    print(f"\nclusters outside or between the known L2: {len(show)}")
    print(show[["verdict", "proposed_name", "notes", "stability", "rule_coverage", "rule_L2", "best_vocabulary_L2", "vocabulary_fit", "top_terms"]]
          .round(3).to_string(index=False, max_colwidth=60))
