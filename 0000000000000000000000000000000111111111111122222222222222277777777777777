        D = np.clip(1 - S, 0, None)
        np.fill_diagonal(D, 0)
        grp = fcluster(linkage(squareform(D, checks=False), method="average"),
                       t=1 - bars["merge bar (separates same-topic from different-topic clusters)"], criterion="distance")
        grp = pd.Series(grp, index=promoted.index)
        lead = promoted.groupby(grp)["notes"].idxmax()
        promoted["final_L2"] = grp.map(lambda g: promoted.loc[lead[g], "proposed_name"])
    clusters["promoted_as"] = clusters["cluster"].map(promoted.set_index("cluster")["final_L2"]).fillna("")
