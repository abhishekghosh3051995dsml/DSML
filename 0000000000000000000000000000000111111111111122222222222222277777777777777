def wilson(k, n, z=1.96):
    if n == 0:
        return np.nan, np.nan
    p_, d = k / n, 1 + z ** 2 / n
    c_ = (p_ + z ** 2 / (2 * n)) / d
    h = z * np.sqrt(p_ * (1 - p_) / n + z ** 2 / (4 * n ** 2)) / d
    return c_ - h, c_ + h


