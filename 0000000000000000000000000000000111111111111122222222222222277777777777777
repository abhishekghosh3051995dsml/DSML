by_class = np.asarray(B[np.flatnonzero(lab_mask)].T @ Y[lab_mask])
rate = by_class / np.maximum(Y.sum(0), 1)
pr = rate / np.maximum(rate.sum(1, keepdims=True), 1e-12)
entropy = -(pr * np.log(np.where(pr > 0, pr, 1))).sum(1) / np.log(K)
neutral = (by_class.sum(1) >= args.neutral_min_notes) & (entropy >= args.neutral_entropy)
phrasing_words = set(vocab_b[neutral]) | set(ENGLISH_STOP_WORDS) | {v.strip() for v in PLACEHOLDERS.values()}
word_roles = pd.DataFrame({"word": vocab_b, "notes": np.asarray(B.sum(0)).ravel(), "spread_across_L2": entropy, "phrasing_word": neutral})
