def interchangeable(affix, rest):
    frame = pd.DataFrame({"affix": affix, "rest": rest})
    variants = frame.groupby("rest")["affix"].nunique()
    s = (frame[frame["affix"] != ""].assign(shared=lambda d: d["rest"].map(variants) > 1)
         .groupby("affix").agg(rows=("rest", "size"), distinct_rest=("rest", "nunique"), shared_share=("shared", "mean")))
    return set(s.index[(s["shared_share"] > 0.5) & (s["distinct_rest"] > 1)])


