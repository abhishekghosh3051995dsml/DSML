nb = NBSVM().fit(Xw_tr[fi], y_tr[fi]).calibrate(Xw_tr[vi], y_tr[vi])
register("nbsvm", "+ NB-SVM feature weighting", lambda d: full_proba(nb, nb.predict_proba(X_word(d))))
nbf = NBSVM().fit(Xf_tr[fi], y_tr[fi]).calibrate(Xf_tr[vi], y_tr[vi])
register("features", "+ character n-grams and L1 context", lambda d: full_proba(nbf, nbf.predict_proba(X_full(d))))
models_e, weights_e = member_models(train, y_tr, np.ones(len(train)))
member_rows = [evaluate(f"member: {n}", P, y_te, trusted=trusted_te) for n, P in member_proba(models_e, test).items()]
register("ensemble", "+ calibrated ensemble (NB-SVM, logistic regression, shallow text network, MLP)", lambda d: blend(member_proba(models_e, d), weights_e),
         ", ".join(f"{n} {v:.2f}" for n, v in weights_e.items() if n != "_T"))

oof = np.zeros((len(train), K))
for tr, te in GroupKFold(n_splits=min(args.folds, train["group"].nunique())).split(train, y_tr, groups=train["group"]):
    m = LogisticRegression(max_iter=args.lr_max_iter, C=args.lr_c).fit(Xf_tr[tr], y_tr[tr])
    oof[np.ix_(te, m.classes_)] = m.predict_proba(Xf_tr[te])
self_conf = oof[np.arange(len(y_tr)), y_tr]
class_thr = np.array([self_conf[y_tr == c].mean() if (y_tr == c).any() else 1.0 for c in range(K)])
pick = oof.argmax(1)
issue = (pick != y_tr) & (self_conf < class_thr[y_tr]) & (oof[np.arange(len(y_tr)), pick] >= class_thr[pick]) & (train["sources_agreeing"].to_numpy() < args.confirm_sources)
cm = pd.crosstab(y_tr, pick).reindex(index=range(K), columns=range(K), fill_value=0).to_numpy().copy()
np.fill_diagonal(cm, 0)
pairs = []
for i in np.argsort(-(cm + cm.T), axis=None):
    p_ = tuple(sorted(np.unravel_index(i, cm.shape)))
    if p_[0] != p_[1] and p_ not in pairs and (cm + cm.T)[p_] > 0:
        pairs.append(p_)
    if len(pairs) == args.hard_pairs:
        break
hard = np.isin(y_tr, [c for p_ in pairs for c in p_]) & (train["sources_agreeing"].to_numpy() >= args.confirm_sources)
w_clean = np.where(issue, 0.0, np.where(hard, args.hard_weight, 1.0))
models_c, weights_c = member_models(train, y_tr, w_clean)
register("cleaned", "+ confident learning and hard-example weighting", lambda d: blend(member_proba(models_c, d), weights_c),
         f"{issue.sum():,} suspect labels removed; hard pairs: " + "; ".join(f"{L2_NAMES[a]} vs {L2_NAMES[b]}" for a, b in pairs))

sel = max(steps[1:], key=lambda s: (coverage_bar(s["P_ca"], y_ca, args.coverage_accuracy)[0], np.mean(s["P_ca"].argmax(1) == y_ca)))
final_l2 = predictors[sel["key"]]
