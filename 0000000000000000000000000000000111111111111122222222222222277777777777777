class NBSVM:
    def __init__(self, C=args.nbsvm_c, alpha=args.nb_alpha):
        self.C, self.alpha, self.T = C, alpha, 1.0

    def fit(self, X, y, w=None):
        Xb = (X > 0).astype(np.float64)
        self.classes_ = np.unique(y)
        self.r_, self.models_ = [], []
        for c in self.classes_:
            p = self.alpha + np.asarray(Xb[y == c].sum(0)).ravel()
            q = self.alpha + np.asarray(Xb[y != c].sum(0)).ravel()
            r = np.log((p / p.sum()) / (q / q.sum()))
            self.r_.append(r)
            self.models_.append(LinearSVC(C=self.C).fit(X.multiply(r).tocsr(), (y == c).astype(int), sample_weight=w))
        return self

    def decision(self, X):
        return np.column_stack([m.decision_function(X.multiply(r).tocsr()) for m, r in zip(self.models_, self.r_)])

    def calibrate(self, X, y):
        seen = np.isin(y, self.classes_)
        if seen.any():
            d = self.decision(X[np.flatnonzero(seen)])
            yi = np.searchsorted(self.classes_, y[seen])
            self.T = float(np.exp(minimize_scalar(lambda t: nll(softmax(d / np.exp(t)), yi), bounds=(-4, 4), method="bounded").x))
        return self

    def predict_proba(self, X):
        return softmax(self.decision(X) / self.T)


class ShallowTextNet:
    def __init__(self, dim=args.net_dim, epochs=args.net_epochs, lr=args.net_lr, batch=args.net_batch, n_features=2 ** args.net_hash_bits, seed=args.seed):
        self.dim, self.epochs, self.lr, self.batch, self.seed = dim, epochs, lr, batch, seed
        self.hasher = HashingVectorizer(analyzer=self._grams, n_features=n_features, alternate_sign=False, norm="l1")

    @staticmethod
    def _grams(text):
        toks = text.split()
        out = toks + [a + " " + b for a, b in zip(toks, toks[1:])]
        for t in toks:
            w = f"<{t}>"
            out += [w[i:i + n] for n in (3, 4, 5) for i in range(len(w) - n + 1)]
        return out

    def fit(self, texts, y, w=None):
        r = np.random.default_rng(self.seed)
        X = self.hasher.transform(texts).tocsr()
        self.classes_ = np.unique(y)
        yi = np.searchsorted(self.classes_, y)
        w = np.ones(len(yi)) if w is None else np.asarray(w, float)
        self.E = r.normal(0, 0.1, (X.shape[1], self.dim))
        self.W = r.normal(0, 0.1, (self.dim, len(self.classes_)))
        self.b = np.zeros(len(self.classes_))
        params = [self.E, self.W, self.b]
        m1, m2 = [np.zeros_like(p) for p in params], [np.zeros_like(p) for p in params]
        step = 0
        for _ in range(self.epochs):
            for s in np.array_split(r.permutation(len(yi)), max(1, len(yi) // self.batch)):
                Xb, yb, wb = X[s], yi[s], w[s] / w[s].sum()
                h = np.asarray(Xb @ self.E)
                g = softmax(h @ self.W + self.b)
                g[np.arange(len(yb)), yb] -= 1
                g *= wb[:, None]
                grads = [None, h.T @ g, g.sum(0)]
                rows = np.unique(Xb.indices)
                gE = np.asarray(Xb[:, rows].T @ (g @ self.W.T))
                step += 1
                for i, (pa, gr) in enumerate(zip(params, grads)):
                    if i == 0:
                        m1[0][rows] = 0.9 * m1[0][rows] + 0.1 * gE
                        m2[0][rows] = 0.999 * m2[0][rows] + 0.001 * gE ** 2
                        pa[rows] -= self.lr * (m1[0][rows] / (1 - 0.9 ** step)) / (np.sqrt(m2[0][rows] / (1 - 0.999 ** step)) + 1e-8)
                    else:
                        m1[i] = 0.9 * m1[i] + 0.1 * gr
                        m2[i] = 0.999 * m2[i] + 0.001 * gr ** 2
                        pa -= self.lr * (m1[i] / (1 - 0.9 ** step)) / (np.sqrt(m2[i] / (1 - 0.999 ** step)) + 1e-8)
        return self

    def predict_proba(self, texts):
        return softmax(np.asarray(self.hasher.transform(texts) @ self.E) @ self.W + self.b)


def full_proba(model, P, n=K):
    out = np.full((P.shape[0], n), 1e-9)
    out[:, model.classes_] = P
    return out / out.sum(1, keepdims=True)


def member_models(d, y, w):
    Xf, Xd = X_full(d), X_dense(d)
    fi, vi = next(GroupShuffleSplit(n_splits=1, test_size=args.validation_share, random_state=args.seed + 2).split(d, groups=d["group"]))
    fi = fi[w[fi] > 0]
    models = {"nbsvm": NBSVM().fit(Xf[fi], y[fi], w[fi]).calibrate(Xf[vi], y[vi]),
              "logistic_regression": LogisticRegression(max_iter=args.lr_max_iter, C=args.lr_c).fit(Xf[fi], y[fi], sample_weight=w[fi]),
              "shallow_text_network": ShallowTextNet(seed=args.seed).fit(d["text_model"].iloc[fi].tolist(), y[fi], w[fi]),
              "mlp": MLPClassifier(hidden_layer_sizes=(args.mlp_hidden,), max_iter=args.mlp_max_iter, early_stopping=True, random_state=args.seed).fit(Xd[fi], y[fi])}
    return models, fit_weights(member_proba(models, d.iloc[vi]), y[vi])


def member_proba(models, d):
    Xf, Xd = X_full(d), X_dense(d)
    return {"nbsvm": full_proba(models["nbsvm"], models["nbsvm"].predict_proba(Xf)),
            "logistic_regression": full_proba(models["logistic_regression"], models["logistic_regression"].predict_proba(Xf)),
            "shallow_text_network": full_proba(models["shallow_text_network"], models["shallow_text_network"].predict_proba(d["text_model"].tolist())),
            "mlp": full_proba(models["mlp"], models["mlp"].predict_proba(Xd))}


def blend(P, weights):
    return softmax(sum(wt * np.log(P[n]) for n, wt in weights.items() if n != "_T") / weights["_T"])


def fit_weights(P, y):
    names = list(P)

    def unpack(x):
        return dict(zip(names, np.exp(x[:-1]) / np.exp(x[:-1]).sum()), _T=float(np.exp(x[-1])))
    return unpack(minimize(lambda x: nll(blend(P, unpack(x)), y), np.zeros(len(names) + 1), method="Nelder-Mead", options={"maxiter": 3000}).x)


def constrain(P, l1s):
    if not ALLOWED:
        return P
    mask = np.array([[1.0 if (l1 not in ALLOWED or n in ALLOWED[l1]) else 0.0 for n in L2_NAMES] for l1 in l1s])
    out = P * np.where(mask.sum(1, keepdims=True) > 0, mask, 1.0)
    return out / out.sum(1, keepdims=True)


