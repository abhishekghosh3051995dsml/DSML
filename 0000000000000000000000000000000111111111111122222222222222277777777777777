cc = CountVectorizer(ngram_range=(1, 2), min_df=args.char_min_df, token_pattern=r"[a-z][a-z0-9]+")
Cc = cc.fit_transform(work["content"])
terms = cc.get_feature_names_out()
wl = work["rule_l2"].to_numpy()
cl_ids = sorted(set(clab) - {-1})
tfm = np.vstack([np.asarray(Cc[wl == n].sum(0)).ravel() for n in L2_NAMES] + [np.asarray(Cc[clab == c].sum(0)).ravel() for c in cl_ids])
Wc = normalize(tfm / np.maximum(tfm.sum(1, keepdims=True), 1) * np.log(1 + tfm.sum(1).mean() / np.maximum(tfm.sum(0), 1)))
fit = Wc[K:] @ Wc[:K].T
word_freq = pd.Series([t for x in real["text_model"] for t in re.findall(r"[a-z][a-z0-9]+", x)]).value_counts()
by_initial = defaultdict(list)
for w_, f_ in word_freq.items():
    by_initial[w_[:1]].append((w_, f_))
canon_cache = {}


def edit_distance(a, b):
    prev = list(range(len(b) + 1))
    for i_, ca in enumerate(a, 1):
        cur = [i_]
        for j_, cb in enumerate(b, 1):
            cur.append(min(prev[j_] + 1, cur[j_ - 1] + 1, prev[j_ - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


def canonical(w):
    if w not in canon_cache:
        f0, limit = word_freq.get(w, 0), 1 if len(w) <= 5 else 2
        if f0 > args.typo_max_share * len(real):
            canon_cache[w] = w
            return w
        best = max(((f_, v) for v, f_ in by_initial[w[:1]] if v != w and f_ >= args.spelling_ratio * max(f0, 1)
                    and abs(len(v) - len(w)) <= limit and edit_distance(v, w) <= limit), default=(0, w))
        canon_cache[w] = best[1]
    return canon_cache[w]


def cluster_name(top, member_text):
    words = []
    for t in top:
        for w in t.split():
            w = canonical(w)
            if w not in words:
                words.append(w)
        if len(words) >= args.name_words:
            break
    if not words:
        counts = pd.Series([canonical(t) for x in member_text for t in x.split()]).value_counts()
        words = list(counts.index[:args.name_words])
    return "_".join(words[:args.name_words]).upper()


