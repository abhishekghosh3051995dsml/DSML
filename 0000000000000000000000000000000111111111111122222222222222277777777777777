    fit_bar = float(clusters.loc[known, "vocabulary_fit"].quantile(args.fit_quantile)) if known.any() else 0.0

    def verdict(r):
        if r.stability < args.min_stability:
            return "unstable"
        if r.rule_coverage >= args.known_coverage and r.rule_purity >= args.known_purity:
            return f"split candidate inside {CATCH_ALL}" if r.rule_L2 == CATCH_ALL else "known L2 confirmed"
        if r.rule_coverage >= args.known_coverage:
            return "boundary between L2s"
        if r.rule_coverage < args.uncovered_coverage and r.vocabulary_fit < fit_bar:
            return "new category candidate"
        return "uncovered part of an existing L2"

    clusters["verdict"] = clusters.apply(verdict, axis=1)
    rank = {"new category candidate": 0, f"split candidate inside {CATCH_ALL}": 1, "uncovered part of an existing L2": 2,
            "boundary between L2s": 3, "known L2 confirmed": 4, "unstable": 5}
    clusters = clusters.sort_values(["verdict", "notes"], key=lambda s: s.map(rank) if s.name == "verdict" else -s).reset_index(drop=True)
    verdicts = clusters.groupby("verdict").agg(clusters=("cluster", "size"), notes=("notes", "sum")).reindex(list(rank)).dropna().reset_index()
    verdicts = pd.concat([verdicts, pd.DataFrame([{"verdict": "not clustered", "clusters": 0, "notes": int((clab < 0).sum())},
                                                  {"verdict": "no issue words", "clusters": 0, "notes": int((~has_content).sum())}])], ignore_index=True)
    verdicts["share_of_real_notes"] = verdicts["notes"] / len(real)
    print("\nreal notes by cluster verdict:")
    print(verdicts.round(4).to_string(index=False))
