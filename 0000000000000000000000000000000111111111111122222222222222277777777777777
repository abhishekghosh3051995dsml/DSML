    if len(cols):
        mask = np.ones(sub.shape[1])
        mask[cols] = 0
        sub = csr_matrix(sub.multiply(mask[None, :]))
    return float(np.linalg.norm(np.asarray(normalize(sub).mean(axis=0)).ravel()))


def random_baseline(n):
