def evaluate(name, P, y, prev=None, trusted=None):
    pred = P.argmax(1)
    row = {"model": name, "accuracy": np.mean(pred == y), "macro_F1": f1_score(y, pred, average="macro"),
           COV: coverage_bar(P, y, args.coverage_accuracy)[0], COV2: coverage_bar(P, y, args.target_precision)[0],
           f"{CATCH_ALL}_share": np.mean(pred == L2_INDEX.get(CATCH_ALL, -1)), "ECE": ece(P, y)}
    if trusted is not None and trusted.any():
        row["accuracy_on_confirmed_labels"] = np.mean(pred[trusted] == y[trusted])
    if prev is not None:
        a, b = prev.argmax(1) == y, pred == y
        n01, n10 = int((~a & b).sum()), int((a & ~b).sum())
        row.update(gained=n01, lost=n10, mcnemar_p=binomtest(n01, n01 + n10, 0.5).pvalue if n01 + n10 else 1.0)
    return row


