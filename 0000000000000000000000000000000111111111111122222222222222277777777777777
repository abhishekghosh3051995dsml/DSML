def normalise(text):
    text = re.sub(r"['\u2019`]", "", text.lower())
    text = re.sub(r"\S+@\S+", PLACEHOLDERS["email"], text)
    text = re.sub(r"(https?://|www\.)\S+", PLACEHOLDERS["url"], text)
    text = re.sub(r"\b(?=\w*\d)\w{%d,}\b" % args.id_min_length, PLACEHOLDERS["idnum"], text)
    text = re.sub(r"\d+", PLACEHOLDERS["num"], text)
    text = re.sub(r"[^\w\s:.!?&/-]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


