def dawid_skene(L, acc0, strength=args.ds_strength, iters=args.ds_max_iter):
    n, m = L.shape
    acc, prior = acc0.copy(), np.full(K, 1.0 / K)
    for _ in range(iters):
        logq = np.tile(np.log(prior), (n, 1))
        for j in range(m):
            on = L[:, j] != ABSTAIN
            wrong = np.log((1 - acc[j]) / (K - 1))
            logq[on] += wrong
            logq[on, L[on, j]] += np.log(acc[j]) - wrong
        q = np.exp(logq - logq.max(1, keepdims=True))
        q /= q.sum(1, keepdims=True)
        new = np.array([(q[L[:, j] != ABSTAIN, L[L[:, j] != ABSTAIN, j]].sum() + strength * acc0[j])
                        / ((L[:, j] != ABSTAIN).sum() + strength) for j in range(m)]).clip(1e-3, 1 - 1e-3)
        if args.class_prior == "learned":
            prior = q.mean(0).clip(1e-4)
        done = np.abs(new - acc).max() < 1e-6
        acc = new
        if done:
            break
    return q, acc


