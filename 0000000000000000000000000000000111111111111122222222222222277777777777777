if len(clusters):
    chars = TfidfVectorizer(analyzer="char_wb", ngram_range=(3, 4), sublinear_tf=True).fit(work["content"])
    cent = {c: np.asarray(chars.transform(work["content"].iloc[np.flatnonzero(clab == c)]).mean(0)).ravel() for c in clusters["cluster"]}

    def similarity(ids):
        rows = [cl_ids.index(c) for c in ids]
        C = normalize(np.vstack([cent[c] for c in ids]))
        return np.maximum(Wc[K:][rows] @ Wc[K:][rows].T, C @ C.T)

    known_c = clusters[clusters["verdict"] == "known L2 confirmed"]
    bars["stability bar (from known-L2 clusters)"] = float(known_c["stability"].quantile(args.reference_quantile)) if len(known_c) else args.min_stability
    bars["merge bar (separates same-topic from different-topic clusters)"] = 1.0
    if len(known_c) > 2:
        S = similarity(known_c["cluster"].tolist())
        topic = [work["rule_topic"].iloc[np.flatnonzero(clab == c)].replace("", np.nan).mode() for c in known_c["cluster"]]
        topic = np.array([t.iloc[0] if len(t) else f"none{i}" for i, t in enumerate(topic)], dtype=object)
        same = topic[:, None] == topic[None, :]
        iu = np.triu_indices(len(S), 1)
        sv, lv = S[iu], same[iu]
        if lv.any() and (~lv).any():
            order = np.argsort(-sv)
            prec = np.cumsum(lv[order]) / np.arange(1, len(sv) + 1)
            ok = np.flatnonzero(prec >= args.merge_probability)
            bars["merge bar (separates same-topic from different-topic clusters)"] = float(sv[order][ok.max()]) if len(ok) else 1.0
    promoted = clusters[clusters["verdict"].isin(["new category candidate", f"split candidate inside {CATCH_ALL}"])
                        & (clusters["stability"] >= bars["stability bar (from known-L2 clusters)"]) & clusters["proposed_name"].str.len().gt(0)].copy()
    promoted["final_L2"] = promoted["proposed_name"]
    if len(promoted) > 1:
