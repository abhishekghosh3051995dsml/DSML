                                               work["content"].iloc[m]) or f"GROUP_{c}", "top_terms": ", ".join(top[:10]),
                 "examples": " | ".join(work[text_col].iloc[m[:5]].astype(str))})
clusters = pd.DataFrame(crow)
if len(clusters):
