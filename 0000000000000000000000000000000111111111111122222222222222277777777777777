def strip_boilerplate(text):
    toks = text.split()
    keep = np.ones(len(toks), dtype=bool)
    for i, t in enumerate(toks):
        for ph in by_first.get(t, ()):
            if toks[i:i + len(ph)] == ph:
                keep[i:i + len(ph)] = False
    out = [t for t, k in zip(toks, keep) if k]
    return " ".join(out) if len(out) >= 2 else text


