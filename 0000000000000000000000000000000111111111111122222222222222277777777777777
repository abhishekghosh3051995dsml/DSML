    mapping = members.merge(promoted[["cluster", "final_L2"]], on="cluster").set_index("row_id")["final_L2"]
    print("\n" + "\n".join(f"{k}: {v:.3f}" for k, v in bars.items()))
    print(f"clusters promoted to new L2: {len(promoted)} -> {promoted['final_L2'].nunique()} new L2 after merging")

