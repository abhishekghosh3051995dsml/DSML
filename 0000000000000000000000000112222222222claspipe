            "shallow_text_network": full_proba(models["shallow_text_network"], models["shallow_text_network"].predict_proba(d["text_model"].tolist())),
            "mlp": full_proba(models["mlp"], models["mlp"].predict_proba(Xd))}


def blend(P, weights):
    return softmax(sum(wt * np.log(P[n]) for n, wt in weights.items() if n != "_T") / weights["_T"])


def fit_weights(P, y):
    names = list(P)

    def unpack(x):
        return dict(zip(names, np.exp(x[:-1]) / np.exp(x[:-1]).sum()), _T=float(np.exp(x[-1])))
    res = minimize(lambda x: nll(blend(P, unpack(x)), y), np.zeros(len(names) + 1), method="Nelder-Mead", options={"maxiter": 3000})
    return unpack(res.x)


