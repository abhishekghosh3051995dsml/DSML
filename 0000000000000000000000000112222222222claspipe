COV = f"coverage_at_{int(args.coverage_accuracy * 100)}pct_accuracy"


def coverage_bar(P, y, target):
    conf = P.max(1)
    order = np.argsort(-conf)
    run = np.cumsum((P.argmax(1) == y)[order]) / np.arange(1, len(y) + 1)
    ok = np.flatnonzero(run >= target)
    return ((ok.max() + 1) / len(y), float(conf[order][ok.max()])) if len(ok) else (0.0, 1.0 + 1e-9)


def evaluate(name, P, y, prev=None, trusted=None):
    pred = P.argmax(1)
    row = {"model": name, "L2_accuracy": np.mean(pred == y), "L2_macro_F1": f1_score(y, pred, average="macro"),
           COV: coverage_bar(P, y, args.coverage_accuracy)[0],
           f"coverage_at_{int(args.target_precision * 100)}pct_accuracy": coverage_bar(P, y, args.target_precision)[0],
           "GENERAL_SUPPORT_share": np.mean(pred == L2_INDEX.get("GENERAL_SUPPORT", -1)), "ECE": ece(P, y)}
    if trusted is not None and trusted.any():
        row["accuracy_on_confirmed_labels"] = np.mean(pred[trusted] == y[trusted])
    if prev is not None:
        a, b = prev.argmax(1) == y, pred == y
        n01, n10 = int((~a & b).sum()), int((a & ~b).sum())
        row.update(gained=n01, lost=n10, mcnemar_p=binomtest(n01, n01 + n10, 0.5).pvalue if n01 + n10 else 1.0)
    return row


