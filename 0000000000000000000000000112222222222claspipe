final = prep[["row_id", text_col, l1_col]].merge(
    pd.concat([real[["row_id", "Intent-L2"]], tmpl_ok[["row_id", "Intent-L2"]]]), on="row_id", how="left")
missing_t = final["Intent-L2"].isna()
if missing_t.any():
