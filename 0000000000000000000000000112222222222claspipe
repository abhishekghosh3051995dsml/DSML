register("cleaned", "+ confident learning and hard-example weighting", lambda d: blend(member_proba(models_c, d), weights_c),
         f"{issue.sum():,} suspect labels removed ({issue.mean():.1%}); hard pairs: " + "; ".join(f"{L2_NAMES[a]} vs {L2_NAMES[b]}" for a, b in pairs))

# %%
spread = LabelSpreading(kernel="knn", n_neighbors=args.spread_neighbors, alpha=0.2, max_iter=50).fit(
    np.vstack([X_dense(train), X_dense(unl)]), np.concatenate([np.where(issue, -1, y_tr), -np.ones(len(unl), dtype=int)]))
graph_pick = spread.label_distributions_[len(train):].argmax(1)
P_unl = blend(member_proba(models_c, unl), weights_c)
pseudo_thr = coverage_bar(steps[-1]["P_ca"], y_ca, args.coverage_accuracy)[1]
agree_pick = (P_unl.argmax(1) == graph_pick) & (P_unl.max(1) >= pseudo_thr)
pseudo = unl[agree_pick].assign(weak_l2=P_unl.argmax(1)[agree_pick])
aug = pd.concat([train, pseudo], ignore_index=True)
models_s, weights_s = member_models(aug, aug["weak_l2"].to_numpy(), np.concatenate([w_clean, P_unl.max(1)[agree_pick]]))
register("semi_supervised", "+ semi-supervised label spreading on unlabelled notes", lambda d: blend(member_proba(models_s, d), weights_s),
         f"{len(pseudo):,} of {len(unl):,} unlabelled notes added (model and graph agree, confidence >= {pseudo_thr:.3f})")

# %%
best_key = max((s for s in steps[1:]), key=lambda s: (coverage_bar(s["P_ca"], y_ca, args.coverage_accuracy)[0], np.mean(s["P_ca"].argmax(1) == y_ca)))["key"]
improved = predictors[best_key]
base_bar = coverage_bar(steps[0]["P_ca"], y_ca, args.coverage_accuracy)[1]


def cascade(d):
    Pb, Pi = predictors["baseline"](d), improved(d)
    keep = Pb.max(1) >= base_bar
    return np.where(keep[:, None], Pb, Pi)


register("cascade", "+ cascade: keep confident baseline answers, route the rest to the improved model", cascade,
         f"baseline kept where its confidence >= {base_bar:.3f}; improved model = {best_key}")
sel = max(steps[1:], key=lambda s: (coverage_bar(s["P_ca"], y_ca, args.coverage_accuracy)[0], np.mean(s["P_ca"].argmax(1) == y_ca)))
final_name, final_predict = sel["key"], predictors[sel["key"]]
ablation_df = pd.DataFrame([s["row"] for s in steps])
print("\nheld-out real notes (never used for training or selection), scored against statistical labels:")
print(ablation_df.drop(columns=["note"]).round(4).to_string(index=False))
tick(f"production configuration selected on the calibration set: {final_name}")

# %%
P_cal, P_test = sel["P_ca"], sel["P_te"]
nonconf = 1 - P_cal[np.arange(len(y_ca)), y_ca]
qhat = np.quantile(nonconf, min(1.0, np.ceil((len(y_ca) + 1) * (1 - args.conformal_alpha)) / len(y_ca)), method="higher")
conf_thr = coverage_bar(P_cal, y_ca, args.coverage_accuracy)[1]
P_real = final_predict(real)
real["Intent-L2"] = [L2_NAMES[i] for i in P_real.argmax(1)]
real["l2_confidence"] = P_real.max(1)
real["conformal_set_size"] = (P_real >= 1 - qhat).sum(1)
real["below_confidence_bar"] = real["l2_confidence"] < conf_thr
tick(f"production L2 for {len(real):,} real notes; confidence bar for {args.coverage_accuracy:.0%} accuracy = {conf_thr:.3f}; "
     f"below the bar: {real['below_confidence_bar'].sum():,} ({real['below_confidence_bar'].mean():.1%})")

# %%
emb_all = normalize(lsa.transform(word_vec.transform(real["text_model"])))
mcs = max(args.min_category_size, int(0.002 * len(real)))
conf_idx = np.flatnonzero(~real["below_confidence_bar"].to_numpy() & (real["weak_l2"].to_numpy() >= 0))
ref = np.random.default_rng(args.seed).choice(conf_idx, size=min(len(conf_idx), 20_000), replace=False)
ref_l2 = P_real.argmax(1)[ref]


def nearest_reference(E, exclude_self=False, k=10):
    sims, labs = np.zeros(len(E)), np.zeros((len(E), K))
    for a in range(0, len(E), 2000):
        S = E[a:a + 2000] @ emb_all[ref].T
        if exclude_self:
            S[S > 0.9999] = -1
        top = np.argsort(-S, axis=1)[:, :k]
        sims[a:a + 2000] = np.take_along_axis(S, top[:, :1], 1).ravel()
        for j in range(k):
            labs[np.arange(a, a + len(top)), ref_l2[top[:, j]]] += 1.0 / k
    return sims, labs


def label_clusters(lab_vec, texts):
    bg = real["text_model"].iloc[ref[:5000]] if len(ref) else pd.Series([], dtype=str)
    cv = CountVectorizer(token_pattern=r"[a-z]{2,}", stop_words="english", ngram_range=(1, 2), min_df=3)
    counts = cv.fit_transform(pd.concat([texts, bg]))
    terms = cv.get_feature_names_out()
    classes = sorted(set(lab_vec) - {-1})
    rows = [np.asarray(counts[:len(texts)][lab_vec == c].sum(0)).ravel() for c in classes]
    rows.append(np.asarray(counts[len(texts):].sum(0)).ravel())
    tf = np.vstack(rows)
    A = tf.sum(1).mean()
    ctf = tf / np.maximum(tf.sum(1, keepdims=True), 1) * np.log(1 + A / np.maximum(tf.sum(0), 1))
    out = {}
    for i, c in enumerate(classes):
        order = np.argsort(-ctf[i])[:15]
        top = [terms[j] for j in order]
        bigrams = [t for t in top[:5] if " " in t]
        name = (bigrams[0] if bigrams else " ".join(top[:2])).upper().replace(" ", "_")
        out[c] = (top, name)
    return out


ref_sim, _ = nearest_reference(emb_all[ref[:3000]], exclude_self=True)
novelty_bar = float(np.quantile(ref_sim, args.novelty_quantile))
all_sim, all_votes = nearest_reference(emb_all)
real["similarity_to_known_notes"] = all_sim
real["outside_known_territory"] = (real["weak_l2"].to_numpy() < 0) & (all_sim < novelty_bar)
real["needs_review"] = real["below_confidence_bar"] | real["outside_known_territory"]
in_catch_all = (real["Intent-L2"] == args.catch_all_l2).to_numpy()
low = real[real["needs_review"].to_numpy() | in_catch_all]
emb_low = emb_all[low.index]
clu_low = normalize(PCA(n_components=min(args.cluster_dims, emb_low.shape[1], max(2, len(low) - 1)), random_state=args.seed).fit_transform(emb_low)) if len(low) > 2 else emb_low
tick(f"category analysis pool: {len(low):,} notes ({len(low) / len(real):.1%}) = below confidence bar {real['below_confidence_bar'].sum():,}, "
     f"unlabelled and far from known notes {real['outside_known_territory'].sum():,} (similarity < {novelty_bar:.3f}), "
     f"predicted {args.catch_all_l2} {in_catch_all.sum():,}")
proposals = []
if len(low) >= 2 * mcs:
    lab_low = HDBSCAN(min_cluster_size=mcs, min_samples=max(5, mcs // 3), copy=True).fit(clu_low).labels_
    low_sim, low_votes = all_sim[low.index], all_votes[low.index]
    rr = np.random.default_rng(args.seed)
    boots = []
    for _ in range(args.stability_runs):
        s = rr.choice(len(emb_low), size=int(0.8 * len(emb_low)), replace=False)
        boots.append((s, HDBSCAN(min_cluster_size=mcs, min_samples=max(5, mcs // 3), copy=True).fit(clu_low[s]).labels_))
    names = label_clusters(lab_low, low["text_model"].reset_index(drop=True))
    for c in sorted(set(lab_low) - {-1}):
        members = np.flatnonzero(lab_low == c)
        mset = set(members)
        jac = []
        for s, bl in boots:
            inside = np.isin(s, members)
            jac.append(max((len(mset & set(s[bl == b])) / len(mset | set(s[bl == b])) for b in set(bl[inside]) - {-1}), default=0.0))
        votes = low_votes[members].mean(0)
        top, name = names[c]
        stable = float(np.mean(jac)) >= args.min_stability
        novel = float(np.median(low_sim[members])) < novelty_bar
        current = real["Intent-L2"].iloc[low.index[members]].value_counts()
        from_catch_all = current.index[0] == args.catch_all_l2
        if not stable:
            action = "ignore: unstable cluster"
        elif novel:
            action = "new L2 candidate"
        elif from_catch_all:
            action = f"split candidate from {args.catch_all_l2}"
        else:
            action = "keep: close to confident notes"
        proposals.append({"cluster": int(c), "notes": len(members), "stability_jaccard": float(np.mean(jac)),
                          "median_similarity_to_confident_notes": float(np.median(low_sim[members])), "novelty_bar": novelty_bar,
                          "current_L2": current.index[0], "current_L2_share": float(current.iloc[0] / len(members)),
                          "neighbour_L2": L2_NAMES[int(votes.argmax())], "neighbour_L2_share": float(votes.max()),
                          "action": action, "proposed_name": name, "top_terms": ", ".join(top[:10]),
                          "examples": " | ".join(low[text_col].iloc[members[:3]].astype(str))})
    low = low.assign(category_cluster=lab_low)
prop = pd.DataFrame(proposals)
accepted = prop[prop["action"].isin(["new L2 candidate", f"split candidate from {args.catch_all_l2}"])] if len(prop) else pd.DataFrame()
if len(prop):
    print(f"\nstable-cluster analysis: {len(prop)} clusters")
    print(prop["action"].value_counts().to_string())
    print(prop[["proposed_name", "notes", "stability_jaccard", "median_similarity_to_confident_notes", "current_L2",
                "neighbour_L2", "action"]].round(3).to_string(index=False))
    members_out = pd.DataFrame({"row_id": low["row_id"].to_numpy(), "cluster": lab_low})
    members_out[members_out["cluster"] >= 0].to_csv(outdir / "l2_category_members.csv", index=False)
    review = prop.assign(decision="", final_L2=np.where(prop.index.isin(accepted.index), prop["proposed_name"], prop["current_L2"]))
    review.to_csv(outdir / "l2_category_review.csv", index=False)
else:
    print("\nno clusters found in the category analysis pool")
if args.category_decisions:
    dec = pd.read_csv(args.category_decisions, keep_default_na=False)
    dec = dec[dec["decision"].str.strip().str.lower() == "accept"]
    mem = pd.read_csv(Path(args.category_decisions).with_name("l2_category_members.csv"))
    mem = mem.merge(dec[["cluster", "final_L2"]], on="cluster")
    hit = real["row_id"].isin(mem["row_id"])
    real.loc[hit, "Intent-L2"] = real.loc[hit, "row_id"].map(mem.set_index("row_id")["final_L2"]).values
    tick(f"applied {len(dec)} accepted category decisions to {int(hit.sum()):,} notes")

