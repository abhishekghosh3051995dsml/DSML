def dawid_skene(L, acc0, strength=100.0, iters=200):
    n, m = L.shape
    acc = acc0.copy()
    prior = np.full(K, 1.0 / K)
    for _ in range(iters):
        logq = np.tile(np.log(prior), (n, 1))
        for j in range(m):
            on = L[:, j] != ABSTAIN
            wrong = np.log((1 - acc[j]) / (K - 1))
            logq[on] += wrong
            logq[on, L[on, j]] += np.log(acc[j]) - wrong
        logq -= logq.max(1, keepdims=True)
        q = np.exp(logq)
        q /= q.sum(1, keepdims=True)
        new = np.array([(q[L[:, j] != ABSTAIN, L[L[:, j] != ABSTAIN, j]].sum() + strength * acc0[j])
                        / ((L[:, j] != ABSTAIN).sum() + strength) for j in range(m)]).clip(1e-3, 1 - 1e-3)
        prior = q.mean(0).clip(1e-4)
        if np.abs(new - acc).max() < 1e-6:
            acc = new
            break
        acc = new
    return q, acc


def pairwise_agreement(j):
