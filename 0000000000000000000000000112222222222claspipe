cov = pd.DataFrame({"min_confidence": np.round(np.arange(0.3, 1.0, 0.05), 2)})
cov["share_of_notes"] = [np.mean(P_test.max(1) >= c) for c in cov["min_confidence"]]
cov["heldout_accuracy"] = [np.mean(pred_te[P_test.max(1) >= c] == y_te[P_test.max(1) >= c]) if (P_test.max(1) >= c).any() else np.nan for c in cov["min_confidence"]]
idx = np.arange(len(y_te))
rb = np.random.default_rng(args.seed)
boot = [np.mean(pred_te[s] == y_te[s]) for s in (rb.integers(0, len(idx), len(idx)) for _ in range(args.bootstrap))]
summary = pd.DataFrame([
    ("rows in output", len(final)), ("real agent notes", len(real)), ("template rows", len(tmpl)),
    ("real notes with statistical labels", len(lab)), ("held-out test notes", len(test)),
