class NBSVM:
    def __init__(self, C=0.5, alpha=1.0):
        self.C, self.alpha, self.T = C, alpha, 1.0

    def fit(self, X, y, w=None):
        Xb = (X > 0).astype(np.float64)
        self.classes_ = np.unique(y)
        self.r_, self.models_ = [], []
        for c in self.classes_:
            p = self.alpha + np.asarray(Xb[y == c].sum(0)).ravel()
            q = self.alpha + np.asarray(Xb[y != c].sum(0)).ravel()
            r = np.log((p / p.sum()) / (q / q.sum()))
            self.r_.append(r)
            self.models_.append(LinearSVC(C=self.C).fit(X.multiply(r).tocsr(), (y == c).astype(int), sample_weight=w))
        return self

    def decision(self, X):
        return np.column_stack([m.decision_function(X.multiply(r).tocsr()) for m, r in zip(self.models_, self.r_)])

    def calibrate(self, X, y):
        seen = np.isin(y, self.classes_)
        d = self.decision(X[np.flatnonzero(seen)])
        yi = np.searchsorted(self.classes_, y[seen])
        self.T = minimize_scalar(lambda t: nll(softmax(d / np.exp(t)), yi), bounds=(-4, 4), method="bounded").x
        self.T = float(np.exp(self.T))
        return self

    def predict_proba(self, X):
        return softmax(self.decision(X) / self.T)


class ShallowTextNet:
    def __init__(self, dim=48, epochs=6, lr=0.02, batch=256, n_features=2 ** 17, seed=0):
        self.dim, self.epochs, self.lr, self.batch, self.seed = dim, epochs, lr, batch, seed
        self.hasher = HashingVectorizer(analyzer=self._grams, n_features=n_features, alternate_sign=False, norm="l1")

    @staticmethod
    def _grams(text):
        toks = text.split()
        out = toks + [a + " " + b for a, b in zip(toks, toks[1:])]
        for t in toks:
            w = f"<{t}>"
            out += [w[i:i + n] for n in (3, 4, 5) for i in range(len(w) - n + 1)]
        return out

    def fit(self, texts, y, w=None):
        r = np.random.default_rng(self.seed)
        X = self.hasher.transform(texts).tocsr()
        self.classes_ = np.unique(y)
        yi = np.searchsorted(self.classes_, y)
        k = len(self.classes_)
        w = np.ones(len(yi)) if w is None else np.asarray(w, float)
        self.E = r.normal(0, 0.1, (X.shape[1], self.dim))
        self.W = r.normal(0, 0.1, (self.dim, k))
        self.b = np.zeros(k)
        params = [self.E, self.W, self.b]
        m1 = [np.zeros_like(p) for p in params]
        m2 = [np.zeros_like(p) for p in params]
        step = 0
        for _ in range(self.epochs):
            for s in np.array_split(r.permutation(len(yi)), max(1, len(yi) // self.batch)):
                Xb, yb, wb = X[s], yi[s], w[s] / w[s].sum()
                h = np.asarray(Xb @ self.E)
                p = softmax(h @ self.W + self.b)
                g = p
                g[np.arange(len(yb)), yb] -= 1
                g *= wb[:, None]
                grads = [None, h.T @ g, g.sum(0)]
                dh = g @ self.W.T
                rows = np.unique(Xb.indices)
                gE = np.asarray(Xb[:, rows].T @ dh)
                step += 1
                for i, (pa, gr) in enumerate(zip(params, grads)):
                    if i == 0:
                        m1[0][rows] = 0.9 * m1[0][rows] + 0.1 * gE
                        m2[0][rows] = 0.999 * m2[0][rows] + 0.001 * gE ** 2
                        pa[rows] -= self.lr * (m1[0][rows] / (1 - 0.9 ** step)) / (np.sqrt(m2[0][rows] / (1 - 0.999 ** step)) + 1e-8)
                    else:
                        m1[i] = 0.9 * m1[i] + 0.1 * gr
                        m2[i] = 0.999 * m2[i] + 0.001 * gr ** 2
                        pa -= self.lr * (m1[i] / (1 - 0.9 ** step)) / (np.sqrt(m2[i] / (1 - 0.999 ** step)) + 1e-8)
        return self

    def predict_proba(self, texts):
        return softmax(np.asarray(self.hasher.transform(texts) @ self.E) @ self.W + self.b)


def full_proba(model, P):
    out = np.full((P.shape[0], K), 1e-9)
    out[:, model.classes_] = P
    return out / out.sum(1, keepdims=True)


