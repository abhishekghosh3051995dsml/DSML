    ("baseline L2 accuracy", ablation_df.iloc[0]["L2_accuracy"]), ("final L2 accuracy", evaluate("x", P_test, y_te)["L2_accuracy"]),
    ("final L2 accuracy 95% CI low", np.percentile(boot, 2.5)), ("final L2 accuracy 95% CI high", np.percentile(boot, 97.5)),
    (f"baseline coverage at {args.coverage_accuracy:.0%} accuracy", ablation_df.iloc[0][f"coverage_at_{int(args.coverage_accuracy * 100)}pct_accuracy"]),
    (f"final coverage at {args.coverage_accuracy:.0%} accuracy", evaluate("x", P_test, y_te)[f"coverage_at_{int(args.coverage_accuracy * 100)}pct_accuracy"]),
    ("real notes below the confidence bar", real["below_confidence_bar"].mean()),
    ("real notes outside known territory", real["outside_known_territory"].mean()),
    ("real notes flagged needs_review", real["needs_review"].mean()),
    ("new or split L2 candidates for review", len(accepted)),
    ("GENERAL_SUPPORT share of real notes", np.mean(real["Intent-L2"] == "GENERAL_SUPPORT")),
], columns=["metric", "value"])
print("\n" + summary.to_string(index=False))
