def lcp(a, b):
    n = 0
    for x, y in zip(a, b):
        if x != y:
            break
        n += 1
    return n


SHORT_TAILS = {"e", "s", "es", "d", "ed", "ing", "on", "y", "ies", "ied"}
INFLECTIONS = {"s", "es", "d", "ed", "ing", "ings", "er", "ers", "ment", "ments", "ion", "ions", "ation", "ations", "al", "ly", "ity", "ivity", "ive"}
STEM_TAILS = SHORT_TAILS | INFLECTIONS | {"ication", "ications", "ying", "ement", "ements", "ered", "ering", "ration", "sion", "ded"}


def word_matches(v, w):
    if v == w:
        return True
    shorter, longer = sorted((v, w), key=len)
    common = lcp(v, w)
    if len(shorter) < 4 or common < 4:
        return False
    if common == len(shorter):
        return longer[common:] in INFLECTIONS
    for c in range(common, max(3, common - 3), -1):
        if v[c:] in STEM_TAILS and w[c:] in STEM_TAILS:
            return True
    return common >= args.word_prefix_ratio * len(shorter) and shorter[common:] in SHORT_TAILS




