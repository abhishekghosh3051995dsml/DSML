real[["row_id", text_col, l1_col, "Intent-L2", "l2_confidence", "conformal_set_size", "below_confidence_bar", "similarity_to_known_notes", "outside_known_territory", "needs_review"]].to_csv(outdir / "l2_predictions_real_notes.csv", index=False)

# %%
pred_te = P_test.argmax(1)
prec, rec, f1v, sup = precision_recall_fscore_support(y_te, pred_te, labels=range(K), zero_division=0)
per_l2 = pd.DataFrame({"Intent-L2": L2_NAMES, "heldout_notes": sup, "precision": prec, "recall": rec, "F1": f1v})
