def softmax(z):
    z = z - z.max(1, keepdims=True)
    e = np.exp(z)
    return e / e.sum(1, keepdims=True)


def nll(P, y):
    return -np.mean(np.log(np.clip(P[np.arange(len(y)), y], 1e-12, 1)))


def ece(P, y, bins=10):
    conf, ok = P.max(1), P.argmax(1) == y
    edges = np.linspace(0, 1, bins + 1)
    return sum(abs(ok[m].mean() - conf[m].mean()) * m.mean()
               for lo, hi in zip(edges[:-1], edges[1:]) for m in [(conf > lo) & (conf <= hi)] if m.any())


def precision_threshold(conf, correct, target):
    order = np.argsort(-conf)
    run = np.cumsum(correct[order]) / np.arange(1, len(conf) + 1)
    ok = np.flatnonzero(run >= target)
    return float(conf[order][ok.max()]) if len(ok) else 1.0


