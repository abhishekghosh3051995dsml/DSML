# %% helpers
def softmax(z):
    z = z - z.max(1, keepdims=True)
    e = np.exp(z)
    return e / e.sum(1, keepdims=True)


def nll(P, y_idx):
    return -np.mean(np.log(np.clip(P[np.arange(len(y_idx)), y_idx], 1e-12, 1)))


def fit_temperature(logits, y_idx):
    if not len(y_idx):
        return 1.0
    res = minimize_scalar(lambda t: nll(softmax(logits / np.exp(t)), y_idx), bounds=(-4, 4), method="bounded")
    return float(np.exp(res.x))


def ece(conf, correct, bins):
    edges = np.linspace(0, 1, bins + 1)
    total = 0.0
    for lo, hi in zip(edges[:-1], edges[1:]):
        m = (conf > lo) & (conf <= hi)
        if m.any():
            total += abs(correct[m].mean() - conf[m].mean()) * m.mean()
    return total


def coverage_at(conf, correct, target):
    """Largest share of rows (most confident first) whose running accuracy is >= target, and the confidence there."""
    if not len(conf):
        return 0.0, np.inf
    order = np.argsort(-conf)
    running = np.cumsum(correct[order]) / np.arange(1, len(conf) + 1)
    ok = np.flatnonzero(running >= target)
    if not len(ok):
        return 0.0, np.inf
    return (ok.max() + 1) / len(conf), float(conf[order][ok.max()])


def wilson(k, n, z=1.96):
    if n == 0:
        return np.nan, np.nan
    p, d = k / n, 1 + z ** 2 / n
    centre = (p + z ** 2 / (2 * n)) / d
    half = z * np.sqrt(p * (1 - p) / n + z ** 2 / (4 * n ** 2)) / d
    return centre - half, centre + half


def grouped_split(frame, share, seed):
    if frame["group"].nunique() < 2 or len(frame) < 10:
        idx = np.arange(len(frame))
        return idx, idx
    splitter = GroupShuffleSplit(n_splits=1, test_size=share, random_state=seed)
    return next(splitter.split(frame, groups=frame["group"]))


class UnionFind:
    def __init__(self, n):
        self.parent = np.arange(n)

    def find(self, i):
        while self.parent[i] != i:
            self.parent[i] = self.parent[self.parent[i]]
            i = self.parent[i]
        return i

    def union(self, a, b):
        ra, rb = self.find(a), self.find(b)
        if ra != rb:
            self.parent[rb] = ra

    def roots(self):
        return np.array([self.find(i) for i in range(len(self.parent))])


