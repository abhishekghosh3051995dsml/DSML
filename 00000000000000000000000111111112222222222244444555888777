def score_against_gold(path, final):
    gold = pd.read_csv(path, dtype=str, keep_default_na=False)
    if "row_id" not in gold.columns or "correct_L2" not in gold.columns:
        log.warning("gold file needs row_id and correct_L2 columns; skipped")
        return pd.DataFrame()
    gold["row_id"] = pd.to_numeric(gold["row_id"], errors="coerce")
    gold = gold.dropna(subset=["row_id"]).astype({"row_id": int}).merge(final, on="row_id")
    rows = []
    for level, truth, pred in (("L2", "correct_L2", "final_l2"), ("L4", "correct_L4", "final_l4")):
        if truth in gold.columns:
            g = gold[gold[truth].str.strip() != ""]
            k = int((g[truth].str.strip().str.upper() == g[pred].str.upper()).sum())
            lo, hi = wilson(k, len(g))
            rows.append({"level": level, "rows": len(g), "correct": k, "accuracy": k / len(g) if len(g) else np.nan, "ci95_low": lo, "ci95_high": hi})
            if "ref_l2" in g and level == "L2":
                k = int((g[truth].str.strip().str.upper() == g["ref_l2"].str.upper()).sum())
                lo, hi = wilson(k, len(g))
                rows.append({"level": "L2 (existing labels)", "rows": len(g), "correct": k, "accuracy": k / len(g), "ci95_low": lo, "ci95_high": hi})
    table = pd.DataFrame(rows)
    log.info("accuracy against the gold file:\n%s", table.round(3).to_string(index=False))
    return table


