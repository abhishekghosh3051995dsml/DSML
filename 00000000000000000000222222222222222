parser = argparse.ArgumentParser()
parser.add_argument("--input", default=str(Path.home() / "OneDrive - T-Mobile USA" / "Downloads" / "data.csv"))
parser.add_argument("--outdir", default=r"C:\Datascience\nora_l2\01_data_preparation")
parser.add_argument("--near-dup-threshold", type=float, default=0.90)
parser.add_argument("--phrase-min-df", type=float, default=0.001)
parser.add_argument("--phrase-max-z", type=float, default=2.0)
parser.add_argument("--phrase-min-ownership", type=float, default=0.5)
parser.add_argument("--length-quantile", type=float, default=0.95)
parser.add_argument("--seed", type=int, default=0)
args, _ = parser.parse_known_args()

outdir = Path(args.outdir)
outdir.mkdir(parents=True, exist_ok=True)
rng = np.random.default_rng(args.seed)

# %%
def read_csv_any(path):
    for enc in ("utf-8-sig", "utf-8", "cp1252", "latin-1"):
        try:
            return pd.read_csv(path, dtype=str, keep_default_na=False, encoding=enc)
        except UnicodeDecodeError:
            continue
    raise ValueError(f"cannot decode {path}")


raw = read_csv_any(args.input)
raw = raw.loc[:, [c for c in raw.columns if not c.startswith("Unnamed")]]
stats = pd.DataFrame({"mean_len": raw.apply(lambda s: s.str.len().mean()), "n_unique": raw.nunique()})
text_col = stats["mean_len"].idxmax()
l1_col = stats.drop(index=text_col).query("n_unique > 1")["n_unique"].idxmin()
df = raw[[text_col, l1_col]].copy()
df.insert(0, "row_id", np.arange(len(df)))
print(f"rows {len(df):,}  text column '{text_col}'  L1 column '{l1_col}'")
print(df[l1_col].value_counts().to_string())

# %%
def normalise(text):
    text = re.sub(r"['\u2019`]", "", text.lower())
    text = re.sub(r"\S+@\S+", " email ", text)
    text = re.sub(r"(https?://|www\.)\S+", " url ", text)
    text = re.sub(r"\b(?=\w*\d)\w{5,}\b", " idnum ", text)
    text = re.sub(r"\d+", " num ", text)
    text = re.sub(r"[^\w\s:.!?&/-]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


df["text_norm"] = df[text_col].map(normalise)
df["n_tokens_raw"] = df["text_norm"].str.split().str.len()

# %%
def interchangeable(affix, rest):
    frame = pd.DataFrame({"affix": affix, "rest": rest})
    variants = frame.groupby("rest")["affix"].nunique()
    s = (frame[frame["affix"] != ""].assign(shared=lambda d: d["rest"].map(variants) > 1)
         .groupby("affix").agg(rows=("rest", "size"), distinct_rest=("rest", "nunique"), shared_share=("shared", "mean")))
    return set(s.index[(s["shared_share"] > 0.5) & (s["distinct_rest"] > 1)]), s


prefix_re = re.compile(r"^([^:.!?]{1,40}):\s+")
prefix = df["text_norm"].str.extract(prefix_re, expand=False).fillna("")
body = df["text_norm"].str.replace(prefix_re, "", n=1, regex=True)
template_prefixes, prefix_stats = interchangeable(prefix, body)
sentences = body.str.split(r"(?<=[.!?])\s+", regex=True)
last = pd.Series(np.where(sentences.str.len() > 1, sentences.str[-1], ""), index=df.index)
core_part = pd.Series([b[: len(b) - len(s)].strip() if s else b for b, s in zip(body, last)], index=df.index)
template_suffixes, suffix_stats = interchangeable(last, core_part)

has_affix = prefix.isin(template_prefixes) | last.isin(template_suffixes)
base = pd.Series(np.where(prefix.isin(template_prefixes), body, df["text_norm"]), index=df.index)
core = pd.Series([b[: len(b) - len(l)].strip() if l in template_suffixes and b.endswith(l) else b
                  for b, l in zip(base, last)], index=df.index)
core = core.str.replace(r"[.!?]+$", "", regex=True).str.strip()
df["is_template"] = has_affix | core.isin(set(core[has_affix]))
df["template_core"] = np.where(df["is_template"], core, "")
raw_text = df[text_col].str.strip()
style = pd.crosstab(df["is_template"], raw_text.str[:1].str.isupper() & raw_text.str[-1:].isin(list(".!?")))
print(f"\ntemplate rows {df['is_template'].sum():,}  real notes {(~df['is_template']).sum():,}  "
      f"template cores {df.loc[df['is_template'], 'template_core'].nunique():,}")
print("style check (rows: is_template, cols: sentence case + end punctuation)")
print(style)

# %%
df["exact_dup_group"] = df["text_norm"].factorize()[0]
real_idx = np.flatnonzero(~df["is_template"].to_numpy())
real_text = df.loc[real_idx, "text_norm"]
shingles = TfidfVectorizer(analyzer="char_wb", ngram_range=(5, 5), min_df=2, sublinear_tf=True).fit_transform(real_text)

parent = np.arange(len(real_idx))


def find(i):
    while parent[i] != i:
        parent[i] = parent[parent[i]]
        i = parent[i]
    return i


chunk = 2000
for start in range(0, shingles.shape[0], chunk):
    sims = (shingles[start:start + chunk] @ shingles.T).tocoo()
    keep = (sims.data >= args.near_dup_threshold) & (sims.row + start < sims.col)
    for a, b in zip(sims.row[keep] + start, sims.col[keep]):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra
roots = np.array([find(i) for i in range(len(real_idx))])
df["near_dup_group"] = -1
df.loc[real_idx, "near_dup_group"] = roots
near_sizes = pd.Series(roots).value_counts()
print(f"\nreal notes in near-duplicate groups (cosine >= {args.near_dup_threshold}): "
      f"{int(near_sizes[near_sizes > 1].sum()):,} in {int((near_sizes > 1).sum()):,} groups")

# %%
lsa_vec = TfidfVectorizer(min_df=3, max_df=0.5, sublinear_tf=True, token_pattern=r"[a-z]{2,}")
X_real = lsa_vec.fit_transform(real_text)
vocab = lsa_vec.vocabulary_

phrase_vec = CountVectorizer(ngram_range=(3, 6), min_df=max(5, int(args.phrase_min_df * len(real_idx))),
                             token_pattern=r"[a-z]{2,}", binary=True)
P = phrase_vec.fit_transform(real_text).tocsc()
phrases = phrase_vec.get_feature_names_out()
X_norm = normalize(X_real)


def resultant(rows, cols):
    sub = X_norm[rows]
    if len(cols):
        mask = np.ones(sub.shape[1])
        mask[cols] = 0
        sub = csr_matrix(sub.multiply(mask[None, :]))
    sub = normalize(sub)
    return float(np.linalg.norm(np.asarray(sub.mean(axis=0)).ravel()))


baseline = {}


def random_baseline(n):
    key = int(np.round(np.log2(max(n, 2)) * 2))
    if key not in baseline:
        draws = [resultant(rng.choice(len(real_idx), size=min(n, len(real_idx)), replace=False), []) for _ in range(20)]
        baseline[key] = (np.mean(draws), np.std(draws) + 1e-9)
    return baseline[key]


X_bin = (X_real > 0).astype(np.int32).tocsr()
word_df = pd.Series(np.asarray(X_bin.sum(axis=0)).ravel(), index=lsa_vec.get_feature_names_out())

rows = []
for j, ph in enumerate(phrases):
    members = P[:, j].nonzero()[0]
    co = np.asarray(X_bin[members].sum(axis=0)).ravel()
    attached = np.flatnonzero((co >= 0.9 * len(members)) & (co >= args.phrase_min_ownership * word_df.values))
    cols = sorted(set(attached) | {vocab[w] for w in ph.split() if w in vocab})
    obs = resultant(members, cols)
    mu, sd = random_baseline(len(members))
    rarest = min(ph.split(), key=lambda w: word_df.get(w, np.inf))
    ownership = len(members) / word_df.get(rarest, len(members))
    rows.append((ph, len(members), len(members) / len(real_idx), obs, (obs - mu) / sd, rarest, ownership))
phrase_table = pd.DataFrame(rows, columns=["phrase", "notes", "share", "cohesion", "cohesion_z", "rarest_word", "ownership"]).sort_values("notes", ascending=False)
phrase_table["boilerplate"] = (phrase_table["cohesion_z"] <= args.phrase_max_z) & (phrase_table["ownership"] >= args.phrase_min_ownership)
boiler = phrase_table[phrase_table["boilerplate"]]
boiler_list = sorted(boiler["phrase"], key=len, reverse=True)
boiler = boiler[np.array([not any(p != q and p in q for q in boiler["phrase"]) for p in boiler["phrase"]], dtype=bool)]
print(f"\ncandidate phrases {len(phrase_table):,}  boilerplate (cohesion z <= {args.phrase_max_z}) {len(boiler_list):,}")
print("cohesion z percentiles (5/25/50/75/95):", np.round(np.percentile(phrase_table["cohesion_z"], [5, 25, 50, 75, 95]), 1).tolist())
print("\nlowest-cohesion phrases (boilerplate candidates):")
print(phrase_table.sort_values("cohesion_z").head(30)[["phrase", "notes", "cohesion_z", "rarest_word", "ownership", "boilerplate"]].to_string(index=False))

# %%
boiler_tokens = [p.split() for p in boiler_list]
by_first = defaultdict(list)
for toks in boiler_tokens:
    by_first[toks[0]].append(toks)


def strip_boilerplate(text):
    toks = text.split()
    keep = np.ones(len(toks), dtype=bool)
    for i, t in enumerate(toks):
        for ph in by_first.get(t, ()):
            if toks[i:i + len(ph)] == ph:
                keep[i:i + len(ph)] = False
    out = [t for t, k in zip(toks, keep) if k]
    return " ".join(out) if len(out) >= 2 else text


df["text_model"] = df["text_norm"]
df.loc[real_idx, "text_model"] = real_text.map(strip_boilerplate).values
max_tokens = int(np.ceil(df.loc[real_idx, "text_model"].str.split().str.len().quantile(args.length_quantile)))
df["truncated"] = (~df["is_template"]) & (df["text_model"].str.split().str.len() > max_tokens)
df.loc[df["truncated"], "text_model"] = df.loc[df["truncated"], "text_model"].str.split().str[:max_tokens].str.join(" ")
df["n_tokens_model"] = df["text_model"].str.split().str.len()
df["low_content"] = df["n_tokens_model"] < 2
print(f"\ntoken cap (P{int(args.length_quantile * 100)} of real notes after boilerplate removal): {max_tokens}")
print(f"notes changed by boilerplate removal: {(df.loc[real_idx, 'text_model'] != real_text.str.split().str[:max_tokens].str.join(' ')).sum():,}")
print(f"notes truncated: {int(df['truncated'].sum()):,}   low-content notes: {int(df['low_content'].sum()):,}")

