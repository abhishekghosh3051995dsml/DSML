cols = ["row_id", text_col, l1_col, "is_template", "template_core", "exact_dup_group", "near_dup_group",
        "text_norm", "text_model", "n_tokens_raw", "n_tokens_model", "truncated", "low_content"]
df[cols].to_csv(outdir / "l2_prepared.csv", index=False)
