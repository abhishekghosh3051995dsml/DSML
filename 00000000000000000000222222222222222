real = df.loc[real_idx]
impact = pd.DataFrame({
    "measure": ["mean tokens", "median tokens", "P95 tokens", "vocabulary size"],
    "before": [real["n_tokens_raw"].mean(), real["n_tokens_raw"].median(), real["n_tokens_raw"].quantile(.95),
               len(CountVectorizer(token_pattern=r"[a-z]{2,}").fit(real["text_norm"]).vocabulary_)],
    "after": [real["n_tokens_model"].mean(), real["n_tokens_model"].median(), real["n_tokens_model"].quantile(.95),
              len(CountVectorizer(token_pattern=r"[a-z]{2,}").fit(real["text_model"]).vocabulary_)],
}).round(1)
print("\ncleaning impact on real notes:")
print(impact.to_string(index=False))

source = df.assign(source=np.where(df["is_template"], "template", "real")).groupby([l1_col, "source"]).agg(
    rows=("row_id", "size"), unique_text=("text_norm", "nunique")).reset_index()
print("\nrows by L1 and source:")
print(source.to_string(index=False))

top_terms = (pd.Series(np.asarray(CountVectorizer(token_pattern=r"[a-z]{2,}", min_df=2).fit(real["text_model"]).transform(real["text_model"]).sum(axis=0)).ravel(),
                       index=CountVectorizer(token_pattern=r"[a-z]{2,}", min_df=2).fit(real["text_model"]).get_feature_names_out())
             .sort_values(ascending=False).head(40))
print("\ntop terms after cleaning:")
print(", ".join(f"{t} ({c})" for t, c in top_terms.items()))

