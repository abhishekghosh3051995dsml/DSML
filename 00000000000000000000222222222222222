style.to_csv(outdir / "template_style_check.csv")
source.to_csv(outdir / "rows_by_l1_source.csv", index=False)
impact.to_csv(outdir / "cleaning_impact.csv", index=False)
near_groups = (df[df["near_dup_group"] >= 0].groupby("near_dup_group").filter(lambda g: len(g) > 1)
