# metric names that were renamed between versions (same measure, new name)
METRIC_ALIASES = {"L2 accuracy": ("L2 accuracy, v8",), "L2 macro-F1": ("L2 macro-F1, v8",)}
# measures where a lower value is the better one
LOWER_IS_BETTER = ("rows routed to review", "rows in a domain-fallback L4", "test rows marked doubtful")
# only quality measures are compared between runs (row counts and baselines are context, not quality)
QUALITY_KEYWORDS = ("accuracy", "F1", "review", "fallback", "above the")
BASELINE_KEYWORDS = ("existing method", "one fixed L4")


def compare_with_baseline(path, metrics):
    """Every metric also present in an earlier run's manifest, with the change and whether it got worse."""
    if not path:
        return pd.DataFrame()
    try:
        before = json.loads(Path(path).read_text(encoding="utf-8"))["metrics"]
    except (OSError, ValueError, KeyError) as err:
        log.warning("baseline manifest %s not usable: %s", path, err)
        return pd.DataFrame()
    rows = []
    for name, value in metrics:
        if isinstance(value, str) or not any(k in name for k in QUALITY_KEYWORDS) or any(k in name for k in BASELINE_KEYWORDS):
            continue
        old = next((before[n] for n in (name,) + METRIC_ALIASES.get(name, ()) if n in before and not isinstance(before[n], str)), None)
        if old is None:
            continue
        delta = float(value) - float(old)
        worse = delta > 0 if name in LOWER_IS_BETTER else delta < 0
        rows.append({"metric": name, "baseline": old, "this_run": float(value), "change": delta, "worse": bool(worse and abs(delta) > 1e-9)})
    table = pd.DataFrame(rows)
    if len(table) and table["worse"].any():
        log.warning("compared with %s, these metrics got worse: %s", path, ", ".join(table.loc[table["worse"], "metric"]))
    elif len(table):
        log.info("compared with %s: no metric got worse (%d compared)", path, len(table))
    return table


def score_against_gold(path, final, level):
    gold = pd.read_csv(path, dtype=str, keep_default_na=False)
    if "row_id" not in gold.columns or "correct_L2" not in gold.columns:
        log.warning("gold file needs row_id and correct_L2 columns; skipped")
        return pd.DataFrame()
    gold["row_id"] = pd.to_numeric(gold["row_id"], errors="coerce")
    gold = gold.dropna(subset=["row_id"]).astype({"row_id": int}).merge(final, on="row_id")
    rows = []
    for level, truth, pred in (("L2", "correct_L2", "final_l2"), ("L4", "correct_L4", "final_l4")):
        if truth in gold.columns:
            g = gold[gold[truth].str.strip() != ""]
            k = int((g[truth].str.strip().str.upper() == g[pred].str.upper()).sum())
            lo, hi = wilson(k, len(g), z_value(level))
            rows.append({"level": level, "rows": len(g), "correct": k, "accuracy": k / len(g) if len(g) else np.nan, "ci95_low": lo, "ci95_high": hi})
            if "ref_l2" in g and level == "L2":
                k = int((g[truth].str.strip().str.upper() == g["ref_l2"].str.upper()).sum())
                lo, hi = wilson(k, len(g), z_value(level))
                rows.append({"level": "L2 (existing labels)", "rows": len(g), "correct": k, "accuracy": k / len(g), "ci95_low": lo, "ci95_high": hi})
    table = pd.DataFrame(rows)
    log.info("accuracy against the gold file:\n%s", table.round(3).to_string(index=False))
    return table


