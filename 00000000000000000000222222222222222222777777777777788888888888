# %% score mode
def score(cfg):
    bundle = joblib.load(cfg.model)
    tax = bundle["taxonomy"]
    raw, df, _, cols = load_input(cfg, tax)
    df["text_model"] = df["text_raw"].map(lambda t: prepare_text(t, bundle["artefacts"], bundle["id_min_length"], bundle["taxonomy"]))
    model = bundle["l2_model"]
    P = tax.constrain(model.predict_proba(df), model.classes_, df["l1"])
    df["final_l2"], df["l2_confidence"] = model.classes_[P.argmax(1)], P.max(1)
    df["final_l4"] = df["final_l2"].map(bundle["new_l2_default_l4"]).fillna("")
    l2_out, l4_out, _ = bundle["l4_model"].decide(df, P, list(model.classes_), bundle["joint_top_k"], bundle["joint_weight"])
    known = pd.Series(l2_out).isin(tax.l2_names).to_numpy()
    df.loc[known, "final_l2"], df.loc[known, "final_l4"] = l2_out[known], l4_out[known]
    df["l2_confidence"] = P[np.arange(len(df)), np.searchsorted(model.classes_, df["final_l2"])]
    df["needs_review"] = df["l2_confidence"] < bundle["review_bar"]
    out = Path(cfg.outdir)
    out.mkdir(parents=True, exist_ok=True)
    path = write_deliverable(raw, df, cols, out / f"{Path(cfg.input).stem}_intent.xlsx")
    df[["row_id", "final_l2", "final_l4", "l2_confidence", "needs_review"]].rename(
        columns={"final_l2": cols.l2, "final_l4": cols.l4}).to_csv(out / f"{Path(cfg.input).stem}_confidence.csv", index=False)
    log.info("scored %s rows with the model trained on %s; %.1f%% below the review bar; written %s", f"{len(df):,}",
             bundle["trained_on"], 100 * df["needs_review"].mean(), path)


# %% train mode
def train(cfg):
    started = time.perf_counter()
    rng = np.random.default_rng(cfg.seed)
    np.random.seed(cfg.seed)
    out = Path(cfg.outdir)
    report_dir, model_dir = out / "validation", out / "model"
    for d in (report_dir, model_dir, out / "prepared"):
        d.mkdir(parents=True, exist_ok=True)

    with stage("1/8 load"):
        tax = Taxonomy.load(cfg.taxonomy)
        raw, df, profile, cols = load_input(cfg, tax)
        unknown_l1 = sorted(set(df["l1"]) - set(tax.allowed)) if tax.allowed else []
        if unknown_l1:
            log.warning("L1 values with no routing entry (all L2 allowed): %s", unknown_l1)

    with stage("2/8 clean"):
        artefacts = clean(df, tax, cfg, rng)
        vocab_rows = df.attrs.get("vocab_rows", 0)
        df["group"] = df["near_dup_group"]
        cleaning = pd.DataFrame({"measure": ["mean tokens", "median tokens", "P95 tokens", "distinct texts"],
                                 "before": [df["n_tokens_raw"].mean(), df["n_tokens_raw"].median(), df["n_tokens_raw"].quantile(0.95), df["text_raw"].nunique()],
                                 "after": [df["n_tokens_model"].mean(), df["n_tokens_model"].median(), df["n_tokens_model"].quantile(0.95),
                                           df["text_model"].nunique()]}).round(2)
        df[["row_id", "text_raw", "l1", "near_dup_group", "text_norm", "text_model"]].to_csv(
            out / "prepared" / "prepared_rows.csv", index=False)

    with stage("3/8 representations"):
        emb = DomainEmbeddings(cfg).fit(df["text_model"].drop_duplicates().tolist())
        probes = [w for w in cfg.probe_words.split(",") if w.strip()] or \
            [w for w in emb.by_frequency if w not in ENGLISH_STOP_WORDS and w not in PLACEHOLDERS][:cfg.probe_count]
        for probe in [w for w in probes if w in emb.index]:
            log.debug("nearest to '%s': %s", probe, ", ".join(f"{w} {s:.2f}" for w, s in emb.neighbours(probe, 6)))
        rows_encoder = row_encoder(cfg, emb)
        word_vec = TfidfVectorizer(ngram_range=(1, 2), min_df=cfg.min_df, max_df=cfg.max_df, sublinear_tf=True,
                                   max_features=cfg.word_max_features).fit(df["text_model"])
        evidence = RuleEvidence(tax, cfg)
        feats = TextFeatures(word_vec, rows_encoder, df["text_model"].drop_duplicates().tolist(), sorted(df["l1"].unique()), cfg, evidence)
        log.info("features: word TF-IDF, char TF-IDF, L1%s%s, %d-dim row vectors", ", rule evidence" if feats.evidence else "",
                 ", first-clause TF-IDF" if feats.lead_vec is not None else "", cfg.emb_dims)

    with stage("4/8 labels: rule, name and semantic sources, then cleaning"):
        labels = build_labels(df, tax, emb, evidence, cfg)
        cleaner = LabelCleaner(tax, evidence, labels.name_vote, feats, cfg)
        clean_summary, clean_events, l4_merges = cleaner.run(df)

    with stage("5/8 L2 models"):
        train_rows, cal_rows, test_rows, labelled = split_labelled(df, cfg, tax.k)
        candidates, chosen, steps = compare_l2_models(train_rows, cal_rows, test_rows, feats, tax, cfg)
        y_cal, y_test = cal_rows["label_l2"].to_numpy(), test_rows["label_l2"].to_numpy()
        review_bar = coverage_at(chosen.cal_conf, chosen.cal_pred == y_cal, cfg.coverage_accuracy)[1]
        exact_bar = coverage_at(chosen.cal_conf, chosen.cal_pred == y_cal, cfg.high_precision)[1]
        route_bar = exact_bar if np.isfinite(exact_bar) else review_bar
        production, trained_rows = chosen.model, len(train_rows)
        if cfg.production_refit:
            refit = pd.concat([train_rows, test_rows[~test_rows["label_doubtful"]]], ignore_index=True)
            refit = distinct_rows(refit, "label_l2")
            production = L2Model(chosen.kind, feats, cfg).fit(refit, refit["label_l2"].to_numpy())
            trained_rows = len(refit)
            log.info("production %s model refitted on train + test: %s distinct texts (reported accuracy stays the held-out estimate)",
                     chosen.kind, f"{trained_rows:,}")
        P = tax.constrain(production.predict_proba(df), production.classes_, df["l1"])
        P_all = P
        df["pred_l2"], df["l2_confidence"] = production.classes_[P.argmax(1)], P.max(1)
        log.info("L2 predicted for all %s rows; %.1f%% above the %.0f%% bar (%.3f), %.1f%% above the %.0f%% bar (%.3f)", f"{len(df):,}",
                 100 * np.mean(df["l2_confidence"] >= review_bar), 100 * cfg.coverage_accuracy, review_bar,
                 100 * np.mean(df["l2_confidence"] >= exact_bar), 100 * cfg.high_precision, exact_bar)
        terms = top_terms_per_l2(train_rows, train_rows["label_l2"].to_numpy(), feats, cfg.top_terms)
        for r in terms.itertuples():
            log.info("  %-16s %s", r.L2, r.top_terms)

    with stage("6/8 L4 models"):
        l4_train = distinct_rows(train_rows[train_rows["label_l4"] != ""], "label_l4")
        l4_eval_model = L4Model(feats, tax, labels.prototypes, cfg).fit(l4_train, l4_train["label_l2"], l4_train["label_l4"])

        # joint L2 + L4 decision: the weight of log P(L4 | L2) is chosen on calibration rows; it may not lower L2 accuracy
        c4 = cal_rows[cal_rows["label_l4"] != ""]
        joint_rows, joint_weight = [], 0.0
        if len(c4):
            P_cal = tax.constrain(chosen.model.predict_proba(c4), chosen.model.classes_, c4["l1"])
            truth2, truth4 = c4["label_l2"].to_numpy(), c4["label_l4"].to_numpy()
            l2_0, l4_0, _ = l4_eval_model.decide(c4, P_cal, list(chosen.model.classes_), cfg.joint_top_k, 0.0)
            right_0 = (l2_0 == truth2) & (l4_0 == truth4)
            for w in sorted(set(pair(cfg.joint_weights, float)) | {0.0}):
                l2_d, l4_d, _ = l4_eval_model.decide(c4, P_cal, list(chosen.model.classes_), cfg.joint_top_k, w)
                right = (l2_d == truth2) & (l4_d == truth4)
                gained, lost = int((right & ~right_0).sum()), int((~right & right_0).sum())
                joint_rows.append({"weight_of_log_P_L4": w, "calibration_L2_accuracy": np.mean(l2_d == truth2),
                                   "calibration_L2_and_L4_correct": right.mean(), "gained_vs_L2_first": gained, "lost_vs_L2_first": lost,
                                   "mcnemar_p": binomtest(gained, gained + lost, 0.5).pvalue if gained + lost else 1.0})
            joint_table = pd.DataFrame(joint_rows)
            # a non-zero weight is used only if it beats L2-first significantly and does not lower L2 accuracy
            floor = np.mean(l2_0 == truth2) - cfg.joint_l2_tolerance
            allowed = joint_table[(joint_table["calibration_L2_accuracy"] >= floor) & (joint_table["mcnemar_p"] < cfg.joint_significance)
                                  & (joint_table["gained_vs_L2_first"] > joint_table["lost_vs_L2_first"])]
            joint_weight = float(allowed.sort_values(["calibration_L2_and_L4_correct", "weight_of_log_P_L4"], ascending=[False, True])
                                 ["weight_of_log_P_L4"].iloc[0]) if len(allowed) else 0.0
            log.info("joint L2 + L4 decision on calibration rows:\n%s\nchosen weight %.2f", joint_table.round(4).to_string(index=False), joint_weight)
        else:
            joint_table = pd.DataFrame()

        t4 = test_rows[test_rows["label_l4"] != ""]
        l4_eval, l4_per_class = pd.DataFrame(), pd.DataFrame()
        if len(t4):
            truth = t4["label_l4"].to_numpy()
            given_true = l4_eval_model.predict(t4, t4["label_l2"])[0]
            P_t4 = tax.constrain(chosen.model.predict_proba(t4), chosen.model.classes_, t4["l1"])
            plain_l2, plain_l4, _ = l4_eval_model.decide(t4, P_t4, list(chosen.model.classes_), cfg.joint_top_k, 0.0)
            t4_l2, end_to_end, _ = l4_eval_model.decide(t4, P_t4, list(chosen.model.classes_), cfg.joint_top_k, joint_weight)
            one_per_l2 = l4_train.groupby("label_l2")["label_l4"].agg(lambda s: s.value_counts().index[0])
            l2_truth = t4["label_l2"].to_numpy()
            l4_eval = pd.DataFrame([
                {"measure": "L4 accuracy, one fixed L4 per L2", "value": np.mean(t4["label_l2"].map(one_per_l2).to_numpy() == truth)},
                {"measure": "L4 accuracy given the correct L2", "value": np.mean(given_true == truth)},
                {"measure": "L4 macro-F1 given the correct L2", "value": f1_score(truth, given_true.astype(str), average="macro")},
                {"measure": "L2 and L4 both correct, L2 first", "value": np.mean((plain_l2 == l2_truth) & (plain_l4 == truth))},
                {"measure": "L2 and L4 both correct (end to end)", "value": np.mean((t4_l2 == l2_truth) & (end_to_end == truth))},
                {"measure": "L4 accuracy (end to end)", "value": np.mean(end_to_end == truth)},
                {"measure": "L4 macro-F1 (end to end)", "value": f1_score(truth, end_to_end.astype(str), average="macro")},
                {"measure": "joint decision weight", "value": joint_weight},
                {"measure": "held-out rows with an L4 label", "value": len(t4)}])
            names = sorted(set(truth))
            p, r, f, s = precision_recall_fscore_support(truth, given_true.astype(str), labels=names, zero_division=0)
            l4_per_class = pd.DataFrame({"L4": names, "L2": [tax.l4_parent[x] for x in names], "test_rows": s, "precision": p, "recall": r, "F1": f})
            log.info("L4 on held-out rows:\n%s", l4_eval.round(4).to_string(index=False))
        l4_base = pd.concat([l4_train, t4], ignore_index=True) if cfg.production_refit else l4_train
        if cfg.production_refit:
            l4_base = l4_base[~l4_base["label_doubtful"]]
        l4_model = L4Model(feats, tax, labels.prototypes, cfg).fit(l4_base, l4_base["label_l2"], l4_base["label_l4"]) \
            if cfg.production_refit else l4_eval_model

    with stage("7/8 topic discovery, new L2 and new L4"):
        topics = discover_topics(df, rows_encoder, tax, cfg, rng)
        promo = promote_new_l2(topics, df, feats, tax, cfg)
        df["final_l2"] = df["pred_l2"].astype(object)
        final_model, new_eval = production, pd.DataFrame()
        new_default_l4 = {}
        if len(promo["mapping"]):
            expanded = df.assign(target=df["row_id"].map(promo["mapping"]).fillna(df["label_l2"]))
            expanded = expanded[expanded["target"] != ""].reset_index(drop=True)
            dev_idx, test_idx = grouped_split(expanded, cfg.test_share, cfg.seed)
            dev, exp_test = distinct_rows(expanded.iloc[dev_idx], "target"), expanded.iloc[test_idx]
            exp_model = L2Model(chosen.kind, feats, cfg).fit(dev, dev["target"].to_numpy())
            P = tax.constrain(exp_model.predict_proba(exp_test), exp_model.classes_, exp_test["l1"])
            pred, truth = exp_model.classes_[P.argmax(1)], exp_test["target"].to_numpy()
            new_eval = pd.DataFrame([{"L2_classes": len(exp_model.classes_), "new_L2": len(promo["names"]), "test_rows": len(exp_test),
                                      "accuracy": np.mean(pred == truth), "macro_F1": f1_score(truth, pred, average="macro")}])
            if cfg.production_refit:
                everything = distinct_rows(expanded, "target")
                final_model = L2Model(chosen.kind, feats, cfg).fit(everything, everything["target"].to_numpy())
            else:
                final_model = exp_model
            P = tax.constrain(final_model.predict_proba(df), final_model.classes_, df["l1"])
            P_all = P
            df["final_l2"], df["l2_confidence"] = final_model.classes_[P.argmax(1)], P.max(1)
            members = df["row_id"].isin(promo["mapping"].index)
            df.loc[members, "final_l2"] = df.loc[members, "row_id"].map(promo["mapping"]).to_numpy()
            new_default_l4 = promo["sub_l4"].groupby(promo["mapping"]).agg(lambda s: s.value_counts().index[0]).to_dict()
            log.info("L2 extended with %d new classes (%s): accuracy %.3f, macro-F1 %.3f on %s held-out rows", len(promo["names"]),
                     ", ".join(promo["names"]), new_eval["accuracy"].iloc[0], new_eval["macro_F1"].iloc[0], f"{len(exp_test):,}")

        # discovered L4 inside known L2: a cluster the L4 model already places in one existing L4 stays there;
        # otherwise its rows become training rows of a new L4, so score mode learns it like any taxonomy L4
        l4_parent = dict(tax.l4_parent)
        new_l4 = promo["new_l4"].copy()
        row_cluster = topics["row_cluster"]
        keep = []
        for r in new_l4.itertuples():
            rows = df[df["row_id"].map(row_cluster).eq(r.cluster).to_numpy()]
            guess = pd.Series(l4_model.predict(rows, np.full(len(rows), r.L2))[0]).value_counts(normalize=True)
            keep.append(len(guess) > 0 and guess.iloc[0] < cfg.known_purity)
            if not keep[-1] and len(guess):
                log.info("cluster %s stays in existing L4 %s (%.0f%% of its rows)", r.name, guess.index[0], 100 * guess.iloc[0])
        new_l4 = new_l4[keep] if len(new_l4) else new_l4
        if len(new_l4):
            new_l4["L4"] = [n if l4_parent.get(n, l2) == l2 else f"{n}_{l2}" for n, l2 in zip(new_l4["name"], new_l4["L2"])]
            l4_parent.update(dict(zip(new_l4["L4"], new_l4["L2"])))
            rows = df[df["row_id"].map(row_cluster).isin(new_l4["cluster"]).to_numpy()].copy()
            by_cluster = new_l4.set_index("cluster")
            rows["label_l2"] = rows["row_id"].map(row_cluster).map(by_cluster["L2"]).to_numpy()
            rows["label_l4"] = rows["row_id"].map(row_cluster).map(by_cluster["L4"]).to_numpy()
            df.loc[rows.index, "final_l2"] = rows["label_l2"]
            l4_with_new = pd.concat([l4_base, distinct_rows(rows, "label_l4")], ignore_index=True)
            l4_model = L4Model(feats, tax, labels.prototypes, cfg).fit(l4_with_new, l4_with_new["label_l2"], l4_with_new["label_l4"])
            log.info("L4 model refitted with %d discovered L4 (%s rows): %s", len(new_l4), f"{len(rows):,}",
                     ", ".join(f"{a} under {b}" for a, b in zip(new_l4["L4"], new_l4["L2"])))

    with stage("8/8 L4, outputs and validation"):
        df["final_l4"], df["l4_confidence"] = "", np.nan
        promoted = df["row_id"].isin(promo["mapping"].index).to_numpy() if len(promo["mapping"]) else np.zeros(len(df), bool)
        l2_out, l4_out, c4_out = l4_model.decide(df, P_all, list(final_model.classes_), cfg.joint_top_k, joint_weight)
        use = pd.Series(l2_out).isin(tax.l2_names).to_numpy() & ~promoted & df["final_l2"].isin(tax.l2_names).to_numpy()
        changed_by_joint = use & (l2_out != df["final_l2"].to_numpy())
        df.loc[use, "final_l2"], df.loc[use, "final_l4"], df.loc[use, "l4_confidence"] = l2_out[use], l4_out[use], c4_out[use]
        df["l2_confidence"] = P_all[np.arange(len(df)), np.searchsorted(final_model.classes_, df["final_l2"])] \
            if set(df["final_l2"]) <= set(final_model.classes_) else df["l2_confidence"]
        known = df["final_l2"].isin(tax.l2_names).to_numpy()
        log.info("joint decision (weight %.2f): %s rows took a different L2 than L2-first; domain-fallback L4 on %s rows (%.1f%%)",
                 joint_weight, f"{changed_by_joint.sum():,}", f"{df['final_l4'].isin(tax.fallback).sum():,}",
                 100 * df["final_l4"].isin(tax.fallback).mean())
        if (~known).any():
            df.loc[~known, "final_l4"] = (df.loc[~known, "row_id"].map(promo["sub_l4"]).fillna(df.loc[~known, "final_l2"].map(new_default_l4))
                                          .fillna(df.loc[~known, "final_l2"]).to_numpy())
        df["needs_review"] = (df["l2_confidence"] < route_bar) | ~df["has_content"]

        problems = []
        if len(df) != len(raw):
            problems.append("row count changed")
        if not (df["l1"].to_numpy() == raw[cols.l1].to_numpy()).all():
            problems.append("an L1 value changed")
        if df["final_l2"].fillna("").eq("").any() or df["final_l4"].fillna("").eq("").any():
            problems.append("a row has no L2 or no L4")
        inconsistent = df["final_l2"].isin(tax.l2_names) & (df["final_l4"].map(l4_parent) != df["final_l2"])
        if inconsistent.any():
            problems.append(f"{int(inconsistent.sum())} rows have an L4 outside their L2")
        if problems:
            raise SystemExit("integrity check failed: " + "; ".join(problems))
        log.info("integrity checks passed: %s rows, every original column unchanged, every row has an L2 and an L4 under it", f"{len(df):,}")
        deliverable = write_deliverable(raw, df, cols, out / f"{Path(cfg.input).stem}_intent.xlsx")
        log.info("review routing: %s rows (%.1f%%) below the %.0f%% bar %.3f or with no issue words", f"{df['needs_review'].sum():,}",
                 100 * df["needs_review"].mean(), 100 * cfg.high_precision, route_bar)

        pred_cols = ["row_id", "text_raw", "l1"] + [c for c in ("ref_l2", "ref_l4") if c in df] + \
                    ["label_l2_initial", "label_l4_initial", "label_l2", "label_l4", "label_action", "label_source", "sources_agreeing",
                     "final_l2", "final_l4", "l2_confidence", "l4_confidence", "needs_review"]
        df[pred_cols].rename(columns={"final_l2": cols.l2, "final_l4": cols.l4, "text_raw": cols.text}).to_csv(
            report_dir / "predictions_all_rows.csv", index=False)

        joblib.dump({"l2_model": final_model, "l4_model": l4_model, "joint_weight": joint_weight, "joint_top_k": cfg.joint_top_k,
                     "l4_merges": cleaner.merges, "taxonomy": tax, "review_bar": route_bar,
                     "new_l2_default_l4": new_default_l4, "artefacts": {k: artefacts[k] for k in ("markers", "phrase_index", "boilerplate")},
                     "id_min_length": cfg.id_min_length, "trained_on": Path(cfg.input).name}, model_dir / "intent_model.joblib")

        correct = chosen.test_pred == y_test
        names = sorted(set(y_test) | set(chosen.test_pred))
        p, r, f, s = precision_recall_fscore_support(y_test, chosen.test_pred, labels=names, zero_division=0)
        per_l2 = pd.DataFrame({"L2": names, "test_rows": s, "precision": p, "recall": r, "F1": f})
        confusion = pd.DataFrame(confusion_matrix(y_test, chosen.test_pred, labels=names), index=names, columns=names).reset_index().rename(
            columns={"index": "label \\ predicted"})
        grid = np.unique(np.floor(np.quantile(chosen.test_conf, np.linspace(0, 1, cfg.confidence_grid, endpoint=False)) * 1000) / 1000)
        acc_conf = pd.DataFrame({"min_confidence": grid, "share_of_rows": [np.mean(chosen.test_conf >= g) for g in grid],
                                 "accuracy": [correct[chosen.test_conf >= g].mean() for g in grid]})
        boot_rng = np.random.default_rng(cfg.seed)
        boot = [correct[idx].mean() for idx in (boot_rng.integers(0, len(correct), len(correct)) for _ in range(cfg.bootstrap))]
        at_bar = chosen.test_conf >= exact_bar
        gold = score_against_gold(cfg.gold, df, cfg.confidence_level) if cfg.gold else pd.DataFrame()
        comparison = compare_with_reference(df, tax, cfg, rng)

        initial_labels = test_rows["label_l2_initial"].to_numpy()
        untouched = (test_rows["label_action"] == "").to_numpy() & (test_rows["sources_agreeing"].to_numpy() >= cfg.confirm_sources)
        metrics = [("rows", len(df)), ("rows with a statistical label", len(labelled)), ("held-out test rows", len(test_rows)),
                   ("L2 model selected", chosen.kind), ("L2 production training texts", trained_rows),
                   ("L2 accuracy, existing method", candidates[0].row["accuracy"]), ("L2 accuracy", correct.mean()),
                   (f"L2 accuracy {cfg.confidence_level:.0%} CI low", np.percentile(boot, 50 * (1 - cfg.confidence_level))),
                   (f"L2 accuracy {cfg.confidence_level:.0%} CI high", np.percentile(boot, 50 * (1 + cfg.confidence_level))),
                   ("L2 macro-F1", chosen.row["macro_F1"]),
                   ("L2 accuracy against the labels before cleaning", np.mean(chosen.test_pred == initial_labels)),
                   ("L2 accuracy on consensus rows (label untouched, sources agree)", correct[untouched].mean() if untouched.any() else np.nan),
                   ("share of test rows that are consensus rows", untouched.mean()),
                   ("test rows marked doubtful", test_rows["label_doubtful"].mean()),
                   (f"test rows above the {cfg.high_precision:.0%} bar set on calibration", at_bar.mean()),
                   ("accuracy of those rows", correct[at_bar].mean() if at_bar.any() else np.nan)]
        if len(l4_eval):
            metrics += list(zip(l4_eval["measure"], l4_eval["value"]))
        if len(new_eval):
            metrics += [("L2 accuracy with new L2", new_eval["accuracy"].iloc[0]), ("L2 macro-F1 with new L2", new_eval["macro_F1"].iloc[0])]
        metrics += [("rows routed to review", df["needs_review"].mean()), ("L2 classes in output", df["final_l2"].nunique()),
                    ("L4 classes in output", df["final_l4"].nunique()), ("new L2 found in the data", len(promo["names"])),
                    ("new L4 found in the data", len(new_l4)),
                    ("rows in a domain-fallback L4", df["final_l4"].isin(tax.fallback).mean()),
                    ("L4 merged for too little data", len(cleaner.merges))]
        summary = pd.DataFrame(metrics, columns=["metric", "value"])
        regression = compare_with_baseline(cfg.baseline_manifest, metrics)
        log.info("summary:\n%s", summary.to_string(index=False))

        l2_key, l4_key = build_keys(df, tax, promo["names"])
        f1_of = (promo["gate"] if len(promo["gate"]) else per_l2).set_index("L2")["F1"]
        l2_key["F1"] = l2_key["name"].map(f1_of)
        if not topics["clusters"].empty or df["has_content"].any():
            pick = sample_for_map(df, cfg, rng)
            layouts, _ = map_layouts(pick, final_model, l4_model, rows_encoder, tax, cfg)
            write_map(pick, layouts, ["l2", "text"], "final_l2", l2_key, "Intent L2 clusters",
                      f"{len(pick):,} distinct texts from {len(df):,} rows · {len(l2_key)} L2 · ★ = cluster centroid", report_dir / "l2_map_3d.html")
            write_map(pick, layouts, ["l4", "text"], "final_l4", l4_key, "Intent L4 clusters",
                      f"{len(pick):,} distinct texts from {len(df):,} rows · {len(l4_key)} L4, coloured within their L2 · ★ = cluster centroid",
                      report_dir / "l4_map_3d.html")
            points = pick[["row_id", "final_l2", "final_l4"]].copy()
            for name, lay in layouts.items():
                for i, axis in enumerate("xyz"):
                    points[f"{name}_{axis}"] = lay["xyz"][:, i]
            points.to_csv(report_dir / "map_points.csv", index=False)
            log.info("interactive 3D maps written: l2_map_3d.html, l4_map_3d.html")
        draw_charts(steps, acc_conf, cfg, report_dir)

        distribution = df.groupby(["final_l2", "final_l4"]).size().rename("rows").reset_index().sort_values(["final_l2", "rows"], ascending=[True, False])
        methods = methods_register(cfg, tax, {"vocab_rows": int(vocab_rows), "semantic_decision": labels.sources.set_index("label_source").at["semantic_similarity", "decision"],
                                              "review_bar": f"confidence {route_bar:.3f} for {cfg.high_precision:.0%} accuracy"})
        sheets = [("Summary", summary), ("Methods", methods), ("Taxonomy_reference", tax.reference_table()), ("Data_profile", profile.reset_index().rename(columns={"index": "column"})), ("Cleaning", cleaning),
                  ("Label_sources", labels.sources), ("Source_agreement", labels.agreement), ("Semantic_prototypes", labels.prototype_report),
                  ("Taxonomy_rule_hits", labels.rule_hits), ("L2_models", steps), ("L2_per_class", per_l2), ("L2_confusion", confusion),
                  ("L2_accuracy_vs_confidence", acc_conf), ("L2_top_terms", terms), ("L4_evaluation", l4_eval), ("L4_per_class", l4_per_class), ("Joint_decision", joint_table),
                  ("Label_cleaning", clean_summary), ("Label_changes", clean_events.head(cfg.disagreement_sample * 5)),
                  ("L4_merges", l4_merges), ("Regression_check", regression),
                  ("L2_L4_distribution", distribution), ("L2_key", l2_key), ("L4_key", l4_key)]
        sheets += list(comparison.items())
        sheets += [("Cluster_verdicts", topics["verdicts"]), ("Clusters", topics["clusters"]),
                   ("Data_driven_bars", pd.DataFrame(list(promo["bars"].items()), columns=["bar", "value"])),
                   ("New_L2_gate", promo["gate"]), ("New_L2_evaluation", new_eval), ("New_L4_found", new_l4),
                   ("Phrasing_words", topics["word_roles"][topics["word_roles"]["phrasing_word"]]),
                   ("Boilerplate_phrases", artefacts["phrase_table"]), ("Gold_check", gold)]
        with pd.ExcelWriter(report_dir / "validation.xlsx", engine="openpyxl") as xw:
            for name, frame in sheets:
                frame.to_excel(xw, sheet_name=name[:31], index=False)

        manifest = {"input": str(Path(cfg.input).resolve()), "input_sha256": hashlib.sha256(Path(cfg.input).read_bytes()).hexdigest(),
                    "taxonomy_sha256": hashlib.sha256(Path(cfg.taxonomy).read_bytes()).hexdigest(),
                    "seconds": round(time.perf_counter() - started, 1), "settings": vars(cfg),
                    "versions": {"python": platform.python_version(), "numpy": np.__version__, "pandas": pd.__version__,
                                 "scikit-learn": sklearn.__version__, "scipy": scipy.__version__},
                    "metrics": {m: (v if isinstance(v, str) else float(v)) for m, v in metrics}}
        (out / "run_manifest.json").write_text(json.dumps(manifest, indent=2, default=str), encoding="utf-8")
    log.info("finished in %.0fs, deliverable %s", time.perf_counter() - started, deliverable)


# %% entry point
def setup_logging(outdir, level):
    Path(outdir).mkdir(parents=True, exist_ok=True)
    fmt = logging.Formatter("%(asctime)s %(levelname)-7s %(message)s", "%H:%M:%S")
    log.setLevel(logging.DEBUG)
    log.handlers.clear()
    console = logging.StreamHandler(sys.stdout)
    console.setLevel(level)
    logfile = logging.FileHandler(Path(outdir) / "run.log", mode="w", encoding="utf-8")
    logfile.setLevel(logging.DEBUG)
    for handler in (console, logfile):
        handler.setFormatter(fmt)
        log.addHandler(handler)


def main(argv=None):
    cfg, _ = build_parser().parse_known_args(argv)
    setup_logging(cfg.outdir, cfg.log_level)
    log.info("NORA intent labelling %s | mode %s | output %s", VERSION, cfg.mode, cfg.outdir)
    if cfg.mode == "score":
        if not cfg.model:
            raise SystemExit("--mode score needs --model <path to intent_model.joblib>")
        score(cfg)
    else:
        train(cfg)


if __name__ == "__main__":
    main()
