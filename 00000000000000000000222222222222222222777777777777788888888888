def sample_for_map(frame, cfg, rng):
    """Distinct texts for the maps; every L4 gets at least --map-min-per-class of them so small classes are visible."""
    with_content = frame[frame["has_content"]].drop_duplicates("text_model")
    per_class = with_content.groupby("final_l4").head(cfg.map_min_per_class).index
    rest = with_content.index.difference(per_class)
    extra = rng.choice(rest, size=min(len(rest), max(0, cfg.map_points - len(per_class))), replace=False) if len(rest) else []
    return frame.loc[np.concatenate([per_class.to_numpy(), np.asarray(extra, dtype=per_class.dtype)])]


def embed_3d(X, cfg):
    """3D embedding: UMAP when installed, otherwise Barnes-Hut t-SNE (PCA initialised, fixed seed)."""
    X = np.asarray(X, dtype=float)
    if X.shape[1] > 30:
        X = PCA(n_components=30, random_state=cfg.seed).fit_transform(X)
    try:
        import umap
        return umap.UMAP(n_components=3, n_neighbors=cfg.umap_neighbours, min_dist=0.1, random_state=cfg.seed, n_jobs=1).fit_transform(X), "UMAP"
    except ImportError:
        tsne = TSNE(n_components=3, perplexity=min(cfg.tsne_perplexity, max(5, (len(X) - 1) / 3)), init="pca",
                    max_iter=cfg.tsne_iterations, random_state=cfg.seed)
        return tsne.fit_transform(X), "t-SNE"


def to_box(xyz):
    """Scale each axis into [-1, 1] for drawing (1st-99th percentile), keeping the original range for the tick labels."""
    q_lo, q_hi = MAP_LAYOUT["axis_quantiles"]
    lo, hi = np.quantile(xyz, q_lo, axis=0), np.quantile(xyz, q_hi, axis=0)
    span = np.where(hi > lo, hi - lo, 1.0)
    clip = MAP_LAYOUT["axis_clip"]
    return np.clip((xyz - lo) / span * 2 - 1, -clip, clip), [[float(a), float(b)] for a, b in zip(lo, hi)]


def classical_mds(D, dims, iterations, tol):
    """Metric MDS: Torgerson classical MDS as the start, then SMACOF stress majorisation (de Leeuw 1977).
    Classical MDS alone keeps only the top eigen-directions, which squeezes many classes into a few arms;
    SMACOF then places every class so its distances to all the others match D as closely as possible.
    Deterministic and dependency-free."""
    n = len(D)
    J = np.eye(n) - np.ones((n, n)) / n
    B = -0.5 * J @ (D ** 2) @ J
    values, vectors = np.linalg.eigh(B)
    top = np.argsort(values)[::-1][:dims]
    X = vectors[:, top] * np.sqrt(np.clip(values[top], PROB_FLOOR, None))
    previous = np.inf
    for _ in range(iterations):
        dist = np.sqrt(((X[:, None, :] - X[None, :, :]) ** 2).sum(-1))
        stress = ((dist - D)[np.triu_indices(n, 1)] ** 2).sum()
        if previous - stress < tol * max(previous, PROB_FLOOR):
            break
        previous = stress
        ratio = np.where(dist > PROB_FLOOR, D / np.maximum(dist, PROB_FLOOR), 0.0)
        Bx = -ratio
        np.fill_diagonal(Bx, 0.0)
        np.fill_diagonal(Bx, -Bx.sum(1))
        X = Bx @ X / n
    return X


def class_anchors(P, labels, names, cfg):
    """One 3D anchor per class by metric MDS (classical start + SMACOF) on the Hellinger distance between class-mean probability vectors:
    classes the model confuses get nearby anchors, well separated classes far apart. Scaled to unit RMS radius."""
    centroids = np.vstack([np.sqrt(P[labels == n]).mean(0) if (labels == n).any() else np.zeros(P.shape[1]) for n in names])
    D = np.sqrt(((centroids[:, None, :] - centroids[None, :, :]) ** 2).sum(-1))
    if len(names) <= 3:
        A = np.eye(3)[:len(names)]
    else:
        A = classical_mds(D, 3, cfg.mds_iterations, cfg.mds_tolerance)
    A = A - A.mean(0)
    return A / max(np.sqrt((A ** 2).sum(1).mean()), 1e-9)


def map_layouts(pick, l2_model, l4_model, rows_encoder, tax, cfg):
    """3D layouts of the same rows.
    Model views: every class has an anchor (class_anchors); each row sits at its probability-weighted mix of anchors,
    so confident rows gather at their class and uncertain rows fall between the classes they are torn between. A small
    offset from the row's own text (first 3 principal components) shows the variety inside a class. L4 anchors sit
    around their L2's anchor, so the L4 map keeps the hierarchy.
    Text view: t-SNE (UMAP if installed) of the text vectors alone, before any model."""
    P2 = tax.constrain(l2_model.predict_proba(pick), l2_model.classes_, pick["l1"])
    P4, l4_names = l4_model.joint_proba(pick, P2, l2_model.classes_)
    l2_names = list(l2_model.classes_)
    text = rows_encoder.transform(pick["content"])
    texture = PCA(n_components=3, random_state=cfg.seed).fit_transform(text)
    texture = texture / max(np.quantile(np.abs(texture), MAP_LAYOUT["texture_quantile"]), PROB_FLOOR)

    A2 = class_anchors(P2, pick["final_l2"].to_numpy(), l2_names, cfg)
    gap = np.sort(np.sqrt(((A2[:, None] - A2[None]) ** 2).sum(-1)), axis=1)[:, 1].min() if len(A2) > 1 else 1.0
    parent = {n: tax.l4_parent.get(n, n) for n in l4_names}
    A4 = np.zeros((len(l4_names), 3))
    for j, l2 in enumerate(l2_names):
        kids = [i for i, n in enumerate(l4_names) if parent[n] == l2]
        if not kids:
            continue
        local = class_anchors(P4[:, kids], pick["final_l4"].to_numpy(), [l4_names[i] for i in kids], cfg) if len(kids) > 1 else np.zeros((1, 3))
        A4[kids] = A2[j] + MAP_LAYOUT["l4_anchor_share"] * gap * local
    layouts = {}
    for key, xyz, label, about, spread in (
            ("l2", P2 @ A2, "Model view: L2 clusters", "each row placed by its L2 probabilities; tight cluster = confident, between clusters = uncertain", MAP_LAYOUT["texture_share"]["l2"]),
            ("l4", P4 @ A4, "Model view: L4 clusters", "each row placed by its L4 probabilities; L4 clusters sit around their L2", MAP_LAYOUT["texture_share"]["l4"])):
        box, bounds = to_box(xyz + spread * gap * texture)
        layouts[key] = {"xyz": box, "bounds": bounds, "label": label, "about": about, "axes": ["Component 1", "Component 2", "Component 3"]}
    started = time.perf_counter()
    xyz, method = embed_3d(text, cfg)
    box, bounds = to_box(xyz)
    layouts["text"] = {"xyz": box, "bounds": bounds, "label": "Text view: raw similarity", "axes": [f"{method} {i}" for i in (1, 2, 3)],
                       "about": "positions from the words alone, before any model; overlap here is real overlap in how agents write"}
    log.info("3D layouts: model views by probability-weighted class anchors (MDS), text view by %s in %.0fs", method, time.perf_counter() - started)
    return layouts, l4_names


def hsl(h, s, l):
    """HSL (degrees, 0-1, 0-1) to a hex colour."""
    a = s * min(l, 1 - l)

    def f(n):
        k = (n + h / 30) % 12
        return round(255 * (l - a * max(-1, min(k - 3, 9 - k, 1))))

    return "#{:02x}{:02x}{:02x}".format(f(0), f(8), f(4))


def write_map(pick, layouts, order, level, key, title, subtitle, path):
    """Self-contained interactive 3D map (no libraries, works offline)."""
    classes = [{"name": r.name, "number": int(r.number), "color": r.color, "count": int(r.rows), "group": r.group, "isNew": bool(r.new)}
               for r in key.itertuples()]
    index = {c["name"]: i for i, c in enumerate(classes)}
    keep = pick[level].isin(index).to_numpy()
    cls = pick.loc[keep, level].map(index).to_numpy()
    meta = [[html.escape(str(t)[:160]), html.escape(f"{a} / {b}"), f"{c:.2f}"]
            for t, a, b, c in zip(pick.loc[keep, "text_raw"], pick.loc[keep, "final_l2"], pick.loc[keep, "final_l4"], pick.loc[keep, "l2_confidence"])]
    out = {}
    for name in order:
        lay = layouts[name]
        xyz = lay["xyz"][keep]
        centres = [None] * len(classes)
        for k in np.unique(cls):
            centres[k] = [round(float(v), 3) for v in np.median(xyz[cls == k], axis=0)]
        out[name] = {"points": np.round(xyz, 3).tolist(), "centers": centres, "bounds": lay["bounds"], "axes": lay["axes"],
                     "label": lay["label"], "about": lay["about"]}
    data = json.dumps({"layouts": out, "cls": cls.tolist(), "meta": meta, "classes": classes, "subtitle": subtitle,
                       "groupLabel": "L2" if level == "final_l4" else "classes"}, separators=(",", ":"))
    page = VIEWER.replace("__TITLE__", html.escape(title)).replace("__SUBTITLE__", html.escape(subtitle)).replace("__DATA__", data.replace("</", "<\\/"))
    Path(path).write_text(page, encoding="utf-8")


def build_keys(final, tax, new_l2):
    """Number and colour every L2 and L4. L4 colours share their L2's hue, so the hierarchy is visible."""
    l2_counts = final["final_l2"].value_counts()
    l2 = pd.DataFrame({"name": l2_counts.index, "rows": l2_counts.values})
    l2["new"] = l2["name"].isin(new_l2)
    l2 = l2.sort_values(["new", "rows"], ascending=[True, False]).reset_index(drop=True)
    l2["number"] = np.arange(1, len(l2) + 1)
    # golden-angle hue steps keep neighbouring numbers far apart in colour, even with 25+ classes
    pal = MAP_PALETTE
    hues = {n: (i * pal["golden_angle"]) % 360 for i, n in enumerate(l2["name"])}
    l2["color"] = [hsl(hues[n], pal["l2_saturation"], pal["l2_lightness"][i % 2]) if not new
                   else hsl(0, pal["new_saturation"], pal["new_lightness"])
                   for i, (n, new) in enumerate(zip(l2["name"], l2["new"]))]
    l2["group"] = "L2"

    l4_counts = final.groupby(["final_l2", "final_l4"]).size().rename("rows").reset_index()
    l4_counts["l2_number"] = l4_counts["final_l2"].map(l2.set_index("name")["number"])
    l4 = l4_counts.sort_values(["l2_number", "rows"], ascending=[True, False]).reset_index(drop=True)
    l4["number"] = np.arange(1, len(l4) + 1)
    colours = []
    for parent, block in l4.groupby("final_l2", sort=False):
        n = len(block)
        spread = min(pal["l4_max_hue_step"], pal["l4_hue_band"] / max(n, 1))
        for j in range(n):
            light = pal["l4_lightness_start"] + pal["l4_lightness_span"] * (j / max(n - 1, 1))
            hue = (hues[parent] + (j - (n - 1) / 2) * spread) % 360
            colours.append(hsl(0, pal["new_saturation"], light) if parent in new_l2 else hsl(hue, pal["l4_saturation"], light))
    l4["color"] = colours
    l4 = l4.rename(columns={"final_l4": "name", "final_l2": "group"})
    l4["new"] = ~l4["name"].isin(tax.l4_parent)
    return l2, l4[["name", "group", "rows", "number", "color", "new"]]


# %% comparison with existing labels
def compare_with_reference(final, tax, cfg, rng):
    """Side by side with the labels already in the file. Our labels are also mapped onto the earlier scheme
    (taxonomy 'legacy_scheme') so agreement is measured like for like. Where the two disagree, the rows are
    listed with the rule evidence behind our label, for a spot check."""
    sheets = {}
    if "ref_l2" not in final:
        return sheets
    f = final.copy()
    f["new_as_legacy_l2"] = [tax.legacy_l2(a, b) for a, b in zip(f["final_l2"], f["final_l4"])]
    has_ref = f["ref_l2"] != ""
    rows = [{"measure": "rows with an existing L2", "value": int(has_ref.sum())},
            {"measure": "L2 agreement (same name)", "value": (f.loc[has_ref, "ref_l2"] == f.loc[has_ref, "final_l2"]).mean()},
            {"measure": "L2 agreement after mapping onto the existing scheme", "value": (f.loc[has_ref, "ref_l2"] == f.loc[has_ref, "new_as_legacy_l2"]).mean()},
            {"measure": "existing distinct L2", "value": f.loc[has_ref, "ref_l2"].nunique()},
            {"measure": "new distinct L2", "value": f["final_l2"].nunique()}]
    if "ref_l4" in f:
        f["new_as_legacy_l4"] = [tax.legacy_l4(a, b) for a, b in zip(f["final_l2"], f["final_l4"])]
        has4 = f["ref_l4"] != ""
        rows += [{"measure": "L4 agreement after mapping onto the existing scheme", "value": (f.loc[has4, "ref_l4"] == f.loc[has4, "new_as_legacy_l4"]).mean()},
                 {"measure": "existing distinct L4", "value": f.loc[has4, "ref_l4"].nunique()},
                 {"measure": "new distinct L4", "value": f["final_l4"].nunique()},
                 {"measure": "existing rows whose L4 just repeats the L2 name", "value": (f.loc[has4, "ref_l4"] == f.loc[has4, "ref_l2"]).mean()},
                 {"measure": "existing average L4 per L2", "value": f[has4].groupby("ref_l2")["ref_l4"].nunique().mean()},
                 {"measure": "new average L4 per L2", "value": f.groupby("final_l2")["final_l4"].nunique().mean()}]
        sheets["Existing_L4_vs_new_L4"] = pd.crosstab(f.loc[has4, "ref_l4"], f.loc[has4, "final_l4"]).T.reset_index()
    summary = pd.DataFrame(rows)
    log.info("comparison with the existing labels:\n%s", summary.round(3).to_string(index=False))
    sheets["Existing_vs_new_summary"] = summary
    sheets["Existing_L2_vs_new_L2"] = pd.crosstab(f.loc[has_ref, "ref_l2"], f.loc[has_ref, "final_l2"]).reset_index()

    differ = f[has_ref & (f["ref_l2"] != f["new_as_legacy_l2"]) & (f["label_source"] != "")]
    differ = differ.drop_duplicates("text_raw")
    differ = differ.sample(min(len(differ), cfg.disagreement_sample), random_state=cfg.seed) if len(differ) else differ
    cols = ["row_id", "text_raw", "l1", "ref_l2"] + (["ref_l4"] if "ref_l4" in f else []) + \
           ["final_l2", "final_l4", "l2_confidence", "label_source", "label_l4"]
    sheets["Disagreements_with_evidence"] = differ.sort_values("l2_confidence", ascending=False)[cols].rename(
        columns={"text_raw": "text", "ref_l2": "existing_L2", "ref_l4": "existing_L4", "final_l2": "new_L2", "final_l4": "new_L4",
                 "label_source": "evidence_source", "label_l4": "evidence_L4"})
    pairs = differ.groupby(["ref_l2", "final_l2"]).size().rename("distinct_texts").reset_index().sort_values("distinct_texts", ascending=False)
    sheets["Disagreement_pairs"] = pairs
    log.info("most common disagreements (existing -> new): %s",
             ", ".join(f"{a}->{b} {n}" for a, b, n in pairs.head(8).itertuples(index=False)))
    return sheets


