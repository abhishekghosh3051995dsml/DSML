# %% taxonomy
@dataclass
class Taxonomy:
    tree: dict
    catch_all: str
    name_stop: set
    parts: dict
    rules_raw: dict
    allowed: dict
    legacy: dict
    definitions: dict
    sources: dict
    vocabulary: dict
    segmentation: dict

    def __post_init__(self):
        self.l4_parent = {l4: l2 for l2, children in self.tree.items() for l4 in children}
        self.l2_names = sorted(self.tree)
        self.fallback = {l4 for l4, rule in self.rules_raw.items() if rule.get("role") == "domain_fallback" and l4 in self.l4_parent}
        self.rewrites = {k.lower(): v.lower() for section in self.vocabulary.values() if isinstance(section, dict)
                         for k, v in section.items()}
        self._rewrite_re = None

    def rewrite(self, text):
        """Vocabulary rewrites (abbreviations, spelling, entities) on normalised text, whole words, longest first."""
        if not self.rewrites:
            return text
        if self._rewrite_re is None:
            keys = sorted(self.rewrites, key=len, reverse=True)
            self._rewrite_re = re.compile(r"\b(?:%s)\b" % "|".join(re.escape(k) for k in keys))
        return self._rewrite_re.sub(lambda m: self.rewrites[m.group(0)], text)

    def __getstate__(self):
        state = dict(self.__dict__)
        state["_rewrite_re"] = None
        return state
    @property
    def k(self):
        return len(self.l2_names)

    @classmethod
    def load(cls, path):
        path = Path(path)
        if not path.exists():
            raise SystemExit(f"taxonomy file not found: {path}")
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data.get("taxonomy"), dict) or not data["taxonomy"]:
            raise SystemExit("the taxonomy file needs a non-empty 'taxonomy' object: {L2: [L4, ...]}")
        tax = cls(tree={k: list(v) for k, v in data["taxonomy"].items()},
                  catch_all=data.get("catch_all_l2", ""),
                  name_stop=set(data.get("name_stop_words", [])),
                  parts=data.get("pattern_parts", {}),
                  rules_raw=data.get("lexicon", {}),
                  allowed={k: set(v) for k, v in data.get("allowed_l2_by_l1", {}).items()},
                  legacy=data.get("legacy_scheme", {}),
                  definitions=data.get("l2_definitions", {}),
                  sources=data.get("sources", {}),
                  vocabulary=data.get("vocabulary", {}),
                  segmentation=data.get("segmentation", {}))
        orphans = sorted(set(tax.rules_raw) - set(tax.l4_parent))
        if orphans:
            log.warning("ignoring %d taxonomy rules with no parent L2: %s", len(orphans), ", ".join(orphans))
        log.info("taxonomy %s (version %s): %d L2, %d L4, %d phrasing rules, %d vocabulary rewrites, L1 routing %s, legacy mapping %s",
                 path.name, data.get("version", "?"), tax.k, len(tax.l4_parent), len(tax.rules_raw) - len(orphans), len(tax.rewrites),
                 "on" if tax.allowed else "off", "on" if tax.legacy else "off")
        return tax

    def tier(self, l4):
        return self.rules_raw.get(l4, {}).get("tier", 1)

    def compiled_rules(self):
        def expand(pattern):
            for key, value in self.parts.items():
                pattern = pattern.replace(key, value)
            return re.compile(pattern)

        compiled = []
        for l4, rule in self.rules_raw.items():
            if l4 not in self.l4_parent:
                continue
            try:
                compiled.append((l4, rule.get("tier", 1), [expand(p) for p in rule.get("match", [])],
                                 [expand(p) for p in rule.get("exclude", [])]))
            except re.error as err:
                raise SystemExit(f"invalid pattern in taxonomy rule {l4}: {err}")
        return compiled

    def legacy_l2(self, l2, l4=None):
        return self.legacy.get("l2_by_l4", {}).get(l4) or self.legacy.get("l2", {}).get(l2, l2)

    def reference_table(self):
        """One row per L4 with its L2 and the standard (eTOM process, Open API, source links) the L2 is derived from."""
        rows = []
        for l2, children in self.tree.items():
            d = self.definitions.get(l2, {})
            links = "; ".join(f"{self.sources[s]['title']} <{self.sources[s]['url']}>" for s in d.get("sources", []) if s in self.sources)
            for l4 in children:
                rows.append({"L2": l2, "L2_description": d.get("description", ""), "eTOM_processes": "; ".join(d.get("etom_processes", [])),
                             "open_apis": "; ".join(d.get("open_apis", [])), "L4": l4,
                             "L4_description": self.rules_raw.get(l4, {}).get("description", ""), "rule_tier": self.tier(l4), "sources": links})
        return pd.DataFrame(rows)

    def legacy_l4(self, l2, l4):
        return self.legacy.get("l4", {}).get(l4) or self.legacy.get("l4_default_by_l2", {}).get(l2, l4)

    def legacy_l4_names(self):
        return set(self.legacy.get("l4", {}).values()) | set(self.legacy.get("l4_default_by_l2", {}).values())

    def constrain(self, P, classes, l1_values):
        """Zero out L2 classes the optional L1 -> L2 routing table forbids (new L2 classes are never blocked)."""
        if not self.allowed:
            return P
        mask = np.ones_like(P)
        for i, l1 in enumerate(l1_values):
            if l1 in self.allowed:
                mask[i] = [0.0 if (c in self.tree and c not in self.allowed[l1]) else 1.0 for c in classes]
        mask[mask.sum(1) == 0] = 1.0
        out = P * mask
        return out / out.sum(1, keepdims=True)


# %% input
def read_table(path, sheet):
    path = Path(path)
    if not path.exists():
        raise SystemExit(f"input file not found: {path}")
    if path.suffix.lower() in (".xlsx", ".xlsm", ".xls"):
        book = pd.read_excel(path, sheet_name=sheet or None, dtype=str, keep_default_na=False)
        if isinstance(book, dict):
            usable = [b for b in book.values() if b.shape[1] >= 2]
            if not usable:
                raise SystemExit(f"no sheet in {path.name} has at least two columns")
            book = max(usable, key=len)
        return book
    for encoding in ("utf-8-sig", "utf-8", "cp1252", "latin-1"):
        try:
            return pd.read_csv(path, dtype=str, keep_default_na=False, encoding=encoding)
        except UnicodeDecodeError:
            continue
    raise SystemExit(f"cannot decode {path}")


@dataclass
class Columns:
    text: str
    l1: str
    ref_l2: str
    ref_l4: str
    l2: str
    l4: str


def load_input(cfg, tax):
    raw = read_table(cfg.input, cfg.sheet)
    raw.columns = [str(c).strip() for c in raw.columns]
    raw = raw.fillna("").astype(str)
    filled = [c for c in raw.columns if not c.startswith("Unnamed") and raw[c].str.strip().ne("").any()]
    if len(filled) < 2 or raw.empty:
        raise SystemExit("the input needs a text column and an L1 column with data")

    profile = pd.DataFrame({"mean_length": raw[filled].apply(lambda s: s.str.len().mean()),
                            "distinct_values": raw[filled].nunique(),
                            "blank_cells": raw[filled].apply(lambda s: s.str.strip().eq("").sum())})
    text_col = cfg.text_column or profile["mean_length"].idxmax()

    def share_known(col, names):
        values = raw[col].str.strip()
        values = values[values != ""]
        return values.isin(names).mean() if len(values) else 0.0

    others = [c for c in filled if c != text_col]
    ref_l2 = cfg.reference_l2_column or next(
        (c for c in others if share_known(c, set(tax.l2_names) | set(tax.legacy.get("l2", {}).values())) >= cfg.reference_match), "")
    l4_names = tax.legacy_l4_names() | set(tax.l4_parent)
    ref_l4 = cfg.reference_l4_column or next(
        (c for c in others if c != ref_l2 and share_known(c, l4_names) >= cfg.reference_match), "")

    candidates = profile.loc[[c for c in others if c not in (ref_l2, ref_l4)]]
    candidates = candidates[(candidates["distinct_values"] > 1) & (candidates["distinct_values"] < 0.5 * len(raw))]
    named = [c for c in candidates.index if re.search(cfg.l1_name_pattern, c, re.I)]
    if cfg.l1_column:
        l1_col = cfg.l1_column
    elif named:
        l1_col = named[0]
    elif len(candidates):
        l1_col = candidates["distinct_values"].idxmin()
    else:
        raise SystemExit("could not find an L1 column; pass --l1-column")
    for col in (text_col, l1_col, ref_l2, ref_l4):
        if col and col not in raw.columns:
            raise SystemExit(f"column '{col}' not in the input; columns are {list(raw.columns)}")

    def free(name):
        return name if name not in raw.columns else f"{name}_{VERSION}"

    cols = Columns(text_col, l1_col, ref_l2, ref_l4, free(cfg.l2_name), free(cfg.l4_name))
    df = pd.DataFrame({"row_id": np.arange(len(raw)), "text_raw": raw[text_col].to_numpy(), "l1": raw[l1_col].to_numpy()})
    if ref_l2:
        df["ref_l2"] = raw[ref_l2].str.strip().to_numpy()
    if ref_l4:
        df["ref_l4"] = raw[ref_l4].str.strip().to_numpy()

    log.info("input %s: %s rows | text '%s' | L1 '%s' | existing L2 '%s' | existing L4 '%s' | adds '%s', '%s'",
             Path(cfg.input).name, f"{len(df):,}", text_col, l1_col, ref_l2 or "-", ref_l4 or "-", cols.l2, cols.l4)
    log.info("L1 values: %s", ", ".join(f"{k} {v:,}" for k, v in df["l1"].value_counts().items()))
    blank = int(df["text_raw"].str.strip().eq("").sum())
    if blank:
        log.warning("%s rows have an empty text; they are labelled from the L1 context only and flagged for review", f"{blank:,}")
    log.debug("distinct texts: %s of %s rows", f"{df['text_raw'].nunique():,}", f"{len(df):,}")
    return raw, df, profile, cols


# %% cleaning
def normalise(text, id_min_length):
    text = re.sub(r"['\u2019`]", "", text.lower())
    text = re.sub(r"\S+@\S+", " email ", text)
    text = re.sub(r"(https?://|www\.)\S+", " url ", text)
    text = re.sub(r"\b(?=\w*\d)\w{%d,}\b" % id_min_length, " idnum ", text)
    text = re.sub(r"\d+", " num ", text)
    text = re.sub(r"[^\w\s:.!?&/-]", " ", text)
    text = re.sub(r"(?<=\w)-(?=\s|$)|(?<=\s)-(?=\w)", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def constant_tokens(texts, share):
    """Leading or trailing tokens present on nearly every row are record markers (e.g. 'row-0'), not content."""
    first = texts.str.split().str[:2].str.join(" ")
    last = texts.str.split().str[-2:].str.join(" ")
    markers = {"start": [], "end": []}
    for side, values in (("start", first), ("end", last)):
        counts = values.value_counts(normalize=True)
        for gram in counts.index[counts >= share]:
            markers[side].append(gram)
        if not markers[side]:
            single = (texts.str.split().str[0] if side == "start" else texts.str.split().str[-1]).value_counts(normalize=True)
            markers[side] = [w for w in single.index[single >= share]]
    return markers


def strip_markers(text, markers):
    for gram in markers["start"]:
        if text.startswith(gram + " ") or text == gram:
            text = text[len(gram):].strip()
    for gram in markers["end"]:
        if text.endswith(" " + gram) or text == gram:
            text = text[: len(text) - len(gram)].strip()
    return text


def near_duplicate_groups(texts, cfg, rng):
    """Character-shingle cosine >= threshold on distinct texts. Exact blockwise search up to --exact-dup-limit
    distinct texts; above that random-hyperplane LSH proposes candidate pairs that are verified exactly."""
    distinct, inverse = np.unique(texts.to_numpy(), return_inverse=True)
    X = TfidfVectorizer(analyzer="char_wb", ngram_range=(cfg.shingle_size, cfg.shingle_size),
                        min_df=min(cfg.min_df, len(distinct)), sublinear_tf=True).fit_transform(distinct)
    n = X.shape[0]
    uf = UnionFind(n)

    def link(rows, block):
        sims = (X[block] @ X[rows].T).tocoo()
        keep = (sims.data >= cfg.near_dup_threshold) & (block[sims.row] < rows[sims.col])
        for a, b in zip(block[sims.row[keep]], rows[sims.col[keep]]):
            uf.union(a, b)

    if n <= cfg.exact_dup_limit:
        everything = np.arange(n)
        for start in range(0, n, cfg.chunk_size):
            link(everything, everything[start:start + cfg.chunk_size])
        method = "exact"
    else:
        Z = normalize(TruncatedSVD(n_components=min(cfg.lsh_dims, X.shape[1] - 1), random_state=cfg.seed).fit_transform(X))
        powers = 1 << np.arange(cfg.lsh_bits)
        for _ in range(cfg.lsh_tables):
            codes = (Z @ rng.normal(size=(Z.shape[1], cfg.lsh_bits)) > 0) @ powers
            for members in pd.Series(np.arange(n)).groupby(codes).groups.values():
                members = np.asarray(members)
                for start in range(0, len(members), cfg.chunk_size):
                    link(members, members[start:start + cfg.chunk_size])
        method = f"LSH {cfg.lsh_tables}x{cfg.lsh_bits} bits"
    groups = uf.roots()[inverse]
    sizes = pd.Series(groups).value_counts()
    log.info("near-duplicates (%s on %s distinct texts, cosine >= %.2f): %s rows in %s groups of 2+, largest %s",
             method, f"{n:,}", cfg.near_dup_threshold, f"{int(sizes[sizes > 1].sum()):,}", f"{int((sizes > 1).sum()):,}",
             f"{int(sizes.max()):,}")
    return groups


def test_phrases(texts, cfg, rng):
    """A frequent 3-6 word phrase is boilerplate when the rows containing it are no more alike than random rows
    (after masking the phrase and the words always attached to it) and the phrase owns its rarest word."""
    columns = ["phrase", "rows", "cohesion", "cohesion_z", "rarest_word", "ownership", "boilerplate"]
    lo, hi = pair(cfg.phrase_ngram, int)
    vec = TfidfVectorizer(min_df=cfg.char_min_df, max_df=cfg.max_df, sublinear_tf=True, token_pattern=r"[a-z]{2,}")
    try:
        X = vec.fit_transform(texts)
        min_df = max(cfg.min_labelled_per_class // 2, int(cfg.phrase_min_df * len(texts)))
        counter = CountVectorizer(ngram_range=(lo, hi), token_pattern=r"[a-z]{2,}", binary=True, min_df=min_df,
                                  max_features=cfg.phrase_max).fit(texts)
    except ValueError:
        return pd.DataFrame(columns=columns)
    vocab = vec.vocabulary_
    P, phrases = counter.transform(texts).tocsc(), counter.get_feature_names_out()
    Xn = normalize(X)
    Xb = (X > 0).astype(np.int32).tocsr()
    word_df = pd.Series(np.asarray(Xb.sum(axis=0)).ravel(), index=vec.get_feature_names_out())
    cache = {}

    def resultant(rows, masked):
        sub = Xn[rows]
        if len(masked):
            keep = np.ones(sub.shape[1])
            keep[masked] = 0
            sub = csr_matrix(sub.multiply(keep[None, :]))
        return float(np.linalg.norm(np.asarray(normalize(sub).mean(axis=0)).ravel()))

    def random_level(n):
        key = int(np.round(np.log2(max(n, 2)) * 2))
        if key not in cache:
            draws = [resultant(rng.choice(len(texts), size=min(n, len(texts)), replace=False), [])
                     for _ in range(cfg.baseline_draws)]
            cache[key] = (np.mean(draws), np.std(draws) + 1e-9)
        return cache[key]

    rows = []
    for j, phrase in enumerate(phrases):
        members = P[:, j].nonzero()[0]
        co = np.asarray(Xb[members].sum(axis=0)).ravel()
        attached = np.flatnonzero((co >= cfg.attached_cooccurrence * len(members)) &
                                  (co >= cfg.phrase_min_ownership * word_df.values))
        masked = sorted(set(attached) | {vocab[w] for w in phrase.split() if w in vocab})
        observed = resultant(members, masked)
        mu, sd = random_level(len(members))
        rarest = min(phrase.split(), key=lambda w: word_df.get(w, np.inf))
        rows.append((phrase, len(members), observed, (observed - mu) / sd, rarest,
                     len(members) / word_df.get(rarest, len(members))))
    table = pd.DataFrame(rows, columns=columns[:-1])
    table["boilerplate"] = (table["cohesion_z"] <= cfg.phrase_max_z) & (table["ownership"] >= cfg.phrase_min_ownership)
    return table


def index_phrases(phrases):
    by_first = defaultdict(list)
    for tokens in sorted((p.split() for p in phrases), key=len, reverse=True):
        by_first[tokens[0]].append(tokens)
    return by_first


def strip_phrases(text, by_first):
    tokens = text.split()
    keep = np.ones(len(tokens), dtype=bool)
    for i, token in enumerate(tokens):
        for phrase in by_first.get(token, ()):
            if tokens[i:i + len(phrase)] == phrase:
                keep[i:i + len(phrase)] = False
    out = [t for t, k in zip(tokens, keep) if k]
    return " ".join(out) if len(out) >= 2 else text


def prepare_text(text_raw, artefacts, id_min_length, tax):
    """The cleaning applied to every row, in training and in score mode alike."""
    text = strip_markers(tax.rewrite(normalise(text_raw, id_min_length)), artefacts["markers"])
    return strip_phrases(text, artefacts["phrase_index"])


def clean(df, tax, cfg, rng):
    df["text_norm"] = df["text_raw"].map(lambda t: tax.rewrite(normalise(t, cfg.id_min_length)))
    changed = (df["text_norm"] != df["text_raw"].map(lambda t: normalise(t, cfg.id_min_length))).sum()
    log.info("vocabulary rewrites touched %s rows", f"{changed:,}")
    df.attrs["vocab_rows"] = int(changed)
    markers = constant_tokens(df["text_norm"], cfg.constant_token_share)
    if markers["start"] or markers["end"]:
        log.info("record markers removed: start %s, end %s", markers["start"] or "-", markers["end"] or "-")
    df["text_norm"] = df["text_norm"].map(lambda t: strip_markers(t, markers))
    df["near_dup_group"] = near_duplicate_groups(df["text_norm"], cfg, rng)

    distinct = df.drop_duplicates("text_norm")["text_norm"]
    phrase_table = test_phrases(distinct.reset_index(drop=True), cfg, rng)
    boilerplate = phrase_table.loc[phrase_table["boilerplate"], "phrase"].tolist() if len(phrase_table) else []
    artefacts = {"markers": markers, "phrase_index": index_phrases(boilerplate), "boilerplate": boilerplate}
    df["text_model"] = df["text_norm"].map(lambda t: strip_phrases(t, artefacts["phrase_index"]))
    df["n_tokens_raw"] = df["text_norm"].str.split().str.len()
    df["n_tokens_model"] = df["text_model"].str.split().str.len()
    log.info("phrases tested %s on %s distinct texts, boilerplate %d", f"{len(phrase_table):,}", f"{len(distinct):,}", len(boilerplate))
    if boilerplate:
        log.debug("boilerplate phrases: %s", boilerplate[:30])
    artefacts["phrase_table"] = phrase_table
    return artefacts


# %% representations
class DomainEmbeddings:
    """Word vectors learned from this dataset only (windowed co-occurrence -> PPMI -> truncated SVD, which captures
    the same information as word2vec), plus SIF row vectors (frequency-weighted average with the common component
    removed). No downloads, deterministic, CPU only."""

    def __init__(self, cfg):
        self.dims, self.window, self.min_count = cfg.emb_dims, cfg.emb_window, cfg.emb_min_count
        self.alpha, self.sif_a, self.seed = cfg.emb_cds_alpha, cfg.sif_a, cfg.seed

    def fit(self, texts):
        token_lists = [TOKEN.findall(t) for t in texts]
        counts = Counter(w for tokens in token_lists for w in tokens)
        words = sorted(w for w, c in counts.items() if c >= self.min_count)
        if len(words) < 10:
            raise SystemExit("too few repeated words to learn embeddings; check the text column")
        self.index = {w: i for i, w in enumerate(words)}
        self.words = np.array(words)
        self.by_frequency = sorted(words, key=lambda w: -counts[w])
        V = len(words)

        ids = [np.array([self.index.get(w, -1) for w in tokens], dtype=np.int64) for tokens in token_lists]
        flat = np.concatenate(ids) if ids else np.zeros(0, dtype=np.int64)
        doc = np.repeat(np.arange(len(ids)), [len(a) for a in ids])
        rows, cols, vals = [], [], []
        for k in range(1, self.window + 1):
            a, b = flat[:-k], flat[k:]
            ok = (doc[:-k] == doc[k:]) & (a >= 0) & (b >= 0)
            rows += [a[ok], b[ok]]
            cols += [b[ok], a[ok]]
            vals += [np.full(ok.sum(), 1.0 / k)] * 2
        C = csr_matrix((np.concatenate(vals), (np.concatenate(rows), np.concatenate(cols))), shape=(V, V))
        C.sum_duplicates()
        total = C.sum()
        if total == 0:
            raise SystemExit("no word co-occurrences found; texts are too short to learn embeddings")

        p_word = np.asarray(C.sum(1)).ravel() / total
        p_ctx = np.asarray(C.sum(0)).ravel() ** self.alpha
        p_ctx = p_ctx / p_ctx.sum()
        C = C.tocoo()
        pmi = np.log((C.data / total) / (p_word[C.row] * p_ctx[C.col]))
        keep = pmi > 0
        ppmi = csr_matrix((pmi[keep], (C.row[keep], C.col[keep])), shape=(V, V))
        dims = min(self.dims, V - 1)
        U, S, _ = randomized_svd(ppmi, n_components=dims, random_state=self.seed)
        self.vectors = normalize(U * np.sqrt(S))
        freq = np.array([counts[w] for w in words], dtype=float)
        self.prob = freq / freq.sum()
        self.bow = CountVectorizer(vocabulary=self.index, token_pattern=TOKEN.pattern, lowercase=False)

        sample = pd.Series(texts)
        sample = sample if len(sample) <= 50_000 else sample.sample(50_000, random_state=self.seed)
        raw = self._weighted_mean(sample)
        raw = raw[np.linalg.norm(raw, axis=1) > 0]
        self.common = TruncatedSVD(n_components=1, random_state=self.seed).fit(raw).components_[0] if len(raw) > 1 \
            else np.zeros(dims)
        log.info("domain embeddings: %s words x %d dims from %s co-occurrence weight (PPMI non-zeros %s)",
                 f"{V:,}", dims, f"{int(total):,}", f"{ppmi.nnz:,}")
        return self

    def _weighted_mean(self, texts):
        T = self.bow.transform(texts).astype(float)
        T = csr_matrix(T.multiply(self.sif_a / (self.sif_a + self.prob)))
        sums = np.asarray(T.sum(1)).ravel()
        return np.asarray(T @ self.vectors) / np.maximum(sums, PROB_FLOOR)[:, None]

    def transform(self, texts):
        X = self._weighted_mean(texts)
        X = X - np.outer(X @ self.common, self.common)
        return normalize(X)

    def neighbours(self, word, n):
        if word not in self.index:
            return []
        sims = self.vectors @ self.vectors[self.index[word]]
        order = np.argsort(-sims)[1:n + 1]
        return [(self.words[i], float(sims[i])) for i in order]


class SentenceEncoder:
    """Optional pretrained sentence encoder loaded from a local folder (sentence-transformers format). Distinct
    texts are encoded once. The model itself is not pickled; score mode reloads it from the same folder."""

    def __init__(self, path, batch):
        self.path, self.batch = str(path), batch
        self._model = None

    def _load(self):
        if self._model is None:
            from sentence_transformers import SentenceTransformer
            self._model = SentenceTransformer(self.path, device="cpu")
        return self._model

    def transform(self, texts):
        texts = pd.Series(list(texts), dtype=object).fillna("")
        distinct = pd.unique(texts)
        vectors = self._load().encode(list(distinct), batch_size=self.batch, show_progress_bar=False, convert_to_numpy=True)
        lookup = dict(zip(distinct, range(len(distinct))))
        return normalize(np.asarray(vectors)[[lookup[t] for t in texts]])

    def __getstate__(self):
        return {"path": self.path, "batch": self.batch, "_model": None}


def row_encoder(cfg, emb):
    if not cfg.encoder:
        return emb
    if not Path(cfg.encoder).exists():
        log.warning("encoder folder %s not found; using the domain embeddings", cfg.encoder)
        return emb
    try:
        encoder = SentenceEncoder(cfg.encoder, cfg.encoder_batch)
        encoder.transform(["check"])
        log.info("row vectors from the local sentence encoder %s", cfg.encoder)
        return encoder
    except Exception as err:  # the optional dependency or the model folder may be unusable
        log.warning("cannot use the sentence encoder (%s); using the domain embeddings", err)
        return emb


# %% weak labels
SHORT_TAILS = {"e", "s", "es", "d", "ed", "ing", "on", "y", "ies", "ied"}
INFLECTIONS = {"s", "es", "d", "ed", "ing", "ings", "er", "ers", "ment", "ments", "ion", "ions", "ation", "ations",
               "al", "ly", "ity", "ivity", "ive"}
STEM_TAILS = SHORT_TAILS | INFLECTIONS | {"ication", "ications", "ying", "ement", "ements", "ered", "ering", "ration",
                                          "sion", "ded"}


def is_variant(word, target, prefix_ratio):
    """'recieving' ~ 'receive', 'activated' ~ 'activation' etc."""
    if word == target:
        return True
    short, long_ = sorted((word, target), key=len)
    common = next((i for i, (a, b) in enumerate(zip(short, long_)) if a != b), len(short))
    if common == len(short):
        return long_[common:] in INFLECTIONS
    for c in range(common, max(3, common - 3), -1):
        if word[c:] in STEM_TAILS and target[c:] in STEM_TAILS:
            return True
    return common >= prefix_ratio * len(short) and short[common:] in SHORT_TAILS


class NameMatcher:
    """Finds the words of an L4 name (with spelling variants seen in the data) close together in a row.
    Domain fallback L4s (tier >= --generic-tier) are not names of a need and are skipped."""

    def __init__(self, tax, texts, cfg):
        self.gap = cfg.name_gap
        self.parent = tax.l4_parent
        self.name_words = {l4: [w for w in l4.lower().split("_") if w not in tax.name_stop]
                           for l4 in tax.l4_parent if tax.tier(l4) < cfg.generic_tier}
        by_prefix = defaultdict(list)
        for w in {w for ws in self.name_words.values() for w in ws}:
            by_prefix[w[:2]].append(w)
        vocab = {t for text in texts for t in re.findall(r"[a-z]+", text)}
        self.variant_of = defaultdict(set)
        self.variants = defaultdict(set)
        for v in vocab:
            for w in by_prefix.get(v[:2], ()):
                if is_variant(v, w, cfg.word_prefix_ratio):
                    self.variant_of[v].add(w)
                    self.variants[w].add(v)
        df = Counter()
        for text in texts:
            df.update({w for t in set(re.findall(r"[a-z]+", text)) for w in self.variant_of.get(t, ())})
        n = len(texts)
        self.idf = {w: np.log((1 + n) / (1 + df.get(w, 0))) + 1 for ws in self.name_words.values() for w in ws}
        log.debug("name matcher: %d L4 names, %d name words, %d spelling variants in the data", len(self.name_words),
                  len(self.variants), sum(len(v) for v in self.variants.values()))

    def vote(self, text):
        tokens = re.findall(r"[a-z]+", text)
        where = defaultdict(list)
        for i, t in enumerate(tokens):
            for w in self.variant_of.get(t, ()):
                where[w].append(i)
        best, best_score = None, 0.0
        for l4, words in self.name_words.items():
            if len(words) < 2 or not all(w in where for w in words) or not self._in_order(words, where):
                continue
            score = sum(self.idf[w] for w in words)
            if score > best_score:
                best, best_score = l4, score
        return best


    def _in_order(self, words, where):
        """The name words occur in the name's order, each within --name-gap words of the previous one."""
        def walk(i, after):
            if i == len(words):
                return True
            return any(walk(i + 1, p) for p in where[words[i]] if after < p <= after + 1 + self.gap)
        return any(walk(1, p) for p in where[words[0]])


def rule_hits(text, rules):
    """Every L4 rule that fires on a text, as (tier, start, -length, L4) sorted by precedence: lowest tier, then the
    earliest mention, then the longest match. The first item is the rule decision."""
    hits = []
    for l4, tier, match, exclude in rules:
        if any(p.search(text) for p in exclude):
            continue
        found = [m for p in match for m in [p.search(text)] if m]
        if found:
            first = min(found, key=lambda m: (m.start(), -(m.end() - m.start())))
            hits.append((tier, first.start(), -(first.end() - first.start()), l4))
    return sorted(hits)


def rule_vote(text, rules):
    hits = rule_hits(text, rules)
    return hits[0][3] if hits else None


class RuleEvidence:
    """Rule hits per text (cached) and the text's first clause. The clause connectors come from the taxonomy
    file ("segmentation"); with none listed, sentence punctuation alone separates clauses."""

    def __init__(self, tax, cfg):
        self.rules = tax.compiled_rules()
        self.l4_cols = {l4: i for i, (l4, _, _, _) in enumerate(self.rules)}
        self.l2_cols = {l2: i for i, l2 in enumerate(tax.l2_names)}
        self.parent = dict(tax.l4_parent)
        words = [re.escape(w.lower()) for w in tax.segmentation.get("clause_connectors", [])]
        marks = "".join(re.escape(c) for c in tax.segmentation.get("clause_punctuation", ".;!?"))
        alternatives = ([r"\b(?:%s)\b" % "|".join(words)] if words else []) + ([f"[{marks}]"] if marks else [])
        self.splitter = re.compile("|".join(alternatives)) if alternatives else None
        self.weight = cfg.rule_feature_weight
        self.cache = {}

    def __getstate__(self):
        state = dict(self.__dict__)
        state["cache"] = {}
        return state

    def hits(self, text):
        if text not in self.cache:
            self.cache[text] = rule_hits(text, self.rules)
        return self.cache[text]

    def lead_end(self, text):
        """Character position where the first clause with a word in it ends."""
        if self.splitter is None:
            return len(text)
        start = 0
        for m in self.splitter.finditer(text):
            if TOKEN.search(text[start:m.start()]):
                return m.start()
            start = m.end()
        return len(text)

    def lead(self, text):
        return text[:self.lead_end(text)]

    def transform(self, texts):
        """Columns: one per L4 rule that fires, one per L2 with any rule firing, one per L2 with a rule firing
        inside the first clause."""
        n4, n2 = len(self.l4_cols), len(self.l2_cols)
        rows, cols = [], []
        for i, text in enumerate(texts):
            end = self.lead_end(text)
            for tier, start, _, l4 in self.hits(text):
                c2 = self.l2_cols[self.parent[l4]]
                rows += [i, i]
                cols += [self.l4_cols[l4], n4 + c2]
                if start < end:
                    rows.append(i)
                    cols.append(n4 + n2 + c2)
        X = csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(len(texts), n4 + 2 * n2))
        X.sum_duplicates()
        X.data[:] = self.weight
        return X


def build_prototypes(tax, matcher, emb, cfg):
    """One vector per L4: its name words (and their spelling variants found in the data) weighted by how specific
    they are to one L2, expanded with nearest neighbours in the domain embedding space. An L4 whose name words do
    not all occur in the data gets no prototype (a partial name drifts: 'update' alone matches any update)."""
    l2s_of_word = defaultdict(set)
    for l4, words in matcher.name_words.items():
        for w in words:
            l2s_of_word[w].add(tax.l4_parent[l4])
    prototypes, report = {}, []
    for l4, words in matcher.name_words.items():
        parts, weights, seeds, missing = [], [], [], []
        for w in words:
            specificity = np.log(tax.k / len(l2s_of_word[w]))
            found = sorted(v for v in matcher.variants.get(w, ()) if v in emb.index)
            if specificity <= 0:
                continue
            if not found:
                missing.append(w)
                continue
            parts.append(emb.vectors[[emb.index[v] for v in found]].mean(0))
            weights.append(specificity)
            seeds += found
        if missing or not parts:
            log.debug("no prototype for %s (name words not in the data: %s)", l4, missing)
            continue
        seed = normalize((np.array(weights)[:, None] * np.array(parts)).sum(0, keepdims=True))[0]
        sims = emb.vectors @ seed
        top = [i for i in np.argsort(-sims)[:cfg.seed_neighbours] if sims[i] > 0]
        prototypes[l4] = normalize((seed + (sims[top, None] * emb.vectors[top]).sum(0))[None])[0]
        report.append({"L2": tax.l4_parent[l4], "L4": l4, "seed_words": ", ".join(seeds), "expanded_with": ", ".join(emb.words[top])})
        log.debug("prototype %-32s [%s] -> [%s]", l4, ", ".join(seeds), ", ".join(emb.words[top]))
    log.info("semantic prototypes built for %d of %d named L4", len(prototypes), len(matcher.name_words))
    return prototypes, pd.DataFrame(report)


def semantic_votes(vectors, prototypes, tax, reference, cfg):
    """Nearest L2 by meaning. The decision bar is the margin (best L2 minus runner-up) at which agreement with the
    phrasing rules reaches --target-precision; if that is never reached, the source abstains."""
    names = list(prototypes)
    empty = pd.Series([None] * len(vectors), dtype=object)
    if len(names) < 2:
        return empty, None
    S = vectors @ np.vstack([prototypes[n] for n in names]).T
    parents = np.array([tax.l4_parent[n] for n in names])
    l2s = sorted(set(parents))
    if len(l2s) < 2:
        return empty, None
    by_l2 = np.column_stack([S[:, parents == l2].max(1) for l2 in l2s])
    order = np.argsort(-by_l2, axis=1)
    rows = np.arange(len(S))
    best = np.array(l2s)[order[:, 0]]
    margin = by_l2[rows, order[:, 0]] - by_l2[rows, order[:, 1]]
    has_vector = np.linalg.norm(vectors, axis=1) > 0
    ref = reference.to_numpy()
    checkable = has_vector & (ref != "")
    if checkable.sum() < cfg.min_source_overlap:
        log.warning("semantic source abstains: only %d rows to set its decision bar", checkable.sum())
        return empty, None
    share, bar = coverage_at(margin[checkable], best[checkable] == ref[checkable], cfg.target_precision)
    if share == 0:
        log.info("semantic source abstains: it never reaches L2 precision %.2f against the phrasing rules", cfg.target_precision)
        return empty, None
    fire = has_vector & (margin >= bar)
    picks = np.full(len(S), None, dtype=object)
    for l2 in l2s:
        m = fire & (best == l2)
        if m.any():
            cols = np.flatnonzero(parents == l2)
            picks[m] = np.array(names)[cols[S[np.ix_(np.flatnonzero(m), cols)].argmax(1)]]
    precision = float((best[checkable & fire] == ref[checkable & fire]).mean())
    log.info("semantic source: margin bar %.3f, fires on %.1f%% of rows, precision vs phrasing rules %.3f",
             bar, 100 * fire.mean(), precision)
    return pd.Series(picks, dtype=object), precision


def dawid_skene(L, acc0, k, cfg):
    """One-coin Dawid-Skene EM; each source's accuracy is shrunk towards its starting estimate."""
    n, m = L.shape
    acc, prior = acc0.copy(), np.full(k, 1.0 / k)
    for iteration in range(cfg.ds_max_iter):
        logq = np.tile(np.log(prior), (n, 1))
        for j in range(m):
            on = L[:, j] >= 0
            wrong = np.log((1 - acc[j]) / (k - 1))
            logq[on] += wrong
            logq[on, L[on, j]] += np.log(acc[j]) - wrong
        q = np.exp(logq - logq.max(1, keepdims=True))
        q /= q.sum(1, keepdims=True)
        new = np.array([(q[L[:, j] >= 0, L[L[:, j] >= 0, j]].sum() + cfg.ds_strength * acc0[j])
                        / ((L[:, j] >= 0).sum() + cfg.ds_strength) for j in range(m)]).clip(1e-3, 1 - 1e-3)
        if cfg.class_prior == "learned":
            prior = q.mean(0).clip(1e-4)
        converged = np.abs(new - acc).max() < 1e-6
        acc = new
        if converged:
            break
    log.debug("Dawid-Skene converged after %d iterations", iteration + 1)
    return q, acc


@dataclass
class Labels:
    sources: pd.DataFrame
    agreement: pd.DataFrame
    rule_hits: pd.DataFrame
    prototypes: dict
    prototype_report: pd.DataFrame
    name_vote: dict


def build_labels(df, tax, emb, evidence, cfg):
    """Three label sources vote an L4 (hence an L2) for each row; Dawid-Skene combines the independent ones."""
    rules = evidence.rules
    distinct = df.drop_duplicates("text_model")["text_model"]
    rule_l4 = {t: (h[0][3] if h else None) for t, h in ((t, evidence.hits(t)) for t in distinct)}
    matcher = NameMatcher(tax, distinct.tolist(), cfg)
    name_l4 = dict(zip(distinct, distinct.map(matcher.vote)))
    votes = {"phrasing_rules": df["text_model"].map(rule_l4), "name_matching": df["text_model"].map(name_l4)}

    reference = votes["phrasing_rules"].map(lambda x: tax.l4_parent[x] if isinstance(x, str) else "")
    prototypes, proto_report = build_prototypes(tax, matcher, emb, cfg)
    semantic, semantic_acc = semantic_votes(emb.transform(df["text_model"]), prototypes, tax, reference, cfg)
    votes["semantic_similarity"] = semantic

    matched = Counter()
    for text in distinct:
        for l4, _, mt, ex in rules:
            if not any(p.search(text) for p in ex) and any(p.search(text) for p in mt):
                matched[l4] += 1
    decided = votes["phrasing_rules"].value_counts()
    rule_hits = pd.DataFrame([{"L2": tax.l4_parent[l4], "L4": l4, "tier": tier,
                               "distinct_texts_matched": matched.get(l4, 0), "rows_decided": int(decided.get(l4, 0))}
                              for l4, tier, _, _ in rules]).sort_values(["L2", "rows_decided"], ascending=[True, False])
    silent = rule_hits.loc[rule_hits["distinct_texts_matched"] == 0, "L4"].tolist()
    if silent:
        log.info("%d taxonomy rules matched no row in this data: %s", len(silent), ", ".join(silent[:20]))

    names = list(votes)
    l2_index = {n: i for i, n in enumerate(tax.l2_names)}
    V4 = np.column_stack([[v if isinstance(v, str) else None for v in votes[n]] for n in names]).astype(object)
    L = np.vectorize(lambda v: l2_index[tax.l4_parent[v]] if v else -1, otypes=[int])(V4)
    for j, n in enumerate(names):
        fired = np.flatnonzero(L[:, j] >= 0)[:3]
        log.debug("%s examples: %s", n, " | ".join(f"{V4[i, j]} <- {df['text_raw'].iat[i][:60]}" for i in fired))

    agreement = pd.DataFrame(index=names, columns=names, dtype=float)
    for a in range(len(names)):
        for b in range(len(names)):
            on = (L[:, a] >= 0) & (L[:, b] >= 0)
            agreement.iloc[a, b] = np.mean(L[on, a] == L[on, b]) if on.sum() >= cfg.min_source_overlap else np.nan
    log.info("pairwise agreement between label sources:\n%s", agreement.round(3).to_string())

    # Dawid-Skene assumes sources make independent mistakes. The semantic source is built on the L4 name words,
    # so it is admitted only if it agrees with the phrasing rules at least as often as name matching does.
    decision = {"phrasing_rules": "used: independent rule source", "name_matching": "used: independent rule source"}
    reference_agreement = agreement.at["name_matching", "phrasing_rules"]
    own = agreement.at["semantic_similarity", "phrasing_rules"]
    if np.isnan(own) or np.isnan(reference_agreement):
        decision["semantic_similarity"] = "rejected: too little overlap with the phrasing rules to test it"
    elif own >= reference_agreement:
        decision["semantic_similarity"] = f"used: agrees with phrasing rules {own:.3f} >= name matching {reference_agreement:.3f}"
    else:
        decision["semantic_similarity"] = f"rejected: agrees with phrasing rules {own:.3f} < name matching {reference_agreement:.3f}"
    log.info("label source semantic_similarity %s", decision["semantic_similarity"])
    used = [j for j, n in enumerate(names) if decision[n].startswith("used")]
    V4u, Lu, used_names = V4[:, used], L[:, used], [names[j] for j in used]

    lo, hi = pair(cfg.source_accuracy_bounds, float)
    start = []
    for n in used_names:
        if n == "semantic_similarity" and semantic_acc:
            start.append(semantic_acc)
        else:
            others = [agreement.at[n, o] for o in used_names if o != n and not np.isnan(agreement.at[n, o])]
            start.append(np.mean(others) if others else np.nan)
    acc0 = np.array(start, dtype=float)
    acc0 = np.clip(np.where(np.isnan(acc0), np.nanmean(acc0) if np.isfinite(acc0).any() else (lo + hi) / 2, acc0), lo, hi)

    covered = (Lu >= 0).any(1)
    df["label_l2"], df["label_l4"], df["sources_agreeing"], df["label_source"] = "", "", 0, ""
    accuracy = acc0
    if covered.any():
        q, accuracy = dawid_skene(Lu[covered], acc0, tax.k, cfg)
        winner = np.full(len(df), -1)
        winner[covered] = q.argmax(1)
        df["label_l2"] = [tax.l2_names[w] if w >= 0 else "" for w in winner]
        df["sources_agreeing"] = ((Lu == winner[:, None]) & (Lu >= 0)).sum(1)
        ranking = np.argsort(-np.asarray(accuracy))
        l4, source = [], []
        for i, w in enumerate(winner):
            pick = next((j for j in ranking if w >= 0 and V4u[i, j] and Lu[i, j] == w), None)
            l4.append(V4u[i, pick] if pick is not None else "")
            source.append(used_names[pick] if pick is not None else "")
        df["label_l4"], df["label_source"] = l4, source
    estimate = dict(zip(used_names, accuracy))
    sources = pd.DataFrame({"label_source": names, "coverage_rows": (L >= 0).mean(0), "used_in_vote": [n in estimate for n in names],
                            "decision": [decision[n] for n in names], "estimated_accuracy": [estimate.get(n, np.nan) for n in names]})
    log.info("labelled %s of %s rows (%.1f%%) from %d sources; estimated source accuracy: %s", f"{covered.sum():,}",
             f"{len(df):,}", 100 * covered.mean(), len(used_names), ", ".join(f"{n} {a:.3f}" for n, a in estimate.items()))
    log.info("label L2 distribution: %s", ", ".join(f"{k} {v:,}" for k, v in df.loc[covered, "label_l2"].value_counts().items()))
    return Labels(sources, agreement.reset_index().rename(columns={"index": "source"}), rule_hits, prototypes, proto_report, name_l4)


# %% label cleaning and taxonomy consistency (v9)
def oof_proba(frame, y, feats, cfg):
    """Out-of-fold class probabilities: every text is scored by a logistic regression that never saw its
    near-duplicate group."""
    classes = np.unique(y)
    P = np.zeros((len(y), len(classes)))
    folds = min(cfg.clean_folds, frame["group"].nunique())
    if folds < 2 or len(classes) < 2:
        P[np.arange(len(y)), np.searchsorted(classes, y)] = 1.0
        return P, classes
    X = feats.sparse(frame)
    for fit_idx, held_idx in GroupKFold(n_splits=folds).split(X, y, frame["group"]):
        if len(np.unique(y[fit_idx])) < 2:
            P[held_idx, np.searchsorted(classes, y[fit_idx][0])] = 1.0
            continue
        model = LogisticRegression(C=cfg.clean_c, max_iter=cfg.clean_max_iter).fit(X[fit_idx], y[fit_idx])
        P[np.ix_(held_idx, np.searchsorted(classes, model.classes_))] = model.predict_proba(X[held_idx])
    return P, classes


def confident_issues(P, yi):
    """Confident learning (Northcutt et al. 2021): class j's threshold is the mean out-of-fold probability of j
    on texts labelled j. A text is a likely label error when another class clears its own threshold and scores
    above the given label. Returns the suggested class index (-1 = no issue)."""
    n, k = P.shape
    thresholds = np.array([P[yi == j, j].mean() if (yi == j).any() else np.inf for j in range(k)])
    above = P >= thresholds
    above[np.arange(n), yi] = False
    alt = np.where(above, P, -1.0).argmax(1)
    issue = above.any(1) & (P[np.arange(n), alt] > P[np.arange(n), yi])
    return np.where(issue, alt, -1)


class LabelCleaner:
    """Phase 1 and 2 of v9, applied to the training labels before any split.

    1. L2 cleaning: out-of-fold confident learning flags texts whose label disagrees with what the rest of the data
       teaches. A flagged label is corrected only when an independent source points to the same L2 (a rule that
       fires for it or the L4-name match) and that evidence is at least as specific as the current label's rule
       (most specific need wins; equally specific needs are decided by the data, not by word order alone).
       A flag without corroboration marks the text 'doubtful': it stays in the evaluation but not in training.
    2. L4 cleaning inside each L2, with the same rule.
    3. Fallback consolidation: a domain-fallback L4 moves to a specific L4 when an out-of-fold model trained on
       the specific rows of that L2 clears a confidence bar set at --high-precision on those rows.
    4. Small-L4 merge: a specific L4 with fewer than --min-l4-support labelled rows is merged into its L2's
       domain-fallback L4 (a vague but true label) or, where the L2 has none, into the sibling its rows are most often
       predicted as (out-of-fold). Domain-fallback L4 are never merged away: a vague row must not get a specific claim.
    """

    def __init__(self, tax, evidence, name_vote, feats, cfg):
        self.tax, self.evidence, self.name_vote, self.feats, self.cfg = tax, evidence, name_vote, feats, cfg
        self.events, self.merges, self.report = [], {}, []

    def _support(self, text, target, level):
        """Best independent evidence for an L2 (level 2) or an L4 (level 4) in a text: (tier, L4) or None."""
        hits = [(h[0], h[3]) for h in self.evidence.hits(text)
                if (self.tax.l4_parent[h[3]] if level == 2 else h[3]) == target]
        name = self.name_vote.get(text)
        if isinstance(name, str) and (self.tax.l4_parent[name] if level == 2 else name) == target:
            hits.append((self.tax.tier(name), name))
        return min(hits) if hits else None

    def _current_tier(self, text, l4):
        tiers = [h[0] for h in self.evidence.hits(text) if h[3] == l4]
        return min(tiers) if tiers else np.inf

    def _correct(self, texts, frame, column, level, round_no):
        """One confident-learning pass over `frame` (distinct texts) for `column`; returns corrections."""
        y = frame[column].to_numpy().astype(str)
        P, classes = oof_proba(frame, y, self.feats, self.cfg)
        alt = confident_issues(P, np.searchsorted(classes, y))
        changes, doubtful = {}, set()
        for i in np.flatnonzero(alt >= 0):
            text, target = texts[i], classes[alt[i]]
            support = self._support(text, target, level)
            current_l4 = frame["label_l4"].iat[i]
            if support is not None and support[0] <= self._current_tier(text, current_l4):
                new_l4 = support[1] if level == 2 else target
                changes[text] = (target if level == 2 else frame["label_l2"].iat[i], new_l4)
                self.events.append({"round": round_no, "level": f"L{level}", "action": "corrected", "text": text,
                                    "old_L2": frame["label_l2"].iat[i], "old_L4": current_l4,
                                    "new_L2": changes[text][0], "new_L4": new_l4, "model_probability": P[i, alt[i]],
                                    "evidence": f"{'rule' if support[1] in [h[3] for h in self.evidence.hits(text)] else 'L4 name'} "
                                                f"{support[1]} (tier {support[0]})"})
            else:
                doubtful.add(text)
        return changes, doubtful, P, classes

    def run(self, df):
        tax, cfg = self.tax, self.cfg
        df["label_l2_initial"], df["label_l4_initial"], df["label_action"] = df["label_l2"], df["label_l4"], ""
        labelled = df["label_l2"] != ""
        texts_df = df[labelled].drop_duplicates("text_model").reset_index(drop=True)
        doubtful = set()
        if cfg.clean_labels:
            for round_no in range(1, cfg.clean_rounds + 1):
                keep = texts_df[~texts_df["text_model"].isin(doubtful)].reset_index(drop=True)
                changes, flagged, _, _ = self._correct(keep["text_model"].to_numpy(), keep, "label_l2", 2, round_no)
                doubtful |= flagged
                self._apply(texts_df, changes)
                log.info("label cleaning round %d (L2): %s texts corrected, %s doubtful so far", round_no,
                         f"{len(changes):,}", f"{len(doubtful):,}")
                if not changes:
                    break
            for parent, block in texts_df[~texts_df["text_model"].isin(doubtful)].groupby("label_l2"):
                block = block[block["label_l4"] != ""].reset_index(drop=True)
                if block["label_l4"].nunique() < 2 or len(block) < cfg.clean_min_rows:
                    continue
                changes, flagged, _, _ = self._correct(block["text_model"].to_numpy(), block, "label_l4", 4, 1)
                doubtful |= flagged
                self._apply(texts_df, changes)
            log.info("label cleaning (L4): %s corrections in total, %s texts doubtful",
                     f"{sum(e['action'] == 'corrected' for e in self.events):,}", f"{len(doubtful):,}")
        if cfg.consolidate_fallback:
            self._consolidate(texts_df, doubtful)
        if cfg.min_l4_support > 0:
            self._merge_small(texts_df, df, doubtful)
        by_text = texts_df.set_index("text_model")
        rows = df.index[labelled]
        df.loc[rows, "label_l2"] = df.loc[rows, "text_model"].map(by_text["label_l2"]).to_numpy()
        df.loc[rows, "label_l4"] = df.loc[rows, "text_model"].map(by_text["label_l4"]).to_numpy()
        df["label_l4"] = df["label_l4"].map(lambda x: self.merges.get(x, x))
        df["label_doubtful"] = df["text_model"].isin(doubtful) & labelled
        changed2 = labelled & (df["label_l2"] != df["label_l2_initial"])
        changed4 = labelled & (df["label_l4"] != df["label_l4_initial"])
        df.loc[changed4, "label_action"] = "L4 changed"
        df.loc[changed2, "label_action"] = "L2 changed"
        df.loc[df["label_doubtful"], "label_action"] = "doubtful (kept for evaluation, not used for training)"
        summary = pd.DataFrame([
            ("labelled rows", int(labelled.sum())),
            ("rows whose L2 label changed", int(changed2.sum())),
            ("rows whose L4 label changed (incl. L2 changes, consolidation and merges)", int(changed4.sum())),
            ("rows marked doubtful (not used for training)", int(df["label_doubtful"].sum())),
            ("domain-fallback L4 labels before", int(df.loc[labelled, "label_l4_initial"].isin(tax.fallback).sum())),
            ("domain-fallback L4 labels after", int(df.loc[labelled, "label_l4"].isin(tax.fallback).sum())),
            ("L4 merged for too little data", len(self.merges))], columns=["measure", "value"])
        log.info("label cleaning summary:\n%s", summary.to_string(index=False))
        events = pd.DataFrame(self.events)
        merges = pd.DataFrame(self.report)
        return summary, events, merges

    @staticmethod
    def _apply(texts_df, changes):
        if not changes:
            return
        hit = texts_df["text_model"].isin(changes)
        new = texts_df.loc[hit, "text_model"].map(changes)
        texts_df.loc[hit, "label_l2"] = new.map(lambda v: v[0]).to_numpy()
        texts_df.loc[hit, "label_l4"] = new.map(lambda v: v[1]).to_numpy()

    def _consolidate(self, texts_df, doubtful):
        """A domain-fallback label moves to a specific L4 only when an out-of-fold model that also knows the
        fallback class (so it can answer 'vague') predicts the specific L4 with a confidence that reaches
        --high-precision on that L2's specific texts. A text that only names the area keeps the fallback."""
        tax, cfg = self.tax, self.cfg
        moved_total = 0
        usable = texts_df[~texts_df["text_model"].isin(doubtful) & (texts_df["label_l4"] != "")]
        for parent, block in usable.groupby("label_l2"):
            is_vague = block["label_l4"].isin(tax.fallback).to_numpy()
            specific_classes = block.loc[~is_vague, "label_l4"].nunique()
            if not is_vague.any() or specific_classes < 2 or len(block) < cfg.clean_min_rows:
                continue
            y = block["label_l4"].to_numpy().astype(str)
            P, classes = oof_proba(block.reset_index(drop=True), y, self.feats, cfg)
            pred, conf = classes[P.argmax(1)], P.max(1)
            share, bar = coverage_at(conf[~is_vague], pred[~is_vague] == y[~is_vague], cfg.high_precision)
            if not np.isfinite(bar):
                continue
            move = is_vague & ~np.isin(pred, list(tax.fallback)) & (conf >= bar)
            for text, old, new, prob in zip(block["text_model"].to_numpy()[move], y[move], pred[move], conf[move]):
                self.events.append({"round": 0, "level": "L4", "action": "fallback consolidated", "text": text,
                                    "old_L2": parent, "old_L4": old, "new_L2": parent, "new_L4": new, "model_probability": prob,
                                    "evidence": f"out-of-fold bar {bar:.3f} at {cfg.high_precision:.0%} precision, fallback class known to the model"})
            texts_df.loc[block.index[move], "label_l4"] = pred[move]
            moved_total += int(move.sum())
            log.debug("fallback consolidation %-36s bar %.3f (covers %.0f%% of specific texts), %d of %d vague texts moved",
                      parent, bar, 100 * share, int(move.sum()), int(is_vague.sum()))
        log.info("fallback consolidation: %s distinct texts moved from a domain-fallback L4 to a specific L4", f"{moved_total:,}")

    def _merge_small(self, texts_df, df, doubtful):
        """Merge L4 with too few labelled rows into the sibling their texts are most often predicted as."""
        tax, cfg = self.tax, self.cfg
        while True:
            rows_per_text = df[df["label_l2"] != ""].groupby("text_model").size()
            counts = (texts_df.assign(rows=texts_df["text_model"].map(rows_per_text).fillna(1))
                      .groupby(["label_l2", "label_l4"])["rows"].sum())
            counts = counts[[l4 != "" for _, l4 in counts.index]]
            small = counts[counts < cfg.min_l4_support].sort_values()
            small = small[[l4 not in tax.fallback for _, l4 in small.index]]
            candidate = None
            for (parent, l4), n in small.items():
                siblings = [c for c in counts.loc[parent].index if c != l4 and c != ""]
                if siblings:
                    candidate = (parent, l4, int(n), siblings)
                    break
            if candidate is None:
                return
            parent, l4, n, siblings = candidate
            block = texts_df[(texts_df["label_l2"] == parent) & (texts_df["label_l4"] != "")].reset_index(drop=True)
            y = block["label_l4"].to_numpy().astype(str)
            P, classes = oof_proba(block, y, self.feats, cfg)
            mine = y == l4
            sibling_cols = [i for i, c in enumerate(classes) if c in siblings]
            vague = [c for c in siblings if c in tax.fallback]
            if cfg.merge_target == "fallback_first" and vague:
                target, reason = vague[0], "domain-fallback sibling"
            else:
                target, reason = classes[sibling_cols[int(P[np.ix_(mine, sibling_cols)].mean(0).argmax())]], "most-confused sibling"
            share = float(np.mean(classes[np.array(sibling_cols)][P[np.ix_(mine, sibling_cols)].argmax(1)] == target))
            texts_df.loc[(texts_df["label_l2"] == parent) & (texts_df["label_l4"] == l4), "label_l4"] = target
            for old, new in list(self.merges.items()):
                if new == l4:
                    self.merges[old] = target
            self.merges[l4] = target
            self.report.append({"L2": parent, "merged_L4": l4, "labelled_rows": n, "merged_into": target, "reason": reason,
                                "share_of_its_texts_predicted_as_target": share, "min_l4_support": cfg.min_l4_support})
            log.info("L4 %s (%d labelled rows) merged into %s under %s (%.0f%% of its texts are predicted as %s)",
                     l4, n, target, parent, 100 * share, target)


# %% features and models
class TextFeatures:
    """Shared representations: word TF-IDF, character TF-IDF, L1 one-hot, rule evidence, first-clause TF-IDF and
    dense row vectors."""

    def __init__(self, word_vec, rows, texts, l1_values, cfg, evidence=None):
        lo, hi = pair(cfg.char_ngram, int)
        self.word_vec, self.rows = word_vec, rows
        self.char_vec = TfidfVectorizer(analyzer="char_wb", ngram_range=(lo, hi), min_df=cfg.char_min_df,
                                        sublinear_tf=True, max_features=cfg.char_max_features).fit(texts)
        self.l1_index = {v: i for i, v in enumerate(l1_values)}
        self.evidence = evidence if cfg.rule_features else None
        self.lead_vec = None
        if cfg.lead_clause_features and evidence is not None:
            leads = [evidence.lead(t) for t in texts]
            self.lead_vec = TfidfVectorizer(ngram_range=(1, 2), min_df=cfg.min_df, max_df=cfg.max_df, sublinear_tf=True,
                                            max_features=cfg.word_max_features).fit(leads)
        self.lead_of = evidence.lead if evidence is not None else None

    def l1(self, values):
        cols = np.array([self.l1_index.get(v, -1) for v in values])
        rows = np.arange(len(cols))
        ok = cols >= 0
        return csr_matrix((np.ones(ok.sum()), (rows[ok], cols[ok])), shape=(len(cols), len(self.l1_index)))

    def word(self, frame):
        return self.word_vec.transform(frame["text_model"])

    def sparse(self, frame):
        texts = frame["text_model"].tolist()
        blocks = [self.word(frame), self.char_vec.transform(texts), self.l1(frame["l1"])]
        if self.evidence is not None:
            blocks.append(self.evidence.transform(texts))
        if self.lead_vec is not None:
            blocks.append(self.lead_vec.transform([self.lead_of(t) for t in texts]))
        return hstack(blocks).tocsr()

    def full(self, frame):
        return hstack([self.sparse(frame), csr_matrix(self.rows.transform(frame["text_model"]))]).tocsr()


class NBSVM:
    """Naive-Bayes-weighted linear SVM, one-vs-rest (Wang & Manning 2012)."""

    def __init__(self, C, alpha):
        self.C, self.alpha = C, alpha

    def fit(self, X, y, w=None):
        Xb = (X > 0).astype(np.float64)
        self.classes_ = np.unique(y)
        self.ratios, self.models = [], []
        for c in self.classes_:
            p = self.alpha + np.asarray(Xb[y == c].sum(0)).ravel()
            q = self.alpha + np.asarray(Xb[y != c].sum(0)).ravel()
            r = np.log((p / p.sum()) / (q / q.sum()))
            self.ratios.append(r)
            self.models.append(LinearSVC(C=self.C).fit(X.multiply(r).tocsr(), (y == c).astype(int), sample_weight=w))
        return self

    def decision(self, X):
        return np.column_stack([m.decision_function(X.multiply(r).tocsr()) for m, r in zip(self.models, self.ratios)])


def hashed_grams(text):
    tokens = text.split()
    grams = tokens + [a + " " + b for a, b in zip(tokens, tokens[1:])]
    for t in tokens:
        w = f"<{t}>"
        grams += [w[i:i + n] for n in (3, 4, 5) for i in range(len(w) - n + 1)]
    return grams


class TextNet:
    """fastText-style network: hashed word and sub-word embeddings averaged per row, softmax output, Adam.
    Written in NumPy so it runs on CPU with no deep-learning framework."""

    def __init__(self, cfg):
        self.dim, self.epochs, self.lr, self.batch, self.seed = cfg.net_dim, cfg.net_epochs, cfg.net_lr, cfg.net_batch, cfg.seed
        self.init_scale = cfg.net_init_scale
        self.beta1, self.beta2, self.eps = pair(cfg.net_adam, float)
        self.hasher = HashingVectorizer(analyzer=hashed_grams, n_features=2 ** cfg.net_hash_bits, alternate_sign=False, norm="l1")

    def fit(self, texts, y, w=None):
        rng = np.random.default_rng(self.seed)
        X = self.hasher.transform(texts).tocsr()
        self.classes_ = np.unique(y)
        yi = np.searchsorted(self.classes_, y)
        w = np.ones(len(yi)) if w is None else np.asarray(w, float)
        self.E = rng.normal(0, self.init_scale, (X.shape[1], self.dim))
        self.W = rng.normal(0, self.init_scale, (self.dim, len(self.classes_)))
        self.b = np.zeros(len(self.classes_))
        m1 = [np.zeros_like(self.E), np.zeros_like(self.W), np.zeros_like(self.b)]
        m2 = [np.zeros_like(self.E), np.zeros_like(self.W), np.zeros_like(self.b)]
        step = 0
        for epoch in range(self.epochs):
            loss = 0.0
            batches = np.array_split(rng.permutation(len(yi)), max(1, len(yi) // self.batch))
            for batch in batches:
                Xb, yb, wb = X[batch], yi[batch], w[batch] / max(w[batch].sum(), PROB_FLOOR)
                h = np.asarray(Xb @ self.E)
                g = softmax(h @ self.W + self.b)
                loss += -np.sum(wb * np.log(np.clip(g[np.arange(len(yb)), yb], PROB_FLOOR, 1)))
                g[np.arange(len(yb)), yb] -= 1
                g *= wb[:, None]
                used = np.unique(Xb.indices)
                grads = [np.asarray(Xb[:, used].T @ (g @ self.W.T)), h.T @ g, g.sum(0)]
                step += 1
                b1, b2 = self.beta1, self.beta2
                c1, c2 = 1 - b1 ** step, 1 - b2 ** step
                # Adam; embedding rows are updated sparsely (only the rows used in this batch)
                m1[0][used] = b1 * m1[0][used] + (1 - b1) * grads[0]
                m2[0][used] = b2 * m2[0][used] + (1 - b2) * grads[0] ** 2
                self.E[used] -= self.lr * (m1[0][used] / c1) / (np.sqrt(m2[0][used] / c2) + self.eps)
                for i, param in ((1, self.W), (2, self.b)):
                    m1[i] = b1 * m1[i] + (1 - b1) * grads[i]
                    m2[i] = b2 * m2[i] + (1 - b2) * grads[i] ** 2
                    param -= self.lr * (m1[i] / c1) / (np.sqrt(m2[i] / c2) + self.eps)
            log.debug("text network epoch %d/%d, mean loss %.4f", epoch + 1, self.epochs, loss / len(batches))
        return self

    def predict_proba(self, texts):
        return softmax(np.asarray(self.hasher.transform(texts) @ self.E) @ self.W + self.b)


class L2Model:
    """One L2 classifier.

    kind: svc (calibrated LinearSVC on word TF-IDF, the existing method's classifier),
          logreg (logistic regression on word + char TF-IDF + L1 + row vectors),
          nbsvm (NB-SVM on word + char TF-IDF + L1), textnet (fastText-style network),
          blend (log-linear pool of logreg, nbsvm and textnet).
    Probabilities of logreg / nbsvm / textnet / blend are temperature-scaled on a grouped validation split.
    """

    MEMBERS = ("logreg", "nbsvm", "textnet")

    def __init__(self, kind, feats, cfg):
        self.kind, self.feats, self.cfg = kind, feats, cfg

    def fit(self, frame, y):
        started = time.perf_counter()
        y = np.asarray(y).astype(str)
        self.classes_ = np.unique(y)
        if self.kind == "svc":
            self._fit_svc(frame, y)
        else:
            fit_idx, val_idx = grouped_split(frame, self.cfg.validation_share, self.cfg.seed + 2)
            kinds = self.MEMBERS if self.kind == "blend" else (self.kind,)
            self.members = [self._fit_member(k, frame, y, fit_idx, val_idx) for k in kinds]
            if self.kind == "blend":
                self._fit_blend(frame.iloc[val_idx], y[val_idx])
        log.debug("fitted %s on %s rows, %d classes in %.1fs", self.kind, f"{len(y):,}", len(self.classes_),
                  time.perf_counter() - started)
        return self

    def _fit_svc(self, frame, y):
        smallest = pd.Series(y).value_counts().min()
        X = self.feats.word(frame)
        if smallest >= 2:
            self.model = CalibratedClassifierCV(LinearSVC(C=self.cfg.svm_c), cv=int(min(self.cfg.calibration_folds, smallest))).fit(X, y)
        else:
            log.warning("a class has a single row; LinearSVC is used without probability calibration")
            self.model = LinearSVC(C=self.cfg.svm_c).fit(X, y)

    def _fit_member(self, kind, frame, y, fit_idx, val_idx):
        cfg = self.cfg
        if len(np.unique(y[fit_idx])) < 2:
            fit_idx = np.arange(len(y))
        if kind == "logreg":
            model = LogisticRegression(max_iter=cfg.lr_max_iter, C=cfg.lr_c).fit(self.feats.full(frame.iloc[fit_idx]), y[fit_idx])
        elif kind == "nbsvm":
            model = NBSVM(cfg.nbsvm_c, cfg.nb_alpha).fit(self.feats.sparse(frame.iloc[fit_idx]), y[fit_idx])
        else:
            model = TextNet(cfg).fit(frame["text_model"].iloc[fit_idx].tolist(), y[fit_idx])
        member = {"kind": kind, "model": model, "T": 1.0}
        seen = np.isin(y[val_idx], self.classes_)
        logits = self._logits(member, frame.iloc[val_idx[seen]])
        member["T"] = fit_temperature(logits, np.searchsorted(self.classes_, y[val_idx[seen]]))
        log.debug("member %s temperature %.3f", kind, member["T"])
        return member

    def _logits(self, member, frame):
        model, kind = member["model"], member["kind"]
        if kind == "logreg":
            scores = np.log(np.clip(model.predict_proba(self.feats.full(frame)), PROB_FLOOR, 1))
        elif kind == "nbsvm":
            scores = model.decision(self.feats.sparse(frame))
        else:
            scores = np.log(np.clip(model.predict_proba(frame["text_model"].tolist()), PROB_FLOOR, 1))
        out = np.full((len(frame), len(self.classes_)), UNSEEN_CLASS_LOGIT)
        out[:, np.searchsorted(self.classes_, model.classes_)] = scores
        return out

    def _member_logp(self, member, frame):
        return np.log(np.clip(softmax(self._logits(member, frame) / member["T"]), PROB_FLOOR, 1))

    def _fit_blend(self, frame, y):
        seen = np.isin(y, self.classes_)
        frame, yi = frame.iloc[np.flatnonzero(seen)], np.searchsorted(self.classes_, y[seen])
        logp = [self._member_logp(m, frame) for m in self.members]

        def pooled(x):
            weights = np.exp(x[:-1]) / np.exp(x[:-1]).sum()
            return softmax(sum(wt * lp for wt, lp in zip(weights, logp)) / np.exp(x[-1]))

        res = minimize(lambda x: nll(pooled(x), yi), np.zeros(len(logp) + 1), method="Nelder-Mead", options={"maxiter": 3000})
        self.weights = np.exp(res.x[:-1]) / np.exp(res.x[:-1]).sum()
        self.blend_T = float(np.exp(res.x[-1]))
        log.info("blend weights: %s", ", ".join(f"{m['kind']} {wt:.2f}" for m, wt in zip(self.members, self.weights)))

    def _proba(self, frame):
        if self.kind == "svc":
            X = self.feats.word(frame)
            if hasattr(self.model, "predict_proba"):
                return self.model.predict_proba(X)
            return softmax(self.model.decision_function(X).reshape(len(frame), -1))
        if self.kind == "blend":
            pooled = sum(wt * self._member_logp(m, frame) for wt, m in zip(self.weights, self.members))
            return softmax(pooled / self.blend_T)
        return softmax(self._logits(self.members[0], frame) / self.members[0]["T"])

    def predict_proba(self, frame):
        size = self.cfg.predict_batch
        if len(frame) <= size:
            return self._proba(frame)
        return np.vstack([self._proba(frame.iloc[s:s + size]) for s in range(0, len(frame), size)])


@dataclass
class Candidate:
    kind: str
    title: str
    model: L2Model
    cal_pred: np.ndarray
    cal_conf: np.ndarray
    test_pred: np.ndarray
    test_conf: np.ndarray
    row: dict


def distinct_rows(frame, label):
    """Identical texts with the same L1 and label add no information to a model; keep one of each."""
    return frame.drop_duplicates(["text_model", "l1", label]).reset_index(drop=True)


def split_labelled(df, cfg, k):
    """Train / calibration / test from labelled rows, grouped by near-duplicate group so no text (or a close copy)
    is on both sides. Training sets keep one row per distinct text; test sets keep every row."""
    labelled = df[df["label_l2"] != ""].reset_index(drop=True)
    if len(labelled) < cfg.min_labelled_per_class * k or labelled["label_l2"].nunique() < 2:
        raise SystemExit(f"only {len(labelled)} rows received a label; check intent_taxonomy.json against this data")
    dev_idx, test_idx = grouped_split(labelled, cfg.test_share, cfg.seed)
    dev = labelled.iloc[dev_idx].reset_index(drop=True)
    train_idx, cal_idx = grouped_split(dev, cfg.test_share, cfg.seed + 1)
    fit_rows = dev.iloc[train_idx]
    if "label_doubtful" in fit_rows:
        fit_rows = fit_rows[~fit_rows["label_doubtful"]]
    train = distinct_rows(fit_rows, "label_l2")
    cal = dev.iloc[cal_idx].reset_index(drop=True)
    test = labelled.iloc[test_idx].reset_index(drop=True)
    log.info("split by near-duplicate group: train %s distinct texts (from %s rows), calibration %s rows, test %s rows; "
             "unlabelled rows %s", f"{len(train):,}", f"{len(train_idx):,}", f"{len(cal):,}", f"{len(test):,}",
             f"{(df['label_l2'] == '').sum():,}")
    return train, cal, test, labelled


def compare_l2_models(train, cal, test, feats, tax, cfg):
    """Rebuild the existing method as a baseline, then fit each candidate on the same labels and score all of them
    on the same held-out rows (McNemar against the previous step). Selection uses the calibration rows only."""
    y_tr, y_cal, y_test = (d["label_l2"].to_numpy() for d in (train, cal, test))
    confirmed = test["sources_agreeing"].to_numpy() >= cfg.confirm_sources
    cov_name = f"coverage_at_{int(cfg.coverage_accuracy * 100)}pct_accuracy"
    hp_name = f"coverage_at_{int(cfg.high_precision * 100)}pct_accuracy"
    candidates = []

    def predict(model, frame):
        P = tax.constrain(model.predict_proba(frame), model.classes_, frame["l1"])
        return model.classes_[P.argmax(1)], P.max(1)

    def add(kind, title, model, detail=""):
        cal_pred, cal_conf = predict(model, cal)
        test_pred, test_conf = predict(model, test)
        correct = test_pred == y_test
        row = {"model": title, "accuracy": correct.mean(), "macro_F1": f1_score(y_test, test_pred, average="macro"),
               cov_name: coverage_at(test_conf, correct, cfg.coverage_accuracy)[0],
               hp_name: coverage_at(test_conf, correct, cfg.high_precision)[0],
               "ECE": ece(test_conf, correct, cfg.ece_bins)}
        if confirmed.any():
            row["accuracy_on_confirmed_labels"] = correct[confirmed].mean()
        if candidates:
            before = candidates[-1].test_pred == y_test
            gained, lost = int((~before & correct).sum()), int((before & ~correct).sum())
            row.update(gained=gained, lost=lost, mcnemar_p=binomtest(gained, gained + lost, 0.5).pvalue if gained + lost else 1.0)
        row["detail"] = detail
        candidates.append(Candidate(kind, title, model, cal_pred, cal_conf, test_pred, test_conf, row))
        log.info("%-60s acc %.3f  macro-F1 %.3f  cov@%d%% %.3f  cov@%d%% %.3f%s", title, row["accuracy"], row["macro_F1"],
                 int(cfg.coverage_accuracy * 100), row[cov_name], int(cfg.high_precision * 100), row[hp_name],
                 f"  McNemar p {row['mcnemar_p']:.2g}" if "mcnemar_p" in row else "")

    # existing method: k-means groups -> majority label per group -> calibrated LinearSVC
    Xw = feats.word(train)
    space = normalize(TruncatedSVD(n_components=min(cfg.emb_dims, Xw.shape[1] - 1), random_state=cfg.seed).fit_transform(Xw))
    best_k, best_s, best_km = None, -1.0, None
    for k in sorted({m * tax.k for m in pair(cfg.kmeans_multiples, int)}):
        if k >= len(train):
            continue
        km = MiniBatchKMeans(n_clusters=k, random_state=cfg.seed, n_init=3).fit(space)
        s = silhouette_score(space, km.labels_, sample_size=min(cfg.silhouette_sample, len(train)), random_state=cfg.seed)
        log.debug("baseline k-means k=%d silhouette %.3f", k, s)
        if s > best_s:
            best_k, best_s, best_km = k, s, km
    y_km = pd.Series(y_tr).groupby(best_km.labels_).agg(lambda s: s.value_counts().idxmax()).reindex(best_km.labels_).to_numpy()
    add("baseline", "Existing method: TF-IDF + k-means + calibrated LinearSVC", L2Model("svc", feats, cfg).fit(train, y_km),
        f"k={best_k}, silhouette {best_s:.3f}, k-means label purity {np.mean(y_km == y_tr):.3f}")

    for kind, title in [("svc", "+ statistical labels (calibrated LinearSVC)"),
                        ("logreg", "+ char n-grams, L1 and row vectors (logistic regression)"),
                        ("nbsvm", "+ NB-SVM weighting"),
                        ("textnet", "+ fastText-style neural network"),
                        ("blend", "+ calibrated blend (logreg, NB-SVM, neural network)")]:
        add(kind, title, L2Model(kind, feats, cfg).fit(train, y_tr))

    # the goal is rows that need no review, so rank by coverage at the high-precision target first
    def merit(c):
        right = c.cal_pred == y_cal
        return (round(coverage_at(c.cal_conf, right, cfg.high_precision)[0], 3),
                round(coverage_at(c.cal_conf, right, cfg.coverage_accuracy)[0], 3), right.mean())

    for c in candidates[1:]:
        log.debug("calibration merit %-8s %s", c.kind, merit(c))
    chosen = max(candidates[1:], key=merit)
    log.info("selected on calibration rows: %s (coverage at %.0f%% accuracy %.3f)", chosen.kind, 100 * cfg.high_precision, merit(chosen)[0])
    return candidates, chosen, pd.DataFrame([c.row for c in candidates])


def top_terms_per_l2(frame, labels, feats, n):
    """Words that most separate each L2 from the rest (NB log-count ratio), to explain what the model keys on."""
    X = (feats.word(frame) > 0).astype(float)
    vocab = feats.word_vec.get_feature_names_out()
    rows = []
    for c in np.unique(labels):
        p = 1 + np.asarray(X[labels == c].sum(0)).ravel()
        q = 1 + np.asarray(X[labels != c].sum(0)).ravel()
        rows.append({"L2": c, "top_terms": ", ".join(vocab[np.argsort(-np.log((p / p.sum()) / (q / q.sum())))[:n]])})
    return pd.DataFrame(rows)


# %% L4
class L4Model:
    """L4 is chosen only among the children of the row's L2. A classifier is trained per L2 where at least two
    children have labelled rows; otherwise the semantic prototypes of the children decide."""

    def __init__(self, feats, tax, prototypes, cfg):
        self.feats, self.tax, self.prototypes, self.cfg = feats, tax, prototypes, cfg

    def fit(self, frame, l2, l4):
        l2, l4 = np.asarray(l2), np.asarray(l4)
        self.models, self.most_common = {}, {}
        for parent in sorted(set(l2)):
            idx = np.flatnonzero(l2 == parent)
            counts = pd.Series(l4[idx]).value_counts()
            self.most_common[parent] = counts.index[0]
            if counts.size >= 2:
                self.models[parent] = LogisticRegression(max_iter=self.cfg.lr_max_iter, C=self.cfg.lr_c).fit(
                    self.feats.full(frame.iloc[idx]), l4[idx])
            log.debug("L4 under %-16s %s rows, %d of %d children seen", parent, f"{len(idx):,}", counts.size,
                      len(self.tax.tree.get(parent, [])))
        log.info("L4 models: %d L2 with a classifier, %d with a single observed child", len(self.models),
                 len(self.most_common) - len(self.models))
        return self

    def joint_proba(self, frame, P2, l2_classes):
        """P(L4) = sum over L2 of P(L2) * P(L4 | L2); an L2 without a classifier puts its mass on its most common L4
        (or on itself for an L2 discovered in the data)."""
        names = sorted({c for m in self.models.values() for c in m.classes_} | set(self.most_common.values()) | set(l2_classes))
        col = {n: i for i, n in enumerate(names)}
        out = np.zeros((len(frame), len(names)))
        X = self.feats.full(frame) if self.models else None
        for j, parent in enumerate(l2_classes):
            if parent in self.models:
                m = self.models[parent]
                out[:, [col[c] for c in m.classes_]] += P2[:, [j]] * m.predict_proba(X)
            else:
                out[:, col[self.most_common.get(parent, parent)]] += P2[:, j]
        keep = out.sum(0) > 0
        return out[:, keep], [n for n, k in zip(names, keep) if k]

    def decide(self, frame, P2, l2_classes, top_k, weight):
        """Joint L2 + L4 decision: among the top-k L2 of each row, the pair with the highest
        log P(L2) + weight * log P(L4 | L2). weight 0 is the plain L2-first decision. Returns L2, L4, L4 confidence."""
        n = len(frame)
        top = np.argsort(-P2, axis=1)[:, :max(1, top_k)]
        best = np.full(n, -np.inf)
        out_l2 = np.array(l2_classes)[top[:, 0]].astype(object)
        out_l4 = np.full(n, "", dtype=object)
        out_c4 = np.zeros(n)
        for j, parent in enumerate(l2_classes):
            idx = np.flatnonzero((top == j).any(1))
            if not len(idx) or parent not in self.most_common and parent not in self.tax.tree:
                continue
            l4, c4 = self.predict(frame.iloc[idx], np.full(len(idx), parent))
            score = np.log(np.clip(P2[idx, j], PROB_FLOOR, 1)) + weight * np.log(np.clip(c4, PROB_FLOOR, 1))
            better = score > best[idx]
            sel = idx[better]
            best[sel], out_l2[sel], out_l4[sel], out_c4[sel] = score[better], parent, l4[better], c4[better]
        return out_l2, out_l4, out_c4

    def predict(self, frame, l2):
        l2 = np.asarray(l2)
        out = np.full(len(frame), "", dtype=object)
        conf = np.zeros(len(frame))
        for parent in sorted(set(l2)):
            idx = np.flatnonzero(l2 == parent)
            sub = frame.iloc[idx]
            if parent in self.models:
                P = self.models[parent].predict_proba(self.feats.full(sub))
                out[idx], conf[idx] = self.models[parent].classes_[P.argmax(1)], P.max(1)
                continue
            children = [c for c in self.tax.tree.get(parent, []) if c in self.prototypes]
            if len(children) >= 2 and isinstance(self.feats.rows, DomainEmbeddings):
                S = self.feats.rows.transform(sub["text_model"]) @ np.vstack([self.prototypes[c] for c in children]).T
                out[idx], conf[idx] = np.array(children)[S.argmax(1)], softmax(S * 10).max(1)
            elif parent in self.most_common:
                out[idx], conf[idx] = self.most_common[parent], 1.0
            elif self.tax.tree.get(parent):
                fallback = [c for c in self.tax.tree[parent] if self.tax.tier(c) >= self.cfg.generic_tier] or self.tax.tree[parent]
                out[idx] = fallback[0]
                log.warning("L2 %s has no L4 evidence; %d rows get %s", parent, len(idx), fallback[0])
        return out, conf


# %% topic discovery
def edit_distance(a, b):
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


class TopicNamer:
    """Readable cluster names: the cluster's most distinctive real collocation (normalised PMI above the corpus
    median), the one found in most of its rows and earliest in the sentence; rare misspellings are mapped to the
    common spelling. Without a collocation, its two most distinctive words in their usual order."""

    def __init__(self, contents, n_rows, cfg):
        self.cfg, self.n_rows = cfg, n_rows
        tokens = [t.split() for t in contents]
        self.freq = Counter(w for ts in tokens for w in ts)
        bigrams = Counter(b for ts in tokens for b in zip(ts, ts[1:]))
        total_words, total_pairs = max(sum(self.freq.values()), 1), max(sum(bigrams.values()), 1)
        npmi = {}
        for (a, b), c in bigrams.items():
            if c < cfg.bigram_min_count:
                continue
            p_ab = c / total_pairs
            if p_ab >= 1:
                continue
            pmi = np.log(p_ab / ((self.freq[a] / total_words) * (self.freq[b] / total_words)))
            npmi[f"{a} {b}"] = pmi / -np.log(p_ab)
        bar = np.quantile(list(npmi.values()), cfg.phrase_npmi_quantile) if npmi else np.inf
        self.phrases = {p for p, v in npmi.items() if v >= bar}
        self.by_initial = defaultdict(list)
        for w, f in self.freq.items():
            self.by_initial[w[:1]].append((w, f))
        self.cache = {}
        log.debug("topic namer: %d collocations above NPMI %.3f", len(self.phrases), bar)

    def canonical(self, w):
        if w in self.cache:
            return self.cache[w]
        f0, limit = self.freq.get(w, 0), 1 if len(w) <= 5 else 2
        best = w
        if f0 <= self.cfg.typo_max_share * self.n_rows:
            options = [(f, v) for v, f in self.by_initial[w[:1]]
                       if v != w and f >= self.cfg.spelling_ratio * max(f0, 1) and abs(len(v) - len(w)) <= limit]
            options = [(f, v) for f, v in options if edit_distance(v, w) <= limit]
            if options:
                best = max(options)[1]
        self.cache[w] = best
        return best

    def name(self, member_contents, ranked_terms):
        rows = [t.split() for t in member_contents]
        options = [t for t in ranked_terms if " " in t and t in self.phrases] or [t for t in ranked_terms if " " not in t][:2]
        if not options or not rows:
            return "UNNAMED", False

        def where(term, tokens):
            parts = term.split()
            for i in range(len(tokens) - len(parts) + 1):
                if tokens[i:i + len(parts)] == parts:
                    return i / max(len(tokens), 1)
            return None

        if " " in options[0]:
            scored = []
            for term in options:
                hits = [p for p in (where(term, ts) for ts in rows) if p is not None]
                scored.append((len(hits) / len(rows), -np.mean(hits) if hits else -1.0, term))
            words = max(scored)[2].split()
        else:
            words = sorted(options, key=lambda t: np.mean([p for p in (where(t, ts) for ts in rows) if p is not None] or [1]))
        return "_".join(dict.fromkeys(self.canonical(w) for w in words)).upper(), " " in options[0]


def reduce_for_clustering(X, cfg):
    try:
        import umap  # optional; used when installed
        reducer = umap.UMAP(n_components=min(cfg.cluster_dims, X.shape[1] - 1), n_neighbors=cfg.umap_neighbours,
                            min_dist=0.0, metric="cosine", random_state=cfg.seed, n_jobs=1)
        log.info("clustering space: UMAP to %d dims", reducer.n_components)
        return reducer.fit_transform(X)
    except ImportError:
        dims = min(cfg.cluster_dims, X.shape[1])
        log.info("clustering space: PCA to %d dims (install umap-learn for UMAP)", dims)
        return normalize(PCA(n_components=dims, random_state=cfg.seed).fit_transform(X))


def discover_topics(df, rows_encoder, tax, cfg, rng):
    """Cluster rows by meaning without assuming the L2 list. Words that appear equally under every L2 (how
    agents write, not what the issue is) are removed first; the rest is embedded, reduced and clustered with
    HDBSCAN. Identical texts are kept at most --dup-cap times so a frequent sentence cannot dominate the density.
    Each cluster is tested for bootstrap stability and compared with the known L2."""
    labelled = (df["label_l2"] != "").to_numpy()
    counter = CountVectorizer(token_pattern=TOKEN.pattern, binary=True, min_df=cfg.min_df)
    B = counter.fit_transform(df["text_model"]).tocsc()
    vocab = counter.get_feature_names_out()
    l2_index = {n: i for i, n in enumerate(tax.l2_names)}
    Y = np.zeros((len(df), tax.k))
    Y[np.flatnonzero(labelled), [l2_index[v] for v in df.loc[labelled, "label_l2"]]] = 1
    by_l2 = np.asarray(B[np.flatnonzero(labelled)].T @ Y[labelled])
    rate = by_l2 / np.maximum(Y.sum(0), 1)
    share = rate / np.maximum(rate.sum(1, keepdims=True), PROB_FLOOR)
    entropy = -(share * np.log(np.where(share > 0, share, 1))).sum(1) / np.log(max(tax.k, 2))
    neutral = (by_l2.sum(1) >= cfg.neutral_min_rows) & (entropy >= cfg.neutral_entropy)
    phrasing = set(vocab[neutral]) | set(ENGLISH_STOP_WORDS) | set(PLACEHOLDERS)
    word_roles = pd.DataFrame({"word": vocab, "rows": np.asarray(B.sum(0)).ravel(), "spread_across_L2": entropy, "phrasing_word": neutral})
    df["content"] = df["text_model"].map(lambda t: " ".join(w for w in TOKEN.findall(t) if w not in phrasing))
    log.info("phrasing words removed before clustering: %d (most frequent: %s)", neutral.sum(),
             ", ".join(word_roles[word_roles["phrasing_word"]].nlargest(10, "rows")["word"]))

    df["has_content"] = df["content"].str.len() > 0
    keep = df[df["has_content"]].groupby("content", sort=False).head(cfg.dup_cap)
    work_idx = keep.index.to_numpy()
    if len(work_idx) > cfg.max_cluster_rows:
        work_idx = np.sort(rng.choice(work_idx, size=cfg.max_cluster_rows, replace=False))
    log.info("clustering %s rows (%s distinct contents, at most %d copies each)", f"{len(work_idx):,}",
             f"{df.loc[work_idx, 'content'].nunique():,}", cfg.dup_cap)
    empty = {"work": df.iloc[:0], "labels": np.array([], dtype=int), "space": np.zeros((0, 2)), "clusters": pd.DataFrame(),
             "verdicts": pd.DataFrame(), "word_roles": word_roles, "row_cluster": pd.Series(-1, index=df["row_id"]), "centroids": {}}
    if len(work_idx) < 2 * cfg.min_cluster_size:
        log.warning("too few rows with content to cluster (%d)", len(work_idx))
        return empty
    work = df.loc[work_idx].reset_index(drop=True)
    work_vectors = rows_encoder.transform(work["content"])
    space = reduce_for_clustering(work_vectors, cfg)

    def cluster(points):
        return HDBSCAN(min_cluster_size=cfg.min_cluster_size, min_samples=cfg.min_samples or max(1, cfg.min_cluster_size // 3),
                       copy=True).fit(points).labels_

    labels = cluster(space)
    runs = []
    for r in range(cfg.stability_runs):
        idx = rng.choice(len(space), size=int(cfg.stability_share * len(space)), replace=False)
        runs.append((idx, cluster(space[idx])))
        log.debug("stability run %d/%d: %d clusters", r + 1, cfg.stability_runs, runs[-1][1].max() + 1)
    ids = sorted(set(labels) - {-1})
    content_cluster = pd.Series(labels, index=work["content"]).groupby(level=0).agg(lambda s: s.value_counts().index[0])
    row_cluster = pd.Series(df["content"].map(content_cluster).fillna(-1).astype(int).to_numpy(), index=df["row_id"])
    log.info("HDBSCAN: %d clusters; %.1f%% of all rows sit in a cluster", len(ids), 100 * np.mean(row_cluster.to_numpy() >= 0))
    if not ids:
        empty.update(work=work, labels=labels, space=space, row_cluster=row_cluster)
        return empty

    # class-based TF-IDF: one document per known L2 and per cluster
    terms_vec = CountVectorizer(ngram_range=(1, 2), min_df=cfg.char_min_df, token_pattern=TOKEN.pattern)
    C = terms_vec.fit_transform(work["content"])
    terms = terms_vec.get_feature_names_out()
    wl = work["label_l2"].to_numpy()
    tf = np.vstack([np.asarray(C[wl == n].sum(0)).ravel() for n in tax.l2_names] + [np.asarray(C[labels == c].sum(0)).ravel() for c in ids])
    W = normalize(tf / np.maximum(tf.sum(1, keepdims=True), 1) * np.log(1 + tf.sum(1).mean() / np.maximum(tf.sum(0), 1)))
    fit = W[tax.k:] @ W[:tax.k].T
    namer = TopicNamer(work["content"], len(df), cfg)
    centroids = {c: normalize(work_vectors[labels == c].mean(0, keepdims=True))[0] for c in ids}
    members_of = df.groupby(row_cluster.to_numpy()).indices

    rows = []
    for i, c in enumerate(ids):
        sample_members = np.flatnonzero(labels == c)
        member_set = set(sample_members)
        jaccard = []
        for idx, run in runs:
            overlap = set(run[np.isin(idx, sample_members)]) - {-1}
            jaccard.append(max((len(member_set & set(idx[run == b])) / len(member_set | set(idx[run == b])) for b in overlap), default=0.0))
        members = df.iloc[members_of.get(c, [])]
        lab = members[members["label_l2"] != ""]
        top_l2 = lab["label_l2"].value_counts()
        top_l4 = lab["label_l4"].replace("", np.nan).dropna().value_counts()
        unseen = members[members["label_l2"] == ""]
        unseen = unseen if len(unseen) else members
        placed = unseen["pred_l2"].value_counts()
        ranked = [terms[j] for j in np.argsort(-W[tax.k + i])[:15] if W[tax.k + i, j] > 0]
        name, is_phrase = namer.name(work["content"].iloc[sample_members], ranked)
        rows.append({"cluster": int(c), "rows": len(members), "share_of_rows": len(members) / len(df), "distinct_texts": members["text_model"].nunique(),
                     "stability": float(np.mean(jaccard)), "label_coverage": len(lab) / max(len(members), 1),
                     "label_L2": top_l2.index[0] if len(top_l2) else "", "label_purity": float(top_l2.iloc[0] / len(lab)) if len(lab) else 0.0,
                     "label_L4": top_l4.index[0] if len(top_l4) else "", "label_L4_purity": float(top_l4.iloc[0] / len(lab)) if len(top_l4) else 0.0,
                     "best_vocabulary_L2": tax.l2_names[int(fit[i].argmax())], "vocabulary_fit": float(fit[i].max()),
                     "model_L2": placed.index[0], "model_L2_share": placed.iloc[0] / len(unseen), "model_confidence": float(unseen["l2_confidence"].mean()),
                     "name": name, "name_is_phrase": is_phrase, "top_terms": ", ".join(ranked[:10]),
                     "examples": " | ".join(members["text_raw"].drop_duplicates().head(5).astype(str).str.slice(0, 80))})
    clusters = pd.DataFrame(rows)

    known = (clusters["label_coverage"] >= cfg.known_coverage) & (clusters["label_purity"] >= cfg.known_purity)
    fit_bar = float(clusters.loc[known, "vocabulary_fit"].quantile(cfg.fit_quantile)) if known.any() else 0.0
    split_name = f"split candidate inside {tax.catch_all}"

    def verdict(r):
        if r.stability < cfg.min_stability:
            return "unstable"
        if r.label_coverage >= cfg.known_coverage and r.label_purity >= cfg.known_purity:
            return split_name if tax.catch_all and r.label_L2 == tax.catch_all else "known L2 confirmed"
        if r.label_coverage >= cfg.known_coverage:
            return "boundary between L2s"
        if r.label_coverage < cfg.uncovered_coverage and r.vocabulary_fit < fit_bar:
            return "new topic candidate"
        return "uncovered part of an existing L2"

    clusters["verdict"] = clusters.apply(verdict, axis=1)
    order = ["new topic candidate", split_name, "uncovered part of an existing L2", "boundary between L2s", "known L2 confirmed", "unstable"]
    clusters["_rank"] = clusters["verdict"].map(order.index)
    clusters = clusters.sort_values(["_rank", "rows"], ascending=[True, False]).drop(columns="_rank").reset_index(drop=True)
    verdicts = clusters.groupby("verdict").agg(clusters=("cluster", "size"), rows=("rows", "sum")).reindex(order).dropna().reset_index()
    verdicts = pd.concat([verdicts, pd.DataFrame([
        {"verdict": "not clustered", "clusters": 0, "rows": int(((row_cluster.to_numpy() < 0) & df["has_content"].to_numpy()).sum())},
        {"verdict": "no issue words", "clusters": 0, "rows": int((~df["has_content"]).sum())}])], ignore_index=True)
    verdicts["share_of_rows"] = verdicts["rows"] / len(df)
    log.info("rows by cluster verdict:\n%s", verdicts.round(4).to_string(index=False))
    log.info("cluster names: %s", ", ".join(clusters.drop_duplicates("name")["name"].head(30)))
    for r in clusters.head(40).itertuples():
        log.debug("cluster %4d %-28s %-34s rows %6d stab %.2f cov %.2f [%s]", r.cluster, r.name, r.verdict, r.rows, r.stability,
                  r.label_coverage, r.top_terms[:70])
    return {"work": work, "labels": labels, "space": space, "clusters": clusters, "verdicts": verdicts, "word_roles": word_roles,
            "row_cluster": row_cluster, "centroids": centroids, "W": W, "ids": ids}


def promote_new_l2(topics, df, feats, tax, cfg):
    """One rule for every candidate topic: if the L2 model places it in one known L2, it belongs there (and is
    checked for being a new L4 later); only a stable, nameable topic the model cannot place becomes a new L2,
    after look-alikes are merged and only if it is as learnable as the weaker known L2 (grouped CV F1)."""
    out = {"bars": {}, "gate": pd.DataFrame(), "mapping": pd.Series(dtype=object), "names": [],
           "sub_l4": pd.Series(dtype=object), "new_l4": pd.DataFrame(columns=["cluster", "name", "L2"])}
    clusters = topics["clusters"]
    if clusters.empty:
        return out
    W, ids, centroids, row_cluster = topics["W"], topics["ids"], topics["centroids"], topics["row_cluster"]
    bars = out["bars"]

    def similarity(selected):
        rows = [ids.index(c) for c in selected]
        lexical = W[tax.k:][rows] @ W[tax.k:][rows].T
        semantic = np.vstack([centroids[c] for c in selected])
        return np.maximum(lexical, semantic @ semantic.T)

    known = clusters[clusters["verdict"] == "known L2 confirmed"]
    stability_bar = float(known["stability"].quantile(cfg.reference_quantile)) if len(known) else cfg.min_stability
    merge_bar = 1.0
    if len(known) > 2:
        S = similarity(known["cluster"].tolist())
        topic_of = known["label_L4"].where(known["label_L4"] != "", [f"none{i}" for i in range(len(known))]).to_numpy()
        iu = np.triu_indices(len(S), 1)
        sims, same = S[iu], (topic_of[:, None] == topic_of[None, :])[iu]
        if same.any() and (~same).any():
            order = np.argsort(-sims)
            precision = np.cumsum(same[order]) / np.arange(1, len(sims) + 1)
            ok = np.flatnonzero(precision >= cfg.merge_probability)
            merge_bar = float(sims[order][ok.max()]) if len(ok) else 1.0
    bars["stability bar (lower quartile of known-L2 clusters)"] = stability_bar
    bars["merge bar (same-L4 vs different-L4 clusters)"] = merge_bar

    stable = clusters["stability"] >= stability_bar
    topic = clusters["verdict"].isin(["new topic candidate", f"split candidate inside {tax.catch_all}"]) & stable & clusters["name_is_phrase"]
    placed = topic & (clusters["model_L2_share"] >= cfg.known_purity)
    out["new_l4"] = clusters.loc[placed, ["cluster", "name", "model_L2"]].rename(columns={"model_L2": "L2"})
    if placed.any():
        log.info("topics the model places inside one known L2 (>= %.0f%% of their rows): %s", 100 * cfg.known_purity,
                 ", ".join(f"{r.name} -> {r.L2}" for r in out["new_l4"].itertuples()))
    seeds = clusters[topic & ~placed]
    if len(seeds) and placed.any():
        pl = clusters[placed]
        S = similarity(seeds["cluster"].tolist() + pl["cluster"].tolist())[:len(seeds), len(seeds):]
        follows = S.max(1) >= merge_bar
        if follows.any():
            partner = pl.iloc[S.argmax(1)[follows]]
            out["new_l4"] = pd.concat([out["new_l4"], pd.DataFrame({"cluster": seeds["cluster"].to_numpy()[follows],
                                                                    "name": partner["name"].to_numpy(), "L2": partner["model_L2"].to_numpy()})],
                                      ignore_index=True)
            log.info("seeds following a placed look-alike: %s", ", ".join(f"{a} -> {b}" for a, b in zip(seeds["name"].to_numpy()[follows], partner["name"])))
            seeds = seeds[~follows]
    log.info("new-L2 seeds (stable, nameable topics the model cannot place): %d", len(seeds))
    if seeds.empty:
        clusters["promoted_as"] = ""
        return out

    pool = clusters[stable & clusters["verdict"].isin(["boundary between L2s", "uncovered part of an existing L2", f"split candidate inside {tax.catch_all}"])
                    & ~clusters["cluster"].isin(seeds["cluster"]) & ~clusters["cluster"].isin(out["new_l4"]["cluster"])]
    candidates = seeds.copy()
    if len(pool):
        S = similarity(pool["cluster"].tolist() + seeds["cluster"].tolist())[:len(pool), len(pool):]
        joined = pool[S.max(1) >= merge_bar]
        if len(joined):
            log.info("clusters joining a new-L2 seed: %s", ", ".join(joined["name"]))
            candidates = pd.concat([seeds, joined]).copy()
    candidates["new_l2"] = candidates["name"]
    if len(candidates) > 1:
        D = np.clip(1 - similarity(candidates["cluster"].tolist()), 0, None)
        np.fill_diagonal(D, 0)
        groups = pd.Series(fcluster(linkage(squareform(D, checks=False), method="average"), t=1 - merge_bar, criterion="distance"),
                           index=candidates.index)
        is_seed = candidates["cluster"].isin(seeds["cluster"])
        lead = candidates[is_seed].groupby(groups[is_seed])["rows"].idxmax()
        candidates = candidates[groups.isin(lead.index)].copy()
        candidates["new_l2"] = groups[candidates.index].map(lambda g: candidates.loc[lead[g], "name"])
    clash = candidates["new_l2"].isin(set(tax.l2_names) | set(tax.l4_parent))
    candidates.loc[clash, "new_l2"] = candidates.loc[clash, "new_l2"] + "_TOPIC"
    log.info("after merging look-alikes (bar %.3f): %d candidate L2: %s", merge_bar, candidates["new_l2"].nunique(),
             ", ".join(sorted(candidates["new_l2"].unique())))

    cluster_to_l2 = candidates.set_index("cluster")["new_l2"]
    mapping = row_cluster[row_cluster.isin(cluster_to_l2.index)].map(cluster_to_l2)
    sub_name = row_cluster[row_cluster.isin(cluster_to_l2.index)].map(candidates.set_index("cluster")["name"])

    def learnability(mapping):
        expanded = df.assign(target=df["row_id"].map(mapping).fillna(df["label_l2"]))
        expanded = distinct_rows(expanded[expanded["target"] != ""], "target")
        y, X = expanded["target"].to_numpy(), feats.sparse(expanded)
        predicted = np.empty(len(expanded), dtype=object)
        for tr, te in GroupKFold(n_splits=min(cfg.folds, expanded["group"].nunique())).split(expanded, y, groups=expanded["group"]):
            model = NBSVM(cfg.nbsvm_c, cfg.nb_alpha).fit(X[tr], y[tr])
            predicted[te] = model.classes_[model.decision(X[te]).argmax(1)]
        names = np.unique(y)
        p, r, f, s = precision_recall_fscore_support(y, predicted.astype(str), labels=names, zero_division=0)
        gate = pd.DataFrame({"L2": names, "new": ~np.isin(names, tax.l2_names), "distinct_texts": s, "precision": p, "recall": r, "F1": f})
        confused = pd.crosstab(pd.Series(y, name="true"), pd.Series(predicted.astype(str), name="predicted"))
        return gate, confused.add(confused.T, fill_value=0).fillna(0)

    # two candidates a model keeps confusing with each other are one topic: merge them and test again
    while True:
        gate, confused = learnability(mapping)
        quality_bar = float(gate.loc[~gate["new"], "F1"].quantile(cfg.reference_quantile))
        merged = False
        for name in gate.loc[gate["new"] & (gate["F1"] < quality_bar)].sort_values("distinct_texts")["L2"]:
            row = confused.loc[name].drop(name, errors="ignore")
            log.debug("%s is confused with: %s", name, row.nlargest(3).to_dict())
            row = row[row.index.isin(set(mapping))]
            if len(row) and row.max() > 0:
                partner = row.idxmax()
                keep, drop = sorted([name, partner], key=lambda n: -(mapping == n).sum())
                log.info("merging new-L2 candidate %s into %s (cross-validation confuses them)", drop, keep)
                mapping = mapping.replace(drop, keep)
                merged = True
                break
        if not merged:
            break
    gate["kept"] = ~gate["new"] | (gate["F1"] >= quality_bar)
    bars["quality bar (lower quartile of cross-validated F1 among known L2)"] = quality_bar
    log.info("learnability gate (bar %.3f):\n%s", quality_bar, gate[gate["new"]].round(3).to_string(index=False))

    kept = set(gate.loc[gate["new"] & gate["kept"], "L2"])
    out.update(gate=gate, mapping=mapping[mapping.isin(kept)], names=sorted(kept), sub_l4=sub_name[mapping.isin(kept)])
    clusters["promoted_as"] = clusters["cluster"].map(cluster_to_l2).where(lambda s: s.isin(kept), "").fillna("")
    return out


