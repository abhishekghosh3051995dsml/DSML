        "(?:transfer|mov|keep|bring)\\w* (?:\\w+ ){0,3}numbers?\\b",
        "numbers? (?:\\w+ )?(?:transferred|moved|ported)",
        "from (?:another|other|a different|the old|his old|her old|their old) carrier"
