      "match": [
        "port ?-? ?out",
        "(?:release|transfer|port ?out|number transfer) pin",
        "(?:to|switch\\w* to|leaving for|moving to) (?:another|a different|other|new) carrier",
        "(?:transferr?ed|ported|moved|switch\\w*) (?:\\w+ ){0,3}(?:line|number) to (?:att|verizon|sprint|another carrier|a different carrier)\\b",
