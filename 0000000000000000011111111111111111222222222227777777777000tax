    "WARRANTY_EXCHANGE": {
      "description": "Warranty exchange and defective device replacement",
      "tier": 1,
      "match": [
        "warranty",
        "(?:replacement|exchange) (?:phone|device)",
        "(?:phone|device) (?:replacement|exchange|swap)",
        "replac\\w* (?:the |his |her |their |a )?(?:phone|device|iphone|tablet)",
        "defective",
        "(?:warranty|device|phone|handset) exchange",
        "exchange (?:the |a |his |her |their |this )?(?:phone|device|iphone|handset)"
      ],
      "exclude": []
