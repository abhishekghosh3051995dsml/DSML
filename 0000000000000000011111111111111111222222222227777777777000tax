        "(?:insurance|damage|file\\w*|open\\w*|start\\w*|make|making|submit\\w*|process\\w*) (?:a |an |the |his |her |their )?claims?",
        "claims? (?:number|status|for|on)\\b"
      ],
      "exclude": []
    },
    "CARRIER_MIGRATION": {
      "description": "Customer moving over from another carrier, when no more specific need is stated",
      "tier": 4,
      "match": [
        "previous carrier",
        "\\bmigrat\\w*"
      ],
      "exclude": []
    }
