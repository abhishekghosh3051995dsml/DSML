      "exclude": [
        "\\be ?-? ?sim",
        "\\bp ?sim\\b"
      ]
    },
    "TICKET_STATUS_FOLLOWUP": {
      "description": "Status, update or follow-up on an existing ticket or case",
      "tier": 4,
      "match": [
        "\\btickets?\\b",
        "\\bcases?\\b",
        "follow ?-? ?up",
        "\\betr\\b",
        "support case"
