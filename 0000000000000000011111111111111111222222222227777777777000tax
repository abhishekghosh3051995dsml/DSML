      "exclude": [
        "port forward\\w*",
        "(?:lan|ethernet|charging|usb) port",
        "port (?:on|of) (?:the )?(?:router|gateway)",
        "\\bdocked\\b"
      ]
    },
    "MOBILE_DATA_NO_CONNECTIVITY": {
      "description": "Mobile data not working or not connecting, APN",
      "tier": 1,
      "match": [
        "\\bno (?:mobile |cellular |cell |lte )?data\\b",
        "(?:mobile|cellular|lte|cell) data",
        "data (?:is |isn ?t |not |stopped |wont |won t )(?:not )?(?:working|connecting|loading)",
        "data (?:connectivity|connection)",
        "\\bapn\\b",
        "\\bdata (?:issues?|problems?)\\b"
      ],
      "exclude": [
        "data pass",
        "<NET>",
        "<GW>",
        "slow|speed|throttl",
        "hot ?spot"
      ]
    },
    "MOBILE_DATA_SLOW_SPEED": {
      "description": "Slow or throttled mobile data",
      "tier": 1,
      "match": [
        "slow (?:mobile |cellular )?data",
        "data (?:speeds?|is slow)",
        "\\bthrottl\\w*",
        "data .{0,15}slow"
      ],
      "exclude": [
        "data pass",
        "<NET>",
        "<GW>",
        "hot ?spot"
      ]
    },
    "INTERNATIONAL_CALLING_ISSUE": {
      "description": "Problems calling international numbers or from abroad",
