TS_RE = re.compile(r'"_ts"\s*:\s*(\d+)')
PREFIX_RE = re.compile(r"^([a-z]{2,12})-(.+)$")
SEP_RE = re.compile(r"[\s()+\-]")
FLOAT_RE = re.compile(r"^-?\d+\.\d+$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}")
LEVEL_RE = re.compile(r"(?i)(?:^|[^a-z0-9])l([1-9])(?:$|[^0-9])")


def as_obj(raw):
    if isinstance(raw, (dict, list)):
        return raw
    if not isinstance(raw, str):
        return None
    raw = raw.strip()
    if raw[:1] not in "{[":
        return None
    try:
        return json.loads(raw)
    except ValueError:
        try:
            return ast.literal_eval(raw)
        except (ValueError, SyntaxError, MemoryError, RecursionError):
            return None


def leaves(obj, prefix="", nested=0):
    if isinstance(obj, str) and nested < 4 and obj.lstrip()[:1] in ("{", "["):
        parsed = as_obj(obj)
        if isinstance(parsed, (dict, list)):
            yield from leaves(parsed, prefix, nested + 1)
            return
    if isinstance(obj, dict):
        for k, v in obj.items():
            yield from leaves(v, f"{prefix}.{k}" if prefix else str(k), nested)
    elif isinstance(obj, list):
        for v in obj:
            yield from leaves(v, f"{prefix}[]", nested)
    else:
        yield prefix, obj


def norm(v):
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, float):
        return f"{int(v * 1000) / 1000:.3f}"
    s = str(v).strip()
    if not s:
        return None
    if len(s) < 25 and FLOAT_RE.match(s):
        return f"{int(float(s) * 1000) / 1000:.3f}"
    d = SEP_RE.sub("", s)
    if d.isdigit() and len(d) >= 10:
        return d[-10:]
    return s


def mask(v):
    s = str(v).strip()
    if args.no_mask:
        return s[:200]
    if DATE_RE.match(s):
        return s[:19]
    if len(s) < 25 and FLOAT_RE.match(s) and abs(float(s)) <= 180:
        return f"{float(s):.1f}"
    if sum(ch.isdigit() for ch in s) >= 7:
        s = re.sub(r"\d(?=(?:\D*\d){2})", "X", s)
    return s if len(s) <= 60 else s[:57] + "..."


def split_name(f):
    m = PREFIX_RE.match(f)
    return (m.group(2), m.group(1)) if m else (f, "")


def depth(path):
    return path.count(".") + path.count("[]")


@lru_cache(maxsize=None)
def shape(nv):
    if nv.isdigit():
        return f"d{len(nv)}"
    if FLOAT_RE.match(nv):
        return "f"
    return None


@lru_cache(maxsize=None)
def name_tokens(path):
    last = path.replace("[]", "").split(".")[-1]
    last = re.sub(r"([a-z])([A-Z])", r"\1 \2", last).lower()
    return frozenset(t[:-1] if len(t) > 3 and t.endswith("s") else t
                     for t in re.split(r"[^a-z0-9]+", last) if t)


def names_match(a, b):
    return any(len(x) >= 3 and len(y) >= 3 and (x.startswith(y) or y.startswith(x)) for x in a for y in b)


def in_text(nv, text):
    return re.search(rf"(?<!\w){re.escape(nv.casefold())}(?!\w)", text) is not None


def conv_half(name):
    return zlib.crc32(name.encode()) & 1


