HEAD_FILL = PatternFill("solid", fgColor="1F3864")
BAND_FILL = PatternFill("solid", fgColor="EAF0F8")
HEAD_FONT = Font(bold=True, color="FFFFFF", name="Calibri", size=11)
BODY_FONT = Font(name="Calibri", size=10)
REPEAT_FONT = Font(name="Calibri", size=10, color="A6A6A6")
THIN = Side(style="thin", color="BFBFBF")
GROUP = Side(style="medium", color="1F3864")
WRAP_COLS = {"Source field", "Other sources", "Parameters", "Parameters needed", "Function names",
             "Output field", "Example value", "Error", "Value"}


def write_sheet(w, name, df, group_cols=(), repeat_cols=()):
    df = df.reset_index(drop=True)
    repeat_cols = set(group_cols) | set(repeat_cols)
    df.to_excel(w, sheet_name=name, index=False)
    ws = w.sheets[name]
    n_rows, n_cols = len(df) + 1, len(df.columns)
    ws.freeze_panes = ws.cell(row=2, column=len(group_cols) + 1)
    ws.auto_filter.ref = f"A1:{get_column_letter(n_cols)}{n_rows}"
    ws.row_dimensions[1].height = 32
    for cell in ws[1]:
        cell.fill, cell.font = HEAD_FILL, HEAD_FONT
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        cell.border = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)
    keys = [tuple(r) for r in df[list(group_cols)].itertuples(index=False)] if group_cols else [None] * len(df)
    band, prev = False, object()
    for i, key in enumerate(keys, start=2):
        new_group = key != prev
        if new_group:
            band = not band
        for j, col in enumerate(df.columns, start=1):
            cell = ws.cell(row=i, column=j)
            cell.font = BODY_FONT
            if band and group_cols:
                cell.fill = BAND_FILL
            cell.border = Border(left=THIN, right=THIN, bottom=THIN,
                                 top=GROUP if (new_group and group_cols and i > 2) else THIN)
            cell.alignment = Alignment(vertical="top", wrap_text=col in WRAP_COLS)
            if isinstance(cell.value, (int, float)) and not isinstance(cell.value, bool):
                cell.number_format = "#,##0" if float(cell.value).is_integer() else "0.0000"
                cell.alignment = Alignment(horizontal="right", vertical="top")
            if col in repeat_cols and not new_group:
                cell.font = REPEAT_FONT
        prev = key
    for j, col in enumerate(df.columns, start=1):
        width = max([min(len(str(col)), 18)] + [len(str(v)) for v in df[col].head(300)]) + 2
        ws.column_dimensions[get_column_letter(j)].width = min(max(width, 10), 55 if col in WRAP_COLS else 40)


def save(path, sheets):
    with pd.ExcelWriter(path, engine="openpyxl") as w:
        for name, df, groups, repeats in sheets:
            if len(df):
                write_sheet(w, name, df, groups, repeats)
    print("saved", path)


