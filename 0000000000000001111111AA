def fn_calls(fk):
    return max(fcalls[fk].values(), default=0)


def p_calls(rk):
    return max(pmerge[rk]["agent"], pmerge[rk]["system"])


@lru_cache(maxsize=None)
def is_fixed(rk):
    n = len(pvals_m[rk])
    return 0 < n <= args.max_listed and p_calls(rk) >= args.fixed_ratio * n


src_count = defaultdict(Counter)
src_half = defaultdict(Counter)
src_detail = defaultdict(lambda: defaultdict(Counter))
dep_convs = Counter()
for cid, cons in consumers.items():
    org = value_origin[cid]
    h = conv_half(conv_names[cid])
    done, deps = set(), set()
    for nv, agent, base, param in cons:
        rk = (res(agent, base), base, param)
        if (nv, rk) in done:
            continue
        done.add((nv, rk))
        source, detail = org.get(nv, ("none", ""))
        if source in ("fixed", "none"):
            source = "fixed" if is_fixed(rk) else "none"
        src_count[rk][source] += 1
        src_half[(rk, h)][source] += 1
        if source == "api":
            ua, ub, field = detail
            src_detail[rk][source][f"{ub} -> {field}"] += 1
            deps.add((ua, ub, field, rk[0], base, param))
        elif detail:
            src_detail[rk][source][detail] += 1
    for k in deps:
        dep_convs[k] += 1
