else:
    wb = load_workbook(base_path, read_only=True)
    sheet = max(wb.worksheets, key=lambda ws: (ws.max_row or 0) * (ws.max_column or 0)).title
    wb.close()
    head = pd.read_excel(base_path, sheet_name=sheet, header=None, nrows=15)
    filled = head.notna().sum(axis=1)
    hrow = int(filled[filled >= 0.6 * filled.max()].index[0]) if filled.max() else 0
    bcols = [str(c).strip() for c in pd.read_excel(base_path, sheet_name=sheet, header=hrow, nrows=0).columns]
    if args.level_cols:
        levels = [c.strip() for c in args.level_cols.split(",")]
    else:
        found = [(int(m.group(1)), c) for c in bcols if (m := LEVEL_RE.search(c))]
        levels = [c for _, c in sorted(found)]
    need = [c for c in levels + [ROLE["agent_col"], ROLE["func_col"], ROLE["conv_col"]] if c in bcols]
    b = pd.read_excel(base_path, sheet_name=sheet, header=hrow, dtype=str)
    b.columns = [str(c).strip() for c in b.columns]
    b = b[need].fillna("")
    print(f"baseline {base_path.name} [{sheet}] {len(b):,} rows, levels: {levels}")

    fn_agents = defaultdict(set)
    for a, f in fcalls:
        fn_agents[f].add(a)
    usual = {fk: ", ".join(usual_params(fk)) for fk in fcalls}
    cnt = Counter()
    unmatched = Counter()
    for row in b.itertuples(index=False):
        r = dict(zip(need, row))
        fns = {split_name(f)[0] for f in split_cell(r.get(ROLE["func_col"], ""))}
        if not fns:
            continue
        lv = tuple(r.get(c, "") or "(blank)" for c in levels)
        row_agents = set(split_cell(r.get(ROLE["agent_col"], "")))
        for f in fns:
            ags = fn_agents.get(f)
            if not ags:
                unmatched[f] += 1
                cnt[lv + ("(not in interactions)", f)] += 1
                continue
            for a in sorted(ags & row_agents) or [max(ags, key=lambda x: fn_calls((x, f)))]:
                cnt[lv + (a, f)] += 1

    rows = [dict(zip(levels + ["Agent", "Function"], k), Parameters=usual.get(k[-2:], ""), Messages=n)
            for k, n in cnt.items()]
    intent = pd.DataFrame(rows).fillna("")
    if len(intent):
        sort_cols = []
        for i, c in enumerate(levels):
            tot = intent.groupby(levels[:i + 1])["Messages"].transform("sum")
            intent[f"_t{i}"] = -tot
            sort_cols += [f"_t{i}", c]
        intent = (intent.sort_values(sort_cols + ["Agent", "Messages"], ascending=[True] * (len(sort_cols) + 1) + [False])
                  .drop(columns=[c for c in intent.columns if c.startswith("_t")]).reset_index(drop=True))

    bconv = {t for v in b.get(ROLE["conv_col"], pd.Series(dtype=str)) for t in split_cell(v)}
    bfns = {split_name(f)[0] for v in b[ROLE["func_col"]] for f in split_cell(v)}
    coverage = [("Baseline rows", len(b)),
                ("Baseline rows with functions", int((b[ROLE["func_col"]] != "").sum())),
                ("Baseline conversations", len(bconv)),
                ("Baseline conversations in interactions file", len(bconv & conv_index.keys())),
                ("Baseline functions", len(bfns)),
                ("Baseline functions found in interactions file", len(bfns & set(fn_agents))),
                ("Baseline functions with parameters", sum(1 for f in bfns if any(params_of.get((a, f)) for a in fn_agents.get(f, ())))),
                ("Baseline functions not in interactions file", ", ".join(sorted(bfns - set(fn_agents))))]
    for k, v in coverage:
        print(f"  {k}: {v}")

