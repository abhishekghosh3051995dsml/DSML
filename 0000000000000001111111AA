stab = []
for fk in fcalls:
    if not any(fcalls_half[fk][(log, 0)] and fcalls_half[fk][(log, 1)] for log in ("agent", "system")):
        continue
    halves = []
    for h in (0, 1):
        rks = params_of.get(fk, [])
        halves.append(({rk[2] for rk in rks if share(rk, h) >= args.usual_share},
                       {rk[2] for rk in rks if share(rk, h) >= 0.99}))
    jac = lambda x, y: 1.0 if not x and not y else len(x & y) / len(x | y)
    stab.append({"Agent": fk[0], "Function": fk[1],
                 "Calls half A": max(fcalls_half[fk][(l, 0)] for l in ("agent", "system")),
                 "Calls half B": max(fcalls_half[fk][(l, 1)] for l in ("agent", "system")),
                 "Usual parameters Jaccard": round(jac(halves[0][0], halves[1][0]), 4),
                 "Always-present parameters Jaccard": round(jac(halves[0][1], halves[1][1]), 4)})
stab = pd.DataFrame(stab)

src_stab = []
for rk in src_count:
