           ("Mean always-present-parameter Jaccard", round(stab["Always-present parameters Jaccard"].mean(), 4) if len(stab) else ""),
           ("Parameters in source-stability test", len(src_stab)),
           ("Main source same in both halves", int(src_stab["Same"].sum()) if len(src_stab) else "")] + \
          [(f"Values: {SRC[s]}", overall[s]) for s in SRC] + [("Values traced to a source", total_vals - overall["none"]),
                                                             ("Values checked", total_vals)]
summary = pd.DataFrame(summary, columns=["Measure", "Value"])
skipped = pd.DataFrame([{"Error": e, "Function": f, "Rows": n} for (e, f), n in errors.most_common()])
