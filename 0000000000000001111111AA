def locate(name):
    p = Path(name)
    if p.is_file():
        return p
    home = Path.home()
    for root in [Path.cwd(), Path(r"C:\Datascience")] + sorted(home.glob("OneDrive*")):
        if not root.is_dir():
            continue
        hits = [h for h in root.rglob(p.name) if not h.name.startswith("~$")]
        if hits:
            return max(hits, key=lambda h: h.stat().st_mtime)
    return None


