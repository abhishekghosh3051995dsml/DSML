        src_stab.append({"Agent": rk[0], "Function": rk[1], "Parameter": rk[2],
                         "Values half A": sum(a.values()), "Values half B": sum(b_.values()),
                         "Main source half A": SRC[ma], "Main source half B": SRC[mb], "Same": ma == mb})
src_stab = pd.DataFrame(src_stab)

dist = pd.DataFrame([{"Agent": rk[0], "Function": rk[1], "Parameter": rk[2],
