for cid, pending in unresolved.items():
    org = value_origin[cid]
    prod = producers.get(cid, {})
    rec = records.get(cid, {})
    ff = form_fields.get(cid, {})
    uses = defaultdict(list)
    for (nv, agent, base, param), ts in consumers[cid].items():
        if nv in pending:
            uses[nv].append((ts, base, param))
    for nv, u in uses.items():
        first_ts = min(x[0] for x in u)
        used_at = {}
        for ts, base, _ in u:
            if base not in used_at or ts < used_at[base]:
                used_at[base] = ts
        ptoks = frozenset().union(*(name_tokens(p) for _, _, p in u))
        best = None
        for (pa, pb, pp), pts in prod.get(nv, {}).items():
            if pts > first_ts:
                continue
            ub = used_at.get(pb)
            if ub is not None and ub <= pts:
                continue
            is_text = pp == "(text)"
            if is_text and pb.lower().endswith(args.agent_call_suffix):
                continue
            named = bool(ptoks & name_tokens(pp))
            if nv.isdigit() and len(nv) <= 6 and not named:
                continue
            score = (named, not is_text, -pts)
            if best is None or score > best[0]:
                best = (score, (res(pa, pb), pb, pp))
        if best:
            org[nv] = ("api", best[1])
        elif nv in rec:
            org[nv] = ("record", rec[nv])
        elif (sh := shape(nv)) and (hit := next((p for p, (toks, fsh) in ff.items()
                                                 if fsh == sh and names_match(ptoks, toks)), None)):
            org[nv] = ("form name", hit)
        elif " " in nv and len(nv) > 20:
            org[nv] = ("agent", "")
        else:
            org[nv] = ("none", "")
