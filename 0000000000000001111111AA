def share(rk, h=None):
    fk = rk[:2]
    best = 0.0
    for log in ("agent", "system"):
        n = fcalls[fk][log] if h is None else fcalls_half[fk][(log, h)]
        w = pmerge[rk][log] if h is None else pmerge[rk][(log, h)]
        if n:
            best = max(best, w / n)
    return best


def example(rk):
    vals = pvals_m[rk]
    if 0 < len(vals) <= args.max_listed and all(len(v) <= 20 and sum(c.isdigit() for c in v) < 7 for v in vals):
        return " | ".join(sorted(vals, key=lambda v: (len(v), v)))
    return mask(pex_m[rk]) if rk in pex_m else ""


