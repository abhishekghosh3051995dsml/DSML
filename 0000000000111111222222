# %%
import argparse
import re
from collections import defaultdict
from pathlib import Path

import numpy as np
import pandas as pd
from scipy.sparse import hstack
from sklearn.decomposition import TruncatedSVD
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import GroupKFold

parser = argparse.ArgumentParser()
parser.add_argument("--stage1", default=r"C:\Datascience\nora_l2l4\stage1_profile")
parser.add_argument("--stage2", default=r"C:\Datascience\nora_l2l4\stage2_taxonomy")
parser.add_argument("--outdir", default=r"C:\Datascience\nora_l2l4\stage3_weak_labels")
parser.add_argument("--target-precision", type=float, default=0.95)
parser.add_argument("--name-coverage", type=float, default=0.75)
parser.add_argument("--lsa-dims", type=int, default=200)
parser.add_argument("--sample", type=int, default=200)
parser.add_argument("--seed", type=int, default=0)
args, _ = parser.parse_known_args()

stage1, stage2, outdir = Path(args.stage1), Path(args.stage2), Path(args.outdir)
outdir.mkdir(parents=True, exist_ok=True)
ABSTAIN = -1

# %%
df = pd.read_csv(stage1 / "stage1_clean.csv", keep_default_na=False)
roles = pd.read_csv(stage1 / "column_roles.csv").set_index("role")["column"]
text_col, l1_col = roles["text"], roles["l1"]
df["is_template"] = df["is_template"].astype(str).str.lower().eq("true")
df["text_clean"] = df["text_clean"].astype(str)

taxonomy = pd.read_csv(stage2 / "taxonomy.csv", keep_default_na=False)
template_labels = pd.read_csv(stage2 / "stage2_template_labels.csv", keep_default_na=False)
template_topics = pd.read_csv(stage2 / "template_topics.csv", keep_default_na=False)

l4_list = taxonomy["Intent-L4"].tolist()
l4_index = {n: i for i, n in enumerate(l4_list)}
l4_parent = dict(zip(taxonomy["Intent-L4"], taxonomy["Intent-L2"]))
K = len(l4_list)

real = df[~df["is_template"]].reset_index(drop=True)
tmpl = df[df["is_template"]].merge(template_labels[["row_id", "Intent-L4", "frame"]], on="row_id").reset_index(drop=True)
tmpl_y = tmpl["Intent-L4"].map(l4_index).to_numpy()
print(f"real notes: {len(real):,}  labelled template rows: {len(tmpl):,}  L4 classes: {K}  L2: {taxonomy['Intent-L2'].nunique()}")

# %%
def split_l1(v):
    return {x for x in str(v).split("|") if x}


matrix_l1 = [split_l1(v) for v in taxonomy["matrix_l1"]]
observed_l1 = [split_l1(v) for v in taxonomy["observed_l1"]]
tmpl_in_matrix = np.array([l1 in matrix_l1[k] for l1, k in zip(tmpl[l1_col], tmpl_y)])
gap_rate = 1 - tmpl_in_matrix.mean()
print(f"template rows outside the routing matrix: {gap_rate:.1%} -> used as the matrix's error rate in the L1 prior")

l1_values = sorted(df[l1_col].unique())
prior_by_l1 = {}
for l1 in l1_values:
    allowed = np.array([(l1 in m) or (l1 in o) or (not m and not o) for m, o in zip(matrix_l1, observed_l1)])
    n_in, n_out = allowed.sum(), (~allowed).sum()
    w = np.where(allowed, (1 - gap_rate) / max(n_in, 1), gap_rate / max(n_out, 1))
    prior_by_l1[l1] = w / w.sum()
    print(f"  {l1:<22} L4 preferred by matrix/data: {n_in:>3}  others: {n_out:>3}")

# %%
def stem(word):
    return word[:5] if len(word) > 5 else word


def stem_set(text):
    return {stem(w) for w in re.findall(r"[a-z]+", text.lower())}


name_stems = [frozenset(stem(w) for w in n.lower().split("_") if w != "ticket") for n in l4_list]
ticket_only = [m == {"TICKET"} for m in matrix_l1]
seen = {}
for k in sorted(range(K), key=lambda k: ticket_only[k]):
    if name_stems[k] in seen:
        name_stems[k] = frozenset()
    else:
        seen[name_stems[k]] = k

name_df = defaultdict(int)
for s in name_stems:
    for w in s:
        name_df[w] += 1
name_idf = {w: np.log((1 + K) / (1 + c)) + 1 for w, c in name_df.items()}
name_weight = [sum(name_idf[w] for w in s) for s in name_stems]


def name_vote(text, allow_ticket_only):
    st = stem_set(text)
    best, best_key = ABSTAIN, (0.0, 0)
    for k, ns in enumerate(name_stems):
        if not ns or (ticket_only[k] and not allow_ticket_only):
            continue
        hit = ns & st
        if not hit:
            continue
        cov = sum(name_idf[w] for w in hit) / name_weight[k]
        key = (round(cov, 6), len(ns))
        if cov >= args.name_coverage and key > best_key:
            best, best_key = k, key
    return best


# %%
all_text = pd.concat([real["text_clean"], tmpl["text_clean"]])
word_vec = TfidfVectorizer(ngram_range=(1, 2), min_df=2, sublinear_tf=True, max_features=100_000).fit(all_text)
char_vec = TfidfVectorizer(analyzer="char_wb", ngram_range=(2, 5), min_df=3, sublinear_tf=True, max_features=150_000).fit(all_text)


def features(texts):
    return hstack([word_vec.transform(texts), char_vec.transform(texts)]).tocsr()


X_tmpl, X_real = features(tmpl["text_clean"]), features(real["text_clean"])


def precision_threshold(conf, correct, target):
    order = np.argsort(-conf)
    running = np.cumsum(correct[order]) / np.arange(1, len(order) + 1)
    ok = np.where(running >= target)[0]
    return float(conf[order][ok.max()]) if len(ok) else 1.0


oof = np.zeros((len(tmpl), K))
for fold, (tr, te) in enumerate(GroupKFold(n_splits=5).split(X_tmpl, tmpl_y, groups=tmpl["frame"])):
    clf = LogisticRegression(max_iter=2000, C=4.0).fit(X_tmpl[tr], tmpl_y[tr])
    oof[np.ix_(te, clf.classes_)] = clf.predict_proba(X_tmpl[te])
    acc = (clf.classes_[clf.predict_proba(X_tmpl[te]).argmax(1)] == tmpl_y[te]).mean()
    print(f"template classifier fold {fold + 1}: held-out frames {sorted(tmpl.loc[te, 'frame'].unique())[:2]}...  accuracy {acc:.3f}")

oof_pred, oof_conf = oof.argmax(1), oof.max(1)
thr_clf = precision_threshold(oof_conf, oof_pred == tmpl_y, args.target_precision)
print(f"unseen-frame accuracy {np.mean(oof_pred == tmpl_y):.3f}; vote threshold for {args.target_precision:.0%} precision: {thr_clf:.3f}")

clf = LogisticRegression(max_iter=2000, C=4.0).fit(X_tmpl, tmpl_y)
proba_real = np.zeros((len(real), K))
proba_real[:, clf.classes_] = clf.predict_proba(X_real)
vote_clf_real = np.where(proba_real.max(1) >= thr_clf, proba_real.argmax(1), ABSTAIN)

# %%
lsa_vec = TfidfVectorizer(min_df=2, sublinear_tf=True, token_pattern=r"[a-z]{2,}").fit(all_text)
svd = TruncatedSVD(n_components=min(args.lsa_dims, len(lsa_vec.vocabulary_) - 1), random_state=args.seed).fit(lsa_vec.transform(all_text))
print(f"semantic space: {svd.n_components} dims, {svd.explained_variance_ratio_.sum():.1%} variance kept")


def embed(texts):
    z = svd.transform(lsa_vec.transform(texts))
    return z / np.maximum(np.linalg.norm(z, axis=1, keepdims=True), 1e-12)


topics_of = template_topics.groupby("Intent-L4")["topic"].apply(" ".join)
l4_docs = [n.replace("_", " ").lower().replace("ticket", "") + " " + topics_of.get(n, "") for n in l4_list]
l4_emb = embed(l4_docs)

sim_tmpl = embed(tmpl["text_clean"]) @ l4_emb.T
thr_sem = precision_threshold(sim_tmpl.max(1), sim_tmpl.argmax(1) == tmpl_y, args.target_precision)
sim_real = embed(real["text_clean"]) @ l4_emb.T
real_is_ticket = real[l1_col].eq("TICKET").to_numpy()
sim_real[np.ix_(~real_is_ticket, np.flatnonzero(ticket_only))] = -1.0
vote_sem_real = np.where(sim_real.max(1) >= thr_sem, sim_real.argmax(1), ABSTAIN)
print(f"semantic vote threshold for {args.target_precision:.0%} precision on templates: cosine {thr_sem:.3f}")

vote_name_real = np.array([name_vote(t, tk) for t, tk in zip(real["text_clean"], real_is_ticket)])
vote_name_tmpl = np.array([name_vote(t, l1 == "TICKET") for t, l1 in zip(tmpl["text_clean"], tmpl[l1_col])])

# %%
lf_names = ["template_classifier", "name_match", "semantic_similarity"]
L = np.column_stack([vote_clf_real, vote_name_real, vote_sem_real])
voted = L != ABSTAIN
n_votes = voted.sum(1)

tmpl_precision = {
    "template_classifier": np.mean(oof_pred[oof_conf >= thr_clf] == tmpl_y[oof_conf >= thr_clf]),
    "name_match": np.mean(vote_name_tmpl[vote_name_tmpl >= 0] == tmpl_y[vote_name_tmpl >= 0]) if (vote_name_tmpl >= 0).any() else np.nan,
    "semantic_similarity": np.mean(sim_tmpl.argmax(1)[sim_tmpl.max(1) >= thr_sem] == tmpl_y[sim_tmpl.max(1) >= thr_sem]),
}


def lf_stats(j):
    others = np.delete(L, j, axis=1)
    other_voted = (others != ABSTAIN).any(1)
    disagree = ((others != ABSTAIN) & (others != L[:, [j]])).any(1)
    return {
        "coverage": voted[:, j].mean(),
        "overlap": (voted[:, j] & other_voted).mean(),
        "conflict": (voted[:, j] & disagree).mean(),
        "classes_voted": len(np.unique(L[voted[:, j], j])),
    }


# %%
def dawid_skene(L, prior, iters=200, tol=1e-6):
    n, m = L.shape
    acc = np.full(m, 0.7)
    for _ in range(iters):
        logq = np.log(prior)
        for j in range(m):
            v = L[:, j]
            on = v != ABSTAIN
            wrong = np.log((1 - acc[j]) / (K - 1))
            logq[on] += wrong
            logq[on, v[on]] += np.log(acc[j]) - wrong
        logq -= logq.max(1, keepdims=True)
        q = np.exp(logq)
        q /= q.sum(1, keepdims=True)
        new = np.array([q[L[:, j] != ABSTAIN, L[L[:, j] != ABSTAIN, j]].mean() if (L[:, j] != ABSTAIN).any() else 0.5 for j in range(m)])
        new = np.clip(new, 1e-3, 1 - 1e-3)
        if np.max(np.abs(new - acc)) < tol:
            acc = new
            break
        acc = new
    return q, acc


covered = n_votes > 0
prior = np.vstack([prior_by_l1[l1] for l1 in real.loc[covered, l1_col]])
q, ds_acc = dawid_skene(L[covered], prior)

summary = pd.DataFrame([{"label_source": n, **lf_stats(j), "precision_on_templates": tmpl_precision[n], "dawid_skene_accuracy": ds_acc[j]}
                        for j, n in enumerate(lf_names)])
print(summary.round(3).to_string(index=False))
summary.to_csv(outdir / "label_source_summary.csv", index=False)

# %%
ticket_l4 = [k for k in range(K) if ticket_only[k]]
ticket_core = {k: {stem(w) for w in l4_list[k].lower().split("_") if w != "ticket"} for k in ticket_l4}
ticket_map = {}
for b in range(K):
    if ticket_only[b]:
        continue
    b_stems = {stem(w) for w in l4_list[b].lower().split("_")}
    best, best_cov = None, 0.0
    for t in ticket_l4:
        if l4_parent[l4_list[t]] != l4_parent[l4_list[b]] or not ticket_core[t]:
            continue
        cov = sum(name_idf.get(w, 1) for w in ticket_core[t] & b_stems) / sum(name_idf.get(w, 1) for w in ticket_core[t])
        if cov > best_cov:
            best, best_cov = t, cov
    if best is not None and best_cov >= 0.5:
        ticket_map[b] = (best, best_cov)
ticket_table = pd.DataFrame([(l4_parent[l4_list[b]], l4_list[b], l4_list[t], round(c, 3)) for b, (t, c) in ticket_map.items()],
                            columns=["Intent-L2", "Intent-L4", "Intent-L4_under_TICKET", "name_coverage"]).sort_values(["Intent-L2", "Intent-L4"])
print(f"\nTICKET naming rule (base L4 -> its ticket form in the matrix): {len(ticket_table)} pairs")
print(ticket_table.to_string(index=False))
ticket_table.to_csv(outdir / "ticket_name_map.csv", index=False)

# %%
pred = np.full(len(real), ABSTAIN)
conf = np.zeros(len(real))
pred[covered], conf[covered] = q.argmax(1), q.max(1)
renamed = np.array([real_is_ticket[i] and pred[i] in ticket_map for i in range(len(real))])
pred[renamed] = [ticket_map[p][0] for p in pred[renamed]]

name_or_blank = lambda arr: [l4_list[v] if v != ABSTAIN else "" for v in arr]
out = pd.DataFrame({
    "row_id": real["row_id"],
    text_col: real[text_col],
    l1_col: real[l1_col],
    "Intent-L2": [l4_parent[l4_list[p]] if p != ABSTAIN else "" for p in pred],
    "Intent-L4": name_or_blank(pred),
    "label_model_confidence": conf.round(4),
    "n_votes": n_votes,
    "sources_agree": [len({v for v in row if v != ABSTAIN}) == 1 for row in L],
    "ticket_renamed": renamed,
    **{f"vote_{n}": name_or_blank(L[:, j]) for j, n in enumerate(lf_names)},
})
out.to_csv(outdir / "stage3_weak_labels.csv", index=False)

# %%
lab = out[out["Intent-L4"] != ""]
print(f"\nreal notes with a weak label: {len(lab):,} of {len(out):,} ({len(lab) / len(out):.1%})")
print(f"votes per note: {pd.Series(n_votes).value_counts().sort_index().to_dict()}")
print(f"all voting sources agree: {lab['sources_agree'].mean():.1%} of labelled notes")
print(f"label-model confidence quartiles (uncalibrated, calibrated in stage 4): {np.round(np.percentile(lab['label_model_confidence'], [25, 50, 75]), 3).tolist()}")
print(f"distinct L4 assigned: {lab['Intent-L4'].nunique()} of {K}")
print("\nweak L2 by L1 (labelled real notes):")
print(pd.crosstab(lab["Intent-L2"], lab[l1_col], margins=True))
print("\nunlabelled real notes by L1 (stage 4 model will label these):")
print(out.loc[out["Intent-L4"] == "", l1_col].value_counts().to_string())
print("\ntop 25 weak L4:")
print(lab.groupby(["Intent-L2", "Intent-L4"]).size().sort_values(ascending=False).head(25).to_string())

# %%
rng = np.random.default_rng(args.seed)
frac = min(1.0, args.sample / max(len(lab), 1))
parts = [g.sample(max(1, int(round(len(g) * frac))), random_state=args.seed) for _, g in lab.groupby("Intent-L2")]
spot = pd.concat(parts)[["row_id", text_col, l1_col, "Intent-L2", "Intent-L4", "label_model_confidence"]]
spot = spot.assign(reviewer_L2="", reviewer_L4="", reviewer_note="").sort_values(["Intent-L2", "Intent-L4"])
spot.to_csv(outdir / "spot_check_sample.csv", index=False)
print(f"\nspot-check sample: {len(spot)} rows stratified by L2")
print(f"written to {outdir}")
for f in sorted(outdir.glob("*.csv")):
    print(f"  {f.name}")
