args, _ = ap.parse_known_args()

src = Path(args.csv)
if not src.is_file():
    sys.exit(f"not found: {src}")
out = Path(args.out)
out.mkdir(parents=True, exist_ok=True)

ROLE = {k: getattr(args, k) for k in
        ["conv_col", "intent_col", "agent_col", "func_col", "input_col",
         "output_col", "error_col", "messages_col", "data_col"]}
header = list(pd.read_csv(src, nrows=0, encoding="utf-8-sig").columns)
missing = [v for v in ROLE.values() if v not in header]
if missing:
    sys.exit(f"columns not in file: {missing}\navailable: {header}")
ARG_KEYS = [k.strip() for k in args.arg_keys.split(",") if k.strip()]
READ = dict(dtype=str, encoding="utf-8-sig", encoding_errors="replace", keep_default_na=False,
            chunksize=args.chunk, nrows=args.max_rows or None)
print(src, f"{src.stat().st_size / 1e9:.2f} GB  ->  {out}")

# %%
TS_RE = re.compile(r'"_ts"\s*:\s*(\d+)')
PREFIX_RE = re.compile(r"^([a-z]{2,12})-(.+)$")
SEP_RE = re.compile(r"[\s()+\-]")
FLOAT_RE = re.compile(r"^-?\d+\.\d+$")


def as_obj(raw):
    if isinstance(raw, (dict, list)):
        return raw
    if not isinstance(raw, str):
        return None
    raw = raw.strip()
    if raw[:1] not in "{[":
        return None
    try:
        return json.loads(raw)
    except ValueError:
        try:
            return ast.literal_eval(raw)
        except (ValueError, SyntaxError, MemoryError, RecursionError):
            return None


def leaves(obj, prefix=""):
    if isinstance(obj, dict):
        for k, v in obj.items():
            yield from leaves(v, f"{prefix}.{k}" if prefix else str(k))
    elif isinstance(obj, list):
        for v in obj:
            yield from leaves(v, f"{prefix}[]")
    else:
        yield prefix, obj


def norm(v):
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, float):
        return f"{int(v * 1000) / 1000:.3f}"
    s = str(v).strip()
    if not s:
        return None
    if len(s) < 25 and FLOAT_RE.match(s):
        return f"{int(float(s) * 1000) / 1000:.3f}"
    d = SEP_RE.sub("", s)
    if d.isdigit() and len(d) >= 10:
        return d[-10:]
    return s


def mask(v):
    s = str(v)
    if args.no_mask:
        return s[:200]
    if len(s) < 25 and FLOAT_RE.match(s) and abs(float(s)) <= 180:
        return f"{float(s):.1f}"
    if sum(ch.isdigit() for ch in s) >= 7:
        s = re.sub(r"\d(?=(?:\D*\d){2})", "X", s)
    return s[:80]


def split_name(f):
    m = PREFIX_RE.match(f)
    return (m.group(2), m.group(1)) if m else (f, "")


def depth(path):
    return path.count(".") + path.count("[]")


# %%
conv_index, conv_names, conv_intent = {}, [], {}
ts_rows, conv_rows = array("q"), array("l")
calls, calls_half = Counter(), Counter()
key_convs = defaultdict(set)
logged_as = defaultdict(Counter)
pstat = defaultdict(Counter)
pvals = defaultdict(set)
pexample = {}
consumers = defaultdict(dict)
records = defaultdict(dict)
texts = defaultdict(lambda: defaultdict(set))
first_type = Counter()
user_type = None
errors = Counter()
agreement = Counter()
VAL_CAP = 1001
REC_CAP = 500

n_rows = 0
t0 = time.time()
for chunk in pd.read_csv(src, usecols=list(ROLE.values()), **READ):
    C, I, A, F, P, E, M, D = (chunk[ROLE[k]].tolist() for k in
                              ["conv_col", "intent_col", "agent_col", "func_col",
                               "input_col", "error_col", "messages_col", "data_col"])
    for i in range(len(chunk)):
        conv = C[i]
        cid = conv_index.get(conv)
        if cid is None:
            cid = conv_index[conv] = len(conv_names)
            conv_names.append(conv)
        if I[i] and cid not in conv_intent:
            conv_intent[cid] = I[i]
        m = TS_RE.search(D[i])
        ts = int(m.group(1)) if m else 0
        ts_rows.append(ts)
        conv_rows.append(cid)

        if M[i]:
            msgs = as_obj(M[i])
            if isinstance(msgs, list):
                for j, msg in enumerate(msgs):
                    if not isinstance(msg, dict):
                        continue
                    t = str(msg.get("type", ""))
                    body = msg.get("data") if isinstance(msg.get("data"), dict) else msg
                    content = body.get("content")
                    if j == 0 and user_type is None:
                        first_type[t] += 1
                    if isinstance(content, str) and content and (user_type is None or t == user_type):
                        texts[cid][t].add(content[:5000])
                if user_type is None and first_type.total() >= 200:
                    user_type = first_type.most_common(1)[0][0]
                    for tx in texts.values():
                        for t in [t for t in tx if t != user_type]:
                            del tx[t]
            d = as_obj(D[i])
            if isinstance(d, dict):
                rec = records[cid]
                body = {k: v for k, v in d.items() if k != ROLE["messages_col"] and not str(k).startswith("_")}
                for path, v in leaves(body):
                    if len(rec) >= REC_CAP:
                        break
                    if not path.startswith(args.form_key) and depth(path) > 2:
                        continue
                    nv = norm(v)
                    if nv and args.min_trace_len <= len(nv) <= 64 and nv not in rec:
                        rec[nv] = path

        f = F[i]
        if not f:
            continue
        base, prefix = split_name(f)
        log = "system" if prefix else "agent"
        agent = A[i]
        half = zlib.crc32(conv.encode()) & 1
        key = (agent, base, log)
        calls[key] += 1
        calls_half[key + (half,)] += 1
        key_convs[key].add(cid)
        logged_as[base][f] += 1
        if E[i]:
            errors[(E[i].strip()[:250], f)] += 1

        p = as_obj(P[i])
        p = p if isinstance(p, dict) and p else None
        fa = None
        if p is None or agreement.total() < 5000:
            d = as_obj(D[i])
            if isinstance(d, dict):
                for k in ARG_KEYS:
                    fa = as_obj(d.get(k))
                    if isinstance(fa, dict):
                        break
                    fa = None
            if p is not None:
                agreement["same keys" if fa is not None and set(fa) == set(p)
                          else "different keys" if fa is not None else "no argument field in data"] += 1
        params = p if p is not None else (fa or {})

        seen = set()
        cons = consumers[cid]
        for path, v in leaves(params):
            pkey = key + (path,)
            if path not in seen:
                seen.add(path)
                pstat[pkey]["n"] += 1
                pstat[pkey][f"h{half}"] += 1
            nv = norm(v)
            if nv is None:
                continue
            if len(pvals[pkey]) < VAL_CAP:
                pvals[pkey].add(nv)
            pexample.setdefault(pkey, v)
            ck = (nv, agent, base, path)
            if ck not in cons or ts < cons[ck]:
                cons[ck] = ts

    n_rows += len(chunk)
    print(f"pass 1: {n_rows:,} rows  {len(conv_names):,} conversations  {time.time() - t0:,.0f}s", flush=True)

if user_type is None and first_type:
    user_type = first_type.most_common(1)[0][0]
print(f"pass 1 done: {n_rows:,} rows, {sum(calls.values()):,} calls, {len(conv_names):,} conversations")
print("user message type:", user_type, dict(first_type))
print("input vs data arguments:", dict(agreement))

# %%
agent_calls = Counter()
for (agent, base, log), c in calls.items():
    if agent:
        agent_calls[(base, agent)] += c
dominant = {}
for (base, agent), _ in agent_calls.most_common():
    dominant.setdefault(base, agent)


def res(agent, base):
    return agent or dominant.get(base, "")


unresolved = defaultdict(set)
for cid, cons in consumers.items():
    rec = records.get(cid, {})
    tx = texts.get(cid)
    text = "\n".join(tx.get(user_type, ())) if tx else ""
    for ck in list(cons):
        nv = ck[0]
        if len(nv) < args.min_trace_len:
            cons[ck] = [cons[ck], "short value", ""]
        elif rec.get(nv, "").startswith(args.form_key):
            cons[ck] = [cons[ck], "user form", rec[nv]]
        elif text and nv in text:
            cons[ck] = [cons[ck], "user message", ""]
        else:
            unresolved[cid].add(nv)
texts.clear()
print(f"values left for upstream search: {sum(len(v) for v in unresolved.values()):,} in {len(unresolved):,} conversations")

# %%
producers = defaultdict(lambda: defaultdict(dict))
if not args.skip_upstream and unresolved:
    r0 = 0
    t0 = time.time()
    cols = [ROLE["conv_col"], ROLE["agent_col"], ROLE["func_col"], ROLE["output_col"]]
    for chunk in pd.read_csv(src, usecols=cols, **READ):
        C, A, F, O = (chunk[c].tolist() for c in cols)
        if C and conv_names[conv_rows[r0]] != C[0]:
            sys.exit(f"row alignment lost at row {r0}")
        for i in range(len(chunk)):
            o = O[i]
            if not o or not F[i]:
                continue
            r = r0 + i
            vals = unresolved.get(conv_rows[r])
            if not vals:
                continue
            hits = {v for v in vals if v in o}
            if not hits:
                continue
            base = split_name(F[i])[0]
            ts = ts_rows[r]
            obj = as_obj(o)
            found = [(v, "(text)") for v in hits] if obj is None else \
                [(nv, path) for path, leaf in leaves(obj) if (nv := norm(leaf)) in hits]
            prod = producers[conv_rows[r]]
            for nv, path in found:
                k = (A[i], base, path)
                if k not in prod[nv] or ts < prod[nv][k]:
                    prod[nv][k] = ts
        r0 += len(chunk)
        print(f"pass 2: {r0:,} rows  {time.time() - t0:,.0f}s", flush=True)

for cid, cons in consumers.items():
    pending = [ck for ck, st in cons.items() if not isinstance(st, list)]
    if not pending:
        continue
    prod = producers.get(cid, {})
    rec = records.get(cid, {})
    consumed_by = defaultdict(dict)
    for (nv, _, base, _), st in cons.items():
        t = st[0] if isinstance(st, list) else st
        if base not in consumed_by[nv] or t < consumed_by[nv][base]:
            consumed_by[nv][base] = t
    for ck in pending:
        nv, agent, base, param = ck
        ts = cons[ck]
        best = None
        for (pa, pb, pp), pts in prod.get(nv, {}).items():
            if pb == base or pts > ts:
                continue
            ct = consumed_by[nv].get(pb)
            if ct is not None and ct <= pts:
                continue
            if best is None or pts > best[0]:
                best = (pts, pb, pp)
        if best:
            cons[ck] = [ts, "earlier call output", f"{best[1]} -> {best[2]}"]
        elif nv in rec:
            cons[ck] = [ts, "conversation state", rec[nv]]
        else:
            cons[ck] = [ts, "not traced", ""]
records.clear()
producers.clear()

# %%
SOURCES = ["user form", "user message", "earlier call output", "conversation state", "not traced", "short value"]
src_count = defaultdict(Counter)
src_detail = defaultdict(Counter)
for cid, cons in consumers.items():
    for (nv, agent, base, param), (_, source, detail) in cons.items():
        rk = (res(agent, base), base, param)
        src_count[rk][source] += 1
        if detail:
            src_detail[rk][detail] += 1

fcalls = defaultdict(Counter)
fconvs = defaultdict(set)
for (agent, base, log), c in calls.items():
    fk = (res(agent, base), base)
    fcalls[fk][log] += c
    fconvs[fk] |= key_convs[(agent, base, log)]

agg = defaultdict(Counter)
agg_vals = defaultdict(set)
agg_example = {}
for (agent, base, log, param), st in pstat.items():
    rk = (res(agent, base), base, param)
    agg[rk][log] += st["n"]
    agg[rk]["h0"] += st["h0"]
    agg[rk]["h1"] += st["h1"]
    if len(agg_vals[rk]) < VAL_CAP:
        agg_vals[rk] |= pvals[(agent, base, log, param)]
    ex = pexample.get((agent, base, log, param))
    if ex is not None and (rk not in agg_example or log == "agent"):
        agg_example[rk] = ex


def top(counter, k=2):
    return " | ".join(f"{d} ({n})" for d, n in counter.most_common(k))


rows = []
for rk, st in agg.items():
    agent, base, param = rk
    fk = (agent, base)
    sc = src_count[rk]
    nd = len(agg_vals[rk])
    rows.append({
        "Agent": agent or "(not logged)",
        "Function": base,
        "Logged as": " | ".join(logged_as[base]),
        "Conversations": len(fconvs[fk]),
        "Intents (conversations)": top(Counter(conv_intent.get(c, "") for c in fconvs[fk]), 5),
        "Calls (agent log)": fcalls[fk]["agent"],
        "Calls (system log)": fcalls[fk]["system"],
        "Parameter": param,
        "With parameter (agent log)": st["agent"],
        "With parameter (system log)": st["system"],
        "Distinct values": "1000+" if nd >= VAL_CAP else nd,
        "Example value": mask(agg_example[rk]) if rk in agg_example else "",
        **{f"From {s}" if s not in ("not traced", "short value") else s.capitalize(): sc[s] for s in SOURCES},
        "Main source detail": top(src_detail[rk]),
    })

fp = pd.DataFrame(rows)
fp["_order"] = fp["With parameter (agent log)"] + fp["With parameter (system log)"]
fp = fp.sort_values(["Agent", "Function", "_order"], ascending=[True, True, False]).drop(columns="_order")

with_params = {(a, b) for a, b, _ in agg}
no_param = [{"Agent": a or "(not logged)", "Function": b, "Logged as": " | ".join(logged_as[b]),
             "Conversations": len(fconvs[(a, b)]), "Calls (agent log)": c["agent"],
             "Calls (system log)": c["system"], "Parameter": "(none logged)"}
            for (a, b), c in fcalls.items() if (a, b) not in with_params]
if no_param:
    fp = pd.concat([fp, pd.DataFrame(no_param)], ignore_index=True)
num_cols = [c for c in fp.columns if c not in
            ("Agent", "Function", "Logged as", "Intents (conversations)", "Parameter",
             "Distinct values", "Example value", "Main source detail")]
fp[num_cols] = fp[num_cols].fillna(0).astype(int)
fp = fp.fillna("")
print(f"{fp['Function'].nunique()} functions, {len(fp)} function-parameter rows")
print(fp[["Agent", "Function", "Parameter", "With parameter (agent log)", "From user form",
          "From earlier call output", "Not traced", "Main source detail"]].head(60).to_string(index=False))

ap_rows = (fp[fp["Parameter"] != "(none logged)"]
           .assign(_calls=lambda x: x["With parameter (agent log)"].fillna(0) + x["With parameter (system log)"].fillna(0))
           .groupby(["Agent", "Parameter"])
           .agg(Functions=("Function", lambda s: " | ".join(sorted(set(s)))),
                **{"Calls with parameter": ("_calls", "sum")})
           .reset_index().sort_values(["Agent", "Calls with parameter"], ascending=[True, False]))
ap_rows["Calls with parameter"] = ap_rows["Calls with parameter"].astype(int)

skipped = pd.DataFrame([{"Error": e, "Function": f, "Rows": n} for (e, f), n in errors.most_common()])

# %%
def locate(name):
    p = Path(name)
    if p.is_file():
        return p
    home = Path.home()
    for root in [Path.cwd(), Path(r"C:\Datascience")] + sorted(home.glob("OneDrive*")) + [home]:
        if not root.is_dir():
            continue
        hits = [h for h in root.rglob(p.name) if not h.name.startswith("~$")]
        if hits:
            return max(hits, key=lambda h: h.stat().st_mtime)
    return None


bl_rows = pd.DataFrame()
coverage = {}
base_path = locate(args.baseline)
if base_path:
    wb = load_workbook(base_path, read_only=True)
    sheet = max(wb.worksheets, key=lambda ws: (ws.max_row or 0) * (ws.max_column or 0)).title
    wb.close()
    want = {ROLE["func_col"], ROLE["conv_col"]}
    b = pd.read_excel(base_path, sheet_name=sheet, dtype=str, usecols=lambda c: c in want).fillna("")
    fn = b[ROLE["func_col"]].str.split("|").explode().str.strip()
    fn = fn[fn != ""].map(lambda f: split_name(f)[0])
    base_counts = fn.groupby(level=0).agg(set).explode().value_counts()
    params_by_fn = (fp[fp["Parameter"] != "(none logged)"]
                    .groupby("Function")["Parameter"].agg(lambda s: " | ".join(dict.fromkeys(s))))
    agents_by_fn = fp.groupby("Function")["Agent"].agg(lambda s: " | ".join(dict.fromkeys(s)))
    bl_rows = pd.DataFrame({
        "Function": base_counts.index,
        "Baseline rows": base_counts.values,
        "Agent": [agents_by_fn.get(f, "") for f in base_counts.index],
        "Parameters": [params_by_fn.get(f, "") for f in base_counts.index],
        "In interactions file": ["yes" if f in agents_by_fn.index else "no" for f in base_counts.index],
    })
    bconv = set(b[ROLE["conv_col"]].str.split("|").explode().str.strip()) - {""}
    coverage = {"baseline": base_path.name, "baseline conversations": len(bconv),
                "file conversations": len(conv_index),
                "baseline conversations in file": len(bconv & conv_index.keys()),
                "baseline functions": len(bl_rows),
                "baseline functions with parameters": int((bl_rows["Parameters"] != "").sum())}
    print(coverage)
else:
    print("baseline not found, Baseline_Functions sheet skipped")

# %%
half_calls = defaultdict(Counter)
for (agent, base, log, h), c in calls_half.items():
    half_calls[(res(agent, base), base)][h] += c
sets = defaultdict(lambda: [set(), set(), set(), set()])
for (agent, base, param), st in agg.items():
    hc = half_calls[(agent, base)]
    for h in (0, 1):
        if hc[h]:
            r = st[f"h{h}"] / hc[h]
            if r >= 0.5:
                sets[(agent, base)][h].add(param)
            if r >= 0.99:
                sets[(agent, base)][2 + h].add(param)


def jac(a, b):
    return 1.0 if not a and not b else len(a & b) / len(a | b)


val = pd.DataFrame([{"agent": a, "function": f, "calls_half0": half_calls[(a, f)][0],
                     "calls_half1": half_calls[(a, f)][1],
                     "usual_param_jaccard": round(jac(s[0], s[1]), 4),
                     "required_param_jaccard": round(jac(s[2], s[3]), 4)}
                    for (a, f), s in sets.items() if half_calls[(a, f)][0] and half_calls[(a, f)][1]])
if len(val):
    print("split-half stability (functions called in both halves):", len(val))
    print(val[["usual_param_jaccard", "required_param_jaccard"]].describe().round(4).to_string())
val.to_csv(out / "internal_validation_split_half.csv", index=False)
pd.DataFrame([agreement]).to_csv(out / "internal_input_vs_data_arguments.csv", index=False)
pd.DataFrame([coverage]).to_csv(out / "internal_baseline_coverage.csv", index=False)
pd.DataFrame([{"intent": k, "conversations": v} for k, v in Counter(conv_intent.values()).items()]) \
    .to_csv(out / "internal_intents.csv", index=False)

# %%
xlsx = out / "nora_function_parameter_map.xlsx"
sheets = {"Function_Parameters": fp, "Agent_Parameters": ap_rows,
          "Baseline_Functions": bl_rows, "Skipped_Calls": skipped}
with pd.ExcelWriter(xlsx, engine="openpyxl") as w:
    for name, df in sheets.items():
        if len(df):
            df.to_excel(w, sheet_name=name, index=False)
            ws = w.sheets[name]
            ws.freeze_panes = "A2"
            for cell in ws[1]:
                cell.font = Font(bold=True)
            for j, col in enumerate(df.columns, 1):
                width = max([len(str(col))] + [len(str(v)) for v in df[col].head(500)])
                ws.column_dimensions[get_column_letter(j)].width = min(max(width + 2, 10), 60)
print("saved", xlsx)
