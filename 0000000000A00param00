ap = argparse.ArgumentParser()
ap.add_argument("--csv", default=r"C:\Datascience\Uday\interactons\interactions.csv")
ap.add_argument("--baseline", default="baseline_56705_mapped_C046D46E.xlsx")
ap.add_argument("--out", default=r"C:\Datascience\nora_function_parameters")
ap.add_argument("--chunk", type=int, default=50000)
ap.add_argument("--max-rows", type=int, default=0)
ap.add_argument("--conv-col", default="interaction_id")
ap.add_argument("--intent-col", default="intent")
ap.add_argument("--agent-col", default="agent")
ap.add_argument("--func-col", default="function_name")
ap.add_argument("--input-col", default="input")
ap.add_argument("--output-col", default="output")
ap.add_argument("--error-col", default="error")
ap.add_argument("--messages-col", default="messages")
ap.add_argument("--data-col", default="data")
ap.add_argument("--arg-keys", default="function_arguments,arguments")
ap.add_argument("--form-key", default="user_inputs")
