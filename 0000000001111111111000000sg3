family = [{k} | {l4_index[o] for o in str(v).split("|") if o in l4_index} for k, v in enumerate(taxonomy["overlaps_with"])]


def mask_name_words(text, k):
    return " ".join(t for t in tokens_of(text) if not (variant_of.get(t, set()) & name_words_full[k]))


calib = np.flatnonzero(vote_name_real != ABSTAIN)
