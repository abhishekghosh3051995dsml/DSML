def lcp(a, b):
    n = 0
    for x, y in zip(a, b):
        if x != y:
            break
        n += 1
    return n


SHORT_TAILS = {"e", "s", "es", "d", "ed", "ing", "on", "y", "ies", "ied"}
INFLECTIONS = {"s", "es", "d", "ed", "ing", "ings", "er", "ers", "ment", "ments", "ion", "ions", "ation", "ations", "al", "ly", "ity", "ivity", "ive"}
STEM_TAILS = SHORT_TAILS | INFLECTIONS | {"ication", "ications", "ying", "ement", "ements", "ered", "ering", "ration", "sion", "ded"}


def word_matches(v, w):
    if v == w:
        return True
    shorter, longer = sorted((v, w), key=len)
    common = lcp(v, w)
    if len(shorter) < 4 or common < 4:
        return False
    if common == len(shorter):
        return longer[common:] in INFLECTIONS
    for c in range(common, max(3, common - 3), -1):
        if v[c:] in STEM_TAILS and w[c:] in STEM_TAILS:
            return True
    return common >= args.word_prefix_ratio * len(shorter) and shorter[common:] in SHORT_TAILS


def tokens_of(text):
    return re.findall(r"[a-z]+", text.lower())


name_words = [frozenset(w for w in n.lower().split("_") if w != "ticket") for n in l4_list]
name_words_full = list(name_words)
ticket_only = [m == {"TICKET"} for m in matrix_l1]
seen = {}
for k in sorted(range(K), key=lambda k: ticket_only[k]):
    if name_words[k] in seen:
        name_words[k] = frozenset()
    else:
        seen[name_words[k]] = k

name_df = defaultdict(int)
for ws in name_words:
    for w in ws:
        name_df[w] += 1
name_idf = {w: np.log((1 + K) / (1 + c)) + 1 for w, c in name_df.items()}
name_weight = [sum(name_idf[w] for w in ws) for ws in name_words]

all_name_words = set().union(*name_words_full)
note_vocab = set(t for text in df["text_clean"] for t in tokens_of(text))
by_head = defaultdict(list)
for w in all_name_words:
    by_head[w[:2]].append(w)
variant_of = {}
for v in note_vocab:
    hits = {w for w in by_head.get(v[:2], []) if word_matches(v, w)}
    if v.startswith("re") and len(v) >= 8:
        hits |= {w for w in by_head.get(v[2:4], []) if word_matches(v[2:], w)}
    if hits:
        variant_of[v] = hits
variant_table = pd.DataFrame(sorted((w, v) for v, ws in variant_of.items() for w in ws if v != w), columns=["name_word", "note_word"])
variant_table.to_csv(outdir / "name_word_variants.csv", index=False)
print(f"name words: {len(all_name_words)}  note-word variants accepted: {len(variant_table):,} (shared-prefix ratio >= {args.word_prefix_ratio})")


real_name_sets = [{w for t in set(tokens_of(text)) for w in variant_of.get(t, ())} for text in real["text_clean"]]
note_df = defaultdict(int)
for ws in real_name_sets:
    for w in ws:
        note_df[w] += 1
note_idf = {w: np.log((1 + len(real)) / (1 + note_df.get(w, 0))) + 1 for w in all_name_words}


def min_span(positions):
    events = sorted((p, w) for w, ps in positions.items() for p in ps)
    need, have, best, left = len(positions), defaultdict(int), None, 0
    for right, (p, w) in enumerate(events):
        have[w] += 1
        while len(have) == need:
            span = p - events[left][0]
            best = span if best is None else min(best, span)
            lw = events[left][1]
            have[lw] -= 1
            if have[lw] == 0:
                del have[lw]
            left += 1
    return best if best is not None else 0


def family_of(k):
    return {k} | {l4_index[o] for o in str(taxonomy.at[k, "overlaps_with"]).split("|") if o in l4_index}


def name_vote(text, allow_ticket_only):
    toks = tokens_of(text)
    where = defaultdict(list)
    for i, t in enumerate(toks):
        for w in variant_of.get(t, ()):
            where[w].append(i)
    found = []
    for k, ws in enumerate(name_words):
        if not ws or (ticket_only[k] and not allow_ticket_only):
            continue
        hit = [w for w in ws if w in where]
        if not hit:
            continue
        cov = sum(name_idf[w] for w in hit) / name_weight[k]
        if cov >= args.name_coverage and min_span({w: where[w] for w in hit}) <= args.name_window:
            found.append((sum(note_idf[w] for w in hit), cov, k))
    if not found:
        return ABSTAIN, ABSTAIN
    found.sort(reverse=True)
    second = next((k for _, _, k in found[1:] if k not in family_of(found[0][2]) and not ticket_only[k]), ABSTAIN)
    return found[0][2], second


