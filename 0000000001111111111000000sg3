lsa_vec = TfidfVectorizer(min_df=2, sublinear_tf=True, token_pattern=r"[a-z]{2,}").fit(all_text)
svd = TruncatedSVD(n_components=min(args.lsa_dims, len(lsa_vec.vocabulary_) - 1), random_state=args.seed).fit(lsa_vec.transform(all_text))
print(f"semantic space: {svd.n_components} dims, {svd.explained_variance_ratio_.sum():.1%} variance kept")


def embed(texts):
    z = svd.transform(lsa_vec.transform(texts)) - lsa_mean
    return z / np.maximum(np.linalg.norm(z, axis=1, keepdims=True), 1e-12)


lsa_mean = svd.transform(lsa_vec.transform(all_text)).mean(0)
