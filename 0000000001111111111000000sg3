def split_l1(v):
    return {x for x in str(v).split("|") if x}


matrix_l1 = [split_l1(v) for v in taxonomy["matrix_l1"]]
observed_l1 = [split_l1(v) for v in taxonomy["observed_l1"]]
l2_l1 = defaultdict(set)
for l2, m in zip(taxonomy["Intent-L2"], matrix_l1):
    l2_l1[l2] |= m
