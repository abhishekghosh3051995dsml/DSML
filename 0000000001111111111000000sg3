def dawid_skene(L, prior, acc0, strength, iters=200, tol=1e-6):
    n, m = L.shape
    acc = acc0.copy()
    a, b = strength * acc0, strength * (1 - acc0)
    for _ in range(iters):
        logq = np.log(prior)
        for j in range(m):
            v = L[:, j]
            on = v != ABSTAIN
            wrong = np.log((1 - acc[j]) / (K - 1))
            logq[on] += wrong
            logq[on, v[on]] += np.log(acc[j]) - wrong
        logq -= logq.max(1, keepdims=True)
        q = np.exp(logq)
        q /= q.sum(1, keepdims=True)
        new = np.array([(q[L[:, j] != ABSTAIN, L[L[:, j] != ABSTAIN, j]].sum() + a[j]) / ((L[:, j] != ABSTAIN).sum() + a[j] + b[j])
                        for j in range(m)])
        new = np.clip(new, 1e-3, 1 - 1e-3)
        if np.max(np.abs(new - acc)) < tol:
            acc = new
            break
        acc = new
    return q, acc


