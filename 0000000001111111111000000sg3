def lexicon_vote(text, l1):
    hits = []
    for k, tier, pos, neg in lexicon:
        if any(n.search(text) for n in neg):
            continue
        found = [m for p in pos for m in [p.search(text)] if m]
        if found:
            m = min(found, key=lambda m: (m.start(), -(m.end() - m.start())))
            hits.append((tier, m.start(), -(m.end() - m.start()), k))
    if not hits:
        return ABSTAIN, ABSTAIN, 0
    hits.sort()
    first = hits[0][3]
    second = next((h[3] for h in hits[1:] if h[3] not in family[first]), ABSTAIN)
    variant = L1_VARIANT.get((l4_list[first], l1))
    if variant in l4_index:
        first = l4_index[variant]
    return first, second, hits[0][0]


