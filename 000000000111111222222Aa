def tokens(name):
    return {w[:-1] if len(w) > 4 and w.endswith("s") else w for w in re.split(r"[_\s]+", name.lower()) if w}


taxonomy = pd.DataFrame(
    [(l2, l4, "canonical") for l2, l4s in L4_BY_L2.items() for l4 in l4s]
    + [(l2, l4, "matrix") for l2, l4s in MATRIX_L4_BY_L2.items() for l4 in l4s],
    columns=["Intent-L2", "Intent-L4", "source"],
).drop_duplicates("Intent-L4")

l4_names = taxonomy["Intent-L4"].tolist()
l4_l2 = taxonomy["Intent-L2"].tolist()
l4_tokens = [tokens(n) for n in l4_names]
doc_freq = defaultdict(int)
for toks in l4_tokens:
    for w in toks:
        doc_freq[w] += 1
idf = lambda w: np.log((1 + len(l4_tokens)) / (1 + doc_freq.get(w, 0))) + 1

real_text = df.loc[~df["is_template"], "text_clean"]
word_vec = TfidfVectorizer(min_df=2, sublinear_tf=True, token_pattern=r"[a-z]{2,}")
real_tfidf = word_vec.fit_transform(real_text)
svd = TruncatedSVD(n_components=min(200, real_tfidf.shape[1] - 1), random_state=0).fit(real_tfidf)
print(f"semantic space: {real_tfidf.shape[1]:,} words from {len(real_text):,} real notes, {svd.n_components} dims, "
      f"{svd.explained_variance_ratio_.sum():.1%} variance kept")


def embed(texts):
    z = svd.transform(word_vec.transform(texts))
    return z / np.maximum(np.linalg.norm(z, axis=1, keepdims=True), 1e-12)


l2_names = sorted(taxonomy["Intent-L2"].unique())
l2_docs = [" ".join([l2.replace("_", " ").lower()] + [n.replace("_", " ").lower() for n, p in zip(l4_names, l4_l2) if p == l2]) for l2 in l2_names]
l2_emb = embed(l2_docs)


def match_topic(topic):
    t = tokens(topic)
    overlap = np.array([sum(idf(w) for w in t & s) / sum(idf(w) for w in t | s) for s in l4_tokens])
    same = [i for i, toks in enumerate(l4_tokens) if toks == t]
    if same:
        exact_idx = same[0]
        return pd.Series({"Intent-L2": l4_l2[exact_idx], "Intent-L4": l4_names[exact_idx], "match": "exact",
                          "nearest_l4": l4_names[exact_idx], "name_overlap": 1.0, "semantic_l2_cosine": np.nan})
    semantic = (embed([topic]) @ l2_emb.T).ravel()
    l2_score = {l2: semantic[i] + max(o for o, p in zip(overlap, l4_l2) if p == l2) for i, l2 in enumerate(l2_names)}
    l2 = max(l2_score, key=l2_score.get)
    in_l2 = [i for i, p in enumerate(l4_l2) if p == l2]
    near = max(in_l2, key=lambda i: overlap[i])
    evidence = l2_score[l2] > 0
    return pd.Series({"Intent-L2": l2, "Intent-L4": re.sub(r"\s+", "_", topic.upper()),
                      "match": "new_l4" if evidence else "new_l4_check_l2",
                      "nearest_l4": l4_names[near], "name_overlap": round(float(overlap[near]), 3),
                      "semantic_l2_cosine": round(float(semantic[l2_names.index(l2)]), 3)})


