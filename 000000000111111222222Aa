# %%
frames_of_topic = defaultdict(set)
topics_of_frame = defaultdict(set)
splits = {}
for core in unique_cores:
    tok = core.split()
    cands = []
    for i in range(len(tok)):
        for j in range(i + 1, len(tok) + 1):
            frame = (" ".join(tok[:i]), " ".join(tok[j:]))
            topic = " ".join(tok[i:j])
            frames_of_topic[topic].add(frame)
            topics_of_frame[frame].add(topic)
            cands.append((frame, topic))
    splits[core] = cands


def best_split(core):
    scored = [
        (len(frames_of_topic[t]) * len(topics_of_frame[f]), len(t.split()), f, t)
        for f, t in splits[core]
        if len(frames_of_topic[t]) > 1 and len(topics_of_frame[f]) > 1
    ]
    if not scored:
        return ("", ""), core
    _, _, frame, topic = max(scored)
    return frame, topic


parsed = {c: best_split(c) for c in unique_cores}
templates["frame"] = templates["core"].map(lambda c: " … ".join(parsed[c][0]).strip(" …") or "(none)")
templates["topic"] = templates["core"].map(lambda c: parsed[c][1])

