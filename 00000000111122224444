# %%
import argparse
import re
from pathlib import Path

import numpy as np
import pandas as pd
from rapidfuzz import process
from rapidfuzz.distance import OSA

parser = argparse.ArgumentParser()
parser.add_argument("--input", default=str(Path.home() / "OneDrive - T-Mobile USA" / "Downloads" / "data.csv"))
parser.add_argument("--outdir", default=r"C:\Datascience\nora_l2l4\stage1_profile")
parser.add_argument("--typo-ratio", type=float, default=10.0)
args, _ = parser.parse_known_args()

outdir = Path(args.outdir)
outdir.mkdir(parents=True, exist_ok=True)


def read_csv_any(path):
    for enc in ("utf-8-sig", "utf-8", "cp1252", "latin-1"):
        try:
            return pd.read_csv(path, dtype=str, keep_default_na=False, encoding=enc), enc
        except UnicodeDecodeError:
            continue
    raise ValueError(f"cannot decode {path}")


raw, encoding = read_csv_any(args.input)
raw = raw.loc[:, [c for c in raw.columns if not c.startswith("Unnamed")]]
print(f"file: {args.input}")
print(f"encoding: {encoding}  rows: {len(raw):,}  columns: {list(raw.columns)}")

# %%
col_stats = pd.DataFrame({
    "mean_len": raw.apply(lambda s: s.str.len().mean()),
    "n_unique": raw.nunique(),
    "n_blank": raw.apply(lambda s: (s.str.strip() == "").sum()),
})
text_col = col_stats["mean_len"].idxmax()
l1_col = col_stats.drop(index=text_col).query("n_unique > 1")["n_unique"].idxmin()
print(col_stats)
print(f"\ntext column: {text_col}\nL1 column:   {l1_col}")

df = raw[[text_col, l1_col]].copy()
df.insert(0, "row_id", np.arange(len(df)))

# %%
l1_counts = df[l1_col].value_counts(dropna=False).rename_axis(l1_col).reset_index(name="rows")
l1_variants = (
    df.assign(l1_norm=df[l1_col].str.strip().str.upper())
    .groupby("l1_norm")[l1_col].nunique().loc[lambda s: s > 1]
)
print(l1_counts.to_string(index=False))
print(f"L1 spelling variants (same value, different case/space): {len(l1_variants)}")
l1_counts.to_csv(outdir / "l1_distribution.csv", index=False)

# %%
def normalize(text):
    text = re.sub(r"['\u2019`]", "", text.lower())
    text = re.sub(r"[^\w\s:.!?&/-]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


df["text_norm"] = df[text_col].map(normalize)
df["n_chars"] = df["text_norm"].str.len()
df["n_tokens"] = df["text_norm"].str.split().str.len()
blank = df["text_norm"] == ""
print(f"blank messages: {blank.sum():,}")
print(df.loc[~blank, ["n_chars", "n_tokens"]].describe(percentiles=[.05, .25, .5, .75, .95]).round(1))

# %%
def interchangeable_affixes(affix, remainder):
    # an affix is a template piece when the sentences it wraps also occur without it or with another affix
    frame = pd.DataFrame({"affix": affix, "rest": remainder})
    variants_per_rest = frame.groupby("rest")["affix"].nunique()
    stats = (
        frame[frame["affix"] != ""]
        .assign(shared=lambda d: d["rest"].map(variants_per_rest) > 1)
        .groupby("affix").agg(rows=("rest", "size"), distinct_rest=("rest", "nunique"), shared_share=("shared", "mean"))
    )
    stats["is_template"] = (stats["shared_share"] > 0.5) & (stats["distinct_rest"] > 1)
    return stats.sort_values("rows", ascending=False)


prefix_re = re.compile(r"^([^:.!?]{1,40}):\s+")
df["prefix"] = df["text_norm"].str.extract(prefix_re, expand=False).fillna("")
after_prefix = df["text_norm"].str.replace(prefix_re, "", n=1, regex=True)
prefix_stats = interchangeable_affixes(df["prefix"], after_prefix)
template_prefixes = set(prefix_stats.index[prefix_stats["is_template"]])

sentences = after_prefix.str.split(r"(?<=[.!?])\s+", regex=True)
df["last_sentence"] = np.where(sentences.str.len() > 1, sentences.str[-1], "")
before_suffix = [t[: len(t) - len(s)].strip() if s else t for t, s in zip(after_prefix, df["last_sentence"])]
suffix_stats = interchangeable_affixes(df["last_sentence"], pd.Series(before_suffix, index=df.index))
template_suffixes = set(suffix_stats.index[suffix_stats["is_template"]])

print("template prefixes:", sorted(template_prefixes))
print("template suffixes:", sorted(template_suffixes))
pd.concat([
    prefix_stats.head(100).reset_index().assign(kind="prefix"),
    suffix_stats.head(100).reset_index().assign(kind="suffix"),
]).to_csv(outdir / "affix_frequency.csv", index=False)

# %%
def strip_affixes(row):
    core = row["text_norm"]
    if row["prefix"] in template_prefixes:
        core = prefix_re.sub("", core, count=1)
    if row["last_sentence"] in template_suffixes:
        core = core[: len(core) - len(row["last_sentence"])].strip()
    return core


df["text_core"] = df.apply(strip_affixes, axis=1)
df["has_affix"] = df["prefix"].isin(template_prefixes) | df["last_sentence"].isin(template_suffixes)
core_affixed = df.groupby("text_core")["has_affix"].transform("any")
df["core_freq"] = df.groupby("text_core")["row_id"].transform("size")
df["is_template"] = df["has_affix"] | (core_affixed & (df["core_freq"] > 1))

raw_text = df[text_col].str.strip()
df["sentence_case"] = raw_text.str[:1].str.isupper()
df["end_punct"] = raw_text.str[-1:].isin(list(".!?"))

style = pd.crosstab(df["is_template"], [df["sentence_case"], df["end_punct"]], margins=True)
print(f"template rows: {df['is_template'].sum():,} of {len(df):,}")
print("\nstyle check (template flag vs sentence case / end punctuation):")
print(style)
style.to_csv(outdir / "template_style_check.csv")

# %%
df["template_group"] = df["text_core"].factorize()[0]
df["dup_group"] = df["text_norm"].factorize()[0]

source = np.where(df["is_template"], "template", "real")
summary = (
    df.assign(source=source)
    .groupby([l1_col, "source"])
    .agg(rows=("row_id", "size"), unique_text=("text_norm", "nunique"), unique_core=("text_core", "nunique"))
    .reset_index()
)
print(summary.to_string(index=False))
summary.to_csv(outdir / "source_by_l1.csv", index=False)

top_cores = (
    df[df["is_template"]].groupby("text_core")
    .agg(rows=("row_id", "size"), l1_values=(l1_col, lambda s: "|".join(sorted(s.unique()))))
    .sort_values("rows", ascending=False).reset_index()
)
top_cores.to_csv(outdir / "template_cores.csv", index=False)
print(f"\ndistinct template cores: {len(top_cores):,}")
print(top_cores.head(15).to_string(index=False))

# %%
conflict = (
    df.groupby("text_norm")[l1_col].nunique().loc[lambda s: s > 1]
)
conflict_rows = df[df["text_norm"].isin(conflict.index)].groupby(["text_norm", l1_col]).size().reset_index(name="rows")
print(f"identical messages carrying different L1: {len(conflict):,}")
conflict_rows.to_csv(outdir / "l1_conflicts_same_text.csv", index=False)

# %%
real = df.loc[~df["is_template"] & ~blank]
tokens = real["text_norm"].str.findall(r"[a-z]+").explode().dropna()
vocab = tokens.value_counts()
frequent_cut = np.percentile(vocab.values, 95)
frequent = vocab[vocab >= frequent_cut]
candidates = vocab[(vocab < frequent_cut) & (vocab.index.str.len() >= 4)]
freq_words = frequent.index.tolist()
print(f"real-message vocabulary: {len(vocab):,} tokens  frequent (>= {frequent_cut:.0f}): {len(frequent):,}  candidates: {len(candidates):,}")


spell_rows = []
for tok, tok_count in candidates.items():
    max_dist = 1 if len(tok) <= 6 else 2
    pool = [w for w in freq_words if w[0] == tok[0] and abs(len(w) - len(tok)) <= max_dist]
    if not pool:
        continue
    hit = process.extractOne(tok, pool, scorer=OSA.distance, score_cutoff=max_dist)
    is_transposition = hit is not None and sorted(tok) == sorted(hit[0])
    if is_transposition and frequent[hit[0]] >= args.typo_ratio * tok_count:
        spell_rows.append((tok, hit[0], int(hit[1]), int(tok_count), int(frequent[hit[0]])))

spell_map = pd.DataFrame(spell_rows, columns=["variant", "canonical", "edit_distance", "variant_count", "canonical_count"])
spell_map.to_csv(outdir / "spelling_map.csv", index=False)
print(f"learned spelling corrections: {len(spell_map):,}")
print(spell_map.sort_values("variant_count", ascending=False).head(20).to_string(index=False))

# %%
short = vocab[vocab.index.str.len() <= 3].head(60).rename_axis("token").reset_index(name="count")
short.to_csv(outdir / "short_tokens.csv", index=False)
single = vocab[(vocab.index.str.len() == 1) & ~vocab.index.isin(["a", "i"])]
print("most frequent short tokens (shorthand candidates):")
print(short.head(30).to_string(index=False))
print(f"\nstray single letters (likely stripped digits): {int(single.sum()):,} occurrences in {len(single)} letters")

# %%
spell_lookup = dict(zip(spell_map["variant"], spell_map["canonical"]))
token_re = re.compile(r"[a-z]+")


def apply_spelling(text):
    return token_re.sub(lambda m: spell_lookup.get(m.group(0), m.group(0)), text)


df["text_clean"] = df["text_core"].map(apply_spelling)
changed = (df["text_clean"] != df["text_core"]).sum()
print(f"messages changed by spelling map: {changed:,}")

keep = ["row_id", text_col, l1_col, "text_clean", "is_template", "template_group", "dup_group", "core_freq", "n_tokens"]
df[keep].to_csv(outdir / "stage1_clean.csv", index=False)
pd.DataFrame({"role": ["text", "l1"], "column": [text_col, l1_col]}).to_csv(outdir / "column_roles.csv", index=False)
print(f"\nwritten to {outdir}")
for f in sorted(outdir.glob("*.csv")):
    print(f"  {f.name}")
