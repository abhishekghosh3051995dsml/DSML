import argparse
import json
import re
import sys
import time
from collections import Counter, defaultdict
from pathlib import Path

import pandas as pd
from openpyxl import load_workbook

ap = argparse.ArgumentParser()
ap.add_argument("--csv", default=r"C:\Datascience\Uday\interactons\interactions.csv")
ap.add_argument("--baseline", default="baseline_56705_mapped_C046D46E.xlsx")
ap.add_argument("--out", default="uday_interactions_eda")
ap.add_argument("--chunk", type=int, default=20000)
ap.add_argument("--max-rows", type=int, default=0)
ap.add_argument("--samples", type=int, default=300)
args, _ = ap.parse_known_args()

out = Path(args.out)
out.mkdir(exist_ok=True)
READ = dict(dtype=str, encoding="utf-8-sig", encoding_errors="replace", keep_default_na=False)


def locate(name):
    p = Path(name)
    if p.is_file():
        return p
    home = Path.home()
    for root in [Path.cwd()] + sorted(home.glob("OneDrive*")) + [home]:
        hits = [h for h in root.rglob(p.name) if not h.name.startswith("~$")]
        if hits:
            return max(hits, key=lambda h: h.stat().st_mtime)
    sys.exit(f"not found: {name}")


src = Path(args.csv)
if not src.is_file():
    sys.exit(f"not found: {src}")
print(src, f"{src.stat().st_size / 1e9:.2f} GB")

peek = pd.read_csv(src, nrows=50, **READ)
cols = list(peek.columns)
print(len(cols), "columns:", cols)

# %%
base_path = locate(args.baseline)
wb = load_workbook(base_path, read_only=True)
base_sheet = max(wb.worksheets, key=lambda ws: (ws.max_row or 0) * (ws.max_column or 0)).title
wb.close()
base = pd.read_excel(base_path, sheet_name=base_sheet, dtype=str).fillna("")
print(base_path.name, base_sheet, base.shape)

ID_RE = re.compile(r"^[0-9a-fA-F][0-9a-fA-F-]{11,}$")


def tokens(series):
    t = series.str.split("|").explode().str.strip()
    return t[t != ""]


base_ids = {}
for c in base.columns:
    t = tokens(base[c])
    if len(t) and t.head(5000).str.match(ID_RE).mean() > 0.9:
        base_ids[c] = set(t)
print("baseline id columns:", {k: len(v) for k, v in base_ids.items()})

shared = [c for c in cols if c in base.columns]
print("columns shared with baseline:", shared)
fn_col = next((c for c in shared if base[c].str.contains("_").mean() > 0.3 and c not in base_ids
               and tokens(base[c]).str.match(r"^[a-z]").mean() > 0.5), None)
ag_col = next((c for c in shared if c != fn_col and c not in base_ids
               and tokens(base[c]).str.match(r"^[A-Z]+_").mean() > 0.5), None)
conv_col = next((c for c in base_ids if c in cols), None)
print("function column:", fn_col, "| agent column:", ag_col, "| conversation id column:", conv_col)

# %%
def looks_json(v):
    v = v.lstrip()
    return v[:1] in "{["


def walk(obj, prefix, acc, depth=0):
    if isinstance(obj, str) and looks_json(obj) and depth < 6:
        try:
            obj = json.loads(obj)
        except ValueError:
            pass
    if isinstance(obj, dict):
        for k, v in obj.items():
            p = f"{prefix}.{k}" if prefix else str(k)
            walk(v, p, acc, depth + 1)
    elif isinstance(obj, list):
        for item in obj[:20]:
            walk(item, f"{prefix}[]", acc, depth + 1)
    else:
        acc.setdefault(prefix, obj)


PAIR_RE = re.compile(r'"(\w+)"\s*:\s*"([0-9a-fA-F][0-9a-fA-F-]{11,})"')
EPOCH_RE = re.compile(r'"(\w*ts)"\s*:\s*(\d{10})\b')
VALUE_CAP = 5000

n_rows = 0
non_null = Counter()
max_len = Counter()
json_rows = Counter()
values = defaultdict(Counter)
capped = set()
fn_rows = Counter()
fn_convs = defaultdict(set)
fn_agents = defaultdict(Counter)
path_hits = Counter()
path_example = {}
sampled = Counter()
link_hits = Counter()
matched = defaultdict(set)
epoch = {}
t0 = time.time()

for chunk in pd.read_csv(src, chunksize=args.chunk, **READ):
    if args.max_rows and n_rows >= args.max_rows:
        break
    n_rows += len(chunk)
    fn = chunk[fn_col] if fn_col else pd.Series("(all)", index=chunk.index)
    fn = fn.where(fn != "", "(no function)")

    for c in cols:
        s = chunk[c]
        filled = s != ""
        non_null[c] += int(filled.sum())
        if not filled.any():
            continue
        lens = s.str.len()
        max_len[c] = max(max_len[c], int(lens.max()))
        is_json = s.str.lstrip().str[:1].isin(["{", "["])
        json_rows[c] += int(is_json.sum())

        if c not in capped:
            values[c].update(s[filled & (lens <= 200)])
            if len(values[c]) > VALUE_CAP:
                capped.add(c)
                values[c] = Counter()

        for k, ids in base_ids.items():
            hit = s[filled & ~is_json].isin(ids)
            if hit.any():
                link_hits[(k, c)] += int(hit.sum())
                matched[k].update(s[filled & ~is_json][hit])

        if not is_json.any():
            continue
        js = s[is_json]
        for pairs in js.str.findall(PAIR_RE):
            for key, val in pairs:
                for k, ids in base_ids.items():
                    if val in ids:
                        link_hits[(k, f"{c}.{key}")] += 1
                        matched[k].add(val)
        for pairs in js.str.findall(EPOCH_RE):
            for key, val in pairs:
                lo, hi = epoch.get(key, (val, val))
                epoch[key] = (min(lo, val), max(hi, val))

        for idx, raw in js.items():
            f = fn[idx]
            if sampled[(c, f)] >= args.samples:
                continue
            try:
                obj = json.loads(raw)
            except ValueError:
                continue
            sampled[(c, f)] += 1
            acc = {}
            walk(obj, "", acc)
            for p, ex in acc.items():
                path_hits[(c, f, p)] += 1
                if ex not in (None, "", [], {}):
                    path_example.setdefault((c, f, p), str(ex)[:120])

    fn_rows.update(fn)
    if conv_col:
        for f, conv in zip(fn, chunk[conv_col]):
            fn_convs[f].add(conv)
    if ag_col:
        for f, a in zip(fn, chunk[ag_col]):
            fn_agents[f][a] += 1

    print(f"{n_rows:,} rows  {time.time() - t0:,.0f}s", flush=True)

print(f"done: {n_rows:,} rows in {time.time() - t0:,.0f}s")

