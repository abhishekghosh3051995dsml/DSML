parser = argparse.ArgumentParser()
parser.add_argument("--stage1", default=r"C:\Datascience\nora_l2l4\stage1_profile")
parser.add_argument("--stage2", default=r"C:\Datascience\nora_l2l4\stage2_taxonomy")
