def arg_text(rec, objs):
    for c in sorted(objs, key=lambda c: len(rec[c])):
        texts = [v for _, v in leaves(objs[c]) if isinstance(v, str) and len(v.split()) >= 3
                 and v.lstrip()[:1] not in ("{", "[") and parse_json(v) is None]
        if texts:
            cleaned = clean_instruction(max(texts, key=len))
            return cleaned[:300] or None
    return None


