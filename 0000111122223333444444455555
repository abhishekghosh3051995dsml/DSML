    for c, keys in ranked[1:]:
        if ts_score[(c, keys)] < 0.5 * ts_score[ranked[0]] or limit <= 0:
            break
        diff = (field_time(c, keys) - primary).abs().dropna()
        if len(diff) and (diff <= limit).mean() >= SECONDARY_ORDER_AGREE:
