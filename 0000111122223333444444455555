def bh(p):
    p = np.asarray(p, float)
    order = np.argsort(p)
    ranked = p[order] * len(p) / np.arange(1, len(p) + 1)
    q = np.minimum.accumulate(ranked[::-1])[::-1]
    out = np.empty_like(q)
    out[order] = np.minimum(q, 1.0)
    return out


def similarity(M):
    df = (M > 0).sum(-2, keepdims=True)
    X = np.log1p(M) * (np.log((1 + M.shape[-2]) / (1 + df)) + 1)
    norm = np.linalg.norm(X, axis=-1, keepdims=True)
    X = np.divide(X, norm, out=np.zeros_like(X), where=norm > 0)
    return X @ np.swapaxes(X, -1, -2)


def tool_test(M, rng, I, J):
    obs = similarity(M)[I, J]
    exceed, done = np.zeros(len(I)), 0
    while done < PERMUTATIONS:
        b = min(PERM_BATCH, PERMUTATIONS - done)
        order = rng.random((b,) + M.shape).argsort(-1)
        null = similarity(np.take_along_axis(np.broadcast_to(M, (b,) + M.shape), order, -1))
        exceed += (null[:, I, J] >= obs - 1e-12).sum(0)
        done += b
    p = (exceed + 1) / (PERMUTATIONS + 1)
    p[obs <= 1e-12] = 1.0
    return obs, p


def cooccurrence_test(rows, n_cols, rng, I, J):
    rows = [set(r) for r in rows if r]
    if len(rows) < 2:
        return np.zeros(len(I)), np.ones(len(I))

    def counts(rs):
        B = np.zeros((len(rs), n_cols))
        for r, cols in enumerate(rs):
            B[r, list(cols)] = 1
        return (B.T @ B)[I, J]

    def trade(rs):
        i, j = rng.choice(len(rs), 2, replace=False)
        a, b = rs[i] - rs[j], rs[j] - rs[i]
        if a and b:
            pool = list(a | b)
            rng.shuffle(pool)
            shared = rs[i] & rs[j]
            rs[i] = shared | set(pool[:len(a)])
            rs[j] = shared | set(pool[len(a):])

    obs = counts(rows)
    null_rows = [set(r) for r in rows]
    for _ in range(5 * len(rows)):
        trade(null_rows)
    null = []
    for _ in range(COOC_SAMPLES):
        for _ in range(len(rows)):
            trade(null_rows)
        null.append(counts(null_rows))
    null = np.array(null)
    mu, sd = null.mean(0), null.std(0)
    z = np.divide(obs - mu, sd, out=np.zeros_like(obs), where=sd > 0)
    p = np.where(sd > 0, norm.sf(z), np.where(obs > mu, 0.0, 1.0))
    return obs / np.maximum(mu, 1e-12), p


