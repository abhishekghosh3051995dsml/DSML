def normal_path(seqs):
    n = len(seqs)
    share, pos, owner = Counter(), defaultdict(list), defaultdict(Counter)
    for seq in seqs:
        first = {}
        for i, (o, s) in enumerate(seq):
            owner[s][o] += 1
            first.setdefault(s, i / max(len(seq) - 1, 1))
        for s, p in first.items():
            share[s] += 1
            pos[s].append(p)
    if not share:
        return [], set()
    thr = normal_threshold([v / n for v in share.values()])
    chosen = [s for s, v in share.items() if v / n >= thr]
    chosen.sort(key=lambda s: np.median(pos[s]))
    return [(owner[s].most_common(1)[0][0], s) for s in chosen], set(chosen)


def family_load(k, f):
    return sum(work.get((k, a), 0) for a in family_members[f])


def main_family(k, fams, core):
    first = {}
    for f in fams:
        vals = [first_info[(k, a)] for a in family_members[f] if a not in core and (k, a) in first_info]
        first[f] = min(vals, key=lambda v: v[1])
    earliest = min(first.values(), key=lambda v: v[1])
    if np.isnan(earliest[0]):
        tied = [f for f in fams if first[f][1] == earliest[1]]
    else:
        tied = [f for f in fams if first[f][0] == earliest[0]]
    return max(tied, key=lambda f: (family_load(k, f), -first[f][1]))


