        return {"actions": f"none (reply only): {numbered(roles)}" if roles else "none (reply only)",
                "n": 0, "agents": NONE, "tools": NONE, "apis": NONE,
                "x_tools": NONE, "x_apis": NONE, "why": NONE, "missing": NONE, "anomaly": "None"}
    agents_seen = []
    for r in seq:
        for a in (r[ACTOR], r["target"] if r["kind"] == "agent" else None):
            name = readable(a) if text(a) else ""
            if name and name not in agents_seen:
                agents_seen.append(name)
    tool_rows = [r for r in seq if r["kind"] == "tool"]
    tools = [f"{r['step']} ({agent_of(r)})" if agent_of(r) else r["step"] for r in tool_rows]
    apis = [api_of(r) for r in tool_rows]

    normal = plan_of.get(conv.at[k, "class_id"], set())
    extras = [(pos, r) for pos, r in enumerate(seq, 1) if r["step"] not in normal]
    x_tools = [f"{action_label(r)} – step {pos}" for pos, r in extras]
    x_apis = [api_of(r) for _, r in extras]

    why, last_note = [], None
    seen_steps = set()
    by_pos = {pos: r for pos, r in enumerate(seq, 1)}
    extra_pos = {pos for pos, _ in extras}
    for pos in range(1, len(seq) + 1):
        r = by_pos[pos]
        if pos in extra_pos and r["step"] not in seen_steps:
            seen_steps.add(r["step"])
            if r["kind"] == "agent" and text(r["arg"]):
                why.append(f"{r['step']} (step {pos}): NORA instruction to {readable(r['target'])}: \"{text(r['arg'])}\"")
            if last_note:
                why.append(f"{r['step']} (step {pos}): preceded by error on {last_note[1]} (step {last_note[0]}): "
                           f"\"{last_note[2]}\"")
                last_note = None
        if text(r["note"]):
            last_note = (pos, r["step"], text(r["note"]))
    why = list(dict.fromkeys(why))
    present = {r["step"] for r in seq}
    missing = [plan_label(o, st) for o, st in class_paths.get(conv.at[k, "class_id"], ([], set()))[0]
               if st not in present]
    anomaly = {(False, False): "None", (True, False): "Extra steps", (False, True): "Missing steps",
               (True, True): "Extra + Missing steps"}[(bool(extras), bool(missing))]
    return {"actions": numbered([action_label(r) for r in seq]), "n": len(seq),
            "agents": numbered(agents_seen), "tools": numbered(tools), "apis": numbered(apis),
            "x_tools": numbered(x_tools), "x_apis": numbered(x_apis),
            "why": numbered(why) if why else (NOT_RECORDED if extras else NONE),
            "missing": numbered(missing), "anomaly": anomaly}


