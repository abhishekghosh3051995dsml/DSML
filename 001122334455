def locate_csv(name):
    local = Path.cwd() / name
    if local.exists():
        return local
    roots = [p for p in Path.home().iterdir() if p.is_dir() and p.name.lower().startswith("onedrive")]
    hits = [f for root in roots for f in root.rglob(name)]
    if not hits:
        raise FileNotFoundError(f"{name} not found in {Path.cwd()} or under OneDrive")
    return max(hits, key=lambda f: f.stat().st_mtime)


def detect_format(path):
    for enc in ("utf-8-sig", "cp1252", "latin-1"):
        try:
            with open(path, encoding=enc, newline="") as fh:
                head = fh.read(64 * 1024)
            return enc, csv.Sniffer().sniff(head, delimiters=",;\t|").delimiter
        except (UnicodeDecodeError, csv.Error):
            continue
    return "latin-1", ","


