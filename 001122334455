def strip_phrases(text, phrases):
    words = re.findall(r"[A-Za-z][A-Za-z]+", text.lower())
    pairs = {p for p in phrases if " " in p}
    keep = [w for i, w in enumerate(words) if w not in phrases
            and f"{words[i - 1] if i else ''} {w}" not in pairs
            and f"{w} {words[i + 1] if i + 1 < len(words) else ''}" not in pairs]
    return " ".join(keep)


