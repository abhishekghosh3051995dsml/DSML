            "interaction_id": rec["Interaction ID"], "intent_l1": rec[L1_COL], "intent_l2": "", "intent_l4": "",
            "content": rec["User Content"],
            "context": {"issue": rec["Context - Issue"], "attributes": rec["Context - Attributes"],
                        "identifiers": rec["Context - Identifiers Used"]},
            "task_class": rec["Task Class"], "task_subclass": rec["Task Subclass"], "task_type": rec["Task Type"],
            "task_actions": [] if g is None else [
                {"step": int(x["Step"]), "agent": x["Agent"], "action": x["Task Action"], "type": x["Action Type"],
                 "api": x["API"], "inputs": x["Inputs"]} for x in g.to_dict("records")],
            "extra_task_actions": rec["Extra Task Actions"], "why_extra": rec["Why Extra Task Actions"],
        }, ensure_ascii=False) + "\n")

