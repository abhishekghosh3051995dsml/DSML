def context_tokens(obj, skip=()):
    out, seen = [], set()
    for keys, v in leaves(obj, max_depth=6):
        if not keys or keys[0] in skip or isinstance(v, (dict, list)) or v is None:
            continue
        key = ".".join(keys[-2:])
        s = str(v).strip()
        if not s:
            continue
        if NOISY_VALUE.search(s) or NUMERIC.match(s) or set(s) <= set("#*xX-"):
            typ, val = "id", ""
        elif len(s) > LEAF_MAX_LEN:
            typ, val = "text", ""
        else:
            typ, val = "cat", s.lower()
        tok = f"{key}\x1e{val}\x1e{typ}"
        if tok not in seen:
            seen.add(tok)
            out.append(tok)
    return "\x1f".join(out) or None


def arg_text(rec, objs):
    for c in sorted(objs, key=lambda c: len(rec[c])):
        texts = [v for _, v in leaves(objs[c]) if isinstance(v, str) and len(v.split()) >= 3
                 and v.lstrip()[:1] not in ("{", "[") and parse_json(v) is None]
        if texts:
            cleaned = clean_instruction(max(texts, key=len))
            return cleaned[:300] or None
    return None


def leaf_tokens(objs, action, actor):
    out = []
    seen = set()
    for c, obj in objs.items():
        for keys, v in leaves(obj):
            if not isinstance(v, (str, bool)):
                continue
            s = str(v).strip()
            if (not 0 < len(s) <= LEAF_MAX_LEN or s in (action, actor) or NOISY_VALUE.search(s)
                    or NUMERIC.match(s)):
                continue
            tok = f"{keys[-1] if keys else c}={s.lower()}"
            if tok not in seen:
                seen.add(tok)
                out.append(tok)
                if len(out) >= LEAF_CAP:
                    return "\x1f".join(out)
    return "\x1f".join(out)


