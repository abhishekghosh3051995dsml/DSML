def bh(p):
    p = np.asarray(p, float)
    order = np.argsort(p)
    ranked = p[order] * len(p) / np.arange(1, len(p) + 1)
    q = np.minimum.accumulate(ranked[::-1])[::-1]
    out = np.empty_like(q)
    out[order] = np.minimum(q, 1.0)
    return out


def similarity(M):
    df = (M > 0).sum(-2, keepdims=True)
    X = np.log1p(M) * (np.log((1 + M.shape[-2]) / (1 + df)) + 1)
    norm = np.linalg.norm(X, axis=-1, keepdims=True)
    X = np.divide(X, norm, out=np.zeros_like(X), where=norm > 0)
    return X @ np.swapaxes(X, -1, -2)


def families_from(M, rng):
    active = [i for i in range(len(specialists)) if M[i].sum() > 0]
    labels = {a: i for i, a in enumerate(specialists)}
    if len(active) < 2:
        return labels, []
    I, J = map(np.array, zip(*combinations(active, 2)))
    obs = similarity(M)[I, J]
    exceed, done = np.zeros(len(I)), 0
    while done < PERMUTATIONS:
        b = min(PERM_BATCH, PERMUTATIONS - done)
        order = rng.random((b,) + M.shape).argsort(-1)
        null = similarity(np.take_along_axis(np.broadcast_to(M, (b,) + M.shape), order, -1))
        exceed += (null[:, I, J] >= obs - 1e-12).sum(0)
        done += b
    p = (exceed + 1) / (PERMUTATIONS + 1)
    p[obs <= 1e-12] = 1.0
    q = bh(p)
    D = np.ones((len(specialists), len(specialists)))
    np.fill_diagonal(D, 0)
    D[I, J] = D[J, I] = q
    sub = D[np.ix_(active, active)]
    cut = fcluster(linkage(squareform(sub, checks=False), method="complete"), FAMILY_ALPHA, "distance")
    for i, c in zip(active, cut):
        labels[specialists[i]] = len(specialists) + int(c)
    shared = ((M[I] > 0) & (M[J] > 0)).sum(1)
    return labels, list(zip([specialists[i] for i in I], [specialists[j] for j in J], shared, obs, p, q))


