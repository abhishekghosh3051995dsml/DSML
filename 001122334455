def main_family(k, fams, core):
    first = {}
    for f in fams:
        vals = [first_info[(k, a)] for a in family_members[f] if a not in core and (k, a) in first_info]
        first[f] = min(vals, key=lambda v: v[1])
    earliest = min(first.values(), key=lambda v: v[1])
    if np.isnan(earliest[0]):
        tied = [f for f in fams if first[f][1] == earliest[1]]
    else:
        tied = [f for f in fams if first[f][0] == earliest[0]]
    return max(tied, key=lambda f: (family_load(k, f), -first[f][1]))


