def normal_path(seqs):
    n = len(seqs)
    share, pos, owner = Counter(), defaultdict(list), defaultdict(Counter)
    for seq in seqs:
        first = {}
        for i, (o, s) in enumerate(seq):
            owner[s][o] += 1
            first.setdefault(s, i / max(len(seq) - 1, 1))
        for s, p in first.items():
            share[s] += 1
            pos[s].append(p)
    if not share:
        return [], set()
    thr = normal_threshold([v / n for v in share.values()])
    chosen = [s for s, v in share.items() if v / n >= thr]
    chosen.sort(key=lambda s: np.median(pos[s]))
    return [(owner[s].most_common(1)[0][0], s) for s in chosen], set(chosen)


def family_load(k, f):
