        others = sorted(set(share) - core)
        keysets = {a: set(tool_keys[ag.map(lambda ags, a=a: a in ags).to_numpy()]) for a in others}
        med = {a: np.median([ags.index(a) for ags in ag if a in ags]) for a in others}
        parent = {a: a for a in others}
        for a, b in combinations(others, 2):
            if len(keysets[a] & keysets[b]) / len(keysets[a] | keysets[b]) >= AGENT_BLOCK_JACCARD:
