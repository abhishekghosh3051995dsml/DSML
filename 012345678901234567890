trigger_rows, trigger_feats, conv_evidence = [], [], defaultdict(dict)
leaf_by_key = steps[(steps.kind == "tool") & steps["leaves"].notna()]

for lab in labels_sorted:
    core = core_agents.get(lab)
    if not core:
        continue
    keys = conv.index[(conv[LABEL] == lab) & conv.has_steps]
    rows = leaf_by_key[leaf_by_key[KEY].isin(keys) & leaf_by_key[ACTOR].isin(core)]
    leaf_docs = (rows.assign(doc=[ "\x1f".join(f"{s}.{t}" for t in l.split("\x1f") if t)
                                  for s, l in zip(rows["step"], rows["leaves"])])
                 .groupby(KEY)["doc"].agg("\x1f".join).reindex(keys).fillna(""))
    mats, names = [], []
    msg_vec = CountVectorizer(binary=True, stop_words=sorted(STOP), min_df=MIN_SUPPORT, max_df=0.95,
                              token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z]+\b")
    leaf_vec = CountVectorizer(binary=True, lowercase=False, min_df=MIN_SUPPORT, max_df=0.95,
                               tokenizer=lambda s: [t for t in s.split("\x1f") if t], token_pattern=None)
    for vec, docs, prefix in ((msg_vec, conv.loc[keys, "input_message"], f"{MSG_FIELD}:"), (leaf_vec, leaf_docs, "")):
        try:
            mats.append(vec.fit_transform(docs))
            names += [prefix + f for f in vec.get_feature_names_out()]
        except ValueError:
            pass
    if not mats:
        continue
    X = hstack(mats).tocsr()
    names = np.array(names)
    for S in sorted(set(u for us in conv.loc[keys, "units"] for u in us)):
        y = conv.loc[keys, "units"].map(lambda us: S in us).to_numpy().astype(int)
        if y.sum() < MIN_SUPPORT or (1 - y).sum() < MIN_SUPPORT:
            continue
        Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=TEST_SIZE, stratify=y, random_state=SEED)
        folds = min(FOLDS, int(ytr.sum()), int((1 - ytr).sum()))
        cv_scores = {}
        if folds >= 2:
            skf = StratifiedKFold(folds, shuffle=True, random_state=SEED)
            for C in C_GRID:
                aucs = []
                for tr, va in skf.split(Xtr, ytr):
                    m = sparse_logit(C).fit(Xtr[tr], ytr[tr])
                    aucs.append(roc_auc_score(ytr[va], m.predict_proba(Xtr[va])[:, 1]))
                cv_scores[C] = (np.mean(aucs), np.std(aucs))
        C = max(cv_scores, key=lambda c: cv_scores[c][0]) if cv_scores else 1.0
        m = sparse_logit(C).fit(Xtr, ytr)
        p = m.predict_proba(Xte)[:, 1]
        test_auc = roc_auc_score(yte, p)
        full = sparse_logit(C).fit(X, y)
        coef = full.coef_[0]
        support = np.asarray(X.sum(0)).ravel()
        pos_hits = np.asarray(X[y == 1].sum(0)).ravel()
        lift = np.divide(pos_hits / y.sum(), support / len(y), out=np.zeros_like(coef), where=support > 0)
        good = np.where((coef > 0) & (support >= MIN_SUPPORT))[0]
        good = good[np.argsort(-coef[good])]
        trigger_rows.append({LABEL: lab, "agents": S, "conversations_with": int(y.sum()),
                             "conversations_without": int((1 - y).sum()), "C": C, "folds": folds,
                             "cv_auc_mean": round(cv_scores.get(C, (np.nan,))[0], 4),
                             "cv_auc_std": round(cv_scores.get(C, (np.nan, np.nan))[1], 4),
                             "test_auc": round(test_auc, 4),
                             "test_balanced_accuracy": round(balanced_accuracy_score(yte, p >= 0.5), 4),
                             "test_f1": round(f1_score(yte, p >= 0.5), 4),
                             "base_rate": round(y.mean(), 4),
                             "evidence": ", ".join(names[good[:TOP_TRIGGERS]]) if test_auc >= TRIGGER_MIN_AUC else ""})
        trigger_feats += [{LABEL: lab, "agents": S, "feature": names[i], "coef": round(coef[i], 4),
                           "conversations": int(support[i]), "with_agent": int(pos_hits[i]), "lift": round(lift[i], 3)}
                          for i in good]
        if test_auc >= TRIGGER_MIN_AUC and len(good):
            sub = X[:, good]
            for r, k in enumerate(keys):
                if y[r]:
                    present = sub[r].indices
                    if len(present):
                        conv_evidence[k][S] = ", ".join(names[good[present[:3]]])

