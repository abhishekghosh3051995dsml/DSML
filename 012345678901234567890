def text_patterns(docs):
    labels = np.full(len(docs), -1)
    names, scan = {}, []
    if sum(bool(d.strip()) for d in docs) < TEXT_MIN_DOCS:
        return labels, names, scan
    vec = TfidfVectorizer(stop_words=sorted(STOP), ngram_range=(1, 2), min_df=2, max_df=0.9, sublinear_tf=True,
                          token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z]+\b")
    try:
        X = vec.fit_transform(docs)
    except ValueError:
        return labels, names, scan
    terms = vec.get_feature_names_out()
    live = np.asarray(X.sum(1)).ravel() > 0
    Xr = X[live]
    k_max = min(TEXT_K_MAX, Xr.shape[0] // 10, Xr.shape[1] - 1)
    if Xr.shape[0] < TEXT_MIN_DOCS or k_max < 2:
        return labels, names, scan
    rng = np.random.default_rng(SEED)
    best = None
    warnings.filterwarnings("ignore", category=RuntimeWarning, module="sklearn")
    for k in range(2, k_max + 1):
        model = NMF(k, init="nndsvda", random_state=SEED, max_iter=600).fit(Xr)
        ref = model.transform(Xr).argmax(1)
        aris = []
        for b in range(BOOTSTRAPS):
            idx = rng.integers(0, Xr.shape[0], Xr.shape[0])
            m = NMF(k, init="nndsvda", random_state=SEED, max_iter=600).fit(Xr[idx])
            aris.append(adjusted_rand_score(ref, m.transform(Xr).argmax(1)))
        scan.append({"k": k, "stability_ari_mean": float(np.mean(aris)), "stability_ari_std": float(np.std(aris))})
        if best is None or np.mean(aris) > best[0]:
            best = (float(np.mean(aris)), k, model)
    W = best[2].transform(Xr)
    total = W.sum(1)
    dom = np.divide(W.max(1), total, out=np.zeros_like(total), where=total > 0)
    lab_live = np.where(dom >= TOPIC_DOMINANCE, W.argmax(1), -1)
    labels[np.where(live)[0]] = lab_live
    for t, row in enumerate(best[2].components_):
        picked, used = [], set()
        for term in terms[row.argsort()[::-1]]:
            words = set(term.split())
            if not words <= used:
                picked.append(term)
                used |= words
            if len(picked) == 3:
                break
        names[t] = " / ".join(picked)
    for s in scan:
        s["chosen"] = s["k"] == best[1]
    return labels, names, scan


