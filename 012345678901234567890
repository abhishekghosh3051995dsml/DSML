    for y, v in enumerate(vc["conversations"].values[::-1]):
        ax.text(v, y, f" {v:,}", va="center", fontsize=8, color="#333333")
    ax.set_xlabel("conversations")
    ax.set_title(f"{lab}: classes")
    for side in ("top", "right"):
        ax.spines[side].set_visible(False)
    fig.tight_layout()
    fig.savefig(OUT / f"classes_{re.sub(r'[^A-Za-z0-9]+', '_', lab)}.png", dpi=150)
    plt.close(fig)

