def evidence(k):
    lab = conv.at[k, LABEL]
    plan = class_paths.get(conv.at[k, "class_id"], ([], set()))[0]
    units = unit_of.get(lab, {})
    normal = {units.get(o) for o, _ in plan} | {units.get(calls_agent.get(s)) for _, s in plan}
    out = []
    for u in conv.at[k, "units"]:
        if u in normal:
            continue
        members = [a for a, x in units.items() if x == u]
        arg = next((first_arg.get((k, a)) for a in members if isinstance(first_arg.get((k, a)), str)), None)
        bits = [x for x in (arg, conv_evidence[k].get(u)) if x]
        if bits:
            out.append(f"{u} ← {' | '.join(bits)}")
    return "; ".join(out)


