def text_of(v, limit=500):
    """Readable text of a logged value: JSON is flattened to its text parts; whitespace collapsed; cut to `limit` characters."""
    if not has_value(v):
        return None
    d = parse_json(v)
    if isinstance(d, (dict, list)):
        parts = [f"{k}: {x}" for k, x in leaves(d if isinstance(d, dict) else {"value": d}).items() if has_value(x)]
        t = " | ".join(parts) if parts else str(v)
    else:
        t = str(v)
    t = re.sub(r"\s+", " ", t).strip()
    return (t[:limit - 1] + "…") if len(t) > limit else t


USER_ROLES, BOT_ROLES = {"user", "human", "customer", "humanmessage"}, {"assistant", "ai", "aimessage", "bot"}
BODY_KEYS = ("content", "text", "message", "msg", "query", "question")


def turns(v):
    """[(role, text)] of a logged conversation: items with a role ('role' / 'type' / 'sender') and a body, the body directly in
    the item or one level down (e.g. {"type": "user", "data": {"content": ...}})."""
    d = parse_json(v) if isinstance(v, str) else (v if isinstance(v, (dict, list)) else None)
    out = []

    def body_of(o):
        for holder in [o] + [o[k] for k in ("data", "kwargs") if isinstance(o.get(k), dict)]:
            b = next((holder[k] for k in BODY_KEYS if k in holder and has_value(holder[k])), None)
            if b is not None:
                return b if isinstance(b, str) else json.dumps(b, default=str)
        return None

    def walk(o, depth=0):
        if depth > 8:
            return
        if isinstance(o, dict):
            role = str(o.get("role", o.get("type", o.get("sender", "")))).lower()
            if role in USER_ROLES | BOT_ROLES:
                b = body_of(o)
                if b is not None:
                    out.append(("user" if role in USER_ROLES else "assistant", b))
                    return
            for v_ in o.values():
                walk(v_, depth + 1)
        elif isinstance(o, list):
            for v_ in o:
                walk(v_, depth + 1)
    walk(d)
    return out


# the input of each interaction, exactly as logged: the first row that is not a call and has an input (e.g. the user's message)
def user_texts(v):
    """All messages written by the user inside a logged conversation, in order."""
    return [t for r, t in turns(v) if r == "user"]


def user_text(v):
    """The first message written by the user inside a logged conversation; otherwise the readable text."""
    found = user_texts(v)
    return text_of(found[0], 32000) if found else text_of(v)


