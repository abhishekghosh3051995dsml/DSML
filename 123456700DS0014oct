def write_book(path, sheets, notes):
    with pd.ExcelWriter(path, engine="openpyxl") as xw:
        for name, frame in sheets.items():
            frame = frame if len(frame.columns) else pd.DataFrame({"Note": ["nothing found in this data"]})
            frame = frame.map(lambda v: ILLEGAL_CHARACTERS_RE.sub("", v)[:32000] if isinstance(v, str) else v)
            if notes:                                                       # main workbook: an empty cell shows '—' (none), so long text next to it cannot spill into it
                frame = frame.astype(object).where(frame.notna() & frame.ne(""), "—")
            frame.to_excel(xw, sheet_name=name[:31], index=False)
    wb = load_workbook(path)
    for ws in wb.worksheets:
        ws.freeze_panes = "B2"
        ws.auto_filter.ref = ws.dimensions
        ws.sheet_view.showGridLines = False
        cols = [c.value for c in ws[1]]
        for j, name in enumerate(cols, start=1):
            cell = ws.cell(1, j)
            cell.font, cell.fill = Font(bold=True, color="FFFFFF"), HEAD
            cell.alignment = Alignment(vertical="center", wrap_text=True)
            if notes and name in GUIDE.get(ws.title, {}):
                cm = Comment(f"{GUIDE[ws.title][name][0]}\n\nMethod: {GUIDE[ws.title][name][1]}", "NORA version 1.8")
                cm.width, cm.height = 320, 140
                cell.comment = cm
            w = max(len(str(ws.cell(i, j).value or "")) for i in range(1, ws.max_row + 1))
            ws.column_dimensions[cell.column_letter].width = WIDE.get(name, max(11, min(70, w + 2)))
        ws.row_dimensions[1].height = 32
        wrap = ws.title in ("Guide", "Column_Guide")                              # short texts: wrapped, row height set from the text
        for r, row in enumerate(ws.iter_rows(min_row=2), start=2):
            if wrap:
                ws.row_dimensions[r].height = 15 * max(1, max(-(-len(str(c_.value or "")) // max(1, int(ws.column_dimensions[c_.column_letter].width) - 2)) for c_ in row))
            for j, cell in enumerate(row):
                cell.border = LINE
                cell.alignment = Alignment(wrap_text=wrap, vertical="top")
                if r % 2 == 0:
                    cell.fill = BAND
                if cols[j] in PERCENT and isinstance(cell.value, (int, float)):
                    cell.number_format = "0.0%"
                elif isinstance(cell.value, int):
                    cell.number_format = "#,##0"
    wb.save(path)


