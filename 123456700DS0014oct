def list_lengths(v, limit=40):
    """Lengths of the lists inside a logged result (path -> number of items), for lists with 2 or more items."""
    d = parse_json(v) if isinstance(v, str) else None
    out = {}

    def walk(o, path, depth):
        if len(out) >= limit or depth > 4:
            return
        if isinstance(o, dict):
            for k_, v_ in o.items():
                walk(v_, f"{path}.{k_}" if path else str(k_), depth + 1)
        elif isinstance(o, list):
            if len(o) >= 2:
                out[path or "(list)"] = max(out.get(path or "(list)", 0), len(o))
            for v_ in o[:3]:
                walk(v_, path, depth + 1)
    walk(d, "", 0)
    return out


