def json_fields(o, path=(), depth=0):
    if depth > 12:
        return
    if isinstance(o, dict):
        for k, x in o.items():
            if str(k).lower() not in (MSG_KEY, "messages"):                     # the conversation is read above
                yield from json_fields(x, path + (str(k),), depth + 1)
    elif isinstance(o, list):
        for x in o:
            yield from json_fields(x, path, depth + 1)
    else:
        inner = parse_json(o) if isinstance(o, str) else None
        if inner is not None:
            yield from json_fields(inner, path, depth + 1)
        elif has_value(o):
            yield ".".join(path), o


