# ================= CLASSES -> VARIANTS: the conditional branches each interaction took =================
#   Principle (trace clustering + decision mining): interactions belong together when they did the same kind of work -
#   the same SET of tasks; how many times a task ran (loops, retries) never splits a group.
#   Class   = the experts the orchestrator handed work to (unchanged).
#   Variant = class + the conditional branches taken: calls outside the class plan that (a) have a trigger proven in the logs
#             (an earlier result or the input; Fisher + BH) and (b) occur in at least k interactions of the class but not in all.
#             Groups smaller than k join the most similar variant. Branches without a proven trigger never split - they are
#             reported as unexplained.
PROVEN = {t for t in TRIG if TRIG[t]["out"] or TRIG[t]["in"]}


def trigger_label(t):
    i_ = TRIG.get(t)
    if not i_:
        return f"too rare to test (< {args.folds} interactions)"
    if i_["out"]:
        _, tk, a_, b_, q = max(i_["out"])
        return f"when the result{src_of(tk)} has {tk} ({a_:.0%} vs {b_:.0%})"
    if i_["in"]:
        _, tk, a_, b_, q = max(i_["in"])
        return (f"when the request has {tk}" if " = " in tk else f"when the input mentions '{tk}'") + f" ({a_:.0%} vs {b_:.0%})"
    return "no trigger found in the logged data"


def trig_tag(t):
    """The data behind an extra call: ' ← <API>: <field> = <value>' (earlier result) or " ← input: '<word>'"; empty when none."""
    i_ = TRIG.get(t)
    if not i_:
        return ""
    if i_["out"]:
        _, tk, a_, b_, q = max(i_["out"])
        k_, _, v_ = tk.partition("=")
        s_ = TOK_SRC.get(tk)
        return f" ← {s_.most_common(1)[0][0] if s_ else '?'}: {k_} = {v_}"
    if i_["in"]:
        _, tk, a_, b_, q = max(i_["in"])
        return f" ← {tk}" if " = " in tk else f" ← input: '{tk}'"
    return ""


def trigger_plain(t):
    """Why an extra call is made, in plain words (no numbers): the earlier result or the input that comes with it."""
    i_ = TRIG.get(t)
    if not i_:
        return "too rare to check (fewer than 5 interactions make this call)"
    if i_["out"]:
        _, tk, a_, b_, q = max(i_["out"])
        k_, _, v_ = tk.partition("=")
        s_ = TOK_SRC.get(tk)
        return f"because the result of {s_.most_common(1)[0][0] if s_ else 'an earlier call'} showed {k_} = {v_}"
    if i_["in"]:
        _, tk, a_, b_, q = max(i_["in"])
        return f"because the request has {tk}" if " = " in tk else f"because the customer's message mentions '{tk}'"
    return "reason not visible in the logs"


