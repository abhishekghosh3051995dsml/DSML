def explain_v17(c):
    row = CNT.loc[c]
    row = row[row > 0]
    ref = REF[VAR[c]]
    allt = row.index.union(ref.index)
    d_ = (row.reindex(allt, fill_value=0) - ref.reindex(allt, fill_value=0))
    d_ = d_[d_ != 0]
    total, ref_t = int(row.sum()), int(ref.sum())
    if d_.empty:
        return total, ref_t, f"{total} = {ref_t}"
    parts = []
    for t in sorted(d_.index, key=lambda t: (-abs(d_[t]), DISP_T[t])):
        dv = int(d_[t])
        if ref.get(t, 0) == 0:
            kind = "" if t in PLAN_T[c] else trig_tag(t)
        elif row.get(t, 0) == 0:
            kind = ""
        else:
            r_ = int(RET_OF.get(c, pd.Series(dtype=int)).get(t, 0))
            kind = (f" · {LOOP_TAG[t]}" if t in LOOP_TAG and dv > 0 else "")
        parts.append(f"{DISP_T[t]} {dv:+d}{kind}")
    shown, rest = parts[:8], int(d_.sum() - sum(int(d_[t]) for t in sorted(d_.index, key=lambda t: (-abs(d_[t]), DISP_T[t]))[:8]))
    txt = f"{total} = {ref_t} " + "  ".join(shown) + (f"  others {rest:+d}" if len(parts) > 8 else "")
    return total, ref_t, txt


