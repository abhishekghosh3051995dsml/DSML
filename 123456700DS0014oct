def decomposition(label):
    """Readable executable plan of a class: standard plan, then each hand-off (in the order seen in the class) and the APIs it brings."""
    mem = FINAL["members"][label]
    hos = [t for t in FINAL["driving"] if label != NONE_LABEL and t in label.split(" + ")]
    hos = sorted(hos, key=lambda t: (np.median([HO_FIRST[(c, t)] for c in mem if (c, t) in HO_FIRST] or [np.inf]), t))
    parts = [f"Standard plan ({len(FINAL['std']['tasks'])} tasks)"]
    n_tasks = len(FINAL["std"]["tasks"])
    for t in hos:
        sub = [x for x in FINAL["subs"][t]["tasks"] if TASK_API[x] != t]
        n_tasks += len(FINAL["subs"][t]["tasks"])
        by_agent = defaultdict(list)
        for x in sub:
            by_agent[TASK_AGENT[x]].append(TASK_API[x])
        parts.append(f"{t} → " + "; ".join(f"{a}: {', '.join(v)}" for a, v in sorted(by_agent.items())) if by_agent else t)
    own = FINAL["cls"].get(label, [])
    if own:
