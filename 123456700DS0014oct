NUMLIKE = re.compile(r"\d{6,}")


def out_tokens(v, limit=80):
    d = parse_json(v) if isinstance(v, str) else None
    toks = []

    def walk(o, key, depth):
        if len(toks) >= limit or depth > 4:
            return
        if isinstance(o, dict):
            for k_, v_ in o.items():
                walk(v_, str(k_), depth + 1)
        elif isinstance(o, list):
            for v_ in o[:20]:
                walk(v_, key, depth + 1)
        elif key and o is not None and not isinstance(o, float):
            t_ = str(o).strip()
            if 0 < len(t_) <= 30 and not NUMLIKE.search(t_):
                toks.append(f"{key}={t_}".lower())
    walk(d, "", 0)
    return set(toks)


