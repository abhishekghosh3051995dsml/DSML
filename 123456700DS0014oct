def cramers_v(tab):
    """Bias-corrected Cramer's V (Bergsma 2013)."""
    chi2 = chi2_contingency(tab, correction=False)[0]
    n_ = tab.values.sum()
    r_, k_ = tab.shape
    phi2 = max(0.0, chi2 / n_ - (k_ - 1) * (r_ - 1) / (n_ - 1))
    rc, kc = r_ - (r_ - 1) ** 2 / (n_ - 1), k_ - (k_ - 1) ** 2 / (n_ - 1)
    return float(np.sqrt(phi2 / max(min(rc - 1, kc - 1), 1e-12))) if min(rc, kc) > 1 else np.nan


