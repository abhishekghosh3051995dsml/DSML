def _merge_inference_config_v57(runtime: ConfigV57, bundle: PipelineBundleV57) -> ConfigV57:
    """Use training-time model/quality configuration at inference.

    Paths, mode/profile and runtime pseudonym settings remain runtime-controlled;
    model semantics remain locked to the saved training bundle.
    """
    data = asdict(runtime)
    runtime_only = {"input_path", "outdir", "mode", "model_dir", "profile", "sample_rows", "pseudonym_key_env", "persist_model", "fail_on_business_readiness"}
    for k, v in dict(getattr(bundle, "config", {}) or {}).items():
        if k in data and k not in runtime_only:
            data[k] = v
    data["input_path"] = runtime.input_path
    data["outdir"] = runtime.outdir
    data["mode"] = runtime.mode
    data["model_dir"] = runtime.model_dir
    data["profile"] = runtime.profile
    data["sample_rows"] = runtime.sample_rows
    data["pseudonym_key_env"] = runtime.pseudonym_key_env
    data["persist_model"] = runtime.persist_model
    data["fail_on_business_readiness"] = runtime.fail_on_business_readiness
    data["ontology_path"] = None
    return ConfigV57(**data)


