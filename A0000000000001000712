def _apply_matches(value,matches):
    merged=[]
    for s,e,label in sorted(matches,key=lambda x:(x[0],-(x[1]-x[0]))):
        if e<=s:continue
        if merged and s<merged[-1][1]:
            ps,pe,pl=merged[-1]
            if e>pe:merged[-1]=(ps,e,pl)
            continue
        merged.append((s,e,label))
    out=value
    for s,e,label in reversed(merged):out=out[:s]+f" [REDACTED_{label.upper()}] "+out[e:]
    return normalize_space(out)
