def normalize_problem_clause(text: str, model: ProblemNormalizerModel) -> Tuple[str, float, str]:
    surface, conf, method = _normalize_problem_clause_v57_base(text, model)
    canonical = canonicalize_surface_v571(surface)
    if canonical and canonical != normalize_term(surface):
