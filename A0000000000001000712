        if et and name:
            toks.append(f"entity_{et}_{name}"); pairs.append(f"{et}_{name}")
    vals = sorted(set(pairs))[:12]
    for i, a in enumerate(vals):
        for b in vals[i + 1:]:
            toks.append(f"epair_{a}__{b}")
    return " ".join(toks) if toks else "entity_profile_none"


def _relation_motif_signature_v57(r):
    toks, preds = [], []
    for rel in r.get("relationships", []):
