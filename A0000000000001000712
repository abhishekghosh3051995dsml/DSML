    for a, b in zip(preds, preds[1:]):
        toks.append(f"rtransition_{a}__{b}")
    return " ".join(toks) if toks else "relation_motif_none"


def _fit_lens_representation_v57(docs, seed):
    vec = TfidfVectorizer(ngram_range=(1, 2), min_df=1, max_df=.995, sublinear_tf=True, norm="l2", token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_]{1,}\b")
    x = _fit_vectorizer_with_fallback(vec, [str(d) if str(d).strip() else "none" for d in docs])
    nc = min(32, x.shape[0] - 1, x.shape[1] - 1)
    svd = None
    if nc >= 2:
        svd = TruncatedSVD(n_components=nc, random_state=seed, n_iter=7); z = svd.fit_transform(x)
    else:
        z = x.toarray()
    norm = Normalizer(copy=False); z = norm.fit_transform(np.asarray(z, dtype=np.float32))
    return vec, svd, norm, np.asarray(z, dtype=np.float32)


def _transform_lens_v57(model: LensModelV57, docs):
    x = model.vectorizer.transform([str(d) if str(d).strip() else "none" for d in docs])
    z = model.svd.transform(x) if model.svd is not None else x.toarray()
    return np.asarray(model.normalizer.transform(np.asarray(z, dtype=np.float32)), dtype=np.float32)


def _lens_descriptions_v57(docs, labels, topn=6):
    out = {}; labels = np.asarray(labels, dtype=int)
    for cid in sorted(set(labels.tolist())):
        cnt = Counter()
        for i in np.flatnonzero(labels == cid).tolist():
            cnt.update(str(docs[i]).split())
        terms = [t for t, _ in cnt.most_common(topn) if t and not t.endswith("_none")]
        out[int(cid)] = " / ".join(terms[:4]) if terms else f"cluster_{cid}"
    return out


def fit_structural_lens_v57(dev_records, name, c: ConfigV57):
    if name == "workflow": builder = _workflow_signature_v57; maxk = c.workflow_max_clusters
    elif name == "entity_profile": builder = _entity_profile_signature_v57; maxk = c.entity_profile_max_clusters
    elif name == "relation_motif": builder = _relation_motif_signature_v57; maxk = c.relation_motif_max_clusters
    else: raise ValueError(name)
    docs = [builder(r) for r in dev_records]
    seed = stable_seed(name, c.seed)
    vec, svd, norm, z = _fit_lens_representation_v57(docs, seed)
    support = max(2, len(z) // max(2, c.structural_lens_min_cluster_size)); upper = min(maxk, support, len(z) - 1)
    if upper < 2:
        return None, np.ones(len(z), dtype=int), pd.DataFrame(), docs
    rows, store = [], {}
    for k in range(2, upper + 1):
        try:
            est = make_context_partitioner(k, seed + k, len(z))
            raw = np.asarray(est.fit_predict(z), dtype=int); pub, _, _ = _normalise_cluster_ids(raw, z); cnt = Counter(pub.tolist())
            sil = safe_silhouette(z, pub, c.seed); stab = _partition_stability_v57(z, k, seed + 1701, max(3, min(c.stability_repeats, 6))); ent = cluster_entropy(pub); minsize = min(cnt.values()) if cnt else 0; largest = max(cnt.values()) / len(pub) if cnt else 1
            rows.append({"k": k, "silhouette": sil, "stability_ari": stab, "balance_entropy": ent, "min_cluster_size": minsize, "largest_cluster_share": largest}); store[k] = pub
        except Exception:
            pass
    tab = pd.DataFrame(rows)
    if tab.empty:
        return None, np.ones(len(z), dtype=int), tab, docs
    tab["rank_silhouette"] = _safe_rank_v57(tab["silhouette"], True); tab["rank_stability"] = _safe_rank_v57(tab["stability_ari"], True); tab["rank_balance"] = _safe_rank_v57(tab["balance_entropy"], True)
    tab["valid"] = (tab["min_cluster_size"] >= max(3, int(.55 * c.structural_lens_min_cluster_size))) & (tab["largest_cluster_share"] <= .80)
    tab["score"] = .50 * tab["rank_silhouette"] + .30 * tab["rank_stability"] + .20 * tab["rank_balance"]
    eligible = tab[tab["valid"]] if bool(tab["valid"].any()) else tab
    k = int(eligible.sort_values(["score", "stability_ari"], ascending=False).iloc[0]["k"])
    labels = store[k]; cents = {}
    for cid in sorted(set(labels.tolist())):
        idx = np.flatnonzero(labels == cid); cent = np.asarray(z[idx].mean(axis=0), dtype=np.float32); cent = cent / max(float(np.linalg.norm(cent)), 1e-12); cents[int(cid)] = cent
    desc = _lens_descriptions_v57(docs, labels)
    model = LensModelV57(name, vec, svd, norm, cents, desc, k, tab[tab["k"] == k].iloc[0].to_dict())
    return model, labels, tab.sort_values(["valid", "score"], ascending=[False, False]).reset_index(drop=True), docs


def predict_structural_lens_v57(model, records):
    if model is None:
        return np.ones(len(records), dtype=int), np.ones(len(records), dtype=float)
    builder = {"workflow": _workflow_signature_v57, "entity_profile": _entity_profile_signature_v57, "relation_motif": _relation_motif_signature_v57}[model.name]
    z = _transform_lens_v57(model, [builder(r) for r in records]); ids = sorted(model.centroid_vectors); mat = np.vstack([model.centroid_vectors[i] for i in ids]); s = np.asarray(z @ mat.T, dtype=float); j = np.argmax(s, axis=1)
    return np.asarray([ids[int(x)] for x in j], dtype=int), np.asarray([s[i, int(j[i])] for i in range(len(j))], dtype=float)


