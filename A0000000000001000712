def _partition_stability_v57(v: np.ndarray, k: int, seed: int, repeats: int) -> float:
    if len(v) < max(10, k * 2) or repeats < 2:
        return 0.0
    labs = []
    for r in range(repeats):
        try:
            est = make_context_partitioner(k, seed + 7919 * r, len(v))
            labs.append(np.asarray(est.fit_predict(v), dtype=int))
        except Exception:
            pass
    vals = []
    for i in range(len(labs)):
        for j in range(i + 1, len(labs)):
            vals.append(float(adjusted_rand_score(labs[i], labs[j])))
    return float(np.mean(vals)) if vals else 0.0


def _align_run_to_reference_v57(reference: np.ndarray, run: np.ndarray) -> np.ndarray:
    reference = np.asarray(reference, dtype=int)
    run = np.asarray(run, dtype=int)
    rids = sorted(set(reference.tolist()))
    uids = sorted(set(run.tolist()))
    mat = np.zeros((len(rids), len(uids)), dtype=int)
    ri = {v: i for i, v in enumerate(rids)}
    ui = {v: i for i, v in enumerate(uids)}
    for a, b in zip(reference.tolist(), run.tolist()):
        mat[ri[a], ui[b]] += 1
    rows, cols = linear_sum_assignment(-mat)
    mapping = {uids[c]: rids[r] for r, c in zip(rows.tolist(), cols.tolist())}
    return np.asarray([mapping.get(int(x), int(x)) for x in run], dtype=int)


def consensus_stability_profile_v57(v: np.ndarray, reference: np.ndarray, k: int, seed: int, repeats: int):
    reference = np.asarray(reference, dtype=int)
    if len(reference) == 0:
        return np.zeros(0), {}, 0.0
    agreements = np.zeros(len(reference), dtype=float)
    completed = 0
    for r in range(max(2, repeats)):
        try:
            est = make_context_partitioner(k, seed + 12347 * (r + 1), len(v))
            lab = np.asarray(est.fit_predict(v), dtype=int)
            aligned = _align_run_to_reference_v57(reference, lab)
            agreements += (aligned == reference).astype(float)
            completed += 1
        except Exception:
            pass
    if completed == 0:
        return np.zeros(len(reference)), {}, 0.0
    scores = agreements / completed
    per = {int(cid): float(np.mean(scores[reference == cid])) for cid in sorted(set(reference.tolist()))}
    return scores, per, float(np.mean(scores))


