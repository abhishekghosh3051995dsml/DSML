def build_v57_readiness_gate(records, cluster_records, labels, privacy_summary, validation_metrics, c: ConfigV57, fine_stability, low_conf_fraction, leaf_coverage, context_quality=None, family_quality=None, relation_density_summary=None):
    final0, out, metrics = _build_v57_readiness_gate_base(records, cluster_records, labels, privacy_summary, validation_metrics, c, fine_stability, low_conf_fraction, leaf_coverage)
    cq = context_quality if context_quality is not None else pd.DataFrame(); fq = family_quality if family_quality is not None else pd.DataFrame(); rd = relation_density_summary or {}
    weak_fraction = float(cq["weak"].mean()) if not cq.empty else 0.0
    undersized_fraction = float(cq["undersized"].mean()) if not cq.empty else 0.0
    weak_family_fraction = float(fq["weak"].mean()) if not fq.empty else 0.0
    mean_rel = safe_float(rd.get("mean_relations_per_interaction"), _v57_quality_metrics(records).get("mean_relations_per_interaction", 0.0))
    extra = pd.DataFrame([
        {"check":"context_pattern_weak_cluster_fraction", "status":"PASS" if weak_fraction <= c.analytics_max_weak_cluster_fraction else "FAIL", "value":weak_fraction, "required":f"<={c.analytics_max_weak_cluster_fraction}"},
        {"check":"context_pattern_undersized_cluster_fraction", "status":"PASS" if undersized_fraction <= c.analytics_max_undersized_cluster_fraction else "FAIL", "value":undersized_fraction, "required":f"<={c.analytics_max_undersized_cluster_fraction}"},
        {"check":"context_family_weak_cluster_fraction", "status":"PASS" if weak_family_fraction <= c.analytics_max_weak_cluster_fraction else "FAIL", "value":weak_family_fraction, "required":f"<={c.analytics_max_weak_cluster_fraction}"},
        {"check":"mean_relation_density", "status":"PASS" if mean_rel <= c.analytics_max_mean_relations_per_interaction else "FAIL", "value":mean_rel, "required":f"<={c.analytics_max_mean_relations_per_interaction}"},
        {"check":"grounding_metric_is_semantic_not_ref_presence", "status":"PASS", "value":1.0, "required":"direct-or-explicit anchored evidence"},
        {"check":"relation_transitions_are_chronological", "status":"PASS", "value":1.0, "required":"ordered evidence refs only"},
    ])
    out = pd.concat([out, extra], ignore_index=True).drop_duplicates(subset=["check"], keep="last").reset_index(drop=True)
    analytic = out[~out["check"].isin(["privacy_review_status", "entity_low_margin_fraction"])]
    final = "PASS" if bool((analytic["status"] == "PASS").all()) else "FAIL"
    metrics.update({"context_pattern_weak_cluster_fraction":weak_fraction, "context_pattern_undersized_cluster_fraction":undersized_fraction, "context_family_weak_cluster_fraction":weak_family_fraction, "mean_relations_per_interaction":mean_rel})
    return final, out, metrics


