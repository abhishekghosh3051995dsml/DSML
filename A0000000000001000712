def _v71_round(value, places=3):
    try:
        return round(float(value), places)
    except (TypeError, ValueError):
        return value


def _v71_grid(value):
    if isinstance(value, (list, tuple)):
        return ", ".join(str(int(x)) if float(x).is_integer() else str(_v71_round(x)) for x in value)
    return value if value is not None else "n/a"


def _v71_engine_card(engine: dict, purity: dict | None) -> str:
    rows = [
        f"<b>Context-pattern engine:</b> {engine.get('context_pattern_engine')}",
        f"<b>Neighbour grid searched:</b> {_v71_grid(engine.get('neighbor_grid'))}",
        f"<b>Resolution grid searched:</b> {_v71_grid(engine.get('resolution_grid'))}",
        f"<b>Ensemble members built:</b> {engine.get('ensemble_members')}",
        f"<b>Selected graph:</b> neighbours={engine.get('selected_k_neighbors')}, "
        f"resolution={_v71_round(engine.get('selected_resolution'))}",
        f"<b>Deployed refit resolution:</b> {_v71_round(engine.get('refit_resolution'))}",
        f"<b>Context patterns deployed:</b> {engine.get('context_patterns')}",
        "<b>Assignment coverage:</b> every clusterable interaction receives a context pattern",
        f"<b>Secondary layers:</b> {engine.get('secondary_layer_partitioner')}",
    ]
    if purity:
        total = int(purity.get("patterns_total") or 0)
        meeting = total - int(purity.get("patterns_below_floor") or 0)
        rows += [
            f"<b>Consensus purity gate:</b> {purity.get('status')}",
            f"<b>Mean internal consensus support:</b> {purity.get('mean_internal_consensus')}",
            f"<b>Weakest pattern support:</b> {purity.get('weakest_cluster_support')}",
            f"<b>Patterns meeting the {purity.get('support_floor')} support floor:</b> "
            f"{meeting} of {total}",
        ]
    return ("<h2>Context-pattern clustering engine</h2><div class='card'>" + "<br>".join(rows) +
            "</div><p>Each interaction is placed on a shared-nearest-neighbour graph whose edges "
            "carry the Jaccard overlap of the two neighbour sets, and Leiden community detection "
            "partitions that graph. The grid above is run end to end for every neighbour count, "
            "resolution and seed, and the resulting partitions are combined through a "
            "co-association consensus, so a pattern is kept where independent runs agree on it. "
            "Consensus support measures that agreement inside each pattern and is reported per "
            "pattern in diagnostics/context_pattern_consensus_purity.csv.</p>")


def _v71_write_narrative(outdir: Path, engine: dict, purity: dict | None):
    for stem in (_V71_BASE_STEM, _V71_STEM):
        path = outdir / "executive" / f"{stem}_summary.html"
        if not path.exists():
            continue
        html = path.read_text(encoding="utf-8")
        html = re.sub(r"<title>[^<]*</title>", "<title>NORA Entity-Context v7.1</title>", html)
        html = re.sub(r"<h1>[^<]*</h1>", f"<h1>{_V71_TITLE}</h1>", html)
        html = re.sub(r"<div class='ok'><b>V5\.7\.2 final fixes:</b>.*?</div>",
                      _V71_QUALITY_BANNER, html, flags=re.S)
        html = re.sub(r"<h2>Structured dictionary output</h2><p>Each interaction carries participants, accepted entities and review candidates, context mentions and context facts, diagnostic evidence, RCA and remediation, evidence-grounded typed relations, full-coverage context-pattern assignments, and independent structural lenses.</p>",
                      _V71_DICTIONARY_PARAGRAPH, html, flags=re.S)
        html = re.sub(r"<h2>Method</h2><p>.*?</p>", _V71_METHOD_PARAGRAPH, html, flags=re.S)
        html = html.replace("<b>V5.7.2 ownership contract:</b>", "<b>Ownership contract:</b>")
        card = _v71_engine_card(engine, purity)
        anchor = html.find("<h2>")
        html = (html[:anchor] + card + html[anchor:]) if anchor > 0 else html.replace(
            "</body></html>", card + "</body></html>")
        path.write_text(html, encoding="utf-8")


def _v71_name_artifacts(outdir: Path):
    for src in sorted(outdir.rglob(f"{_V71_BASE_STEM}*")):
        dst = src.with_name(src.name.replace(_V71_BASE_STEM, _V71_STEM))
        if dst.exists():
            dst.unlink()
        src.rename(dst)
    for path in sorted(outdir.rglob("*.json")) + sorted(outdir.rglob("*.html")):
        text = path.read_text(encoding="utf-8")
        renamed = text.replace(_V71_BASE_STEM, _V71_STEM)
        if renamed != text:
            path.write_text(renamed, encoding="utf-8")
    manifest_path = outdir / "model_manifest.json"
    if not manifest_path.exists():
        return
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    manifest["pipeline"] = PIPELINE_NAME
    manifest["pipeline_version"] = PIPELINE_VERSION
    manifest["artifact_format"] = ARTIFACT_FORMAT_VERSION
    for key, path in (("model", outdir / f"{_V71_STEM}_model.joblib"),
                      ("report", outdir / f"{_V71_STEM}_report.json"),
                      ("dictionary_json", outdir / f"{_V71_STEM}_dictionary.json"),
                      ("dictionary_jsonl", outdir / f"{_V71_STEM}_dictionary.jsonl")):
        if not path.exists():
            continue
        slot = manifest.setdefault("artifacts", {}).setdefault(key, {})
        slot["model_file" if key == "model" else "file"] = path.name
        slot["model_sha256" if key == "model" else "sha256"] = sha256_file(path)
    summary = outdir / "executive" / f"{_V71_STEM}_summary.html"
    if summary.exists():
        slot = manifest.setdefault("artifacts", {}).setdefault("html", {})
        slot["file"] = f"executive/{_V71_STEM}_summary.html"
        slot["sha256"] = sha256_file(summary)
    manifest_path.write_text(json.dumps(to_plain(manifest), indent=2, ensure_ascii=False),
                             encoding="utf-8")


_v71_core_train = run_train_v572
_v71_core_infer = run_inference_v572


def run_train_v572(c: ConfigV71):
    report = _v71_core_train(c)
    outdir = Path(c.outdir)
    _v71_write_narrative(outdir, report.get("clustering_engine") or {},
                         report.get("consensus_purity"))
    _v71_name_artifacts(outdir)
    path = outdir / f"{_V71_STEM}_report.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else report


def run_inference_v572(c: ConfigV71):
    report = _v71_core_infer(c)
    outdir = Path(c.outdir)
    _v71_name_artifacts(outdir)
    path = outdir / f"{_V71_STEM}_inference_report.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else report


