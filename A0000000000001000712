def canonicalize_surface_v571(text: Any) -> str:
    """Conservative lexical normalization for analytic surfaces only.

    It standardizes orthographic variants and a small set of unambiguous
    inflections. Raw/redacted evidence remains untouched for provenance.
    """
    v = normalize_linguistic_text(text)
    for patt, repl in _V571_LEXICAL_PHRASE_MAP:
        v = patt.sub(repl, v)
    toks = tokenize(v)
    if not toks:
        return normalize_space(v)
    out = [_V571_SAFE_TOKEN_LEMMA.get(t, t) for t in toks]
    return " ".join(out)


