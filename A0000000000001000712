V572_CAUSE_PREFIX_RE = re.compile(r"(?i)\b(?:caused\s+by|due\s+to|because\s+of|because|result(?:ed|ing)?\s+from|attribut(?:ed|able)\s+to|identified\s+as|root\s+cause(?:\s+of\s+the\s+(?:issue|problem))?)\b\s*(?:was|is|:|-)?\s*")
