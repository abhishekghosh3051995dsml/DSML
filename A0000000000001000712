def _context_substantive_score_v57(item: Mapping[str, Any]) -> float:
    text = normalize_space(item.get("summary_phrase") or item.get("statement") or "")
    ctype = str(item.get("context_type", "")).upper()
    tokens = tokenize(text)
    base = safe_float(item.get("evidence_strength"), .65)
    signal = 0.0
    if ctype in {"CUSTOMER_PROBLEM", "SYMPTOM_OR_IMPACT", "ROOT_CAUSE", "REMEDIATION"}:
        signal += .18
    if ctype in {"DIAGNOSTIC", "STATE", "TEMPORAL"}:
        signal += .10
    if IMPACT_CUE_RE.search(text) or DIAGNOSTIC_CUE_RE.search(text) or STATE_CUE_RE.search(text) or CAUSE_CUE_RE.search(text) or REMEDIATION_CUE_RE.search(text):
        signal += .16
    if len(tokens) >= 4:
        signal += .08
    if BOILERPLATE_CUE_RE.search(text):
        signal -= .14
    generic_ratio = sum(t in BACKGROUND_TERMS for t in tokens) / max(len(tokens), 1)
    return float(np.clip(.58 * base + signal - .18 * generic_ratio, 0.0, 1.0))


def _context_fact_id_v57(interaction_ref: Any, ctype: Any, phrase: Any) -> str:
    raw = f"{interaction_ref}|{str(ctype).upper()}|{normalize_term(phrase)}".encode("utf-8", errors="ignore")
    return hashlib.sha1(raw).hexdigest()[:22]


def _aggregate_context_facts_v57(record: Mapping[str, Any], c: ConfigV57) -> List[Dict[str, Any]]:
    contexts = [dict(x) for x in record.get("context", [])]
    phrase_types = defaultdict(set)
    for x in contexts:
        p = normalize_term(x.get("summary_phrase") or x.get("statement") or "")
        if p:
            phrase_types[p].add(str(x.get("context_type", "")).upper())
    groups = defaultdict(list)
    for x in contexts:
        ctype = str(x.get("context_type", "")).upper()
        phrase = normalize_space(x.get("summary_phrase") or x.get("statement") or "")
        key = (ctype, normalize_term(phrase))
        if ctype and key[1]:
            groups[key].append(x)
    facts = []
    for (ctype, norm), items in groups.items():
        roles = sorted(set(str(x.get("role", "unknown")) for x in items if str(x.get("role", ""))))
        refs = sorted(set(str(x.get("evidence_ref", "")) for x in items if str(x.get("evidence_ref", ""))))
        phrase = normalize_space(items[0].get("summary_phrase") or items[0].get("statement") or norm)
        score = max(_context_substantive_score_v57(x) for x in items)
        facts.append({
            "context_fact_id": _context_fact_id_v57(record.get("interaction_ref"), ctype, phrase),
            "context_type": ctype,
            "normalized_fact": norm,
            "summary_phrase": phrase,
            "mention_count": len(items),
            "roles": roles,
            "evidence_refs": refs,
            "max_evidence_strength": max([safe_float(x.get("evidence_strength"), 0.0) for x in items] or [0.0]),
            "context_substantive_score": score,
            "is_substantive": bool(score >= c.context_min_substantive_score),
            "ambiguity_status": "TYPE_AMBIGUITY" if len(phrase_types[norm]) > 1 else "CLEAR",
        })
    return sorted(facts, key=lambda x: (not x["is_substantive"], x["context_type"], x["normalized_fact"]))


def _annotate_entities_v57(record: Dict[str, Any], role_by_ref: Mapping[str, str], c: ConfigV57) -> None:
    accepted_by_ref_name = defaultdict(set)
    candidate_by_ref_name = defaultdict(set)
    for e in record.get("entities", []):
        ref = str(e.get("evidence_ref", "")); name = normalize_term(e.get("canonical_name", "")); et = str(e.get("entity_type", "")).upper()
        if ref and name and et:
            accepted_by_ref_name[(ref, name)].add(et)
    for e in record.get("entity_candidates", []):
        ref = str(e.get("evidence_ref", "")); name = normalize_term(e.get("canonical_name", "")); et = str(e.get("entity_type", "")).upper()
        if ref and name and et:
            candidate_by_ref_name[(ref, name)].add(et)

    def decorate(items, accepted: bool):
        out = []
        for raw in items:
            e = dict(raw)
            ref = str(e.get("evidence_ref", "")); name = normalize_term(e.get("canonical_name", "")); et = str(e.get("entity_type", "")).upper()
            score = safe_float(e.get("precision_score", e.get("evidence_strength")), 0.0)
            threshold = safe_float(e.get("acceptance_threshold"), c.entity_accept_confidence)
            e["evidence_role"] = role_by_ref.get(ref, "unknown")
            e["acceptance_margin"] = float(score - threshold)
            e["confidence_status"] = "LOW_MARGIN" if abs(score - threshold) <= c.entity_ambiguity_margin else "CLEAR"
            # True semantic ambiguity is separated from confidence margin.
            accepted_types = accepted_by_ref_name.get((ref, name), set())
            e["ambiguity_status"] = "TYPE_AMBIGUITY" if len(accepted_types) > 1 else "CLEAR"
            e["candidate_type_count"] = len(candidate_by_ref_name.get((ref, name), set()))
            e["canonicalization_key"] = f"{et}::{name}"
            e["entity_status"] = "ACCEPTED" if accepted else "REVIEW_CANDIDATE"
            out.append(e)
        return out

    record["entities"] = decorate(record.get("entities", []), True)
    record["entity_candidates"] = decorate(record.get("entity_candidates", []), False)


def _node_support_v57(record: Mapping[str, Any]) -> Dict[Tuple[str, str], Dict[str, Any]]:
    support = {}
    for e in record.get("entities", []):
        key = (str(e.get("entity_type", "")).upper(), normalize_term(e.get("canonical_name", "")))
        if not key[1]:
            continue
        row = support.setdefault(key, {"refs": set(), "ambiguity": set()})
        if e.get("evidence_ref"):
            row["refs"].add(str(e.get("evidence_ref")))
        row["ambiguity"].add(str(e.get("ambiguity_status", "CLEAR")))
    for x in record.get("context", []):
        label = normalize_space(x.get("summary_phrase") or x.get("statement") or "")
        key = (str(x.get("context_type", "")).upper(), normalize_term(label))
        if not key[1]:
            continue
        row = support.setdefault(key, {"refs": set(), "ambiguity": set()})
        if x.get("evidence_ref"):
            row["refs"].add(str(x.get("evidence_ref")))
    for field, ntype in (("root_cause", "ROOT_CAUSE"), ("remediation", "REMEDIATION")):
        for x in record.get(field, []):
            key = (ntype, normalize_term(x.get("statement", "")))
            row = support.setdefault(key, {"refs": set(), "ambiguity": set()})
            if x.get("evidence_ref"):
                row["refs"].add(str(x.get("evidence_ref")))
    return support


def _ground_relations_v57(record: Dict[str, Any], c: ConfigV57) -> None:
    support = _node_support_v57(record)
    rows = []
    for raw in record.get("relationships", []):
        rel = dict(raw)
        ref = str(rel.get("evidence_ref", ""))
        sk = (str(rel.get("subject_type", "")).upper(), normalize_term(rel.get("subject", "")))
        ok = (str(rel.get("object_type", "")).upper(), normalize_term(rel.get("object", "")))
        sr = support.get(sk, {"refs": set(), "ambiguity": set()})
        orow = support.get(ok, {"refs": set(), "ambiguity": set()})
        sm = bool(ref and ref in sr.get("refs", set()))
        om = bool(ref and ref in orow.get("refs", set()))
        rule = str(rel.get("source_rule", ""))
        explicit = rule in {"root_cause_link", "remediation_link", "interaction_problem_anchor", "diagnostic_for_problem"}
        base = safe_float(rel.get("relation_confidence"), 0.0)
        score = float(np.clip(base + (.07 if sm and om else .04 if sm or om else 0.0) + (.03 if explicit else 0.0), 0.0, 1.0))
        if sm and om:
            method = "DIRECT_SHARED_EVIDENCE"
        elif sm or om:
            method = "DIRECT_ONE_SIDE_EVIDENCE"
        elif explicit:
            method = "EXPLICIT_RESOLUTION_ANCHOR"
        else:
            method = "INTERACTION_LEVEL_INFERENCE"
        ambiguity = set(sr.get("ambiguity", set())) | set(orow.get("ambiguity", set()))
        rel.update({
            "grounding_score": score,
            "grounding_method": method,
            "evidence_traceable": bool(ref),
            "grounding_status": "GROUNDED" if score >= c.grounding_min_confidence else "WEAK_GROUNDING",
            "ambiguity_status": "AMBIGUOUS" if "TYPE_AMBIGUITY" in ambiguity else "CLEAR",
            "substantive_relation": str(rel.get("predicate", "")) in V57_SUBSTANTIVE_PREDICATES,
        })
        rows.append(rel)

    resources = [e for e in record.get("entities", []) if str(e.get("entity_type", "")) in RELATION_RESOURCE_TYPES]
    for m in record.get("measurements", []):
        ref = str(m.get("evidence_ref", ""))
        label = f"{m.get('normalized_key')}={m.get('value')} {m.get('unit')}".strip()
        for e in resources:
            if ref and ref == str(e.get("evidence_ref", "")):
                conf = min(safe_float(m.get("evidence_strength"), .8), safe_float(e.get("precision_score", e.get("evidence_strength")), .8))
                rel = _relation_row(record.get("interaction_ref"), str(e.get("entity_type")), e.get("canonical_name", ""), "HAS_MEASUREMENT", "MEASUREMENT", label, conf, ref, "same_evidence_resource_measurement")
                rel.update({"grounding_score": float(np.clip(conf + .08, 0, 1)), "grounding_method": "DIRECT_SHARED_EVIDENCE", "evidence_traceable": True, "grounding_status": "GROUNDED", "ambiguity_status": e.get("ambiguity_status", "CLEAR"), "substantive_relation": True})
                rows.append(rel)

    for field, pred, ntype in (("root_cause", "ASSOCIATED_WITH_RESOURCE", "ROOT_CAUSE"), ("remediation", "ACTS_ON_RESOURCE", "REMEDIATION")):
        for item in record.get(field, []):
            ref = str(item.get("evidence_ref", "")); label = item.get("statement", "")
            for e in resources:
                if ref and ref == str(e.get("evidence_ref", "")):
                    conf = min(safe_float(item.get("evidence_strength"), .8), safe_float(e.get("precision_score", e.get("evidence_strength")), .8))
                    rel = _relation_row(record.get("interaction_ref"), ntype, label, pred, str(e.get("entity_type")), e.get("canonical_name", ""), conf, ref, "same_evidence_resolution_resource", status=item.get("status") if field == "root_cause" else None)
                    rel.update({"grounding_score": float(np.clip(conf + .08, 0, 1)), "grounding_method": "DIRECT_SHARED_EVIDENCE", "evidence_traceable": True, "grounding_status": "GROUNDED", "ambiguity_status": e.get("ambiguity_status", "CLEAR"), "substantive_relation": True})
                    rows.append(rel)

    record["relationships"] = dedupe_dicts(rows, ("subject_id", "predicate", "object_id", "evidence_ref"), score_key="grounding_score")


def _resolution_chain_v57(record: Mapping[str, Any]) -> Dict[str, Any]:
    causes = [dict(x) for x in record.get("root_cause", [])]
    rem = [dict(x) for x in record.get("remediation", [])]
    diag = [dict(x) for x in record.get("diagnostic_evidence", [])]
    statuses = Counter(str(x.get("status", "UNKNOWN")) for x in causes)
    if statuses.get("CONFIRMED", 0) > 0 and rem:
        state = "CONFIRMED_RCA_WITH_REMEDIATION"
    elif causes and rem:
        state = "RCA_CONTEXT_WITH_REMEDIATION"
    elif causes:
        state = "RCA_CONTEXT_ONLY"
    elif rem:
        state = "REMEDIATION_ONLY"
    elif diag:
        state = "DIAGNOSTIC_ONLY"
    else:
        state = "NO_RESOLUTION_EVIDENCE"
    items = causes + rem + diag
    refs = [str(x.get("evidence_ref", "")) for x in items if str(x.get("evidence_ref", ""))]
    return {
        "resolution_evidence_status": state,
        "root_cause_count": len(causes),
        "remediation_count": len(rem),
        "diagnostic_evidence_count": len(diag),
        "root_cause_status_counts": dict(statuses),
        "evidence_refs": sorted(set(refs)),
        "evidence_traceability": float(len(refs) / max(len(items), 1)),
        "root_causes": causes,
        "remediations": rem,
    }


def _evidence_quality_v57(record: Mapping[str, Any]) -> Dict[str, Any]:
    ents = record.get("entities", [])
    facts = record.get("context_facts", [])
    rels = record.get("relationships", [])
    true_amb = sum(str(e.get("ambiguity_status", "CLEAR")) == "TYPE_AMBIGUITY" for e in ents)
    low_margin = sum(str(e.get("confidence_status", "CLEAR")) == "LOW_MARGIN" for e in ents)
    substantive = [r for r in rels if r.get("substantive_relation")]
    grounded = [r for r in substantive if r.get("grounding_status") == "GROUNDED"]
    refs = []
    for seq in (ents, record.get("context", []), rels, record.get("root_cause", []), record.get("remediation", [])):
        refs.extend([bool(x.get("evidence_ref")) for x in seq])
    return {
        "accepted_entity_count": len(ents),
        "context_fact_count": len(facts),
        "substantive_context_fact_count": sum(bool(x.get("is_substantive")) for x in facts),
        "relation_count": len(rels),
        "substantive_relation_count": len(substantive),
        "grounded_substantive_relation_count": len(grounded),
        "grounding_coverage": float(len(grounded) / max(len(substantive), 1)),
        "mean_grounding_score": float(np.mean([safe_float(x.get("grounding_score"), 0.0) for x in substantive])) if substantive else 0.0,
        "true_ambiguous_entity_count": true_amb,
        "true_entity_ambiguity_fraction": float(true_amb / max(len(ents), 1)),
        "low_margin_entity_count": low_margin,
        "low_margin_entity_fraction": float(low_margin / max(len(ents), 1)),
        "evidence_reference_coverage": float(sum(refs) / max(len(refs), 1)),
    }


def enhance_records_v57(records: Sequence[Dict[str, Any]], frame: pd.DataFrame, c: ConfigV57) -> List[Dict[str, Any]]:
    role_by_ref = {str(r["_row_ref"]): str(r["_role"]) for _, r in frame.iterrows() if "_row_ref" in r and "_role" in r}
    out = []
    for raw in records:
        r = dict(raw)
        _annotate_entities_v57(r, role_by_ref, c)
        for x in r.get("context", []):
            x["evidence_role"] = role_by_ref.get(str(x.get("evidence_ref", "")), str(x.get("role", "unknown")))
            x["context_substantive_score"] = _context_substantive_score_v57(x)
            x["is_substantive"] = bool(x["context_substantive_score"] >= c.context_min_substantive_score)
        r["context_facts"] = _aggregate_context_facts_v57(r, c)
        _ground_relations_v57(r, c)
        r["resolution_chain"] = _resolution_chain_v57(r)
        r["evidence_quality"] = _evidence_quality_v57(r)

        customer_entities = [e for e in r.get("entities", []) if str(e.get("evidence_role")) == "customer"]
        customer_context = [x for x in r.get("context", []) if str(x.get("role")) == "customer"]
        base_sig = semantic_signature(customer_entities, customer_context, r.get("_customer_problem", ""))
        extra = []
        for f in r.get("context_facts", []):
            if f.get("is_substantive") and "customer" in f.get("roles", []):
                extra.append("context_fact_" + normalise_key(f.get("context_type", "")))
        for e in customer_entities:
            et = normalise_key(e.get("entity_type", ""))
            if et:
                extra.append("grounded_entity_type_" + et)
        r["_semantic_signature"] = " ".join(sorted(set(tokenize(base_sig) + extra)))
        out.append(r)
    return out


def relation_structure_purity(records, labels):
    """V5.7 schema-level relation purity.

    V5.6 mixed resource values into a metric named *structure* purity. That
    penalized otherwise consistent typed graphs. V5.7 measures the actual graph
    schema: subject_type -> predicate -> object_type, using grounded substantive
    relations. Resource-value agreement remains available separately in exports.
    """
    labels = np.asarray(labels, dtype=int)
    per = {}
    if len(records) != len(labels):
        return None, {}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cid)
        docs = []
        for i in idx:
            sig = set()
            for rel in records[i].get("relationships", []):
                if not rel.get("substantive_relation") or rel.get("grounding_status") != "GROUNDED":
                    continue
                s = str(rel.get("subject_type", "")); p = str(rel.get("predicate", "")); o = str(rel.get("object_type", ""))
                if s and p and o:
                    sig.add(f"{s}|{p}|{o}")
                    if p.startswith("HAS_") and rel.get("status"):
                        sig.add(f"{s}|{p}|{o}|status={rel.get('status')}")
            docs.append(sig)
        freq = Counter(t for d in docs for t in d)
        core = {t for t, n in freq.items() if n / max(len(docs), 1) >= .30}
        if not core:
            core = {t for t, _ in freq.most_common(min(6, len(freq)))}
        sims = []
        for d in docs:
            if not d and not core:
                sims.append(1.0)
            elif not d or not core:
                sims.append(0.0)
            else:
                sims.append(len(d & core) / max(len(d | core), 1))
        per[cid] = float(np.mean(sims)) if sims else float("nan")
    vals = [x for x in per.values() if np.isfinite(x)]
    return (float(np.mean(vals)) if vals else None), per


def relation_value_purity_v57(records, labels):
    """Optional stricter metric including resource canonical values."""
    labels = np.asarray(labels, dtype=int)
    per = {}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        docs = []
        for i in np.flatnonzero(labels == cid):
            sig = set()
            for rel in records[i].get("relationships", []):
                if not rel.get("substantive_relation") or rel.get("grounding_status") != "GROUNDED":
                    continue
                s, p, o = str(rel.get("subject_type", "")), str(rel.get("predicate", "")), str(rel.get("object_type", ""))
                obj = normalize_term(rel.get("object", ""))
                sig.add(f"{s}|{p}|{o}|{obj}" if o in RELATION_RESOURCE_TYPES and obj else f"{s}|{p}|{o}")
            docs.append(sig)
        freq = Counter(t for d in docs for t in d)
        core = {t for t, n in freq.items() if n / max(len(docs), 1) >= .30}
        sims = [len(d & core) / max(len(d | core), 1) if d and core else (1.0 if not d and not core else 0.0) for d in docs]
        per[cid] = float(np.mean(sims)) if sims else float("nan")
    good = [v for v in per.values() if np.isfinite(v)]
    return (float(np.mean(good)) if good else None), per


def _v57_quality_metrics(records: Sequence[Mapping[str, Any]]) -> Dict[str, float]:
    eq = [r.get("evidence_quality", {}) or {} for r in records]
    chains = [r.get("resolution_chain", {}) or {} for r in records]
    total_entities = sum(int(x.get("accepted_entity_count", 0)) for x in eq)
    true_amb = sum(int(x.get("true_ambiguous_entity_count", 0)) for x in eq)
    low_margin = sum(int(x.get("low_margin_entity_count", 0)) for x in eq)
    sub = sum(int(x.get("substantive_relation_count", 0)) for x in eq)
    gr = sum(int(x.get("grounded_substantive_relation_count", 0)) for x in eq)
    eligible_chains = [x for x in chains if int(x.get("root_cause_count", 0)) + int(x.get("remediation_count", 0)) + int(x.get("diagnostic_evidence_count", 0)) > 0]
    return {
        "true_entity_ambiguity_fraction": float(true_amb / max(total_entities, 1)),
        "entity_low_margin_fraction": float(low_margin / max(total_entities, 1)),
        "grounded_substantive_relation_coverage": float(gr / max(sub, 1)),
        "mean_interaction_grounding_coverage": float(np.mean([safe_float(x.get("grounding_coverage"), 0.0) for x in eq])) if eq else 0.0,
        "evidence_reference_coverage": float(np.mean([safe_float(x.get("evidence_reference_coverage"), 0.0) for x in eq])) if eq else 0.0,
        "resolution_evidence_traceability": float(np.mean([safe_float(x.get("evidence_traceability"), 0.0) for x in eligible_chains])) if eligible_chains else 1.0,
        "context_fact_coverage": float(np.mean([bool(r.get("context_facts")) for r in records])) if records else 0.0,
    }


# ---------------------------------------------------------------------------
# Full-coverage context-pattern model selection (V5.6 behavior preserved)
# ---------------------------------------------------------------------------

def fit_full_coverage_context_model_v57(tv, ttexts, tsigs, trecords, vv, vtexts, vsigs, vrecords, stopwords, c: ConfigV57):
    max_support = max(2, len(tv) // max(2, c.fine_min_cluster_size))
    upper = min(c.fine_max_clusters, max_support, len(tv) - 1)
    lower = min(max(2, c.fine_min_clusters), upper)
    if upper < 2:
        raise RuntimeError("Insufficient train interactions for full-coverage clustering.")

    ks = list(range(lower, upper + 1))
    # For moderate N, evaluate the entire admissible range; for large N use a
    # deterministic spread. This preserves V5.6's ability to discover 20-30+
    # patterns without hard-coding a target K.
    if len(tv) >= 1500 and len(ks) > max(8, c.model_search_trials):
        pos = np.linspace(0, len(ks) - 1, max(8, c.model_search_trials)).round().astype(int)
        ks = sorted(set(ks[i] for i in pos.tolist()))

    rows, store = [], {}
    for k in ks:
        try:
            est = make_context_partitioner(k, c.seed, len(tv))
            raw = np.asarray(est.fit_predict(tv), dtype=int)
            model, tl = _make_model("partition_full_coverage", est, {"n_clusters": int(k), "coverage_contract": "full"}, raw, tv, c)
            vl, _, _, _, _, _ = _full_centroid_predict_v57(model, vv)
            tm = evaluate_clustering(tv, tl, ttexts, stopwords, c, signatures=tsigs)
            vm = evaluate_clustering(vv, vl, vtexts, stopwords, c, signatures=vsigs)
            rel_purity, _ = relation_structure_purity(vrecords, vl)
            cnt = Counter(tl.tolist())
            min_support = min(cnt.values()) if cnt else 0
            small_share = float(sum(v for v in cnt.values() if v < c.fine_min_cluster_size) / max(len(tl), 1))
            stability = _partition_stability_v57(tv, int(k), c.seed + 500, c.stability_repeats)
            rows.append({
                "candidate_k": int(k),
                "train_silhouette": tm.get("silhouette"),
                "validation_silhouette": vm.get("silhouette"),
                "validation_coherence": vm.get("semantic_coherence_npmi"),
                "validation_signature_purity": vm.get("signature_purity"),
                "validation_relation_structure_purity": rel_purity,
                "validation_balance_entropy": vm.get("balance_entropy"),
                "validation_largest_cluster_share": vm.get("largest_cluster_share"),
                "train_min_cluster_size": int(min_support),
                "train_small_cluster_share": small_share,
                "stability_ari": stability,
                "validation_assigned_fraction": 1.0,
            })
            store[int(k)] = (model, tl, vl)
        except Exception as exc:
            LOGGER.debug("context candidate k=%s failed: %s", k, exc)

    tab = pd.DataFrame(rows)
    if tab.empty:
        raise RuntimeError("No full-coverage context-pattern candidate could be fit.")

    tab["rank_silhouette"] = _safe_rank_v57(tab["validation_silhouette"], True)
    tab["rank_coherence"] = _safe_rank_v57(tab["validation_coherence"], True)
    tab["rank_signature"] = _safe_rank_v57(tab["validation_signature_purity"], True)
    tab["rank_relation_structure"] = _safe_rank_v57(tab["validation_relation_structure_purity"], True)
    tab["rank_balance"] = _safe_rank_v57(tab["validation_balance_entropy"], True)
    tab["rank_stability"] = _safe_rank_v57(tab["stability_ari"], True)
    tab["rank_granularity"] = _safe_rank_v57(tab["candidate_k"], True)
    tab["support_factor"] = np.minimum(1.0, pd.to_numeric(tab["train_min_cluster_size"], errors="coerce").fillna(0) / max(c.fine_min_cluster_size, 1))
    tab["structural_valid"] = (
        (tab["train_min_cluster_size"] >= max(3, int(math.ceil(.60 * c.fine_min_cluster_size)))) &
        (tab["validation_largest_cluster_share"].fillna(1.0) <= max(.50, c.business_max_largest_cluster_share + .08)) &
        (tab["train_small_cluster_share"] <= .20)
    )
    tab["selection_score"] = (
        .22 * tab["rank_silhouette"] +
        .18 * tab["rank_coherence"] +
        .18 * tab["rank_signature"] +
        .10 * tab["rank_relation_structure"] +
        .17 * tab["rank_stability"] +
        .08 * tab["rank_balance"] +
        .07 * tab["rank_granularity"]
    ) * (.82 + .18 * tab["support_factor"])
    eligible = tab[tab["structural_valid"]].copy() if bool(tab["structural_valid"].any()) else tab.copy()
    best = eligible.sort_values(
        ["selection_score", "stability_ari", "validation_signature_purity", "validation_relation_structure_purity", "candidate_k"],
        ascending=[False, False, False, False, False],
    ).iloc[0]
    k = int(best["candidate_k"])
    model, tl, vl = store[k]
    return model, tl, vl, tab.sort_values(["structural_valid", "selection_score"], ascending=[False, False]).reset_index(drop=True), best.to_dict()


def refit_context_model_v57(dev_v: np.ndarray, k: int, c: ConfigV57):
    est = make_context_partitioner(k, c.seed + 991, len(dev_v))
    raw = np.asarray(est.fit_predict(dev_v), dtype=int)
    return _make_model("partition_full_coverage", est, {"n_clusters": int(k), "coverage_contract": "full"}, raw, dev_v, c)


def fit_macro_clusters_v57(fine_model: ClusterModel, fine_counts: Mapping[int, int], c: ConfigV57):
    fine_ids = sorted(int(x) for x in fine_model.centroid_vectors)
    if len(fine_ids) <= 2:
        return {x: 1 for x in fine_ids}, {1: {"descriptor": "all customer problems", "keywords": []}}, pd.DataFrame()
    x = np.vstack([fine_model.centroid_vectors[i] for i in fine_ids])
    weights = np.asarray([max(1, int(fine_counts.get(i, 1))) for i in fine_ids], dtype=float)
    upper = min(c.macro_max_clusters, len(fine_ids) - 1)
    lower = min(max(2, c.macro_min_clusters), upper)
    rows, store = [], {}
    for k in range(lower, upper + 1):
        try:
            est = make_context_partitioner(k, c.seed + 1401, len(x), reassignment_ratio=0.0)
            try:
                raw = est.fit_predict(x, sample_weight=weights)
            except TypeError:
                raw = est.fit_predict(x)
            sil = safe_silhouette(x, np.asarray(raw, dtype=int), c.seed)
            ent = cluster_entropy(np.asarray(raw, dtype=int))
            stab = _partition_stability_v57(x, k, c.seed + 1403, max(3, min(c.stability_repeats, 6)))
            rows.append({"macro_k": k, "silhouette": sil, "balance_entropy": ent, "stability_ari": stab})
            store[k] = np.asarray(raw, dtype=int)
        except Exception:
            pass
    tab = pd.DataFrame(rows)
    if tab.empty:
        raw = np.zeros(len(fine_ids), dtype=int)
    else:
        tab["rank_silhouette"] = _safe_rank_v57(tab["silhouette"], True)
        tab["rank_balance"] = _safe_rank_v57(tab["balance_entropy"], True)
        tab["rank_stability"] = _safe_rank_v57(tab["stability_ari"], True)
        tab["score"] = .55 * tab["rank_silhouette"] + .20 * tab["rank_balance"] + .25 * tab["rank_stability"]
        k = int(tab.sort_values(["score", "stability_ari"], ascending=False).iloc[0]["macro_k"])
        raw = store[k]
    public, _, _ = _normalise_cluster_ids(raw, x)
    mapping = {fine_ids[i]: int(public[i]) for i in range(len(fine_ids))}
    desc = {cid: {"descriptor": f"context_family_{cid}", "keywords": []} for cid in sorted(set(mapping.values()))}
    return mapping, desc, tab.sort_values("score", ascending=False).reset_index(drop=True) if not tab.empty and "score" in tab else tab


def _signature_parent_purity_v57(signatures: Sequence[str]) -> float:
    if not signatures:
        return 0.0
    p, _ = signature_purity(signatures, np.ones(len(signatures), dtype=int))
    return safe_float(p, 0.0)


def discover_context_refinements_v57(dev_records, dev_v, dev_labels, stopwords, c: ConfigV57):
    models, audit = {}, []
    dev_labels = np.asarray(dev_labels, dtype=int)
    for parent in sorted(set(int(x) for x in dev_labels.tolist())):
        idx = np.flatnonzero(dev_labels == parent)
        n = len(idx)
        local_records = [dev_records[i] for i in idx.tolist()]
        texts = [r["_customer_problem"] for r in local_records]
        sigs = [r["_semantic_signature"] for r in local_records]
        parent_sig = _signature_parent_purity_v57(sigs)
        parent_rel = safe_float(relation_structure_purity(local_records, np.ones(n, dtype=int))[0], 0.0)
        maxk = min(c.context_refinement_max_children, n // max(1, c.context_refinement_min_child_size))
        if n < 2 * c.context_refinement_min_child_size or maxk < 2:
            audit.append({"parent_cluster_id": parent, "candidate_k": 0, "n": n, "accepted": False, "reason": "insufficient_support", "parent_signature_purity": parent_sig, "parent_relation_purity": parent_rel})
            continue
        candidates, store = [], {}
        for k in range(2, maxk + 1):
            try:
                est = make_context_partitioner(k, c.seed + parent * 101 + k, n, reassignment_ratio=0.0)
                raw = np.asarray(est.fit_predict(dev_v[idx]), dtype=int)
                pub, _, _ = _normalise_cluster_ids(raw, dev_v[idx])
                cnt = Counter(pub.tolist()); minchild = min(cnt.values()) if cnt else 0; largest = max(cnt.values()) / n if cnt else 1.0
                sil = safe_silhouette(dev_v[idx], pub, c.seed)
                sig, _ = signature_purity(sigs, pub)
                rel, _ = relation_structure_purity(local_records, pub)
                stability = _partition_stability_v57(dev_v[idx], k, c.seed + parent * 37, c.context_refinement_stability_repeats)
                silv, sigv, relv = safe_float(sil, -1.0), safe_float(sig, 0.0), safe_float(rel, 0.0)
                accepted = (
                    minchild >= c.context_refinement_min_child_size and
                    stability >= c.context_refinement_min_stability and
                    silv >= c.context_refinement_min_silhouette and
                    sigv >= max(c.context_refinement_min_signature_purity, parent_sig) and
                    largest <= .82
                )
                score = .45 * stability + .30 * max(0.0, silv) + .20 * sigv + .05 * relv
                row = {"parent_cluster_id": parent, "candidate_k": k, "n": n, "min_child_size": minchild, "largest_child_share": largest, "silhouette": silv, "stability_ari": stability, "signature_purity": sigv, "relation_structure_purity": relv, "parent_signature_purity": parent_sig, "parent_relation_purity": parent_rel, "accepted": accepted, "score": score, "reason": "accepted_candidate" if accepted else "quality_gate"}
                candidates.append(row); store[k] = pub
            except Exception as exc:
                candidates.append({"parent_cluster_id": parent, "candidate_k": k, "n": n, "accepted": False, "reason": f"fit_error:{type(exc).__name__}"})
        audit.extend(candidates)
        ok = [x for x in candidates if x.get("accepted")]
        if not ok:
            continue
        best = sorted(ok, key=lambda x: (safe_float(x.get("score")), safe_float(x.get("stability_ari")), safe_float(x.get("signature_purity"))), reverse=True)[0]
        pub = store[int(best["candidate_k"])]
        cents = {}
        for child in sorted(set(int(x) for x in pub.tolist())):
            ci = np.flatnonzero(pub == child)
            cent = np.asarray(dev_v[idx][ci].mean(axis=0), dtype=np.float32)
            cent = cent / max(float(np.linalg.norm(cent)), 1e-12)
            cents[child] = cent
        desc = cluster_descriptions(texts, pub, stopwords, c.top_cluster_terms)
        models[parent] = ContextRefinementModelV57(parent, cents, desc, float(best["stability_ari"]), float(best["silhouette"]), float(best["signature_purity"]), float(best["relation_structure_purity"]))
    return models, pd.DataFrame(audit)


def assign_context_refinements_v57(v, fine_labels, models, fine_desc):
    fine_labels = np.asarray(fine_labels, dtype=int)
    leaf, child_ids, strengths, stabilities, meanings = [], [], [], [], []
    for i, parent in enumerate(fine_labels.tolist()):
        m = models.get(int(parent))
        if m is None:
            leaf.append(f"F{int(parent)}"); child_ids.append(0); strengths.append(1.0); stabilities.append(1.0); meanings.append(str(fine_desc.get(int(parent), {}).get("descriptor", f"cluster_{parent}")))
            continue
        ids = sorted(m.centroid_vectors)
        mat = np.vstack([m.centroid_vectors[x] for x in ids])
        s = np.asarray(v[i] @ mat.T, dtype=float).ravel()
        j = int(np.argmax(s)); child = ids[j]
        leaf.append(f"F{int(parent)}.S{int(child)}"); child_ids.append(int(child)); strengths.append(float(s[j])); stabilities.append(float(m.stability_ari)); meanings.append(str(m.descriptions.get(int(child), {}).get("descriptor", f"context_refinement_{parent}_{child}")))
    return np.asarray(leaf, dtype=object), np.asarray(child_ids, dtype=int), np.asarray(strengths), np.asarray(stabilities), np.asarray(meanings, dtype=object)


