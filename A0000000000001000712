            internal = float(stats.get("internal_consensus", 0.0))
            external = float(stats.get("external_consensus", 0.0))
            rows.append({
                "context_pattern_cluster_id": int(cid),
                "size": int(stats.get("size", 0)),
                "internal_consensus_support": round(internal, 4),
                "external_consensus_support": round(external, 4),
                "separation": round(internal - external, 4),
                "internal_edges": int(stats.get("internal_edges", 0)),
                "meets_support_floor": bool(internal >= floor),
            })
        table = pd.DataFrame(rows).sort_values("internal_consensus_support")
        table.to_csv(diag / "context_pattern_consensus_purity.csv", index=False)
        weak = table[~table["meets_support_floor"]]
        weak_fraction = float(weak["size"].sum()) / max(float(table["size"].sum()), 1.0)
        purity_summary = {
            "status": "PASS" if weak.empty else ("REVIEW" if weak_fraction <= .10 else "FAIL"),
            "support_floor": floor,
            "mean_internal_consensus": round(float(table["internal_consensus_support"].mean()), 4),
            "weakest_cluster_support": round(float(table["internal_consensus_support"].min()), 4),
            "patterns_total": int(len(table)),
            "patterns_below_floor": int(len(weak)),
            "records_below_floor_fraction": round(weak_fraction, 4),
            "artifact": "diagnostics/context_pattern_consensus_purity.csv",
        }
        engine["mean_internal_consensus_support"] = purity_summary["mean_internal_consensus"]

    report["clustering_engine"] = engine
    report["pipeline"] = PIPELINE_NAME
    report["pipeline_version"] = PIPELINE_VERSION
    if purity_summary:
        report["consensus_purity"] = purity_summary

    for name in ("nora_entity_context_v5_7_2_report.json",):
        path = outdir / name
        if path.exists():
            payload = json.loads(path.read_text(encoding="utf-8"))
            payload["clustering_engine"] = engine
            payload["pipeline"] = PIPELINE_NAME
            payload["pipeline_version"] = PIPELINE_VERSION
            if purity_summary:
                payload["consensus_purity"] = purity_summary
            path.write_text(json.dumps(to_plain(payload), indent=2, ensure_ascii=False),
                            encoding="utf-8")

    pd.DataFrame([engine]).to_csv(diag / "clustering_engine.csv", index=False)
    if purity_summary:
        LOGGER.info("V7.1 consensus purity: %s mean=%.3f weakest=%.3f patterns_below_floor=%d",
                    purity_summary["status"], purity_summary["mean_internal_consensus"],
                    purity_summary["weakest_cluster_support"], purity_summary["patterns_below_floor"])
    LOGGER.info("V7.1 context engine: %s patterns via neighbours=%s resolution=%s over %s ensemble members",
                engine["context_patterns"], engine["selected_k_neighbors"],
                engine["selected_resolution"], engine["ensemble_members"])
    return report


