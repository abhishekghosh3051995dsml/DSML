def build_v57_readiness_gate(records, cluster_records, labels, privacy_summary, validation_metrics, c: ConfigV57, fine_stability, low_conf_fraction, leaf_coverage):
    # Reuse the proven base gate but with V5.7's schema-level relation purity.
    _, base, metrics = build_business_gate(records, cluster_records, labels, privacy_summary, validation_metrics, c)
    q = _v57_quality_metrics(records)
    extra = [
        {"check": "full_coverage_contract", "status": "PASS" if float(np.mean(np.asarray(labels) != -1)) >= .98 else "FAIL", "value": float(np.mean(np.asarray(labels) != -1)), "required": ">=0.98"},
        {"check": "context_pattern_partition_stability", "status": "PASS" if fine_stability >= c.analytics_min_fine_stability else "FAIL", "value": fine_stability, "required": f">={c.analytics_min_fine_stability}"},
        {"check": "hierarchical_context_leaf_coverage", "status": "PASS" if leaf_coverage >= .98 else "FAIL", "value": leaf_coverage, "required": ">=0.98"},
        {"check": "low_confidence_fraction", "status": "PASS" if low_conf_fraction <= c.analytics_max_low_confidence_fraction else "FAIL", "value": low_conf_fraction, "required": f"<={c.analytics_max_low_confidence_fraction}"},
        {"check": "grounded_substantive_relation_coverage", "status": "PASS" if q["grounded_substantive_relation_coverage"] >= c.analytics_min_grounding_coverage else "FAIL", "value": q["grounded_substantive_relation_coverage"], "required": f">={c.analytics_min_grounding_coverage}"},
        {"check": "evidence_reference_coverage", "status": "PASS" if q["evidence_reference_coverage"] >= c.analytics_min_evidence_traceability else "FAIL", "value": q["evidence_reference_coverage"], "required": f">={c.analytics_min_evidence_traceability}"},
        {"check": "resolution_evidence_traceability", "status": "PASS" if q["resolution_evidence_traceability"] >= c.analytics_min_evidence_traceability else "FAIL", "value": q["resolution_evidence_traceability"], "required": f">={c.analytics_min_evidence_traceability}"},
        {"check": "true_entity_ambiguity_fraction", "status": "PASS" if q["true_entity_ambiguity_fraction"] <= c.analytics_max_true_entity_ambiguity_fraction else "FAIL", "value": q["true_entity_ambiguity_fraction"], "required": f"<={c.analytics_max_true_entity_ambiguity_fraction}"},
        {"check": "entity_low_margin_fraction", "status": "PASS" if q["entity_low_margin_fraction"] <= c.analytics_max_entity_low_margin_fraction else "WARN", "value": q["entity_low_margin_fraction"], "required": f"<={c.analytics_max_entity_low_margin_fraction} (quality monitor)"},
        {"check": "context_fact_coverage", "status": "PASS" if q["context_fact_coverage"] >= .90 else "FAIL", "value": q["context_fact_coverage"], "required": ">=0.90"},
        {"check": "upstream_intent_is_passthrough_only", "status": "PASS", "value": 1.0, "required": "no intent training / no intent scoring"},
    ]
    out = pd.concat([base, pd.DataFrame(extra)], ignore_index=True)
    # Deduplicate checks that are superseded by V5.7-specific definitions.
    out = out.drop_duplicates(subset=["check"], keep="last").reset_index(drop=True)
    analytic = out[~out["check"].isin(["privacy_review_status", "entity_low_margin_fraction"])]
    final = "PASS" if bool((analytic["status"] == "PASS").all()) else "FAIL"
    metrics.update({"context_pattern_partition_stability": fine_stability, "low_confidence_fraction": low_conf_fraction, "hierarchical_context_leaf_coverage": leaf_coverage, **q})
    return final, out, metrics


