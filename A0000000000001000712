def build_relationships(participants,entities,contexts,attributes,measurements,causes,remediations,interaction_ref,problem_text,min_confidence=.72):
    """Build a typed, provenance-preserving local relation graph.

    Relations are asserted only when supported by the same evidence reference
    or by an explicit interaction-level structure (problem->cause/remediation).
    This deliberately avoids speculative cross-sentence causal links.
    """
    byent=defaultdict(list);byctx=defaultdict(list);byp=defaultdict(list);rows=[]
    for e in entities:byent[str(e["evidence_ref"])].append(e)
    for x in contexts:byctx[str(x["evidence_ref"])].append(x)
    for p in participants:byp[str(p["evidence_ref"])].append(p)
    problem_label=normalize_space(problem_text) or "customer problem"
    problem_ref="interaction:"+str(interaction_ref)

    # Canonical customer -> problem anchor.
    customer=[p for p in participants if p.get("participant")=="customer"]
    if customer:
        rows.append(_relation_row(interaction_ref,"PARTICIPANT","customer","REPORTS_PROBLEM","CUSTOMER_PROBLEM",problem_label,.98,problem_ref,"interaction_problem_anchor"))

    refs=set(byent)|set(byctx)|set(byp)
    for ref in refs:
        ents=byent.get(ref,[]);ctxs=byctx.get(ref,[]);parts=byp.get(ref,[])
        resources=[x for x in ents if str(x.get("entity_type")) in RELATION_RESOURCE_TYPES]
        symptoms=[x for x in ctxs if x.get("context_type")=="SYMPTOM_OR_IMPACT"]
        diagnostics=[x for x in ctxs if x.get("context_type")=="DIAGNOSTIC"]
        states=[x for x in ctxs if x.get("context_type")=="STATE"]
        temporals=[x for x in ctxs if x.get("context_type")=="TEMPORAL"]
        is_customer_ref=any(p.get("participant")=="customer" and p.get("participant_semantics") in {"canonical_participant","source_role_alias"} for p in parts)

        for p0 in parts[:4]:
            for sym in symptoms[:4]:
                conf=min(safe_float(p0.get("evidence_strength"),.8),safe_float(sym.get("evidence_strength"),.8))
                rows.append(_relation_row(interaction_ref,"PARTICIPANT",p0.get("participant","participant"),"EXPERIENCES","SYMPTOM_OR_IMPACT",sym.get("summary_phrase") or sym.get("statement",""),conf,ref,"same_evidence_participant_symptom"))

        if is_customer_ref:
            for e in resources[:8]:
                conf=min(.97,safe_float(e.get("precision_score",e.get("evidence_strength")),.8)+.03)
                rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"INVOLVES_RESOURCE",str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),conf,ref,"customer_problem_resource"))

        for sym in symptoms[:4]:
            for e in resources[:6]:
                conf=min(safe_float(sym.get("evidence_strength"),.8),safe_float(e.get("precision_score",e.get("evidence_strength")),.8))
                rows.append(_relation_row(interaction_ref,"SYMPTOM_OR_IMPACT",sym.get("summary_phrase") or sym.get("statement",""),"AFFECTS_RESOURCE",str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),conf,ref,"same_evidence_symptom_resource"))

        for d in diagnostics[:4]:
            rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"HAS_DIAGNOSTIC","DIAGNOSTIC",d.get("summary_phrase") or d.get("statement",""),safe_float(d.get("evidence_strength"),.8),ref,"diagnostic_for_problem"))
            for e in resources[:5]:
                conf=min(safe_float(d.get("evidence_strength"),.8),safe_float(e.get("precision_score",e.get("evidence_strength")),.8))
                rows.append(_relation_row(interaction_ref,"DIAGNOSTIC",d.get("summary_phrase") or d.get("statement",""),"OBSERVES_RESOURCE",str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),conf,ref,"same_evidence_diagnostic_resource"))

        for st in states[:4]:
            for e in resources[:5]:
                conf=min(safe_float(st.get("evidence_strength"),.8),safe_float(e.get("precision_score",e.get("evidence_strength")),.8))
                rows.append(_relation_row(interaction_ref,str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),"HAS_STATE","STATE",st.get("summary_phrase") or st.get("statement",""),conf,ref,"same_evidence_resource_state"))
        for t in temporals[:3]:
            rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"HAS_TEMPORAL_CONTEXT","TEMPORAL",t.get("summary_phrase") or t.get("statement",""),safe_float(t.get("evidence_strength"),.8),ref,"problem_temporal_context"))

    for x in attributes:
        rows.append(_relation_row(interaction_ref,"INTERACTION",str(interaction_ref),"HAS_ATTRIBUTE","ATTRIBUTE",f"{x['normalized_key']}={x['normalized_value']}",safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"explicit_key_value"))
    for x in measurements:
        rows.append(_relation_row(interaction_ref,"INTERACTION",str(interaction_ref),"HAS_MEASUREMENT","MEASUREMENT",f"{x['normalized_key']}={x['value']} {x['unit']}",safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"numeric_measurement"))
    for x in causes:
        pred={"CONFIRMED":"HAS_CONFIRMED_CAUSE","SUSPECTED":"HAS_SUSPECTED_CAUSE","RULED_OUT":"HAS_RULED_OUT_CAUSE","NOT_DETERMINED":"CAUSE_NOT_DETERMINED"}.get(x.get("status"),"HAS_CAUSE_CONTEXT")
        rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,pred,"ROOT_CAUSE",x.get("statement",""),safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"root_cause_link",status=x.get("status")))
    for x in remediations:
        rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"HAS_REMEDIATION","REMEDIATION",x.get("statement",""),safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"remediation_link"))

    rows=[r for r in rows if safe_float(r.get("relation_confidence"),0)>=float(min_confidence) and r.get("subject") and r.get("object")]
    return dedupe_dicts(rows,("subject_id","predicate","object_id","evidence_ref"),score_key="relation_confidence")

def semantic_signature(entities,contexts,problem_text=""):
    """Structure-aware customer-problem signature used alongside lexical text.

    This is not an intent label. It is a sparse relational fingerprint built
    only from accepted customer-side entities/context plus broad polarity/state
    cues, which improves semantic purity without pretrained embeddings.
    """
    toks=[];entity_tokens=[]
    for e in entities:
        et=normalise_key(e.get("entity_type",""));name=normalise_key(e.get("canonical_name",""))
        if not et:continue
        toks.append("etype_"+et)
        if str(e.get("entity_type","")) in STRUCTURAL_ENTITY_TYPES and name:
            token=f"entity_{et}_{name}";toks.append(token);entity_tokens.append((et,name))
    for c0 in contexts:
        ct=str(c0.get("context_type",""))
        if ct in {"SYMPTOM_OR_IMPACT","STATE","TEMPORAL","CUSTOMER_PROBLEM"}:toks.append("context_"+normalise_key(ct))
    # Entity co-occurrence encodes lightweight relation structure without
    # importing assistant-side RCA/remediation into customer-problem clustering.
    for i,(et1,n1) in enumerate(entity_tokens[:10]):
        for et2,n2 in entity_tokens[i+1:10]:
            a,b=sorted((f"{et1}_{n1}",f"{et2}_{n2}"));toks.append(f"pair_{a}__{b}")
    p=str(problem_text or "")
    if IMPACT_CUE_RE.search(p):toks.append("problem_has_impact")
    if REQUEST_CUE_RE.search(p):toks.append("problem_has_request")
    if STATE_CUE_RE.search(p):toks.append("problem_has_state")
    if any(x in tokenize(p) for x in NEGATION_KEEP):toks.append("problem_has_negation")
    return " ".join(sorted(set(x for x in toks if x and not x.endswith("_"))))

def build_records(frame,interactions,normalizer,ontology_matcher,stopwords,c:Config):
    rows=[];imap=interactions.set_index("_group").to_dict("index")
    for group,block in frame.groupby("_group",sort=False):
        participants=[];entities=[];entity_candidates=[];contexts=[];attributes=[];measurements=[];customer_entities=[];customer_contexts=[]
        for _,row in block.iterrows():
            text=str(row["_sanitized_text"]);role=str(row["_role"]);ref=str(row["_row_ref"]);role_source=str(row["_role_source"])
            participants.extend(extract_participants(text,role,role_source,ref));a,m=extract_observations(text,ref);attributes.extend(a);measurements.extend(m)
            local_context=extract_context(text,role,ref,stopwords);contexts.extend(local_context)
            raw_entities=ontology_matcher.extract(text,ref)+extract_bootstrap_domain_entities(text,ref)+extract_device_model_candidates(text,ref)+metric_entities_from_measurements(m,ref)
            local_entities,local_candidates=precision_filter_entities(raw_entities,text,role,c)
            entities.extend(local_entities);entity_candidates.extend(local_candidates)
            if role=="customer":customer_entities.extend(local_entities);customer_contexts.extend(local_context)
        base=imap[str(group)];normalized_problem,norm_conf,norm_method=normalize_problem_clause(str(base["customer_text"]),normalizer)
        if normalized_problem:
            contexts.append({"context_type":"CUSTOMER_PROBLEM","statement":normalized_problem,"summary_phrase":normalized_problem,"role":"customer","evidence_strength":norm_conf,"sentence_index":None,"evidence_ref":"interaction:"+str(base["interaction_ref"]),"normalization_method":norm_method})
            customer_contexts.append(contexts[-1])
        participants=dedupe_dicts(participants,("participant","evidence_ref"));entities=dedupe_dicts(entities,("canonical_name","entity_type","evidence_ref"),score_key="precision_score");entity_candidates=dedupe_dicts(entity_candidates,("canonical_name","entity_type","evidence_ref"),score_key="precision_score");contexts=dedupe_dicts(contexts,("context_type","statement","evidence_ref"));attributes=dedupe_dicts(attributes,("normalized_key","normalized_value","evidence_ref"));measurements=dedupe_dicts(measurements,("normalized_key","value","unit","evidence_ref"))
        evidence=build_evidence_records(contexts,attributes,measurements);causes=build_cause_records(contexts,evidence);remediation=build_remediation_records(contexts,evidence)
        relationships=build_relationships(participants,entities,contexts,attributes,measurements,causes,remediation,str(base["interaction_ref"]),normalized_problem,c.relation_min_confidence,c.relation_max_resources_per_context,c.relation_max_relations_per_evidence)
        participant_names=[]
        for p0 in participants:
            if p0["participant"] not in participant_names:participant_names.append(p0["participant"])
        rows.append({"interaction_ref":base["interaction_ref"],"data_split":base["data_split"],"message_count":base["message_count"],"upstream_labels_passthrough":base["upstream_labels_passthrough"],"participants":participant_names,"participant_evidence":participants,"content":{"customer_source_redacted":str(base["customer_text"]),"customer_problem_normalized":normalized_problem,"customer_problem_normalization_confidence":norm_conf,"assistant_response_redacted":str(base["assistant_text"]),"evidence_text_redacted":str(base["evidence_text"])},"entities":entities,"entity_candidates":entity_candidates,"context":contexts,"attributes":attributes,"measurements":measurements,"diagnostic_evidence":evidence,"root_cause":causes,"remediation":remediation,"relationships":relationships,"_customer_problem":normalized_problem,"_semantic_signature":semantic_signature(customer_entities,customer_contexts,normalized_problem)})
    return rows

