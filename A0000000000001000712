        rows.append({"participant":name, "canonical_interaction_count":count, "alias_mention_count":aliases.get("user→customer", 0) if name == "customer" else 0, "semantics":"; ".join(f"{k}:{v}" for k,v in semantics[name].most_common())})
    return pd.DataFrame(rows)


