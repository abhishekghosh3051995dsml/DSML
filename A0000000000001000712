def _extract_cause_phrase_v571(statement: str) -> str:
    s = normalize_space(statement)
    patterns = (
        r"(?i)\bcaused\s+by\s+(.+)$", r"(?i)\bdue\s+to\s+(.+)$",
        r"(?i)\bbecause\s+of\s+(.+)$", r"(?i)\bresult(?:ed|ing)?\s+from\s+(.+)$",
        r"(?i)\battribut(?:ed|able)\s+to\s+(.+)$", r"(?i)\bidentified\s+as\s+(.+)$",
        r"(?i)\broot\s+cause\s*(?:was|is|:|-)?\s*(.+)$",
    )
    payload = ""
    for p in patterns:
        m = re.search(p, s)
        if m:
            payload = normalize_space(m.group(1)); break
    if not payload:
        payload = salient_phrase(s, SAFE_ENGLISH_STOPWORDS | BACKGROUND_TERMS, max_tokens=10)
    payload = re.split(r"(?i)\b(?:recommend(?:ed|ation)?|next\s+step|resolved\s+by|remediat(?:e|ion))\b", payload, maxsplit=1)[0]
    return canonicalize_surface_v571(payload)


def build_cause_records(contexts, evidence):
    by = defaultdict(list)
    for x in evidence:
        by[str(x.get("evidence_ref", ""))].append(x)
    rows = []
    for ctx in contexts:
        if ctx.get("context_type") != "ROOT_CAUSE":
            continue
        ref = str(ctx.get("evidence_ref", "")); support = by.get(ref, [])
        status = str(ctx.get("root_cause_status", "SUSPECTED"))
        phrase = _extract_cause_phrase_v571(ctx.get("statement", ""))
        if status == "NOT_DETERMINED":
            state, strength = "NOT_DETERMINED", .96
        elif status == "RULED_OUT":
            state, strength = "NEGATED_OR_RULED_OUT", .90
        elif support:
            state = "DIRECT_SAME_EVIDENCE"
            strength = .94 if status == "CONFIRMED" else .82
        else:
            state = "ASSERTED_WITHOUT_CORROBORATION"
            strength = .82 if status == "CONFIRMED" else .72
        rows.append({"statement": ctx.get("statement", ""), "cause_phrase": phrase, "status": status,
                     "cause_evidence_state": state, "evidence_strength": strength,
                     "supporting_evidence_count": len(support),
                     "linked_evidence_refs": sorted({str(x.get("evidence_ref", "")) for x in support if x.get("evidence_ref")}),
                     "evidence_ref": ref})
    return dedupe_dicts(rows, ("cause_phrase", "status", "evidence_ref"))


def _resource_relevance_v571(entity: Mapping[str, Any], statement: str) -> float:
    name = normalize_term(entity.get("canonical_name", "")); et = str(entity.get("entity_type", ""))
    base = safe_float(entity.get("precision_score", entity.get("evidence_strength")), 0.0)
    nt = set(tokenize(name)); st = set(tokenize(statement))
    overlap = len(nt & st) / max(len(nt), 1) if nt else 0.0
    specificity = .04 if len(nt) >= 2 or et in {"DEVICE_MODEL", "METRIC", "PLAN_OR_SOC", "PRODUCT"} else 0.0
    generic_penalty = .06 if name in GENERIC_ENTITY_VALUES else 0.0
    return float(base + .18 * overlap + specificity - generic_penalty)


def _top_resources_v571(resources: Sequence[Mapping[str, Any]], statement: str, limit: int) -> List[Mapping[str, Any]]:
    vals = sorted(resources, key=lambda e: (_resource_relevance_v571(e, statement), safe_float(e.get("precision_score", e.get("evidence_strength")))), reverse=True)
    # Retain the best resource even when lexical overlap is zero; extraction and
    # same-evidence provenance still carry signal. Cap prevents Cartesian growth.
    return vals[:max(1, int(limit))]


def _cap_relation_rows_v571(rows: Sequence[Mapping[str, Any]], cap: int) -> List[Dict[str, Any]]:
    deduped = dedupe_dicts(rows, ("subject_id", "predicate", "object_id", "evidence_ref"), score_key="relation_confidence")
    if cap <= 0 or len(deduped) <= cap:
        return deduped
    return sorted(deduped, key=lambda r: (_V571_RELATION_PRIORITY.get(str(r.get("predicate")), 0), safe_float(r.get("relation_confidence"))), reverse=True)[:cap]


