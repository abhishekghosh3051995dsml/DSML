    fam = _metric_family(unit)
    if fam == "radio": return n in V572_RADIO_METRICS or "signal" in n or "power" in n
    if fam == "speed": return n in V572_SPEED_METRICS or any(x in n for x in ("speed", "throughput", "bandwidth"))
    if fam == "time": return n in V572_TIME_METRICS or any(x in n for x in ("latency", "jitter", "delay", "response", "rtt"))
    if fam == "percent": return n in V572_PERCENT_METRICS or any(x in n for x in ("loss", "utilization", "usage", "availability", "quality"))
