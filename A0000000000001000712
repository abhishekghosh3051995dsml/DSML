    problem_ref = "interaction:" + str(interaction_ref)
    rows = []
    customer = [p for p in participants if p.get("participant") == "customer" and p.get("participant_semantics") == "canonical_participant"]
    if customer:
        rows.append(_relation_row(interaction_ref, "PARTICIPANT", "customer", "REPORTS_PROBLEM", "CUSTOMER_PROBLEM", problem_label, .98, problem_ref, "interaction_problem_anchor"))

    for ref in sorted(set(byent) | set(byctx) | set(byp)):
        local = []
        ents, ctxs, parts = byent.get(ref, []), byctx.get(ref, []), byp.get(ref, [])
        resources = [x for x in ents if str(x.get("entity_type")) in RELATION_RESOURCE_TYPES]
        symptoms = [x for x in ctxs if x.get("context_type") == "SYMPTOM_OR_IMPACT"]
        diagnostics = [x for x in ctxs if x.get("context_type") == "DIAGNOSTIC"]
        states = [x for x in ctxs if x.get("context_type") == "STATE"]
        temporals = [x for x in ctxs if x.get("context_type") == "TEMPORAL"]
        canonical_customer = [p for p in parts if p.get("participant") == "customer" and p.get("participant_semantics") == "canonical_participant"]

        for sym in symptoms[:3]:
            for p0 in canonical_customer[:1]:
                conf = min(safe_float(p0.get("evidence_strength"), .8), safe_float(sym.get("evidence_strength"), .8))
                local.append(_relation_row(interaction_ref, "PARTICIPANT", "customer", "EXPERIENCES", "SYMPTOM_OR_IMPACT", sym.get("summary_phrase") or sym.get("statement", ""), conf, ref, "same_evidence_participant_symptom"))
            for e in _top_resources_v571(resources, sym.get("statement", ""), max_resources_per_context):
                conf = min(safe_float(sym.get("evidence_strength"), .8), safe_float(e.get("precision_score", e.get("evidence_strength")), .8))
                local.append(_relation_row(interaction_ref, "SYMPTOM_OR_IMPACT", sym.get("summary_phrase") or sym.get("statement", ""), "AFFECTS_RESOURCE", str(e.get("entity_type", "ENTITY")), e.get("canonical_name", ""), conf, ref, "same_evidence_symptom_resource"))

        if canonical_customer and resources:
            for e in _top_resources_v571(resources, problem_label, max_resources_per_context):
                conf = min(.97, safe_float(e.get("precision_score", e.get("evidence_strength")), .8) + .03)
                local.append(_relation_row(interaction_ref, "CUSTOMER_PROBLEM", problem_label, "INVOLVES_RESOURCE", str(e.get("entity_type", "ENTITY")), e.get("canonical_name", ""), conf, ref, "customer_problem_resource"))

        for d in diagnostics[:3]:
            local.append(_relation_row(interaction_ref, "CUSTOMER_PROBLEM", problem_label, "HAS_DIAGNOSTIC", "DIAGNOSTIC", d.get("summary_phrase") or d.get("statement", ""), safe_float(d.get("evidence_strength"), .8), ref, "diagnostic_for_problem"))
            for e in _top_resources_v571(resources, d.get("statement", ""), max_resources_per_context):
                conf = min(safe_float(d.get("evidence_strength"), .8), safe_float(e.get("precision_score", e.get("evidence_strength")), .8))
                local.append(_relation_row(interaction_ref, "DIAGNOSTIC", d.get("summary_phrase") or d.get("statement", ""), "OBSERVES_RESOURCE", str(e.get("entity_type", "ENTITY")), e.get("canonical_name", ""), conf, ref, "same_evidence_diagnostic_resource"))

        for st in states[:3]:
            for e in _top_resources_v571(resources, st.get("statement", ""), max_resources_per_context):
                conf = min(safe_float(st.get("evidence_strength"), .8), safe_float(e.get("precision_score", e.get("evidence_strength")), .8))
                local.append(_relation_row(interaction_ref, str(e.get("entity_type", "ENTITY")), e.get("canonical_name", ""), "HAS_STATE", "STATE", st.get("summary_phrase") or st.get("statement", ""), conf, ref, "same_evidence_resource_state"))
        for temp in temporals[:2]:
            local.append(_relation_row(interaction_ref, "CUSTOMER_PROBLEM", problem_label, "HAS_TEMPORAL_CONTEXT", "TEMPORAL", temp.get("summary_phrase") or temp.get("statement", ""), safe_float(temp.get("evidence_strength"), .8), ref, "problem_temporal_context"))

        # Explicit attributes are useful audit edges but remain lowest priority.
        for x in [a for a in attributes if str(a.get("evidence_ref", "")) == ref][:3]:
            local.append(_relation_row(interaction_ref, "INTERACTION", str(interaction_ref), "HAS_ATTRIBUTE", "ATTRIBUTE", f"{x['normalized_key']}={x['normalized_value']}", safe_float(x.get("evidence_strength"), .8), ref, "explicit_key_value"))
        # Bind measurements directly to the most relevant same-evidence resources;
        # only fall back to an interaction-level measurement when no resource exists.
        for x in [m for m in measurements if str(m.get("evidence_ref", "")) == ref][:4]:
            selected = _top_resources_v571(resources, str(x.get("normalized_key", "")), max_resources_per_context) if resources else []
            label = f"{x['normalized_key']}={x['value']} {x['unit']}"
            if selected:
                for e in selected:
                    conf = min(safe_float(x.get("evidence_strength"), .8), safe_float(e.get("precision_score", e.get("evidence_strength")), .8))
                    local.append(_relation_row(interaction_ref, str(e.get("entity_type", "ENTITY")), e.get("canonical_name", ""), "HAS_MEASUREMENT", "MEASUREMENT", label, conf, ref, "same_evidence_resource_measurement"))
            else:
                local.append(_relation_row(interaction_ref, "INTERACTION", str(interaction_ref), "HAS_MEASUREMENT", "MEASUREMENT", label, safe_float(x.get("evidence_strength"), .8), ref, "numeric_measurement"))

        rows.extend(_cap_relation_rows_v571([r for r in local if safe_float(r.get("relation_confidence"), 0) >= float(min_confidence) and r.get("subject") and r.get("object")], max_relations_per_evidence))

    for x in causes:
        pred = {"CONFIRMED":"HAS_CONFIRMED_CAUSE", "SUSPECTED":"HAS_SUSPECTED_CAUSE", "RULED_OUT":"HAS_RULED_OUT_CAUSE", "NOT_DETERMINED":"CAUSE_NOT_DETERMINED"}.get(x.get("status"), "HAS_CAUSE_CONTEXT")
        label = x.get("cause_phrase") or x.get("statement", "")
        rows.append(_relation_row(interaction_ref, "CUSTOMER_PROBLEM", problem_label, pred, "ROOT_CAUSE", label, safe_float(x.get("evidence_strength"), .8), x.get("evidence_ref"), "root_cause_link", status=x.get("status")))
    for x in remediations:
        rows.append(_relation_row(interaction_ref, "CUSTOMER_PROBLEM", problem_label, "HAS_REMEDIATION", "REMEDIATION", x.get("statement", ""), safe_float(x.get("evidence_strength"), .8), x.get("evidence_ref"), "remediation_link"))
    return dedupe_dicts([r for r in rows if safe_float(r.get("relation_confidence"), 0) >= float(min_confidence)], ("subject_id", "predicate", "object_id", "evidence_ref"), score_key="relation_confidence")


def _aggregate_context_facts_v57(record: Mapping[str, Any], c: ConfigV57) -> List[Dict[str, Any]]:
    contexts = [dict(x) for x in record.get("context", [])]
    phrase_types = defaultdict(set); groups = defaultdict(list)
    for x in contexts:
        ctype = str(x.get("context_type", "")).upper()
        phrase = normalize_space(x.get("summary_phrase") or x.get("statement") or "")
        canonical = canonicalize_surface_v571(phrase)
        if ctype and canonical:
            phrase_types[canonical].add(ctype); groups[(ctype, canonical)].append(x)
    facts = []
    for (ctype, canonical), items in groups.items():
        roles = sorted(set(str(x.get("role", "unknown")) for x in items if str(x.get("role", ""))))
        refs = sorted(set(str(x.get("evidence_ref", "")) for x in items if str(x.get("evidence_ref", ""))))
        variants = sorted(set(normalize_space(x.get("summary_phrase") or x.get("statement") or "") for x in items if normalize_space(x.get("summary_phrase") or x.get("statement") or "")))
        score = max(_context_substantive_score_v57(x) for x in items)
        facts.append({
            "context_fact_id": _context_fact_id_v57(record.get("interaction_ref"), ctype, canonical),
            "context_type": ctype, "normalized_fact": canonical, "summary_phrase": variants[0] if variants else canonical,
            "surface_variants": variants[:8], "mention_count": len(items), "roles": roles, "evidence_refs": refs,
            "max_evidence_strength": max([safe_float(x.get("evidence_strength"), 0.0) for x in items] or [0.0]),
            "context_substantive_score": score, "is_substantive": bool(score >= c.context_min_substantive_score),
            "ambiguity_status": "TYPE_AMBIGUITY" if len(phrase_types[canonical]) > 1 else "CLEAR",
            "normalization_version": "v5.7.1_conservative",
        })
    return sorted(facts, key=lambda x: (not x["is_substantive"], x["context_type"], x["normalized_fact"]))


def _node_support_v571(record: Mapping[str, Any]) -> Dict[Tuple[str, str], Dict[str, Any]]:
    support = _node_support_v57(record)
    for p0 in record.get("participant_evidence", []):
        key = ("PARTICIPANT", normalize_term(p0.get("participant", "")))
        if key[1]:
            row = support.setdefault(key, {"refs": set(), "ambiguity": set()})
            if p0.get("evidence_ref"): row["refs"].add(str(p0.get("evidence_ref")))
    for rc in record.get("root_cause", []):
        phrase = rc.get("cause_phrase") or rc.get("statement", "")
        key = ("ROOT_CAUSE", normalize_term(phrase))
        if key[1]:
            row = support.setdefault(key, {"refs": set(), "ambiguity": set()})
            if rc.get("evidence_ref"): row["refs"].add(str(rc.get("evidence_ref")))
    for m in record.get("measurements", []):
        label = f"{m.get('normalized_key')}={m.get('value')} {m.get('unit')}"
        key = ("MEASUREMENT", normalize_term(label))
        row = support.setdefault(key, {"refs": set(), "ambiguity": set()})
        if m.get("evidence_ref"): row["refs"].add(str(m.get("evidence_ref")))
    for a in record.get("attributes", []):
        label = f"{a.get('normalized_key')}={a.get('normalized_value')}"
        key = ("ATTRIBUTE", normalize_term(label))
        row = support.setdefault(key, {"refs": set(), "ambiguity": set()})
        if a.get("evidence_ref"): row["refs"].add(str(a.get("evidence_ref")))
    return support


def _ground_relations_v57(record: Dict[str, Any], c: ConfigV57) -> None:
    """Calibrate evidence quality without equating 'has a ref' with 'grounded'."""
    support = _node_support_v571(record); rows = []
    explicit_rules = {"root_cause_link", "remediation_link", "interaction_problem_anchor", "diagnostic_for_problem", "customer_problem_resource", "problem_temporal_context", "numeric_measurement"}
    for raw in record.get("relationships", []):
        rel = dict(raw); ref = str(rel.get("evidence_ref", "")); rule = str(rel.get("source_rule", ""))
        sk = (str(rel.get("subject_type", "")).upper(), normalize_term(rel.get("subject", "")))
        ok = (str(rel.get("object_type", "")).upper(), normalize_term(rel.get("object", "")))
        sr, orow = support.get(sk, {"refs": set(), "ambiguity": set()}), support.get(ok, {"refs": set(), "ambiguity": set()})
        sm, om = bool(ref and ref in sr.get("refs", set())), bool(ref and ref in orow.get("refs", set()))
        explicit = rule in explicit_rules
        if sm and om:
            tier, evidence_factor = "DIRECT_SHARED_EVIDENCE", 1.0
        elif explicit and (sm or om or rule == "interaction_problem_anchor"):
            tier, evidence_factor = "EXPLICIT_ANCHOR", .90
        elif sm or om:
            tier, evidence_factor = "ONE_SIDE_EVIDENCE", .66
        else:
            tier, evidence_factor = "INTERACTION_LEVEL_INFERENCE", .42
        base = safe_float(rel.get("relation_confidence"), 0.0)
        score = float(np.clip(.72 * base + .28 * evidence_factor, 0, 1))
        ambiguity = set(sr.get("ambiguity", set())) | set(orow.get("ambiguity", set()))
        rel.update({
            "grounding_score": score, "grounding_method": tier, "grounding_tier": tier,
            "semantic_support_score": evidence_factor, "evidence_traceable": bool(ref),
            "grounding_status": "GROUNDED" if score >= c.grounding_min_confidence else "WEAK_GROUNDING",
            "ambiguity_status": "AMBIGUOUS" if "TYPE_AMBIGUITY" in ambiguity else "CLEAR",
            "substantive_relation": str(rel.get("predicate", "")) in V57_SUBSTANTIVE_PREDICATES,
        })
        rows.append(rel)

    # Same-evidence RCA/remediation -> resource links remain useful, but only to
    # the highest-relevance resources so one message cannot explode combinatorially.
    resources = [e for e in record.get("entities", []) if str(e.get("entity_type", "")) in RELATION_RESOURCE_TYPES]
    for field, pred, ntype in (("root_cause", "ASSOCIATED_WITH_RESOURCE", "ROOT_CAUSE"), ("remediation", "ACTS_ON_RESOURCE", "REMEDIATION")):
        for item in record.get(field, []):
            ref = str(item.get("evidence_ref", "")); label = item.get("cause_phrase") if field == "root_cause" else item.get("statement", "")
            same = [e for e in resources if ref and ref == str(e.get("evidence_ref", ""))]
            for e in _top_resources_v571(same, str(label), c.relation_max_resources_per_context) if same else []:
                conf = min(safe_float(item.get("evidence_strength"), .8), safe_float(e.get("precision_score", e.get("evidence_strength")), .8))
                rel = _relation_row(record.get("interaction_ref"), ntype, label, pred, str(e.get("entity_type")), e.get("canonical_name", ""), conf, ref, "same_evidence_resolution_resource", status=item.get("status") if field == "root_cause" else None)
                rel.update({"grounding_score": float(np.clip(.72 * conf + .28, 0, 1)), "grounding_method":"DIRECT_SHARED_EVIDENCE", "grounding_tier":"DIRECT_SHARED_EVIDENCE", "semantic_support_score":1.0, "evidence_traceable":True, "grounding_status":"GROUNDED", "ambiguity_status":e.get("ambiguity_status", "CLEAR"), "substantive_relation":True})
                rows.append(rel)
    record["relationships"] = dedupe_dicts(rows, ("subject_id", "predicate", "object_id", "evidence_ref"), score_key="grounding_score")


def _evidence_quality_v57(record: Mapping[str, Any]) -> Dict[str, Any]:
    ents = record.get("entities", []); facts = record.get("context_facts", []); rels = record.get("relationships", [])
    true_amb = sum(str(e.get("ambiguity_status", "CLEAR")) == "TYPE_AMBIGUITY" for e in ents)
    low_margin = sum(str(e.get("confidence_status", "CLEAR")) == "LOW_MARGIN" for e in ents)
    substantive = [r for r in rels if r.get("substantive_relation")]
    direct = [r for r in substantive if r.get("grounding_tier") == "DIRECT_SHARED_EVIDENCE" and r.get("grounding_status") == "GROUNDED"]
    anchored = [r for r in substantive if r.get("grounding_tier") == "EXPLICIT_ANCHOR" and r.get("grounding_status") == "GROUNDED"]
    one_side = [r for r in substantive if r.get("grounding_tier") == "ONE_SIDE_EVIDENCE"]
    inferred = [r for r in substantive if r.get("grounding_tier") == "INTERACTION_LEVEL_INFERENCE"]
    refs = []
    for seq in (ents, record.get("context", []), rels, record.get("root_cause", []), record.get("remediation", [])):
        refs.extend([bool(x.get("evidence_ref")) for x in seq])
    meaningful = len(direct) + len(anchored)
    return {
        "accepted_entity_count": len(ents), "context_fact_count": len(facts),
        "substantive_context_fact_count": sum(bool(x.get("is_substantive")) for x in facts),
        "relation_count": len(rels), "relations_per_interaction": float(len(rels)),
        "substantive_relation_count": len(substantive), "direct_grounded_relation_count": len(direct),
        "anchored_grounded_relation_count": len(anchored), "one_side_relation_count": len(one_side),
        "inferred_relation_count": len(inferred), "grounded_substantive_relation_count": meaningful,
        "grounding_coverage": float(meaningful / max(len(substantive), 1)),
        "direct_grounding_coverage": float(len(direct) / max(len(substantive), 1)),
        "anchored_or_direct_grounding_coverage": float(meaningful / max(len(substantive), 1)),
        "inferred_relation_fraction": float(len(inferred) / max(len(substantive), 1)),
        "mean_grounding_score": float(np.mean([safe_float(x.get("grounding_score"), 0.0) for x in substantive])) if substantive else 0.0,
        "mean_semantic_support_score": float(np.mean([safe_float(x.get("semantic_support_score"), 0.0) for x in substantive])) if substantive else 0.0,
        "true_ambiguous_entity_count": true_amb, "true_entity_ambiguity_fraction": float(true_amb / max(len(ents), 1)),
        "low_margin_entity_count": low_margin, "low_margin_entity_fraction": float(low_margin / max(len(ents), 1)),
        "evidence_reference_coverage": float(sum(refs) / max(len(refs), 1)),
    }


def enhance_records_v57(records: Sequence[Dict[str, Any]], frame: pd.DataFrame, c: ConfigV57) -> List[Dict[str, Any]]:
    ordered = frame.sort_values(["_group", "_row_id"], kind="stable")
    role_by_ref = {str(r["_row_ref"]): str(r["_role"]) for _, r in ordered.iterrows() if "_row_ref" in r and "_role" in r}
    order_by_ref = {str(r["_row_ref"]): int(pos) for pos, (_, r) in enumerate(ordered.iterrows()) if "_row_ref" in r}
    out = []
    for raw in records:
        r = dict(raw); _annotate_entities_v57(r, role_by_ref, c)
        for field in ("entities", "entity_candidates", "attributes", "measurements", "diagnostic_evidence", "root_cause", "remediation"):
            for x in r.get(field, []):
                ref = str(x.get("evidence_ref", "")); x["evidence_order"] = order_by_ref.get(ref)
                if field in {"entities", "entity_candidates"}: x["evidence_role"] = role_by_ref.get(ref, "unknown")
        for x in r.get("context", []):
            ref = str(x.get("evidence_ref", "")); x["evidence_role"] = role_by_ref.get(ref, str(x.get("role", "unknown"))); x["evidence_order"] = order_by_ref.get(ref)
            x["context_substantive_score"] = _context_substantive_score_v57(x); x["is_substantive"] = bool(x["context_substantive_score"] >= c.context_min_substantive_score)
        r["context_facts"] = _aggregate_context_facts_v57(r, c)
        _ground_relations_v57(r, c)
        for rel in r.get("relationships", []):
            rel["evidence_order"] = order_by_ref.get(str(rel.get("evidence_ref", "")))
        r["resolution_chain"] = _resolution_chain_v57(r); r["evidence_quality"] = _evidence_quality_v57(r)
        customer_entities = [e for e in r.get("entities", []) if str(e.get("evidence_role")) == "customer"]
        customer_context = [x for x in r.get("context", []) if str(x.get("role")) == "customer"]
        base_sig = semantic_signature(customer_entities, customer_context, r.get("_customer_problem", "")); extra = []
        for f in r.get("context_facts", []):
            if f.get("is_substantive") and "customer" in f.get("roles", []): extra.append("context_fact_" + normalise_key(f.get("context_type", "")))
        for e in customer_entities:
            et = normalise_key(e.get("entity_type", ""))
            if et: extra.append("grounded_entity_type_" + et)
        r["_semantic_signature"] = " ".join(sorted(set(tokenize(base_sig) + extra)))
        r["surface_normalization"] = {"customer_problem_canonical": r.get("_customer_problem", ""), "normalization_version": "v5.7.1_conservative"}
        r["participant_aliases"] = {"user":"customer"} if any(p.get("participant") == "user" for p in r.get("participant_evidence", [])) else {}
        out.append(r)
    return out


def _v57_quality_metrics(records: Sequence[Mapping[str, Any]]) -> Dict[str, float]:
    eq = [r.get("evidence_quality", {}) or {} for r in records]; chains = [r.get("resolution_chain", {}) or {} for r in records]
    total_entities = sum(int(x.get("accepted_entity_count", 0)) for x in eq); true_amb = sum(int(x.get("true_ambiguous_entity_count", 0)) for x in eq); low_margin = sum(int(x.get("low_margin_entity_count", 0)) for x in eq)
    sub = sum(int(x.get("substantive_relation_count", 0)) for x in eq); grounded = sum(int(x.get("grounded_substantive_relation_count", 0)) for x in eq); direct = sum(int(x.get("direct_grounded_relation_count", 0)) for x in eq); inferred = sum(int(x.get("inferred_relation_count", 0)) for x in eq)
    eligible_chains = [x for x in chains if int(x.get("root_cause_count", 0)) + int(x.get("remediation_count", 0)) + int(x.get("diagnostic_evidence_count", 0)) > 0]
    return {
        "true_entity_ambiguity_fraction": float(true_amb / max(total_entities, 1)),
        "entity_low_margin_fraction": float(low_margin / max(total_entities, 1)),
        "grounded_substantive_relation_coverage": float(grounded / max(sub, 1)),
        "direct_substantive_relation_coverage": float(direct / max(sub, 1)),
        "inferred_substantive_relation_fraction": float(inferred / max(sub, 1)),
        "mean_interaction_grounding_coverage": float(np.mean([safe_float(x.get("grounding_coverage"), 0.0) for x in eq])) if eq else 0.0,
        "mean_relations_per_interaction": float(np.mean([safe_float(x.get("relation_count"), 0.0) for x in eq])) if eq else 0.0,
        "p95_relations_per_interaction": float(np.quantile([safe_float(x.get("relation_count"), 0.0) for x in eq], .95)) if eq else 0.0,
        "evidence_reference_coverage": float(np.mean([safe_float(x.get("evidence_reference_coverage"), 0.0) for x in eq])) if eq else 0.0,
        "resolution_evidence_traceability": float(np.mean([safe_float(x.get("evidence_traceability"), 0.0) for x in eligible_chains])) if eligible_chains else 1.0,
        "context_fact_coverage": float(np.mean([bool(r.get("context_facts")) for r in records])) if records else 0.0,
    }


def _ordered_context_v571(r):
    return sorted(r.get("context", []), key=lambda x: (x.get("evidence_order") is None, x.get("evidence_order") if x.get("evidence_order") is not None else 10**12, x.get("sentence_index") if x.get("sentence_index") is not None else 10**9, str(x.get("context_type", ""))))


def _workflow_signature_v57(r):
    toks = ["participant_" + normalise_key(x) for x in r.get("participants", []) if normalize_space(x) and x != "user"]
    seq = []
    for x in _ordered_context_v571(r):
        ct = normalise_key(x.get("context_type", "")); si = x.get("sentence_index")
        if ct: seq.append((x.get("evidence_order"), si, ct)); toks.append("ctx_" + ct)
    for (oa, sa, a), (ob, sb, b) in zip(seq, seq[1:]):
        later = False
        if oa is not None and ob is not None:
            later = ob > oa or (ob == oa and sa is not None and sb is not None and sb > sa)
        if later: toks.append(f"transition_{a}__{b}")
    ordered_rels = sorted([rel for rel in r.get("relationships", []) if rel.get("grounding_status") == "GROUNDED"], key=lambda rel: (rel.get("evidence_order") is None, rel.get("evidence_order") if rel.get("evidence_order") is not None else 10**12, str(rel.get("predicate", ""))))
    for rel in ordered_rels:
        p = normalise_key(rel.get("predicate", ""))
        if p: toks.append("pred_" + p)
    for rc in r.get("root_cause", []):
        st = normalise_key(rc.get("status", ""))
        if st: toks.append("rc_" + st)
    if r.get("remediation"): toks.append("has_remediation")
    if r.get("diagnostic_evidence"): toks.append("has_diagnostic")
    return " ".join(toks) if toks else "workflow_none"


def _relation_motif_signature_v57(r):
    toks = []; ordered = sorted([rel for rel in r.get("relationships", []) if rel.get("grounding_status") == "GROUNDED"], key=lambda rel: (rel.get("evidence_order") is None, rel.get("evidence_order") if rel.get("evidence_order") is not None else 10**12, str(rel.get("predicate", ""))))
    pred_seq = []
    for rel in ordered:
        s, p, o = normalise_key(rel.get("subject_type", "")), normalise_key(rel.get("predicate", "")), normalise_key(rel.get("object_type", "")); order = rel.get("evidence_order")
        if p: toks.append("pred_" + p); pred_seq.append((order, p))
        if s and p and o: toks.append(f"motif_{s}__{p}__{o}")
    # Transitions require observed message order; list-generation order is never used.
    for (oa, a), (ob, b) in zip(pred_seq, pred_seq[1:]):
        if oa is not None and ob is not None and ob > oa: toks.append(f"rtransition_{a}__{b}")
    return " ".join(toks) if toks else "relation_motif_none"


def _lens_token_label_v571(token: str) -> Optional[str]:
    t = str(token)
    if not t or t.endswith("_none") or t.startswith("transition_") or t.startswith("rtransition_"):
        return None
    if t.startswith("entity_"):
        parts = t.split("_", 2); return parts[2].replace("_", " ") if len(parts) == 3 else None
    if t.startswith("etype_"): return t[6:].replace("_", " ")
    if t.startswith("pred_"): return t[5:].replace("_", " ").replace("has ", "")
    if t.startswith("ctx_"): return t[4:].replace("_", " ")
    if t.startswith("rc_"): return "rca " + t[3:].replace("_", " ")
    if t.startswith("motif_"):
        parts = t.split("__")
        return parts[1].replace("_", " ") if len(parts) >= 2 else None
    if t.startswith("participant_"): return None
    return t.replace("_", " ")


def _lens_descriptions_v57(docs, labels, topn=6):
    out = {}; labels = np.asarray(labels, dtype=int)
    for cid in sorted(set(labels.tolist())):
        cnt = Counter()
        for i in np.flatnonzero(labels == cid).tolist(): cnt.update(str(docs[i]).split())
        labels_clean = []
        for token, _ in cnt.most_common(max(topn * 4, 12)):
            lab = _lens_token_label_v571(token)
            if lab and lab not in labels_clean: labels_clean.append(lab)
            if len(labels_clean) >= topn: break
        out[int(cid)] = " / ".join(labels_clean[:4]) if labels_clean else "sparse structural profile"
    return out


def refit_context_model_v57(dev_v: np.ndarray, k: int, c: ConfigV57):
    """Multi-seed refit that preserves K/full coverage while avoiding fragments."""
    best = None
    trials = max(1, int(c.refit_seed_trials))
    for t in range(trials):
        seed = c.seed + 991 + 3571 * t
        try:
            est = make_context_partitioner(k, seed, len(dev_v)); raw = np.asarray(est.fit_predict(dev_v), dtype=int)
            model, public = _make_model("partition_full_coverage", est, {"n_clusters": int(k), "coverage_contract":"full", "refit_seed":int(seed)}, raw, dev_v, c)
            cnt = Counter(public.tolist()); min_size = min(cnt.values()) if cnt else 0
            small_share = float(sum(v for v in cnt.values() if v < c.fine_min_cluster_size) / max(len(public), 1))
            inertia = safe_float(getattr(est, "inertia_", float("inf")), float("inf"))
            key = (small_share, -min_size, inertia)
            if best is None or key < best[0]: best = (key, model, public, min_size, small_share)
        except Exception:
            continue
    if best is None: raise RuntimeError("V5.7.1 multi-seed context refit failed for every deterministic seed.")
    _, model, public, min_size, small_share = best
    model.parameters.update({"refit_seed_trials": trials, "refit_min_cluster_size": int(min_size), "refit_small_cluster_share": float(small_share)})
    return model, public


def participant_summary_table(records):
    canonical = Counter(); aliases = Counter(); semantics = defaultdict(Counter)
    for r in records:
        seen = set()
        for e in r.get("participant_evidence", []):
            name = str(e.get("participant", "")).strip(); sem = str(e.get("participant_semantics", "unspecified"))
            if not name: continue
