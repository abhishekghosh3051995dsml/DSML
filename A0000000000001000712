# ---------------------------------------------------------------------------
# 8. V7.1 graph-consensus context discovery
# ---------------------------------------------------------------------------
# V5.7.2 discovered context patterns by partitioning the embedding space around
# centroids. That works, but it imposes a shape on the data: every pattern ends
# up a round blob of roughly comparable size, and the result moves with the
# seed. Support text does not arrive in round blobs.
#
# V7.1 keeps every V5.7.2 contract - full coverage, the same catalogue, the
# same evidence and RCA layers, the same gates - and replaces only how the
# patterns are found:
#
#   1. Shared-nearest-neighbour graph. In high dimensions the absolute cosine
#      between two short problem statements is noisy, but the company they keep
#      is not, so edges are weighted by how much two records agree about who
#      their neighbours are.
#   2. Leiden community detection. Local moving, then a refinement pass that
#      guarantees no community is internally disconnected, then aggregation.
#      Resolution sets granularity, so the number of patterns is discovered
#      rather than supplied.
#   3. Consensus over an ensemble. Neighbourhood size, resolution and seed are
#      varied, and only the pairings that survive most of the ensemble are kept.
#      A single stochastic run is never the deliverable.
#   4. Small communities are absorbed, so coverage stays complete and the
#      catalogue contains no fragments.

@dataclass(frozen=True)
class ConfigV71(ConfigV572):
    graph_neighbor_grid: str = "auto"
    graph_resolution_grid: str = "auto"
    graph_ensemble_seeds: int = 3
    graph_max_neighbors: int = 48
    graph_min_neighbors: int = 8
    graph_stability_repeats: int = 5
    graph_subsample_fraction: float = .85
    graph_dense_partition_limit: int = 6000
    analytics_min_consensus_support: float = .60


ConfigV572 = ConfigV71
ConfigV57 = ConfigV71


# --- graph construction -----------------------------------------------------

def graph_degrees_v71(adj):
    """Weighted degree with self-loops counted twice, as modularity requires."""
    return np.asarray(adj.sum(axis=1)).ravel() + np.asarray(adj.diagonal()).ravel()


def graph_total_weight_v71(adj):
    return float(adj.sum() + adj.diagonal().sum()) / 2.0


def build_snn_graph_v71(v, n_neighbors):
    """Mutual k-nearest-neighbour graph re-weighted by shared-neighbour overlap.

    Two records are linked only if each is in the other's neighbourhood, and
    the edge is worth the Jaccard overlap of their neighbour sets. Isolated
    near-duplicates therefore cannot pull a pattern out of shape, and a record
    in a sparse region keeps its strongest honest link instead of being forced
    towards a distant centroid.
    """
    n = int(len(v))
    if n < 3:
        return sparse.csr_matrix((n, n), dtype=np.float64)
    k = int(max(2, min(n_neighbors, n - 1)))
    nn = NearestNeighbors(n_neighbors=k + 1, metric="cosine", algorithm="brute").fit(v)
    _, idx = nn.kneighbors(v)
    idx = idx[:, 1:]
    rows = np.repeat(np.arange(n), idx.shape[1])
    cols = idx.reshape(-1)
    knn = sparse.csr_matrix((np.ones(len(rows), dtype=np.float32), (rows, cols)), shape=(n, n))
    shared = (knn @ knn.T).tocoo()
    both = knn.multiply(knn.T)
    mutual = (both + both.T).tocoo()
    keep = sparse.csr_matrix((np.ones(mutual.nnz, dtype=bool), (mutual.row, mutual.col)), shape=(n, n))
    shared = shared.multiply(keep).tocoo()
    mask = shared.row != shared.col
    r, cc, s = shared.row[mask], shared.col[mask], shared.data[mask]
    if len(r) == 0:
        return sparse.csr_matrix((n, n), dtype=np.float64)
    weight = s / np.maximum(2.0 * k - s, 1.0)
    adj = sparse.csr_matrix((weight.astype(np.float64), (r, cc)), shape=(n, n))
    adj = adj.maximum(adj.T)
    adj.setdiag(0.0)
    adj.eliminate_zeros()
    return adj


# --- Leiden -----------------------------------------------------------------

def _relabel_v71(labels):
    seen, out = {}, np.empty(len(labels), dtype=np.int64)
    for i, value in enumerate(labels):
        value = int(value)
        if value not in seen:
            seen[value] = len(seen)
        out[i] = seen[value]
    return out, len(seen)


def _local_move_v71(adj, comm, gamma, total_weight, degrees, rng, max_sweeps=64):
    """Greedy node moves repeated in randomised sweeps until nothing improves."""
    n = adj.shape[0]
    ctot = np.zeros(n + 2, dtype=np.float64)
    for node in range(n):
        ctot[comm[node]] += degrees[node]
    indptr, indices, data = adj.indptr, adj.indices, adj.data
    two_m = max(2.0 * total_weight, 1e-12)
    for _ in range(max_sweeps):
        moved_any = False
        for node in rng.permutation(n):
            node = int(node)
            start, end = indptr[node], indptr[node + 1]
            nbrs, wts = indices[start:end], data[start:end]
            if len(nbrs) == 0:
                continue
            own = int(comm[node])
            links = {}
            for nb, w in zip(nbrs, wts):
                nb = int(nb)
                if nb == node:
                    continue
                cid = int(comm[nb])
                links[cid] = links.get(cid, 0.0) + float(w)
            ctot[own] -= degrees[node]
            best_c = own
            best_gain = links.get(own, 0.0) - gamma * degrees[node] * ctot[own] / two_m
            for cand, w in links.items():
                if cand == own:
                    continue
                gain = w - gamma * degrees[node] * ctot[cand] / two_m
                if gain > best_gain + 1e-12:
                    best_c, best_gain = cand, gain
            ctot[best_c] += degrees[node]
            if best_c != own:
                comm[node] = best_c
                moved_any = True
        if not moved_any:
            break
    return comm


def _refine_partition_v71(adj, comm, gamma, total_weight, degrees, rng):
    """Split each community into well-connected parts before aggregating.

    This is the step Louvain does not have. Without it a community can be
    internally disconnected - two unrelated groups of interactions reported as
    one pattern - which is precisely the impurity an SME notices first.
    """
    n = adj.shape[0]
    refined = np.arange(n, dtype=np.int64)
    indptr, indices, data = adj.indptr, adj.indices, adj.data
    two_m = max(2.0 * total_weight, 1e-12)
    members_by_comm = {}
    for node in range(n):
        members_by_comm.setdefault(int(comm[node]), []).append(node)
    for members in members_by_comm.values():
        if len(members) <= 1:
            continue
        mset = set(members)
        deg_s = float(sum(degrees[m] for m in members))
        rtot = {m: float(degrees[m]) for m in members}
        still_alone = {m: True for m in members}
        for position in rng.permutation(len(members)):
            node = int(members[int(position)])
            if not still_alone[node]:
                continue
            start, end = indptr[node], indptr[node + 1]
            inside = [(int(nb), float(w)) for nb, w in zip(indices[start:end], data[start:end])
                      if int(nb) in mset and int(nb) != node]
            if not inside:
                continue
            connection = sum(w for _, w in inside)
            if connection < gamma * degrees[node] * (deg_s - degrees[node]) / two_m:
                continue
            links = {}
            for nb, w in inside:
                links[int(refined[nb])] = links.get(int(refined[nb]), 0.0) + w
            best_c, best_gain = int(refined[node]), 0.0
            for cand, w in links.items():
                if cand == int(refined[node]):
                    continue
                gain = w - gamma * degrees[node] * rtot.get(cand, 0.0) / two_m
                if gain > best_gain + 1e-12:
                    best_c, best_gain = cand, gain
            if best_c != int(refined[node]):
                rtot[int(refined[node])] = rtot.get(int(refined[node]), 0.0) - degrees[node]
                rtot[best_c] = rtot.get(best_c, 0.0) + degrees[node]
                refined[node] = best_c
                still_alone[node] = False
    return refined


def _aggregate_graph_v71(adj, part, n_parts):
    n = adj.shape[0]
    m = sparse.csr_matrix((np.ones(n), (np.arange(n), part)), shape=(n, n_parts))
    return (m.T @ adj @ m).tocsr()


def leiden_communities_v71(adj, resolution=1.0, seed=0, max_levels=16):
    """Leiden: local moving, refinement, aggregation, then a polishing sweep."""
    rng = np.random.default_rng(int(seed))
    n0 = adj.shape[0]
    if n0 == 0:
        return np.zeros(0, dtype=np.int64)
    cur = adj.tocsr().astype(np.float64)
    total_weight = graph_total_weight_v71(cur)
    if total_weight <= 0:
        return np.zeros(n0, dtype=np.int64)
    node_to_super = np.arange(n0, dtype=np.int64)
    partition = np.arange(cur.shape[0], dtype=np.int64)
    for _ in range(max_levels):
        n = cur.shape[0]
        degrees = graph_degrees_v71(cur)
        moved = _local_move_v71(cur, partition.copy(), resolution, total_weight, degrees, rng)
        moved, n_comm = _relabel_v71(moved)
        if n_comm == n:
            partition = moved
            break
        refined = _refine_partition_v71(cur, moved, resolution, total_weight, degrees, rng)
        refined, n_ref = _relabel_v71(refined)
        seed_partition = np.zeros(n_ref, dtype=np.int64)
        for node in range(n):
            seed_partition[refined[node]] = moved[node]
        node_to_super = refined[node_to_super]
        cur = _aggregate_graph_v71(cur, refined, n_ref)
        partition, _ = _relabel_v71(seed_partition)
        if n_ref <= 1:
            break
    labels, _ = _relabel_v71(partition[node_to_super])
    # One pass at full resolution: the hierarchy can leave a community split
    # across levels, and this repairs that without disturbing the rest.
    degrees = graph_degrees_v71(adj)
    labels = _local_move_v71(adj.tocsr().astype(np.float64), labels.copy(), resolution,
                             total_weight, degrees, rng)
    out, _ = _relabel_v71(labels)
    return out


def graph_modularity_v71(adj, labels, resolution=1.0):
    labels = np.asarray(labels)
    m = graph_total_weight_v71(adj)
    if m <= 0:
        return 0.0
    deg = graph_degrees_v71(adj)
    q = 0.0
    for c in np.unique(labels):
        idx = np.flatnonzero(labels == c)
        sub = adj[idx][:, idx]
        q += float(sub.sum()) / (2.0 * m) - resolution * (float(deg[idx].sum()) / (2.0 * m)) ** 2
    return float(q)


# --- consensus over an ensemble --------------------------------------------

def _grid_from_spec_v71(spec, fallback):
    if spec is None or str(spec).strip().lower() in ("", "auto"):
        return list(fallback)
    out = []
    for piece in str(spec).split(","):
        piece = piece.strip()
        if not piece:
            continue
        try:
            out.append(float(piece))
        except ValueError:
            continue
    return out or list(fallback)


def neighbor_grid_v71(n, c: ConfigV71):
    """Neighbourhood sizes to try, scaled to the corpus rather than fixed."""
    spec = _grid_from_spec_v71(getattr(c, "graph_neighbor_grid", "auto"), [])
    if spec:
        return sorted({int(max(2, min(n - 1, x))) for x in spec})
    root = int(round(math.sqrt(max(n, 4))))
    raw = {int(round(root * f)) for f in (0.6, 1.0, 1.6)}
    lo, hi = int(c.graph_min_neighbors), int(c.graph_max_neighbors)
    return sorted({int(max(lo, min(hi, min(n - 1, x)))) for x in raw if x >= 2})


def resolution_grid_v71(c: ConfigV71):
    spec = _grid_from_spec_v71(getattr(c, "graph_resolution_grid", "auto"), [])
    if spec:
        return sorted({float(x) for x in spec if x > 0})
    return [0.4, 0.7, 1.0, 1.5, 2.2, 3.2, 4.5]


def ensemble_partitions_v71(adj_by_k, resolutions, seeds):
    """Base partitions across neighbourhood size, resolution and seed.

    Diversity is the point: a consensus is only worth taking over members that
    are able to disagree.
    """
    members = []
    for k in sorted(adj_by_k):
        adj = adj_by_k[k]
        if adj.nnz == 0:
            continue
        for res in resolutions:
            for s in seeds:
                labels = leiden_communities_v71(adj, resolution=float(res), seed=int(s))
                if len(set(labels.tolist())) >= 2:
                    members.append({"k_neighbors": int(k), "resolution": float(res),
                                    "seed": int(s), "labels": labels})
    return members


def coassociation_graph_v71(base_adj, members):
    """Re-weight each edge by how often the ensemble kept its endpoints together.

    Only pairs that are already neighbours are counted, so this stays linear in
    the number of edges instead of quadratic in the number of records.
    """
    coo = sparse.triu(base_adj, k=1).tocoo()
    rows, cols = coo.row, coo.col
    if len(rows) == 0 or not members:
        return base_adj.copy()
    agreement = np.zeros(len(rows), dtype=np.float64)
    for member in members:
        labels = member["labels"]
        agreement += (labels[rows] == labels[cols]).astype(np.float64)
    agreement /= float(len(members))
    graph = sparse.csr_matrix((agreement, (rows, cols)), shape=base_adj.shape)
    graph = graph.maximum(graph.T)
    graph.eliminate_zeros()
    return graph


def absorb_small_communities_v71(labels, v, min_size):
    """Fold undersized communities into the nearest surviving one.

    Coverage stays complete and the catalogue carries no fragment an SME would
    have to skip over.
    """
    labels = np.asarray(labels, dtype=np.int64).copy()
    guard = 0
    while guard < 512:
        guard += 1
        counts = Counter(labels.tolist())
        if len(counts) <= 2:
            break
        small = [cid for cid, n in counts.items() if n < int(min_size)]
        keep = [cid for cid, n in counts.items() if n >= int(min_size)]
        if not small or not keep:
            break
        centroids = []
        for cid in keep:
            idx = np.flatnonzero(labels == cid)
            cen = np.asarray(v[idx].mean(axis=0), dtype=np.float64)
            centroids.append(cen / max(float(np.linalg.norm(cen)), 1e-12))
        mat = np.vstack(centroids)
        target = small[int(np.argmin([counts[cid] for cid in small]))]
        idx = np.flatnonzero(labels == target)
        sims = np.asarray(v[idx] @ mat.T, dtype=float).mean(axis=0)
        labels[idx] = keep[int(np.argmax(sims))]
    out, _ = _relabel_v71(labels)
    return out


def consensus_support_v71(members, labels):
    """Share of ensemble members that agree with each record's final cluster."""
    labels = np.asarray(labels)
    n = len(labels)
    if not members or n == 0:
        return np.zeros(n, dtype=float)
    support = np.zeros(n, dtype=np.float64)
    clusters = np.unique(labels)
    for member in members:
        lab = np.asarray(member["labels"])
        for cid in clusters:
            idx = np.flatnonzero(labels == cid)
            if len(idx) == 0:
                continue
            vals, counts = np.unique(lab[idx], return_counts=True)
            major = vals[int(np.argmax(counts))]
            support[idx] += (lab[idx] == major).astype(float)
    return support / float(len(members))


def graph_partition_v71(v, k_neighbors, resolution, seed, min_size, adj=None):
    """One full-coverage partition of `v`: SNN graph, Leiden, absorb fragments."""
    graph = build_snn_graph_v71(v, k_neighbors) if adj is None else adj
    if graph.nnz == 0:
        return np.zeros(len(v), dtype=np.int64), graph
    labels = leiden_communities_v71(graph, resolution=resolution, seed=seed)
    labels = absorb_small_communities_v71(labels, v, min_size)
    return labels, graph


# --- hierarchical partitioner for the secondary layers ----------------------
# Families, leaf refinements and the structural lenses all need "split this
# small matrix into exactly k parts". Agglomerative linkage answers that
# deterministically, which also removes the seed sensitivity those layers used
# to inherit. Birch takes over when a lens grows past the point where a full
# distance matrix is sensible.

class HierarchicalPartitionerV71:
    """Drop-in replacement for the old centroid partitioner."""

    def __init__(self, n_clusters, dense_limit=6000):
        self.n_clusters = int(n_clusters)
        self.dense_limit = int(dense_limit)
        self.labels_ = None
        self.inertia_ = float("inf")
        self.cluster_centers_ = None

    def fit_predict(self, x, sample_weight=None):
        x = np.asarray(x, dtype=np.float64)
        n = len(x)
        k = int(max(1, min(self.n_clusters, n)))
        if k <= 1 or n <= 1:
            self.labels_ = np.zeros(n, dtype=int)
        elif n <= self.dense_limit:
            model = AgglomerativeClustering(n_clusters=k, metric="cosine", linkage="average")
            self.labels_ = np.asarray(model.fit_predict(x), dtype=int)
        else:
            model = Birch(n_clusters=AgglomerativeClustering(n_clusters=k, metric="cosine",
                                                             linkage="average"),
                          threshold=.35, branching_factor=64)
            self.labels_ = np.asarray(model.fit_predict(x), dtype=int)
        centers, inertia = [], 0.0
        for cid in sorted(set(self.labels_.tolist())):
            idx = np.flatnonzero(self.labels_ == cid)
            cen = x[idx].mean(axis=0)
            norm = float(np.linalg.norm(cen))
            cen = cen / max(norm, 1e-12)
            centers.append(cen)
            inertia += float(np.sum((x[idx] - cen) ** 2))
        self.cluster_centers_ = np.vstack(centers) if centers else None
        self.inertia_ = inertia
        return self.labels_

    def fit(self, x, sample_weight=None):
        self.fit_predict(x, sample_weight=sample_weight)
        return self


def make_partitioner_v71(k, seed, n, reassignment_ratio=.005, dense_limit=6000):
    """Signature-compatible with the partitioner the earlier versions used."""
    return HierarchicalPartitionerV71(k, dense_limit=dense_limit)


def subsample_stability_v71(v, k, seed, repeats, fraction=.85):
    """Agreement between partitions fitted on overlapping subsamples.

    Re-running the same deterministic fit would report perfect stability and
    mean nothing, so the data is resampled instead and agreement is measured on
    the records the two runs share.
    """
    v = np.asarray(v, dtype=np.float64)
    n = len(v)
    k = int(k)
    if n < max(10, k * 2) or repeats < 2 or k < 2:
        return 0.0
    rng = np.random.default_rng(int(seed))
    size = int(max(k * 2, round(float(fraction) * n)))
    runs = []
    for _ in range(int(repeats)):
        idx = np.sort(rng.choice(n, size=min(size, n), replace=False))
        try:
            labels = HierarchicalPartitionerV71(k).fit_predict(v[idx])
            runs.append((idx, np.asarray(labels, dtype=int)))
        except Exception:
            continue
    scores = []
    for i in range(len(runs)):
        for j in range(i + 1, len(runs)):
            idx_a, lab_a = runs[i]
            idx_b, lab_b = runs[j]
            shared = np.intersect1d(idx_a, idx_b, assume_unique=True)
            if len(shared) < max(10, k * 2):
                continue
            pos_a = {int(x): p for p, x in enumerate(idx_a.tolist())}
            pos_b = {int(x): p for p, x in enumerate(idx_b.tolist())}
            a = np.asarray([lab_a[pos_a[int(x)]] for x in shared.tolist()])
            b = np.asarray([lab_b[pos_b[int(x)]] for x in shared.tolist()])
            scores.append(float(adjusted_rand_score(a, b)))
    return float(np.mean(scores)) if scores else 0.0


def graph_stability_v71(v, adj_by_k, k_neighbors, resolution, seed, repeats, min_size, fraction=.85):
    """Stability of the graph partition under resampling of the corpus."""
    v = np.asarray(v, dtype=np.float64)
    n = len(v)
    if n < 20 or repeats < 2:
        return 0.0
    rng = np.random.default_rng(int(seed))
    size = int(max(20, round(float(fraction) * n)))
    runs = []
    for _ in range(int(repeats)):
        idx = np.sort(rng.choice(n, size=min(size, n), replace=False))
        try:
            labels, _ = graph_partition_v71(v[idx], k_neighbors, resolution, int(seed), min_size)
            runs.append((idx, labels))
        except Exception:
            continue
    scores = []
    for i in range(len(runs)):
        for j in range(i + 1, len(runs)):
            idx_a, lab_a = runs[i]
            idx_b, lab_b = runs[j]
            shared = np.intersect1d(idx_a, idx_b, assume_unique=True)
            if len(shared) < 20:
                continue
            pos_a = {int(x): p for p, x in enumerate(idx_a.tolist())}
            pos_b = {int(x): p for p, x in enumerate(idx_b.tolist())}
            a = np.asarray([lab_a[pos_a[int(x)]] for x in shared.tolist()])
            b = np.asarray([lab_b[pos_b[int(x)]] for x in shared.tolist()])
            scores.append(float(adjusted_rand_score(a, b)))
    return float(np.mean(scores)) if scores else 0.0


# --- context-pattern selection ---------------------------------------------

_V71_SELECTION: Dict[str, Any] = {}


def _cluster_shape_stats_v71(labels, min_size):
    counts = Counter(np.asarray(labels).tolist())
    if not counts:
        return 0, 1.0, 0
    smallest = min(counts.values())
    small_share = float(sum(n for n in counts.values() if n < int(min_size)) / max(len(labels), 1))
    return int(smallest), small_share, len(counts)


def _candidate_row_v71(model, tl, vl, tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords,
                       stopwords, c, extra):
    tm = evaluate_clustering(tv, tl, ttexts, stopwords, c, signatures=tsigs)
    vm = evaluate_clustering(vv, vl, vtexts, stopwords, c, signatures=vsigs)
    rel_purity, _ = relation_structure_purity(vrecords, vl)
    smallest, small_share, k_public = _cluster_shape_stats_v71(tl, c.fine_min_cluster_size)
    row = {
        "candidate_k": int(k_public),
        "train_silhouette": tm.get("silhouette"),
        "validation_silhouette": vm.get("silhouette"),
        "validation_coherence": vm.get("semantic_coherence_npmi"),
        "validation_signature_purity": vm.get("signature_purity"),
        "validation_relation_structure_purity": rel_purity,
        "validation_balance_entropy": vm.get("balance_entropy"),
        "validation_largest_cluster_share": vm.get("largest_cluster_share"),
        "train_min_cluster_size": int(smallest),
        "train_small_cluster_share": float(small_share),
        "validation_assigned_fraction": 1.0,
    }
    row.update(extra)
    return row


def _graph_candidate_rows_v71(tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords, stopwords, c,
                              adj_by_k, members, resolutions, store, relax=False):
    rows = []
    lower = 2 if relax else max(2, c.fine_min_clusters)
    upper = max(2, len(tv) // max(1, c.fine_min_cluster_size)) if relax else max(2, c.fine_max_clusters)
    for k_neighbors in sorted(adj_by_k):
        consensus = coassociation_graph_v71(adj_by_k[k_neighbors], members)
        if consensus.nnz == 0:
            continue
        for res in resolutions:
            try:
                labels = leiden_communities_v71(consensus, resolution=float(res), seed=int(c.seed))
                labels = absorb_small_communities_v71(labels, tv, c.fine_min_cluster_size)
                k_found = len(set(labels.tolist()))
                if k_found < lower or k_found > upper:
                    continue
                model, tl = _make_model(
                    "snn_leiden_consensus_full_coverage",
                    {"k_neighbors": int(k_neighbors), "resolution": float(res)},
                    {"k_neighbors": int(k_neighbors), "resolution": float(res),
                     "ensemble_members": len(members), "coverage_contract": "full",
                     "n_clusters": int(k_found)},
                    labels, tv, c)
                vl, _, _, _, _, _ = _full_centroid_predict_v57(model, vv)
                support = consensus_support_v71(members, tl)
                stability = graph_stability_v71(tv, adj_by_k, k_neighbors, float(res),
                                                c.seed + 500, max(2, int(c.graph_stability_repeats)),
                                                c.fine_min_cluster_size,
                                                float(c.graph_subsample_fraction))
                rows.append(_candidate_row_v71(
                    model, tl, vl, tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords, stopwords, c,
                    {"k_neighbors": int(k_neighbors), "resolution": float(res),
                     "engine": "snn_leiden_consensus",
                     "graph_modularity": graph_modularity_v71(consensus, tl, float(res)),
                     "consensus_support_mean": float(np.mean(support)),
                     "stability_ari": float(stability)}))
                store[(int(k_neighbors), float(res))] = (model, tl, vl)
            except Exception as exc:
                LOGGER.debug("graph candidate k=%s res=%s failed: %s", k_neighbors, res, exc)
    return rows


def _hierarchical_candidate_rows_v71(tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords, stopwords,
                                     c, store):
    """Deterministic fallback when the corpus cannot support a usable graph."""
    rows = []
    upper = int(max(2, min(c.fine_max_clusters, len(tv) // max(1, c.fine_min_cluster_size))))
    for k in range(2, upper + 1):
        try:
            est = HierarchicalPartitionerV71(k, dense_limit=int(c.graph_dense_partition_limit))
            labels = est.fit_predict(tv)
            labels = absorb_small_communities_v71(labels, tv, c.fine_min_cluster_size)
            if len(set(labels.tolist())) < 2:
                continue
            model, tl = _make_model(
                "hierarchical_full_coverage_fallback", est,
                {"n_clusters": int(k), "coverage_contract": "full",
                 "fallback_reason": "shared_neighbour_graph_unusable"},
                labels, tv, c)
            vl, _, _, _, _, _ = _full_centroid_predict_v57(model, vv)
            stability = subsample_stability_v71(tv, k, c.seed + 500,
                                                max(2, int(c.graph_stability_repeats)),
                                                float(c.graph_subsample_fraction))
            rows.append(_candidate_row_v71(
                model, tl, vl, tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords, stopwords, c,
                {"k_neighbors": 0, "resolution": 0.0, "engine": "hierarchical_fallback",
                 "graph_modularity": 0.0, "consensus_support_mean": 0.0,
                 "stability_ari": float(stability)}))
            store[(0, float(k))] = (model, tl, vl)
        except Exception as exc:
            LOGGER.debug("hierarchical fallback k=%s failed: %s", k, exc)
    return rows


def fit_full_coverage_context_model_v71(tv, ttexts, tsigs, trecords, vv, vtexts, vsigs, vrecords,
                                        stopwords, c: ConfigV71):
    """Discover context patterns with a consensus of graph partitions.

    The neighbourhood size and the resolution are searched; the number of
    patterns is whatever the data supports at the winning setting. Every
    candidate is scored on held-out validation interactions using the same
    quality panel V5.7.2 used, so the choice stays comparable across versions.
    """
    n = int(len(tv))
    if n < max(12, 2 * c.fine_min_cluster_size):
        raise RuntimeError("Insufficient train interactions for graph context discovery.")

    neighbors = neighbor_grid_v71(n, c)
    resolutions = resolution_grid_v71(c)
    seeds = [int(c.seed + 1009 * i) for i in range(max(1, int(c.graph_ensemble_seeds)))]
    LOGGER.info("  context graph search: neighbours=%s resolutions=%s seeds=%d",
                neighbors, [round(r, 2) for r in resolutions], len(seeds))

    adj_by_k = {k: build_snn_graph_v71(tv, k) for k in neighbors}
    adj_by_k = {k: a for k, a in adj_by_k.items() if a.nnz > 0}
    if not adj_by_k:
        raise RuntimeError("Shared-neighbour graph is empty; corpus is too small or too sparse.")

    members = ensemble_partitions_v71(adj_by_k, resolutions, seeds)
    if not members:
        raise RuntimeError("No graph partition produced at least two communities.")
    LOGGER.info("  ensemble members: %d", len(members))

    store = {}
    relaxed_bounds = True
    rows = _graph_candidate_rows_v71(tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords, stopwords,
                                     c, adj_by_k, members, resolutions, store, relax=False)
    tab = pd.DataFrame(rows)
    if tab.empty and relaxed_bounds:
        # A thin corpus cannot support the configured pattern range. Accept any
        # partition with at least two well-supported communities rather than
        # stopping: the catalogue is smaller, and the report says why.
        LOGGER.warning("  no candidate inside [%d, %d] patterns; relaxing the range for this corpus.",
                       c.fine_min_clusters, c.fine_max_clusters)
        rows = _graph_candidate_rows_v71(tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords, stopwords,
                                         c, adj_by_k, members, resolutions, store, relax=True)
        tab = pd.DataFrame(rows)
    if tab.empty:
        # The shared-neighbour graph is unusable on this corpus (too few or too
        # uniform records). Fall back to deterministic hierarchical partitions
        # so the pipeline still produces a reviewable catalogue.
        LOGGER.warning("  graph engine unusable on this corpus; falling back to hierarchical partitioning.")
        rows = _hierarchical_candidate_rows_v71(tv, ttexts, tsigs, vv, vtexts, vsigs, vrecords,
                                                stopwords, c, store)
        tab = pd.DataFrame(rows)
    if tab.empty:
        raise RuntimeError("No full-coverage context candidate could be fit on this corpus.")

    tab["rank_silhouette"] = _safe_rank_v57(tab["validation_silhouette"], True)
    tab["rank_coherence"] = _safe_rank_v57(tab["validation_coherence"], True)
    tab["rank_signature"] = _safe_rank_v57(tab["validation_signature_purity"], True)
    tab["rank_relation_structure"] = _safe_rank_v57(tab["validation_relation_structure_purity"], True)
    tab["rank_balance"] = _safe_rank_v57(tab["validation_balance_entropy"], True)
    tab["rank_stability"] = _safe_rank_v57(tab["stability_ari"], True)
    tab["rank_support"] = _safe_rank_v57(tab["consensus_support_mean"], True)
    tab["rank_granularity"] = _safe_rank_v57(tab["candidate_k"], True)
    tab["support_factor"] = np.minimum(
        1.0, pd.to_numeric(tab["train_min_cluster_size"], errors="coerce").fillna(0)
        / max(c.fine_min_cluster_size, 1))
    tab["structural_valid"] = (
        (tab["train_min_cluster_size"] >= max(3, int(math.ceil(.60 * c.fine_min_cluster_size)))) &
        (tab["validation_largest_cluster_share"].fillna(1.0) <= max(.50, c.business_max_largest_cluster_share + .08)) &
        (tab["train_small_cluster_share"] <= .20)
    )
    # Same quality panel as V5.7.2, with ensemble agreement folded in: a pattern
    # is only worth publishing if the ensemble keeps putting the same
    # interactions together.
    tab["selection_score"] = (
        .20 * tab["rank_silhouette"] +
        .16 * tab["rank_coherence"] +
        .16 * tab["rank_signature"] +
        .09 * tab["rank_relation_structure"] +
        .15 * tab["rank_stability"] +
        .12 * tab["rank_support"] +
        .06 * tab["rank_balance"] +
        .06 * tab["rank_granularity"]
    ) * (.82 + .18 * tab["support_factor"])

    eligible = tab[tab["structural_valid"]].copy() if bool(tab["structural_valid"].any()) else tab.copy()
    best = eligible.sort_values(
        ["selection_score", "stability_ari", "consensus_support_mean",
         "validation_signature_purity", "candidate_k"],
        ascending=[False, False, False, False, False],
    ).iloc[0]
    key = (int(best["k_neighbors"]), float(best["resolution"]))
    if key not in store:
        key = sorted(store)[0]
    model, tl, vl = store[key]
    _V71_SELECTION.update({
        "engine": str(best.get("engine", "snn_leiden_consensus")),
        "k_neighbors": key[0], "resolution": key[1],
        "candidate_k": int(best["candidate_k"]),
        "ensemble_members": len(members),
        "neighbor_grid": neighbors, "resolution_grid": resolutions,
    })
    LOGGER.info("  selected context graph: neighbours=%d resolution=%.2f patterns=%d "
                "stability=%.3f support=%.3f",
                key[0], key[1], int(best["candidate_k"]),
                safe_float(best.get("stability_ari")), safe_float(best.get("consensus_support_mean")))
    return (model, tl, vl,
            tab.sort_values(["structural_valid", "selection_score"], ascending=[False, False]).reset_index(drop=True),
            best.to_dict())


def _partition_at_resolution_v71(consensus, v, resolution, seed, min_size):
    labels = leiden_communities_v71(consensus, resolution=float(resolution), seed=int(seed))
    labels = absorb_small_communities_v71(labels, v, min_size)
    return labels, len(set(labels.tolist()))


def resolution_for_target_v71(consensus, v, target_k, seed, min_size, lo=.05, hi=48.0, steps=14):
    """Find the resolution that yields the granularity selection settled on.

    Cluster count rises with resolution, so a bounded bisection gets there in a
    handful of fits. The refit has to reproduce the pattern count that was
    validated, otherwise the held-out numbers describe a model that was never
    shipped.
    """
    best = None
    seen = {}

    def evaluate(res):
        res = float(round(res, 5))
        if res not in seen:
            seen[res] = _partition_at_resolution_v71(consensus, v, res, seed, min_size)
        return seen[res]

    for res in (lo, hi):
        labels, found = evaluate(res)
        gap = abs(found - int(target_k))
        if best is None or gap < best[0]:
            best = (gap, res, labels, found)
    low, high = float(lo), float(hi)
    for _ in range(int(steps)):
        mid = math.sqrt(max(low, 1e-6) * max(high, 1e-6))
        labels, found = evaluate(mid)
        gap = abs(found - int(target_k))
        if gap < best[0]:
            best = (gap, mid, labels, found)
        if best[0] == 0:
            break
        if found < int(target_k):
            low = mid
        else:
            high = mid
    _, resolution, labels, found = best
    return labels, float(resolution), int(found)


def cluster_consensus_purity_v71(consensus, labels):
    """Mean ensemble agreement inside each published pattern.

    An edge weight in the consensus graph is the share of ensemble members that
    kept those two interactions together. Averaged inside a pattern it answers
    the only question an SME really has about a cluster: would these
    interactions still be grouped if the analysis were run again?
    """
    labels = np.asarray(labels, dtype=int)
    coo = sparse.triu(consensus, k=1).tocoo()
    if coo.nnz == 0:
        return {}
    same = labels[coo.row] == labels[coo.col]
    out = {}
    for cid in sorted(set(labels.tolist())):
        sel = same & (labels[coo.row] == cid)
        internal = coo.data[sel]
        external = coo.data[(~same) & ((labels[coo.row] == cid) | (labels[coo.col] == cid))]
        out[int(cid)] = {
            "internal_consensus": float(np.mean(internal)) if internal.size else 0.0,
            "external_consensus": float(np.mean(external)) if external.size else 0.0,
            "internal_edges": int(internal.size),
            "size": int(np.sum(labels == cid)),
        }
    return out


def refit_context_model_v71(dev_v: np.ndarray, k: int, c: ConfigV71):
    """Refit on development data at the granularity selection settled on.

    The consensus is rebuilt over the larger development corpus and the
    resolution is solved for, so the deployed model carries the same number of
    patterns the held-out validation measured.
    """
    target = int(k)
    neighbors = neighbor_grid_v71(len(dev_v), c)
    selected_k_neighbors = int(_V71_SELECTION.get("k_neighbors") or neighbors[len(neighbors) // 2])
    seeds = [int(c.seed + 2011 * i) for i in range(max(1, int(c.graph_ensemble_seeds)))]
    resolutions = resolution_grid_v71(c)
    adj_by_k = {kk: build_snn_graph_v71(dev_v, kk) for kk in neighbors}
    adj_by_k = {kk: a for kk, a in adj_by_k.items() if a.nnz > 0}
    if not adj_by_k:
        raise RuntimeError("Development shared-neighbour graph is empty.")
    members = ensemble_partitions_v71(adj_by_k, resolutions, seeds)
    if selected_k_neighbors not in adj_by_k:
        selected_k_neighbors = sorted(adj_by_k)[len(adj_by_k) // 2]
    base = adj_by_k[selected_k_neighbors]
    consensus = coassociation_graph_v71(base, members) if members else base

    labels, resolution, found = resolution_for_target_v71(
        consensus, dev_v, target, int(c.seed + 991), c.fine_min_cluster_size)
    smallest, small_share, _ = _cluster_shape_stats_v71(labels, c.fine_min_cluster_size)
    model, public = _make_model(
        "snn_leiden_consensus_full_coverage",
        {"k_neighbors": int(selected_k_neighbors), "resolution": float(resolution)},
        {"k_neighbors": int(selected_k_neighbors), "resolution": float(resolution),
         "coverage_contract": "full", "n_clusters": int(found),
         "requested_granularity": target, "refit_min_cluster_size": int(smallest),
         "refit_small_cluster_share": float(small_share),
         "ensemble_members": len(members)},
        labels, dev_v, c)
    _V71_SELECTION["refit_resolution"] = float(resolution)
    _V71_SELECTION["refit_clusters"] = int(found)
    _V71_SELECTION["cluster_consensus_purity"] = cluster_consensus_purity_v71(consensus, public)
    _V71_SELECTION["record_consensus_support"] = consensus_support_v71(members, public).tolist() if members else []
    if found != target:
        LOGGER.warning("  refit granularity %d differs from the validated %d; "
                       "held-out comparability is reduced.", found, target)
    LOGGER.info("  refit on development: resolution=%.3f patterns=%d (target %d) smallest=%d",
                resolution, found, target, smallest)
    return model, public


def consensus_stability_profile_v71(v: np.ndarray, reference: np.ndarray, k: int, seed: int, repeats: int):
    """Per-record agreement between the published partition and resampled runs.

    A record that keeps the same companions when the corpus is resampled is one
    an SME can trust; one that moves is flagged rather than quietly published.
    """
    reference = np.asarray(reference, dtype=int)
    n = len(reference)
    if n == 0:
        return np.zeros(0), {}, 0.0
    k_neighbors = int(_V71_SELECTION.get("k_neighbors") or max(8, int(round(math.sqrt(max(n, 4))))))
    resolution = float(_V71_SELECTION.get("refit_resolution") or _V71_SELECTION.get("resolution") or 1.0)
    rng = np.random.default_rng(int(seed))
    size = int(max(20, round(0.85 * n)))
    agree = np.zeros(n, dtype=float)
    seen = np.zeros(n, dtype=float)
    for r in range(max(2, int(repeats))):
        idx = np.sort(rng.choice(n, size=min(size, n), replace=False))
        try:
            labels, _ = graph_partition_v71(v[idx], k_neighbors, resolution, int(seed + 37 * r), 3)
            aligned = _align_run_to_reference_v57(reference[idx], labels)
            agree[idx] += (aligned == reference[idx]).astype(float)
            seen[idx] += 1.0
        except Exception:
            continue
    scores = np.divide(agree, np.maximum(seen, 1.0))
    scores[seen == 0] = 0.0
    per_cluster = {int(cid): float(np.mean(scores[reference == cid]))
                   for cid in sorted(set(reference.tolist()))}
    return scores, per_cluster, float(np.mean(scores))


