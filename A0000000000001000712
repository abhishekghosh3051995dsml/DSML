def parse_args_v572(argv=None):
    pre = argparse.ArgumentParser(add_help=False)
    pre.add_argument("--graph-neighbors", dest="graph_neighbor_grid",
                     help="Comma-separated neighbourhood sizes, or auto.")
    pre.add_argument("--graph-resolutions", dest="graph_resolution_grid",
                     help="Comma-separated Leiden resolutions, or auto.")
    pre.add_argument("--graph-ensemble-seeds", type=int)
    pre.add_argument("--graph-stability-repeats", type=int)
    pre.add_argument("--graph-subsample-fraction", type=float)
    pre.add_argument("--graph-max-neighbors", type=int)
    pre.add_argument("--graph-min-neighbors", type=int)
    pre.add_argument("--analytics-min-consensus-support", type=float)
    extra, remaining = pre.parse_known_args(argv)
    base = _parse_args_v71_base(remaining)
    data = asdict(base)
    for field_name in ("graph_neighbor_grid", "graph_resolution_grid", "graph_ensemble_seeds",
                       "graph_stability_repeats", "graph_subsample_fraction",
                       "graph_max_neighbors", "graph_min_neighbors",
                       "analytics_min_consensus_support"):
        value = getattr(extra, field_name, None)
        if value is not None:
            data[field_name] = value
    return ConfigV71(**data)


