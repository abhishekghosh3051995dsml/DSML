def residual_pii_findings(text):
    """Residual privacy scan with severity.

    Deterministic identifiers/address residue are HARD. Ambiguous proper names are
    SOFT review findings: they are useful to inspect but must not fail the
    analytics pipeline by themselves.
    """
    v=str(text or "");rows=[]
    for name,p in PII_PATTERNS:
        for m in p.finditer(v):
            rows.append({"type":name,"text":m.group(0)[:80],"source":"regex_residual","severity":"HARD"})
    for m in STREET_ADDRESS_RE.finditer(v):
        rows.append({"type":"address","text":m.group(0)[:100],"source":"address_residual","severity":"HARD"})
    for m in TEMPLATE_PERSON_RE.finditer(v):
        rows.append({"type":"person","text":m.group("name")[:80],"source":"template_person_residual","severity":"SOFT"})
    for m in PROPER_NAME_RESIDUAL_RE.finditer(v):
        phrase=normalize_space(m.group(0))
        if phrase not in PROPER_NAME_SAFE and not phrase.startswith("REDACTED") and not CALL_CENTER_RE.search(phrase):
            rows.append({"type":"possible_person_or_location","text":phrase[:80],"source":"proper_name_residual","severity":"SOFT"})
    return rows

def public_safe_phrase(text):
    """Return a display-safe phrase while preserving useful telecom semantics.

    HARD identifiers are already redacted upstream. Ambiguous title-case names or
    locations are masked only in public examples; this avoids suppressing an
    entire entity/context table because of a soft privacy review finding.
    """
    v=str(text or "")
    spans=[]
    for m in TEMPLATE_PERSON_RE.finditer(v):
        spans.append((*m.span("name"),"NAME_OR_LOCATION"))
    for m in PROPER_NAME_RESIDUAL_RE.finditer(v):
        phrase=normalize_space(m.group(0))
        if phrase not in PROPER_NAME_SAFE and not phrase.startswith("REDACTED") and not CALL_CENTER_RE.search(phrase):
            spans.append((m.start(),m.end(),"NAME_OR_LOCATION"))
    return _apply_matches(v,spans) if spans else normalize_space(v)

