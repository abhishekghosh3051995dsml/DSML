V572_GENERIC_CAUSE = {"root cause", "root cause issue", "root cause problem", "cause issue", "cause problem", "primary root cause"}


def _cause_payload(statement: str) -> str:
    s = normalize_space(statement)
    if CAUSE_UNKNOWN_RE.search(s):
        return "cause not determined"
    if CAUSE_RULED_OUT_RE.search(s):
        m = re.search(r"(?i)\b(?:ruled\s+out|not\s+caused\s+by|no\s+evidence\s+of|unlikely\s+(?:caused\s+by|due\s+to))\s+(.+)$", s)
        return canonicalize_surface_v571(m.group(1)) if m else "cause ruled out"
    matches = list(V572_CAUSE_PREFIX_RE.finditer(s))
    payload = normalize_space(s[matches[-1].end():] if matches else "")
    if not payload:
        return ""
    payload = re.split(r"(?i)\b(?:recommend(?:ed|ation)?|next\s+step|resolved\s+by|remediat(?:e|ion)|follow[- ]?up|escalat(?:e|ed|ion))\b", payload, maxsplit=1)[0]
    payload = canonicalize_surface_v571(payload)
    content = [t for t in tokenize(payload) if t not in V572_CAUSE_STOP and t not in SAFE_ENGLISH_STOPWORDS and t not in BACKGROUND_TERMS]
    if len(content) < 2 or normalize_term(payload) in V572_GENERIC_CAUSE:
        return ""
    return payload


def _valid_cause(statement: str, status: str) -> bool:
    return status in {"NOT_DETERMINED", "RULED_OUT"} or bool(_cause_payload(statement))


