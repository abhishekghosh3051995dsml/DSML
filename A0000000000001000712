def _contains_hard_pii(value)->bool:
    v=str(value or "")
    for _,p in PII_PATTERNS:
        if p.search(v):return True
    return bool(STREET_ADDRESS_RE.search(v) or SENSITIVE_FIELD_RE.search(v))

