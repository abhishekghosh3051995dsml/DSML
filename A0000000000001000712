    return canonical or surface, conf, method


def _normalize_measurement_key_v571(raw_key: str, unit: str) -> Optional[str]:
    key = normalize_space(re.sub(r"(?i)^\s*(?:checked?|verified?|queried?|retrieved?|returned?|observed?|measured?)\s+", "", raw_key)).strip(" :-")
    norm = normalize_term(key)
    toks = tokenize(norm)
    if not toks:
        return None
    unit_norm = normalize_term(unit)
    # Durations such as "no internet for 2 hours" are temporal context, not metrics.
    if unit_norm in _V571_DURATION_UNITS:
        if len(toks) > 2 or IMPACT_CUE_RE.search(key) or toks[-1:] == ["for"] or "since" in toks:
            return None
        if norm not in {"latency", "response time", "duration", "uptime", "downtime", "time"}:
            return None
    for phrase in _V571_METRIC_PHRASES:
        if re.search(rf"(?i)(?:^|\b){re.escape(phrase)}(?:$|\b)", norm):
            return phrase
    # Unknown measurement keys are accepted only when short and noun-like.
    if len(toks) <= 3 and _valid_key(norm) and not IMPACT_CUE_RE.search(norm) and not REQUEST_CUE_RE.search(norm):
        return norm
    return None


def extract_observations(text, ref):
    """V5.7.1 observation extraction with conservative numeric-key binding."""
    attrs, meas = [], []
    for m in MEASUREMENT_RE.finditer(text):
        unit = normalize_space(m.group("unit"))
        key = _normalize_measurement_key_v571(m.group("key"), unit)
        if not key:
            continue
        try:
            value = float(m.group("value"))
        except Exception:
            continue
        meas.append({"key": key, "normalized_key": normalize_term(key), "value": value, "unit": unit,
                     "evidence_strength": .97, "method": "v571_validated_numeric_measurement", "evidence_ref": ref})
    for m in KV_RE.finditer(text):
        k = normalize_space(m.group("key")); v = normalize_space(m.group("value"))
        if not _valid_key(k) or not v or len(tokenize(v)) > 16:
            continue
        # Avoid turning whole problem statements into attribute keys.
        if IMPACT_CUE_RE.search(k) or REQUEST_CUE_RE.search(k) or len(tokenize(k)) > 5:
            continue
        if any(x["normalized_key"] == normalize_term(k) for x in meas):
            continue
        attrs.append({"key": k, "normalized_key": normalize_term(k), "value": v,
                      "normalized_value": normalize_term(v), "evidence_strength": .88,
                      "method": "validated_explicit_attribute", "evidence_ref": ref})
    for m in ERROR_CODE_RE.finditer(text):
        attrs.append({"key": "error_code", "normalized_key": "error_code", "value": m.group(1),
                      "normalized_value": m.group(1).upper(), "evidence_strength": .94,
                      "method": "error_code_pattern", "evidence_ref": ref})
    return dedupe_dicts(attrs, ("normalized_key", "normalized_value", "evidence_ref")), dedupe_dicts(meas, ("normalized_key", "value", "unit", "evidence_ref"))


def _canonical_device_model_v571(surface: str, explicit: bool) -> Optional[str]:
    raw = [x.strip(".,;:()[]{}") for x in normalize_space(surface).split() if x.strip(".,;:()[]{}")]
    if not raw:
        return None
    reject = set(NETWORK_TECH_CUES) | {"ghz","mhz","khz","mbps","gbps","kbps","dbm","db","rsrp","rsrq","sinr","pci","band","cell","site","tower","router","gateway","modem","phone","device","handset","watch","tablet"}
    kept = []
    for token in raw:
        n = normalize_term(token)
        if n in reject and kept:
            break
        if n in reject and not kept:
            continue
        kept.append(token)
    if not kept:
        return None
    mixed = [t for t in kept if re.search(r"[A-Za-z]", t) and re.search(r"\d", t)]
    alpha = [t for t in kept if re.search(r"[A-Za-z]", t) and not re.search(r"\d", t)]
    numeric = [t for t in kept if re.fullmatch(r"\d+[A-Za-z]?", t)]
    if mixed:
        # Preserve a short vendor/family token immediately before a model token.
        j = kept.index(mixed[0]); start = max(0, j - 1) if j > 0 and kept[j-1] in alpha else j
        return normalize_space(" ".join(kept[start:j+1]))
    if explicit and alpha and numeric:
        j = kept.index(numeric[0]); start = max(0, j - 1)
        return normalize_space(" ".join(kept[start:j+1]))
    return None


