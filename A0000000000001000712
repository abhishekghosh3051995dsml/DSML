_build_relationships_v572_pre_participant = build_relationships_v572
def build_relationships_v572_participant_safe(participants, entities, contexts, attributes, measurements, causes, remediations, interaction_ref, problem_text, min_confidence=.72, max_resources_per_context=1, max_relations_per_evidence=12):
    rows = _build_relationships_v572_pre_participant(participants, entities, contexts, attributes, measurements, causes, remediations, interaction_ref, problem_text, min_confidence, max_resources_per_context, max_relations_per_evidence)
    problem_label = normalize_space(problem_text) or "customer problem"
    problem_ref = "interaction:" + str(interaction_ref)
    reporters = [p for p in participants if p.get("participant") in {"user", "customer"} and p.get("participant_semantics") == "canonical_participant"]
    if reporters:
        reporter = reporters[0]
        if not any(r.get("predicate") == "REPORTS_PROBLEM" for r in rows):
            rows.append(_relation_row(interaction_ref, "PARTICIPANT", reporter.get("participant"), "REPORTS_PROBLEM", "CUSTOMER_PROBLEM", problem_label, .98, problem_ref, "interaction_problem_anchor"))
        by_ref_entities = defaultdict(list); by_ref_context = defaultdict(list)
        for e in entities:
            if str(e.get("entity_type")) in RELATION_RESOURCE_TYPES:
                by_ref_entities[str(e.get("evidence_ref", ""))].append(e)
        for x in contexts:
            by_ref_context[str(x.get("evidence_ref", ""))].append(x)
        for p in reporters:
            ref = str(p.get("evidence_ref", ""))
            for sym in [x for x in by_ref_context.get(ref, []) if x.get("context_type") == "SYMPTOM_OR_IMPACT"][:3]:
                rows.append(_relation_row(interaction_ref, "PARTICIPANT", p.get("participant"), "EXPERIENCES", "SYMPTOM_OR_IMPACT", sym.get("summary_phrase") or sym.get("statement", ""), min(safe_float(p.get("evidence_strength"), .8), safe_float(sym.get("evidence_strength"), .8)), ref, "same_evidence_participant_symptom"))
            for e in _top_resources_v571(by_ref_entities.get(ref, []), problem_label, max_resources_per_context):
