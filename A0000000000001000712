def cluster_quality_audit_v571(records, vectors, labels, descriptions, c: ConfigV57, level: str, analysis_by_ref=None):
    labels = np.asarray(labels, dtype=int); rows=[]; total=max(len(labels),1)
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx=np.flatnonzero(labels==cid); subset=[records[i] for i in idx.tolist()]
        cent=np.asarray(vectors[idx].mean(axis=0),float); cent=cent/max(float(np.linalg.norm(cent)),1e-12); cohesion=float(np.mean(vectors[idx]@cent)) if len(idx) else 0.0
        sig,_=signature_purity([records[i].get("_semantic_signature","") for i in idx.tolist()], np.ones(len(idx),dtype=int)); rel,_=relation_structure_purity(subset,np.ones(len(idx),dtype=int))
        low=0.0
        if analysis_by_ref:
            vals=[analysis_by_ref.get(str(records[i].get("interaction_ref")),{}).get("confidence_band") == "LOW" for i in idx.tolist()]
            low=float(np.mean(vals)) if vals else 0.0
        weak_reasons=[]
        if cohesion < c.analytics_min_cluster_cohesion: weak_reasons.append("cohesion")
        if safe_float(sig,0) < c.analytics_min_cluster_signature_purity: weak_reasons.append("signature_purity")
        if safe_float(rel,0) < c.analytics_min_cluster_relation_purity: weak_reasons.append("relation_structure_purity")
        undersized = len(idx) < c.fine_min_cluster_size if level == "context_pattern" else False
        rows.append({"level":level, "cluster_id":cid, "meaning":descriptions.get(cid,{}).get("descriptor",f"cluster_{cid}"), "count":len(idx), "share":len(idx)/total, "cohesion":cohesion, "signature_purity":sig, "relation_structure_purity":rel, "low_confidence_fraction":low, "undersized":undersized, "weak":bool(weak_reasons), "weak_reasons":";".join(weak_reasons)})
    return pd.DataFrame(rows)


