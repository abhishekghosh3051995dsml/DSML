def stable_seed(namespace: str, base_seed: int) -> int:
    """Stable process-independent seed; avoids Python's randomized hash()."""
    digest = hashlib.sha256(f"{base_seed}|{namespace}".encode("utf-8")).digest()
    return int.from_bytes(digest[:4], "big") % (2**31 - 1)



def _safe_rank_v57(series: pd.Series, higher: bool = True) -> pd.Series:
    s = pd.to_numeric(series, errors="coerce")
    if not s.notna().any():
        return pd.Series(np.zeros(len(s)), index=s.index, dtype=float)
    fill = float(s.median())
    return percentile_rank(s.fillna(fill), higher)


def _full_centroid_predict_v57(model: ClusterModel, v: np.ndarray):
    """Full-coverage nearest-centroid assignment.

    Confidence is measured, never converted to an outlier merely because the
    margin is low. -1 remains reserved for genuinely non-clusterable records.
    """
    ids = sorted(int(x) for x in model.centroid_vectors)
    n = len(v)
    if not ids or n == 0:
        return (
            np.full(n, -1, dtype=int), np.zeros(n), np.full(n, -1, dtype=int),
            np.zeros(n), np.zeros(n), np.asarray(["not_clusterable"] * n, dtype=object)
        )
    mat = np.vstack([model.centroid_vectors[i] for i in ids])
    sims = np.asarray(v @ mat.T, dtype=float)
    order = np.argsort(sims, axis=1)[:, ::-1]
    primary = np.empty(n, dtype=int)
    secondary = np.full(n, -1, dtype=int)
    pscore = np.zeros(n, dtype=float)
    sscore = np.zeros(n, dtype=float)
    margin = np.zeros(n, dtype=float)
    for i in range(n):
        j = int(order[i, 0])
        primary[i] = ids[j]
        pscore[i] = float(sims[i, j])
        if len(ids) > 1:
            j2 = int(order[i, 1])
            secondary[i] = ids[j2]
            sscore[i] = float(sims[i, j2])
        margin[i] = pscore[i] - sscore[i]
    return primary, pscore, secondary, sscore, margin, np.asarray(["pattern_prototype_similarity_full_coverage"] * n, dtype=object)


