# In production the telecom vocabulary is supplied through a versioned JSON
# rule pack. The rule pack is explicitly *not* an ontology; ontology integration
# remains deferred until an approved NORA/TM Forum source is supplied.

# Preserve digit-leading radio-generation tokens (5g/4g/3g) without admitting
# arbitrary numeric IDs into the NLP vocabulary.
TOKEN_RE = re.compile(r"(?ui)\b(?:[345]g|[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,})\b")

_V572_RULE_PACK: Dict[str, Any] = {}
_V572_RULE_PACK_PATH: Optional[Path] = None
_V572_RULE_PACK_SHA256: Optional[str] = None
_V572_ENTITY_RULES: List[Dict[str, Any]] = []

def _default_rules_path_v572() -> Path:
    return Path(__file__).resolve().with_name("nora_entity_context_v5_7_2_rules.json")

def _validated_rule_pack_v572(raw: Mapping[str, Any]) -> Dict[str, Any]:
    z = dict(raw or {})
    version = str(z.get("rule_pack_version", "")).strip()
    if not version.startswith("5.7.2"):
        raise ValueError(f"Rule pack version must start with 5.7.2; got {version!r}")
    rules = list(z.get("entity_rules", []) or []) + list(z.get("tmobile_specific_entities", []) or [])
    cleaned = []
    for row in rules:
        if not isinstance(row, Mapping):
            continue
        et = normalize_space(row.get("entity_type", "")).upper()
        canonical = normalize_term(row.get("canonical", ""))
        aliases = row.get("aliases", []) or []
        if isinstance(aliases, str):
            aliases = [aliases]
        aliases = [normalize_term(x) for x in aliases if normalize_term(x)]
        conf = safe_float(row.get("confidence"), .90)
        if not et or not canonical:
            continue
        cleaned.append({"entity_type": et, "canonical": canonical, "aliases": aliases, "confidence": float(np.clip(conf, 0.0, .995))})
    if not cleaned:
        raise ValueError("Rule pack contains no valid entity_rules/tmobile_specific_entities.")
    z["_clean_entity_rules"] = cleaned
    return z

def configure_rule_pack_v572(c: ConfigV572) -> Dict[str, Any]:
    global _V572_RULE_PACK, _V572_RULE_PACK_PATH, _V572_RULE_PACK_SHA256, _V572_ENTITY_RULES
    requested = normalize_space(getattr(c, "rules_path", None) or os.environ.get("NORA_V572_RULES", ""))
    path = Path(requested).expanduser() if requested else _default_rules_path_v572()
    if not path.exists():
        if c.profile == "production" and bool(getattr(c, "require_rule_pack", True)):
            raise FileNotFoundError(
                f"Production profile requires the V5.7.2 rule pack. Expected: {path}. "
                "Place nora_entity_context_v5_7_2_rules.json beside the script or pass --rules <path>."
            )
        LOGGER.warning("V5.7.2 rule pack not found; fast-dev conservative built-ins will be used: %s", path)
        _V572_RULE_PACK, _V572_RULE_PACK_PATH, _V572_RULE_PACK_SHA256, _V572_ENTITY_RULES = {}, None, None, []
        return {}
    raw = json.loads(path.read_text(encoding="utf-8"))
    z = _validated_rule_pack_v572(raw)
    _V572_RULE_PACK, _V572_RULE_PACK_PATH, _V572_RULE_PACK_SHA256 = z, path.resolve(), sha256_file(path)
    _V572_ENTITY_RULES = list(z.get("_clean_entity_rules", []))

    # Externalize the most important precision controls. Built-ins remain safe
    # fallback defaults for fast-dev only.
    taxonomy = dict(z.get("network_taxonomy", {}) or {})
    if taxonomy:
        globals()["V572_NETWORK_TECH"] = {normalize_term(x) for x in taxonomy.get("NETWORK_TECHNOLOGY", []) if normalize_term(x)}
        globals()["V572_NETWORK_PROTOCOL"] = {normalize_term(x) for x in taxonomy.get("NETWORK_PROTOCOL", []) if normalize_term(x)}
        globals()["V572_NETWORK_CONFIGURATION"] = {normalize_term(x) for x in taxonomy.get("NETWORK_CONFIGURATION", []) if normalize_term(x)}
        globals()["V572_SERVICE_CAPABILITY"] = {normalize_term(k): normalize_term(v) for k, v in dict(taxonomy.get("SERVICE_CAPABILITY", {}) or {}).items() if normalize_term(k) and normalize_term(v)}
    rejects = z.get("device_model_reject_exact")
    if rejects:
        globals()["V572_REJECT_DEVICE_MODEL_EXACT"] = {normalize_term(x) for x in rejects if normalize_term(x)}
    block = z.get("metric_key_blocklist")
    if block:
        globals()["V572_METRIC_KEY_BLOCKLIST"] = {normalize_term(x) for x in block if normalize_term(x)}
    families = dict(z.get("metric_families", {}) or {})
    mapping = {
        "radio": "V572_RADIO_METRICS", "speed": "V572_SPEED_METRICS", "time": "V572_TIME_METRICS",
        "percent": "V572_PERCENT_METRICS", "frequency": "V572_FREQ_METRICS",
        "electrical": "V572_ELECTRICAL_METRICS", "volume": "V572_VOLUME_METRICS",
    }
    for family, gname in mapping.items():
        if family in families:
            globals()[gname] = {normalize_term(x) for x in families.get(family, []) if normalize_term(x)}

    # New typed resources are valid structural relation resources.
    for et in {x["entity_type"] for x in _V572_ENTITY_RULES}:
        if et not in {"ORGANIZATION"}:
            STRUCTURAL_ENTITY_TYPES.add(et)
            RELATION_RESOURCE_TYPES.add(et)
    LOGGER.info("Loaded V5.7.2 rule pack version=%s rules=%d sha256=%s", z.get("rule_pack_version"), len(_V572_ENTITY_RULES), _V572_RULE_PACK_SHA256[:12])
    return z

def extract_bootstrap_domain_entities_v572_configured(text: str, ref: str):
    # Production route: exact phrase/alias matching from the external versioned
    # rule pack. This supports T-Mobile-specific additions without code edits.
    if _V572_ENTITY_RULES:
        n = " " + normalize_term(text) + " "
        rows = []
        for rule in _V572_ENTITY_RULES:
            aliases = [rule["canonical"]] + list(rule.get("aliases", []))
            matched = next((a for a in sorted(set(aliases), key=lambda x: len(x.split()), reverse=True) if a and f" {a} " in n), None)
            if matched:
                rows.append({
                    "surface": matched, "canonical_name": rule["canonical"], "entity_type": rule["entity_type"],
                    "evidence_strength": rule["confidence"], "method": "v572_configured_domain_rule", "evidence_ref": ref,
                    "rule_pack_version": _V572_RULE_PACK.get("rule_pack_version"),
                })
        return dedupe_dicts(rows, ("canonical_name", "entity_type", "evidence_ref"))
    return extract_bootstrap_domain_entities_v572(text, ref)

# Preserve USER, CUSTOMER and CALL CENTER as distinct participant concepts.
# The message role may still normalize to "customer" for downstream grouping,
# but participant semantics are never collapsed into a user->customer alias.
def extract_participants_v572(text, role, role_source, ref):
    rows = []
    src = str(role_source or "")
    def add(name, strength, method, semantics):
        rows.append({"participant": name, "participant_semantics": semantics, "evidence_strength": strength, "method": method, "evidence_ref": ref})
    if role == "assistant":
        add("assistant", .99, "interaction_role", "canonical_participant")
    elif role == "customer":
        if re.search(r"\buser\b", src, re.I):
            add("user", .99, "source_role", "canonical_participant")
        elif re.search(r"\b(customer|subscriber|human)\b", src, re.I):
            add("customer", .99, "source_role", "canonical_participant")
        else:
            add("customer", .96, "normalized_interaction_role", "canonical_participant")
    if USER_MENTION_RE.search(str(text)):
        add("user", .94, "explicit_mention", "explicit_mention")
    if CUSTOMER_MENTION_RE.search(str(text)):
        add("customer", .94, "explicit_mention", "explicit_mention")
    if CALL_CENTER_RE.search(f"{src} {text}"):
        add("call center", .95, "explicit_mention", "service_channel")
    return dedupe_dicts(rows, ("participant", "participant_semantics", "evidence_ref"))

def participant_summary_table_v572(records):
    interactions = Counter(); mentions = Counter(); semantics = defaultdict(Counter)
    for r in records:
        seen = set()
        for e in r.get("participant_evidence", []):
            name = normalize_space(e.get("participant", "")); sem = str(e.get("participant_semantics", "unspecified"))
            if not name:
                continue
            mentions[name] += 1; semantics[name][sem] += 1; seen.add(name)
        for name in seen:
            interactions[name] += 1
    return pd.DataFrame([{
        "participant": name, "interaction_count": count, "mention_count": mentions[name],
        "semantics": "; ".join(f"{k}:{v}" for k, v in semantics[name].most_common())
    } for name, count in interactions.most_common()])

# The V5.7.1 relation builder anchored only a canonical "customer". V5.7.2
# anchors whichever reporter was actually observed: USER or CUSTOMER, without
