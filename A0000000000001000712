            # free-text surface. This is deliberately field-level, not a global
            # suppression switch.
            if "statement" in item:item["statement"]=public_safe_phrase(item.get("statement",""))
            if "summary_phrase" in item:item["summary_phrase"]=public_safe_phrase(item.get("summary_phrase",""))
        out.append(item)
