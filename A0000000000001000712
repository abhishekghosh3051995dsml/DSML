def _workflow_signature_v57(r):
    toks = ["participant_" + normalise_key(x) for x in r.get("participants", []) if normalize_space(x)]
    seq = []
    for x in r.get("context", []):
        ct = normalise_key(x.get("context_type", ""))
        if ct:
            seq.append(ct); toks.append("ctx_" + ct)
    for a, b in zip(seq, seq[1:]):
        toks.append(f"transition_{a}__{b}")
    for rel in r.get("relationships", []):
        if rel.get("grounding_status") != "GROUNDED":
            continue
        p = normalise_key(rel.get("predicate", ""))
        if p:
            toks.append("pred_" + p)
    for rc in r.get("root_cause", []):
        st = normalise_key(rc.get("status", ""))
        if st:
            toks.append("rc_" + st)
    if r.get("remediation"):
        toks.append("has_remediation")
    if r.get("diagnostic_evidence"):
        toks.append("has_diagnostic")
    return " ".join(toks) if toks else "workflow_none"


def _entity_profile_signature_v57(r):
    toks, pairs = [], []
    for e in r.get("entities", []):
        et = normalise_key(e.get("entity_type", "")); name = normalise_key(e.get("canonical_name", ""))
        if et:
