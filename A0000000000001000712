def _canonical_device_model_v572(surface: str, explicit: bool) -> Optional[str]:
    raw = [x.strip(".,;:()[]{}") for x in normalize_space(surface).split() if x.strip(".,;:()[]{}")]
    if not raw:
        return None
    prefix = []
    for t in raw:
        if _invalid_model_token(t):
            break
        prefix.append(t)
    raw = prefix
    if not raw:
        return None
    mixed = [t for t in raw if re.search(r"[A-Za-z]", t) and re.search(r"\d", t) and not V572_RADIO_BAND_RE.fullmatch(normalize_term(t))]
    if mixed:
        j = raw.index(mixed[0])
        start = max(0, j - 1)
        if start < j and _invalid_model_token(raw[start]):
            start = j
        candidate = normalize_space(" ".join(raw[start:j + 1]))
        return candidate if len(tokenize(candidate)) <= 3 else None
    if explicit and len(raw) >= 2:
        alpha = [t for t in raw if re.search(r"[A-Za-z]", t)]
        numeric = [t for t in raw if re.search(r"\d", t)]
        if alpha and numeric and all(not _invalid_model_token(t) for t in raw[:2]):
            candidate = normalize_space(" ".join(raw[:2]))
            return candidate if len(tokenize(candidate)) <= 3 else None
    return None


