    if fam == "electrical": return n in V572_ELECTRICAL_METRICS
    if fam == "volume": return n in V572_VOLUME_METRICS or "usage" in n or "volume" in n
    if fam == "duration": return n in {"latency", "response time", "duration", "uptime", "downtime"}
    allowed = V572_RADIO_METRICS | V572_SPEED_METRICS | V572_TIME_METRICS | V572_PERCENT_METRICS | V572_FREQ_METRICS | V572_ELECTRICAL_METRICS | V572_VOLUME_METRICS
