def best_jaccard(ref, other):
    return {c: max(((ref == c) & (other == o)).sum() / ((ref == c) | (other == o)).sum() for o in np.unique(other)) for c in np.unique(ref)}


def kmedoids(Dm, k, rng, iters=100):
    m = len(Dm)
    med = [int(rng.integers(m))]
    for _ in range(1, k):
        p = Dm[:, med].min(1) ** 2
        p = p / p.sum() if p.sum() > 0 else np.where(np.isin(np.arange(m), med), 0, 1) / (m - len(med))
        med.append(int(rng.choice(m, p=p)))
    med = np.array(med)
    for _ in range(iters):
        lab = Dm[:, med].argmin(1)
        new = med.copy()
        for c in range(k):
            mem = np.flatnonzero(lab == c)
            if len(mem):
                new[c] = mem[Dm[np.ix_(mem, mem)].sum(1).argmin()]
        if np.array_equal(new, med):
            break
        med = new
    lab = Dm[:, med].argmin(1)
    return lab, float(Dm[np.arange(m), med[lab]].sum())


def latent_classes(Xb, P0, k, rng, iters=1000):
    m = len(Xb)
    R = rng.dirichlet(np.ones(k), m)
    prev = -np.inf
    for it in range(iters):
        Nk = R.sum(0)
        theta = np.clip((R.T @ Xb + P0) / (Nk[:, None] + 1), 1e-12, 1 - 1e-12)
        L = Xb @ np.log(theta).T + (1 - Xb) @ np.log(1 - theta).T + np.log(Nk / m + 1e-300)
        norm = logsumexp(L, 1, keepdims=True)
        R = np.exp(L - norm)
        objective = float(norm.sum() + (P0 * np.log(theta) + (1 - P0) * np.log(1 - theta)).sum())
        if it > 10 and abs(objective - prev) <= 1e-9 * abs(objective):
            break
        prev = objective
    return R.argmax(1), objective


