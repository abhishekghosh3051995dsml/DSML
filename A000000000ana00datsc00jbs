# %% Phase 4 - unusual interactions (isolation forest), kept but not allowed to shape the classes

section("PHASE 4  Unusual interactions (isolation forest)")
shape = np.log1p(per[["agents", "agent_turns", "api_calls", "distinct_apis", "retries", "repeat_new_input", "errors"]].astype(float).values)
iso = IsolationForest(n_estimators=500, random_state=args.seed).fit(shape)
per["unusual_score"] = -iso.score_samples(shape)
q1, q3 = np.percentile(per["unusual_score"], [25, 75])
fence = q3 + 1.5 * (q3 - q1)
per["unusual"] = per["unusual_score"] > fence
overview("4. Unusual interactions", "Interactions flagged as unusual", f"{int(per['unusual'].sum()):,} ({pct(per['unusual'].mean())})",
         "Isolation forest scores each interaction on agents, agent turns, API calls, distinct APIs, retries, repeated calls and errors; "
         "scores beyond the standard box-plot fence (Q3 + 1.5 IQR) are unusual. They get a class but do not shape the classes")

