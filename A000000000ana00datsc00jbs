from openpyxl import load_workbook
from openpyxl.cell.cell import ILLEGAL_CHARACTERS_RE
from openpyxl.styles import Alignment, Font, PatternFill


def write(path, sheets, wrap):
    with pd.ExcelWriter(path, engine="openpyxl") as xw:
        for name, frame in sheets.items():
            frame.map(lambda v: ILLEGAL_CHARACTERS_RE.sub("", v)[:32000] if isinstance(v, str) else v).to_excel(xw, sheet_name=name[:31], index=False)
    wb = load_workbook(path)
    for ws in wb.worksheets:
        ws.freeze_panes = "B2"
        ws.auto_filter.ref = ws.dimensions
        for j, cell in enumerate(ws[1], start=1):
            cell.font, cell.fill = Font(bold=True, color="FFFFFF"), PatternFill("solid", fgColor="1C5CAB")
            cell.alignment = Alignment(vertical="center", wrap_text=True)
            width = max(len(str(ws.cell(i, j).value or "")) for i in range(1, min(ws.max_row, 100) + 1))
            ws.column_dimensions[cell.column_letter].width = max(12, min(60, width + 2))
        if ws.title in wrap:
            for row in ws.iter_rows(min_row=2):
                for cell in row:
                    cell.alignment = Alignment(wrap_text=True, vertical="top")
    wb.save(path)


