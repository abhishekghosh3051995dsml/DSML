# %% PHASE 4 - Hand-off detection: a call whose name is another agent's name (words shared by several agent names ignored)

section("PHASE 4  Hand-off detection")


def words(x):
    return {w for w in re.split(r"[^0-9a-z]+", str(x).lower()) if w}


AGENTS = sorted(a for a in calls[AGENT].unique() if a != UNKNOWN)
shared = Counter(w for a in AGENTS for w in words(a))
GENERIC = {w for w, k in shared.items() if k > 1}
OWN = {a: words(a) - GENERIC for a in AGENTS}
HANDOFF, detect = {}, []
for t in sorted(calls[TOOL].astype(str).unique()):
    tw = words(t)
    hits = [a for a in AGENTS if OWN[a] and OWN[a] <= tw and tw - OWN[a] <= GENERIC]
    if len(hits) != 1:
        continue
    callers = calls.loc[calls[TOOL] == t, AGENT]
    if (callers != hits[0]).mean() <= MAJORITY:
        continue
    HANDOFF[t] = hits[0]
    detect.append({"Hand-off call": t, "Agent it names": hits[0], "Words only this agent's name has": ", ".join(sorted(OWN[hits[0]])),
                   "Made by": " · ".join(f"{a} ({k:,})" for a, k in callers.value_counts().items())})
calls["is_handoff"] = calls[TOOL].isin(list(HANDOFF))
HO = calls[calls["is_handoff"]]
DISP = HO.groupby(CASE)[TOOL].agg(set).to_dict()                                             # hand-offs per interaction
HO_FIRST = HO.groupby([CASE, TOOL])["call_no"].min().to_dict()
WORK = calls[~calls["is_handoff"]]
RAN = WORK.groupby(CASE)[AGENT].agg(set).to_dict()                                           # agents that did work
AG_FIRST = WORK.groupby([CASE, AGENT])["call_no"].min().to_dict()
AGENT_TASKS = WORK.groupby(AGENT)["task"].agg(lambda s: sorted(set(s))).to_dict()
calls["system"] = np.where(calls["is_handoff"], "hand-off", calls[TOOL].map(API_SYSTEM).fillna("not recorded"))
fact("handoffs", ", ".join(HANDOFF) or "none", "Hand-off calls found")
fact("coordinator", " · ".join(f"{a} ({k:,})" for a, k in HO[AGENT].value_counts().items()) or "none", "Agent(s) making the hand-offs")
fact("handoff_calls", int(calls["is_handoff"].sum()), "Hand-off calls")
fact("api_calls", int((~calls["is_handoff"]).sum()), "API calls (tool calls that fetch from a system)")

# %% PHASE 5 - The model (learned only from the interactions it is given)
#   (a) hand-off test   which hand-offs bring work that does not happen otherwise (Fisher's exact test + Benjamini-Hochberg)
#   (b) classes         interaction class = exact set of hand-offs that bring work
#   (c) task DAGs       standard plan + one sub-plan per hand-off: Heuristics Miner dependency + binomial test + BH, cycles broken, transitive reduction, stages

section("PHASE 5  The model")


def fisher_greater(a, b, c, d):
    return fisher_exact([[a, b], [c, d]], alternative="greater")


def handoff_test(ids):
    ids_set, m = set(ids), len(ids)
    rows, task_rows = [], []
    for t, ag in HANDOFF.items():
        handed = {c for c in ids if t in DISP.get(c, ())}
        nd, nn = len(handed), m - len(handed)
        ran = {c for c in ids if ag in RAN.get(c, ())}
        both, without = len(handed & ran), len(ran - handed)
        odds, p = fisher_greater(both, nd - both, without, nn - without) if nd and nn else (np.nan, np.nan)
        rows.append({"t": t, "a": ag, "nd": nd, "nn": nn, "with": both / nd if nd else np.nan, "without": without / nn if nn else np.nan,
                     "odds": odds, "p": p})
        for task in AGENT_TASKS.get(ag, []):
            tw = sum(1 for c in handed if task in TASKS[c])
            to = sum(1 for c in ids_set - handed if task in TASKS[c])
            _, tp = fisher_greater(tw, nd - tw, to, nn - to) if nd and nn else (np.nan, np.nan)
            task_rows.append({"t": t, "task": task, "with": tw / nd if nd else np.nan, "without": to / nn if nn else np.nan, "p": tp,
                              "home": tw / (tw + to) if tw + to else np.nan})
    for r, q in zip(rows, bh([r["p"] for r in rows])):
        r["q"] = q
    for r, q in zip(task_rows, bh([r["p"] for r in task_rows])):
        r["q"] = q
        r["dependent"] = bool(r["with"] > MAJORITY and r["without"] < MAJORITY and q < ALPHA)
    dep = defaultdict(list)
    for r in task_rows:
        if r["dependent"]:
            dep[r["t"]].append(r["task"])
    for r in rows:
        r["dependent_tasks"] = sorted(dep.get(r["t"], []))
        own = [x for x in task_rows if x["t"] == r["t"] and x["dependent"]]
        r["best"] = max(own, key=lambda x: (x["with"] - x["without"], -x["q"])) if own else None
        if r["dependent_tasks"]:                                              # at least one task that only runs after this hand-off
            r["verdict"] = "Brings specialist work"
        elif pd.notna(r["without"]) and r["without"] >= MAJORITY:
            r["verdict"] = "Agent works regardless of the hand-off"
        else:
            r["verdict"] = "No clear link"
    return rows, task_rows


def binom_greater(k, n_):
    return binom.sf(np.asarray(k) - 1, np.asarray(n_), 0.5)


def build_plan(members, tasks):
    """Dependency DAG over `tasks` learned from the first positions of the tasks in `members`."""
    k = len(tasks)
    empty = {"tasks": list(tasks), "stages": [list(tasks)] if k else [], "edges": [], "stats": [], "pred": {t: [] for t in tasks}}
    if k < 2 or not members:
        return empty
    P = np.full((len(members), k), np.inf)
    for i, c in enumerate(members):
        pos = POS[c]
        for j, t in enumerate(tasks):
            if t in pos:
                P[i, j] = pos[t]
    fin = np.isfinite(P)
    before = np.zeros((k, k))
    for a in range(k):
        before[a] = ((P[:, [a]] < P) & fin[:, [a]] & fin).sum(0)
    A, B = np.where(before > before.T)
    kept = {}
    if len(A):
        ab, ba = before[A, B], before[B, A]
        dep = (ab - ba) / (ab + ba + 1)
        q = bh(binom_greater(ab, ab + ba))
        keep = (dep >= args.dependency) & (q < ALPHA)
        kept = {(int(a), int(b)): (int(x), int(y), float(d), float(qq)) for a, b, x, y, d, qq, kp in zip(A, B, ab, ba, dep, q, keep) if kp}
    if not kept:
        return empty
    while True:                                                    # topological order; break a cycle at its weakest edge
        indeg = Counter(b for _, b in kept)
        succ = defaultdict(list)
        for a, b in kept:
            succ[a].append(b)
        ready = sorted(j for j in range(k) if indeg[j] == 0)
        order = []
        while ready:
            j = ready.pop(0)
            order.append(j)
            for b in succ[j]:
                indeg[b] -= 1
                if indeg[b] == 0:
                    ready.append(b)
        if len(order) == k:
            break
        done = set(order)
        kept.pop(min((e for e in kept if e[0] not in done and e[1] not in done), key=lambda e: kept[e][2]))
    reach = {j: set() for j in range(k)}
    for j in reversed(order):
        for b in succ[j]:
            reach[j] |= {b} | reach[b]
    reduced = sorted((a, b) for a, b in kept if not any(b in reach[x] for x in succ[a] if x != b))   # transitive reduction
    level = {}
    for j in order:
        level[j] = 1 + max((level[a] for a, b in reduced if b == j), default=0)
    stages = [sorted(tasks[j] for j in range(k) if level[j] == s) for s in range(1, max(level.values()) + 1)]
    return {"tasks": list(tasks), "stages": stages, "edges": [(tasks[a], tasks[b]) for a, b in reduced],
            "stats": [{"From task": tasks[a], "To task": tasks[b], "Traces with both": kept[(a, b)][0] + kept[(a, b)][1],
                       "From came first": kept[(a, b)][0], "To came first": kept[(a, b)][1],
                       "Dependency (0-1)": round(kept[(a, b)][2], 3), "p-value (BH)": p_text(kept[(a, b)][3])} for a, b in reduced],
            "pred": {t: sorted(tasks[a] for a, b in reduced if tasks[b] == t) for t in tasks}}


def core(ids, keep_task):
    m = len(ids)
    cnt = Counter(t for c in ids for t in TASKS[c] if keep_task(t))
    return sorted(t for t, k in cnt.items() if k / m > MAJORITY)


NONE_LABEL = "No hand-off that brings specialist work"


def learn(ids):
    """Fit the decomposition model on `ids` only."""
    rows, task_rows = handoff_test(ids)
    driving = {r["t"] for r in rows if r["verdict"] == "Brings specialist work"}
    specialist_tasks = {r["task"] for r in task_rows if r["t"] in driving and (r["dependent"] or r["home"] > MAJORITY)}
    share = Counter(t for c in ids for t in TASKS[c])

    def layer(task):
        api = TASK_API[task]
        if api in driving:
            return "Hand-off"
        if task in specialist_tasks:
            return "Specialist"
        if TASK_AGENT[task] == UNKNOWN:
            return "Agent not recorded"
        return "Standard" if share[task] / len(ids) > MAJORITY else "Occasional"

    lay = {t: layer(t) for t in TASK_AGENT}

    def label(c):
        combo = sorted(t for t in DISP.get(c, ()) if t in driving)
        return " + ".join(combo) if combo else NONE_LABEL

    labels = {c: label(c) for c in ids}
    members = defaultdict(list)
    for c in ids:
        members[labels[c]].append(c)
    std = build_plan(ids, core(ids, lambda t: lay[t] in ("Standard", "Agent not recorded")))
    dep_of = {r["t"]: set(r["dependent_tasks"]) for r in rows}
    subs = {}                                                                # one sub-plan per hand-off that brings work
    for t in sorted(driving):
        mem = [c for c in ids if t in DISP.get(c, ())]
        ho = [x for x in TASK_API if TASK_API[x] == t]
        subs[t] = build_plan(mem, sorted(set(ho) | dep_of[t]))      # hand-off + the tasks it brings; their order is learned from the traces
    one = build_plan(ids, core(ids, lambda t: True))                         # baseline: one plan for everyone, no decomposition
    calls_n = {c: CALLS_N[c] for c in ids}
    med = {l: float(np.median([calls_n[c] for c in mem])) for l, mem in members.items()}
    return {"rows": rows, "task_rows": task_rows, "driving": driving, "layer": lay, "label": label, "labels": labels, "members": members,
            "std": std, "subs": subs, "one": one, "median_calls": med, "median_all": float(np.median(list(calls_n.values())))}


CALLS_N = calls.groupby(CASE).size().to_dict()
