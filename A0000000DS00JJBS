IDS = calls[CASE].drop_duplicates().tolist()
n = len(IDS)
first = calls.groupby([CASE, "task"], sort=False)["call_no"].min()
POS = {c: g.droplevel(0).to_dict() for c, g in first.groupby(level=0, sort=False)}          # first position of each task
