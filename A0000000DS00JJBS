def write_book(path, sheets, notes):
    with pd.ExcelWriter(path, engine="openpyxl") as xw:
        for name, frame in sheets.items():
            frame = frame if len(frame.columns) else pd.DataFrame({"Note": ["nothing found in this data"]})
            frame.map(lambda v: ILLEGAL_CHARACTERS_RE.sub("", v)[:32000] if isinstance(v, str) else v).to_excel(xw, sheet_name=name[:31], index=False)
    wb = load_workbook(path)
    for ws in wb.worksheets:
        ws.freeze_panes = "B2"
        ws.auto_filter.ref = ws.dimensions
        ws.sheet_view.showGridLines = False
        cols = [c.value for c in ws[1]]
        for j, name in enumerate(cols, start=1):
            cell = ws.cell(1, j)
            cell.font, cell.fill = Font(bold=True, color="FFFFFF"), HEAD
            cell.alignment = Alignment(vertical="center", wrap_text=True)
            if notes and name in GUIDE.get(ws.title, {}):
                cm = Comment(f"{GUIDE[ws.title][name][0]}\n\nMethod: {GUIDE[ws.title][name][1]}", "NORA v7.1")
                cm.width, cm.height = 320, 140
                cell.comment = cm
            w = max(len(str(ws.cell(i, j).value or "")) for i in range(1, min(ws.max_row, 60) + 1))
            ws.column_dimensions[cell.column_letter].width = WIDE.get(name, max(11, min(40, w + 2)))
        ws.row_dimensions[1].height = 32
        for r, row in enumerate(ws.iter_rows(min_row=2), start=2):
            for j, cell in enumerate(row):
                cell.border = LINE
                cell.alignment = Alignment(wrap_text=cols[j] in WIDE, vertical="top")
                if r % 2 == 0:
                    cell.fill = BAND
                if cols[j] in PERCENT and isinstance(cell.value, (int, float)):
                    cell.number_format = "0.0%"
                elif isinstance(cell.value, int):
                    cell.number_format = "#,##0"
    wb.save(path)


