def fit_level(Z, k_range, level, scope, cap=False):
    rows, fits = [], {}
    hi = min(k_range[1], len(Z) - 1, int(np.sqrt(len(Z) / 2)) if cap else len(Z))
    for k in range(k_range[0], hi + 1):
        km = KMeans(n_clusters=k, n_init=N_INIT, random_state=SEED).fit(Z)
        sizes = np.bincount(km.labels_, minlength=k)
        row = {"level": level, "scope": scope, "k": k, "smallest_cluster": int(sizes.min()), "valid": bool(sizes.min() >= MIN_CLUSTER)}
        if row["valid"] and len(np.unique(Z, axis=0)) > k:
            row.update(silhouette=silhouette_score(Z, km.labels_, metric="cosine"), calinski_harabasz=calinski_harabasz_score(Z, km.labels_),
                       davies_bouldin=davies_bouldin_score(Z, km.labels_))
            fits[k] = km
        else:
            row["valid"] = False
        rows.append(row)
    tab = pd.DataFrame(rows)
    for col in ("silhouette", "calinski_harabasz", "davies_bouldin"):
        if col not in tab:
            tab[col] = np.nan
    ok = tab[tab.valid]
    if ok.empty:
        tab["votes"], tab["chosen"] = 0, False
        return None, tab
    votes = Counter([int(ok.loc[ok.silhouette.idxmax(), "k"]), int(ok.loc[ok.calinski_harabasz.idxmax(), "k"]), int(ok.loc[ok.davies_bouldin.idxmin(), "k"])])
    sil = ok.set_index("k")["silhouette"]
    best = max(votes, key=lambda k: (votes[k], sil[k]))
    tab["votes"] = tab["k"].map(votes).fillna(0).astype(int)
    tab["chosen"] = tab["k"] == best
    return fits[best], tab


def by_size(labels):
    order = [c for c, _ in Counter(labels).most_common()]
    return np.array([order.index(c) for c in labels])


def ctfidf(groups, labels, stop=None, bag=False, top=TOP_TERMS):
    classes = sorted(set(labels))
    if bag:
        joined = [[t for g, l in zip(groups, labels) if l == c for t in g] or ["(none)"] for c in classes]
        cv = CountVectorizer(analyzer=identity, lowercase=False)
    else:
        joined = [" ".join(re.sub(NOISE_TEXT, " ", g) for g, l in zip(groups, labels) if l == c) or "emptytext" for c in classes]
        cv = CountVectorizer(stop_words=sorted(stop or []), token_pattern=TOKEN, ngram_range=(1, 2))
    try:
        X = cv.fit_transform(joined).toarray().astype(float)
    except ValueError:
        return {c: [] for c in classes}
    tf = X / X.sum(1, keepdims=True).clip(min=1)
    idf = np.log(1 + (X.sum() / len(classes)) / np.maximum(X.sum(0), 1))
    W, terms = tf * idf, cv.get_feature_names_out()
    out = {}
    for i, c in enumerate(classes):
        picked, words = [], set()
        for j in np.argsort(-W[i]):
            if W[i, j] <= 0 or len(picked) == top:
                break
            parts = set(str(terms[j]).split())
            if not bag and parts <= words:
                continue
            picked.append(str(terms[j]))
            words |= parts
        out[c] = picked
    return out


def signature(lists, members, top=3):
    overall = Counter(t for x in lists for t in set(x))
    inside = Counter(t for i in members for t in set(lists[i]))
    rows = []
    for t, k in inside.items():
        sup, lift = k / len(members), (k / len(members)) / (overall[t] / len(lists))
        rows.append((t, sup, lift))
    rows.sort(key=lambda r: (-(r[1] >= 0.5), -r[2], -r[1]))
    return rows[:top]


def representatives(Z, labels, c, ids, k=3):
    idx = np.where(labels == c)[0]
    centre = normalize(Z[idx].mean(0, keepdims=True))
    return [ids[i] for i in idx[np.argsort(-(Z[idx] @ centre.T).ravel())][:k]]


