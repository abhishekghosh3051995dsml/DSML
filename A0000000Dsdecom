def stop_layers(docs, name):
    labels = Counter()
    for d in docs:
        labels.update({w for lab in re.findall(FIELD_LABEL, d, re.M) for w in re.findall(r"[a-z]{2,}", lab.lower())})
    field = {w for w, k in labels.items() if k >= FIELD_LABEL_SHARE * len(docs)}
    base = set(ENGLISH_STOP_WORDS) | field
    cv = CountVectorizer(stop_words=sorted(base), token_pattern=TOKEN, binary=True)
    try:
        X = cv.fit_transform(docs)
        share = np.asarray(X.sum(0)).ravel() / len(docs)
        over = {t for t, s in zip(cv.get_feature_names_out(), share) if s > OVERFREQUENT_SHARE}
    except ValueError:
        over = set()
    log.info(f"   {name}: {len(field)} form-label words, {len(over)} over-frequent words removed {sorted(field | over)[:20]}")
    return base | over


def reduce(X):
    k = min(LSA_DIMS, X.shape[1] - 1, X.shape[0] - 1)
    if k < 2:
        return normalize(X.toarray()), 1.0
    svd = TruncatedSVD(n_components=k, random_state=SEED)
    return normalize(svd.fit_transform(X)), float(svd.explained_variance_ratio_.sum())


def text_space(docs, stop):
    docs = [re.sub(NOISE_TEXT, " ", d) if d.strip() else "emptytext" for d in docs]
    for min_df in (MIN_DF, 1):
        try:
            vec = TfidfVectorizer(stop_words=sorted(stop), token_pattern=TOKEN, ngram_range=(1, 2), min_df=min_df, sublinear_tf=True)
            X = vec.fit_transform(docs)
            break
        except ValueError:
            continue
    Z, var = reduce(X)
    return Z, X.shape[1], var


def bag_space(lists):
    lists = [x if x else ["(none)"] for x in lists]
    X = TfidfVectorizer(analyzer=identity, lowercase=False, binary=True).fit_transform(lists)
    Z, var = reduce(X) if X.shape[1] > LSA_DIMS else (normalize(X.toarray()), 1.0)
    return Z, X.shape[1], var


def blocks(*mats):
    return normalize(np.hstack([normalize(m) for m in mats]))


