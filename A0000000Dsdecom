def blank(v):
    if v is None or (isinstance(v, float) and np.isnan(v)):
        return True
    if isinstance(v, (list, dict)):
        return len(v) == 0
    return isinstance(v, str) and v.strip().lower() in BLANK


def parse_json(value, depth=0):
    if depth > 6:
        return value
    if isinstance(value, str):
        s = value.strip()
        if s[:1] in ("[", "{"):
            for loader in (json.loads, ast.literal_eval):
                try:
                    return parse_json(loader(s), depth + 1)
                except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
                    continue
        return value
    if isinstance(value, list):
        return [parse_json(v, depth + 1) for v in value]
    if isinstance(value, dict):
        return {k: parse_json(v, depth + 1) for k, v in value.items()}
    return value


def _repair(m):
    raw = bytearray()
    for ch in m.group(0):
        try:
            raw += ch.encode("cp1252")
        except UnicodeEncodeError:
            if ord(ch) > 255:
                return m.group(0)
            raw.append(ord(ch))
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return m.group(0)


def fix_mojibake(v):
    return re.sub(MOJIBAKE, _repair, v) if isinstance(v, str) else v


def slug(text):
    return re.sub(r"[^A-Za-z0-9]+", "_", str(text)).strip("_")[:60]


