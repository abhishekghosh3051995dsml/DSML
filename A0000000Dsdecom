    fig, ax = plt.subplots(figsize=(9, 0.3 * len(st) + 1.5))
    ax.barh(st.cluster_id, st.bootstrap_jaccard, color=SERIES[0], height=0.6)
    for x, lab in ((PATTERN_JACCARD, "pattern"), (STABLE_JACCARD, "stable")):
        ax.axvline(x, color=MUTED, ls="--", lw=1)
        ax.text(x, -0.9, lab, fontsize=7, color=INK2, ha="center")
    ax.set_xlim(0, 1)
    ax.invert_yaxis()
    ax.set_title(f"Cluster stability under resampling (bootstrap Jaccard, B={args.bootstraps})")
    ax.spines[["top", "right"]].set_visible(False)
    save(fig, "07_stability")

