def point_quality(Z, lab):
    lab = np.asarray(lab)
    if len(set(lab)) < 2:
        return np.full(len(lab), np.nan), np.full(len(lab), np.nan), np.array(["single cluster"] * len(lab), dtype=object)
    sil = silhouette_samples(Z, lab, metric="cosine")
    k = min(KNN, len(Z) - 1)
    nb = NearestNeighbors(n_neighbors=k + 1, metric="cosine").fit(Z).kneighbors(Z, return_distance=False)
    nb = np.array([[j for j in row if j != i][:k] for i, row in enumerate(nb)])
    agree = (lab[nb] == lab[:, None]).mean(1)
    align = np.where((sil >= STRONG_SILHOUETTE) & (agree >= STRONG_KNN), "strong",
                     np.where((sil < LOOSE_SILHOUETTE) | (agree < LOOSE_KNN), "loose", "moderate"))
    return sil, agree, align.astype(object)


def jaccard_stability(Z, lab, B):
    k, rng = len(set(lab)), np.random.default_rng(SEED)
    acc = [[] for _ in range(k)]
    for b in range(B):
        idx = rng.choice(len(Z), len(Z), replace=True)
        uniq = np.unique(idx)
        if len(np.unique(Z[idx], axis=0)) <= k:
            continue
        new = KMeans(n_clusters=k, n_init=5, random_state=b).fit(Z[idx]).predict(Z[uniq])
        old = lab[uniq]
        for c in range(k):
            A = old == c
            if A.any():
                acc[c].append(max((A & (new == d)).sum() / (A | (new == d)).sum() for d in range(k)))
    return [float(np.mean(a)) if a else np.nan for a in acc]


def stability_class(j):
    return "n/a" if j != j else "stable" if j >= STABLE_JACCARD else "pattern" if j >= PATTERN_JACCARD else "weak"


def natural(Z, lab, level):
    try:
        from sklearn.cluster import HDBSCAN
    except ImportError:
        log.info("   HDBSCAN needs scikit-learn >= 1.3; natural-structure check skipped")
        return None, {}
    nat = HDBSCAN(min_cluster_size=max(MIN_CLUSTER, round(0.05 * len(Z)))).fit(Z).labels_
    keep = nat != -1
    res = {"level": level, "natural_clusters": len(set(nat[keep])), "noise_share": round(float((~keep).mean()), 3),
           "kmeans_k": len(set(lab)),
           "ARI_kmeans_vs_natural": round(adjusted_rand_score(lab[keep], nat[keep]), 3) if keep.sum() > 1 and len(set(nat[keep])) > 1 else np.nan}
    return nat, res


