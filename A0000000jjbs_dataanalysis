def detect_encoding(path, probe=64 * 1024 * 1024):
    with path.open("rb") as fh:
        raw = fh.read(probe)
    for enc in ("utf-8-sig", "cp1252"):
        try:
            raw.decode(enc)
            return enc
        except UnicodeDecodeError as e:
            if enc == "utf-8-sig" and e.start >= len(raw) - 3:
                return enc
    return "latin-1"


def read(cols=None):
    with pd.read_csv(SRC, dtype=str, keep_default_na=False, na_filter=False, encoding=ENC, encoding_errors="replace",
                     chunksize=args.chunk, usecols=[RAW[c] for c in cols] if cols else None) as reader:
        for ch in reader:
            ch.columns = [str(c).strip() for c in ch.columns]
            yield ch


def parse_json(value):
    for loader in (json.loads, ast.literal_eval):
        try:
            return loader(value)
        except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
            continue
    return None


def blank_mask(s):
    return s.str.strip().str.lower().isin(BLANK_TOKENS)


def row_hash(frame):
    return pd.util.hash_pandas_object(frame, index=False).values


def short(v, width=80):
    v = str(v).replace("\n", " ")
    return v if len(v) <= width else v[:width] + "…"


