note("Exact duplicate rows (every column identical)", f"{duplicates:,} ({duplicates / total:.2%})")
note("Estimated memory if fully loaded as text", f"{chunk_mem * total / 1024 ** 3:.1f} GB")


def dominant(p):
    if p["n"] == 0:
        return "empty"
    shares = {k: p[k] / p["sampled"] for k in ("num", "dt", "boolean", "json_ok")}
    name = {"num": "numeric", "dt": "datetime", "boolean": "boolean", "json_ok": "json"}
    best = max(shares, key=shares.get)
    if shares[best] == 1.0:
        return name[best]
    if shares[best] > 0:
        return f"mixed (text + {name[best]} {shares[best]:.0%})"
    return "text" if p["spaced"] else "text, no spaces"


rows = []
for i, c in enumerate(COLS):
    p = P[c]
    lens = np.concatenate(p["lengths"]) if p["lengths"] else np.array([0])
