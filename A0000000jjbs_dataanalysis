# %% Phase 3 - structure inside JSON columns: which fields exist, how often, with what values

section("PHASE 3  Structure inside JSON columns")


def walk(obj, path, out):
    if isinstance(obj, dict):
        out.append((path or "(root)", "object", len(obj)))
        for k, v in obj.items():
            walk(v, f"{path}.{k}" if path else str(k), out)
    elif isinstance(obj, list):
        out.append((path or "(root)", "list", len(obj)))
        for v in obj:
            walk(v, f"{path}[]", out)
    else:
        out.append((path, type(obj).__name__, obj))


json_rows = []
for c in [c for c in COLS if P[c]["json_ok"]]:
    docs = [d for d in (parse_json(x) for x in JSON_DOCS[c]) if d is not None]
    in_docs, kinds, values, sizes = Counter(), defaultdict(Counter), defaultdict(Counter), defaultdict(list)
    for d in docs:
        leaves = []
        walk(d, "", leaves)
        for path in {pth for pth, _, _ in leaves}:
            in_docs[path] += 1
        for path, kind, val in leaves:
            kinds[path][kind] += 1
            if kind in ("list", "object"):
                sizes[path].append(val)
            else:
                values[path][short(val, 100)] += 1
    for path, cnt in in_docs.most_common():
        json_rows.append({"column": c, "path": path, "value_types": dict(kinds[path]), "docs_sampled": len(docs),
                          "share_of_docs": round(cnt / len(docs), 4),
                          "items_median": float(np.median(sizes[path])) if sizes[path] else "",
                          "distinct_values_in_sample": len(values[path]) if values[path] else "",
                          "top_values": " | ".join(f"{v} ({n})" for v, n in values[path].most_common(10))})
    log.info(f"   {c}: {len(docs):,} documents parsed, {len(in_docs)} distinct field paths")
json_struct = pd.DataFrame(json_rows)
json_struct.to_csv(OUT / "04_json_structure.csv", index=False)

# %% Phase 4 - identifier columns: grain of the data and how the ids nest inside each other

section("PHASE 4  Identifier columns and how they nest")
ids = profile[(profile["has_spaces_share"] == 0) & (profile["has_digit_share"] == 1) & (profile["unique_values"] > 1)
              & ((profile["inferred_type"] == "text, no spaces") | ((profile["inferred_type"] == "numeric") & (profile["integer_share"] == 1)))]["column"].tolist()
note("Identifier-like columns (no spaces, every value carries a digit, no decimals)", ids)
counts = {c: pd.Series(dtype="int64") for c in ids}
pairs = [(a, b) for k, a in enumerate(ids) for b in ids[k + 1:]]
pair_hashes = {pr: np.empty(0, np.uint64) for pr in pairs}
for ch in read(ids):
    ch = ch.apply(lambda s: s.str.strip().where(~blank_mask(s)))
    hashes = {c: row_hash(ch[c].fillna("")) for c in ids}
    for c in ids:
        counts[c] = counts[c].add(ch[c].dropna().value_counts(), fill_value=0)
    for a, b in pairs:
        both = ch[a].notna().values & ch[b].notna().values
        combo = hashes[a][both] * np.uint64(1_000_003) ^ hashes[b][both]
        pair_hashes[(a, b)] = np.union1d(pair_hashes[(a, b)], np.unique(combo))

grain = []
for c in ids:
    rpv = counts[c].astype(int)
    grain.append({"column": c, "unique_values": len(rpv), "rows_per_value_min": int(rpv.min()), "median": float(rpv.median()),
                  "mean": round(rpv.mean(), 2), "p95": float(rpv.quantile(0.95)), "max": int(rpv.max()),
                  "values_seen_once_share": round((rpv == 1).mean(), 4)})
grain = pd.DataFrame(grain)
grain.to_csv(OUT / "05_identifier_grain.csv", index=False)
log.info(f"   rows per identifier value\n{grain.to_string(index=False)}")

nest = []
for a, b in pairs:
    joint = len(pair_hashes[(a, b)])
    ua, ub = len(counts[a]), len(counts[b])
    a_to_b, b_to_a = joint == ua, joint == ub
    relation = ("same grain (1:1)" if a_to_b and b_to_a else f"each {a} sits inside one {b}" if a_to_b
                else f"each {b} sits inside one {a}" if b_to_a else "many-to-many")
    nest.append({"column_a": a, "column_b": b, "unique_a": ua, "unique_b": ub, "unique_pairs": joint, "relation": relation})
nest = pd.DataFrame(nest)
nest.to_csv(OUT / "06_identifier_nesting.csv", index=False)
for r in nest.itertuples():
    log.info(f"   {r.column_a} vs {r.column_b}: {r.relation}")

# %% Phase 5 - cleaning: trim, blanks to missing, encoding repair, exact duplicates out, types cast

section("PHASE 5  Cleaning")
try:
    import pyarrow as pa
    import pyarrow.parquet as pq
except ImportError:
    pa = None
    CLEAN = SRC.with_name(f"{SRC.stem}_clean.csv")
    log.info("   pyarrow not installed, so the cleaned file is written as CSV (pip install pyarrow for a faster Parquet copy)")


def _repair(m):
    raw = bytearray()
    for ch_ in m.group(0):
        try:
            raw += ch_.encode("cp1252")
        except UnicodeEncodeError:
            if ord(ch_) > 255:
                return m.group(0)
            raw.append(ord(ch_))
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return m.group(0)


kind = profile.set_index("column")["inferred_type"].to_dict()
drop_cols = [c for c in COLS if kind[c] == "empty"]
keep = [c for c in COLS if c not in drop_cols]
num_cols = [c for c in keep if kind[c] == "numeric" and c not in ids]
dt_cols = [c for c in keep if kind[c] == "datetime"]
bool_cols = [c for c in keep if kind[c] == "boolean"]
text_cols = [c for c in keep if c not in num_cols + dt_cols + bool_cols]
cast_to = {**{c: "text" for c in text_cols}, **{c: "float" for c in num_cols}, **{c: "datetime (UTC)" for c in dt_cols}, **{c: "boolean" for c in bool_cols}}
if pa is not None:
    pa_type = {**{c: pa.string() for c in text_cols}, **{c: pa.float64() for c in num_cols},
               **{c: pa.timestamp("ns", tz="UTC") for c in dt_cols}, **{c: pa.bool_() for c in bool_cols}}
    schema = pa.schema([(c, pa_type[c]) for c in keep] + [("source_row", pa.int64())])
file_time = pd.Timestamp(SRC.stat().st_mtime, unit="s", tz="UTC")

stats = {c: Counter() for c in keep}
dt_range = {c: [None, None] for c in dt_cols}
per_day = {c: Counter() for c in dt_cols}
numeric_values = {c: [] for c in num_cols}
seen, offset, rows_out = np.empty(0, np.uint64), 0, 0
writer = pq.ParquetWriter(CLEAN, schema) if pa is not None else None
if writer is None and CLEAN.exists():
    CLEAN.unlink()
for ch in read():
    ch = ch[keep].copy()
    ch["source_row"] = np.arange(offset, offset + len(ch))
    offset += len(ch)
    for c in keep:
        s = ch[c].str.strip()
        bl = s.str.lower().isin(BLANK_TOKENS)
        stats[c]["blank_to_missing"] += int(bl.sum())
        s = s.where(~bl)
        if c in text_cols:
            hit = s.str.contains(MOJIBAKE, regex=True, na=False)
            if hit.any():
                fixed = s[hit].str.replace(MOJIBAKE, _repair, regex=True)
                stats[c]["encoding_repaired"] += int((fixed != s[hit]).sum())
                s[hit] = fixed
        ch[c] = s
    h = row_hash(ch[keep])
    fresh = ~np.isin(h, seen) & ~pd.Series(h).duplicated().values
    seen = np.union1d(seen, h)
    ch = ch[fresh]
    for c in num_cols:
        before = ch[c].notna().sum()
        ch[c] = pd.to_numeric(ch[c], errors="coerce")
        stats[c]["failed_cast"] += int(before - ch[c].notna().sum())
        numeric_values[c].append(ch[c].dropna().values)
    for c in dt_cols:
        before = ch[c].notna().sum()
        ch[c] = pd.to_datetime(ch[c], errors="coerce", utc=True, format="mixed")
        stats[c]["failed_cast"] += int(before - ch[c].notna().sum())
        stats[c]["after_file_date"] += int((ch[c] > file_time).sum())
        if ch[c].notna().any():
            lo, hi = ch[c].min(), ch[c].max()
            dt_range[c] = [lo if dt_range[c][0] is None else min(lo, dt_range[c][0]), hi if dt_range[c][1] is None else max(hi, dt_range[c][1])]
            per_day[c].update(ch[c].dt.floor("D").value_counts().to_dict())
    for c in bool_cols:
        ch[c] = ch[c].str.lower().map({"true": True, "false": False})
    if writer is not None:
        writer.write_table(pa.Table.from_pandas(ch, schema=schema, preserve_index=False))
    else:
        ch.to_csv(CLEAN, mode="a", header=not CLEAN.exists(), index=False)
    rows_out += len(ch)
if writer is not None:
    writer.close()

clean_log = pd.DataFrame([{"column": c, "cast_to": cast_to[c], **stats[c],
                           "earliest": dt_range[c][0] if c in dt_range else "", "latest": dt_range[c][1] if c in dt_range else ""}
                          for c in keep]).fillna(0)
clean_log.to_csv(OUT / "07_cleaning_log.csv", index=False)
note("Columns dropped (no value in any row)", drop_cols or "none")
note("Rows after removing exact duplicates", f"{rows_out:,} of {total:,}")
note("Cleaned file", f"{CLEAN} ({CLEAN.stat().st_size / 1024 ** 3:.2f} GB)")
for c in dt_cols:
    note(f"{c} range", f"{dt_range[c][0]} to {dt_range[c][1]}, {stats[c]['failed_cast']:,} unparseable, {stats[c]['after_file_date']:,} later than the file itself")

