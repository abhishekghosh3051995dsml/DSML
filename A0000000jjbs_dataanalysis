# %% Phase 2 - full-file profile: completeness, uniqueness, type, length, encoding damage

section("PHASE 2  Profiling every column across the whole file")
P = {c: {"n": 0, "blank": Counter(), "hashes": np.empty(0, np.uint64), "lengths": [], "sampled": 0, "num": 0, "dt": 0,
         "boolean": 0, "json": 0, "json_ok": 0, "spaced": 0, "digit": 0, "integer": 0, "fffd": 0, "moji": 0, "top": Counter(),
         "top_open": True, "examples": []} for c in COLS}
JSON_DOCS = defaultdict(list)
row_hashes, total, n_chunks = np.empty(0, np.uint64), 0, 0
for ch in read():
    n_chunks += 1
    total += len(ch)
    row_hashes = np.union1d(row_hashes, np.unique(row_hash(ch)))
    for c in COLS:
        p, s = P[c], ch[c].str.strip()
        is_blank = s.str.lower().isin(BLANK_TOKENS)
        p["blank"].update(s[is_blank].str.lower().value_counts().to_dict())
        v = s[~is_blank]
        if v.empty:
            continue
        p["n"] += len(v)
        p["hashes"] = np.union1d(p["hashes"], np.unique(row_hash(v)))
        p["lengths"].append(v.str.len().values.astype(np.int32))
        p["fffd"] += int(v.str.contains("\ufffd", regex=False).sum())
        p["moji"] += int(v.str.contains(MOJIBAKE, regex=True).sum())
        p["json"] += int(v.str[:1].isin(["[", "{"]).sum())
        if p["top_open"]:
            p["top"].update(v.value_counts().to_dict())
            if len(p["top"]) > TRACK_LIMIT:
                p["top_open"], p["top"] = False, Counter()
        smp = v.sample(min(args.sample, len(v)), random_state=args.seed)
        num = pd.to_numeric(smp, errors="coerce").notna()
        cand = smp[~num & (smp.str.len() <= 40) & smp.str.contains(r"\d")]
        js = smp[smp.str[:1].isin(["[", "{"])]
        p["sampled"] += len(smp)
        p["num"] += int(num.sum())
        p["dt"] += int(pd.to_datetime(cand, errors="coerce", utc=True, format="mixed").notna().sum()) if len(cand) else 0
        p["boolean"] += int(smp.str.lower().isin(["true", "false"]).sum())
        p["json_ok"] += sum(parse_json(x) is not None for x in js)
        p["spaced"] += int(smp.str.contains(r"\s").sum())
        p["digit"] += int(smp.str.contains(r"\d").sum())
        p["integer"] += int(smp.str.fullmatch(r"-?\d+").sum())
        if len(JSON_DOCS[c]) < args.json_docs and len(js):
            JSON_DOCS[c].extend(js.head(args.json_docs - len(JSON_DOCS[c])).tolist())
        if len(p["examples"]) < 3:
            p["examples"] += [short(x) for x in v.drop_duplicates().head(3 - len(p["examples"]))]
    log.info(f"   chunk {n_chunks}: {total:,} rows read")

duplicates = total - len(row_hashes)
