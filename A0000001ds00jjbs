per["agents"] = calls[calls[AGENT] != UNKNOWN].groupby(CASE)[AGENT].nunique()
per["distinct_apis"] = calls.groupby(CASE)[TOOL].nunique()
per["steps"] = pd.Series({c: len(STEPS[c]) for c in IDS})
per["retries"] = calls.groupby(CASE)["retry"].sum()
per["errors"] = calls[calls["outcome"] == "error"].groupby(CASE).size()
per = per.fillna(0)
X = np.log1p(per[["agents", "tool_calls", "distinct_apis", "steps", "retries", "errors"]].astype(float).values)
iso = IsolationForest(n_estimators=300, random_state=args.seed).fit(X)
per["anomaly_score"] = -iso.score_samples(X)
