# %% PHASE 2 - Prepare the calls

section("PHASE 2  Prepare the calls")
# 2a. discover the timestamp field and an agent field inside the JSON payload (from the data, not typed)
time_path = agent_path = None
TIME_FIELDS = pd.DataFrame()
if COL["payload"]:
    def flatten(rows):
        docs = rows[COL["payload"]].dropna()
        docs = docs.sample(min(args.sample, len(docs)), random_state=args.seed).map(parse_json)
        return [leaves(d) for d in docs if isinstance(d, dict)]

    flat = flatten(calls)
    cand = []
    for p, k in Counter(p for f in flat for p in f).items():
        vals = [f[p] for f in flat if p in f]
        if to_time(vals, CEILING).notna().all():
            cand.append((k, len(set(map(str, vals))), p))
    TIME_FIELDS = pd.DataFrame([{"Payload field": p, "Calls sampled with it": k, "Distinct values": d} for k, d, p in sorted(cand, reverse=True)])
    time_path = args.time_field or (max(cand)[2] if cand else None)
    known_agents = set(calls[AGENT].dropna().astype(str))
    missing = calls[calls[AGENT].isna()]
    if known_agents and len(missing):
        flat_na = flatten(missing)
        cand = []
        for p, k in Counter(p for f in flat_na for p in f if has_value(f[p])).items():
            if all(str(f[p]) in known_agents for f in flat_na if p in f and has_value(f[p])):
                cand.append((k, p))
        agent_path = max(cand)[1] if cand else None
if time_path or agent_path:
    picked = calls[COL["payload"]].map(lambda v: (lambda d: (get_path(d, time_path) if time_path else None,
                                                             get_path(d, agent_path) if agent_path else None))(parse_json(v)))
    calls["_t"] = to_time(picked.map(lambda x: x[0]), CEILING) if time_path else pd.NaT
    calls["_agent_payload"] = picked.map(lambda x: str(x[1]) if has_value(x[1]) else None) if agent_path else None
    del picked
else:
    calls["_t"] = pd.NaT
calls["_t"] = pd.to_datetime(calls["_t"], utc=True)
fact("time_field", time_path or "none (file order used)", "Timestamp field found in the payload")

# 2b. API names: one log table writes '<system><sep><api>'; the system list is learned from names logged both ways
SEP = re.compile(r"[^0-9A-Za-z_]")
names = calls.groupby(SOURCE)[TOOL].agg(lambda x: set(x.astype(str)))
canon, two_names = {}, []
for src, own in names.items():
    others = set().union(*[v for k, v in names.items() if k != src]) if len(names) > 1 else set()
    for name in own:
        target, prefix = name, ""
        if name not in others:
            for hit in SEP.finditer(name):
                if name[hit.end():] in others:
                    target, prefix = name[hit.end():], name[:hit.start()]
                    break
        canon[(src, name)] = target
        if target != name:
            two_names.append({"Log table": src, "Logged as": name, "Same API as": target, "System prefix": prefix, "Plain name seen elsewhere": "yes"})
SYSTEMS = {r["System prefix"] for r in two_names if r["System prefix"]}


def prefix_of(name):
    hit = SEP.search(name)
    return name[:hit.start()] if hit and name[:hit.start()] in SYSTEMS else None


for (src, name), target in list(canon.items()):
    p = prefix_of(name)
    if target == name and p:
        canon[(src, name)] = name[len(p) + 1:]
        two_names.append({"Log table": src, "Logged as": name, "Same API as": name[len(p) + 1:], "System prefix": p, "Plain name seen elsewhere": "no"})
calls["_logged"] = calls[TOOL].astype(str)
calls[TOOL] = [canon[(a, b)] for a, b in zip(calls[SOURCE], calls["_logged"])]
API_SYSTEM = calls.groupby(TOOL)["_logged"].agg(lambda x: " / ".join(sorted({prefix_of(v) for v in set(x)} - {None})) or None).dropna()
fact("systems", ", ".join(sorted(SYSTEMS)) or "none", "Systems NORA writes in front of API names")

# 2c. outcome of each call: error text, and the HTTP status code if the output carries one (field found from the data)
status_paths = []
if COL["output"]:
    outs = calls.loc[calls[COL["output"]].notna(), [TOOL, COL["output"]]]          # sample every API, so rare APIs are seen too
    outs = outs.sample(frac=1, random_state=args.seed).groupby(TOOL).head(max(5, args.sample // max(outs[TOOL].nunique(), 1)))
    outs = outs[COL["output"]].map(parse_json)
    of = [leaves(d) for d in outs if isinstance(d, dict)]
    for p in Counter(p for f in of for p in f):
        vals = [f[p] for f in of if p in f]
        if all(isinstance(v, int) and not isinstance(v, bool) and 100 <= v <= 599 for v in vals):
            status_paths.append(p)


def status_of(v):
    d = parse_json(v)
    codes = [get_path(d, p) for p in status_paths] if isinstance(d, dict) else []
    codes = [c for c in codes if isinstance(c, int) and not isinstance(c, bool)]
    return float(max(codes)) if codes else np.nan


calls["status"] = calls[COL["output"]].map(status_of).astype(float) if status_paths else np.nan
calls["_err"] = calls[COL["error"]].map(lambda v: str(v).strip() if has_value(v) else None) if COL["error"] else None
has_out = calls[COL["output"]].map(has_value) if COL["output"] else pd.Series(False, index=calls.index)
calls["outcome"] = np.select([calls["_err"].notna(), calls["status"] >= 400, has_out], ["error", "error", "returned data"], "no output")
fact("status_field", ", ".join(status_paths) or "none", "HTTP status field found in the output")


def norm_input(v):
    d = parse_json(v)
    return json.dumps(d, sort_keys=True, default=str) if d is not None else (None if v is None else str(v).strip())


calls["_in"] = calls[COL["input"]].map(norm_input) if COL["input"] else None


def order_calls(frame):
    full = frame["_t"].notna().groupby(frame[CASE]).transform("all")
    secs = (frame["_t"] - pd.Timestamp("1970-01-01", tz="UTC")).dt.total_seconds()
    frame = frame.assign(_order=np.where(full, secs, frame["source_row"]))
    return frame.sort_values([CASE, "_order", "source_row"], kind="stable"), full


# 2d. the same call written to two log tables is counted once (match: interaction + API + occurrence; checked by identical input)
calls, _ = order_calls(calls)
src_count = calls[SOURCE].value_counts()
primary = src_count.index[0]
calls["_k"] = calls.groupby([CASE, SOURCE, TOOL]).cumcount()
drop, dup_rows = [], []
RANK = {"returned data": 0, "no output": 1, "error": 2}
for s in src_count.index[1:]:
    a = calls[calls[SOURCE] == primary][[CASE, TOOL, "_k"]].reset_index().rename(columns={"index": "_ia"})
    b = calls[calls[SOURCE] == s][[CASE, TOOL, "_k"]].reset_index().rename(columns={"index": "_ib"})
    m = a.merge(b, on=[CASE, TOOL, "_k"])
    ia, ib = calls.loc[m["_ia"], "_in"].values, calls.loc[m["_ib"], "_in"].values
    both = pd.notna(ia) & pd.notna(ib)
    dup_rows.append({"Log table": s, "Call rows": int((calls[SOURCE] == s).sum()), "Same call already in": primary, "Matched": len(m),
                     "Identical input in matched pairs": round(float(np.mean(ia[both] == ib[both])), 4) if both.any() else None})
    A, B = m["_ia"].values, m["_ib"].values
    for c in ("_in", "_err", "_agent_payload") if "_agent_payload" in calls else ("_in", "_err"):
        va, vb = calls.loc[A, c].values, calls.loc[B, c].values
        fill = pd.isna(va) & pd.notna(vb)
        calls.loc[A[fill], c] = vb[fill]
    calls.loc[A, "status"] = np.fmax(calls.loc[A, "status"].values, calls.loc[B, "status"].values)
    oa, ob = calls.loc[A, "outcome"].values, calls.loc[B, "outcome"].values
    calls.loc[A, "outcome"] = np.where([RANK[x] >= RANK[y] for x, y in zip(oa, ob)], oa, ob)
    need = calls.loc[A, AGENT].isna().values & calls.loc[B, AGENT].notna().values
    calls.loc[A[need], AGENT] = calls.loc[B[need], AGENT].values
    ta = calls.loc[A, "_t"]
    calls.loc[A, "_t"] = ta.where(ta.notna(), pd.Series(calls.loc[B, "_t"].array, index=ta.index))
    drop.extend(B.tolist())
calls = calls.drop(index=drop)
calls, full = order_calls(calls)
DUPLICATES = pd.DataFrame(dup_rows)
fact("calls", len(calls), "Tool calls after counting each call once")
fact("timed_share", pct(full.groupby(calls[CASE]).first().mean()), "Interactions ordered by recorded time (rest: file order)")

# 2e. agent of each call: from the log, from a payload field, or from the only agent ever seen running that API; never guessed
calls["agent_basis"] = np.where(calls[AGENT].notna(), "recorded", None)
if agent_path:
    fill = calls[AGENT].isna() & calls["_agent_payload"].notna()
    calls.loc[fill, AGENT] = calls.loc[fill, "_agent_payload"]
    calls.loc[fill, "agent_basis"] = "payload field"
owners = calls.dropna(subset=[AGENT]).groupby(TOOL)[AGENT].agg(lambda s: sorted(set(s)))
single = {t: a[0] for t, a in owners.items() if len(a) == 1}
fill = calls[AGENT].isna() & calls[TOOL].isin(single)
calls.loc[fill, AGENT] = calls.loc[fill, TOOL].map(single)
calls.loc[fill, "agent_basis"] = "only agent of this API"
UNKNOWN = "(agent not recorded)"
calls["agent_basis"] = calls["agent_basis"].fillna("not recorded")
calls[AGENT] = calls[AGENT].fillna(UNKNOWN).astype(str)
