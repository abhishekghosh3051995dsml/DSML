    stated.append({"Earlier API": u, "API that failed": x, "Evidence in the message": how, "Messages": k, "Interactions with both": len(both),
                   "Earlier API logged first": first_ok / len(both) if both else None,
                   "Used in the task plan": "yes" if (u, x) in STATED_API_EDGES else "no (several APIs return that field)",
                   "Order alone also shows it": "yes" if (u, x) in order_found else "no"})
