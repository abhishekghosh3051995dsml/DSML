section("PHASE 8  Approved traces")
per = pd.DataFrame(index=pd.Index(IDS, name="case"))
per["tool_calls"] = pd.Series(CALLS_N)
per["handoff_calls"] = calls[calls["is_handoff"]].groupby(CASE).size()
per = per.fillna(0)
