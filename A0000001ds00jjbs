from http import HTTPStatus


def phrase(code):
    try:
        return HTTPStatus(int(code)).phrase
    except ValueError:
        return ""


err_calls = calls[calls["outcome"] == "error"].copy()
err_calls["code"] = err_calls["status"].where(err_calls["status"] >= 400)
err_calls["message"] = err_calls["_err"].fillna(err_calls["code"].map(lambda c: f"HTTP {int(c)} {phrase(c)}" if pd.notna(c) else ""))
tot = calls.groupby([AGENT, TOOL]).size()
rows = []
for (ag, api), g in err_calls.groupby([AGENT, TOOL]):
    codes = g["code"].dropna().astype(int).value_counts()
    no_status = int(g["code"].isna().sum())
    top_code = codes.index[0] if len(codes) else None
    up = ", ".join(sorted(STATED_UP.get(api, ())))
    if top_code is not None and codes.iloc[0] >= no_status and top_code >= 500:
        where = f"Provider side (their end): HTTP {top_code} {phrase(top_code)} (5xx = server error, RFC 9110)"
    elif top_code is not None and codes.iloc[0] >= no_status:
        where = f"Provider refused NORA's request: HTTP {top_code} {phrase(top_code)} (4xx = request side, RFC 9110)"
    elif up:
        where = f"Not a provider failure: no HTTP reply; NORA lacked input from {up} (our side)"
    else:
        where = "No HTTP reply recorded: NORA's own message (see message)"
    rows.append({"Agent": ag, "API": api, "Calls": int(tot[(ag, api)]), "Errors": len(g), "Error share": len(g) / tot[(ag, api)],
                 "Interactions affected": int(g[CASE].nunique()),
                 "HTTP codes": " · ".join(f"{c} {phrase(c)} ×{k:,}" for c, k in codes.items()), "No HTTP reply": no_status,
                 "Most common message": g["message"].value_counts().index[0][:200], "Earlier API it depends on (from messages)": up,
                 "Where the failure sits": where})
API_ERRORS = pd.DataFrame(rows).sort_values(["Errors"], ascending=False) if rows else pd.DataFrame()
side = Counter()
for _, r in API_ERRORS.iterrows():
    side[r["Where the failure sits"].split(":")[0]] += r["Errors"]
fact("error_sides", " · ".join(f"{k}: {v:,}" for k, v in side.most_common()) or "no errors", "Failed calls by where they sit")
code_tot = err_calls["code"].dropna().astype(int).value_counts()
fact("error_codes", " · ".join(f"{c} {phrase(c)} {k:,}" for c, k in code_tot.items()) or "none", "Failed calls by HTTP code")

# dependencies NORA states itself, checked against the order in the traces and against the order-only DAG
order_found = {(TASK_API[a], TASK_API[b]) for pl in [FINAL["std"]] + list(FINAL["subs"].values()) for a, b in pl.get("order_edges", [])}
