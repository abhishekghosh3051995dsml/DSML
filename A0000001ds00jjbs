# %% PHASE 3 - Event log: every interaction as ordered steps

section("PHASE 3  Event log")
calls = calls.reset_index(drop=True)
calls["call_no"] = calls.groupby(CASE).cumcount()
calls["task"] = calls[AGENT] + " · " + calls[TOOL].astype(str)
new_step = calls["task"] != calls.groupby(CASE)["task"].shift()
calls["step_no"] = new_step.astype(int).groupby(calls[CASE]).cumsum()
same_step = ~new_step
same_in = calls["_in"].fillna("\x00").eq(calls.groupby(CASE)["_in"].shift().fillna("\x00"))
calls["retry"] = same_step & same_in

IDS = calls[CASE].drop_duplicates().tolist()
n = len(IDS)
first = calls.groupby([CASE, "task"], sort=False)["call_no"].min()
POS = {c: g.droplevel(0).to_dict() for c, g in first.groupby(level=0, sort=False)}          # first position of each task
TASKS = {c: set(p) for c, p in POS.items()}
STEPS = calls[new_step].groupby(CASE, sort=False)["task"].agg(list).to_dict()                # ordered steps
TASK_AGENT = calls.groupby("task")[AGENT].first().to_dict()
TASK_API = calls.groupby("task")[TOOL].first().to_dict()
SYS_OF = {t: API_SYSTEM.get(a) for t, a in TASK_API.items()}
fact("interactions", n, "Interactions with at least one call")
fact("agents", calls.loc[calls[AGENT] != UNKNOWN, AGENT].nunique(), "Agents")
fact("apis", calls[TOOL].nunique(), "Distinct APIs")
fact("tasks", len(TASK_AGENT), "Distinct tasks (agent · API)")
fact("variants", len(Counter(tuple(STEPS[c]) for c in IDS)), "Different exact step sequences")

# %% PHASE 4 - Hand-off detection: a call whose name is another agent's name (words shared by several agent names ignored)

section("PHASE 4  Hand-off detection")


def words(x):
    return {w for w in re.split(r"[^0-9a-z]+", str(x).lower()) if w}


AGENTS = sorted(a for a in calls[AGENT].unique() if a != UNKNOWN)
shared = Counter(w for a in AGENTS for w in words(a))
GENERIC = {w for w, k in shared.items() if k > 1}
OWN = {a: words(a) - GENERIC for a in AGENTS}
HANDOFF, detect = {}, []
for t in sorted(calls[TOOL].astype(str).unique()):
    tw = words(t)
    hits = [a for a in AGENTS if OWN[a] and OWN[a] <= tw and tw - OWN[a] <= GENERIC]
    if len(hits) != 1:
        continue
    callers = calls.loc[calls[TOOL] == t, AGENT]
    if (callers != hits[0]).mean() <= MAJORITY:
        continue
    HANDOFF[t] = hits[0]
    detect.append({"Hand-off call": t, "Agent it names": hits[0], "Words only this agent's name has": ", ".join(sorted(OWN[hits[0]])),
                   "Made by": " · ".join(f"{a} ({k:,})" for a, k in callers.value_counts().items())})
calls["is_handoff"] = calls[TOOL].isin(list(HANDOFF))
HO = calls[calls["is_handoff"]]
DISP = HO.groupby(CASE)[TOOL].agg(set).to_dict()                                             # hand-offs per interaction
HO_FIRST = HO.groupby([CASE, TOOL])["call_no"].min().to_dict()
WORK = calls[~calls["is_handoff"]]
RAN = WORK.groupby(CASE)[AGENT].agg(set).to_dict()                                           # agents that did work
AG_FIRST = WORK.groupby([CASE, AGENT])["call_no"].min().to_dict()
AGENT_TASKS = WORK.groupby(AGENT)["task"].agg(lambda s: sorted(set(s))).to_dict()
calls["system"] = np.where(calls["is_handoff"], "hand-off", calls[TOOL].map(API_SYSTEM).fillna("not recorded"))
fact("handoffs", ", ".join(HANDOFF) or "none", "Hand-off calls found")
fact("coordinator", " · ".join(f"{a} ({k:,})" for a, k in HO[AGENT].value_counts().items()) or "none", "Agent(s) making the hand-offs")
fact("handoff_calls", int(calls["is_handoff"].sum()), "Hand-off calls")
fact("api_calls", int((~calls["is_handoff"]).sum()), "API calls (tool calls that fetch from a system)")

# dependencies NORA states itself: an error message of API X that names an earlier API, or names a field that only one API returns
API_NAMES = sorted(calls[TOOL].astype(str).unique())
name_re = {a: re.compile(rf"(?<![0-9A-Za-z_]){re.escape(a)}(?![0-9A-Za-z_])") for a in API_NAMES}


def keys_of(obj, depth=0, out=None):
    out = set() if out is None else out
    if depth <= 5:
        if isinstance(obj, dict):
            for k, v in obj.items():
                out.add(str(k))
                keys_of(v, depth + 1, out)
        elif isinstance(obj, list):
            for v in obj[:3]:
                keys_of(v, depth + 1, out)
    return out


PRODUCERS = defaultdict(set)                                   # output field -> APIs that return it (from a sample of successful outputs)
if COL["output"]:
    okc = calls.loc[calls["outcome"] == "returned data", [TOOL, COL["output"]]]
    okc = okc.sample(frac=1, random_state=args.seed).groupby(TOOL).head(max(5, args.sample // max(okc[TOOL].nunique(), 1)))
    for api_, v in zip(okc[TOOL], okc[COL["output"]]):
        d = parse_json(v)
        if d is not None:
            for k in keys_of(d):
                PRODUCERS[k].add(api_)
    PRODUCERS = {k: v for k, v in PRODUCERS.items() if len(v) <= MAJORITY * len(API_NAMES)}   # fields most APIs return say nothing
evid_rows = defaultdict(int)
STATED_API_EDGES, STATED_UP = set(), defaultdict(set)
errs = calls[calls["_err"].notna()]
for (txt, x, no_status), k in errs.assign(_ns=errs["status"].isna()).groupby(["_err", TOOL, "_ns"]).size().items():
    for u in (a for a in API_NAMES if a != x and name_re[a].search(txt)):
        evid_rows[(u, x, "message names the API")] += k
        STATED_API_EDGES.add((u, x))
        STATED_UP[x].add(u)
    if no_status:
        for tok in set(re.findall(r"[A-Za-z_][A-Za-z0-9_]*", txt)) & set(PRODUCERS):
            prods = PRODUCERS[tok] - {x}
            for u in prods:
                evid_rows[(u, x, f"message names field '{tok}', returned by " + ("this API only" if len(prods) == 1 else f"{len(prods)} APIs"))] += k
                STATED_UP[x].add(u)
            if len(prods) == 1:
                STATED_API_EDGES.add((next(iter(prods)), x))
STATED_EDGES = {(tu, tx) for u, x in STATED_API_EDGES for tu, a in TASK_API.items() if a == u for tx, b in TASK_API.items() if b == x}
fact("stated_edges", len(STATED_API_EDGES), "Dependencies NORA states in its own error messages (API -> API)")

# %% PHASE 5 - The model (learned only from the interactions it is given)
#   (a) hand-off test   which hand-offs bring work that does not happen otherwise (Fisher's exact test + Benjamini-Hochberg)
#   (b) classes         interaction class = exact set of hand-offs that bring work
#   (c) task DAG        per class: Heuristics Miner dependency + binomial test + BH, cycles broken, transitive reduction, stages

section("PHASE 5  The model")


def fisher_greater(a, b, c, d):
    return fisher_exact([[a, b], [c, d]], alternative="greater")


def handoff_test(ids):
    ids_set, m = set(ids), len(ids)
    rows, task_rows = [], []
    for t, ag in HANDOFF.items():
        handed = {c for c in ids if t in DISP.get(c, ())}
        nd, nn = len(handed), m - len(handed)
        ran = {c for c in ids if ag in RAN.get(c, ())}
        both, without = len(handed & ran), len(ran - handed)
        odds, p = fisher_greater(both, nd - both, without, nn - without) if nd and nn else (np.nan, np.nan)
        rows.append({"t": t, "a": ag, "nd": nd, "nn": nn, "with": both / nd if nd else np.nan, "without": without / nn if nn else np.nan,
                     "odds": odds, "p": p, "_handed": handed})
        for task in AGENT_TASKS.get(ag, []):
            tw = sum(1 for c in handed if task in TASKS[c])
            to = sum(1 for c in ids_set - handed if task in TASKS[c])
            _, tp = fisher_greater(tw, nd - tw, to, nn - to) if nd and nn else (np.nan, np.nan)
            task_rows.append({"t": t, "task": task, "with": tw / nd if nd else np.nan, "without": to / nn if nn else np.nan, "p": tp,
                              "home": tw / (tw + to) if tw + to else np.nan})
    for r, q in zip(rows, bh([r["p"] for r in rows])):
        r["q"] = q
    for r, q in zip(task_rows, bh([r["p"] for r in task_rows])):
        r["q"] = q
        r["dependent"] = bool(r["with"] > MAJORITY and r["without"] < MAJORITY and q < ALPHA)
    dep = defaultdict(list)
    for r in task_rows:
        if r["dependent"]:
            dep[r["t"]].append(r["task"])
    for r in rows:
        r["dependent_tasks"] = sorted(dep.get(r["t"], []))
        ok = [c for c in r["_handed"] if any(t in TASKS[c] for t in r["dependent_tasks"])]
        r["after"] = (sum(1 for c in ok if min(POS[c][t] for t in r["dependent_tasks"] if t in POS[c]) > HO_FIRST[(c, r["t"])]) / len(ok)
                      if ok else np.nan)
        if r["dependent_tasks"]:                                              # at least one task that only runs after this hand-off
            r["verdict"] = "Brings specialist work"
        elif pd.notna(r["without"]) and r["without"] >= MAJORITY:
            r["verdict"] = "Agent works regardless of the hand-off"
        else:
            r["verdict"] = "No clear link"
    return rows, task_rows


def binom_greater(k, n_):
    return binom.sf(np.asarray(k) - 1, np.asarray(n_), 0.5)


def build_plan(members, tasks):
    """Dependency DAG over `tasks` learned from the first positions of the tasks in `members`."""
    k = len(tasks)
    empty = {"tasks": list(tasks), "stages": [list(tasks)] if k else [], "edges": [], "stats": [], "pred": {t: [] for t in tasks}}
    if k < 2 or not members:
        return empty
    P = np.full((len(members), k), np.inf)
    for i, c in enumerate(members):
        pos = POS[c]
        for j, t in enumerate(tasks):
            if t in pos:
                P[i, j] = pos[t]
    fin = np.isfinite(P)
    before = np.zeros((k, k))
    for a in range(k):
        before[a] = ((P[:, [a]] < P) & fin[:, [a]] & fin).sum(0)
    A, B = np.where(before > before.T)
    kept, source = {}, {}
    if len(A):
        ab, ba = before[A, B], before[B, A]
        dep = (ab - ba) / (ab + ba + 1)
        q = bh(binom_greater(ab, ab + ba))
        keep = (dep >= args.dependency) & (q < ALPHA)
        kept = {(int(a), int(b)): (int(x), int(y), float(d), float(qq)) for a, b, x, y, d, qq, kp in zip(A, B, ab, ba, dep, q, keep) if kp}
        source = {e: "order in the traces" for e in kept}
    order_edges = [(tasks[a], tasks[b]) for a, b in kept]
    idx = {t: j for j, t in enumerate(tasks)}
    for ta, tb in STATED_EDGES:                                    # dependencies NORA states in its own messages are always kept
        if ta in idx and tb in idx:
            a, b = idx[ta], idx[tb]
            kept.pop((b, a), None)
            source[(a, b)] = "order in the traces + NORA's messages" if (a, b) in kept else "NORA's messages"
            kept[(a, b)] = (int(before[a, b]), int(before[b, a]), 2.0, kept.get((a, b), (0, 0, 0, np.nan))[3])
    if not kept:
        return empty
    while True:                                                    # topological order; break a cycle at its weakest edge
        indeg = Counter(b for _, b in kept)
        succ = defaultdict(list)
        for a, b in kept:
            succ[a].append(b)
        ready = sorted(j for j in range(k) if indeg[j] == 0)
        order = []
        while ready:
            j = ready.pop(0)
            order.append(j)
            for b in succ[j]:
                indeg[b] -= 1
                if indeg[b] == 0:
                    ready.append(b)
        if len(order) == k:
            break
        done = set(order)
        kept.pop(min((e for e in kept if e[0] not in done and e[1] not in done), key=lambda e: kept[e][2]))
    reach = {j: set() for j in range(k)}
    for j in reversed(order):
        for b in succ[j]:
            reach[j] |= {b} | reach[b]
    reduced = sorted((a, b) for a, b in kept if not any(b in reach[x] for x in succ[a] if x != b))   # transitive reduction
    level = {}
    for j in order:
        level[j] = 1 + max((level[a] for a, b in reduced if b == j), default=0)
    stages = [sorted(tasks[j] for j in range(k) if level[j] == s) for s in range(1, max(level.values()) + 1)]
    return {"tasks": list(tasks), "stages": stages, "edges": [(tasks[a], tasks[b]) for a, b in reduced],
            "stats": [{"From task": tasks[a], "To task": tasks[b], "Traces with both": kept[(a, b)][0] + kept[(a, b)][1],
                       "From came first": kept[(a, b)][0], "To came first": kept[(a, b)][1],
                       "Dependency (0-1)": round(kept[(a, b)][2], 3) if kept[(a, b)][2] <= 1 else None, "p-value (BH)": p_text(kept[(a, b)][3]),
                       "Evidence": source[(a, b)]} for a, b in reduced],
            "pred": {t: sorted(tasks[a] for a, b in reduced if tasks[b] == t) for t in tasks}, "order_edges": order_edges}


def core(ids, keep_task):
    m = len(ids)
    cnt = Counter(t for c in ids for t in TASKS[c] if keep_task(t))
    return sorted(t for t, k in cnt.items() if k / m > MAJORITY)


NONE_LABEL = "No specialist handed work"


def learn(ids):
    """Fit the decomposition model on `ids` only."""
    rows, task_rows = handoff_test(ids)
    driving = {r["t"] for r in rows if r["verdict"] == "Brings specialist work"}
    specialist_tasks = {r["task"] for r in task_rows if r["t"] in driving and (r["dependent"] or r["home"] > MAJORITY)}

    def layer(task):
        api = TASK_API[task]
        if api in HANDOFF:
            return "Hand-off" if api in driving else "Standard"
        if task in specialist_tasks:
            return "Specialist"
        return "Agent not recorded" if TASK_AGENT[task] == UNKNOWN else "Standard"

    lay = {t: layer(t) for t in TASK_AGENT}

    def label(c):
        combo = sorted(t for t in DISP.get(c, ()) if t in driving)
        return " + ".join(combo) if combo else NONE_LABEL

    labels = {c: label(c) for c in ids}
    members = defaultdict(list)
    for c in ids:
        members[labels[c]].append(c)
    std = build_plan(ids, core(ids, lambda t: lay[t] in ("Standard", "Agent not recorded")))
    dep_of = {r["t"]: set(r["dependent_tasks"]) for r in rows}
    subs = {}                                                                # one sub-plan per hand-off that brings work
    for t in sorted(driving):
        mem = [c for c in ids if t in DISP.get(c, ())]
        sp = build_plan(mem, sorted(dep_of[t]))                     # order learned among the specialist's own tasks
        ho = sorted(x for x in TASK_API if TASK_API[x] == t)        # the hand-off comes first by definition: these tasks only run after it
        sp["tasks"], sp["stages"] = ho + sp["tasks"], [ho] + sp["stages"]
        for x in (sp["stages"][1] if len(sp["stages"]) > 1 else []):
            sp["pred"][x] = ho
        sp["pred"].update({h: [] for h in ho})
        subs[t] = sp
    one = build_plan(ids, core(ids, lambda t: True))                         # baseline: one plan for everyone, no decomposition
    calls_n = {c: CALLS_N[c] for c in ids}
    med = {l: float(np.median([calls_n[c] for c in mem])) for l, mem in members.items()}
    trans, trans_all = defaultdict(lambda: defaultdict(Counter)), defaultdict(Counter)
    for c in ids:
        s = STEPS[c]
        for x, y in zip(s, s[1:]):
            trans[labels[c]][x][y] += 1
            trans_all[x][y] += 1
    return {"rows": rows, "task_rows": task_rows, "driving": driving, "layer": lay, "label": label, "labels": labels, "members": members,
            "std": std, "subs": subs, "one": one, "median_calls": med, "median_all": float(np.median(list(calls_n.values()))),
            "trans": trans, "trans_all": trans_all}


CALLS_N = calls.groupby(CASE).size().to_dict()
log.info("   model defined: hand-off test -> classes -> task DAG per class (learned only from the interactions it is fitted on)")

# %% PHASE 6 - Validation: k-fold cross-validation on unseen interactions
#   With decomposition    = standard plan + the plan of the interaction's class
#   Without decomposition = one plan learned from all training interactions (the baseline the decomposition must beat)

section(f"PHASE 6  Validation ({args.folds}-fold cross-validation)")


def top(counter, k):
    return [y for y, _ in counter.most_common(k)] if counter else []


def compose(model, c):
    """Executable plan of an interaction = standard plan + the sub-plan of every hand-off that brings work in it."""
    tasks, edges = set(model["std"]["tasks"]), list(model["std"]["edges"])
    for t in sorted(DISP.get(c, ())):
        if t in model["subs"]:
            tasks |= set(model["subs"][t]["tasks"])
            edges += model["subs"][t]["edges"]
    return tasks, edges


def evaluate(model, ids):
    res = []
    for c in ids:
        lab = model["label"](c)
        pred, edges = compose(model, c)
        base = set(model["one"]["tasks"])
        act, pos = TASKS[c], POS[c]
        spec = lambda S: {t for t in S if model["layer"].get(t) in ("Hand-off", "Specialist")}
        sp, sa, sb = spec(pred), spec(act), spec(base)

        def order_check(e):
            ok = tot = 0
            for a, b in e:
                if a in pos and b in pos:
                    tot += 1
                    ok += pos[a] < pos[b]
            return ok, tot

        ok, tot = order_check(edges)
        bok, btot = order_check(model["one"]["edges"])
        s = STEPS[c]
        h1 = h3 = b1 = b3 = 0
        tc = model["trans"].get(lab, {})
        for x, y in zip(s, s[1:]):
            g = tc.get(x) or model["trans_all"].get(x)
            p3 = top(g, 3)
            h1 += bool(p3) and p3[0] == y
            h3 += y in p3
            q3 = top(model["trans_all"].get(x), 3)
            b1 += bool(q3) and q3[0] == y
            b3 += y in q3
        res.append({"case": c, "label": lab, "tp": len(pred & act), "fp": len(pred - act), "fn": len(act - pred),
                    "btp": len(base & act), "bfp": len(base - act), "bfn": len(act - base),
                    "stp": len(sp & sa), "sfp": len(sp - sa), "sfn": len(sa - sp), "sbtp": len(sb & sa), "sbfp": len(sb - sa), "sbfn": len(sa - sb), "ok": ok, "tot": tot, "bok": bok, "btot": btot,
                    "follows": ok == tot, "bfollows": bok == btot, "h1": h1, "h3": h3, "b1": b1, "b3": b3, "nxt": max(len(s) - 1, 0),
                    "ae": abs(CALLS_N[c] - model["median_calls"].get(lab, model["median_all"])), "bae": abs(CALLS_N[c] - model["median_all"])})
    return pd.DataFrame(res)


def scores(r):
    def f1(tp, fp, fn):
        p, rc = tp / max(tp + fp, 1), tp / max(tp + fn, 1)
        return p, rc, 2 * p * rc / max(p + rc, 1e-12)
    p, rc, f = f1(r["tp"].sum(), r["fp"].sum(), r["fn"].sum())
    bp, brc, bf = f1(r["btp"].sum(), r["bfp"].sum(), r["bfn"].sum())
    sp_, src, sf = f1(r["stp"].sum(), r["sfp"].sum(), r["sfn"].sum())
    sbp, sbrc, sbf = f1(r["sbtp"].sum(), r["sbfp"].sum(), r["sbfn"].sum())
    nx = max(r["nxt"].sum(), 1)
    return {"sprecision": sp_, "srecall": src, "sf1": sf, "b_sprecision": sbp, "b_srecall": sbrc, "b_sf1": sbf,
            "precision": p, "recall": rc, "f1": f, "order": r["ok"].sum() / max(r["tot"].sum(), 1), "follows": r["follows"].mean(),
            "next1": r["h1"].sum() / nx, "next3": r["h3"].sum() / nx, "mae": r["ae"].mean(),
            "b_precision": bp, "b_recall": brc, "b_f1": bf, "b_order": r["bok"].sum() / max(r["btot"].sum(), 1), "b_follows": r["bfollows"].mean(),
            "b_next1": r["b1"].sum() / nx, "b_next3": r["b3"].sum() / nx, "b_mae": r["bae"].mean()}


strat_raw = [" + ".join(sorted(DISP.get(c, ()))) for c in IDS]
cnt = Counter(strat_raw)
strat = [s if cnt[s] >= args.folds else "rare" for s in strat_raw]
folds = min(args.folds, max(2, min(Counter(strat).values()))) if n >= 2 * args.folds else 2
skf = StratifiedKFold(n_splits=folds, shuffle=True, random_state=args.seed)
OOF, FOLD_ROWS, VERDICTS = [], [], defaultdict(list)
for k, (tr, te) in enumerate(skf.split(np.zeros(n), strat), start=1):
    t1 = time.time()
    train, test = [IDS[i] for i in tr], [IDS[i] for i in te]
    model = learn(train)
    r = evaluate(model, test)
    r["fold"] = k
    OOF.append(r)
    s = scores(r)
    for row in model["rows"]:
        VERDICTS[row["t"]].append(row["verdict"])
    FOLD_ROWS.append({"Fold": k, "Train interactions": len(train), "Test interactions": len(test),
                      "Hand-offs that bring work": len(model["driving"]), "Classes in training": len(model["members"]),
                      "Specialist task F1": s["sf1"], "Task precision": s["precision"], "Task recall": s["recall"], "Task F1": s["f1"],
                      "Order accuracy": s["order"], "Follow plan fully": s["follows"], "Next step top-1": s["next1"], "Next step top-3": s["next3"],
                      "Tool-call error (MAE)": round(s["mae"], 2), "Baseline specialist task F1": s["b_sf1"], "Baseline task F1": s["b_f1"], "Baseline next step top-1": s["b_next1"],
                      "Seconds": round(time.time() - t1, 1)})
    log.info(f"   fold {k}/{folds}: train {len(train):,} · test {len(test):,} · specialist F1 {s['sf1']:.3f} (baseline {s['b_sf1']:.3f}) · task F1 {s['f1']:.3f} (baseline {s['b_f1']:.3f}) · "
             f"order {s['order']:.3f} · next-step top-1 {s['next1']:.3f} (baseline {s['b_next1']:.3f}) · {time.time() - t1:.1f}s")
OOF = pd.concat(OOF, ignore_index=True)
POOLED = scores(OOF)

# bootstrap 95% confidence intervals over the unseen interactions (resampling interactions)
rng = np.random.default_rng(args.seed)
SUMS = ["tp", "fp", "fn", "btp", "bfp", "bfn", "stp", "sfp", "sfn", "sbtp", "sbfp", "sbfn", "ok", "tot", "bok", "btot", "h1", "h3", "b1", "b3", "nxt"]
M = OOF[SUMS].to_numpy(float)
FOL, BFOL, AE, BAE = (OOF[c].to_numpy(float) for c in ("follows", "bfollows", "ae", "bae"))
boot = defaultdict(list)
step = max(1, args.bootstrap // 10)
for b0 in range(0, args.bootstrap, step):
    nb = min(step, args.bootstrap - b0)
    W = rng.multinomial(len(OOF), np.full(len(OOF), 1 / len(OOF)), size=nb).astype(float)
    S = W @ M
    col = {c: S[:, i] for i, c in enumerate(SUMS)}
    for pre, (tp, fp, fn) in (("", ("tp", "fp", "fn")), ("b_", ("btp", "bfp", "bfn")), ("s", ("stp", "sfp", "sfn")), ("b_s", ("sbtp", "sbfp", "sbfn"))):
        p_, r_ = col[tp] / np.maximum(col[tp] + col[fp], 1), col[tp] / np.maximum(col[tp] + col[fn], 1)
        boot[pre + "precision"] += list(p_)
        boot[pre + "recall"] += list(r_)
        boot[pre + "f1"] += list(2 * p_ * r_ / np.maximum(p_ + r_, 1e-12))
    boot["order"] += list(col["ok"] / np.maximum(col["tot"], 1))
    boot["b_order"] += list(col["bok"] / np.maximum(col["btot"], 1))
    for c_, h in (("next1", "h1"), ("next3", "h3"), ("b_next1", "b1"), ("b_next3", "b3")):
        boot[c_] += list(col[h] / np.maximum(col["nxt"], 1))
    boot["follows"] += list(W @ FOL / len(OOF))
    boot["b_follows"] += list(W @ BFOL / len(OOF))
    boot["mae"] += list(W @ AE / len(OOF))
    boot["b_mae"] += list(W @ BAE / len(OOF))
    log.info(f"   bootstrap {b0 + nb:,}/{args.bootstrap:,}")
CI = {k: (float(np.percentile(v, 2.5)), float(np.percentile(v, 97.5))) for k, v in boot.items()}
fold_df = pd.DataFrame(FOLD_ROWS)
for key, name in (("sf1", "Specialist task F1"), ("f1", "Task F1"), ("order", "Order accuracy"), ("mae", "Tool-call error (MAE)")):
    fact(f"cv_{key}", f"{POOLED[key]:.3f} (95% CI {CI[key][0]:.3f}-{CI[key][1]:.3f}; baseline {POOLED['b_' + key]:.3f})", f"{name} on unseen interactions")

