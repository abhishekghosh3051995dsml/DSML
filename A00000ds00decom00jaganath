                                           + (f" Different from its sibling plans in: {s['name']}." if s["split"] and s["core"] else "")
                                           + (f" Family kept as one plan: {s['reason']}." if not s["split"] and s["reason"] and s["core"] else ""),
                          "template": s["template"], "confidence": round(s["confidence"], 3), "strength": band(s["confidence"]),
                          "example_interactions": ", ".join(s["examples"])})
catalogue = pd.DataFrame(catalogue)
validation = summary_v.rename(columns={"level": "decomposition level tested", "f1": "f1 (sub-tasks predicted vs run)",
                                       "f1_case_specific": "f1 on case-specific sub-tasks only", "order_agreement": "order agreement",
                                       "f1_fold_sd": "f1 spread across folds (sd)"})
overview = pd.DataFrame(OVERVIEW + [("Tier 1 routine preamble (list)", ", ".join(routine_list))], columns=["item", "value"])
findings = pd.DataFrame({"finding": FINDINGS})

nested = {"source": SRC.name, "interactions": n, "L1": {k: int(v) for k, v in inter["L1"].value_counts().items()} if "L1" in inter else {},
          "tiers": {"routine_preamble": routine_list, "shared_diagnostics_battery": sorted(M["battery"])}, "validation": summary_v.to_dict("records"), "D2": {}}
for d in D2.values():
    nested["D2"][d["id"]] = {"name": d["name"], "cases": d["cases"], "confidence": round(d["confidence"], 3), "specialists": d["specialists"], "D3": {}}
    for s in [s for s in D3.values() if s["parent"] == d["id"]]:
        nested["D2"][d["id"]]["D3"][s["id"]] = {"name": s["name"], "cases": s["cases"], "confidence": round(s["confidence"], 3),
                                                "sub_tasks": templates[templates["D3_id"] == s["id"]].drop(columns=["D2_id", "D3_id", "D3_name"]).to_dict("records")}
nested["interactions"] = {r.interaction_id: {"cid": getattr(r, "cid", None), "L1": getattr(r, "L1", None), "D2": r.D2_id, "D3": r.D3_id,
                                             "sub_tasks": sub_task_sheet[sub_task_sheet["interaction_id"] == r.interaction_id]
                                             .drop(columns=["interaction_id", "D2_id", "D3_id"]).to_dict("records")}
                          for r in decomposition.itertuples(index=False)}
with open(OUT / "decomposition_dictionary.json", "w", encoding="utf-8") as fh:
