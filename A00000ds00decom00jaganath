from openpyxl import load_workbook
from openpyxl.cell.cell import ILLEGAL_CHARACTERS_RE
from openpyxl.styles import Alignment, Font, PatternFill

sheets = {"Decomposition_View": view, "Overview": overview, "Findings": findings, "Decomposition": decomposition, "Sub_Tasks": sub_task_sheet,
          "Plan_Templates": templates, "Catalogue": catalogue, "Validation": validation}
xlsx = OUT / f"{SRC.stem}_task_decomposition.xlsx"
with pd.ExcelWriter(xlsx, engine="openpyxl") as xw:
    for name, frame in sheets.items():
        frame.map(lambda v: ILLEGAL_CHARACTERS_RE.sub("", v)[:32000] if isinstance(v, str) else v).to_excel(xw, sheet_name=name, index=False)
fills = {"high": "D9EAD3", "medium": "FFF2CC", "low": "F4CCCC", "returned": "D9EAD3", "empty": "FFF2CC", "failed": "F4CCCC"}
wb = load_workbook(xlsx)
for ws in wb.worksheets:
    ws.freeze_panes = "B2"
    ws.auto_filter.ref = ws.dimensions
    for j, cell in enumerate(ws[1], start=1):
        cell.font, cell.fill = Font(bold=True, color="FFFFFF"), PatternFill("solid", fgColor="1C5CAB")
        cell.alignment = Alignment(vertical="center")
        width = max(len(str(ws.cell(i, j).value or "")) for i in range(1, min(ws.max_row, 150) + 1))
        ws.column_dimensions[cell.column_letter].width = max(10, min(70, width + 2))
        if cell.value in ("D2_band", "D3_band", "strength", "result"):
            for i in range(2, ws.max_row + 1):
                f = fills.get(ws.cell(i, j).value)
                if f:
                    ws.cell(i, j).fill = PatternFill("solid", fgColor=f)
    if ws.title == "Decomposition_View":
        tint = {"Source_Intent-L1": "DDEBF7", "Decomposition_Family-D2": "E2EFDA", "SubTask_Plan-D3": "FFF2CC", "User_Message": "F2F2F2"}
        for j, cell in enumerate(ws[1], start=1):
            if cell.value in tint:
                for i in range(2, ws.max_row + 1):
                    ws.cell(i, j).fill = PatternFill("solid", fgColor=tint[cell.value])
            if cell.value in ("User_Message", "SubTask_Sequence", "Root_Cause"):
                ws.column_dimensions[cell.column_letter].width = 70
    if ws.title in ("Overview", "Findings", "Catalogue", "Validation"):
        for row in ws.iter_rows(min_row=2):
            for cell in row:
                cell.alignment = Alignment(wrap_text=True, vertical="top")
wb.save(xlsx)
log.info(f"   Excel -> {xlsx.name} ({len(sheets)} sheets)")
log.info(f"   JSON  -> decomposition_dictionary.json")
log.info(f"Finished in {time.time() - t0:.0f}s")
