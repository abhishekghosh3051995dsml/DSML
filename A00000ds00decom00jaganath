save(fig, OUT / "charts" / "02_decomposition_hierarchy.png")

plan_ids = [s["id"] for s in D3.values()]
cols = list(dict.fromkeys(t for s in D3.values() for t in s["core"]))
if cols:
    share = pd.DataFrame(0.0, index=plan_ids, columns=cols)
    for sid in plan_ids:
        mem = D3[sid]["members"]
        for t in cols:
            share.loc[sid, t] = np.mean([t in plans[i] for i in mem])
    posn = {t: np.median([p.index(t) / max(len(p) - 1, 1) for p in plans if t in p]) for t in cols}
    share = share[sorted(cols, key=lambda t: posn[t])]
    fig, ax = plt.subplots(figsize=(max(7, 0.55 * share.shape[1] + 5), 0.42 * share.shape[0] + 2))
    im = ax.imshow(share.values, cmap="Blues", vmin=0, vmax=1, aspect="auto")
    ax.set_xticks(range(share.shape[1]), [c[:32] for c in share.columns], rotation=40, ha="right", fontsize=7.5)
    ax.set_yticks(range(share.shape[0]), [f"{sid}  {D3[sid]['name'][:48]}" for sid in plan_ids], fontsize=7.5)
    for a in range(share.shape[0]):
        for b in range(share.shape[1]):
            v = share.values[a, b]
            if v >= 0.05:
                ax.text(b, a, f"{v:.0%}", ha="center", va="center", fontsize=6.5, color="white" if v > 0.6 else INK)
    for a, sid in enumerate(plan_ids[:-1]):
