        ax.barh(yy, d["cases"], color=colour[d["parent"]], height=0.62)
        ax.text(d["cases"] + 0.4, yy, f"{d['id']}  {d['name']}  ({d['cases']})", fontsize=8, color=INK2, va="center")
ax.set_ylim(y, -1)
ax.set_xlim(0, max(d["cases"] for d in D3.values()) * 2.6)
