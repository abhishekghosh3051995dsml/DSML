            continue
        out.append(f"hand-off → {r.sub_task}" if r.kind.startswith("hand-off") else f"{r.sub_task} [{r.system or 'api'} · {r.result}]")
    return "  →  ".join(f"{k}. {x}" for k, x in enumerate(out, start=1)) or "(routine preamble only)"


def api_line(g):
