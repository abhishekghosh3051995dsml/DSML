def step_line(g):
    out, battery_seen = [], False
    for r in g.sort_values("order").itertuples():
        if r.tier.startswith("1"):
            continue
        if r.tier.startswith("2"):
            if not battery_seen:
                n_q = int(g["tier"].str.startswith("2").sum())
                out.append(f"{BATTERY_STEP} ({n_q} queries)")
