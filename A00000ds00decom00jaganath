    prefixes = {t for t, k in lead.items() if k >= NAME_AFFIX_MIN} - set(protect)
    out = {}
    for nm, p in parts.items():
        keep = [t for t in p if t.lower() not in prefixes and t.lower() not in ENGLISH_STOP_WORDS] or p[-1:]
        words = [casing.get(t.lower(), t.lower()) if casing is not None else t for t in keep]
        out[nm] = words[0][:1].upper() + words[0][1:] + (" " + " ".join(words[1:]) if len(words) > 1 else "") if words else nm
    return out


