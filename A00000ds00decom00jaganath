SERIES = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"]
INK, INK2, MUTED, GRID = "#1f1f1e", "#5f5e58", "#9a9990", "#e8e7e2"
plt.rcParams.update({"font.size": 9, "axes.titlesize": 12, "axes.titlelocation": "left", "axes.titlecolor": INK,
