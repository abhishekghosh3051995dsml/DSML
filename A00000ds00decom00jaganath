def locate():
    if args.file:
        return Path(args.file)
    roots = [os.environ.get(k) for k in ("OneDriveCommercial", "OneDrive")]
    here = [Path.cwd()] + ([Path(__file__).resolve().parent] if "__file__" in globals() else [])
    dirs = [d for d in dict.fromkeys(here + [Path(r) / "Downloads" for r in roots if r] + [Path.home() / "Downloads"]) if d.is_dir()]
    matches = [p for d in dirs for p in d.glob(args.pattern)]
    if not matches:
        raise FileNotFoundError(f"No file matching {args.pattern} in {dirs}")
    return max(matches, key=lambda p: p.stat().st_mtime)


