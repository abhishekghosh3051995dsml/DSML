    plt.close(fig)
    log.info(f"   chart -> {path.relative_to(OUT)}")


xy = TSNE(n_components=2, perplexity=max(2, min(30, (n - 1) / 3)), metric="cosine", init="pca", random_state=SEED).fit_transform(M["Z"] + 1e-9)
xy = xy + np.random.default_rng(SEED).normal(0, 0.01 * np.ptp(xy, axis=0), xy.shape)
fig, ax = plt.subplots(figsize=(11, 6.5))
for d in D2.values():
    m = (inter["D2_id"] == d["id"]).values
    firm = m & (inter["D2_confidence"] >= MEDIUM).values
    ax.scatter(xy[firm, 0], xy[firm, 1], s=40, c=colour[d["id"]], edgecolors="white", linewidths=1.5, label=f"{d['id']}  {d['name']}  ({d['cases']})")
    ax.scatter(xy[m & ~firm, 0], xy[m & ~firm, 1], s=40, facecolors="white", edgecolors=colour[d["id"]], linewidths=1.5)
    cx, cy = np.median(xy[m], axis=0)
    ax.annotate(d["id"], (cx, cy), fontsize=8, color=INK, ha="center", va="center", bbox=dict(boxstyle="round,pad=0.25", fc="white", ec=colour[d["id"]], lw=1))
ax.set_xticks([])
ax.set_yticks([])
for s in ax.spines.values():
    s.set_color(GRID)
ax.set_title(f"D2 decomposition families - {len(D2)} families across {n} interactions (built from specialists and sub-tasks only)")
ax.legend(frameon=False, fontsize=8, loc="upper left", bbox_to_anchor=(1.0, 1.0), title="filled = confident, hollow = sits between families", title_fontsize=7.5)
save(fig, OUT / "charts" / "01_D2_families.png")

rows_h, ypos, y = [], [], 0
for d in D2.values():
