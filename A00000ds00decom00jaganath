section("PHASE 4  Validation: 5-fold, every test fold kept out of every fitting step")


def overlap(pred, actual):
    p, a = set(pred), set(actual)
    if not p and not a:
        return 1.0, 1.0, 1.0
    if not p or not a:
        return 0.0, 0.0, 0.0
    hit = len(p & a)
    prec, rec = hit / len(p), hit / len(a)
    return prec, rec, (2 * prec * rec / (prec + rec)) if hit else 0.0


def order_agreement(pred, actual):
    both = [s for s in pred if s in actual]
    pairs = [(a, b) for x, a in enumerate(both) for b in both[x + 1:]]
    return np.mean([actual.index(a) < actual.index(b) for a, b in pairs]) if pairs else np.nan


rows_v = []
