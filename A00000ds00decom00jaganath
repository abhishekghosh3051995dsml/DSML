    catalogue.append({"level": "D2", "id": d["id"], "parent": "", "name": d["name"], "cases": d["cases"], "share": round(d["cases"] / n, 3),
                      "what_it_means": f"Cases the orchestrator decomposed towards {d['specialists'] or 'no specialist'}. Worked through {len(kids)} plan(s).",
                      "template": d["template"], "confidence": round(d["confidence"], 3), "strength": band(d["confidence"]),
                      "example_interactions": ", ".join(d["examples"])})
    for s in kids:
        catalogue.append({"level": "D3", "id": s["id"], "parent": d["id"], "name": s["name"], "cases": s["cases"], "share": round(s["cases"] / n, 3),
