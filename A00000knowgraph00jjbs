#legend span{display:flex;align-items:center;gap:5px}
@media (max-width:900px){#side{display:none}#info{width:270px;min-width:270px}}
</style></head><body>
<header><h1>NORA <span>Task Decomposition</span> · Knowledge Graph</h1><span class="src" id="src"></span>
<div class="tabs"><button data-v="net" class="on">Graph</button><button data-v="3d">3D graph</button><button data-v="plan">Plan explorer</button><button data-v="guide">How to read</button></div></header>
<main>
<aside id="side">
 <h3>Find</h3><input id="q" type="text" list="names" placeholder="Search a class, agent, API…"><datalist id="names"></datalist>
 <h3>Follow one class</h3><select id="clsSel"></select>
 <div><button class="btn" id="reset">Reset</button><button class="btn" id="lbl">Labels: auto</button><button class="btn" id="shake">Re-arrange</button></div>
 <h3>Colour by</h3><select id="colorBy"><option value="type">Node type</option><option value="community">Cluster (community)</option><option value="layer">Task layer</option><option value="system">System</option></select>
 <h3>Show nodes</h3><div id="typeBox"></div>
 <h3>Show links</h3><div id="relBox"></div>
 <p class="hint">Scroll or pinch to zoom, drag to move, drag a node to pull it. Click a node to see everything linked to it.</p>
</aside>
<section id="stage">
 <canvas id="cv"></canvas><div id="tip"></div><div id="legend"></div>
 <div id="planwrap" style="display:none"></div>
 <div id="g3d" style="display:none"></div><div id="msg3d" class="hint" style="display:none"></div>
 <div id="guide" style="display:none"></div>
</section>
<aside id="info"></aside>
</main>
<script>
const DATA = /*__DATA__*/null;
const TYPES = {class:["Class","--c-class"],plan:["Standard plan","--c-plan"],handoff:["Hand-off","--c-handoff"],agent:["Agent","--c-agent"],task:["Task (agent · API)","--c-task"],api:["API","--c-api"],system:["System","--c-system"]};
const RELS = {HANDS_OFF_TO:"class → hand-off",RUNS_PLAN:"class → standard plan",INCLUDES:"standard plan → task",HANDS_OFF:"boss agent → hand-off",ACTIVATES:"hand-off → expert agent",BRINGS:"hand-off → task it brings",PERFORMS:"agent → task",CALLS:"task → API",ON_SYSTEM:"API → system",THEN:"task → next task (DAG order)"};
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const COL = Object.fromEntries(Object.entries(TYPES).map(([k,v])=>[k,css(v[1])]));
const PALETTE = ["#ff4d6d","#3ec1ff","#4ade80","#ffd23f","#a78bfa","#ff9f1c","#f472b6","#2dd4bf","#facc15","#60a5fa","#fb7185","#a3e635","#c084fc","#fdba74"];
const byId = new Map(DATA.nodes.map(n=>[n.id,n]));
const out = new Map(), inn = new Map();
DATA.edges.forEach(e=>{(out.get(e.s)||out.set(e.s,[]).get(e.s)).push(e);(inn.get(e.t)||inn.set(e.t,[]).get(e.t)).push(e);});
document.getElementById("src").textContent = `${DATA.nodes.length} nodes · ${DATA.edges.length} links · built from ${DATA.source.main} + ${DATA.source.validation}`;
const esc = s => String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt = (k,v) => { if(v===null||v===undefined||v==="") return "";
  if(typeof v==="number"){ if(/ran_when|f1/.test(k) && v<=1) return (v*100).toFixed(1)+"%"; if(/dependency/.test(k)) return v.toFixed(3);
    return Number.isInteger(v)? v.toLocaleString(): (Math.abs(v)<10? v.toFixed(2): Math.round(v).toLocaleString()); } return String(v); };
const nice = k => k.replace(/_/g," ").replace(/\bbh\b/i,"(BH)").replace(/^./,c=>c.toUpperCase());
const short=(s,n)=>s.length>n?s.slice(0,n-1)+"…":s;

/* ---------- colours ---------- */
function catColors(vals){ return Object.fromEntries([...new Set(vals)].sort().map((v,i)=>[v,PALETTE[i%PALETTE.length]])); }
const LAYERC = catColors(DATA.nodes.filter(n=>n.type==="task").map(n=>n.a.layer||"not recorded"));
const SYSC = catColors(DATA.nodes.filter(n=>n.type==="task").map(n=>n.a.system||"not recorded"));
const COMMC = Object.fromEntries((DATA.communities||[]).map((c,i)=>[c.name,PALETTE[i%PALETTE.length]]));
let colorBy = "type";
function nodeColor(n){
  if(colorBy==="community") return COMMC[n.a.community]||"#64748b";
  if(n.type==="task"&&colorBy==="layer") return LAYERC[n.a.layer||"not recorded"];
  if(n.type==="task"&&colorBy==="system") return SYSC[n.a.system||"not recorded"];
  return n.type==="handoff"&&n.a.brings_specialist_work==="no" ? "#9a7440" : COL[n.type]; }
function legend(){ const L=document.getElementById("legend");
  const m = colorBy==="type" ? Object.fromEntries(Object.entries(TYPES).filter(([k])=>DATA.counts[k]).map(([k,v])=>[v[0],COL[k]])) : colorBy==="community" ? COMMC : colorBy==="layer" ? LAYERC : SYSC;
  L.innerHTML = Object.entries(m).map(([k,c])=>`<span><i class="dot" style="background:${c};color:${c}"></i>${esc(k)}</span>`).join(""); }

/* ---------- sidebar ---------- */
const showType = Object.fromEntries(Object.keys(TYPES).map(k=>[k,true]));
const showRel = Object.fromEntries(Object.keys(RELS).map(k=>[k,k!=="THEN"]));
function buildSide(){
  const tb=document.getElementById("typeBox"); tb.innerHTML="";
  Object.entries(TYPES).forEach(([k,[name]])=>{ const c=DATA.counts[k]||0; if(!c) return;
    const r=document.createElement("label"); r.className="row"; r.innerHTML=`<input type="checkbox" ${showType[k]?"checked":""}><span class="dot" style="background:${COL[k]};color:${COL[k]}"></span>${name}<span class="cnt">${c}</span>`;
    r.querySelector("input").onchange=e=>{showType[k]=e.target.checked; restart(.7);}; tb.appendChild(r); });
  const rb=document.getElementById("relBox"); rb.innerHTML="";
  Object.entries(RELS).forEach(([k,name])=>{ const c=DATA.rels[k]||0; if(!c) return;
    const r=document.createElement("label"); r.className="row"; r.innerHTML=`<input type="checkbox" ${showRel[k]?"checked":""}>${name}<span class="cnt">${c}</span>`;
    r.querySelector("input").onchange=e=>{showRel[k]=e.target.checked; restart(.5);}; rb.appendChild(r); });
  document.getElementById("names").innerHTML = DATA.nodes.map(n=>`<option value="${esc(n.label)} — ${TYPES[n.type][0]}">`).join("");
  document.getElementById("clsSel").innerHTML = `<option value="">— all classes —</option>` + DATA.classes.map(c=>`<option value="${esc(c.id)}">${esc(c.name)} · ${esc(c.spec)} (${fmt("n",c.n)})</option>`).join("");
}

/* ---------- live force-directed graph ---------- */
const cv=document.getElementById("cv"), ctx=cv.getContext("2d"), tip=document.getElementById("tip");
let W=0,H=0,DPR=1, T={k:1,x:0,y:0}, labels="auto", hover=null, selected=null, focus=null, alpha=1, userMoved=false, raf=null;
DATA.nodes.forEach(n=>{ n.x=n.x*0.45; n.y=n.y*0.45; n.vx=0; n.vy=0; n.deg=(out.get(n.id)||[]).length+(inn.get(n.id)||[]).length; });
const maxSize = Math.max(...DATA.nodes.map(n=>n.size));
const visibleNode = n => showType[n.type] && (!focus || focus.has(n.id));
let VN=[], VE=[];
function collect(){ VN=DATA.nodes.filter(visibleNode); const ids=new Set(VN.map(n=>n.id));
  VE=DATA.edges.filter(e=>showRel[e.rel]&&ids.has(e.s)&&ids.has(e.t)).map(e=>({e,a:byId.get(e.s),b:byId.get(e.t)})); }
function tick(){
  const N=VN.length, rep=900*(focus?3.2:1);
  for(let i=0;i<N;i++){ const a=VN[i]; for(let j=i+1;j<N;j++){ const b=VN[j]; let dx=b.x-a.x, dy=b.y-a.y, d2=dx*dx+dy*dy+0.01;
      if(d2>250000) continue; const f=rep*alpha/d2, d=Math.sqrt(d2); dx/=d; dy/=d; a.vx-=dx*f; a.vy-=dy*f; b.vx+=dx*f; b.vy+=dy*f; } }
  for(const {e,a,b} of VE){ if(e.rel==="THEN") continue; const dx=b.x-a.x, dy=b.y-a.y, d=Math.sqrt(dx*dx+dy*dy)+0.01; const L=(focus?44:26)+a.size+b.size;
    const f=(d-L)/d*0.05*alpha; a.vx+=dx*f; a.vy+=dy*f; b.vx-=dx*f; b.vy-=dy*f; }
  for(const n of VN){ if(n===drag) { n.vx=n.vy=0; continue; } n.vx-=n.x*0.006*alpha; n.vy-=n.y*0.006*alpha; n.vx*=0.62; n.vy*=0.62; n.x+=n.vx; n.y+=n.vy; }
}
function loop(){ if(alpha>0.02||drag){ tick(); alpha*=0.985; if(!userMoved) fit(); draw(); raf=requestAnimationFrame(loop); } else { raf=null; draw(); } }
function restart(a){ collect(); alpha=Math.max(alpha,a); if(!raf) raf=requestAnimationFrame(loop); legend(); }
function resize(){ const r=cv.parentElement.getBoundingClientRect(); DPR=window.devicePixelRatio||1; W=r.width; H=r.height; cv.width=W*DPR; cv.height=H*DPR; draw(); }
function fit(){ if(!VN.length||!W) return; let x0=1e9,x1=-1e9,y0=1e9,y1=-1e9; VN.forEach(n=>{x0=Math.min(x0,n.x);x1=Math.max(x1,n.x);y0=Math.min(y0,n.y);y1=Math.max(y1,n.y);});
  const w=x1-x0+160, h=y1-y0+120; T.k=Math.min(W/w,H/h,2.4); T.x=W/2-T.k*(x0+x1)/2; T.y=H/2-T.k*(y0+y1)/2; }
const sx=x=>x*T.k+T.x, sy=y=>y*T.k+T.y;
const rad = n => Math.max(2.2,n.size*0.75*Math.sqrt(T.k));
function draw(){
  if(!W) return; ctx.setTransform(DPR,0,0,DPR,0,0); ctx.clearRect(0,0,W,H);
  const hl = selected ? neighbourSet(selected) : null;
  ctx.lineWidth=0.8;
  for(const {e,a,b} of VE){ const on = !hl || ((a.id===selected||b.id===selected));
    ctx.strokeStyle = e.rel==="THEN" ? "#ffd23f" : nodeColor(a); ctx.globalAlpha = on ? (hl?0.85:(e.rel==="THEN"?0.6:0.22)) : 0.03;
    ctx.beginPath(); ctx.moveTo(sx(a.x),sy(a.y)); ctx.lineTo(sx(b.x),sy(b.y)); ctx.stroke(); if(e.rel==="THEN"&&on) arrow(sx(a.x),sy(a.y),sx(b.x),sy(b.y),rad(b)); }
  const glow = VN.length<900;
  for(const n of VN){ const on=!hl||hl.has(n.id), r=rad(n), c=nodeColor(n); ctx.globalAlpha=on?1:.12;
    if(glow&&on){ ctx.shadowColor=c; ctx.shadowBlur=Math.min(22,r*1.6); } ctx.fillStyle=c; ctx.beginPath(); ctx.arc(sx(n.x),sy(n.y),r,0,7); ctx.fill(); ctx.shadowBlur=0;
    if(n.id===selected||n===hover){ ctx.strokeStyle="#fff"; ctx.lineWidth=2; ctx.stroke(); ctx.lineWidth=0.8; } }
  ctx.globalAlpha=1;
  for(const n of VN){ const on=!hl||hl.has(n.id); if(!on) continue;
    const big = n.type==="plan"||n.type==="system"||n.type==="handoff"||n.type==="agent"||(n.type==="class"&&(n.size>=maxSize*0.55||!!focus));
    const show = labels==="on" || n.id===selected || n===hover || (labels==="auto" && (big || (hl&&on) || T.k>1.6));
    if(!show) continue; const r=rad(n); const fs=Math.round(Math.min(22,Math.max(10.5,(n.type==="task"||n.type==="api"?10.5:11)+n.size*0.35*Math.sqrt(T.k))));
    ctx.font=`${big?700:500} ${fs}px Segoe UI,Arial`; const txt=short(n.label,38);
    ctx.lineWidth=3; ctx.strokeStyle="rgba(5,7,15,.85)"; ctx.strokeText(txt,sx(n.x)+r+4,sy(n.y)+fs*0.35);
    ctx.fillStyle = big ? nodeColor(n) : "#dbe3f5"; ctx.fillText(txt,sx(n.x)+r+4,sy(n.y)+fs*0.35); }
  ctx.lineWidth=0.8;
}
function arrow(x1,y1,x2,y2,r){ const a=Math.atan2(y2-y1,x2-x1), x=x2-Math.cos(a)*(r+2), y=y2-Math.sin(a)*(r+2); ctx.fillStyle="#ffd23f";
  ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x-8*Math.cos(a-.4),y-8*Math.sin(a-.4)); ctx.lineTo(x-8*Math.cos(a+.4),y-8*Math.sin(a+.4)); ctx.fill(); }
function neighbourSet(id){ const s=new Set([id]); (out.get(id)||[]).forEach(e=>{if(showRel[e.rel])s.add(e.t)}); (inn.get(id)||[]).forEach(e=>{if(showRel[e.rel])s.add(e.s)}); return s; }
function nodeAt(px,py){ let best=null,bd=1e9; for(const n of VN){ const d=Math.hypot(sx(n.x)-px,sy(n.y)-py), r=rad(n)+4; if(d<r&&d<bd){bd=d;best=n;} } return best; }
let drag=null, pan=null, moved=false;
cv.addEventListener("mousedown",e=>{ const n=nodeAt(e.offsetX,e.offsetY); moved=false; if(n){ drag=n; } else pan={x:e.offsetX,y:e.offsetY,tx:T.x,ty:T.y}; cv.style.cursor="grabbing"; });
cv.addEventListener("mousemove",e=>{ if(drag){ drag.x=(e.offsetX-T.x)/T.k; drag.y=(e.offsetY-T.y)/T.k; if(!moved){ moved=true; userMoved=true; restart(.25);} return; }
  if(pan){ T.x=pan.tx+e.offsetX-pan.x; T.y=pan.ty+e.offsetY-pan.y; moved=true; userMoved=true; draw(); return; }
  const n=nodeAt(e.offsetX,e.offsetY); if(n!==hover){hover=n;draw();}
  if(n){ tip.style.display="block"; tip.style.left=(e.offsetX+14)+"px"; tip.style.top=(e.offsetY+10)+"px";
    tip.innerHTML=`<b>${esc(n.type==="task"?(n.a.agent||"")+" · "+n.label:n.label)}</b><br><span class="muted">${TYPES[n.type][0]}${n.a.interactions?" · "+fmt("i",n.a.interactions)+" interactions":""}${n.a.community?" · "+esc(n.a.community):""}</span>`; }
  else tip.style.display="none"; });
window.addEventListener("mouseup",()=>{ if(drag&&!moved) select(drag.id); else if(pan&&!moved){ selected=null; draw(); home(); } drag=null; pan=null; cv.style.cursor="grab"; });
cv.addEventListener("wheel",e=>{ e.preventDefault(); userMoved=true; const f=Math.exp(-e.deltaY*.0015); const wx=(e.offsetX-T.x)/T.k, wy=(e.offsetY-T.y)/T.k;
  T.k=Math.min(12,Math.max(.05,T.k*f)); T.x=e.offsetX-wx*T.k; T.y=e.offsetY-wy*T.k; draw(); },{passive:false});
let tp=null;
cv.addEventListener("touchstart",e=>{ const r=cv.getBoundingClientRect(); if(e.touches.length===1){const t=e.touches[0]; const n=nodeAt(t.clientX-r.left,t.clientY-r.top); if(n) select(n.id); tp={x:t.clientX,y:t.clientY,tx:T.x,ty:T.y};}
  else if(e.touches.length===2){ const [a,b]=e.touches; tp={d:Math.hypot(a.clientX-b.clientX,a.clientY-b.clientY),k:T.k,tx:T.x,ty:T.y,cx:(a.clientX+b.clientX)/2,cy:(a.clientY+b.clientY)/2}; } userMoved=true; },{passive:true});
cv.addEventListener("touchmove",e=>{ e.preventDefault(); if(!tp) return; const r=cv.getBoundingClientRect();
  if(e.touches.length===1&&tp.x!==undefined){ const t=e.touches[0]; T.x=tp.tx+t.clientX-tp.x; T.y=tp.ty+t.clientY-tp.y; }
  else if(e.touches.length===2&&tp.d){ const [a,b]=e.touches; const d=Math.hypot(a.clientX-b.clientX,a.clientY-b.clientY); const k=Math.min(12,Math.max(.05,tp.k*d/tp.d));
    const cx=tp.cx-r.left, cy=tp.cy-r.top, wx=(cx-tp.tx)/tp.k, wy=(cy-tp.ty)/tp.k; T.k=k; T.x=cx-wx*k; T.y=cy-wy*k; } draw(); },{passive:false});
cv.addEventListener("touchend",()=>{tp=null;});

/* ---------- right panel ---------- */
function select(id, center){ selected=id; const n=byId.get(id); if(center){ userMoved=true; T.k=Math.max(T.k,1.3); T.x=W/2-n.x*T.k; T.y=H/2-n.y*T.k; } draw(); info(n); }
window.select=select;
function home(){ // overview like a discourse panel: key numbers + main clusters
  const el=document.getElementById("info"); const cs=DATA.classes, tot=cs.reduce((a,c)=>a+(c.n||0),0), appr=cs.reduce((a,c)=>a+(c.approved||0),0);
  const proven=DATA.nodes.filter(n=>n.type==="handoff"&&n.a.brings_specialist_work==="yes").length;
  let h=`<h3 style="margin-top:2px">Task decomposition at a glance</h3><div class="stat"><div><b>${fmt("n",tot)}</b><span>interactions</span></div><div><b>${cs.length}</b><span>classes</span></div><div><b>${proven}/${DATA.counts.handoff||0}</b><span>hand-offs proven</span></div><div><b>${DATA.counts.task||0}</b><span>tasks</span></div><div><b>${DATA.counts.api||0}</b><span>APIs</span></div><div><b>${fmt("n",appr)}</b><span>approved traces</span></div></div>`;
  h+=`<h3>Main clusters <span class="muted" style="text-transform:none;letter-spacing:0">(found by community detection; click to focus)</span></h3>`;
  (DATA.communities||[]).slice(0,10).forEach((c,i)=>{ const col=COMMC[c.name]; h+=`<div class="topic" onclick="focusCommunity(${i})"><b>${i+1}. ${esc(c.name)}</b><div class="bar" style="width:${Math.max(6,c.pct)}%;background:${col};box-shadow:0 0 8px ${col}"></div><div class="w">${c.pct.toFixed(0)}% of nodes · ${c.size} nodes · ${esc(c.top.join(", "))}</div></div>`; });
  h+=`<h3>Largest classes</h3>`+cs.slice(0,8).map(c=>`<div class="row" onclick="pickClass('${esc(c.id)}')"><span class="dot" style="background:${COL.class};color:${COL.class}"></span><span class="lnk">${esc(c.name)}</span>&nbsp;<span class="muted">${esc(short(c.spec,30))}</span><span class="cnt">${fmt("n",c.n)}</span></div>`).join("");
  el.innerHTML=h; }
function info(n){
  const el=document.getElementById("info"); let h=`<p><a class="lnk" onclick="selected=null;draw();home()">← overview</a></p><span class="chip" style="background:${nodeColor(n)}">${TYPES[n.type][0]}</span><h2>${esc(n.type==="task"?(n.a.agent||"")+" · "+n.label:n.label)}</h2>`;
  const rows=Object.entries(n.a).filter(([k,v])=>v!==""&&v!==null&&k!=="label"); if(rows.length) h+=`<table class="kv">${rows.map(([k,v])=>`<tr><td>${esc(nice(k))}</td><td>${esc(fmt(k,v))}</td></tr>`).join("")}</table>`;
  if(n.type==="class") h+=`<p><a class="lnk" onclick="pickClass('${esc(n.id)}')">Show only this class in the graph</a> · <a class="lnk" onclick="openPlan('${esc(n.id)}')">Open its plan →</a></p>`;
  const groups={}; (out.get(n.id)||[]).forEach(e=>(groups["→ "+e.rel]=groups["→ "+e.rel]||[]).push([e.t,e])); (inn.get(n.id)||[]).forEach(e=>(groups["← "+e.rel]=groups["← "+e.rel]||[]).push([e.s,e]));
  for(const [g,list] of Object.entries(groups)){ const rel=g.slice(2); h+=`<div class="relh">${g.startsWith("→")?"→ ":"← "}${esc(RELS[rel]||rel)} <span>(${list.length})</span></div><ul class="nb">`;
    list.slice(0,60).forEach(([id,e])=>{ const m=byId.get(id); const ex=edgeText(e); h+=`<li><a class="lnk" data-sel="${esc(id)}">${esc(m.type==="task"?(m.a.agent||"")+" · "+m.label:m.label)}</a>${ex?` <span class="muted">${esc(ex)}</span>`:""}</li>`; });
    if(list.length>60) h+=`<li class="muted">… ${list.length-60} more</li>`; h+=`</ul>`; }
  el.innerHTML=h; el.querySelectorAll("[data-sel]").forEach(a=>a.onclick=()=>{ const m=byId.get(a.dataset.sel); if(!visibleNode(m)){ focus=null; document.getElementById("clsSel").value=""; showType[m.type]=true; buildSide(); restart(.4);} select(m.id,true); }); }
function edgeText(e){ const a=e.a||{}; const p=[];
  if(a.stage) p.push("stage "+a.stage); if(a.ran_when_handed!==undefined) p.push(`${fmt("ran_when",a.ran_when_handed)} when handed vs ${fmt("ran_when",a.ran_when_not)}`);
  if(a.dependency!==undefined) p.push("dependency "+fmt("dependency",a.dependency)); if(a.interactions&&e.rel!=="RUNS_PLAN"&&e.rel!=="HANDS_OFF_TO") p.push(fmt("i",a.interactions)+" interactions");
  if(a.order) p.push("#"+a.order+" hand-off"); return p.join(" · "); }

/* ---------- focus: one class / one cluster ---------- */
function classSet(cid){ const s=new Set([cid]); const add=id=>s.add(id);
  (out.get(cid)||[]).forEach(e=>{ add(e.t); if(e.rel==="RUNS_PLAN"){ (out.get(e.t)||[]).filter(x=>x.rel==="INCLUDES").forEach(x=>add(x.t)); }
    if(e.rel==="HANDS_OFF_TO"){ (out.get(e.t)||[]).forEach(x=>{ if(x.rel==="BRINGS"||x.rel==="ACTIVATES") add(x.t); }); (inn.get(e.t)||[]).forEach(x=>{ if(x.rel==="HANDS_OFF") add(x.s); }); } });
  [...s].forEach(id=>{ const n=byId.get(id); if(n.type==="task"){ (inn.get(id)||[]).forEach(e=>{ if(e.rel==="PERFORMS") add(e.s); }); (out.get(id)||[]).forEach(e=>{ if(e.rel==="CALLS"){ add(e.t); (out.get(e.t)||[]).forEach(x=>x.rel==="ON_SYSTEM"&&add(x.t)); } }); } });
  return s; }
function setFocus(s){ focus=s; selected=null; userMoved=false; restart(1); }
function pickClass(cid){ document.getElementById("clsSel").value=cid; setFocus(classSet(cid)); info(byId.get(cid)); }
function focusCommunity(i){ const c=DATA.communities[i]; document.getElementById("clsSel").value=""; colorBy="community"; document.getElementById("colorBy").value="community"; setFocus(new Set(DATA.nodes.filter(n=>n.a.community===c.name).map(n=>n.id))); }
window.pickClass=pickClass; window.focusCommunity=focusCommunity;
document.getElementById("clsSel").onchange=e=>{ const v=e.target.value; if(v) pickClass(v); else { setFocus(null); home(); } if(view==="plan") renderPlan(v); };
document.getElementById("reset").onclick=()=>{ document.getElementById("clsSel").value=""; setFocus(null); home(); };
document.getElementById("shake").onclick=()=>{ VN.forEach(n=>{n.x+=(Math.random()-.5)*80;n.y+=(Math.random()-.5)*80;}); userMoved=false; restart(1); };
