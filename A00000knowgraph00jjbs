# NORA knowledge graph v1 - built 100% from the v7.2 decomposition outputs
#
#   Reads  : nora_task_decomposition_v7_2.xlsx            (Classes, Task_Plan, Interactions, API_Catalog)
#            nora_task_decomposition_v7_2_validation.xlsx (Handoff_Test, Handoff_Tasks, DAG_Edges, Accuracy_by_Class)
#   Builds : a NetworkX graph  Class -> Hand-off -> Agent -> Task -> API -> System, plus "then" arrows of the task DAG
#   Writes : nora_knowledge_graph.html          interactive page (network view, plan explorer, optional 3D view), works offline
#            nora_knowledge_graph.graphml       for NetworkX / Gephi / JanusGraph (TinkerPop GraphML: labelV / labelE)
#            nora_kg_nodes.csv, nora_kg_edges.csv
#            load_into_janusgraph.groovy        Gremlin console script + example queries
#
#   Nothing is typed in by hand: every node, link and number comes from the two Excel files.
#   Run:  python nora_knowledge_graph_v1.py
#         python nora_knowledge_graph_v1.py --main <path to main xlsx> --validation <path to validation xlsx> --out <folder>

import argparse
import json
import math
import re
import sys
from collections import defaultdict
from pathlib import Path

import pandas as pd

try:
    import networkx as nx
except ImportError:
    sys.exit("networkx is missing: run  pip install networkx  and try again")

p = argparse.ArgumentParser()
p.add_argument("--main", default="nora_task_decomposition_v7_2.xlsx")
p.add_argument("--validation", default="nora_task_decomposition_v7_2_validation.xlsx")
p.add_argument("--out", default=None, help="output folder (default: the folder of the main workbook)")
p.add_argument("--seed", type=int, default=42)
args = p.parse_args()

HERE = Path(__file__).resolve().parent


def find(name):
    for c in (Path(name), Path.cwd() / name, HERE / name, Path.cwd() / "outputs" / name, HERE / "outputs" / name):
        if c.exists():
            return c
    sys.exit(f"cannot find {name}; pass it with --main / --validation")


MAIN, VAL = find(args.main), find(args.validation)
OUT = Path(args.out) if args.out else MAIN.parent
OUT.mkdir(parents=True, exist_ok=True)
print(f"main workbook       : {MAIN}")
print(f"validation workbook : {VAL}")

M = pd.read_excel(MAIN, sheet_name=None, dtype=object)
V = pd.read_excel(VAL, sheet_name=None, dtype=object)
for need in ("Classes", "Task_Plan", "API_Catalog"):
    if need not in M:
        sys.exit(f"sheet {need} not found in {MAIN.name}")

SEP = " · "
NONE_PREFIX = "No hand-off"


def s(v):
    return "" if v is None or (isinstance(v, float) and pd.isna(v)) else str(v).strip()


def num(v):
    try:
        f = float(v)
        return None if pd.isna(f) else f
    except (TypeError, ValueError):
        return None


def col(df, *names):
    """First column whose name starts with any of `names` (tolerates renamed / shortened headers)."""
    for n in names:
        for c in df.columns:
            if str(c).strip().lower().startswith(n.lower()):
                return c
    return None


def split_task(t):
    agent, _, api = s(t).partition(SEP)
    return agent.strip(), api.strip()


G = nx.MultiDiGraph()
TYPE_LABEL = {"class": "Class", "plan": "Plan", "handoff": "Hand-off", "agent": "Agent", "task": "Task", "api": "API", "system": "System"}


def add_node(nid, ntype, label, **attrs):
    if nid in G:
        G.nodes[nid].update({k: v for k, v in attrs.items() if v not in (None, "")})
    else:
        G.add_node(nid, type=ntype, labelV=TYPE_LABEL[ntype], label=label, **{k: v for k, v in attrs.items() if v not in (None, "")})


def add_edge(a, b, rel, **attrs):
    G.add_edge(a, b, key=f"{rel}:{len(G)}:{G.number_of_edges()}", rel=rel, labelE=rel,
               **{k: v for k, v in attrs.items() if v not in (None, "")})


# ---------- hand-offs (validation: Handoff_Test) ----------
HANDOFF = {}
ht = V.get("Handoff_Test")
if ht is not None and len(ht):
    c_t, c_a, c_nd, c_nn, c_v = (col(ht, "Hand-off call"), col(ht, "Specialist agent"), col(ht, "Interactions handed"),
                                 col(ht, "Interactions not handed"), col(ht, "Verdict"))
    c_st, c_sw, c_so, c_sp = (col(ht, "Strongest task") , col(ht, "Strongest task: ran when handed"),
                              col(ht, "Strongest task: ran when not"), col(ht, "Strongest task: p-value"))
    c_fold = col(ht, "Same verdict")
    for _, r in ht.iterrows():
        t = s(r[c_t])
        if not t:
            continue
        HANDOFF[t] = {"agent": s(r[c_a]), "verdict": s(r[c_v]), "handed": num(r[c_nd]), "not_handed": num(r[c_nn]),
                      "strongest_task": s(r[c_st]) if c_st else "", "ran_when_handed": num(r[c_sw]) if c_sw else None,
                      "ran_when_not": num(r[c_so]) if c_so else None, "p_value_bh": s(r[c_sp]) if c_sp else "",
                      "same_verdict_in_folds": s(r[c_fold]) if c_fold else ""}

# hand-off calls also appear as tasks with System = 'hand-off'
cat = M["API_Catalog"]
c_ag, c_api, c_sys, c_lay, c_int, c_calls = (col(cat, "Agent"), col(cat, "API"), col(cat, "System"), col(cat, "Layer"),
                                              col(cat, "Interactions using"), col(cat, "Calls"))
for _, r in cat.iterrows():
    if s(r[c_sys]).lower() == "hand-off" and s(r[c_api]) not in HANDOFF:
        HANDOFF[s(r[c_api])] = {"agent": "", "verdict": s(r[c_lay])}


def task_id(task):
    agent, api = split_task(task)
    return f"handoff:{api}" if api in HANDOFF else f"task:{agent}{SEP}{api}"


for t, h in HANDOFF.items():
    brings = h.get("verdict", "").lower().startswith("brings")
    add_node(f"handoff:{t}", "handoff", t, brings_specialist_work="yes" if brings else "no", **{k: v for k, v in h.items() if k != "agent"},
             specialist_agent=h.get("agent", ""))
    if h.get("agent"):
        add_node(f"agent:{h['agent']}", "agent", h["agent"])
        add_edge(f"handoff:{t}", f"agent:{h['agent']}", "ACTIVATES")

# ---------- agents, tasks, APIs, systems (API_Catalog) ----------
for _, r in cat.iterrows():
    agent, api, system, layer = s(r[c_ag]), s(r[c_api]), s(r[c_sys]) or "not recorded", s(r[c_lay])
    inter, calls = num(r[c_int]), num(r[c_calls])
    if not api:
        continue
    add_node(f"agent:{agent}", "agent", agent)
    G.nodes[f"agent:{agent}"]["calls"] = G.nodes[f"agent:{agent}"].get("calls", 0) + (calls or 0)
    if api in HANDOFF:                                   # the boss passing work to an expert
        hid = f"handoff:{api}"
        add_node(hid, "handoff", api, interactions=inter, calls=calls, layer=layer)
        add_edge(f"agent:{agent}", hid, "HANDS_OFF", calls=calls, interactions=inter)
        continue
    tid = f"task:{agent}{SEP}{api}"
    add_node(tid, "task", api, agent=agent, api=api, system=system, layer=layer, interactions=inter, calls=calls)
    add_node(f"api:{api}", "api", api)
    G.nodes[f"api:{api}"]["calls"] = G.nodes[f"api:{api}"].get("calls", 0) + (calls or 0)
    add_node(f"system:{system}", "system", system)
    G.nodes[f"system:{system}"]["calls"] = G.nodes[f"system:{system}"].get("calls", 0) + (calls or 0)
    add_edge(f"agent:{agent}", tid, "PERFORMS", calls=calls, interactions=inter)
    if not G.has_edge(tid, f"api:{api}"):
        add_edge(tid, f"api:{api}", "CALLS")
    if not G.has_edge(f"api:{api}", f"system:{system}"):
        add_edge(f"api:{api}", f"system:{system}", "ON_SYSTEM")

# ---------- plans and stages (Task_Plan) ----------
tp = M["Task_Plan"]
c_plan, c_stage, c_task, c_tsys, c_after = (col(tp, "Plan"), col(tp, "Stage"), col(tp, "Task"), col(tp, "System"), col(tp, "Runs after"))
PLANS = {}                         # plan name -> {"handoff": name or None, "stages": {stage: [node ids]}, "edges": []}
for _, r in tp.iterrows():
    pname, task = s(r[c_plan]), s(r[c_task])
    if not pname or not task:
        continue
    stage = int(num(r[c_stage]) or 1)
    nid = task_id(task)
    if nid not in G:                                     # a plan task missing from the catalog: add it from the plan row
        agent, api = split_task(task)
        add_node(nid, "task", api, agent=agent, api=api, system=s(r[c_tsys]))
    is_std = pname.lower().startswith("standard")
    ho = None if is_std else re.sub(r"\s*sub-plan\s*$", "", pname).strip()
    pl = PLANS.setdefault(pname, {"handoff": ho, "stages": defaultdict(list), "after": {}, "edges": []})
    pl["stages"][stage].append(nid)
    pl["after"][nid] = s(r[c_after])
    if is_std:
        add_node("plan:standard", "plan", "Standard plan", description="Runs in every interaction")
        add_edge("plan:standard", nid, "INCLUDES", stage=stage)
        G.nodes[nid]["standard_stage"] = stage
    elif ho and nid != f"handoff:{ho}":
        add_edge(f"handoff:{ho}", nid, "BRINGS", stage=stage)
        G.nodes[nid]["sub_plan"] = ho

# "then" arrows of the DAG: DAG_Edges (exact names and statistics); fallback = 'Runs after' text
de = V.get("DAG_Edges")
if de is not None and len(de):
    cp, cf, ct = col(de, "Plan"), col(de, "From task"), col(de, "To task")
    cdep, cq, cboth, cfirst = col(de, "Dependency"), col(de, "p-value"), col(de, "Traces with both"), col(de, "From came first")
    for _, r in de.iterrows():
        pname, a, b = s(r[cp]), task_id(r[cf]), task_id(r[ct])
        if pname in PLANS and a in G and b in G:
            dep = num(r[cdep])
            PLANS[pname]["edges"].append([a, b, dep])
            add_edge(a, b, "THEN", plan=pname, dependency=dep, p_value_bh=s(r[cq]), cases_with_both=num(r[cboth]),
                     from_came_first=num(r[cfirst]))
else:
    for pname, pl in PLANS.items():
        for b, after in pl["after"].items():
            if after and after.lower() != "start":
                for a_txt in after.split(", "):
                    a = task_id(a_txt)
                    if a in G:
                        pl["edges"].append([a, b, None])
                        add_edge(a, b, "THEN", plan=pname)

# evidence on BRINGS links: Handoff_Tasks
hts = V.get("Handoff_Tasks")
if hts is not None and len(hts):
    ch, ctk, cw, co, cq, cd = (col(hts, "Hand-off call"), col(hts, "Task"), col(hts, "Ran when handed"), col(hts, "Ran when not"),
                               col(hts, "p-value"), col(hts, "Runs only after"))
    for _, r in hts.iterrows():
        hid, tid = f"handoff:{s(r[ch])}", task_id(r[ctk])
        if hid in G and tid in G and G.has_edge(hid, tid):
            for k, e in G[hid][tid].items():
                if e["rel"] == "BRINGS":
                    e.update(ran_when_handed=num(r[cw]), ran_when_not=num(r[co]), p_value_bh=s(r[cq]))

# ---------- classes (Classes + Interactions + Accuracy_by_Class) ----------
cl = M["Classes"]
c_cls, c_spec, c_n, c_tasks, c_dec = (col(cl, "Class"), col(cl, "Specialists"), col(cl, "Interactions"),
                                      col(cl, "Tasks in executable"), col(cl, "Decomposition"))
c_med = col(cl, "Tool calls (median)")
approved = defaultdict(int)
it = M.get("Interactions")
if it is not None and len(it):
    ci, ca = col(it, "Class"), col(it, "Approved")
    if ci and ca:
        for k, v in it.groupby(it[ci].map(s))[ca].apply(lambda x: (x.map(s).str.lower() == "yes").sum()).items():
            approved[k] = int(v)
acc = {}
ab = V.get("Accuracy_by_Class")
if ab is not None and len(ab):
    for _, r in ab.iterrows():
        acc[s(r[col(ab, "Class")])] = {"task_f1_unseen": num(r[col(ab, "Task F1")]),
                                       "specialist_f1_unseen": num(r[col(ab, "Specialist task F1")]),
                                       "baseline_task_f1_unseen": num(r[col(ab, "Baseline task F1")])}
CLASSES = []
for _, r in cl.iterrows():
    cname, spec = s(r[c_cls]), s(r[c_spec])
    if not cname:
        continue
    dec = s(r[c_dec]) if c_dec else ""
    hos = [] if spec.startswith(NONE_PREFIX) else [h.strip() for h in spec.split(" + ") if h.strip()]
    hos = sorted(hos, key=lambda h: (dec.find(h) if h in dec else 10 ** 6, h))   # order seen in the class (Decomposition column)
    cid = f"class:{cname}"
    add_node(cid, "class", cname, specialists_handed_work=spec, interactions=num(r[c_n]), tasks_in_plan=num(r[c_tasks]) if c_tasks else None,
             tool_calls_median=num(r[c_med]) if c_med else None, approved_traces=approved.get(cname, 0), **acc.get(cname, {}))
    if "plan:standard" in G:
        add_edge(cid, "plan:standard", "RUNS_PLAN", interactions=num(r[c_n]))
    for order, h in enumerate(hos, start=1):
        if f"handoff:{h}" not in G:
            add_node(f"handoff:{h}", "handoff", h)
        add_edge(cid, f"handoff:{h}", "HANDS_OFF_TO", order=order, interactions=num(r[c_n]))
    CLASSES.append({"id": cid, "name": cname, "spec": spec, "handoffs": hos, "n": num(r[c_n]), "tasks": num(r[c_tasks]) if c_tasks else None,
                    "median_calls": num(r[c_med]) if c_med else None, "approved": approved.get(cname, 0), **acc.get(cname, {})})

# ---------- layout (NetworkX, deterministic) ----------
U = nx.Graph()
U.add_nodes_from(G.nodes)
for a, b, e in G.edges(data=True):
    if e["rel"] != "THEN":
        U.add_edge(a, b)
pos = nx.spring_layout(U, seed=args.seed, iterations=300, k=1.6 / max(1, len(U)) ** 0.5)
xs = [v[0] for v in pos.values()] or [0]
ys = [v[1] for v in pos.values()] or [0]
span = max(max(xs) - min(xs), max(ys) - min(ys)) or 1


def size_of(n, d):
    w = d.get("interactions") or d.get("calls") or 1
    base = {"class": 4, "plan": 12, "handoff": 6, "agent": 6, "task": 2.5, "api": 2.5, "system": 8}[d["type"]]
    return round(base + 2.2 * math.log10(1 + float(w or 0)), 1)


nodes = []
for n, d in G.nodes(data=True):
    attrs = {k: v for k, v in d.items() if k not in ("type", "label", "labelV")}
    nodes.append({"id": n, "type": d["type"], "label": d["label"], "size": size_of(n, d),
                  "x": round((pos[n][0] - min(xs)) / span * 2000 - 1000, 1), "y": round((pos[n][1] - min(ys)) / span * 2000 - 1000, 1),
                  "a": attrs})
edges = [{"s": a, "t": b, "rel": e["rel"], "a": {k: v for k, v in e.items() if k not in ("rel", "labelE")}} for a, b, e in G.edges(data=True)]
plans = {name: {"handoff": pl["handoff"], "stages": [pl["stages"][k] for k in sorted(pl["stages"])], "edges": pl["edges"]}
         for name, pl in PLANS.items()}
counts = defaultdict(int)
for _, d in G.nodes(data=True):
    counts[d["type"]] += 1
rel_counts = defaultdict(int)
for _, _, e in G.edges(data=True):
    rel_counts[e["rel"]] += 1
DATA = {"nodes": nodes, "edges": edges, "classes": CLASSES, "plans": plans, "counts": counts, "rels": rel_counts,
        "source": {"main": MAIN.name, "validation": VAL.name}}

# ---------- exports ----------
GG = nx.MultiDiGraph()
for n, d in G.nodes(data=True):
    GG.add_node(n, **{k: (v if isinstance(v, (int, float, str)) else str(v)) for k, v in d.items() if v is not None})
for a, b, k, e in G.edges(keys=True, data=True):
    GG.add_edge(a, b, key=k, **{kk: (v if isinstance(v, (int, float, str)) else str(v)) for kk, v in e.items() if v is not None})
nx.write_graphml(GG, OUT / "nora_knowledge_graph.graphml")
pd.DataFrame([{"id": n, **d} for n, d in G.nodes(data=True)]).to_csv(OUT / "nora_kg_nodes.csv", index=False)
pd.DataFrame([{"from": a, "to": b, **e} for a, b, e in G.edges(data=True)]).to_csv(OUT / "nora_kg_edges.csv", index=False)
(OUT / "load_into_janusgraph.groovy").write_text("""// Load the NORA knowledge graph into JanusGraph (Gremlin console).
// Put nora_knowledge_graph.graphml next to the console, then:  :load load_into_janusgraph.groovy
graph = JanusGraphFactory.open('conf/janusgraph-inmemory.properties')   // or your berkeleyje / cassandra properties file
graph.io(IoCore.graphml()).readGraph('nora_knowledge_graph.graphml')   // vertex label = labelV, edge label = labelE
graph.tx().commit()
g = graph.traversal()

// What is in the graph
g.V().groupCount().by(label)
g.E().groupCount().by(label)

// The executable plan of one class: its hand-offs, the expert agent and the tasks each hand-off brings
g.V().has('label', 'Class 02').out('HANDS_OFF_TO').as('handoff').out('BRINGS').as('task').select('handoff', 'task').by('label')

// Who calls an API, and in how many interactions
g.V().has('label', 'get_device_details').hasLabel('API').in('CALLS').project('task', 'agent', 'interactions').by('label').by('agent').by('interactions')

// The order of the standard plan: every 'then' arrow with its dependency score
g.E().hasLabel('THEN').has('plan', 'Standard (every interaction)').project('from', 'to', 'dependency').by(outV().values('label')).by(inV().values('label')).by('dependency')
""", encoding="utf-8")


