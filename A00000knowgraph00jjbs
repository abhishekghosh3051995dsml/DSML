/* ---------- plan explorer ---------- */
const STD = Object.keys(DATA.plans).find(k=>k.toLowerCase().startsWith("standard"));
const planOf = h => Object.entries(DATA.plans).find(([k,p])=>p.handoff===h);
function openPlan(cid){ document.getElementById("clsSel").value=cid; focus=classSet(cid); collect(); setView("plan"); renderPlan(cid); }
window.openPlan=openPlan;
function renderPlan(cid){
  const wrap=document.getElementById("planwrap"); const c=DATA.classes.find(x=>x.id===cid) || DATA.classes[0]; if(!c){ wrap.innerHTML="<p>No classes found.</p>"; return; }
  let h=`<h2 style="margin:0 0 4px">${esc(c.name)} — ${esc(c.spec)}</h2><p class="hint" style="margin:0 0 10px">Executable plan = the standard plan + the sub-plan of every hand-off in this class, in the order NORA hands off. Arrows = "runs after", learned from the logs (task DAG). Pick another class on the left.</p><div class="kpis">`;
  [["Interactions",c.n],["Approved traces",c.approved],["Tasks in plan",c.tasks],["Typical tool calls",c.median_calls],["Task F1 on unseen",c.task_f1_unseen],["Specialist F1 on unseen",c.specialist_f1_unseen]].forEach(([k,v])=>{ if(v!==undefined&&v!==null&&v!=="") h+=`<div class="kpi"><b>${esc(fmt(/F1/.test(k)?"f1":"n",v))}</b><span>${k}</span></div>`; });
  h+=`</div>`; const lanes=[]; if(STD) lanes.push([DATA.plans[STD],"Standard plan","Runs in every interaction"]);
  c.handoffs.forEach((ho,i)=>{ const p=planOf(ho); const a=(byId.get("handoff:"+ho)||{a:{}}).a;
    const ev = a.strongest_task ? `Proof: ${a.strongest_task} ran in ${fmt("ran_when",a.ran_when_handed)} of cases handed work vs ${fmt("ran_when",a.ran_when_not)} otherwise (p ${a.p_value_bh||"–"}, same verdict ${a.same_verdict_in_folds||"–"} folds)` : "";
    lanes.push([p?p[1]:{stages:[["handoff:"+ho]],edges:[]}, `Hand-off ${i+1}: ${ho}`, ev]); });
  lanes.forEach(([pl,title,ev],li)=>{ h+=`<div class="lane"><h4>${esc(title)}</h4>${ev?`<div class="ev">${esc(ev)}</div>`:""}${laneSvg(pl,li)}</div>`; });
  wrap.innerHTML=h; info(byId.get(c.id)); wrap.querySelectorAll("[data-id]").forEach(g=>g.addEventListener("click",()=>info(byId.get(g.dataset.id)))); }
function laneSvg(pl,li){
  const BW=250,BH=40,GX=70,GY=10,PADT=22; const pos={}; let maxRows=0;
  pl.stages.forEach((st,i)=>{ maxRows=Math.max(maxRows,st.length); st.forEach((id,j)=>pos[id]={x:i*(BW+GX),y:PADT+j*(BH+GY)}); });
  const Wd=pl.stages.length*(BW+GX)-GX+10, Hd=PADT+maxRows*(BH+GY)+4; const mk=`ah${li}`;
  let s=`<svg width="${Wd}" height="${Hd}"><defs><marker id="${mk}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0L10,5L0,10z" fill="#ffd23f"/></marker></defs>`;
  pl.stages.forEach((st,i)=>{ s+=`<text x="${i*(BW+GX)}" y="13" fill="#8e9bba" font-size="11" font-weight="600">STAGE ${i+1} · ${st.length} task${st.length>1?"s":""}${i===0?" (runs after: start)":""}</text>`; });
  (pl.edges||[]).forEach(([a,b,d])=>{ const A=pos[a],B=pos[b]; if(!A||!B) return; const x1=A.x+BW,y1=A.y+BH/2,x2=B.x,y2=B.y+BH/2,mx=(x1+x2)/2;
    s+=`<path d="M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2-2},${y2}" fill="none" stroke="#ffd23f" stroke-opacity=".55" stroke-width="1.3" marker-end="url(#${mk})"><title>dependency ${d==null?"":d.toFixed(3)}</title></path>`; });
  pl.stages.forEach(st=>st.forEach(id=>{ const n=byId.get(id); if(!n) return; const P=pos[id]; const col=nodeColor(n);
    const top = n.type==="handoff" ? "hand-off · "+(n.a.specialist_agent||"") : (n.a.agent||"")+(n.a.system?" · "+n.a.system:"");
    s+=`<g data-id="${esc(id)}" style="cursor:pointer"><rect x="${P.x}" y="${P.y}" width="${BW}" height="${BH}" rx="8" fill="#141b31" stroke="${col}" stroke-width="1.4"/><rect x="${P.x}" y="${P.y}" width="5" height="${BH}" rx="2" fill="${col}"/>
      <text x="${P.x+12}" y="${P.y+15}" fill="#8e9bba" font-size="10.5">${esc(short(top,40))}</text><text x="${P.x+12}" y="${P.y+31}" fill="#e6ebf5" font-size="12" font-weight="600">${esc(short(n.label,34))}</text><title>${esc((n.a.agent?n.a.agent+" · ":"")+n.label)}</title></g>`; }));
  return s+`</svg>`; }

/* ---------- 3D graph (needs internet once to load the 3D library) ---------- */
let g3d=null;
function load3d(){
  const box=document.getElementById("g3d"), msg=document.getElementById("msg3d");
  const go=()=>{ msg.style.display="none"; if(g3d){ g3d.width(box.clientWidth).height(box.clientHeight); return; }
    const vis=new Set(DATA.nodes.filter(n=>showType[n.type]).map(n=>n.id));
    const gd={nodes:DATA.nodes.filter(n=>vis.has(n.id)).map(n=>({id:n.id,label:n.label,type:n.type,val:n.size*n.size/9,color:nodeColor(n)})),
      links:DATA.edges.filter(e=>showRel[e.rel]&&vis.has(e.s)&&vis.has(e.t)).map(e=>({source:e.s,target:e.t,rel:e.rel}))};
    g3d=ForceGraph3D()(box).backgroundColor("#05070f").graphData(gd).nodeLabel(n=>`${n.label} (${TYPES[n.type][0]})`).nodeColor("color").nodeVal("val").nodeOpacity(.95)
      .linkColor(l=>l.rel==="THEN"?"#ffd23f":"#9fb3e8").linkOpacity(.25).linkDirectionalArrowLength(l=>l.rel==="THEN"?3.5:0).linkDirectionalParticles(l=>l.rel==="HANDS_OFF_TO"||l.rel==="BRINGS"?1:0)
      .onNodeClick(n=>info(byId.get(n.id))).width(box.clientWidth).height(box.clientHeight); };
  if(window.ForceGraph3D) return go();
  msg.style.display="block"; msg.textContent="Loading the 3D library… (needs internet once)";
  const sc=document.createElement("script"); sc.src="https://cdn.jsdelivr.net/npm/3d-force-graph@1.72.2/dist/3d-force-graph.min.js"; sc.onload=go;
  sc.onerror=()=>{ msg.innerHTML="The 3D library could not be loaded (no internet, or the site is blocked on this network). The Graph and Plan explorer views work fully offline."; };
  document.head.appendChild(sc); }

