.stat{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 10px}.stat div{background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:6px 9px;flex:1;min-width:88px}.stat b{display:block;font-size:16px}.stat span{font-size:11px;color:var(--muted)}
#planwrap{position:absolute;inset:0;overflow:auto;padding:14px;background:var(--bg)}
