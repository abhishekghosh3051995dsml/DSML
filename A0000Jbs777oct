                       key=lambda s: (-(share_in[s] / len(mem) - share_out[s] / max(len(others), 1)), s))
        d["name"] = d["name"].split(" | ")[0] + (f" | {extra[0]}" if extra else f" | variant {seen_names[d['name']]}")
