def crosstab(level, by):
    sel = in_file & inter_intent[level].str.strip().ne("")
    if not sel.any():
        return None
    ct = pd.crosstab(inter_intent.loc[sel, level], inter.loc[sel, by])
    out = ct.copy()
    out.insert(0, "cases", ct.sum(axis=1))
    out.insert(0, "intent_value", ct.index)
    out.insert(0, "intent_level", level)
    out["top_" + by] = ct.idxmax(axis=1).values
    out["top_share"] = (ct.max(axis=1) / ct.sum(axis=1)).round(3).values
    out["distinct_" + by] = (ct > 0).sum(axis=1).values
    out["note"] = np.where(ct.sum(axis=1).values < MIN_INTENT_CASES, f"fewer than {MIN_INTENT_CASES} cases: indicative only", "")
    return out.sort_values("cases", ascending=False).reset_index(drop=True)


