    finding(f"{len(M['battery'])} diagnostic queries are run by most cases in two or more families; they are reported as one '{BATTERY_STEP}' sub-task.")

named_spec = [sorted(set(M["spec"][i]) | {h for h in map(handoff, plans[i]) if h and h not in M["routine_agents"]}) for i in range(n)]
spec_all = Counter(a for sp in named_spec for a in sp)
fam_share = {k: {a: v / len(f["members"]) for a, v in Counter(a for i in f["members"] for a in named_spec[i]).items()} for k, f in M["fams"].items()}
routed = [k for k in fam_share if any(v >= CORE_SHARE for v in fam_share[k].values())]
