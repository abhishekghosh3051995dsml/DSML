def entropy(counts):
    p = np.asarray(counts, float).ravel()
    p = p[p > 0] / p.sum()
    return float(-(p * np.log(p)).sum())


def association(a, b):
    ct = pd.crosstab(a, b).values.astype(float)
    total = ct.sum()
    h_a, h_b, h_ab = entropy(ct.sum(1)), entropy(ct.sum(0)), entropy(ct)
    mi = h_a + h_b - h_ab
    r, k = ct.shape
    phi2 = chi2_contingency(ct, correction=False)[0] / total
    phi2c = max(0.0, phi2 - (k - 1) * (r - 1) / max(total - 1, 1))
    rc, kc = r - (r - 1) ** 2 / max(total - 1, 1), k - (k - 1) ** 2 / max(total - 1, 1)
    v = float(np.sqrt(phi2c / max(min(kc - 1, rc - 1), 1e-9)))
    ca, cb = pd.factorize(a)[0], pd.factorize(b)[0]
    rng = np.random.default_rng(SEED)
    obs = mutual_info_score(ca, cb)
    p = (1 + sum(mutual_info_score(ca, rng.permutation(cb)) >= obs - 1e-12 for _ in range(PERMUTATIONS))) / (1 + PERMUTATIONS)
    return {"cramers_v_bias_corrected": round(v, 3), "adjusted_mutual_information": round(float(adjusted_mutual_info_score(ca, cb)), 3),
            "p_value_vs_shuffled_labels": round(p, 4), "intent_explains_decomposition": round(mi / h_b, 3) if h_b else np.nan,
            "decomposition_explains_intent": round(mi / h_a, 3) if h_a else np.nan}


