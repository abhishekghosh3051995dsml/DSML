task_all = Counter(s for p in plans for s in set(p))


def lift_rank(shares, overall, exclude=()):
    ranked = sorted(((x, sup, sup / (overall[x] / n)) for x, sup in shares.items() if x not in exclude), key=lambda r: (-r[1] * r[2], r[0]))
    return [x for x, sup, lift in ranked if sup >= CORE_SHARE and lift >= 1.2]


ROUTER = mode(calls.loc[calls["kind"] == "hand-off to specialist", "specialist"])
not_specialists = connectors | ({ROUTER} if ROUTER else set()) | set(M["routine_agents"])
D2, D3 = {}, {}
for k, f in M["fams"].items():
    mem = f["members"]
    lead = lift_rank(fam_share[k], spec_all, connectors)[:3]
    if not lead:
        lead = ["No specialist routed"] if np.mean([not named_spec[i] for i in mem]) >= CORE_SHARE else ["Mixed specialists"]
    tshare = {s: v / len(mem) for s, v in Counter(s for i in mem for s in set(plans[i])).items()}
    signature = [t for t in lift_rank(tshare, task_all, {BATTERY_STEP}) if handoff(t) not in lead][:1]
    if not signature and not lift_rank(tshare, task_all):
        signature = ["no case-specific sub-tasks"] if np.mean([not plans[i] for i in mem]) >= CORE_SHARE else [BATTERY_STEP.lower() + " only"]
    did = f"D2_{k + 1:02d}"
    D2[k] = {"id": did, "name": " + ".join(lead) + (f" | {signature[0]}" if signature else ""), "cases": len(mem),
             "specialists": ", ".join([f"{a} {v:.0%}" for a, v in sorted(fam_share[k].items(), key=lambda r: -r[1]) if a not in not_specialists][:4]),
             "confidence": float(M["conf2"][mem].mean()), "template": " → ".join(f["core"])}
    siblings = f["plans"]
    inside = Counter(s for p in siblings for i in p["members"] for s in set(plans[i]))
    for j, p in enumerate(siblings):
        pm = p["members"]
        sid = f"D3_{k + 1:02d}_{j + 1:02d}"
        if p["empty"]:
            name = "No case-specific sub-tasks"
        else:
            cnt = Counter(s for i in pm for s in set(plans[i]))
            rest = sum(len(q["members"]) for q in siblings if not q["empty"]) - len(pm)
            lift = {s: v / len(pm) - ((inside[s] - v) / rest if rest else task_all[s] / n) for s, v in cnt.items()}
            ranked = [s for s in sorted(lift, key=lambda s: (-lift[s], s)) if cnt[s] / len(pm) >= CORE_SHARE]
            key = [s for s in ranked if s != BATTERY_STEP][:2] or ranked[:1]
            name = " + ".join(sorted(key, key=lambda s: p["core"].index(s) if s in p["core"] else 99)) or "Varied sub-tasks"
        D3[sid] = {"id": sid, "parent": did, "name": name, "cases": len(pm), "core": p["core"],
                   "template": " → ".join(p["core"]) or ("(routine preamble only)" if p["empty"] else "(no sub-task shared by half the cases)"),
                   "split": len([q for q in siblings if not q["empty"]]) > 1, "reason": f["reason"], "members": pm}

seen_names = Counter()
