        tint = {"Source_Intent-L1": "DDEBF7", "Decomposition_Family-D2": "E2EFDA", "SubTask_Plan-D3": "FFF2CC", "User_Message": "F2F2F2"}
        for j, cell in enumerate(ws[1], start=1):
            if cell.value in tint:
                for i in range(2, ws.max_row + 1):
                    ws.cell(i, j).fill = PatternFill("solid", fgColor=tint[cell.value])
            if cell.value in ("User_Message", "SubTask_Sequence", "Root_Cause", "Agents_Called"):
                ws.column_dimensions[cell.column_letter].width = 70
    if ws.title in ("Overview", "Findings", "Catalogue", "Validation", "Intent_Map", "D2_Intent_Mix", "Intent_Decomposition_Fit"):
        for row in ws.iter_rows(min_row=2):
            for cell in row:
                cell.alignment = Alignment(wrap_text=True, vertical="top")
wb.save(xlsx)
log.info(f"   Excel -> {xlsx.name} ({len(sheets)} sheets)")
log.info(f"   JSON  -> decomposition_dictionary.json")
log.info(f"Finished in {time.time() - t0:.0f}s")
