# %% Phase 3 - the decomposition model (fit on any subset, apply to any other)


def snn_graph(Z):
    k = min(KNN, len(Z) - 1)
    nn = NearestNeighbors(n_neighbors=k + 1, metric="cosine").fit(Z).kneighbors(Z, return_distance=False)
    A = np.zeros((len(Z), len(Z)))
    A[np.repeat(np.arange(len(Z)), k + 1), nn.ravel()] = 1
    shared = A @ A.T
    W = shared / (2 * (k + 1) - shared)
    W[W < SNN_PRUNE] = 0
    np.fill_diagonal(W, 0)
    i, j = np.nonzero(np.triu(W))
    return list(zip(i.tolist(), j.tolist())), W[i, j].tolist()


def communities(Z, gamma, seed):
    edges, weights = snn_graph(Z)
    if ig is not None:
        random.seed(seed)
        g = ig.Graph(n=len(Z), edges=edges)
        return np.array(g.community_leiden("modularity", weights, gamma, 0.01, None, -1).membership)
    import networkx as nx
    g = nx.Graph()
    g.add_nodes_from(range(len(Z)))
    g.add_weighted_edges_from((a, b, w) for (a, b), w in zip(edges, weights))
    lab = np.zeros(len(Z), dtype=int)
    for k, members in enumerate(nx.community.louvain_communities(g, weight="weight", resolution=gamma, seed=seed)):
        lab[list(members)] = k
    return lab


def families(Z, runs, seed):
    m = len(Z)
    rng = np.random.default_rng(seed)
    subsets = [np.sort(rng.choice(m, max(2, int(SUBSAMPLE * m)), replace=False)) for _ in range(runs)]
    scan, full, subs = [], {}, {}
    for gamma in RESOLUTIONS:
        lab = communities(Z, gamma, seed)
        sub = [communities(Z[s], gamma, seed + r) for r, s in enumerate(subsets)]
        ari = [adjusted_rand_score(lab[s], ls) for s, ls in zip(subsets, sub)]
        sizes = np.bincount(lab)
        scan.append({"resolution": gamma, "families": int((sizes >= MIN_FAMILY).sum()), "stability_mean_ari": round(float(np.mean(ari)), 4)})
        full[gamma], subs[gamma] = lab, sub
    scan = pd.DataFrame(scan)
    valid = scan[scan.families >= 2]
    if valid.empty:
        scan["chosen"] = False
        return np.zeros(m, dtype=int), np.ones(m), None, scan, np.zeros(m, dtype=bool)
    near = valid[valid.stability_mean_ari >= valid.stability_mean_ari.max() - STABILITY_TOLERANCE]
    gamma = near.sort_values(["families", "stability_mean_ari"], ascending=False).iloc[0]["resolution"]
    scan["chosen"] = scan["resolution"] == gamma
    lab = full[gamma].copy()
    sizes = np.bincount(lab)
    big = [k for k in range(len(sizes)) if sizes[k] >= MIN_FAMILY] or [int(np.argmax(sizes))]
    rare = ~np.isin(lab, big)
    cent = {k: normalize(Z[lab == k].mean(0, keepdims=True)).ravel() for k in big}
    for i in np.where(~np.isin(lab, big))[0]:
        lab[i] = max(big, key=lambda k: Z[i] @ cent[k])
    order = [k for k, _ in Counter(lab).most_common()]
    lab = np.array([order.index(k) for k in lab])
    together, sampled = np.zeros((m, m)), np.zeros((m, m))
    for s, ls in zip(subsets, subs[gamma]):
        together[np.ix_(s, s)] += ls[:, None] == ls[None, :]
        sampled[np.ix_(s, s)] += 1
    co = np.where(sampled > 0, together / np.maximum(sampled, 1), np.nan)
    conf = np.array([np.nanmean([co[i, j] for j in np.where(lab == lab[i])[0] if j != i]) if (lab == lab[i]).sum() > 1 else 1.0 for i in range(m)])
    return lab, conf, gamma, scan, rare


def template(member_plans):
    count = Counter(s for p in member_plans for s in set(p))
    core = [s for s, v in count.items() if v / max(len(member_plans), 1) >= CORE_SHARE]
    pos = {s: np.median([p.index(s) / max(len(p) - 1, 1) for p in member_plans if s in p]) for s in core}
    return sorted(core, key=lambda s: (pos[s], -count[s], s)), count


def plan_tokens(p):
    return (list(p) + [f"{a} > {b}" for a, b in zip(p, p[1:])]) or ["(no case-specific sub-tasks)"]


def fit(idx, runs, seed=SEED):
    idx = np.asarray(idx)
    m = len(idx)
    a_share = Counter(a for i in idx for a in AGENTS[i])
    s_share = Counter(s for i in idx for s in SEQ[i])
    routine_agents = {a for a, v in a_share.items() if v / m >= ALWAYS_ON_SHARE}
    routine_steps = {s for s, v in s_share.items() if v / m >= ALWAYS_ON_SHARE}
    spec = [[a for a in AGENTS[i] if a not in routine_agents] for i in idx]
    steps = [[s for s in SEQ[i] if s not in routine_steps] for i in idx]

    vec = TfidfVectorizer(analyzer=identity, lowercase=False, binary=True)
    X = vec.fit_transform([["agent:" + a for a in sp] + ["task:" + s for s in st] or ["(none)"] for sp, st in zip(spec, steps)])
    Z = normalize(X.toarray())
    lab2, conf2, gamma, scan, rare = families(Z, runs, seed)
    signature = {}
    for k in set(lab2):
        mem = np.where(lab2 == k)[0]
        core_a = frozenset(a for a, v in Counter(a for i in mem for a in spec[i]).items() if v / len(mem) >= CORE_SHARE)
        core_s = frozenset(x for x, v in Counter(x for i in mem for x in steps[i]).items() if v / len(mem) >= CORE_SHARE)
        signature.setdefault((core_a, core_s), []).append(k)
    remap = {k: ks[0] for ks in signature.values() for k in ks}
    if len(set(remap.values())) < len(set(lab2)):
        lab2 = np.array([remap[k] for k in lab2])
        order = [k for k, _ in Counter(lab2).most_common()]
        lab2 = np.array([order.index(k) for k in lab2])

    battery = set()
    if len(set(lab2)) > 1:
        core_in = Counter()
        for k in set(lab2):
            mem = np.where(lab2 == k)[0]
            for s, v in Counter(x for i in mem for x in set(steps[i])).items():
                core_in[s] += v / len(mem) >= CORE_SHARE
        battery = {s for s, c in core_in.items() if c >= max(2, int(np.ceil(len(set(lab2)) / 2)))}

    def collapse(st):
        out = []
        for s in st:
            s = BATTERY_STEP if s in battery else s
            if s not in out:
                out.append(s)
        return out

    plans = [collapse(st) for st in steps]
    fams, lab3, sel = {}, np.empty(m, dtype=object), []
    for k in sorted(set(lab2)):
        mem = np.where(lab2 == k)[0]
        work = np.array([i for i in mem if plans[i]], dtype=int)
        empty = np.array([i for i in mem if not plans[i]], dtype=int)
        sub, reason, fvec, D = np.zeros(len(work), dtype=int), "", None, None
        if len(work):
            fvec = TfidfVectorizer(analyzer=identity, lowercase=False, binary=True).fit([plan_tokens(plans[i]) for i in work])
            Y = fvec.transform([plan_tokens(plans[i]) for i in work])
            D = np.clip(1 - (Y @ Y.T).toarray(), 0, None)
            np.fill_diagonal(D, 0)
        if len(work) < D3_MIN_PARENT:
            reason = f"only {len(work)} cases with case-specific sub-tasks"
        elif np.allclose(D, 0):
            reason = "every case ran the same sub-tasks"
        else:
            tree, best = linkage(squareform(D, checks=False), method="average"), (None, -1)
            for kk in range(2, D3_MAX + 1):
                cut = fcluster(tree, kk, criterion="maxclust") - 1
                sizes = np.bincount(cut)
                big = [c for c in range(len(sizes)) if sizes[c] >= D3_MIN_SIZE]
                if len(big) < 2:
                    continue
                for i in np.where(~np.isin(cut, big))[0]:
                    cut[i] = min(big, key=lambda c: D[i, cut == c].mean())
                sil = silhouette_score(D, cut, metric="precomputed")
                sel.append({"family": k, "plans": len(set(cut)), "silhouette": round(sil, 4)})
                if sil > best[1] + 1e-9:
                    best = (cut.copy(), sil)
            if best[0] is None:
                reason = "no split left two plans with 3+ cases"
            elif best[1] < D3_MIN_SILHOUETTE:
                reason = f"best split was weak (silhouette {best[1]:.2f})"
            else:
                order = [c for c, _ in Counter(best[0]).most_common()]
                sub = np.array([order.index(c) for c in best[0]])
        plan_list = []
        for p in sorted(set(sub)) if len(work) else []:
            members = work[sub == p]
            core, _ = template([plans[i] for i in members])
            cent = normalize(np.asarray(fvec.transform([plan_tokens(plans[i]) for i in members]).mean(0))).ravel()
            plan_list.append({"members": members, "core": core, "centroid": cent, "empty": False})
            lab3[members] = f"{k}.{len(plan_list) - 1}"
        if len(empty):
            plan_list.append({"members": empty, "core": [], "centroid": None, "empty": True})
            lab3[empty] = f"{k}.{len(plan_list) - 1}"
        fam_core, _ = template([plans[i] for i in mem])
        fams[k] = {"members": mem, "plans": plan_list, "vec": fvec, "reason": reason, "core": fam_core,
                   "centroid": normalize(Z[mem].mean(0, keepdims=True)).ravel()}
    global_core, _ = template(plans)
    return {"idx": idx, "routine_agents": routine_agents, "routine_steps": routine_steps, "battery": battery, "collapse": collapse,
            "vec": vec, "Z": Z, "lab2": lab2, "conf2": conf2, "rare": rare, "gamma": gamma, "scan": scan, "fams": fams, "lab3": lab3,
            "plans": plans, "spec": spec, "global_core": global_core, "selection": sel}


def assign(model, idx):
    out = []
    for i in idx:
        sp = [a for a in AGENTS[i] if a not in model["routine_agents"]]
        st = [s for s in SEQ[i] if s not in model["routine_steps"]]
        z = normalize(model["vec"].transform([["agent:" + a for a in sp] + ["task:" + s for s in st] or ["(none)"]]).toarray()).ravel()
        k = max(model["fams"], key=lambda f: z @ model["fams"][f]["centroid"])
        fam, plan = model["fams"][k], model["collapse"](st)
        options = [(j, p) for j, p in enumerate(fam["plans"]) if p["empty"] == (not plan)] or list(enumerate(fam["plans"]))
        if plan and fam["vec"] is not None and len(options) > 1:
            y = normalize(fam["vec"].transform([plan_tokens(plan)]).toarray()).ravel()
            j = max(options, key=lambda o: -1 if o[1]["centroid"] is None else y @ o[1]["centroid"])[0]
        else:
            j = options[0][0]
        out.append((k, j, plan))
    return out


# %% Phase 4 - isolated validation: does the decomposition generalise to interactions it never saw?

section("PHASE 4  Validation: 5-fold, every test fold kept out of every fitting step")


def overlap(pred, actual):
    p, a = set(pred), set(actual)
    if not p and not a:
        return 1.0, 1.0, 1.0
    if not p or not a:
        return 0.0, 0.0, 0.0
    hit = len(p & a)
    prec, rec = hit / len(p), hit / len(a)
    return prec, rec, (2 * prec * rec / (prec + rec)) if hit else 0.0


def order_agreement(pred, actual):
    both = [s for s in pred if s in actual]
    pairs = [(a, b) for x, a in enumerate(both) for b in both[x + 1:]]
    return np.mean([actual.index(a) < actual.index(b) for a, b in pairs]) if pairs else np.nan


rows_v = []
for fold, (train, test) in enumerate(KFold(n_splits=min(FOLDS, n), shuffle=True, random_state=SEED).split(np.arange(n)), start=1):
    model = fit(train, args.cv_runs, SEED + fold)
    for i, (k, j, plan) in zip(test, assign(model, test)):
        fam = model["fams"][k]
        for level, pred in (("D2 + D3 (full decomposition)", fam["plans"][j]["core"]), ("D2 only (family template)", fam["core"]),
                            ("Baseline: one template for all cases", model["global_core"])):
            prec, rec, f1 = overlap(pred, plan)
            f1_specific = overlap([x for x in pred if x != BATTERY_STEP], [x for x in plan if x != BATTERY_STEP])[2]
            rows_v.append({"fold": fold, "interaction_id": IDS[i], "level": level, "precision": prec, "recall": rec, "f1": f1,
                           "f1_case_specific": f1_specific, "order_agreement": order_agreement(pred, plan)})
    log.info(f"   fold {fold}: trained on {len(train)}, tested on {len(test)} unseen interactions, {len(model['fams'])} families learnt")
val = pd.DataFrame(rows_v)
levels = ["D2 + D3 (full decomposition)", "D2 only (family template)", "Baseline: one template for all cases"]
summary_v = val.groupby("level")[["precision", "recall", "f1", "f1_case_specific", "order_agreement"]].mean().reindex(levels)
per_fold = val.groupby(["level", "fold"])["f1"].mean().unstack().reindex(levels)
summary_v["f1_fold_sd"] = per_fold.std(axis=1)
summary_v = summary_v.round(3).reset_index()
log.info(f"   held-out results\n{summary_v.to_string(index=False)}")
val.to_csv(OUT / "diagnostics" / "validation_per_interaction.csv", index=False)
full_f1, base_f1 = summary_v.set_index("level").loc[levels[0], "f1"], summary_v.set_index("level").loc[levels[2], "f1"]
finding(f"On interactions the model never saw, the learnt decomposition predicts which sub-tasks a case will run with F1 {full_f1:.2f}, "
        f"against {base_f1:.2f} for a single template applied to every case.")

