            labels[i] = max(cent, key=lambda k: float(v @ cent[k])) if v.any() else -2
else:
    key = [tuple(sorted(set(s))) for s in AG_SEQ]
    order_ = {k: i for i, (k, _) in enumerate(Counter(key).most_common())}
    labels = np.array([order_[k] for k in key])
order_ = [c for c, _ in Counter(labels).most_common()]
