section("PHASE 6  Steps of each class")
tools = sorted(calls[TOOL].unique())
Bt = np.array([[t in set(s) for t in tools] for s in SEQ], dtype=np.int8)
pos = {}
for s in SEQ:
    for i, t in reversed(list(enumerate(s))):
        pos.setdefault(t, []).append(i / max(len(s) - 1, 1))
median_pos = {t: float(np.median(v)) for t, v in pos.items()}
api_agent = calls.groupby(TOOL)[AGENT].agg(lambda s: s.value_counts().index[0])

Y = per["class"].values
counts_y = Counter(Y)
cv = StratifiedKFold(5, shuffle=True, random_state=args.seed) if min(counts_y.values()) >= 5 else KFold(5, shuffle=True, random_state=args.seed)
alphas = np.unique(DecisionTreeClassifier(random_state=args.seed).cost_complexity_pruning_path(Bt, Y).ccp_alphas)
best = None
for a in alphas:
    pred = cross_val_predict(DecisionTreeClassifier(ccp_alpha=a, random_state=args.seed), Bt, Y, cv=cv)
    score = (f1_score(Y, pred, average="macro"), (pred == Y).mean())
    if best is None or score[0] >= best[1][0] - 1e-12:
        best = (a, score)
tree = DecisionTreeClassifier(ccp_alpha=best[0], random_state=args.seed).fit(Bt, Y)
overview("6. Checking the classes", "Can a short rule predict the class of an unseen interaction?",
         f"{best[1][1]:.1%} correct (guessing the biggest class: {max(counts_y.values()) / n:.1%}); macro-F1 {best[1][0]:.2f}",
         f"Pruned decision tree with {tree.get_n_leaves()} rules, tested on interactions it never saw (5-fold cross-validation). "
         "Supporting check; the main proof is the randomised-data test")
imp = pd.Series(tree.feature_importances_, index=tools).sort_values(ascending=False)
overview("6. Checking the classes", "APIs that most separate the classes", ", ".join(imp[imp > 0].index[:5]),
         "From the pruned tree's feature importance")
T = tree.tree_
leaf_rules = []


def walk(node, conds):
    if T.children_left[node] == -1:
        v = T.value[node][0]
        leaf_rules.append((tree.classes_[np.argmax(v)], int(T.n_node_samples[node]), float(v.max() / v.sum()), conds))
        return
    f = tools[T.feature[node]]
    walk(T.children_left[node], conds + [f"did not call {f}"])
    walk(T.children_right[node], conds + [f"called {f}"])


walk(0, [])

class_rows, used = [], set()
for k in sorted(set(labels)):
    cid, m = CLASS[k], labels == k
    mem = np.flatnonzero(m)
    s_in = Bt[m].mean(0)
    s_out = Bt[~m].mean(0) if (~m).any() else np.zeros(len(tools))
    ranked = [tools[j] for j in np.argsort(-(s_in - s_out)) if s_in[j] - s_out[j] > 0]
    if raw_of[k] == -2:
        name = "only the steps every interaction runs"
    elif not chosen_k:
        name = "agents: " + (" + ".join(sorted(set(AG_SEQ[mem[0]]))) or "none recorded")
    else:
        top = ranked[:2]
        while " + ".join(top) in used and len(top) < len(ranked):
            top = ranked[:len(top) + 1]
        name = " + ".join(top) or "no distinguishing API"
    used.add(name)
    core = sorted([tools[j] for j in np.flatnonzero(s_in >= 0.5)], key=lambda t: median_pos.get(t, 1))
    path, path_n = Counter(tuple(SEQ[i]) for i in mem).most_common(1)[0]
    ag = Counter(a for i in mem for a in set(AG_SEQ[i]))
    api_calls = calls[calls[CASE].isin([IDS[i] for i in mem])][TOOL].value_counts()
    apis_used = sorted(((t, s_in[tools.index(t)]) for t in api_calls.index), key=lambda x: -x[1])
    rule = max([r for r in leaf_rules if r[0] == cid], key=lambda r: r[1], default=None)
    sub = per.iloc[mem]
    class_rows.append({
        "Class": cid, "Defined by (APIs)": name, "Interactions": int(m.sum()), "Share": round(m.mean(), 4),
        "Of which unusual": int(sub["unusual"].sum()),
        "Agents called (share of class)": " · ".join(f"{a} {pct(v / m.sum())}" for a, v in ag.most_common()) or "none recorded",
        "Typical steps in order (agent · API, share of class)": "  →  ".join(f"{api_agent[t]} · {t} ({pct(s_in[tools.index(t)])})" for t in core),
        "Most common exact path": f"{' → '.join(path)}  [{path_n} of {int(m.sum())}]",
        "APIs called (share of class · total calls)": " | ".join(f"{t} ({pct(v)} · {int(api_calls[t]):,})" for t, v in apis_used),
        "Avg agents": round(sub["agents"].mean(), 1), "Avg agent turns": round(sub["agent_turns"].mean(), 1),
        "Avg API calls": round(sub["api_calls"].mean(), 1), "Avg distinct APIs": round(sub["distinct_apis"].mean(), 1),
        "Avg retries": round(sub["retries"].mean(), 1), "Error share of calls": round(sub["errors"].sum() / max(sub["api_calls"].sum(), 1), 4),
        "Rule (from pruned decision tree)": " AND ".join(rule[3]) if rule and rule[3] else "(no rule needed)",
        "Rule purity": round(rule[2], 3) if rule else np.nan})
classes = pd.DataFrame(class_rows)
per["class_defined_by"] = per["class"].map(classes.set_index("Class")["Defined by (APIs)"])
