section("PHASE 5  Classes")
TOKENS = [sorted(set(s) | {f"{a} → {b}" for a, b in zip(s, s[1:]) if a != b}) for s in SEQ]
vocab = sorted({t for ts in TOKENS for t in ts})
col_of = {t: j for j, t in enumerate(vocab)}
rows_i = np.repeat(np.arange(n), [len(ts) for ts in TOKENS])
cols_i = np.array([col_of[t] for ts in TOKENS for t in ts], dtype=int)
B_all = sparse.csr_matrix((np.ones(len(cols_i)), (rows_i, cols_i)), shape=(n, len(vocab)))
df_all = np.asarray(B_all.sum(0)).ravel()
universal = df_all == n
fit_rows = np.flatnonzero(~per["unusual"].values)
B = B_all[fit_rows][:, ~universal]
voc = np.array(vocab)[~universal]
active = np.asarray(B.sum(1)).ravel() > 0
Bf = B[active].tocsr()
FIT = fit_rows[active]
idf = np.log(Bf.shape[0] / np.maximum(np.asarray(Bf.sum(0)).ravel(), 1))
