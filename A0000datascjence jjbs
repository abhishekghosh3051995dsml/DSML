labels = np.full(n, -1)
if chosen_k:
    labels[FIT] = labels_fit
    Wn = normalize(Bf.multiply(idf).tocsr())
    cent = {k: np.asarray(Wn[labels_fit == k].mean(0)).ravel() for k in set(labels_fit)}
    rest = np.setdiff1d(np.arange(n), FIT)
