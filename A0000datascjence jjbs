         "Which APIs it called and which API-followed-by-API pairs occurred, weighted so that steps every interaction runs count 0")


def distance(M):
    W = normalize(M.multiply(idf).tocsr())
    S = (W @ W.T).toarray()
    np.fill_diagonal(S, 1.0)
    return np.clip(1 - S, 0, 2)


def scan(M, ks):
    D = distance(M)
    d = squareform(D, checks=False)
    tree = linkage(d, "average")
    iu = np.triu_indices(M.shape[0], 1)
    out = {}
    for k in ks:
        lab = fcluster(tree, k, "maxclust")
        if 1 < len(set(lab)) < M.shape[0]:
            out[k] = (silhouette_score(D, lab, metric="precomputed"),
                      np.corrcoef(d, (lab[iu[0]] != lab[iu[1]]).astype(float))[0, 1], lab)
    return out


def curveball(M, rng):
    rows = [set(M.indices[M.indptr[i]:M.indptr[i + 1]]) for i in range(M.shape[0])]
    for i, j in rng.integers(0, len(rows), (5 * len(rows), 2)):
        if i == j:
            continue
        a, b = rows[i], rows[j]
        only_a, only_b = list(a - b), list(b - a)
        if only_a and only_b:
            pool = only_a + only_b
            rng.shuffle(pool)
            rows[i], rows[j] = (a & b) | set(pool[:len(only_a)]), (a & b) | set(pool[len(only_a):])
    r = np.repeat(np.arange(len(rows)), [len(x) for x in rows])
    c = np.array([j for x in rows for j in x], dtype=int)
    return sparse.csr_matrix((np.ones(len(c)), (r, c)), shape=M.shape)


uniq = len({tuple(Bf.indices[Bf.indptr[i]:Bf.indptr[i + 1]]) for i in range(Bf.shape[0])})
KS = list(range(2, min(args.max_classes, uniq - 1) + 1)) if Bf.shape[0] > 3 else []
chosen_k, test_tbl, labels_fit = None, pd.DataFrame(), None
if KS:
    obs = scan(Bf, KS)
    null = []
    for r in range(args.null_runs):
        null.append(scan(curveball(Bf, RNG), KS))
        if (r + 1) % 10 == 0:
            log.info(f"   randomised datasets: {r + 1}/{args.null_runs}")
    rows_t, crit = [], {}
    for idx, name in ((0, "ASW"), (1, "PBC")):
        ks = [k for k in obs if all(k in nl for nl in null)]
        mu = {k: np.mean([nl[k][idx] for nl in null]) for k in ks}
        sd = {k: np.std([nl[k][idx] for nl in null]) + 1e-12 for k in ks}
        crit[name] = float(np.quantile([max((nl[k][idx] - mu[k]) / sd[k] for k in ks) for nl in null], 0.95))
        for k in ks:
            rows_t.append({"classes": k, "index": name, "real data": round(obs[k][idx], 4), "random mean": round(mu[k], 4),
                           "random sd": round(sd[k], 4), "z": round((obs[k][idx] - mu[k]) / sd[k], 2), "bound z (95%)": round(crit[name], 2)})
    test_tbl = pd.DataFrame(rows_t)
    wide = test_tbl.pivot(index="classes", columns="index", values="z")
    passed = wide[(wide["ASW"] > crit["ASW"]) & (wide["PBC"] > crit["PBC"])].index
    if len(passed):
        pbc = {k: obs[k][1] for k in passed}
        chosen_k = min(k for k in passed if pbc[k] == max(pbc.values()))
        labels_fit = obs[chosen_k][2]
    APPENDIX["Class existence test"] = test_tbl
