def distinctive_terms(docs, labels, top=3):
    classes = sorted(set(labels))
    joined = [" ".join(d for d, l in zip(clean_text(docs), labels) if l == c) for c in classes]
    try:
        seen_in = CountVectorizer(stop_words="english", token_pattern=WORD, ngram_range=(1, 2), binary=True).fit(clean_text(docs))
        share = np.asarray(seen_in.transform(clean_text(docs)).sum(0)).ravel() / len(docs)
        allowed = [t for t, v in zip(seen_in.get_feature_names_out(), share) if v <= FURNITURE_SHARE and v * len(docs) >= 2]
        cv = CountVectorizer(token_pattern=WORD, ngram_range=(1, 2), vocabulary=allowed)
        X = cv.fit_transform(joined).toarray().astype(float)
    except ValueError:
        return {c: [] for c in classes}
    tf = X / X.sum(1, keepdims=True).clip(min=1)
    W = tf * np.log(1 + (X.sum() / len(classes)) / np.maximum(X.sum(0), 1))
    terms, out = cv.get_feature_names_out(), {}
    for i, c in enumerate(classes):
        picked, seen = [], set()
        for j in np.argsort(-W[i]):
            words = set(terms[j].split())
            if W[i, j] <= 0 or len(picked) == top:
                break
            if words & seen:
                continue
            picked.append(terms[j])
            seen |= words
        out[c] = picked
    return out


