section("PHASE 3  D2 families: graph communities over problem + specialists, resolution chosen by stability")


def clean_text(docs):
    return [re.sub(NOISE_TEXT, " ", re.sub(r"([a-z])([A-Z])", r"\1 \2", d)).lower() if d.strip() else "noproblemtext" for d in docs]


def text_space(docs):
    docs = clean_text(docs)
    blocks = []
    for vec in (TfidfVectorizer(stop_words="english", token_pattern=WORD, ngram_range=(1, 2), min_df=2, max_df=FURNITURE_SHARE, sublinear_tf=True),
                TfidfVectorizer(analyzer="char_wb", ngram_range=(3, 5), min_df=2, max_df=FURNITURE_SHARE, sublinear_tf=True)):
        try:
            blocks.append(normalize(vec.fit_transform(docs)))
        except ValueError:
            continue
    X = hstack(blocks).tocsr()
    k = min(LSA_DIMS, X.shape[1] - 1, X.shape[0] - 1)
    return normalize(TruncatedSVD(n_components=k, random_state=SEED).fit_transform(X)) if k >= 2 else normalize(X.toarray())


def bag_space(lists):
    lists = [x or ["(none)"] for x in lists]
    return TfidfVectorizer(analyzer=identity, lowercase=False, binary=True).fit_transform(lists).toarray()


def snn_graph(Z):
    k = min(KNN, len(Z) - 1)
    nn = NearestNeighbors(n_neighbors=k + 1, metric="cosine").fit(Z).kneighbors(Z, return_distance=False)
    A = np.zeros((len(Z), len(Z)))
    A[np.repeat(np.arange(len(Z)), k + 1), nn.ravel()] = 1
    shared = A @ A.T
    W = shared / (2 * (k + 1) - shared)
    W[W < SNN_PRUNE] = 0
    np.fill_diagonal(W, 0)
    i, j = np.nonzero(np.triu(W))
    return list(zip(i.tolist(), j.tolist())), W[i, j].tolist()


def communities(Z, gamma, seed):
    edges, weights = snn_graph(Z)
    if ig is not None:
        random.seed(seed)
        g = ig.Graph(n=len(Z), edges=edges)
        return np.array(g.community_leiden("modularity", weights, gamma, 0.01, None, -1).membership)
    import networkx as nx
    g = nx.Graph()
    g.add_nodes_from(range(len(Z)))
    g.add_weighted_edges_from((a, b, w) for (a, b), w in zip(edges, weights))
    lab = np.zeros(len(Z), dtype=int)
    for k, members in enumerate(nx.community.louvain_communities(g, weight="weight", resolution=gamma, seed=seed)):
        lab[list(members)] = k
    return lab


