def blank(v):
    if v is None or (isinstance(v, float) and np.isnan(v)):
        return True
    if isinstance(v, (list, dict)):
        return len(v) == 0
    return isinstance(v, str) and v.strip().lower() in BLANK


def load_json(value):
    if not isinstance(value, str) or value.strip()[:1] not in ("[", "{"):
        return value
    for loader in (json.loads, ast.literal_eval):
        try:
            return loader(value)
        except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
            continue
    return value


def _repair(m):
    raw = bytearray()
    for ch in m.group(0):
        try:
            raw += ch.encode("cp1252")
        except UnicodeEncodeError:
            if ord(ch) > 255:
                return m.group(0)
            raw.append(ord(ch))
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return m.group(0)


def band(x):
    return "n/a" if x != x else "high" if x >= HIGH else "medium" if x >= MEDIUM else "low"


