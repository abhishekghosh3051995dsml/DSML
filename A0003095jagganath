section("PHASE 4  D3 plans: ordered sub-task sequences clustered inside each D2 family")


def plan_tokens(steps):
    return (list(steps) + [f"{a} > {b}" for a, b in zip(steps, steps[1:])]) or ["(no case-specific steps)"]


def template(member_steps):
    count = Counter(s for st in member_steps for s in set(st))
    core = [s for s, v in count.items() if v / len(member_steps) >= CORE_SHARE]
    pos = {s: np.median([st.index(s) / max(len(st) - 1, 1) for st in member_steps if s in st]) for s in core}
    return sorted(core, key=lambda s: (pos[s], -count[s])), count


selection, lab3, D3 = [], np.empty(n, dtype=object), {}
steps_all = inter["steps"].tolist()
for k in sorted(set(lab2)):
    pid, members = D2[k]["id"], np.where(lab2 == k)[0]
    Y = TfidfVectorizer(analyzer=identity, lowercase=False, binary=True).fit_transform([plan_tokens(steps_all[i]) for i in members])
    D = np.clip(1 - (Y @ Y.T).toarray(), 0, None)
    np.fill_diagonal(D, 0)
    sub, reason = np.zeros(len(members), dtype=int), ""
    if len(members) < D3_MIN_PARENT:
        reason = f"only {len(members)} cases"
    elif np.allclose(D, 0):
        reason = "every case ran the same steps"
    else:
        tree, best = linkage(squareform(D, checks=False), method="average"), (None, -1)
        for kk in range(2, min(D3_MAX, len(members) // D3_MIN_SIZE) + 1):
            cut = fcluster(tree, kk, criterion="maxclust") - 1
            sizes = np.bincount(cut)
            ok = len(sizes) >= 2 and sizes.min() >= D3_MIN_SIZE
            sil = silhouette_score(D, cut, metric="precomputed") if ok else np.nan
            selection.append({"family": pid, "plans": kk, "smallest_plan": int(sizes.min()), "valid": ok, "silhouette": round(sil, 4) if ok else None})
            if ok and sil > best[1]:
                best = (cut, sil)
        if best[0] is None:
            reason = "no split kept every plan at 3+ cases"
        elif best[1] < D3_MIN_SILHOUETTE:
            reason = f"best split was weak (silhouette {best[1]:.2f})"
        else:
            order = [c for c, _ in Counter(best[0]).most_common()]
            sub = np.array([order.index(c) for c in best[0]])
    inside = Counter(s for i in members for s in set(steps_all[i]))
    for p in sorted(set(sub)):
        sm = members[sub == p]
        core, count = template([steps_all[i] for i in sm])
        rest = [i for i in members if i not in set(sm)]
        lift = {s: v / len(sm) - (inside[s] - v) / max(len(rest), 1) for s, v in count.items()}
        key_steps = [s for s in sorted(lift, key=lambda s: -lift[s]) if count[s] / len(sm) >= CORE_SHARE][:2] if rest else core[:2]
        key_steps = sorted(key_steps, key=lambda s: core.index(s) if s in core else len(core))
        sid = f"D3_{k + 1:02d}_{p + 1:02d}"
        name = " + ".join(key_steps) if key_steps else ("No case-specific steps" if not count else "Varied steps")
        D3[sid] = {"id": sid, "parent": pid, "name": name, "cases": len(sm), "template": " → ".join(core) or "(no step shared by half the cases)",
                   "core": core, "split": len(set(sub)) > 1, "reason": reason}
        lab3[sm] = sid
    log.info(f"   {pid} ({len(members)} cases): " + (f"{len(set(sub))} plans" if len(set(sub)) > 1 else f"single plan - {reason}"))

inter["D3_id"] = lab3
inter["D3_name"] = [D3[s]["name"] for s in lab3]
inter["D3_confidence"] = [round(len(set(st) & set(D3[s]["core"])) / len(set(st) | set(D3[s]["core"])), 3) if (st or D3[s]["core"]) else 1.0
                          for st, s in zip(steps_all, lab3)]
for d in D3.values():
    m = inter["D3_id"] == d["id"]
    d["confidence"] = float(inter.loc[m, "D3_confidence"].mean())
    d["examples"] = inter.index[m][np.argsort(-inter.loc[m, "D3_confidence"].values)][:3].tolist()
    log.info(f"   {d['id']}  {d['cases']:>3} cases  fit {d['confidence']:.2f}  {d['name']}  ::  {d['template']}")
pd.DataFrame(selection).to_csv(OUT / "diagnostics" / "d3_split_selection.csv", index=False)
