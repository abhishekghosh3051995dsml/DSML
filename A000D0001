            row = {"view": view, "algorithm": algo, "k": k, "clusters": len(set(labels)), **internal_scores(Z, labels)}
            if algo == "kmeans":
                row["stability"] = bootstrap_stability(Z, k, algo, labels, args.bootstraps)
            runs[(view, algo, k)] = labels
            records.append(row)
    if HDBSCAN is not None:
        labels = HDBSCAN(min_cluster_size=max(3, n_fit // 25)).fit_predict(Z)
        found = len(set(labels) - {-1})
        if found >= 2:
            runs[(view, "hdbscan", found)] = labels
            records.append({"view": view, "algorithm": "hdbscan", "k": found, "clusters": found,
                            "noise_share": float((labels == -1).mean()), **internal_scores(Z, labels)})

grid = pd.DataFrame(records)
tables["cluster_grid"] = grid.round(4)

best_rows = []
for (view, algo), g in grid[grid["algorithm"] != "hdbscan"].groupby(["view", "algorithm"]):
    g = g.dropna(subset=["silhouette"])
    if g.empty:
        continue
    rank = (g["silhouette"].rank(ascending=False) + g["calinski_harabasz"].rank(ascending=False)
            + g["davies_bouldin"].rank(ascending=True))
    if "stability" in g and g["stability"].notna().any():
        rank = rank + g["stability"].rank(ascending=False)
    best_rows.append(g.loc[rank.idxmin()])
