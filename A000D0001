def parse_json(value):
    if not isinstance(value, str):
        return None
    s = value.strip()
    if len(s) < 2 or s[0] not in "[{":
        return None
    for loader in (json.loads, ast.literal_eval):
        try:
            return loader(s)
        except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
            continue
    return None


def expand(obj, depth=0):
    if depth > 4:
        return obj
    if isinstance(obj, str):
        inner = parse_json(obj)
        return obj if inner is None else expand(inner, depth + 1)
    if isinstance(obj, dict):
        return {k: expand(v, depth + 1) for k, v in obj.items()}
    if isinstance(obj, list):
        return [expand(v, depth + 1) for v in obj]
    return obj


def parse_cell(value):
    obj = parse_json(value)
    return None if obj is None else expand(obj)


def walk(obj, path=""):
    if isinstance(obj, dict):
        for k, v in obj.items():
            yield from walk(v, f"{path}.{k}" if path else str(k))
    elif isinstance(obj, list):
        for v in obj:
            yield from walk(v, f"{path}[]")
    else:
        yield path, obj


def leaf_key(path):
    return path.replace("[]", "").rsplit(".", 1)[-1]


def is_text_column(s):
    return pd.api.types.is_string_dtype(s) or s.dtype == object


