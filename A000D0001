# %% Consensus clustering (evidence accumulation across all runs)


def coassociation(label_sets):
    C = np.zeros((len(label_sets[0]),) * 2)
    for labs in label_sets:
        labs = np.asarray(labs)
        C += (labs[:, None] == labs[None, :]) & (labs[:, None] >= 0)
    return C / len(label_sets)


good_keys = [key for key, r in zip(runs, records) if r.get("silhouette", 0) > 0]
if len(good_keys) < 5:
    good_keys = list(runs)
C = coassociation([runs[k] for k in good_keys])
D = 1 - C
np.fill_diagonal(D, 0)
tree = linkage(squareform(D, checks=False), method="average")

consensus_scores = []
for k in k_values:
    labs = fcluster(tree, k, criterion="maxclust") - 1
    if len(set(labs)) < 2:
        continue
    consensus_scores.append({"k": k, "silhouette": silhouette_score(D, labs, metric="precomputed"),
                             "smallest_cluster": int(np.bincount(labs).min())})
consensus_scores = pd.DataFrame(consensus_scores)
min_size = max(3, int(np.ceil(MIN_CLUSTER_SHARE * n_fit)))
eligible = consensus_scores[consensus_scores["smallest_cluster"] >= min_size]
if eligible.empty:
    eligible = consensus_scores
k_final = int(eligible.sort_values(["silhouette", "smallest_cluster"], ascending=False).iloc[0]["k"])
final_fit = fcluster(tree, k_final, criterion="maxclust") - 1
off_diag = C[~np.eye(len(C), dtype=bool)]
pac = float(((off_diag > 0.1) & (off_diag < 0.9)).mean())

own = np.array([(C[i, final_fit == final_fit[i]].sum() - 1) / max((final_fit == final_fit[i]).sum() - 1, 1) for i in range(n_fit)])
other = np.array([max([C[i, final_fit == c].mean() for c in set(final_fit) if c != final_fit[i]] or [0]) for i in range(n_fit)])
margin = own - other

final = np.full(n, -1)
final[idx_fit] = final_fit
membership = pd.DataFrame(index=df.index, data={"cohesion": np.nan, "margin": np.nan})
