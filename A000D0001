def text_matrix(texts):
    texts = pd.Series(texts).fillna("")
    if (texts.str.len() > 0).sum() < 3:
        return None
    min_df = 2 if len(texts) >= 200 else 1
    word = TfidfVectorizer(ngram_range=(1, 2), min_df=min_df, max_df=0.95, sublinear_tf=True,
                           stop_words="english", token_pattern=TOKEN)
    char = TfidfVectorizer(analyzer="char_wb", ngram_range=(3, 5), min_df=min_df, sublinear_tf=True)
    try:
        return hstack([word.fit_transform(texts), char.fit_transform(texts)]).tocsr()
    except ValueError:
        return None


def lsa(X, target_var=0.8, cap=100):
    n_max = min(cap, X.shape[0] - 1, X.shape[1] - 1)
    if n_max < 2:
        return None, 0.0
    svd = TruncatedSVD(n_components=n_max, random_state=SEED).fit(X)
    k = int(np.clip(np.searchsorted(np.cumsum(svd.explained_variance_ratio_), target_var) + 1, 2, n_max))
    return normalize(svd.transform(X)[:, :k]), float(svd.explained_variance_ratio_[:k].sum())


