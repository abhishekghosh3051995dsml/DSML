membership.loc[idx_fit, "margin"] = margin
if n_fit < n:
    rest = np.setdiff1d(np.arange(n), idx_fit)
    knn = KNeighborsClassifier(5, metric="cosine", algorithm="brute").fit(views["combined" if "combined" in views else next(iter(views))][idx_fit], final_fit)
    final[rest] = knn.predict(views["combined" if "combined" in views else next(iter(views))][rest])

tables["consensus_k_selection"] = consensus_scores.round(4)
print(f"Runs pooled into consensus : {len(good_keys)} of {len(runs)}")
print(f"Consensus k                : {k_final}")
print(f"PAC (lower = crisper)      : {pac:.3f}")
print(f"Cluster sizes              : {dict(Counter(final))}")
print(f"Ambiguous rows (margin < {AMBIGUITY_MARGIN}): {(membership['margin'] < AMBIGUITY_MARGIN).sum()}")

method_labels = {f"{r.view}|{r.algorithm}|k{int(r.k)}": runs[(r.view, r.algorithm, int(r.k))] for r in best.itertuples()}
method_labels["consensus"] = final_fit
keys = list(method_labels)
tables["method_agreement_ari"] = pd.DataFrame(
    [[adjusted_rand_score(method_labels[a], method_labels[b]) for b in keys] for a in keys], index=keys, columns=keys
