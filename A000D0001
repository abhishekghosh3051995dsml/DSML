# %% Supervised verification (KNN, logistic regression, baselines)


def collapse_rare(y, min_count=2):
    y = pd.Series(y).astype(str).reset_index(drop=True)
    counts = y.value_counts()
    y = y.where(~y.isin(counts[counts < min_count].index), "_rare")
    return y


def cv_predict(model, Z, y, g, method="predict"):
    y = collapse_rare(y)
    keep = ~y.isin(y.value_counts()[y.value_counts() < 2].index)
    y, Zk, gk = y[keep], Z[keep.values], g[keep.values]
    if y.nunique() < 2:
        return None
    splits = int(min(5, y.value_counts().min()))
    if splits < 2:
        return None
    cv = StratifiedGroupKFold(n_splits=splits, shuffle=True, random_state=SEED)
    return y, keep.values, cross_val_predict(model, Zk, y, groups=gk, cv=cv, method=method)


def models(n_train):
    out = {"dummy_majority": DummyClassifier(strategy="most_frequent"),
           "logreg": LogisticRegression(max_iter=2000, class_weight="balanced")}
    for k in (1, 3, 5):
        if k < n_train:
            out[f"knn{k}"] = KNeighborsClassifier(k, metric="cosine", algorithm="brute", weights="distance")
    return out


