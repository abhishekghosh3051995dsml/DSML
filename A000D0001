per_cluster_recall = {}
if consensus_pred is not None:
    yt, yp = consensus_pred
    for c in yt.unique():
        per_cluster_recall[c] = float(recall_score(yt, yp, labels=[c], average="macro", zero_division=0))

profiles, check_rows = [], []
overall_problem = {chk: float((severity[chk] >= PROBLEM_SEVERITY).sum() / max(status[chk].notna().sum(), 1)) for chk in checks}
for c in sorted(set(final)):
    m = final == c
    ids = np.where(m)[0]
    fit_members = [i for i in ids if i in set(idx_fit)]
    medoid_order = sorted(fit_members, key=lambda i: -membership.loc[i, "cohesion"])
    steps, ruled_out, not_run = [], [], []
    for chk in checks:
        ran = status[chk][m].notna()
        if ran.sum() == 0:
            not_run.append(chk)
            continue
        prob_rate = float((severity[chk][m] >= PROBLEM_SEVERITY).sum() / ran.sum())
        lift = prob_rate / overall_problem[chk] if overall_problem[chk] > 0 else np.nan
        check_rows.append({"cluster": int(c), "check": chk, "run_rate": round(float(ran.mean()), 3),
                           "problem_rate": round(prob_rate, 3), "lift": round(lift, 2) if lift == lift else None})
        if prob_rate > 0:
            steps.append({"check": chk, "trigger_rate": round(prob_rate, 3),
                          "lift": round(lift, 2) if lift == lift else None,
                          "observed_problem_status": status[chk][m & (severity[chk] >= PROBLEM_SEVERITY)].mode().iloc[0],
                          "target_status": healthy_status[chk]})
        else:
            ruled_out.append(chk)
    steps.sort(key=lambda s: (-s["trigger_rate"], -(s["lift"] or 0)))
    tools = Counter(t for seq in tool_seq[m] for t in seq)
    profiles.append({
        "cluster_id": int(c),
        "candidate_name": " / ".join(cluster_terms.get(str(c), [])[:3]) or f"cluster_{c}",
        "size": int(m.sum()), "share": round(float(m.mean()), 3),
        "keywords": cluster_terms.get(str(c), []),
        "l1_mix": share_dict(l1[m]) if l1 is not None else {},
        "category_mix": share_dict(category[m]) if category is not None else {},
        "subcategory_mix": share_dict(subcategory[m]) if subcategory is not None else {},
        "task_plan": [{"step": i + 1, **s} for i, s in enumerate(steps)],
