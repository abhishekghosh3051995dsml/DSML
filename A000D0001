# %% Clustering: several algorithms x views x k


def run_algorithm(name, Z, k, seed):
    if name == "kmeans":
        est = MiniBatchKMeans(k, random_state=seed, n_init=10, batch_size=2048) if len(Z) > 20000 else KMeans(k, random_state=seed, n_init=20)
        return est.fit_predict(Z)
    if name == "agglo_ward":
        return AgglomerativeClustering(n_clusters=k, linkage="ward").fit_predict(Z)
    if name == "agglo_cosine":
        return AgglomerativeClustering(n_clusters=k, metric="cosine", linkage="average").fit_predict(Z)
    if name == "spectral":
        return SpectralClustering(n_clusters=k, affinity="nearest_neighbors", n_neighbors=min(10, len(Z) - 1),
                                  random_state=seed, assign_labels="cluster_qr").fit_predict(Z)
    if name == "gmm":
        return GaussianMixture(k, covariance_type="diag", reg_covar=1e-3, random_state=seed, n_init=3).fit_predict(Z)
    raise ValueError(name)


def internal_scores(Z, labels):
    keep = labels >= 0
    labs = labels[keep]
    k = len(set(labs))
    if k < 2 or k >= keep.sum():
        return {"silhouette": np.nan, "calinski_harabasz": np.nan, "davies_bouldin": np.nan}
    sample = 5000 if keep.sum() > 5000 else None
    return {"silhouette": silhouette_score(Z[keep], labs, metric="cosine", sample_size=sample, random_state=SEED),
            "calinski_harabasz": calinski_harabasz_score(Z[keep], labs),
            "davies_bouldin": davies_bouldin_score(Z[keep], labs)}


def bootstrap_stability(Z, k, algo, full_labels, B):
    rng = np.random.default_rng(SEED)
    m = int(0.8 * len(Z))
    scores = []
    for b in range(B):
        idx = rng.choice(len(Z), m, replace=False)
        try:
            scores.append(adjusted_rand_score(full_labels[idx], run_algorithm(algo, Z[idx], k, SEED + b + 1)))
        except Exception:
            continue
    return float(np.mean(scores)) if scores else np.nan


