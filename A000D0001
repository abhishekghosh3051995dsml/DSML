def cramers_v(a, b):
    ct = pd.crosstab(a, b)
    if min(ct.shape) < 2:
        return np.nan
    chi2 = chi2_contingency(ct, correction=False)[0]
    return float(np.sqrt(chi2 / (ct.values.sum() * (min(ct.shape) - 1))))


TOKEN = r"(?u)\b(?=\w*[a-zA-Z])\w{2,}\b"


def ctfidf_terms(texts, labels, top_n=10):
    try:
        cv = CountVectorizer(ngram_range=(1, 2), stop_words="english", token_pattern=TOKEN)
        X = cv.fit_transform(pd.Series(texts).fillna(""))
    except ValueError:
        return {}
    labs = np.asarray(pd.Series(labels).astype(str))
    classes = sorted(set(labs))
    tf = np.vstack([np.asarray(X[labs == c].sum(axis=0)).ravel() for c in classes])
    idf = np.log1p((tf.sum() / len(classes)) / np.maximum(tf.sum(axis=0), 1))
    scores = tf / np.maximum(tf.sum(axis=1, keepdims=True), 1) * idf
    vocab = cv.get_feature_names_out()
    return {c: [vocab[i] for i in np.argsort(-scores[j])[:top_n] if scores[j, i] > 0] for j, c in enumerate(classes)}


