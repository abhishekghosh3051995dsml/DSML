            yt, _, yp = res
            sup_rows.append({"target": tgt, "view": view, "model": mname, "classes": yt.nunique(),
                             "accuracy": accuracy_score(yt, yp), "macro_f1": f1_score(yt, yp, average="macro")})
            if tgt == "consensus" and view == ("combined" if "combined" in views else next(iter(views))) and mname == "logreg":
