def find_column(columns, pattern):
    hits = [c for c in columns if re.search(pattern, c, flags=re.I)]
    return hits[0] if hits else None


def duplicate_columns(frame):
    seen, dups = {}, {}
    for c in frame.columns:
        key = pd.util.hash_pandas_object(frame[c].astype(str), index=False).values.tobytes()
        if key in seen:
            dups[c] = seen[key]
        else:
            seen[key] = c
    return dups


