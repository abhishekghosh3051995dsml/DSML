def downloads_dirs():
    roots = [os.environ.get(k) for k in ("OneDriveCommercial", "OneDrive")]
    dirs = [Path(r) / "Downloads" for r in roots if r] + [Path.home() / "Downloads"]
    return [d for d in dict.fromkeys(dirs) if d.is_dir()]


def locate_input(path_arg):
    if path_arg:
        return Path(path_arg)
    matches = [p for d in downloads_dirs() for p in d.glob(FILE_PATTERN)]
    if not matches:
        raise FileNotFoundError(f"No file matching {FILE_PATTERN} in {downloads_dirs()}")
    return max(matches, key=lambda p: p.stat().st_mtime)


def load_table(path, max_rows):
    for enc in ("utf-8", "utf-8-sig", "cp1252", "latin-1"):
        try:
            return pd.read_csv(path, encoding=enc, low_memory=False, nrows=max_rows), enc
        except UnicodeDecodeError:
            continue
    raise ValueError(f"Could not decode {path}")


