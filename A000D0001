PII_PATTERNS = [
    (re.compile(r"[\w.+-]+@[\w-]+(\.[\w-]+)+"), "<EMAIL>"),
    (re.compile(r"https?://\S+"), "<URL>"),
    (re.compile(r"\b[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\b", re.I), "<UUID>"),
    (re.compile(r"(?<!\w)\+?\d[\d\s\-().]{6,}\d(?!\w)"), "<NUM>"),
]


def mask_pii(text):
    for pat, token in PII_PATTERNS:
        text = pat.sub(token, text)
    return NAME_RE.sub("<NAME>", text) if NAME_RE else text


def model_text(text):
    return re.sub(r"\s+", " ", re.sub(r"<[A-Z]+>", " ", text)).strip().lower()


def user_utterances(msgs):
    out = []
    for m in msgs if isinstance(msgs, list) else []:
        if isinstance(m, dict) and str(m.get("type", m.get("role", ""))).lower() in {"user", "human", "customer"}:
            out += [v for p, v in walk(m) if isinstance(v, str) and leaf_key(p) == "content"]
    return " ".join(out)


def context_text(obj):
    parts = []
    for path, v in walk(obj):
        if isinstance(v, str) and v.strip():
            keys = " ".join(re.findall(r"[A-Za-z]+", path.replace("_", " ")))
            parts.append(f"{keys} {v}")
    return " ".join(parts)


def discover_tool_key(objs):
    coverage = Counter()
    for obj in objs.dropna():
        keys = {leaf_key(p) for p, v in walk(obj) if isinstance(v, str) and v.strip()}
        coverage.update(k for k in keys if re.search(r"tool|function|name", k, re.I))
    return coverage.most_common(1)[0][0] if coverage else None


