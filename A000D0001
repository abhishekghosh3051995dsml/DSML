        "checks_not_run": not_run,
        "validator_coverage": round(float(status[m].notna().any(axis=1).mean()), 3) if checks else 0.0,
        "tools_observed": [t for t, _ in tools.most_common(10)],
        "confidence": {
            "cohesion": round(float(np.nanmean(membership.loc[m, "cohesion"])), 3),
            "supervised_recall": round(per_cluster_recall.get(str(c), np.nan), 3),
        },
        "evidence": {
