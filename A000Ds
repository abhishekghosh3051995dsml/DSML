def parse_json(value, depth=0):
    if depth > 4:
        return value
    if isinstance(value, (list, dict)):
        return [parse_json(v, depth + 1) for v in value] if isinstance(value, list) else {k: parse_json(v, depth + 1) for k, v in value.items()}
    if not isinstance(value, str):
        return None if value is None or (isinstance(value, float) and np.isnan(value)) else value
    s = value.strip()
    if not s or s[0] not in "[{":
        return value
    for loader in (json.loads, ast.literal_eval):
        try:
            return parse_json(loader(s), depth + 1)
        except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
            continue
    return value


def walk(obj, path=""):
    if isinstance(obj, dict):
        for k, v in obj.items():
            yield from walk(v, f"{path}.{k}" if path else str(k))
    elif isinstance(obj, list):
        for v in obj:
            yield from walk(v, f"{path}[]")
    else:
        yield path, obj


def is_empty(v):
    return v is None or (isinstance(v, (list, dict, str)) and len(v) == 0) or (isinstance(v, float) and np.isnan(v))


def wilson_lower(k, m, z=1.96):
    if m == 0:
        return np.nan
    p = k / m
    return (p + z * z / (2 * m) - z * np.sqrt(p * (1 - p) / m + z * z / (4 * m * m))) / (1 + z * z / m)


def slug(text):
    return re.sub(r"[^A-Za-z0-9]+", "_", str(text)).strip("_")[:60]


