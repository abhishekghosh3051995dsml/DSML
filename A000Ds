def heatmap(values, title, name, fmt="{:.0%}", counts=None, vmax=1.0, max_rows=50, max_cols=30):
    values = values.iloc[:max_rows, :max_cols]
    fig, ax = plt.subplots(figsize=(max(6, 0.75 * values.shape[1] + 3.5), max(2.8, 0.36 * values.shape[0] + 1.5)))
    im = ax.imshow(values.fillna(0).values, cmap=SEQ, vmin=0, vmax=vmax, aspect="auto")
    short = lambda c: " > ".join(str(c).split(" > ")[-2:])[:45]
    ax.set_xticks(range(values.shape[1]), [short(c) for c in values.columns], rotation=40, ha="right", fontsize=7.5)
    ax.set_yticks(range(values.shape[0]), [str(r)[:55] for r in values.index], fontsize=7.5)
    for i in range(values.shape[0]):
        for j in range(values.shape[1]):
            v = values.values[i, j]
            if v == v and v > 0:
                txt = fmt.format(v) + (f"\n{int(counts.values[i, j])}" if counts is not None and values.size <= 300 else "")
                ax.text(j, i, txt, ha="center", va="center", fontsize=6.5, color="white" if v / vmax > 0.55 else INK)
    ax.set_title(title)
    ax.spines[:].set_visible(False)
    cb = fig.colorbar(im, ax=ax, fraction=0.025, pad=0.02)
    cb.outline.set_visible(False)
    save(fig, name)


# %% D0 - load the interactions export and attach the intent


def resolve(columns):
    roles = {r: next((c for c in columns if re.search(p, c, re.I)), None) for r, p in COLUMN_PATTERNS.items()}
    checks = defaultdict(dict)
    for c in columns:
        m = re.search(VALIDATOR, c, re.I)
        if m:
            checks[m.group("check")][m.group("part").lower()] = c
    inputs = [c for c in columns if re.search(USER_INPUT_PREFIX, c, re.I)]
    return roles, dict(checks), inputs


def attach_labels(df, raw):
    if LABELS is None:
        return df, None
    sheets = pd.read_excel(LABELS, sheet_name=None)
    lab = max(sheets.values(), key=len)
    lab.columns = [str(c).strip() for c in lab.columns]
    lvl = {}
    for c in lab.columns:
        m = re.search(LEVEL_COLUMN, c, re.I)
        if m:
            lvl.setdefault(f"L{m.group(1)}", c)
    ids = [c for c in lab.columns if c not in lvl.values() and lab[c].nunique() >= 0.95 * len(lab)]
    best = (0, None, None)
    for lc in ids:
        keys = set(lab[lc].astype(str))
        for rc in raw.columns:
            if re.search(r"(^|[._])(conversation_|source_)?id$", rc, re.I):
                hit = raw[rc].astype(str).isin(keys).sum()
                if hit > best[0]:
                    best = (hit, lc, rc)
    if best[0] == 0:
        log.warning(f"   labels file {LABELS.name} found but no id overlaps with the interactions export; using the export's own fields")
        return df, None
    hits, lc, rc = best
    m = lab.drop_duplicates(lc).set_index(lab.drop_duplicates(lc)[lc].astype(str))
    key = raw[rc].astype(str)
    for level in ("L2", "L3", "L4"):
        if level in lvl:
            df[f"{level}_label"] = key.map(m[lvl[level]]).astype(object)
    log.info(f"   joined {hits} of {len(df)} interactions to {LABELS.name} on {rc} = {lc}")
    return df, {"file": LABELS.name, "matched": int(hits), "join": f"{rc} = {lc}"}


def intent_backoff(df, levels):
    path_cols = [c for c in levels if c in df]
    keys = []
    for _, row in df[path_cols].iterrows():
        parts = [str(row[c]) for c in path_cols if pd.notna(row[c]) and str(row[c]).strip() not in ("", "nan", "None")]
        chosen = "ALL"
        for depth in range(len(parts), 0, -1):
            prefix = " > ".join(parts[:depth])
            if R.path_counts.get(prefix, 0) >= MIN_INTENT_ROWS:
                chosen = prefix
                break
        keys.append(chosen)
    return keys


def load():
    banner("D0 - load the interactions export and attach the intent (classification is taken as given)")
    with step("0.1 read and resolve columns"):
        for enc in ("utf-8", "utf-8-sig", "cp1252", "latin-1"):
            try:
                raw = pd.read_csv(SRC, encoding=enc, low_memory=False)
                break
            except UnicodeDecodeError:
                continue
        roles, checks, inputs = resolve(raw.columns)
        metric("interactions file", f"{SRC.name} ({len(raw):,} rows x {raw.shape[1]} cols)")
        for r, c in roles.items():
            log.info(f"   {r:<16} -> {c}")
        metric("validator checks found", len(checks))
        metric("user-input fields found", len(inputs))
        if roles["record_id"] is None:
            roles["record_id"] = next((c for c in raw.columns if re.search(r"(^|[._])id$", c, re.I)), None)
    with step("0.2 intent per interaction"):
        df = pd.DataFrame({"record_id": raw[roles["record_id"]].astype(str) if roles["record_id"] else raw.index.astype(str)})
        df["L1_classification"] = raw[roles["L1"]].astype(str) if roles["L1"] else "unclassified"
        if roles["L1_confidence"]:
            df["L1_confidence"] = pd.to_numeric(raw[roles["L1_confidence"]], errors="coerce")
        df, join = attach_labels(df, raw)
        if join:
            levels = ["L1_classification"] + [c for c in ("L2_label", "L3_label") if c in df]
            source = f"other team's labels ({join['file']}, {join['matched']} matched)"
        else:
            if roles["category"]:
                df["category"] = raw[roles["category"]].astype(object)
            if roles["subcategory"]:
                df["subcategory"] = raw[roles["subcategory"]].astype(object)
            levels = ["L1_classification"] + [c for c in ("category", "subcategory") if c in df]
            source = "classification.intent + the form's category / subCategory"
        R.path_counts = Counter()
        for _, row in df[levels].iterrows():
            parts = [str(row[c]) for c in levels if pd.notna(row[c]) and str(row[c]).strip() not in ("", "nan", "None")]
            for depth in range(1, len(parts) + 1):
                R.path_counts[" > ".join(parts[:depth])] += 1
        df["intent_path"] = [" > ".join(str(row[c]) for c in levels if pd.notna(row[c])) for _, row in df[levels].iterrows()]
        df["intent_key"] = intent_backoff(df, levels)
        metric("intent levels used", f"{' > '.join(levels)}  [{source}]")
        metric("decomposition groups (paths with >= %d interactions, finer paths rolled up)" % MIN_INTENT_ROWS, df["intent_key"].nunique())
        show(df["intent_key"].value_counts().rename_axis("intent_key").reset_index(name="interactions"), "   interactions per decomposition group")
        rolled = (df["intent_key"] != df["intent_path"]).sum()
        if rolled:
            finding(f"{rolled} of {len(df)} interactions sit on intent paths with fewer than {MIN_INTENT_ROWS} examples and were rolled up to their parent intent.")
    R.raw, R.df, R.roles, R.checks, R.inputs, R.levels = raw, df, roles, checks, inputs, levels


# %% D2 - break every interaction into steps


def message_turns(obj):
    turns = []
    for m in obj if isinstance(obj, list) else []:
        if not isinstance(m, dict):
            continue
        kind = str(m.get("type", m.get("role", ""))).lower()
        data = m.get("data", m) if isinstance(m.get("data", m), dict) else m
        content = data.get("content", "")
        if isinstance(content, list):
            content = " ".join(str(x.get("text", "")) if isinstance(x, dict) else str(x) for x in content)
        calls = []
        for tc in (data.get("tool_calls") or []) + ((data.get("additional_kwargs") or {}).get("tool_calls") or []):
            if isinstance(tc, dict):
                nm = tc.get("name") or (tc.get("function") or {}).get("name")
                if nm:
                    calls.append(str(nm))
        turns.append({"kind": kind, "content": str(content or ""), "tool_calls": calls, "tool_name": data.get("name") if kind in TOOL_TYPES else None})
    return turns


def tool_events(obj):
    events, keys_seen = [], Counter()
    for i, e in enumerate(obj if isinstance(obj, list) else []):
        if not isinstance(e, dict):
            continue
        keys_seen.update(e.keys())
        name = next((str(e[k]) for k in TOOL_NAME_KEYS if k in e and isinstance(e[k], (str, int)) and str(e[k]).strip()), None)
        if name is None and len(e) == 1 and isinstance(next(iter(e.values())), (dict, list)):
            name = next(iter(e))
        if name is None:
            continue
        status_raw = next((e[k] for k in TOOL_STATUS_KEYS if k in e), None)
        output = next((e[k] for k in TOOL_OUTPUT_KEYS if k in e), "__absent__")
        if status_raw is not None and re.search(r"fail|error|false|exception", str(status_raw), re.I):
            outcome = "failed"
        elif output != "__absent__" and is_empty(output):
            outcome = "empty"
        else:
            outcome = "returned"
        ts = next((e[k] for k in TOOL_TIME_KEYS if k in e), None)
        events.append({"tool": name, "outcome": outcome, "ts": ts, "pos": i})
    if events and all(ev["ts"] is not None for ev in events):
        try:
            events.sort(key=lambda ev: pd.to_datetime(ev["ts"]))
        except (ValueError, TypeError):
            pass
    return events, keys_seen


def sentences(text):
    return [s.strip() for s in re.split(r"(?<=[.!?])\s+|\n+", text) if len(s.strip().split()) >= 4]


def remediation_actions(sents):
    from sklearn.feature_extraction.text import ENGLISH_STOP_WORDS
    acts = []
    for s in sents:
        toks = re.findall(r"[a-z0-9][a-z0-9\-]*", s.lower())
        for i, t in enumerate(toks):
            if not re.fullmatch(ACTION_VERBS, t):
                continue
            obj = []
            for w in toks[i + 1:i + 6]:
                if w in ENGLISH_STOP_WORDS:
                    if obj:
                        break
                    continue
                obj.append(w)
                if len(obj) == 2:
                    break
            if obj:
                acts.append(f"{t} {' '.join(obj)}")
    return acts


def parse_interaction(i):
    raw, roles, checks = R.raw, R.roles, R.checks
    rid = R.df.at[i, "record_id"]
    steps = []

    def add(kind, name, outcome, order=np.nan, detail=""):
        steps.append({"record_id": rid, "step_type": kind, "step": f"{kind}:{name}", "outcome": outcome, "order": order, "detail": str(detail)[:200]})

    ic = parse_json(raw.at[i, roles["issues_context"]]) if roles["issues_context"] else None
    if isinstance(ic, dict):
        for area, payload in (ic.get("issue_summary") if isinstance(ic.get("issue_summary"), dict) else ic).items():
            text = json.dumps(payload) if not isinstance(payload, str) else payload
            add("context", f"issue_summary.{area}" if isinstance(ic.get("issue_summary"), dict) else area,
                "unavailable" if re.search(CONTEXT_FAILURE, text, re.I) else "gathered", detail=text)
    loc = parse_json(raw.at[i, roles["location"]]) if roles["location"] else None
    if isinstance(loc, dict):
        sites = loc.get("sites") or []
        add("context", "location.sites", "gathered" if sites else "unavailable", detail=f"{len(sites)} sites")
        if "is_roaming" in loc:
            add("context", "location.roaming_flag", "gathered", detail=loc.get("is_roaming"))
    if roles["ticket_history"] and pd.notna(raw.at[i, roles["ticket_history"]]):
        t = str(raw.at[i, roles["ticket_history"]])
        add("context", "ticket_history", "none_found" if re.search(r"\bno\b.*\b(history|ticket|incident)", t, re.I) else "gathered", detail=t)
    socs = parse_json(raw.at[i, roles["socs"]]) if roles["socs"] else None
    if isinstance(socs, list) and socs:
        add("context", "service_codes", "gathered", detail=f"{len(socs)} SOCs")
    for c in R.inputs:
        v = raw.at[i, c]
        if pd.notna(v) and str(v).strip() and str(v).lower() not in ("na", "n/a", "none"):
            add("input", re.sub(USER_INPUT_PREFIX, "", c, flags=re.I), "provided", detail=v)

    for chk, parts in checks.items():
        st = raw.at[i, parts["status"]] if "status" in parts else np.nan
        val = raw.at[i, parts["value"]] if "value" in parts else np.nan
        if pd.isna(st) and pd.isna(val):
            continue
        sev = STATUS_SEVERITY.get(str(st).strip().lower(), 1) if pd.notna(st) else 1
        outcome = "problem" if sev >= PROBLEM_SEVERITY else "neutral" if sev == 1 else "passed"
        add("check", chk, outcome, detail=f"value={val}; status={st}")

    turns = message_turns(parse_json(raw.at[i, roles["messages"]])) if roles["messages"] else []
    if roles["chat_history"]:
        turns += message_turns(parse_json(raw.at[i, roles["chat_history"]]))
    events, keys = tool_events(parse_json(raw.at[i, roles["tool_history"]])) if roles["tool_history"] else ([], Counter())
    R.tool_keys.update(keys)
    source = "tool_history"
    if not events:
        seq = [c for t in turns for c in t["tool_calls"]] or [t["tool_name"] for t in turns if t["tool_name"]]
        events = [{"tool": str(nm), "outcome": "returned", "ts": None, "pos": k} for k, nm in enumerate(seq)]
        source = "messages" if events else "none"
    for k, ev in enumerate(events):
        add("tool", ev["tool"], ev["outcome"], order=k)

    ctx = parse_json(raw.at[i, roles["context_history"]]) if roles["context_history"] else None
    for k, e in enumerate(ctx if isinstance(ctx, list) else []):
        if isinstance(e, dict):
            R.context_keys.update(e.keys())
            label = next((str(e[kk]) for kk in CONTEXT_LABEL_KEYS if kk in e and str(e[kk]).strip()), None)
            if label:
                add("knowledge", label, "retrieved", order=k)

    assistant = " ".join(t["content"] for t in turns if t["kind"] in ASSISTANT_TYPES)
    user = " ".join(t["content"] for t in turns if t["kind"] in USER_TYPES)
    sents = sentences(assistant)
    rc = [s for s in sents if re.search(ROOT_CAUSE_CUES, s, re.I)]
    rem = [s for s in sents if re.search(REMEDIATION_CUES, s, re.I)]
    for a in Counter(remediation_actions(rem)):
        add("remediation", a, "proposed")
    fb = parse_json(raw.at[i, roles["feedback"]]) if roles["feedback"] else None
    summary = {
        "record_id": rid, "tool_source": source, "user_text": user[:300], "assistant_chars": len(assistant),
        "root_cause_sentence": rc[0][:300] if rc else "", "remediation_sentence": rem[0][:300] if rem else "",
        "feedback_items": len(fb) if isinstance(fb, list) else 0,
        "rca_complete": raw.at[i, roles["rca_complete"]] if roles["rca_complete"] else np.nan,
    }
    return steps, summary


def d2():
    banner("D2 - break every interaction into steps: context -> checks -> tools -> knowledge -> root cause -> remediation")
    R.tool_keys, R.context_keys = Counter(), Counter()
    with step("2.1 parse all interactions"):
        all_steps, sums = [], []
        for i in range(len(R.df)):
            s, sm = parse_interaction(i)
            all_steps += s
            sums.append(sm)
        steps = pd.DataFrame(all_steps, columns=["record_id", "step_type", "step", "outcome", "order", "detail"])
        steps = steps.merge(R.df[["record_id", "intent_key"]], on="record_id", how="left")
        summ = pd.DataFrame(sums)
        log.info(f"   keys seen at the top level of tool_history entries: {dict(R.tool_keys.most_common(12))}")
        log.info(f"   keys seen at the top level of context_history entries: {dict(R.context_keys.most_common(12))}")
    with step("2.2 one summary row per interaction"):
        g = steps.groupby("record_id")
        per = pd.DataFrame({
            "context_gathered": g.apply(lambda x: int(((x.step_type == "context") & (x.outcome != "unavailable")).sum())),
            "context_unavailable": g.apply(lambda x: int(((x.step_type == "context") & (x.outcome == "unavailable")).sum())),
            "checks_run": g.apply(lambda x: int((x.step_type == "check").sum())),
            "checks_problem": g.apply(lambda x: ", ".join(x.loc[(x.step_type == "check") & (x.outcome == "problem"), "step"].str[6:])),
            "checks_ruled_out": g.apply(lambda x: ", ".join(x.loc[(x.step_type == "check") & (x.outcome == "passed"), "step"].str[6:])),
            "tool_sequence": g.apply(lambda x: " -> ".join(x.loc[x.step_type == "tool"].sort_values("order")["step"].str[5:])),
            "tools_empty_or_failed": g.apply(lambda x: int(((x.step_type == "tool") & x.outcome.isin(["empty", "failed"])).sum())),
            "knowledge_docs": g.apply(lambda x: int((x.step_type == "knowledge").sum())),
            "remediation_actions": g.apply(lambda x: ", ".join(x.loc[x.step_type == "remediation", "step"].str[12:])),
        }).reset_index()
        inter = R.df[["record_id", "intent_key", "intent_path", "L1_classification"]].merge(summ, on="record_id", how="left").merge(per, on="record_id", how="left")
        for c in ("context_gathered", "context_unavailable", "checks_run", "tools_empty_or_failed", "knowledge_docs"):
            inter[c] = inter[c].fillna(0).astype(int)
        inter = inter.fillna({"checks_problem": "", "checks_ruled_out": "", "tool_sequence": "", "remediation_actions": ""})
        n = len(inter)
        metric("interactions with context gathered", f"{(inter.context_gathered > 0).sum()} / {n}")
        metric("interactions with validator checks", f"{(inter.checks_run > 0).sum()} / {n}")
        metric("interactions with tool calls", f"{(inter.tool_sequence != '').sum()} / {n} (source: {dict(Counter(inter.tool_source))})")
        metric("interactions with a root-cause sentence", f"{(inter.root_cause_sentence != '').sum()} / {n}")
        metric("interactions with a remediation action", f"{(inter.remediation_actions != '').sum()} / {n}")
        tool_rows = steps[steps.step_type == "tool"]
        if len(tool_rows):
            metric("tool calls that returned nothing or failed", f"{tool_rows.outcome.isin(['empty', 'failed']).mean():.0%} of {len(tool_rows)}")
        show(steps.groupby(["step_type", "outcome"]).size().reset_index(name="steps"), "   steps by type and outcome")
        thin = [(c, int((inter[c] > 0).sum() if pd.api.types.is_numeric_dtype(inter[c]) else (inter[c] != "").sum())) for c in ("checks_run", "tool_sequence", "root_cause_sentence")]
        for c, k in thin:
            if k < 0.3 * n:
                finding(f"Only {k} of {n} interactions carry {c.replace('_', ' ')}; decomposition for that part rests on few examples.")
    add_sheet("D2_Steps", steps)
    add_sheet("D2_Interactions", inter)
    R.steps, R.inter = steps, inter
    steps.to_csv(OUT / "handoff" / "d2_steps.csv", index=False)
    inter.to_csv(OUT / "handoff" / "d2_interactions.csv", index=False)
    log.info("   handoff -> handoff/d2_steps.csv, d2_interactions.csv")


# %% D3 - typical plan per intent


def d3():
    banner("D3 - the typical plan per intent: which steps, how often, how specific, in what order")
    steps, inter = R.steps, R.inter
    n_int = inter.groupby("intent_key").size()
    n_all = len(inter)
    with step("3.1 support, lift and role of every step"):
        present = steps.drop_duplicates(["record_id", "step"])
        cnt = present.groupby(["intent_key", "step"]).size().unstack(fill_value=0)
        overall = present.groupby("step")["record_id"].nunique() / n_all
        support = cnt.div(n_int, axis=0)
        lift = support.div(overall, axis=1)
        always_on = [s for s in overall.index if overall[s] >= ALWAYS_ON_SUPPORT and lift[s].between(*ALWAYS_ON_LIFT).all()]
        rows = []
        always_on = [s for s in always_on if not s.startswith("check:")]
        chk_steps = steps[steps.step_type == "check"].assign(problem=lambda x: x.outcome == "problem")
        prob = chk_steps.groupby(["intent_key", "step"])["problem"].agg(["sum", "count"])
        overall_prob = chk_steps.groupby("step")["problem"].mean()
        validated = steps[steps.step_type == "check"].groupby("intent_key")["record_id"].nunique()
        for intent in support.index:
            for s in support.columns:
                k = int(cnt.at[intent, s])
                if k == 0:
                    continue
                sup = support.at[intent, s]
                pr = prob.loc[(intent, s)] if (intent, s) in prob.index else None
                if s.startswith("check:"):
                    sup = k / max(int(validated.get(intent, 0)), 1)
                    rate = pr["sum"] / pr["count"] if pr is not None and pr["count"] else 0.0
                    base = overall_prob.get(s, 0)
                    p_lift = rate / base if base > 0 else (np.inf if rate > 0 else 0)
                    if pr is not None and pr["sum"] >= MIN_FAILURES and rate >= DIAGNOSTIC_RATE and p_lift >= DIAGNOSTIC_LIFT:
                        role = "diagnostic"
                    elif pr is not None and pr["count"] >= MIN_CHECK_RUNS and pr["sum"] == 0:
                        role = "rule-out"
                    else:
                        role = "weak signal"
                else:
                    role = "always-on" if s in always_on else "core" if sup >= CORE_SUPPORT else "optional" if sup >= OPTIONAL_SUPPORT else "rare"
                rows.append({"intent_key": intent, "step": s, "step_type": s.split(":")[0], "interactions": k, "intent_size": int(n_int[intent]),
                             "support": round(sup, 3), "support_lower_95": round(wilson_lower(k, int(n_int[intent])), 3),
                             "overall_support": round(float(overall[s]), 3), "lift": round(float(lift.at[intent, s]), 2), "role": role,
                             "problem_rate": round(pr["sum"] / pr["count"], 3) if pr is not None and pr["count"] else np.nan,
                             "problem_lift": round(float(p_lift), 2) if s.startswith("check:") and np.isfinite(p_lift) else (None if not s.startswith("check:") else "only here"),
                             "thin_intent": int(n_int[intent]) < 2 * MIN_INTENT_ROWS})
        sup_tab = pd.DataFrame(rows)
        show(sup_tab[sup_tab.role.isin(["core", "diagnostic"])].sort_values(["intent_key", "role", "support"], ascending=[True, True, False])
             [["intent_key", "step", "support", "lift", "role", "problem_rate", "problem_lift"]], "   core steps and diagnostic checks per intent", 40)
        rc = sup_tab[sup_tab.step_type == "check"]["role"].value_counts()
        metric("check roles across intents", ", ".join(f"{k} {v}" for k, v in rc.items()))
        if always_on:
            finding(f"{len(always_on)} step(s) appear in {ALWAYS_ON_SUPPORT:.0%}+ of all interactions with the same rate for every intent (always-on, not intent-specific): {', '.join(always_on[:10])}")
    with step("3.2 order of tool calls (directly-follows counts and mean position)"):
        tools = steps[steps.step_type == "tool"].sort_values(["record_id", "order"])
        dfg, pos = [], []
        for (rid, intent), g in tools.groupby(["record_id", "intent_key"]):
            seq = g["step"].tolist()
            for k, s in enumerate(seq):
                pos.append({"intent_key": intent, "step": s, "position": k / max(len(seq) - 1, 1)})
            for a, b in zip(seq, seq[1:]):
                dfg.append({"intent_key": intent, "from": a, "to": b})
        dfg = pd.DataFrame(dfg, columns=["intent_key", "from", "to"]).value_counts().rename("count").reset_index() if dfg else pd.DataFrame(columns=["intent_key", "from", "to", "count"])
        pos = pd.DataFrame(pos, columns=["intent_key", "step", "position"])
        mean_pos = pos.groupby(["intent_key", "step"])["position"].mean().round(3).rename("mean_position").reset_index()
        sup_tab = sup_tab.merge(mean_pos, on=["intent_key", "step"], how="left")
        metric("distinct tool transitions", len(dfg))
    with step("3.3 ordered plan per intent: gather context -> verify -> act -> conclude -> remediate"):
        stage = {"context": 1, "input": 1, "check": 2, "knowledge": 3, "tool": 3, "remediation": 5}
        plan = sup_tab[sup_tab.role.isin(["core", "optional", "diagnostic", "rule-out"])].copy()
        plan["stage"] = plan["step_type"].map(stage) + np.where(plan["role"] == "rule-out", 0.5, 0)
        plan["stage_name"] = plan["stage"].map({1: "gather context", 2: "verify (diagnostic checks)", 2.5: "rule out (checks that stay healthy)",
                                                3: "act (tools / knowledge)", 5: "remediate"})
        plan = plan.sort_values(["intent_key", "stage", "problem_rate", "mean_position", "support"], ascending=[True, True, False, True, False], na_position="last")
        plan["order_in_plan"] = plan.groupby("intent_key").cumcount() + 1
        show(plan.groupby("intent_key").agg(steps=("step", "size"), core=("role", lambda r: int((r == "core").sum()))).reset_index(), "   plan size per intent")
    add_sheet("D3_Step_Support", sup_tab)
    add_sheet("D3_Plan", plan[["intent_key", "order_in_plan", "stage_name", "step", "role", "support", "support_lower_95", "lift", "problem_rate", "mean_position", "interactions", "intent_size", "thin_intent"]])
    add_sheet("D3_Tool_Transitions", dfg)
    R.sup_tab, R.plan, R.dfg, R.always_on = sup_tab, plan, dfg, always_on
    with step("3.4 charts"):
        piv = sup_tab[sup_tab.role != "rare"].pivot_table(index="step", columns="intent_key", values="support", fill_value=0)
        if len(piv):
            piv = piv.loc[piv.max(axis=1).sort_values(ascending=False).index]
            heatmap(piv, "How often each step happens per intent (support)", "D3_01_step_x_intent_support")
        chk = sup_tab[sup_tab.step_type == "check"].pivot_table(index="step", columns="intent_key", values="problem_rate")
        if len(chk):
            heatmap(chk.loc[chk.max(axis=1).sort_values(ascending=False).index], "Where checks fail per intent (problem rate when the check ran)", "D3_02_check_problem_rate")
        for intent, g in plan.groupby("intent_key"):
            ro = g[g.role == "rule-out"].sort_values("support", ascending=False)
            hidden = len(ro) - 6
            g = pd.concat([g[g.role != "rule-out"], ro.head(6)]).sort_values("order_in_plan", ascending=False)
            fig, ax = plt.subplots(figsize=(9, max(2.5, 0.3 * len(g) + 1)))
            ax.barh([f"{r.order_in_plan:>2}. [{r.stage_name}] {r.step}" for r in g.itertuples()], g["support"],
                    color=[ROLE_COLOUR[r] for r in g["role"]], height=0.65)
            for y, r in enumerate(g.itertuples()):
                extra = f"  lift {r.lift}" + (f", fails {r.problem_rate:.0%}" if r.problem_rate == r.problem_rate else "")
                ax.text(r.support, y, f"  {r.support:.0%}{extra}", va="center", fontsize=7, color=INK2)
            ax.set_xlim(0, 1.25)
            ax.set_title(f"Plan for '{intent}' (n={int(n_int[intent])})\nblue = core, light blue = optional, orange = diagnostic check, green = rule-out check"
                         + (f"  (+{hidden} more rule-out checks in Excel D3_Plan)" if hidden > 0 else ""), fontsize=10)
            tidy(ax)
            save(fig, f"D3_03_plan_{slug(intent)}")
        for intent, g in dfg.groupby("intent_key"):
            if g["count"].sum() < 2:
                continue
            nodes = sorted(set(g["from"]) | set(g["to"]), key=lambda s: mean_pos.set_index(["intent_key", "step"])["mean_position"].get((intent, s), 0.5))
            x = {s: k for k, s in enumerate(nodes)}
            fig, ax = plt.subplots(figsize=(max(6, 1.6 * len(nodes)), 3.6))
            top = g["count"].max()
            for src_, dst_, cnt_ in g[["from", "to", "count"]].itertuples(index=False, name=None):
                a, b = x[src_], x[dst_]
                rad = -0.35 if b > a else 0.35
                ax.annotate("", xy=(b, 0), xytext=(a, 0), arrowprops=dict(arrowstyle="-|>", color=SERIES[0], lw=0.8 + 3 * cnt_ / top,
                                                                          connectionstyle=f"arc3,rad={rad}", alpha=0.8))
                span_ = abs(b - a)
                ax.text((a + b) / 2, (0.1 + 0.075 * span_) * (1 if b > a else -1), str(cnt_), ha="center", fontsize=7, color=INK2,
                        bbox=dict(boxstyle="round,pad=0.1", fc=SURFACE, ec="none"))
            ax.scatter(range(len(nodes)), [0] * len(nodes), s=320, c=SURFACE, edgecolors=SERIES[0], zorder=3)
            for k, s in enumerate(nodes):
                ax.text(k, -0.12, s.replace("tool:", ""), ha="center", va="top", fontsize=7.5, rotation=20)
            ax.set_ylim(-0.25 - 0.1 * len(nodes), 0.25 + 0.1 * len(nodes))
            ax.axis("off")
            ax.set_title(f"Tool flow for '{intent}' (arrow width = times A was directly followed by B)")
            save(fig, f"D3_04_toolflow_{slug(intent)}")


# %% D4 - expectations, targets and conditions (TM Forum TR290 shape)


def d4():
    banner("D4 - expectations, targets and conditions per intent (TR290: Intent -> Expectation -> Target / Condition)")
    steps, plan = R.steps, R.plan
    chk = steps[steps.step_type == "check"].copy()
    chk["value"] = chk["detail"].str.extract(r"value=(.*?); status")[0]
    chk["status"] = chk["detail"].str.extract(r"status=(.*)$")[0]
    rows, R.decomp = [], {}
    with step("4.1 build expectations"):
        for intent, g in plan.groupby("intent_key"):
            g = g.sort_values("order_in_plan")
            exp_list, ctx_list, act_list = [], [], []
            checks = g[g.role.isin(["diagnostic", "rule-out"])].sort_values("order_in_plan")["step"].tolist()
            for k, s in enumerate(checks):
                obs = chk[(chk.intent_key == intent) & (chk.step == s)]
                healthy = obs[obs.outcome == "passed"]["value"].value_counts()
                bad = obs[obs.outcome == "problem"]
                gr = g.set_index("step").loc[s]
                e = {
                    "expectation_id": f"E{k + 1}", "expectation_type": "PropertyExpectation", "target_property": s[6:],
                    "operator": "in", "target_values": healthy.index[:3].tolist() or ["(no passing example observed)"],
                    "condition_violated_when": sorted(set(bad["status"].dropna().str.lower()) | set(bad["value"].dropna().head(3))) or [f"(no failure in {len(obs)} runs)"],
                    "diagnostic_role": gr["role"],
                    "observed_problem_rate": None if pd.isna(gr["problem_rate"]) else float(gr["problem_rate"]),
                    "evaluated_in": int(len(obs)), "role": gr["role"], "support": float(gr["support"]),
                    "on_violation_next": "diagnose root cause, then remediate" if gr["role"] == "diagnostic" else "re-examine: unexpected failure",
                    "on_pass": f"rule out {s[6:]}",
                }
                exp_list.append(e)
                rows.append({"intent_key": intent, **{kk: (", ".join(map(str, v)) if isinstance(v, list) else v) for kk, v in e.items()}})
            for r in g[g.step_type.isin(["context", "input"])].itertuples():
                ctx_list.append({"requirement": r.step, "role": r.role, "support": r.support})
            for r in g[g.step_type.isin(["tool", "knowledge"])].itertuples():
                act_list.append({"action": r.step, "role": r.role, "support": r.support,
                                 "mean_position": None if pd.isna(r.mean_position) else r.mean_position})
            ii = R.inter[R.inter.intent_key == intent]
            rem = Counter(a.strip() for s in ii["remediation_actions"] for a in s.split(",") if a.strip())
            rc = [s for s in ii["root_cause_sentence"] if s][:5]
            R.decomp[intent] = {
                "intent": {"key": intent, "levels": R.levels, "interactions": int(len(ii))},
                "context_requirements": ctx_list, "expectations": exp_list, "actions": act_list,
                "root_cause_examples": rc, "remediations": [{"action": a, "count": c} for a, c in rem.most_common(10)],
                "excluded_always_on": [s for s in R.always_on],
            }
        tr = pd.DataFrame(rows)
        show(tr[["intent_key", "expectation_id", "target_property", "target_values", "condition_violated_when", "observed_problem_rate"]] if len(tr) else tr,
             "   expectations (checks) per intent", 40)
        metric("intents with at least one expectation", f"{tr['intent_key'].nunique() if len(tr) else 0} / {R.plan['intent_key'].nunique()}")
    add_sheet("D4_Expectations_TR290", tr)
    for intent, d in R.decomp.items():
        with open(OUT / "decomposition" / f"{slug(intent)}.json", "w", encoding="utf-8") as fh:
            json.dump(d, fh, indent=2, default=str)
    with open(OUT / "decomposition" / "all_intents.json", "w", encoding="utf-8") as fh:
        json.dump(R.decomp, fh, indent=2, default=str)
    log.info(f"   decomposition dictionaries -> decomposition/ ({len(R.decomp)} intents + all_intents.json)")


# %% D5 - validate the plans


def plan_steps(frame, intent):
    t = frame[(frame.intent_key == intent) & frame.role.isin(["core", "optional", "diagnostic"])]
    return set(t["step"])


def d5():
    banner("D5 - validate: do the plans cover what really happened, are intents distinct, what is missing")
    steps, inter = R.steps, R.inter
    kinds = ["context", "check", "tool", "knowledge"]
    with step("5.1 leave-one-out coverage (plan built without the interaction it is tested on)"):
        present = steps[steps.step_type.isin(kinds)].drop_duplicates(["record_id", "step"])
        by_rec = present.groupby("record_id")["step"].apply(set).to_dict()
        rows = []
        for intent, ii in inter.groupby("intent_key"):
            ids = ii["record_id"].tolist()
            if len(ids) < 3:
                continue
            for rid in ids:
                actual = by_rec.get(rid, set())
                if not actual:
                    continue
                others = [by_rec.get(o, set()) for o in ids if o != rid]
                cnt = Counter(s for st in others for s in st)
                pl = {s for s, c in cnt.items() if c / len(others) >= OPTIONAL_SUPPORT and s not in R.always_on}
                actual_s = {s for s in actual - set(R.always_on) if not s.startswith("check:")}
                pl = {s for s in pl if not s.startswith("check:")}
                hit = actual_s & pl
                fails = set(steps[(steps.record_id == rid) & (steps.outcome == "problem")]["step"])
                fail_cnt = Counter(s for o in ids if o != rid for s in steps[(steps.record_id == o) & (steps.outcome == "problem")]["step"])
                predicted_fail = {s for s, c in fail_cnt.items() if c >= MIN_FAILURES}
                rows.append({"intent_key": intent, "record_id": rid, "actual_steps": len(actual_s), "plan_steps": len(pl),
                             "recall": len(hit) / len(actual_s) if actual_s else np.nan, "precision": len(hit) / len(pl) if pl else np.nan,
                             "failed_checks": len(fails), "failed_checks_anticipated": len(fails & predicted_fail) / len(fails) if fails else np.nan})
        loo = pd.DataFrame(rows)
        cov = loo.groupby("intent_key").agg(interactions=("record_id", "size"), recall=("recall", "mean"), precision=("precision", "mean"),
                                            failed_checks_anticipated=("failed_checks_anticipated", "mean")).round(3).reset_index() if len(loo) else pd.DataFrame()
        show(cov, "   held-out coverage per intent (recall = share of real steps the plan predicted)")
        if len(cov):
            metric("mean held-out recall / precision (context, tools, knowledge)", f"{loo['recall'].mean():.2f} / {loo['precision'].mean():.2f}")
            metric("held-out failed checks the plan anticipated", f"{loo['failed_checks_anticipated'].mean():.0%} (over interactions with at least one failed check)")
    with step("5.2 are the intents' plans distinct? (Jaccard of core + optional steps)"):
        intents = sorted(R.plan["intent_key"].unique())
        sets = {i: plan_steps(R.sup_tab, i) - set(R.always_on) for i in intents}
        jac = pd.DataFrame([[len(sets[a] & sets[b]) / len(sets[a] | sets[b]) if sets[a] | sets[b] else np.nan for b in intents] for a in intents],
                           index=intents, columns=intents).round(3)
        near = [(a, b, jac.at[a, b]) for i, a in enumerate(intents) for b in intents[i + 1:] if jac.at[a, b] >= 0.8]
        if near:
            finding("Intent pairs whose plans are 80%+ identical (decomposition does not separate them): " + "; ".join(f"{a} ~ {b} ({v:.0%})" for a, b, v in near[:6]))
    with step("5.3 evidence alignment and blockers"):
        align = []
        for r in inter.itertuples():
            probs = [p.strip() for p in r.checks_problem.split(",") if p.strip()]
            if probs and r.root_cause_sentence:
                toks = [set(re.split(r"[_\W]+", p.lower())) - {"", "7d", "1d", "status", "value"} for p in probs]
                align.append(any(any(t in r.root_cause_sentence.lower() for t in ts) for ts in toks))
        if align:
            metric("root-cause text mentions a failed check", f"{np.mean(align):.0%} of {len(align)} interactions with both")
        block = []
        for intent, ii in inter.groupby("intent_key"):
            block.append({"intent_key": intent, "interactions": len(ii), "with_checks": int((ii.checks_run > 0).sum()),
                          "with_tools": int((ii.tool_sequence != "").sum()), "with_root_cause": int((ii.root_cause_sentence != "").sum()),
                          "with_remediation": int((ii.remediation_actions != "").sum()),
                          "blocker": "; ".join(b for b, ok in [("no validator checks", (ii.checks_run > 0).any()), ("no tool calls", (ii.tool_sequence != "").any()),
                                                             ("no root-cause text", (ii.root_cause_sentence != "").any()),
                                                             (f"fewer than {2 * MIN_INTENT_ROWS} interactions", len(ii) >= 2 * MIN_INTENT_ROWS)] if not ok)})
        block = pd.DataFrame(block)
        show(block, "   what each intent's decomposition is missing")
        for r in block[block.blocker != ""].itertuples():
            finding(f"'{r.intent_key}': {r.blocker}")
    add_sheet("D5_Coverage_by_Intent", cov)
    add_sheet("D5_Coverage_by_Interaction", loo)
    add_sheet("D5_Intent_Plan_Similarity", jac, index=True)
    add_sheet("D5_Blockers", block)
    with step("5.4 charts"):
        if len(cov):
            c = cov.iloc[::-1]
            fig, ax = plt.subplots(figsize=(8, max(2.5, 0.45 * len(c) + 1)))
            y = np.arange(len(c))
            ax.barh(y + 0.2, c["recall"], 0.38, color=SERIES[0], label="recall (real steps the plan predicted)")
            ax.barh(y - 0.2, c["precision"], 0.38, color="#86b6ef", label="precision (plan steps that really happened)")
            ax.set_yticks(y, c["intent_key"])
            ax.set_xlim(0, 1)
            ax.set_title("Held-out plan coverage per intent")
            ax.legend(frameon=False, fontsize=8, loc="lower right")
            tidy(ax)
            save(fig, "D5_01_plan_coverage")
        if len(jac) > 1:
            heatmap(jac, "How similar the intents' plans are (Jaccard of core + optional steps)", "D5_02_plan_similarity")


# %% D6 - outputs for the SLM


def d6():
    banner("D6 - SLM training records and final tables")
    steps, inter = R.steps, R.inter
    with step("6.1 one training record per interaction with evidence"):
        recs = []
        for r in inter.itertuples():
            st = steps[steps.record_id == r.record_id]
            if not ((st.step_type == "check").any() or (st.step_type == "tool").any()):
                continue
            ctx = {s[8:]: d for s, d in zip(st.loc[st.step_type == "context", "step"], st.loc[st.step_type == "context", "detail"])}
            dplan = R.decomp.get(r.intent_key, {})
            sub = []
            exp_by = {e["target_property"]: e for e in dplan.get("expectations", [])}
            ran = st[st.step_type == "check"].assign(rank=lambda x: x.outcome.map({"problem": 0, "neutral": 1, "passed": 2}))
            for _, c in ran.sort_values("rank").iterrows():
                prop = c["step"][6:]
                e = exp_by.get(prop, {})
                sub.append({"task": f"verify {prop}", "expectation": e.get("expectation_id"), "target": e.get("target_values"),
                            "observed": c["detail"], "outcome": c["outcome"]})
            for _, t in st[st.step_type == "tool"].sort_values("order").iterrows():
                sub.append({"task": f"call {t['step'][5:]}", "outcome": t["outcome"]})
            target = {"intent": r.intent_key, "sub_tasks": sub, "ruled_out": [c for c in r.checks_ruled_out.split(", ") if c],
                      "root_cause": r.root_cause_sentence, "remediation": [a for a in r.remediation_actions.split(", ") if a]}
            recs.append({"messages": [
                {"role": "system", "content": "Decompose the classified intent into ordered sub-tasks with expectations, targets and outcomes. Return JSON."},
                {"role": "user", "content": json.dumps({"intent": r.intent_key, "note": r.user_text, "context": ctx})},
                {"role": "assistant", "content": json.dumps(target, default=str)}],
                "metadata": {"record_id": r.record_id, "intent_path": r.intent_path}})
        with open(OUT / "decomposition" / "slm_decomposition_records.jsonl", "w", encoding="utf-8") as fh:
            for rec in recs:
                fh.write(json.dumps(rec, default=str) + "\n")
        metric("SLM decomposition records written", f"{len(recs)} (interactions with at least one check or tool call)")
    with step("6.2 final decomposition table (one row per intent x planned step)"):
        final = R.plan.copy()
        final["_prop"] = final["step"].str.replace("check:", "", regex=False)
        tr = R.sheets.get("D4_Expectations_TR290", pd.DataFrame())
        if len(tr):
            final = final.merge(tr.drop(columns=["role", "support"], errors="ignore"), how="left",
                                left_on=["intent_key", "_prop"], right_on=["intent_key", "target_property"])
        keep = [c for c in ["intent_key", "order_in_plan", "stage_name", "step", "role", "support", "lift", "problem_rate", "expectation_id",
                            "target_values", "condition_violated_when", "on_violation_next", "on_pass"] if c in final]
        add_sheet("Final_Decomposition", final[keep].sort_values(["intent_key", "order_in_plan"]))


# %% Excel


def write_excel():
    banner("REPORT - Excel workbook")
    from openpyxl import load_workbook
    from openpyxl.cell.cell import ILLEGAL_CHARACTERS_RE
    from openpyxl.formatting.rule import ColorScaleRule
    from openpyxl.styles import Alignment, Font, PatternFill

    dictionary = pd.DataFrame([
        ("intent_key", "Decomposition group: the finest intent path (L1 > L2 > L3 or L1 > category > subCategory) with enough interactions; thinner paths roll up to their parent"),
        ("step", "context:<field>, input:<field>, check:<validator>, tool:<name>, knowledge:<doc>, remediation:<action>"),
        ("support", "Share of the intent's interactions in which the step happened"),
        ("support_lower_95", "Wilson 95% lower bound of support (honest with small samples)"),
        ("lift", "support in this intent / support over all interactions; >1 = characteristic of the intent"),
        ("role", "core >= 60% support, optional 20-60%, rare below; always-on = 80%+ everywhere with the same rate for every intent. "
                 "Checks: diagnostic = fails >= 20% here and >= 1.5x its overall failure rate (2+ failures); rule-out = 3+ runs, never failed; weak signal = neither"),
        ("problem_lift", "Check failure rate in this intent / its failure rate over all interactions"),
        ("problem_rate", "For checks: share of runs whose status was warn / alert / poor"),
        ("mean_position", "For tools: average relative position in the call sequence (0 = first, 1 = last)"),
        ("expectation / target / condition", "TR290 shape: each check is a PropertyExpectation; target = values seen when it passed; condition = statuses/values seen when it failed"),
        ("recall / precision (D5)", "Leave-one-out: plan built from the other interactions of the intent, tested on the held-out one"),
    ], columns=["column", "meaning"])
    front = [("Summary", pd.DataFrame(R.summary, columns=["phase", "metric", "value"])),
             ("Findings", pd.DataFrame(R.findings, columns=["phase", "finding"])), ("Data_Dictionary", dictionary)]
    final = [("Final_Decomposition", R.sheets["Final_Decomposition"])] if "Final_Decomposition" in R.sheets else []
    ordered = front + final + [(k, v) for k, v in R.sheets.items() if k != "Final_Decomposition"]
    xlsx = OUT / f"{SRC.stem}_decomposition_D{args.until}.xlsx"
    with pd.ExcelWriter(xlsx, engine="openpyxl") as xw:
        for name, frame in ordered:
            frame.map(lambda v: ILLEGAL_CHARACTERS_RE.sub("", v)[:32000] if isinstance(v, str) else v).to_excel(xw, sheet_name=name[:31], index=False)
    fills = {"diagnostic": "FCE5CD", "rule-out": "D9EAD3", "weak signal": "FFFFFF", "core": "CFE2F3", "optional": "EAF2FB", "always-on": "EFEFEF", "rare": "FFFFFF", "problem": "F4CCCC", "passed": "D9EAD3",
             "neutral": "FFF2CC", "empty": "FCE5CD", "failed": "F4CCCC", "unavailable": "FCE5CD"}
    wb = load_workbook(xlsx)
    for ws in wb.worksheets:
        ws.freeze_panes = "B2" if ws.title == "D5_Intent_Plan_Similarity" else "A2"
        if ws.max_row > 1:
            ws.auto_filter.ref = ws.dimensions
        for c in ws[1]:
            c.font, c.fill = Font(bold=True, color="FFFFFF"), PatternFill("solid", fgColor="1C5CAB")
            c.alignment = Alignment(vertical="center", wrap_text=True)
        for j, cell in enumerate(ws[1], start=1):
            width = max(len(str(ws.cell(i, j).value or "")) for i in range(1, min(ws.max_row, 150) + 1))
            ws.column_dimensions[cell.column_letter].width = max(9, min(60, width + 2))
            if cell.value in ("role", "outcome"):
                for i in range(2, ws.max_row + 1):
                    f = fills.get(ws.cell(i, j).value)
                    if f:
                        ws.cell(i, j).fill = PatternFill("solid", fgColor=f)
            if cell.value in ("support", "problem_rate", "recall", "precision") and ws.max_row > 1:
                ws.conditional_formatting.add(f"{cell.column_letter}2:{cell.column_letter}{ws.max_row}",
                                              ColorScaleRule(start_type="num", start_value=0, start_color="FFFFFF", end_type="num", end_value=1, end_color="2A78D6"))
        if ws.title == "D5_Intent_Plan_Similarity" and ws.max_row > 1:
            ws.conditional_formatting.add(f"B2:{ws.cell(ws.max_row, ws.max_column).coordinate}",
                                          ColorScaleRule(start_type="num", start_value=0, start_color="FFFFFF", end_type="num", end_value=1, end_color="2A78D6"))
    wb.save(xlsx)
    log.info(f"   Excel  -> {xlsx}  ({len(ordered)} sheets)")
    log.info(f"   Charts -> {OUT / 'charts'}  ({len(list((OUT / 'charts').glob('*.png')))} PNGs)")
    log.info(f"   JSON   -> {OUT / 'decomposition'}")
    log.info(f"   Log    -> {OUT / 'run.log'}")


