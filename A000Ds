def downloads_dirs():
    roots = [os.environ.get(k) for k in ("OneDriveCommercial", "OneDrive")]
    dirs = [Path(r) / "Downloads" for r in roots if r] + [Path.home() / "Downloads"]
    return [d for d in dict.fromkeys(dirs) if d.is_dir()]


def locate(path_arg, pattern, required=True):
    if path_arg:
        if Path(path_arg).exists() or required:
            return Path(path_arg)
        print(f"WARNING: {path_arg} not found, continuing without it")
        return None
    matches = [p for d in downloads_dirs() for p in d.glob(pattern)]
    if matches:
        return max(matches, key=lambda p: p.stat().st_mtime)
    if required:
        raise FileNotFoundError(f"No file matching {pattern} in {downloads_dirs()}")
    return None


