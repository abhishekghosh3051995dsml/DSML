# %%
import csv
from pathlib import Path

import pandas as pd

FILE_NAME = "interactions.csv"
CSV_PATH = None  # set a full path here to skip the OneDrive search
SAMPLE_ROWS = 1000


def locate_csv(name):
    roots = [p for p in Path.home().iterdir() if p.is_dir() and p.name.lower().startswith("onedrive")]
    hits = [f for root in roots for f in root.rglob(name)]
    if not hits:
        raise FileNotFoundError(f"{name} not found under {[str(r) for r in roots]}")
    return max(hits, key=lambda f: f.stat().st_mtime)


def detect_format(path):
    for enc in ("utf-8-sig", "cp1252", "latin-1"):
        try:
            with open(path, encoding=enc, newline="") as fh:
                head = fh.read(64 * 1024)
            sep = csv.Sniffer().sniff(head, delimiters=",;\t|").delimiter
            return enc, sep
        except (UnicodeDecodeError, csv.Error):
            continue
    return "latin-1", ","


path = Path(CSV_PATH) if CSV_PATH else locate_csv(FILE_NAME)
encoding, sep = detect_format(path)
print(f"file      : {path}")
print(f"size (MB) : {path.stat().st_size / 1024**2:,.1f}")
print(f"encoding  : {encoding}   delimiter: {sep!r}")

# %%
columns = pd.read_csv(path, nrows=0, sep=sep, encoding=encoding).columns.tolist()
print(f"\n{len(columns)} columns\n")
for i, col in enumerate(columns, 1):
    print(f"{i:>3}  {col}")

# %%
sample = pd.read_csv(path, nrows=SAMPLE_ROWS, sep=sep, encoding=encoding, low_memory=False)

profile = pd.DataFrame({
    "column": sample.columns,
    "dtype": sample.dtypes.astype(str).values,
    "non_null_in_sample": sample.notna().sum().values,
    "distinct_in_sample": sample.nunique(dropna=True).values,
    "example_value": [
        str(sample[c].dropna().iloc[0])[:80] if sample[c].notna().any() else ""
        for c in sample.columns
    ],
})

pd.set_option("display.max_rows", None, "display.width", 200, "display.max_colwidth", 80)
print(profile.to_string(index=False))

out = path.with_name("interactions_columns.csv")
profile.to_csv(out, index=False)
print(f"\nsaved: {out}")
