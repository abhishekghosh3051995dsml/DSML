def norm_text(v: Any) -> str:
    if v is None:
        return ""
    s = str(v)
    if s.lower() == "nan":
        return ""
    return re.sub(r"\s+", " ", s).strip()


def norm_key(v: Any) -> str:
    return re.sub(r"[^a-z0-9]+", "_", norm_text(v).lower()).strip("_")


def safe_float(v: Any, default: Optional[float] = None) -> Optional[float]:
    try:
        x = float(v)
        return x if math.isfinite(x) else default
    except Exception:
        return default


def stable_id(namespace: str, *parts: Any, length: int = 20) -> str:
    payload = "|".join([namespace] + [norm_text(x) for x in parts]).encode("utf-8", errors="ignore")
    return f"{namespace[:4].upper()}_{hashlib.sha256(payload).hexdigest()[:length]}"


def safe_read_csv(path: Path) -> pd.DataFrame:
    if not path.exists():
        return pd.DataFrame()
    return pd.read_csv(path, low_memory=False).fillna("")


def first_col(df: pd.DataFrame, candidates: Sequence[str]) -> Optional[str]:
    if df.empty:
        return None
    exact = {str(c).lower(): c for c in df.columns}
    for x in candidates:
        if x.lower() in exact:
            return exact[x.lower()]
    normalized = {norm_key(c): c for c in df.columns}
    for x in candidates:
        if norm_key(x) in normalized:
            return normalized[norm_key(x)]
    return None


def compact_meta(row: Mapping[str, Any], limit: int = 18) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    for k, v in dict(row or {}).items():
        if str(k).startswith("_") or v in ("", None, [], {}):
            continue
        if len(out) >= limit:
            break
        if isinstance(v, np.generic):
            v = v.item()
        out[str(k)] = v
    return out


def catalog_map(df: pd.DataFrame, id_candidates: Sequence[str], meaning_candidates: Sequence[str]) -> Dict[str, Dict[str, Any]]:
    if df.empty:
        return {}
    id_col = first_col(df, id_candidates)
    meaning_col = first_col(df, meaning_candidates)
    if not id_col:
        return {}
    out: Dict[str, Dict[str, Any]] = {}
    for _, r in df.iterrows():
        rid = norm_text(r.get(id_col))
        if not rid:
            continue
        row = r.to_dict()
        row["_meaning"] = norm_text(r.get(meaning_col)) if meaning_col else rid
        out[rid] = row
    return out


@dataclass
class Node:
    id: str
    type: str
    label: str
    parent_id: Optional[str] = None
    level: int = 0
    count: int = 0
    metadata: Dict[str, Any] = field(default_factory=dict)
    source_artifacts: set[str] = field(default_factory=set)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "type": self.type,
            "label": self.label,
            "parent_id": self.parent_id,
            "level": self.level,
            "count": int(self.count),
            "metadata": self.metadata,
            "source_artifacts": sorted(self.source_artifacts),
            "style": NODE_STYLE.get(self.type, {"color": "#7f8c8d", "shape": "dot", "size": 11}),
        }


@dataclass
class Edge:
    id: str
    source: str
    target: str
    predicate: str
    kind: str
    count: int = 0
    confidence_sum: float = 0.0
    confidence_n: int = 0
    metadata: Dict[str, Any] = field(default_factory=dict)
    source_artifacts: set[str] = field(default_factory=set)

    def add_conf(self, value: Any) -> None:
        x = safe_float(value)
        if x is not None:
            self.confidence_sum += x
            self.confidence_n += 1

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "source": self.source,
            "target": self.target,
            "predicate": self.predicate,
            "kind": self.kind,
            "count": int(self.count),
            "mean_confidence": self.confidence_sum / self.confidence_n if self.confidence_n else None,
            "metadata": self.metadata,
            "source_artifacts": sorted(self.source_artifacts),
        }


class GraphStore:
    def __init__(self) -> None:
        self.nodes: Dict[str, Node] = {}
        self.edges: Dict[Tuple[str, str, str, str], Edge] = {}

    def add_node(self, node_id: str, node_type: str, label: str, *, parent_id: Optional[str] = None,
                 level: int = 0, count: int = 0, metadata: Optional[Mapping[str, Any]] = None,
                 source_artifact: Optional[str] = None) -> str:
        if node_id not in self.nodes:
            self.nodes[node_id] = Node(node_id, node_type, norm_text(label) or node_id, parent_id, level, max(0, int(count)), dict(metadata or {}))
        else:
            n = self.nodes[node_id]
            n.count += max(0, int(count))
            if parent_id and not n.parent_id:
                n.parent_id = parent_id
            for k, v in dict(metadata or {}).items():
                if v not in ("", None, [], {}) and k not in n.metadata:
                    n.metadata[k] = v
        if source_artifact:
            self.nodes[node_id].source_artifacts.add(source_artifact)
        return node_id

    def add_edge(self, source: str, target: str, predicate: str, *, kind: str, count: int = 1,
                 confidence: Any = None, metadata: Optional[Mapping[str, Any]] = None,
                 source_artifact: Optional[str] = None) -> str:
        if not source or not target or source == target:
            return ""
        key = (source, target, predicate, kind)
        if key not in self.edges:
            self.edges[key] = Edge(stable_id("edge", source, predicate, target, kind, length=24), source, target, predicate, kind, metadata=dict(metadata or {}))
        e = self.edges[key]
        e.count += max(1, int(count))
        e.add_conf(confidence)
        for k, v in dict(metadata or {}).items():
            if v not in ("", None, [], {}) and k not in e.metadata:
                e.metadata[k] = v
        if source_artifact:
            e.source_artifacts.add(source_artifact)
        return e.id


def relation_visual_type(t: str) -> str:
    t = t.upper()
    if t in NODE_STYLE:
        return t
    if t in {"SERVICE", "DEVICE_MODEL", "DEVICE_TYPE", "NETWORK_TECHNOLOGY", "NETWORK_PROTOCOL", "NETWORK_CONFIGURATION", "NETWORK_RESOURCE", "PRODUCT", "PLAN_OR_SOC", "METRIC"}:
        return "ENTITY"
    return "EVIDENCE"


class NoraGraphBuilder:
    def __init__(self, input_dir: Path, include_interactions: bool, include_fingerprints: bool) -> None:
        self.input_dir = input_dir
        self.include_interactions = include_interactions
        self.include_fingerprints = include_fingerprints
        self.g = GraphStore()
        self.frames = {k: safe_read_csv(input_dir / v) for k, v in FILES.items()}
        self.assign = self.frames["assignments"]
        if self.assign.empty:
            raise FileNotFoundError(f"Required artifact missing/empty: {input_dir / FILES['assignments']}")

        self.interaction_col = first_col(self.assign, ["interaction_ref"])
        self.pattern_col = first_col(self.assign, ["context_pattern_cluster_id", "cluster_id"])
        self.family_col = first_col(self.assign, ["context_family_id"])
        self.leaf_col = first_col(self.assign, ["context_leaf_id"])
        self.motif_col = first_col(self.assign, ["relation_motif_cluster_id"])
        if not self.interaction_col or not self.pattern_col:
            raise ValueError("context_pattern_assignments.csv must contain interaction_ref and context_pattern_cluster_id")

        self.pattern_catalog = catalog_map(self.frames["patterns"], ["context_pattern_cluster_id", "cluster_id"], ["meaning", "context_pattern_meaning", "descriptor"])
        self.family_catalog = catalog_map(self.frames["families"], ["context_family_id", "cluster_id"], ["meaning", "context_family_meaning", "descriptor"])
        self.leaf_catalog = catalog_map(self.frames["leaves"], ["context_leaf_id"], ["meaning", "local_context_refinement_meaning", "descriptor"])
        self.motif_catalog = catalog_map(self.frames["motifs"], ["cluster_id", "relation_motif_cluster_id"], ["meaning", "descriptor"])
        self.by_interaction: Dict[str, Dict[str, str]] = {}
        for _, r in self.assign.iterrows():
            ref = norm_text(r.get(self.interaction_col))
            if not ref:
                continue
            self.by_interaction[ref] = {
                "pattern": norm_text(r.get(self.pattern_col)),
                "family": norm_text(r.get(self.family_col)) if self.family_col else "",
                "leaf": norm_text(r.get(self.leaf_col)) if self.leaf_col else "",
                "motif": norm_text(r.get(self.motif_col)) if self.motif_col else "",
            }

    def family_node(self, family: str) -> Optional[str]:
        if not family or family in {"-1", "nan"}:
            return None
        meta = self.family_catalog.get(family, {})
        return self.g.add_node(stable_id("family", family), "CONTEXT_FAMILY", norm_text(meta.get("_meaning")) or f"Context Family {family}", level=0,
                               metadata={"context_family_id": family, **compact_meta(meta)}, source_artifact=FILES["families"])

    def pattern_node(self, pattern: str, family: str = "") -> Optional[str]:
        if not pattern or pattern in {"-1", "nan"}:
            return None
        parent = self.family_node(family)
        meta = self.pattern_catalog.get(pattern, {})
        nid = self.g.add_node(stable_id("pattern", pattern), "CONTEXT_PATTERN", norm_text(meta.get("_meaning")) or f"Context Pattern {pattern}", parent_id=parent, level=1,
                              metadata={"context_pattern_cluster_id": pattern, **compact_meta(meta)}, source_artifact=FILES["patterns"])
        if parent:
            self.g.add_edge(parent, nid, "HAS_PATTERN", kind="aggregation", source_artifact=FILES["assignments"])
        return nid

    def leaf_node(self, leaf: str, pattern: str, family: str = "") -> Optional[str]:
        if not leaf or leaf in {"-1", "NOT_CLUSTERABLE", "nan"}:
            return None
        parent = self.pattern_node(pattern, family)
        meta = self.leaf_catalog.get(leaf, {})
        nid = self.g.add_node(stable_id("leaf", leaf), "CONTEXT_LEAF", norm_text(meta.get("_meaning")) or leaf, parent_id=parent, level=2,
                              metadata={"context_leaf_id": leaf, "context_pattern_cluster_id": pattern, **compact_meta(meta)}, source_artifact=FILES["leaves"])
        if parent:
            self.g.add_edge(parent, nid, "HAS_LEAF", kind="aggregation", source_artifact=FILES["assignments"])
        return nid

    def anchor(self, interaction_ref: str) -> Optional[str]:
        a = self.by_interaction.get(interaction_ref)
        if not a:
            return None
        return self.leaf_node(a["leaf"], a["pattern"], a["family"]) or self.pattern_node(a["pattern"], a["family"])

    def build_hierarchy(self) -> None:
        for ref, a in self.by_interaction.items():
            anchor = self.anchor(ref)
            if not anchor:
                continue
            if self.include_interactions:
                iid = self.g.add_node(stable_id("interaction", ref), "INTERACTION", f"Interaction {ref[:10]}…", parent_id=anchor, level=3,
                                      metadata={"interaction_ref": ref}, source_artifact=FILES["assignments"])
                self.g.add_edge(anchor, iid, "HAS_INTERACTION", kind="aggregation", source_artifact=FILES["assignments"])
            motif = a.get("motif", "")
            if motif and motif not in {"-1", "nan"}:
                meta = self.motif_catalog.get(motif, {})
                mid = self.g.add_node(stable_id("motif", motif), "RELATION_MOTIF", norm_text(meta.get("_meaning")) or f"Relation Motif {motif}", level=3,
                                      metadata={"relation_motif_cluster_id": motif, **compact_meta(meta)}, source_artifact=FILES["motifs"])
                self.g.add_edge(anchor, mid, "HAS_RELATION_MOTIF", kind="aggregation", source_artifact=FILES["assignments"])

    def add_table_semantics(self) -> None:
        self.add_participants(); self.add_entities(); self.add_context_facts(); self.add_rca(); self.add_remediation(); self.add_tools()

    def add_participants(self) -> None:
        df = self.frames["participants"]
        ref_col, p_col = first_col(df,["interaction_ref"]), first_col(df,["participant"])
        if df.empty or not ref_col or not p_col:
            return
        sem_col, conf_col = first_col(df,["participant_semantics"]), first_col(df,["evidence_strength"])
        for _, r in df.iterrows():
            ref, p = norm_text(r.get(ref_col)), norm_text(r.get(p_col)).lower()
            anchor = self.anchor(ref)
            if not anchor or not p: continue
            nid = self.g.add_node(stable_id("participant", p), "PARTICIPANT", p, level=3,
                                  metadata={"participant": p, "participant_semantics": norm_text(r.get(sem_col)) if sem_col else ""}, source_artifact=FILES["participants"])
            self.g.add_edge(anchor, nid, "HAS_PARTICIPANT", kind="aggregation", confidence=r.get(conf_col) if conf_col else None, source_artifact=FILES["participants"])

    def add_entities(self) -> None:
        df = self.frames["entities"]
        ref_col, type_col, name_col = first_col(df,["interaction_ref"]), first_col(df,["entity_type"]), first_col(df,["canonical_name"])
        if df.empty or not ref_col or not type_col or not name_col: return
        key_col, conf_col = first_col(df,["canonicalization_key"]), first_col(df,["precision_score","evidence_strength"])
        for _, r in df.iterrows():
            ref, et, name = norm_text(r.get(ref_col)), norm_text(r.get(type_col)).upper(), norm_text(r.get(name_col))
            anchor=self.anchor(ref)
            if not anchor or not et or not name: continue
            canonical = norm_text(r.get(key_col)) if key_col else f"{et}::{name.lower()}"
            nid=self.g.add_node(stable_id("entity", et, canonical), "ENTITY", name, level=3,
                                metadata={"entity_type":et,"canonicalization_key":canonical}, source_artifact=FILES["entities"])
            self.g.add_edge(anchor,nid,"HAS_ENTITY",kind="aggregation",confidence=r.get(conf_col) if conf_col else None,source_artifact=FILES["entities"])

    def add_context_facts(self) -> None:
        df=self.frames["context_facts"]
        ref_col,type_col,fact_col=first_col(df,["interaction_ref"]),first_col(df,["context_type"]),first_col(df,["normalized_fact","summary_phrase"])
        if df.empty or not ref_col or not type_col or not fact_col:return
        conf_col=first_col(df,["context_substantive_score","max_evidence_strength"])
        for _,r in df.iterrows():
            ref,ctype,fact=norm_text(r.get(ref_col)),norm_text(r.get(type_col)).upper(),norm_text(r.get(fact_col)); anchor=self.anchor(ref)
            if not anchor or not ctype or not fact: continue
            nid=self.g.add_node(stable_id("context",ctype,fact.lower()),"CONTEXT_FACT",fact,level=3,metadata={"context_type":ctype},source_artifact=FILES["context_facts"])
            self.g.add_edge(anchor,nid,"HAS_CONTEXT",kind="aggregation",confidence=r.get(conf_col) if conf_col else None,source_artifact=FILES["context_facts"])

    def add_rca(self) -> None:
        df=self.frames["root_cause"]
        ref_col,phrase_col=first_col(df,["interaction_ref"]),first_col(df,["cause_phrase","statement"])
        if df.empty or not ref_col or not phrase_col:return
        status_col,conf_col=first_col(df,["status"]),first_col(df,["evidence_strength"])
        for _,r in df.iterrows():
            ref,phrase=norm_text(r.get(ref_col)),norm_text(r.get(phrase_col)); status=norm_text(r.get(status_col)).upper() if status_col else "UNKNOWN"; anchor=self.anchor(ref)
            if not anchor or not phrase: continue
            nid=self.g.add_node(stable_id("rca",status,phrase.lower()),"ROOT_CAUSE",phrase,level=3,metadata={"status":status},source_artifact=FILES["root_cause"])
            pred={"CONFIRMED":"HAS_CONFIRMED_CAUSE","SUSPECTED":"HAS_SUSPECTED_CAUSE","RULED_OUT":"HAS_RULED_OUT_CAUSE","NOT_DETERMINED":"CAUSE_NOT_DETERMINED"}.get(status,"HAS_CAUSE_CONTEXT")
            self.g.add_edge(anchor,nid,pred,kind="aggregation",confidence=r.get(conf_col) if conf_col else None,source_artifact=FILES["root_cause"])

    def add_remediation(self) -> None:
        df=self.frames["remediation"]
        ref_col,phrase_col=first_col(df,["interaction_ref"]),first_col(df,["action_phrase","statement"])
        if df.empty or not ref_col or not phrase_col:return
        conf_col=first_col(df,["evidence_strength"])
        for _,r in df.iterrows():
            ref,phrase=norm_text(r.get(ref_col)),norm_text(r.get(phrase_col)); anchor=self.anchor(ref)
            if not anchor or not phrase: continue
            nid=self.g.add_node(stable_id("remediation",phrase.lower()),"REMEDIATION",phrase,level=3,metadata={"action":phrase},source_artifact=FILES["remediation"])
            self.g.add_edge(anchor,nid,"HAS_REMEDIATION",kind="aggregation",confidence=r.get(conf_col) if conf_col else None,source_artifact=FILES["remediation"])

    def add_tools(self) -> None:
        structured = [self.input_dir/"tools.csv", self.input_dir/"tool_history.csv", self.input_dir/"tool_usage.csv"]
        source=next((p for p in structured if p.exists()),None)
        df=safe_read_csv(source) if source else self.frames["diagnostics"]
        if df.empty:return
        ref_col,tool_col=first_col(df,["interaction_ref"]),first_col(df,["tool_name","function_name","tool","tool_type"])
        if not ref_col or not tool_col:return
        source_name=source.name if source else FILES["diagnostics"]
        for _,r in df.iterrows():
            ref,tool=norm_text(r.get(ref_col)),norm_text(r.get(tool_col)); anchor=self.anchor(ref)
            if not anchor or not tool:continue
            tid=self.g.add_node(stable_id("tool",tool.lower()),"TOOL",tool,level=3,metadata={"tool_name":tool,"source":"structured_field"},source_artifact=source_name)
            self.g.add_edge(anchor,tid,"USED_TOOL",kind="aggregation",source_artifact=source_name)

    def add_grounded_relationships(self) -> None:
        df=self.frames["relationships"]
        if df.empty:return
        s_type,s_label,pred,t_type,t_label=(first_col(df,["subject_type"]),first_col(df,["subject"]),first_col(df,["predicate"]),first_col(df,["object_type"]),first_col(df,["object"]))
        if not all([s_type,s_label,pred,t_type,t_label]):return
        conf_col,tier_col,iref_col,eref_col=(first_col(df,["grounding_score","relation_confidence","evidence_strength"]),first_col(df,["grounding_tier","grounding_method"]),first_col(df,["interaction_ref"]),first_col(df,["evidence_ref"]))
        for _,r in df.iterrows():
            st,sl,pr,ot,ol=norm_text(r.get(s_type)).upper(),norm_text(r.get(s_label)),norm_text(r.get(pred)),norm_text(r.get(t_type)).upper(),norm_text(r.get(t_label))
            if not all([st,sl,pr,ot,ol]):continue
            sid=self.g.add_node(stable_id("semantic",st,sl.lower()),relation_visual_type(st),sl,level=4,metadata={"semantic_type":st},source_artifact=FILES["relationships"])
            oid=self.g.add_node(stable_id("semantic",ot,ol.lower()),relation_visual_type(ot),ol,level=4,metadata={"semantic_type":ot},source_artifact=FILES["relationships"])
            self.g.add_edge(sid,oid,pr,kind="semantic",confidence=r.get(conf_col) if conf_col else None,
                            metadata={"grounding_tier":norm_text(r.get(tier_col)) if tier_col else "","interaction_ref":norm_text(r.get(iref_col)) if iref_col else "","evidence_ref":norm_text(r.get(eref_col)) if eref_col else ""},source_artifact=FILES["relationships"])

    def add_fingerprints(self) -> None:
        if not self.include_fingerprints:return
        df=self.frames["fingerprints"]
        ref_col,fp_col=first_col(df,["interaction_ref"]),first_col(df,["fingerprint_id"])
        if df.empty or not ref_col or not fp_col:return
        for _,r in df.iterrows():
            ref,fp=norm_text(r.get(ref_col)),norm_text(r.get(fp_col)); anchor=self.anchor(ref)
            if not anchor or not fp:continue
            fid=self.g.add_node(stable_id("fingerprint",fp),"RELATION_MOTIF",f"Fingerprint {fp}",level=4,metadata={"fingerprint_id":fp},source_artifact=FILES["fingerprints"])
            self.g.add_edge(anchor,fid,"HAS_FINGERPRINT",kind="aggregation",source_artifact=FILES["fingerprints"])

    def build(self) -> Dict[str, Any]:
        self.build_hierarchy(); self.add_table_semantics(); self.add_grounded_relationships(); self.add_fingerprints()
        degree=Counter()
        for e in self.g.edges.values(): degree[e.source]+=1; degree[e.target]+=1
        for nid,n in self.g.nodes.items(): n.metadata["degree"]=degree[nid]
        return {
            "schema_version":GRAPH_SCHEMA_VERSION,
            "source_pipeline":PIPELINE,
            "input_dir":str(self.input_dir),
            "counts":{"nodes":len(self.g.nodes),"edges":len(self.g.edges),"node_types":dict(Counter(n.type for n in self.g.nodes.values())),"edge_predicates":dict(Counter(e.predicate for e in self.g.edges.values()))},
            "node_styles":NODE_STYLE,
            "nodes":[n.to_dict() for n in self.g.nodes.values()],
            "edges":[e.to_dict() for e in self.g.edges.values()],
        }


def write_outputs(bundle: Dict[str, Any], output_dir: Path) -> None:
    output_dir.mkdir(parents=True,exist_ok=True)
    (output_dir/"graph_bundle.json").write_text(json.dumps(bundle,indent=2,ensure_ascii=False),encoding="utf-8")
    pd.DataFrame([{"id":n["id"],"type":n["type"],"label":n["label"],"parent_id":n.get("parent_id"),"level":n.get("level"),"count":n.get("count"),"metadata_json":json.dumps(n.get("metadata",{}),ensure_ascii=False),"source_artifacts":";".join(n.get("source_artifacts",[]))} for n in bundle["nodes"]]).to_csv(output_dir/"graph_nodes.csv",index=False)
    pd.DataFrame([{"id":e["id"],"source":e["source"],"target":e["target"],"predicate":e["predicate"],"kind":e["kind"],"count":e["count"],"mean_confidence":e.get("mean_confidence"),"metadata_json":json.dumps(e.get("metadata",{}),ensure_ascii=False),"source_artifacts":";".join(e.get("source_artifacts",[]))} for e in bundle["edges"]]).to_csv(output_dir/"graph_edges.csv",index=False)
    (output_dir/"graph_build_report.json").write_text(json.dumps({"schema_version":bundle["schema_version"],"source_pipeline":bundle["source_pipeline"],"counts":bundle["counts"]},indent=2),encoding="utf-8")


def parse_args(argv=None):
    p=argparse.ArgumentParser(description="Build NORA V5.7.2 interactive knowledge graph")
    p.add_argument("--input-dir",required=True)
    p.add_argument("--output-dir",default="nora_v572_graph")
    p.add_argument("--include-interactions",action="store_true")
    p.add_argument("--include-fingerprints",action="store_true")
    return p.parse_args(argv)


def main(argv=None)->int:
    a=parse_args(argv)
    builder=NoraGraphBuilder(Path(a.input_dir).expanduser().resolve(),bool(a.include_interactions),bool(a.include_fingerprints))
    bundle=builder.build(); out=Path(a.output_dir).expanduser().resolve(); write_outputs(bundle,out)
    print(f"[OK] nodes={bundle['counts']['nodes']} edges={bundle['counts']['edges']}")
    print(f"[OK] output={out}")
    print(f"[RUN] python -m http.server 8000 --directory \"{out}\"")
    print("[OPEN] http://127.0.0.1:8000/viewer.html")
    return 0

if __name__=="__main__":
    raise SystemExit(main())
