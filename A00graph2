def norm_text(v: Any) -> str:
    if v is None:
        return ""
    try:
        if pd.isna(v):
            return ""
    except Exception:
        pass
    s = str(v)
    if s.strip().lower() in EMPTY_VALUES:
        return ""
    return re.sub(r"\s+", " ", s).strip()


def norm_key(v: Any) -> str:
    return re.sub(r"[^a-z0-9]+", "_", norm_text(v).lower()).strip("_")


def norm_label(v: Any) -> str:
    return norm_text(v).casefold()


def safe_float(v: Any, default: Optional[float] = None) -> Optional[float]:
    try:
        x = float(v)
        return x if math.isfinite(x) else default
    except Exception:
        return default


def safe_int(v: Any, default: int = 0) -> int:
    try:
        x = int(float(v))
        return x
    except Exception:
        return default


def stable_id(namespace: str, *parts: Any, length: int = 20) -> str:
    payload = "|".join([namespace] + [norm_text(x) for x in parts]).encode("utf-8", errors="ignore")
    prefix = re.sub(r"[^A-Za-z0-9]", "", namespace.upper())[:4] or "NODE"
    return f"{prefix}_{hashlib.sha256(payload).hexdigest()[:length]}"


def _json_scalar(v: Any) -> Any:
    if isinstance(v, np.generic):
        return v.item()
    if isinstance(v, pd.Timestamp):
        return v.isoformat()
    if isinstance(v, Path):
        return str(v)
    if isinstance(v, (str, int, float, bool)) or v is None:
        return v
    return str(v)


def compact_value(v: Any) -> Any:
    if isinstance(v, Mapping):
        return {str(k): compact_value(x) for k, x in list(v.items())[:METADATA_FIELD_LIMIT]}
    if isinstance(v, (list, tuple, set)):
        return [compact_value(x) for x in list(v)[:METADATA_SAMPLE_LIMIT]]
    v = _json_scalar(v)
    if isinstance(v, str) and len(v) > METADATA_STRING_LIMIT:
        return v[:METADATA_STRING_LIMIT] + "…"
    return v


def compact_meta(row: Mapping[str, Any], limit: int = METADATA_FIELD_LIMIT) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    for k, v in dict(row or {}).items():
        if str(k).startswith("_"):
            continue
        text = norm_text(v)
        if not text:
            continue
        if len(out) >= limit:
            break
        out[str(k)] = compact_value(v)
    return out


def merge_metadata(target: MutableMapping[str, Any], incoming: Optional[Mapping[str, Any]]) -> None:
    """Merge metadata without losing conflicting values.

    The first scalar is retained as the primary value. If later rows carry a
    different scalar for the same key, a `<key>_samples` list is maintained so
    aggregated graph edges/nodes preserve representative provenance.
    """
    if not incoming:
        return
    for k, raw in incoming.items():
        v = compact_value(raw)
        if v in ("", None, [], {}):
            continue
        if k not in target:
            target[k] = v
            continue
        if target[k] == v:
            continue
        sample_key = f"{k}_samples"
        vals = list(target.get(sample_key, [])) if isinstance(target.get(sample_key), list) else []
        if target[k] not in vals:
            vals.append(target[k])
        if v not in vals and len(vals) < METADATA_SAMPLE_LIMIT:
            vals.append(v)
        target[sample_key] = vals[:METADATA_SAMPLE_LIMIT]


@dataclass
class ArtifactLoadAudit:
    key: str
    file: str
    required: bool
    exists: bool
    size_bytes: int
    status: str
    rows: int = 0
    columns: int = 0
    encoding: str = ""
    parser: str = ""
    error: str = ""


class CsvLoader:
    """Resilient CSV loader with explicit audit trail."""

    def __init__(self, strict_optional: bool = False) -> None:
        self.strict_optional = strict_optional
        self.audit: list[ArtifactLoadAudit] = []

    def _record(self, audit: ArtifactLoadAudit) -> None:
        self.audit.append(audit)
        if audit.status.startswith("LOADED"):
            LOGGER.info("Loaded %-38s rows=%-7d cols=%-3d", audit.file, audit.rows, audit.columns)
        elif audit.required:
            LOGGER.error("Required artifact %s: %s", audit.file, audit.status)
        else:
            LOGGER.warning("Optional artifact %s: %s", audit.file, audit.status)

    def read(self, path: Path, *, key: str, required: bool = False) -> pd.DataFrame:
        path = Path(path)
        exists = path.exists() and path.is_file()
        size = int(path.stat().st_size) if exists else 0
        base = ArtifactLoadAudit(key=key, file=path.name, required=required, exists=exists, size_bytes=size, status="")

        if not exists:
            base.status = "MISSING_REQUIRED" if required else "MISSING_OPTIONAL"
            self._record(base)
            if required or self.strict_optional:
                raise FileNotFoundError(f"CSV artifact not found: {path}")
            return pd.DataFrame()

        if size == 0:
            base.status = "EMPTY_REQUIRED" if required else "EMPTY_OPTIONAL"
            self._record(base)
            if required or self.strict_optional:
                raise pd.errors.EmptyDataError(f"CSV artifact is zero bytes: {path}")
            return pd.DataFrame()

        attempts = (
            ("utf-8-sig", "c", "error"),
            ("utf-8", "python", "warn"),
            ("cp1252", "python", "warn"),
        )
        errors: list[str] = []
        for encoding, engine, on_bad_lines in attempts:
            try:
                df = pd.read_csv(
                    path,
                    low_memory=False if engine == "c" else None,
                    encoding=encoding,
                    engine=engine,
                    on_bad_lines=on_bad_lines,
                ).fillna("")
                base.rows = int(len(df))
                base.columns = int(len(df.columns))
                base.encoding = encoding
                base.parser = engine
                base.status = "LOADED" if engine == "c" else "LOADED_FALLBACK"
                if df.shape[1] == 0:
                    base.status = "NO_COLUMNS_REQUIRED" if required else "NO_COLUMNS_OPTIONAL"
                    self._record(base)
                    if required or self.strict_optional:
                        raise ValueError(f"CSV has no columns: {path}")
                    return pd.DataFrame()
                if df.empty:
                    # Header-only files are valid optional artifacts.
                    base.status = "HEADER_ONLY_REQUIRED" if required else "HEADER_ONLY_OPTIONAL"
                    self._record(base)
                    if required:
                        raise ValueError(f"Required CSV contains headers but no rows: {path}")
                    return df
                self._record(base)
                return df
            except pd.errors.EmptyDataError as exc:
                errors.append(f"{encoding}/{engine}: EmptyDataError: {exc}")
                break
            except (UnicodeDecodeError, pd.errors.ParserError) as exc:
                errors.append(f"{encoding}/{engine}: {type(exc).__name__}: {exc}")
                continue
            except Exception as exc:
                errors.append(f"{encoding}/{engine}: {type(exc).__name__}: {exc}")
                continue

        base.error = " | ".join(errors)[-2500:]
        if any("EmptyDataError" in x for x in errors):
            base.status = "EMPTY_REQUIRED" if required else "EMPTY_OPTIONAL"
        else:
            base.status = "READ_ERROR_REQUIRED" if required else "READ_ERROR_OPTIONAL"
        self._record(base)
        if required or self.strict_optional:
            raise RuntimeError(f"Unable to read CSV {path}: {base.error}")
        return pd.DataFrame()


def first_col(df: pd.DataFrame, candidates: Sequence[str]) -> Optional[str]:
    if df is None or df.shape[1] == 0:
        return None
    exact = {str(c).casefold(): c for c in df.columns}
    for x in candidates:
        if x.casefold() in exact:
            return exact[x.casefold()]
    normalized = {norm_key(c): c for c in df.columns}
    for x in candidates:
        if norm_key(x) in normalized:
            return normalized[norm_key(x)]
    return None


def catalog_map(
    df: pd.DataFrame,
    id_candidates: Sequence[str],
    meaning_candidates: Sequence[str],
) -> Dict[str, Dict[str, Any]]:
    if df.empty:
        return {}
    id_col = first_col(df, id_candidates)
    meaning_col = first_col(df, meaning_candidates)
    if not id_col:
        return {}
    out: Dict[str, Dict[str, Any]] = {}
    for _, r in df.iterrows():
        rid = norm_text(r.get(id_col))
        if not rid:
            continue
        row = r.to_dict()
        row["_meaning"] = norm_text(r.get(meaning_col)) if meaning_col else rid
        out[rid] = row
    return out


@dataclass
class Node:
    id: str
    type: str
    label: str
    parent_id: Optional[str] = None
    level: int = 0
    count: int = 0
    metadata: Dict[str, Any] = field(default_factory=dict)
    source_artifacts: set[str] = field(default_factory=set)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "type": self.type,
            "label": self.label,
            "parent_id": self.parent_id,
            "level": int(self.level),
            "count": int(self.count),
            "metadata": self.metadata,
            "source_artifacts": sorted(self.source_artifacts),
            "style": NODE_STYLE.get(self.type, {"color": "#7f8c8d", "shape": "dot", "size": 11}),
        }


@dataclass
class Edge:
    id: str
    source: str
    target: str
    predicate: str
    kind: str
    count: int = 0
    confidence_sum: float = 0.0
    confidence_n: int = 0
    metadata: Dict[str, Any] = field(default_factory=dict)
    source_artifacts: set[str] = field(default_factory=set)

    def add_conf(self, value: Any) -> None:
        x = safe_float(value)
        if x is not None:
            self.confidence_sum += x
            self.confidence_n += 1

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "source": self.source,
            "target": self.target,
            "predicate": self.predicate,
            "kind": self.kind,
            "count": int(self.count),
            "mean_confidence": self.confidence_sum / self.confidence_n if self.confidence_n else None,
            "metadata": self.metadata,
            "source_artifacts": sorted(self.source_artifacts),
        }


class GraphStore:
    def __init__(self) -> None:
        self.nodes: Dict[str, Node] = {}
        self.edges: Dict[Tuple[str, str, str, str], Edge] = {}

    def add_node(
        self,
        node_id: str,
        node_type: str,
        label: str,
        *,
        parent_id: Optional[str] = None,
        level: int = 0,
        count: int = 0,
        metadata: Optional[Mapping[str, Any]] = None,
        source_artifact: Optional[str] = None,
    ) -> str:
        if not node_id:
            return ""
        clean_label = norm_text(label) or node_id
        if node_id not in self.nodes:
            self.nodes[node_id] = Node(
                id=node_id,
                type=node_type,
                label=clean_label,
                parent_id=parent_id,
                level=int(level),
                count=max(0, int(count)),
                metadata={},
            )
            merge_metadata(self.nodes[node_id].metadata, metadata)
        else:
            n = self.nodes[node_id]
            n.count += max(0, int(count))
            if parent_id and not n.parent_id:
                n.parent_id = parent_id
            n.level = min(n.level, int(level)) if n.level is not None else int(level)
            if len(clean_label) > len(n.label) and n.label.startswith(("Context ", "Interaction ")):
                n.label = clean_label
            merge_metadata(n.metadata, metadata)
        if source_artifact:
            self.nodes[node_id].source_artifacts.add(source_artifact)
        return node_id

    def add_edge(
        self,
        source: str,
        target: str,
        predicate: str,
        *,
        kind: str,
        count: int = 1,
        confidence: Any = None,
        metadata: Optional[Mapping[str, Any]] = None,
        source_artifact: Optional[str] = None,
    ) -> str:
        if not source or not target or source == target:
            return ""
        pred = norm_text(predicate) or "RELATED_TO"
        key = (source, target, pred, kind)
        if key not in self.edges:
            self.edges[key] = Edge(
                id=stable_id("edge", source, pred, target, kind, length=24),
                source=source,
                target=target,
                predicate=pred,
                kind=kind,
                metadata={},
            )
        e = self.edges[key]
        e.count += max(1, int(count))
        e.add_conf(confidence)
        merge_metadata(e.metadata, metadata)
        if source_artifact:
            e.source_artifacts.add(source_artifact)
        return e.id


def relation_visual_type(t: str) -> str:
    t = norm_text(t).upper()
    if t in NODE_STYLE:
        return t
    if t in ENTITY_SEMANTIC_TYPES:
        return "ENTITY"
    if t in CONTEXT_SEMANTIC_TYPES:
        return t if t in NODE_STYLE else "CONTEXT_FACT"
    if t in {"ROOT_CAUSE", "REMEDIATION", "ATTRIBUTE", "MEASUREMENT", "PARTICIPANT"}:
        return t
    return "EVIDENCE"


class NoraGraphBuilder:
    def __init__(
        self,
        input_dir: Path,
        *,
        include_interactions: bool,
        include_fingerprints: bool,
        include_evidence: bool,
        strict_optional_inputs: bool,
    ) -> None:
        self.input_dir = Path(input_dir)
        if not self.input_dir.exists() or not self.input_dir.is_dir():
            raise NotADirectoryError(f"Input directory does not exist: {self.input_dir}")

        self.include_interactions = bool(include_interactions)
        self.include_fingerprints = bool(include_fingerprints)
        self.include_evidence = bool(include_evidence)
        self.g = GraphStore()
        self.loader = CsvLoader(strict_optional=strict_optional_inputs)
        self.warnings: list[str] = []
        self.metrics: Dict[str, Any] = {}

        self.frames: Dict[str, pd.DataFrame] = {}
        for key, filename in FILES.items():
            self.frames[key] = self.loader.read(
                self.input_dir / filename,
                key=key,
                required=(key == "assignments"),
            )

        self.assign = self.frames["assignments"]
        self.interaction_col = first_col(self.assign, ["interaction_ref"])
        self.pattern_col = first_col(self.assign, ["context_pattern_cluster_id", "cluster_id"])
        self.family_col = first_col(self.assign, ["context_family_id"])
        self.leaf_col = first_col(self.assign, ["context_leaf_id"])
        self.motif_col = first_col(self.assign, ["relation_motif_cluster_id"])
        self.problem_col = first_col(self.assign, ["customer_problem_normalized"])
        self.confidence_band_col = first_col(self.assign, ["confidence_band"])
        self.cluster_strength_col = first_col(self.assign, ["cluster_strength"])

        missing = []
        if not self.interaction_col:
            missing.append("interaction_ref")
        if not self.pattern_col:
            missing.append("context_pattern_cluster_id")
        if missing:
            raise ValueError(
                f"{FILES['assignments']} is missing required columns: {', '.join(missing)}. "
                f"Columns found: {list(self.assign.columns)}"
            )

        self.pattern_catalog = catalog_map(
            self.frames["patterns"],
            ["context_pattern_cluster_id", "cluster_id"],
            ["meaning", "context_pattern_meaning", "descriptor"],
        )
        self.family_catalog = catalog_map(
            self.frames["families"],
            ["context_family_id", "cluster_id"],
            ["meaning", "context_family_meaning", "descriptor"],
        )
        self.leaf_catalog = catalog_map(
            self.frames["leaves"],
            ["context_leaf_id"],
            ["meaning", "local_context_refinement_meaning", "descriptor"],
        )
        self.motif_catalog = catalog_map(
            self.frames["motifs"],
            ["cluster_id", "relation_motif_cluster_id"],
            ["meaning", "descriptor"],
        )

        # Interaction -> hierarchy assignment, deduplicated deterministically.
        self.by_interaction: Dict[str, Dict[str, str]] = {}
        duplicate_refs = Counter()
        conflict_refs = set()
        for _, r in self.assign.iterrows():
            ref = norm_text(r.get(self.interaction_col))
            if not ref:
                continue
            current = {
                "pattern": norm_text(r.get(self.pattern_col)),
                "family": norm_text(r.get(self.family_col)) if self.family_col else "",
                "leaf": norm_text(r.get(self.leaf_col)) if self.leaf_col else "",
                "motif": norm_text(r.get(self.motif_col)) if self.motif_col else "",
                "problem": norm_text(r.get(self.problem_col)) if self.problem_col else "",
                "confidence_band": norm_text(r.get(self.confidence_band_col)) if self.confidence_band_col else "",
                "cluster_strength": norm_text(r.get(self.cluster_strength_col)) if self.cluster_strength_col else "",
            }
            if ref in self.by_interaction:
                duplicate_refs[ref] += 1
                previous = self.by_interaction[ref]
                if any(previous.get(k, "") != current.get(k, "") for k in ("pattern", "family", "leaf", "motif")):
                    conflict_refs.add(ref)
                    # Keep the first assignment. A V5.7.2 interaction should not
                    # drift across multiple hierarchy IDs in the same artifact.
                continue
            self.by_interaction[ref] = current

        if conflict_refs:
            self.warnings.append(
                f"{len(conflict_refs)} interaction_ref values had conflicting hierarchy assignments; first occurrence retained."
            )
        self.metrics["duplicate_assignment_rows"] = int(sum(duplicate_refs.values()))
        self.metrics["conflicting_assignment_interactions"] = int(len(conflict_refs))
        self.metrics["unique_interactions"] = int(len(self.by_interaction))

        # Node caches / semantic reuse indexes.
        self.family_nodes: Dict[str, str] = {}
        self.pattern_nodes: Dict[str, str] = {}
        self.leaf_nodes: Dict[str, str] = {}
        self.interaction_nodes: Dict[str, str] = {}
        self.motif_nodes: Dict[str, str] = {}
        self.hierarchy_anchor_by_interaction: Dict[str, str] = {}
        self.semantic_anchor_by_interaction: Dict[str, str] = {}

        self.participant_nodes: Dict[str, str] = {}
        self.entity_nodes: Dict[Tuple[str, str], str] = {}
        self.context_nodes: Dict[Tuple[str, str], str] = {}
        self.rca_nodes: Dict[str, str] = {}
        self.remediation_nodes: Dict[str, str] = {}
        self.attribute_nodes: Dict[Tuple[str, str], str] = {}
        self.measurement_nodes: Dict[str, str] = {}

    # ------------------------------------------------------------------
    # Hierarchy
    # ------------------------------------------------------------------
    def _ensure_family(self, family: str, *, occurrence: int = 0) -> Optional[str]:
        family = norm_text(family)
        if not family or family in {"-1"}:
            return None
        if family in self.family_nodes:
            if occurrence:
                self.g.add_node(self.family_nodes[family], "CONTEXT_FAMILY", self.g.nodes[self.family_nodes[family]].label, count=occurrence)
            return self.family_nodes[family]
        meta = self.family_catalog.get(family, {})
        nid = self.g.add_node(
            stable_id("family", family),
            "CONTEXT_FAMILY",
            norm_text(meta.get("_meaning")) or f"Context Family {family}",
            level=0,
            count=occurrence,
            metadata={"context_family_id": family, **compact_meta(meta)},
            source_artifact=FILES["families"] if not self.frames["families"].empty else FILES["assignments"],
        )
        self.family_nodes[family] = nid
        return nid

    def _ensure_pattern(self, pattern: str, family: str = "", *, occurrence: int = 0) -> Optional[str]:
        pattern = norm_text(pattern)
        if not pattern or pattern in {"-1"}:
            return None
        parent = self._ensure_family(family, occurrence=0)
        if pattern in self.pattern_nodes:
            nid = self.pattern_nodes[pattern]
            if occurrence:
                self.g.add_node(nid, "CONTEXT_PATTERN", self.g.nodes[nid].label, count=occurrence)
            if parent and self.g.nodes[nid].parent_id and self.g.nodes[nid].parent_id != parent:
                self.warnings.append(f"Context pattern {pattern} appeared under multiple context families.")
            return nid
        meta = self.pattern_catalog.get(pattern, {})
        nid = self.g.add_node(
            stable_id("pattern", pattern),
            "CONTEXT_PATTERN",
            norm_text(meta.get("_meaning")) or f"Context Pattern {pattern}",
            parent_id=parent,
            level=1 if parent else 0,
            count=occurrence,
            metadata={"context_pattern_cluster_id": pattern, **compact_meta(meta)},
            source_artifact=FILES["patterns"] if not self.frames["patterns"].empty else FILES["assignments"],
        )
        self.pattern_nodes[pattern] = nid
        return nid

    def _ensure_leaf(self, leaf: str, pattern: str, family: str = "", *, occurrence: int = 0) -> Optional[str]:
        leaf = norm_text(leaf)
        if not leaf or leaf in {"-1", "NOT_CLUSTERABLE"}:
            return None
        parent = self._ensure_pattern(pattern, family, occurrence=0)
        if leaf in self.leaf_nodes:
            nid = self.leaf_nodes[leaf]
            if occurrence:
                self.g.add_node(nid, "CONTEXT_LEAF", self.g.nodes[nid].label, count=occurrence)
            if parent and self.g.nodes[nid].parent_id and self.g.nodes[nid].parent_id != parent:
                self.warnings.append(f"Context leaf {leaf} appeared under multiple context patterns.")
            return nid
        meta = self.leaf_catalog.get(leaf, {})
        nid = self.g.add_node(
            stable_id("leaf", leaf),
            "CONTEXT_LEAF",
            norm_text(meta.get("_meaning")) or leaf,
            parent_id=parent,
            level=2 if parent else 1,
            count=occurrence,
            metadata={"context_leaf_id": leaf, "context_pattern_cluster_id": pattern, **compact_meta(meta)},
            source_artifact=FILES["leaves"] if not self.frames["leaves"].empty else FILES["assignments"],
        )
        self.leaf_nodes[leaf] = nid
        return nid

    def hierarchy_anchor(self, interaction_ref: str) -> Optional[str]:
        return self.hierarchy_anchor_by_interaction.get(norm_text(interaction_ref))

    def semantic_anchor(self, interaction_ref: str) -> Optional[str]:
        ref = norm_text(interaction_ref)
        return self.semantic_anchor_by_interaction.get(ref) or self.hierarchy_anchor_by_interaction.get(ref)

    def build_hierarchy(self) -> None:
        seen_family_pattern: Counter[Tuple[str, str]] = Counter()
        seen_pattern_leaf: Counter[Tuple[str, str]] = Counter()

        # First pass: ensure hierarchy nodes and cache anchors.
        for ref, a in self.by_interaction.items():
            family = a.get("family", "")
            pattern = a.get("pattern", "")
            leaf = a.get("leaf", "")

            family_id = self._ensure_family(family, occurrence=1) if family else None
            pattern_id = self._ensure_pattern(pattern, family, occurrence=1)
            leaf_id = self._ensure_leaf(leaf, pattern, family, occurrence=1) if leaf else None
            hierarchy_anchor = leaf_id or pattern_id
            if not hierarchy_anchor:
                continue
            self.hierarchy_anchor_by_interaction[ref] = hierarchy_anchor

            if family_id and pattern_id:
                seen_family_pattern[(family_id, pattern_id)] += 1
            if pattern_id and leaf_id:
                seen_pattern_leaf[(pattern_id, leaf_id)] += 1

            if self.include_interactions:
                meta = {
                    "interaction_ref": ref,
                    "context_family_id": family,
                    "context_pattern_cluster_id": pattern,
                    "context_leaf_id": leaf,
                    "confidence_band": a.get("confidence_band", ""),
                    "cluster_strength": a.get("cluster_strength", ""),
                    "customer_problem_normalized": a.get("problem", ""),
                }
                iid = self.g.add_node(
                    stable_id("interaction", ref),
                    "INTERACTION",
                    f"Interaction {ref[:12]}…" if len(ref) > 12 else f"Interaction {ref}",
                    parent_id=hierarchy_anchor,
                    level=3,
                    count=1,
                    metadata=meta,
                    source_artifact=FILES["assignments"],
                )
                self.interaction_nodes[ref] = iid
                self.semantic_anchor_by_interaction[ref] = iid
                self.g.add_edge(
                    hierarchy_anchor,
                    iid,
                    "HAS_INTERACTION",
                    kind="aggregation",
                    source_artifact=FILES["assignments"],
                )
            else:
                self.semantic_anchor_by_interaction[ref] = hierarchy_anchor

            motif = norm_text(a.get("motif"))
            if motif and motif != "-1":
                meta = self.motif_catalog.get(motif, {})
                mid = self.motif_nodes.get(motif)
                if not mid:
                    mid = self.g.add_node(
                        stable_id("motif", motif),
                        "RELATION_MOTIF",
                        norm_text(meta.get("_meaning")) or f"Relation Motif {motif}",
                        level=4 if self.include_interactions else 3,
                        metadata={"relation_motif_cluster_id": motif, **compact_meta(meta)},
                        source_artifact=FILES["motifs"] if not self.frames["motifs"].empty else FILES["assignments"],
                    )
                    self.motif_nodes[motif] = mid
                else:
                    self.g.add_node(mid, "RELATION_MOTIF", self.g.nodes[mid].label, count=1)
                self.g.add_edge(
                    self.semantic_anchor_by_interaction[ref],
                    mid,
                    "HAS_RELATION_MOTIF",
                    kind="aggregation",
                    source_artifact=FILES["assignments"],
                )

        # Add cluster hierarchy edges once, carrying interaction support counts.
        for (source, target), count in seen_family_pattern.items():
            self.g.add_edge(
                source,
                target,
                "HAS_PATTERN",
                kind="aggregation",
                count=count,
                source_artifact=FILES["assignments"],
            )
        for (source, target), count in seen_pattern_leaf.items():
            self.g.add_edge(
                source,
                target,
                "HAS_LEAF",
                kind="aggregation",
                count=count,
                source_artifact=FILES["assignments"],
            )

