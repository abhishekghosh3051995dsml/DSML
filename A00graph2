        if df.empty or not ref_col or not p_col:
            return
        sem_col = first_col(df, ["participant_semantics"])
        conf_col = first_col(df, ["evidence_strength"])
        method_col = first_col(df, ["method"])
        for _, r in df.iterrows():
            ref = norm_text(r.get(ref_col))
            participant = norm_text(r.get(p_col)).lower()
            anchor = self.semantic_anchor(ref)
            if not anchor or not participant:
                continue
            key = norm_label(participant)
            nid = self.participant_nodes.get(key)
            metadata = {
                "participant": participant,
                "participant_semantics": norm_text(r.get(sem_col)) if sem_col else "",
                "method": norm_text(r.get(method_col)) if method_col else "",
            }
            if not nid:
                nid = self.g.add_node(
                    stable_id("participant", key),
                    "PARTICIPANT",
                    participant,
                    level=4 if self.include_interactions else 3,
                    count=1,
                    metadata=metadata,
                    source_artifact=FILES["participants"],
                )
                self.participant_nodes[key] = nid
            else:
                self.g.add_node(nid, "PARTICIPANT", participant, count=1, metadata=metadata, source_artifact=FILES["participants"])
            self.g.add_edge(
                anchor,
                nid,
                "HAS_PARTICIPANT",
                kind="aggregation",
                confidence=r.get(conf_col) if conf_col else None,
                metadata={"interaction_ref": ref},
                source_artifact=FILES["participants"],
