    def _resolve_semantic_node(self, semantic_type: str, label: str, interaction_ref: str = "") -> str:
        st = norm_text(semantic_type).upper() or "EVIDENCE"
        label = norm_text(label)
        key = norm_label(label)
        if not label:
            return ""

        if st == "PARTICIPANT":
            existing = self.participant_nodes.get(key)
            if existing:
                return existing
            nid = self.g.add_node(stable_id("participant", key), "PARTICIPANT", label, level=4, metadata={"semantic_type": st}, source_artifact=FILES["relationships"])
            self.participant_nodes[key] = nid
            return nid

        if st in ENTITY_SEMANTIC_TYPES:
            existing = self.entity_nodes.get((st, key))
            if existing:
                return existing
            canonical = f"{st}::{key}"
            nid = self.g.add_node(stable_id("entity", st, canonical), "ENTITY", label, level=4, metadata={"entity_type": st, "canonicalization_key": canonical, "semantic_type": st}, source_artifact=FILES["relationships"])
            self.entity_nodes[(st, key)] = nid
            return nid

        if st == "ROOT_CAUSE":
            existing = self.rca_nodes.get(key)
            if existing:
                return existing
            nid = self.g.add_node(stable_id("rca", key), "ROOT_CAUSE", label, level=4, metadata={"semantic_type": st}, source_artifact=FILES["relationships"])
            self.rca_nodes[key] = nid
            return nid

        if st == "REMEDIATION":
            existing = self.remediation_nodes.get(key)
            if existing:
                return existing
            nid = self.g.add_node(stable_id("remediation", key), "REMEDIATION", label, level=4, metadata={"semantic_type": st}, source_artifact=FILES["relationships"])
            self.remediation_nodes[key] = nid
            return nid

        if st == "ATTRIBUTE":
            # Relationship export usually carries "key=value" as the label.
            nid = self.g.add_node(stable_id("attribute_semantic", key), "ATTRIBUTE", label, level=4, metadata={"semantic_type": st}, source_artifact=FILES["relationships"])
            return nid

        if st == "MEASUREMENT":
            existing = self.measurement_nodes.get(key)
            if existing:
                return existing
            nid = self.g.add_node(stable_id("measurement", key), "MEASUREMENT", label, level=4, metadata={"semantic_type": st}, source_artifact=FILES["relationships"])
            self.measurement_nodes[key] = nid
            return nid

        if st in CONTEXT_SEMANTIC_TYPES:
            existing = self.context_nodes.get((st, key))
            if existing:
                return existing
            visual_type = st if st in NODE_STYLE else "CONTEXT_FACT"
            nid = self.g.add_node(stable_id("context", st, key), visual_type, label, level=4, metadata={"context_type": st, "semantic_type": st}, source_artifact=FILES["relationships"])
            self.context_nodes[(st, key)] = nid
            return nid

        if st == "INTERACTION" and interaction_ref:
            existing = self.interaction_nodes.get(interaction_ref)
            if existing:
                return existing

        return self.g.add_node(
            stable_id("semantic", st, key),
            relation_visual_type(st),
            label,
            level=4,
            metadata={"semantic_type": st},
            source_artifact=FILES["relationships"],
        )

    def add_grounded_relationships(self) -> None:
        df = self.frames["relationships"]
        if df.empty:
            return
        s_type = first_col(df, ["subject_type"])
        s_label = first_col(df, ["subject"])
        pred_col = first_col(df, ["predicate"])
        t_type = first_col(df, ["object_type"])
        t_label = first_col(df, ["object"])
        if not all([s_type, s_label, pred_col, t_type, t_label]):
            self.warnings.append(
                f"{FILES['relationships']} exists but is missing one or more typed relation columns; semantic edges skipped."
            )
            return

        conf_col = first_col(df, ["grounding_score", "relation_confidence", "evidence_strength"])
        tier_col = first_col(df, ["grounding_tier", "grounding_method"])
        iref_col = first_col(df, ["interaction_ref"])
        eref_col = first_col(df, ["evidence_ref"])
        rule_col = first_col(df, ["source_rule"])
        status_col = first_col(df, ["status"])
        grounding_status_col = first_col(df, ["grounding_status"])

        for _, r in df.iterrows():
            st = norm_text(r.get(s_type)).upper()
            sl = norm_text(r.get(s_label))
            predicate = norm_text(r.get(pred_col))
            ot = norm_text(r.get(t_type)).upper()
            ol = norm_text(r.get(t_label))
            iref = norm_text(r.get(iref_col)) if iref_col else ""
            if not all([st, sl, predicate, ot, ol]):
                continue

            sid = self._resolve_semantic_node(st, sl, iref)
            oid = self._resolve_semantic_node(ot, ol, iref)
            metadata = {
                "grounding_tier": norm_text(r.get(tier_col)) if tier_col else "",
                "grounding_status": norm_text(r.get(grounding_status_col)) if grounding_status_col else "",
                "interaction_ref": iref,
                "evidence_ref": norm_text(r.get(eref_col)) if eref_col else "",
                "source_rule": norm_text(r.get(rule_col)) if rule_col else "",
                "status": norm_text(r.get(status_col)) if status_col else "",
            }
            self.g.add_edge(
                sid,
                oid,
                predicate,
                kind="semantic",
                confidence=r.get(conf_col) if conf_col else None,
                metadata=metadata,
                source_artifact=FILES["relationships"],
            )

            # Make the semantic subgraph reachable from the hierarchy even when
            # the source/target node came only from grounded_relationships.csv.
            anchor = self.semantic_anchor(iref) if iref else None
            if anchor:
                self.g.add_edge(
                    anchor,
                    sid,
                    "HAS_SEMANTIC_SUBJECT",
                    kind="aggregation",
                    metadata={"interaction_ref": iref},
                    source_artifact=FILES["relationships"],
                )
                self.g.add_edge(
                    anchor,
                    oid,
                    "HAS_SEMANTIC_OBJECT",
                    kind="aggregation",
                    metadata={"interaction_ref": iref},
                    source_artifact=FILES["relationships"],
                )

    def add_fingerprints(self) -> None:
        if not self.include_fingerprints:
            return
        df = self.frames["fingerprints"]
        ref_col = first_col(df, ["interaction_ref"])
        fp_col = first_col(df, ["fingerprint_id"])
        if df.empty or not ref_col or not fp_col:
            return
        for _, r in df.iterrows():
            ref = norm_text(r.get(ref_col))
            fingerprint = norm_text(r.get(fp_col))
            anchor = self.semantic_anchor(ref)
            if not anchor or not fingerprint:
                continue
            fid = self.g.add_node(
                stable_id("fingerprint", fingerprint),
                "FINGERPRINT",
                f"Fingerprint {fingerprint}",
                level=4 if self.include_interactions else 3,
                count=1,
                metadata={"fingerprint_id": fingerprint, **compact_meta(r.to_dict(), limit=12)},
                source_artifact=FILES["fingerprints"],
            )
            self.g.add_edge(
                anchor,
                fid,
                "HAS_FINGERPRINT",
                kind="aggregation",
                metadata={"interaction_ref": ref},
                source_artifact=FILES["fingerprints"],
            )

    # ------------------------------------------------------------------
    # Build / quality
    # ------------------------------------------------------------------
    def _finalize_degrees(self) -> None:
        degree = Counter()
        semantic_degree = Counter()
        aggregation_degree = Counter()
        for e in self.g.edges.values():
            degree[e.source] += 1
            degree[e.target] += 1
            target = semantic_degree if e.kind == "semantic" else aggregation_degree
            target[e.source] += 1
            target[e.target] += 1
        for nid, node in self.g.nodes.items():
            node.metadata["degree"] = int(degree[nid])
            node.metadata["semantic_degree"] = int(semantic_degree[nid])
            node.metadata["aggregation_degree"] = int(aggregation_degree[nid])

    def _integrity(self) -> Dict[str, Any]:
        missing_source = []
        missing_target = []
        for e in self.g.edges.values():
            if e.source not in self.g.nodes:
                missing_source.append(e.id)
            if e.target not in self.g.nodes:
                missing_target.append(e.id)
        orphan_parent = [n.id for n in self.g.nodes.values() if n.parent_id and n.parent_id not in self.g.nodes]
        isolated = []
        degree = Counter()
        for e in self.g.edges.values():
            degree[e.source] += 1
            degree[e.target] += 1
        for nid in self.g.nodes:
            if degree[nid] == 0:
                isolated.append(nid)
        return {
            "missing_edge_sources": len(missing_source),
            "missing_edge_targets": len(missing_target),
            "orphan_parent_nodes": len(orphan_parent),
            "isolated_nodes": len(isolated),
            "is_valid": not missing_source and not missing_target and not orphan_parent,
        }

    def build(self) -> Dict[str, Any]:
        self.build_hierarchy()
        self.add_table_semantics()
        self.add_grounded_relationships()
        self.add_fingerprints()
        self._finalize_degrees()
        integrity = self._integrity()
        if not integrity["is_valid"]:
            raise RuntimeError(f"Graph integrity validation failed: {integrity}")

        counts = {
            "nodes": len(self.g.nodes),
            "edges": len(self.g.edges),
            "node_types": dict(sorted(Counter(n.type for n in self.g.nodes.values()).items())),
            "edge_kinds": dict(sorted(Counter(e.kind for e in self.g.edges.values()).items())),
            "edge_predicates": dict(Counter(e.predicate for e in self.g.edges.values()).most_common()),
        }
        return {
            "schema_version": GRAPH_SCHEMA_VERSION,
            "graph_builder_version": GRAPH_BUILDER_VERSION,
            "source_pipeline": PIPELINE,
            "input_dir": str(self.input_dir),
            "configuration": {
                "include_interactions": self.include_interactions,
                "include_fingerprints": self.include_fingerprints,
                "include_evidence": self.include_evidence,
            },
            "counts": counts,
            "integrity": integrity,
            "build_metrics": self.metrics,
            "warnings": sorted(set(self.warnings)),
            "artifact_load_audit": [asdict(x) for x in self.loader.audit],
            "node_styles": NODE_STYLE,
            "nodes": [n.to_dict() for n in self.g.nodes.values()],
            "edges": [e.to_dict() for e in self.g.edges.values()],
        }


def _atomic_text(path: Path, text: str, encoding: str = "utf-8") -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding=encoding)
    tmp.replace(path)


def _atomic_csv(df: pd.DataFrame, path: Path) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    df.to_csv(tmp, index=False)
    tmp.replace(path)


def _bundle_node_rows(bundle: Mapping[str, Any]) -> Iterable[Dict[str, Any]]:
    for n in bundle.get("nodes", []):
        yield {
            "id": n["id"],
            "type": n["type"],
            "label": n["label"],
            "parent_id": n.get("parent_id"),
            "level": n.get("level"),
            "count": n.get("count"),
            "metadata_json": json.dumps(n.get("metadata", {}), ensure_ascii=False),
            "source_artifacts": ";".join(n.get("source_artifacts", [])),
        }


def _bundle_edge_rows(bundle: Mapping[str, Any]) -> Iterable[Dict[str, Any]]:
    for e in bundle.get("edges", []):
        yield {
            "id": e["id"],
            "source": e["source"],
            "target": e["target"],
            "predicate": e["predicate"],
            "kind": e["kind"],
            "count": e["count"],
            "mean_confidence": e.get("mean_confidence"),
            "metadata_json": json.dumps(e.get("metadata", {}), ensure_ascii=False),
            "source_artifacts": ";".join(e.get("source_artifacts", [])),
        }


def copy_viewer(output_dir: Path, viewer_path: Optional[Path], no_viewer_copy: bool) -> Optional[Path]:
    if no_viewer_copy:
        return None
    candidate = viewer_path
    if candidate is None:
        candidate = Path(__file__).resolve().with_name("viewer.html")
    if not candidate.exists() or not candidate.is_file():
        LOGGER.warning("viewer.html not found at %s; graph files will still be generated.", candidate)
        return None
    dst = output_dir / "viewer.html"
    if candidate.resolve() != dst.resolve():
        shutil.copy2(candidate, dst)
    return dst


def write_outputs(
    bundle: Dict[str, Any],
    output_dir: Path,
    *,
    viewer_path: Optional[Path],
    no_viewer_copy: bool,
) -> Optional[Path]:
    output_dir.mkdir(parents=True, exist_ok=True)

    _atomic_text(
        output_dir / "graph_bundle.json",
        json.dumps(bundle, indent=2, ensure_ascii=False),
    )
    _atomic_csv(pd.DataFrame(list(_bundle_node_rows(bundle))), output_dir / "graph_nodes.csv")
    _atomic_csv(pd.DataFrame(list(_bundle_edge_rows(bundle))), output_dir / "graph_edges.csv")
    _atomic_csv(pd.DataFrame(bundle.get("artifact_load_audit", [])), output_dir / "artifact_load_audit.csv")

    report = {
        "schema_version": bundle["schema_version"],
        "graph_builder_version": bundle["graph_builder_version"],
        "source_pipeline": bundle["source_pipeline"],
        "input_dir": bundle.get("input_dir"),
        "configuration": bundle.get("configuration", {}),
        "counts": bundle["counts"],
        "integrity": bundle.get("integrity", {}),
        "build_metrics": bundle.get("build_metrics", {}),
        "warnings": bundle.get("warnings", []),
        "artifact_load_audit": bundle.get("artifact_load_audit", []),
    }
    _atomic_text(output_dir / "graph_build_report.json", json.dumps(report, indent=2, ensure_ascii=False))
    return copy_viewer(output_dir, viewer_path, no_viewer_copy)


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Build the NORA V5.7.2 interactive knowledge graph from V5.7.2 CSV artifacts."
    )
    p.add_argument("--input-dir", required=True, help="Directory containing the V5.7.2 CSV outputs.")
    p.add_argument("--output-dir", default="nora_v572_graph", help="Directory for graph_bundle.json and graph CSVs.")
    p.add_argument("--include-interactions", action="store_true", help="Add one clickable INTERACTION node per interaction_ref.")
    p.add_argument("--include-fingerprints", action="store_true", help="Add deterministic V5.7.2 interaction fingerprint nodes.")
    p.add_argument("--include-evidence", action="store_true", help="Add diagnostic evidence statement nodes (can increase graph size).")
    p.add_argument("--strict-optional-inputs", action="store_true", help="Fail instead of skipping missing/empty optional CSV artifacts.")
    p.add_argument("--viewer", help="Optional path to viewer.html. If omitted, viewer.html beside this script is used when present.")
    p.add_argument("--no-viewer-copy", action="store_true", help="Do not copy viewer.html into the graph output directory.")
    p.add_argument("--verbose", action="store_true")
    return p.parse_args(argv)


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(argv)
    configure_logging(args.verbose)
    try:
        input_dir = Path(args.input_dir).expanduser().resolve()
        output_dir = Path(args.output_dir).expanduser().resolve()
        viewer_path = Path(args.viewer).expanduser().resolve() if args.viewer else None

        builder = NoraGraphBuilder(
            input_dir,
            include_interactions=bool(args.include_interactions),
            include_fingerprints=bool(args.include_fingerprints),
            include_evidence=bool(args.include_evidence),
            strict_optional_inputs=bool(args.strict_optional_inputs),
        )
        bundle = builder.build()
        copied_viewer = write_outputs(
            bundle,
            output_dir,
            viewer_path=viewer_path,
            no_viewer_copy=bool(args.no_viewer_copy),
        )

        print(f"[OK] graph_builder_version={GRAPH_BUILDER_VERSION}")
        print(f"[OK] nodes={bundle['counts']['nodes']} edges={bundle['counts']['edges']}")
        print(f"[OK] integrity={bundle['integrity']['is_valid']}")
        print(f"[OK] output={output_dir}")
        skipped = [x for x in bundle["artifact_load_audit"] if not str(x.get("status", "")).startswith("LOADED")]
        if skipped:
            print(f"[INFO] optional/marginal artifacts skipped_or_empty={len(skipped)}; see artifact_load_audit.csv")
        if copied_viewer:
            print(f"[OK] viewer={copied_viewer}")
            print(f"[RUN] python -m http.server 8000 --directory \"{output_dir}\"")
            print("[OPEN] http://127.0.0.1:8000/viewer.html")
        else:
            print("[INFO] viewer.html was not copied; graph data files are ready.")
        return 0
    except KeyboardInterrupt:
        LOGGER.error("Interrupted by user.")
        return 130
    except Exception as exc:
        LOGGER.exception("Graph build failed: %s", exc)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
