    def add_tools(self) -> None:
        source: Optional[Path] = None
        for name in TOOL_FILE_CANDIDATES:
            p = self.input_dir / name
            if p.exists() and p.is_file():
                source = p
                break

        if source:
            df = self.loader.read(source, key="tools_dynamic", required=False)
            source_name = source.name
        else:
            df = self.frames["diagnostics"]
            source_name = FILES["diagnostics"]

        if df.empty:
            return
        ref_col = first_col(df, ["interaction_ref"])
        tool_col = first_col(df, ["tool_name", "function_name", "tool", "tool_type"])
        if not ref_col or not tool_col:
            return
        result_col = first_col(df, ["status", "tool_status", "success", "result"])
        tool_nodes: Dict[str, str] = {}
        for _, r in df.iterrows():
            ref = norm_text(r.get(ref_col))
            tool = norm_text(r.get(tool_col))
            anchor = self.semantic_anchor(ref)
            if not anchor or not tool:
                continue
            key = norm_label(tool)
            tid = tool_nodes.get(key)
            metadata = {
                "tool_name": tool,
                "tool_result": norm_text(r.get(result_col)) if result_col else "",
                "source": "structured_tool_field",
            }
            if not tid:
                tid = self.g.add_node(
                    stable_id("tool", key),
                    "TOOL",
                    tool,
                    level=4 if self.include_interactions else 3,
                    count=1,
                    metadata=metadata,
                    source_artifact=source_name,
                )
                tool_nodes[key] = tid
            else:
                self.g.add_node(tid, "TOOL", tool, count=1, metadata=metadata, source_artifact=source_name)
            self.g.add_edge(
                anchor,
                tid,
                "USED_TOOL",
                kind="aggregation",
                metadata={"interaction_ref": ref},
                source_artifact=source_name,
            )

