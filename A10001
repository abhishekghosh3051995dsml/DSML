def run_inference(c:Config):
    outdir=Path(c.outdir);outdir.mkdir(parents=True,exist_ok=True);md=Path(c.model_dir or "");manifest_path=md/"model_manifest.json"
    if not manifest_path.exists():raise FileNotFoundError(f"Model manifest not found: {manifest_path}")
    manifest=json.loads(manifest_path.read_text(encoding="utf-8"));meta=manifest.get("artifacts",{}).get("model",{});model_file=meta.get("model_file")
    if not model_file:raise RuntimeError("Persisted model unavailable. The training run may have contained HARD privacy residue.")
    mp=md/model_file
    if meta.get("model_sha256") and sha256_file(mp)!=meta["model_sha256"]:raise RuntimeError("Model checksum mismatch.")
    payload=joblib.load(mp)
    if payload.get("artifact_format")!=ARTIFACT_FORMAT_VERSION:raise RuntimeError("Artifact format mismatch; retrain with NORA Entity-Context v5.6.1.")
    if payload.get("code_fingerprint_sha256")!=current_code_fingerprint():raise RuntimeError("Code fingerprint mismatch between training and inference runtime.")
    bundle=payload["bundle"];frame,schema=load_raw_frame(c);frame["data_split"]="inference";frame,privacy_summary,residual_df=privacy_prepare_frame(frame)
    key,key_source=resolve_pseudonym_key(c)
    frame["_row_ref"]=[pseudonymize(f"{g}|{rid}",key) for g,rid in zip(frame["_group"].astype(str),frame["_row_id"].astype(str))]
    interactions=aggregate_interactions(frame,key)
    records=build_records(frame,interactions,bundle.problem_normalizer,set(bundle.stopwords),c,bundle.relation_schema)
    clusterable=[r for r in records if len(tokenize(r["_customer_problem"]))>=c.min_problem_tokens];cluster_map={}
    if clusterable:
        v=transform_representation(bundle.representation,[r["_customer_problem"] for r in clusterable],[r["_semantic_signature"] for r in clusterable])
        l,s,src=predict_cluster(bundle.cluster_model,v)
        cluster_map={r["interaction_ref"]:(int(l[i]),float(s[i]),str(src[i])) for i,r in enumerate(clusterable)}
    topic_assign,topic_catalog,topic_map=latent_topic_tables(clusterable,bundle.representation)
    public_examples_safe=bool(privacy_summary.get("public_examples_safe",False));hard_privacy_safe=bool(privacy_summary.get("model_persistence_safe",False))
    public=[]
    for r in records:
        cid,strength,src=cluster_map.get(r["interaction_ref"],(-1,0.0,"not_clusterable"))
        meaning="UNKNOWN/OUTLIER" if cid==-1 else bundle.cluster_descriptions.get(cid,{}).get("descriptor",f"cluster_{cid}")
        public.append(public_dictionary_record(r,cid,strength,meaning,src,public_examples_safe,hard_privacy_safe,topic_map.get(str(r["interaction_ref"]))))
    out=outdir/"nora_entity_context_inference.jsonl"
    with out.open("w",encoding="utf-8") as h:
        for r in public:h.write(json.dumps(to_plain(r),ensure_ascii=False)+"\n")
    safe_residual=_privacy_safe_residual_table(residual_df)
    safe_residual.to_csv(outdir/"residual_pii_findings.csv",index=False)
    if not safe_residual.empty:
        cols=[x for x in ("severity","type","source") if x in safe_residual.columns]
        safe_residual.groupby(cols,dropna=False).size().reset_index(name="count").sort_values("count",ascending=False).to_csv(outdir/"privacy_review_summary.csv",index=False)
    if not topic_assign.empty:topic_assign.to_csv(outdir/"latent_topic_assignments.csv",index=False)
    cluster_assignment_table(public).to_csv(outdir/"context_pattern_assignments.csv",index=False)
    interaction_dictionary_table(public).to_csv(outdir/"interaction_dictionary.csv",index=False)
    participant_summary_table(public).to_csv(outdir/"participant_summary.csv",index=False)
    entity_summary_table(public).to_csv(outdir/"entity_summary.csv",index=False)
    context_summary_table(public).to_csv(outdir/"context_summary.csv",index=False)
    flatten_field(public,"entities").to_csv(outdir/"entities.csv",index=False)
    flatten_field(public,"entity_candidates").to_csv(outdir/"entity_candidates_review.csv",index=False)
    flatten_field(public,"relationships").to_csv(outdir/"relationships.csv",index=False)
    graph_node_table(public).to_csv(outdir/"relation_graph_nodes.csv",index=False)
    relation_summary_table(public).to_csv(outdir/"relation_summary.csv",index=False)
    assigned=sum(1 for x in public if int(x["semantic_cluster"]["cluster_id"])!=-1)
    rep={
        "pipeline":PIPELINE_NAME,"pipeline_version":PIPELINE_VERSION,"mode":"infer","execution_status":"SUCCESS",
        "privacy_review_status":privacy_summary["residual_gate_status"],"public_text_suppressed":not public_examples_safe,
        "input_rows":len(frame),"interaction_records":len(public),"clusterable_customer_interactions":len(clusterable),
        "assigned_fraction":float(assigned/max(len(clusterable),1)),"cluster_id_contract":{"first_cluster_id":1,"outlier_id":-1},
        "external_pretrained_models_used":False,"pseudonym_key_source":key_source,"schema":schema,"output":out.name,
    }
    (outdir/"nora_entity_context_inference_report.json").write_text(json.dumps(to_plain(rep),indent=2,ensure_ascii=False),encoding="utf-8")
    return rep


