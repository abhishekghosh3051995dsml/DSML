    if etype=="DEVICE_MODEL" and compat>=.90:score+=.025
    if etype=="METRIC" and method=="validated_measurement_key":score+=.025
    if role=="customer" and (IMPACT_CUE_RE.search(text) or REQUEST_CUE_RE.search(text)):score+=.025
    if role in {"assistant","evidence"} and (DIAGNOSTIC_CUE_RE.search(text) or REMEDIATION_CUE_RE.search(text) or CAUSE_CUE_RE.search(text)):score+=.02
