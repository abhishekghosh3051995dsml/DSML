    elif lens=="relation_motif":
        for x in r.get("relationships",[]):
            if str(x.get("predicate")) not in SUBSTANTIVE_RELATION_PREDICATES:continue
            toks += ["pred_"+normalise_key(x.get("predicate","")),"motif_"+normalise_key(x.get("subject_type",""))+"__"+normalise_key(x.get("predicate",""))+"__"+normalise_key(x.get("object_type",""))]
