def relation_structure_purity(records,labels):
    """Mean within-cluster agreement of typed relation topology.

    v5.6.1 intentionally measures subject-type/predicate/object-type structure.
    Canonical resource values are analyzed separately and do not contaminate a
    metric named *structure* purity.
    """
    labels=np.asarray(labels,dtype=int);per={}
    if len(records)!=len(labels):return None,{}
