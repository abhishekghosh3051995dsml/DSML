        idx=np.flatnonzero(labels==cid);docs=[]
        for i in idx:
            sig=set()
            for rel in records[i].get("relationships",[]):
                if rel.get("schema_status") not in {None,"VALID"}:continue
                pred=str(rel.get("predicate",""));st=str(rel.get("subject_type",""));ot=str(rel.get("object_type",""))
                if pred in {"REPORTS_PROBLEM","HAS_ATTRIBUTE","HAS_TEMPORAL_CONTEXT"}:continue
                if pred and st and ot:sig.add(f"{st}|{pred}|{ot}")
            docs.append(sig)
        freq=Counter(t for d in docs for t in d);core={t for t,n in freq.items() if n/max(len(docs),1)>=.30}
        if not core:core={t for t,_ in freq.most_common(min(6,len(freq)))}
