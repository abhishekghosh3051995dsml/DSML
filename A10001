        lab=km.fit_predict(X)
        if len(set(lab))<2:continue
        try:sil=float(silhouette_score(X,lab,metric="cosine"))
        except Exception:sil=-1.0
        largest=max(Counter(lab).values())/n
        score=sil-.12*max(0.0,largest-.55)
        candidates.append((score,sil,k,km,lab))
    if not candidates:
        labels=np.ones(n,dtype=int);cent=np.asarray(X.mean(axis=0));return labels,pd.DataFrame([{"lens":lens,"cluster_id":1,"meaning":"single_signature","count":n,"share_pct":100.0,"cohesion":1.0}]),np.asarray(X.toarray()),{1:"single_signature"}
    _,_,k,km,raw=max(candidates,key=lambda x:x[0]);labels=np.asarray(raw,dtype=int)+1
    terms=np.asarray(vec.get_feature_names_out());meanings={};rows=[];Xd=np.asarray(X.toarray())
    for cid in sorted(set(labels.tolist())):
        idx=np.flatnonzero(labels==cid);cent=np.asarray(Xd[idx].mean(axis=0),float);norm=max(float(np.linalg.norm(cent)),1e-12);cent=cent/norm;sims=Xd[idx]@cent;top=np.argsort(cent)[::-1][:4];meaning=" / ".join(str(terms[j]).replace("_"," ") for j in top if cent[j]>0) or f"cluster_{cid}";meanings[cid]=meaning
        rows.append({"lens":lens,"cluster_id":cid,"meaning":meaning,"count":len(idx),"share_pct":100*len(idx)/n,"cohesion":float(np.mean(sims)) if len(sims) else np.nan})
    return labels,pd.DataFrame(rows).sort_values("count",ascending=False).reset_index(drop=True),Xd,meanings

