    a=p.parse_args(argv)
    if not .05<=a.test_size<=.40:p.error("--test-size must be between 0.05 and 0.40")
    if not .05<=a.validation_within_development<=.35:p.error("--validation-within-development must be between 0.05 and 0.35")
    if not 0<a.template_df_ratio<1:p.error("--template-df-ratio must be in (0,1)")
    if a.local_embedding_components<2:p.error("--local-embedding-components must be >=2")
    if a.local_context_window<1:p.error("--local-context-window must be >=1")
    if a.local_min_df<1:p.error("--local-min-df must be >=1")
    if a.local_max_vocab<50:p.error("--local-max-vocab must be >=50")
    if not 0<a.sif_a<1:p.error("--sif-a must be in (0,1)")
    for name in (
        "centroid_quantile","centroid_min_similarity","centroid_margin","selection_target_coverage",
        "business_min_coverage","business_max_outlier_rate","business_max_largest_cluster_share",
        "business_min_problem_normalization_coverage","business_max_low_confidence_entity_fraction",
        "business_entity_confidence_floor","analytics_min_validation_silhouette","analytics_min_validation_coherence",
        "entity_accept_confidence","entity_generic_accept_confidence","relation_min_confidence",
        "analytics_min_signature_purity","analytics_min_relation_coverage","analytics_min_relation_structure_purity",
        "analytics_min_grounded_relation_coverage","analytics_min_evidence_reference_coverage","analytics_max_entity_ambiguity_fraction","analytics_min_context_partition_stability"
    ):
        if not 0<=getattr(a,name)<=1:p.error(f"--{name.replace('_','-')} must be between 0 and 1")
    if a.mode=="infer" and not a.model_dir:p.error("--model-dir is required for inference")
    if a.profile=="fast_dev":
        a.model_search_trials=min(a.model_search_trials,12);a.stability_repeats=min(a.stability_repeats,3)
        a.lsa_components=min(a.lsa_components,48);a.local_embedding_components=min(a.local_embedding_components,32)
        a.max_word_features=min(a.max_word_features,35000);a.max_char_features=min(a.max_char_features,35000)
        a.local_max_vocab=min(a.local_max_vocab,3000);a.projection_sample=min(a.projection_sample,1500)
        a.metric_bootstrap_repeats=min(a.metric_bootstrap_repeats,15)
    return Config(
        input_path=a.input_path,outdir=a.outdir,mode=a.mode,model_dir=a.model_dir,profile=a.profile,
        seed=a.seed,sample_rows=a.sample_rows,test_size=a.test_size,
        validation_within_development=a.validation_within_development,split_trials=a.split_trials,
        stopword_seed_path=a.stopword_seed_path,relation_schema_path=a.relation_schema_path,
        lsa_components=a.lsa_components,topic_components=a.topic_components,
        max_word_features=a.max_word_features,max_char_features=a.max_char_features,
        word_weight=a.word_weight,char_weight=a.char_weight,signature_weight=a.signature_weight,
        lsa_weight=a.lsa_weight,topic_weight=a.topic_weight,
        local_embedding_components=a.local_embedding_components,local_embedding_weight=a.local_embedding_weight,
        local_context_window=a.local_context_window,local_min_df=a.local_min_df,local_max_vocab=a.local_max_vocab,
        sif_a=a.sif_a,template_df_ratio=a.template_df_ratio,model_search_trials=a.model_search_trials,
        stability_repeats=a.stability_repeats,representative_examples=a.representative_examples,
        top_cluster_terms=a.top_cluster_terms,projection_sample=a.projection_sample,heatmap_top_n=a.heatmap_top_n,
        centroid_quantile=a.centroid_quantile,centroid_min_similarity=a.centroid_min_similarity,
        centroid_margin=a.centroid_margin,selection_target_coverage=a.selection_target_coverage,
        business_min_coverage=a.business_min_coverage,business_max_outlier_rate=a.business_max_outlier_rate,
        business_max_largest_cluster_share=a.business_max_largest_cluster_share,
        business_min_clusters=a.business_min_clusters,
        business_min_problem_normalization_coverage=a.business_min_problem_normalization_coverage,
        business_max_low_confidence_entity_fraction=a.business_max_low_confidence_entity_fraction,
        business_entity_confidence_floor=a.business_entity_confidence_floor,
        analytics_min_validation_silhouette=a.analytics_min_validation_silhouette,
        analytics_min_validation_coherence=a.analytics_min_validation_coherence,
        metric_bootstrap_repeats=a.metric_bootstrap_repeats,entity_accept_confidence=a.entity_accept_confidence,
        entity_generic_accept_confidence=a.entity_generic_accept_confidence,relation_min_confidence=a.relation_min_confidence,
        analytics_min_signature_purity=a.analytics_min_signature_purity,analytics_min_relation_coverage=a.analytics_min_relation_coverage,
        analytics_min_relation_structure_purity=a.analytics_min_relation_structure_purity,
        analytics_min_grounded_relation_coverage=a.analytics_min_grounded_relation_coverage,
        analytics_min_evidence_reference_coverage=a.analytics_min_evidence_reference_coverage,
        analytics_max_entity_ambiguity_fraction=a.analytics_max_entity_ambiguity_fraction,
        analytics_min_context_partition_stability=a.analytics_min_context_partition_stability,
        human_validation_sample_size=a.human_validation_sample_size,
        persist_model=not a.no_persist_model,
        pseudonym_key_env=a.pseudonym_key_env,fail_on_business_readiness=a.fail_on_business_readiness,
    )

def main(argv=None):
    configure_logging()
    try:
        c=parse_args(argv);report=run_train(c) if c.mode=="train" else run_inference(c)
        if c.mode=="train" and c.fail_on_business_readiness and report.get("business_readiness_status")!="PASS":LOGGER.error("Business readiness gate failed.");return 2
        return 0
    except KeyboardInterrupt:LOGGER.error("Interrupted by user.");return 130
    except Exception as exc:LOGGER.exception("Pipeline failed: %s",exc);return 1

if __name__=="__main__":sys.exit(main())
