leaf_rows = steps[(steps.kind == "tool") & steps["leaves"].notna()]

for lab in labels_sorted:
    core = core_agents.get(lab)
    if not core:
        continue
    keys = conv.index[(conv[LABEL] == lab) & conv.has_steps].tolist()
    rows = leaf_rows[leaf_rows[KEY].isin(keys) & leaf_rows[ACTOR].isin(core)]
    leaf_docs = (rows.assign(doc=["\x1f".join(f"{s}.{t}" for t in l.split("\x1f") if t)
                                  for s, l in zip(rows["step"], rows["leaves"])])
                 .groupby(KEY)["doc"].agg("\x1f".join).reindex(keys).fillna(""))
    mats, names = [], []
    msg_vec = CountVectorizer(binary=True, stop_words=EN_STOP, min_df=MIN_SUPPORT, max_df=0.95,
                              token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z]+\b")
    leaf_vec = CountVectorizer(binary=True, lowercase=False, min_df=MIN_SUPPORT, max_df=0.95,
                               tokenizer=lambda s: [t for t in s.split("\x1f") if t], token_pattern=None)
    for vec, docs, prefix in ((msg_vec, conv.loc[keys, "input_message"], f"{CUSTOMER}:"), (leaf_vec, leaf_docs, "")):
        try:
            mats.append(vec.fit_transform(docs))
            names += [prefix + f for f in vec.get_feature_names_out()]
        except ValueError:
            pass
    if not mats:
        continue
    X = hstack(mats).tocsr()
    names = np.array(names)
    support = np.asarray(X.sum(0)).ravel()
    for F in sorted(set(f for k in keys for f in conv.at[k, "units"])):
        y = np.array([F in conv.at[k, "units"] for k in keys], dtype=int)
        if y.sum() < MIN_SUPPORT or (1 - y).sum() < MIN_SUPPORT:
            continue
        Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=TEST_SIZE, stratify=y, random_state=SEED)
        folds = min(FOLDS, int(ytr.sum()), int((1 - ytr).sum()))
        cv_scores = {}
        if folds >= 2:
            skf = StratifiedKFold(folds, shuffle=True, random_state=SEED)
            for C in C_GRID:
                aucs = [roc_auc_score(ytr[va], sparse_logit(C).fit(Xtr[tr], ytr[tr]).predict_proba(Xtr[va])[:, 1])
                        for tr, va in skf.split(Xtr, ytr)]
                cv_scores[C] = (float(np.mean(aucs)), float(np.std(aucs)))
        C = max(cv_scores, key=lambda c: cv_scores[c][0]) if cv_scores else 1.0
        p = sparse_logit(C).fit(Xtr, ytr).predict_proba(Xte)[:, 1]
        test_auc = roc_auc_score(yte, p)
        coef = sparse_logit(C).fit(X, y).coef_[0]
        pos_hits = np.asarray(X[y == 1].sum(0)).ravel()
        lift = np.divide(pos_hits / y.sum(), support / len(y), out=np.zeros_like(coef), where=support > 0)
        good = np.where((coef > 0) & (support >= MIN_SUPPORT) & (lift > 1))[0]
        good = good[np.argsort(-coef[good])]
        valid = test_auc >= TRIGGER_MIN_AUC
        trigger_rows.append({LABEL: lab, "family": F, "conversations_with": int(y.sum()),
                             "conversations_without": int((1 - y).sum()), "C": C, "folds": folds,
                             "cv_auc_mean": round(cv_scores.get(C, (np.nan, np.nan))[0], 4),
                             "cv_auc_std": round(cv_scores.get(C, (np.nan, np.nan))[1], 4),
                             "test_auc": round(test_auc, 4),
                             "test_balanced_accuracy": round(balanced_accuracy_score(yte, p >= 0.5), 4),
                             "test_f1": round(f1_score(yte, p >= 0.5), 4),
                             "evidence": ", ".join(names[good[:TOP_TRIGGERS]]) if valid else ""})
        trigger_feats += [{LABEL: lab, "family": F, "feature": names[i], "coef": round(coef[i], 4),
                           "conversations": int(support[i]), "with_family": int(pos_hits[i]), "lift": round(lift[i], 3)}
                          for i in good]
        if valid and len(good):
            sub = X[:, good]
            for r, k in enumerate(keys):
                if y[r] and sub[r].nnz:
                    conv_evidence[k][F] = ", ".join(names[good[sub[r].indices[:3]]])

