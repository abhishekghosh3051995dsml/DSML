def compact(seq):
    owners, counts, first = [], defaultdict(Counter), defaultdict(list)
    for o, s in seq:
        if o not in counts:
            owners.append(o)
        if s not in counts[o]:
            first[o].append(s)
        counts[o][s] += 1
    out = []
    for o in owners:
        items = ", ".join(f"{s} ×{counts[o][s]}" if counts[o][s] > 1 else s for s in first[o])
        out.append(f"{o}: {items}" if o else items)
    return " → ".join(out)


