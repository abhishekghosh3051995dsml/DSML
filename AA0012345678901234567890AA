    groups += [("Unknown", ["Unknown"])] if (action[keys] == "Unknown").any() else []
    for i, (name, members) in enumerate(groups, next_id):
        cid = f"{lab.upper()}-{i}"
        sel = [k for k in keys if action[k] in members]
        conv.loc[sel, ["class_id", "class", "main"]] = [cid, name, name]
        conv.loc[sel, "subclass"] = request[sel].values
        j = 0
        for sub, cnt in conv.loc[sel, "subclass"].value_counts().items():
            ok = cnt >= MIN_SUPPORT and sub != "Unknown"
            sid = f"{cid}{letters(j)}" if ok else f"{cid}X"
            j += ok
            conv.loc[[k for k in sel if conv.at[k, "subclass"] == sub], "subclass_id"] = sid
        common_flow = conv.loc[sel, "flow"].value_counts().index[0]
        class_paths[cid] = ([("", common_flow)] if common_flow else [], set())
        class_rows.append({LABEL: lab, "class_id": cid, "class": name, "conversations": len(sel),
                           "kind": "messages", "mixed": len(members) > 1})
    print(f"{lab}: conversations without steps {len(keys)}  classes {len(groups)}")

