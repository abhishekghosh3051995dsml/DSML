def pattern_vectorizer():
    return TfidfVectorizer(stop_words=EN_STOP, ngram_range=(1, 2), min_df=MIN_SUPPORT, max_df=0.9,
                           sublinear_tf=True, token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z]+\b")


def top_terms(weights, terms, n=3):
    picked, used = [], set()
    for i in np.argsort(weights)[::-1]:
        if weights[i] <= 0:
            break
        words = set(terms[i].split())
        if not words <= used:
            picked.append(terms[i])
            used |= words
        if len(picked) == n:
            break
    return " / ".join(picked)


def stable_patterns(docs):
    labels = np.full(len(docs), -1)
    names, scan, detail = {}, [], []
    vec = pattern_vectorizer()
    try:
        X = vec.fit_transform(docs)
    except ValueError:
        return labels, names, scan, detail
    terms = vec.get_feature_names_out()
    live = np.where(np.asarray(X.sum(1)).ravel() > 0)[0]
    Xr = X[live]
    k_max = min(TEXT_K_MAX, len(live) // 10, Xr.shape[1] - 1)
    if len(live) < TEXT_MIN_DOCS or k_max < 2:
        return labels, names, scan, detail
    rng = np.random.default_rng(SEED)
    warnings.filterwarnings("ignore", category=RuntimeWarning, module="sklearn")
    warnings.filterwarnings("ignore", category=ConvergenceWarning)
    best = None
    for k in range(2, k_max + 1):
        model = NMF(k, init="nndsvda", random_state=SEED, max_iter=NMF_ITER).fit(Xr)
        W = model.transform(Xr)
        ref = np.where(W.sum(1) > 0, W.argmax(1), -1)
        jac = defaultdict(list)
        for _ in range(BOOTSTRAPS):
            draw = rng.integers(0, len(live), len(live))
            idx = np.unique(draw)
            mb = NMF(k, init="nndsvda", random_state=SEED, max_iter=NMF_ITER).fit(Xr[draw])
            Wb = mb.transform(Xr[idx])
            lb = np.where(Wb.sum(1) > 0, Wb.argmax(1), -1)
            r = ref[idx]
            boot = [set(np.where(lb == d)[0]) for d in range(k)]
            for c in range(k):
                A = set(np.where(r == c)[0])
                if A:
                    jac[c].append(max(len(A & B) / len(A | B) for B in boot))
        stab = {c: float(np.mean(v)) for c, v in jac.items()}
        kept = [c for c in range(k) if stab.get(c, 0) >= STABLE_JACCARD]
        covered = int(np.isin(ref, kept).sum())
        scan.append({"k": k, "patterns_kept": len(kept), "conversations_covered": covered})
        if best is None or (covered, len(kept)) >= (best[0], len(best[5])):
            best = (covered, k, model, ref, stab, kept)
    covered, k, model, ref, stab, kept = best
    for s in scan:
        s["chosen"] = s["k"] == k
    labels[live] = [kept.index(c) if c in kept else -1 for c in ref]
    for c in range(k):
        name = top_terms(model.components_[c], terms)
        if c in kept:
            names[kept.index(c)] = name
        if not (ref == c).any():
            continue
        detail.append({"k": k, "pattern": name, "conversations": int((ref == c).sum()),
                       "bootstrap_jaccard": round(stab.get(c, np.nan), 4), "kept": c in kept})
    return labels, names, scan, detail


def phrase_sets(texts):
    words = texts.str.lower().str.findall(r"[a-z][a-z]+")
    return words.map(lambda w: set(w) | {f"{x} {y}" for x, y in zip(w, w[1:])})


def boilerplate(column):
    sets = phrase_sets(conv[column])
    shares = defaultdict(list)
    big = [lab for lab in labels_sorted if ((conv[LABEL] == lab) & conv[column].ne("")).sum() >= TEXT_MIN_DOCS]
    for lab in big:
