def parse_json(value):
    if not isinstance(value, str):
        return None
    value = value.strip()
    if not value or value[0] not in "{[":
        return None
    try:
        return json.loads(value)
    except ValueError:
        try:
            return ast.literal_eval(value)
        except (ValueError, SyntaxError, MemoryError, RecursionError):
            return None


def leaves(obj, keys=(), depth=0, max_depth=8):
    if isinstance(obj, dict):
        if depth < max_depth:
            for k, v in obj.items():
                yield from leaves(v, keys + (str(k),), depth + 1, max_depth)
    elif isinstance(obj, list):
        if depth < max_depth:
            for v in obj[:50]:
                yield from leaves(v, keys, depth + 1, max_depth)
    else:
        yield keys, obj


def dict_lists(obj, keys=(), depth=0):
    if depth > 3:
        return
    if isinstance(obj, list):
        if obj and all(isinstance(i, dict) for i in obj[:20]):
            yield keys, obj
    elif isinstance(obj, dict):
        for k, v in obj.items():
            yield from dict_lists(v, keys + (str(k),), depth + 1)


def dig(obj, keys):
    for k in keys:
        if not isinstance(obj, dict) or k not in obj:
            return None
        obj = obj[k]
    return obj


def to_epoch(v):
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        x = float(v)
        if 9.4e8 <= x <= 4.2e9:
            return x
        if 9.4e11 <= x <= 4.2e12:
            return x / 1000
        return None
    if isinstance(v, str) and 10 <= len(v) <= 40 and re.match(r"\d{4}-\d{2}-\d{2}", v):
        t = pd.to_datetime(v, errors="coerce", utc=True)
        return None if pd.isna(t) else t.timestamp()
    return None


def mask(text):
    text = EMAIL.sub("#", text)
    return DIGITS.sub(lambda m: "#" * len(m.group()), text)


def clean_instruction(text):
    text = MASKED_PAIR.sub("", mask(text))
    text = re.sub(r"#{2,}", "", text)
    return re.sub(r"\s{2,}", " ", text).strip(" ,;|")


def tokens(name):
    return {t for t in re.split(r"[^a-z0-9]+", re.sub(r"([a-z])([A-Z])", r"\1_\2", name).lower()) if t}


def collapse(items):
    out = []
    for item in items:
        if out and out[-1][0] == item:
            out[-1][1] += 1
        else:
            out.append([item, 1])
    return [f"{i} ×{n}" if n > 1 else i for i, n in out]


def grouped(pairs):
    out = []
    for owner, step in pairs:
        if out and out[-1][0] == owner:
            out[-1][1].append(step)
        else:
            out.append((owner, [step]))
    return " → ".join(f"{o}: {', '.join(collapse(s))}" if o else ", ".join(collapse(s)) for o, s in out)


def normal_threshold(shares):
    v = np.unique(np.round(np.asarray(shares, float), 6))[::-1]
    if len(v) < 2:
        return MAJORITY
    gaps = v[:-1] - v[1:]
    i = int(gaps.argmax())
    return max((v[i] + v[i + 1]) / 2, MAJORITY)


