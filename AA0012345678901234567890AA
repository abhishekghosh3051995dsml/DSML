def next_hits(train_seqs, test_seqs):
    dfg = defaultdict(Counter)
    for seq in train_seqs:
        for a, b in zip(seq, seq[1:]):
            dfg[a][b] += 1
    top1 = top3 = total = 0
    for seq in test_seqs:
        for a, b in zip(seq, seq[1:]):
            nxt = [x for x, _ in dfg[a].most_common(3)]
            total += 1
            top1 += bool(nxt) and nxt[0] == b
            top3 += b in nxt
    return (round(top1 / total, 4), round(top3 / total, 4)) if total else (np.nan, np.nan)


def tool_chain(k):
    return [x.split(" ×")[0] for x in collapse([s for _, s in conv.at[k, "seq"]])]


rng = np.random.default_rng(SEED)
val_rows = []
for lab in labels_sorted:
    keys = conv.index[(conv[LABEL] == lab) & conv.has_steps].tolist()
    if len(keys) < 2 * MIN_SUPPORT:
        continue
    cls = conv.loc[keys, "class_id"].astype(object)
    strata = cls.where(cls.map(cls.value_counts()) >= 2, "rare")
    if strata.value_counts().min() < 2:
        strata = None
    tr_keys, te_keys = train_test_split(keys, test_size=TEST_SIZE, random_state=SEED,
                                        stratify=None if strata is None else strata.tolist())
    for cid in cls.value_counts().index:
        tr = [k for k in tr_keys if cls[k] == cid]
        te = [k for k in te_keys if cls[k] == cid]
        all_k = cls.index[cls == cid].tolist()
        mixed = bool(classes.loc[classes.class_id == cid, "mixed"].iloc[0])
        row = {LABEL: lab, "class_id": cid, "mixed_group": mixed, "conversations": len(all_k), "train": len(tr), "test": len(te)}
        if mixed:
            val_rows.append(row)
            continue
        if tr and te:
            plan_set = normal_path(conv.loc[tr, "seq"].tolist())[1]
            prec, rec = [], []
            for k in te:
                actual = {s for _, s in conv.at[k, "seq"]}
                hit = len(plan_set & actual)
                prec.append(hit / len(plan_set) if plan_set else 0.0)
                rec.append(hit / len(actual) if actual else 0.0)
            P, R = float(np.mean(prec)), float(np.mean(rec))
            a1, a3 = next_hits([conv.at[k, "agents"] for k in tr], [conv.at[k, "agents"] for k in te])
            _, t3 = next_hits([tool_chain(k) for k in tr], [tool_chain(k) for k in te])
            row.update({"step_precision": round(P, 4), "step_recall": round(R, 4),
                        "step_f1": round(2 * P * R / (P + R), 4) if P + R else 0.0,
                        "next_agent_top1": a1, "next_agent_top3": a3, "next_tool_top3": t3})
        if len(all_k) >= MIN_SUPPORT:
            full_set = normal_path(conv.loc[all_k, "seq"].tolist())[1]
            jac = []
            for _ in range(BOOTSTRAPS):
                bs = normal_path([conv.at[all_k[i], "seq"] for i in rng.integers(0, len(all_k), len(all_k))])[1]
                jac.append(len(bs & full_set) / len(bs | full_set) if bs | full_set else 1.0)
            row["path_stability_jaccard"] = round(float(np.mean(jac)), 4)
        val_rows.append(row)
