def phase4(user, Xd, C, O, max_k, seed):
    log("\n=== PHASE 4  CLUSTERING ===")
    O.h("Phase 4 · K-means, heat maps, and what each cluster is")

    sample = Xd
    if len(Xd) > 8000:
        idx = np.random.RandomState(seed).choice(len(Xd), 8000, replace=False)
        sample = Xd[idx]
    scores = []
    best_k, best_s = None, -2
    hi = max(3, min(max_k, len(Xd) // 40))
    for k in range(2, hi + 1):
        km = KMeans(n_clusters=k, random_state=seed, n_init=4).fit(sample)
        try:
            s = silhouette_score(sample, km.labels_,
                                 sample_size=min(4000, len(sample)),
                                 random_state=seed)
        except Exception:
            continue
        scores.append({"k": k, "silhouette": round(float(s), 4)})
        if s > best_s:
            best_k, best_s = k, s
    SC = pd.DataFrame(scores)
    O.csv(SC, "p4_01_silhouette_by_k.csv")
    fig, ax = plt.subplots(figsize=(8, 3.2))
    ax.plot(SC["k"], SC["silhouette"], marker="o", color=PALETTE[0])
    if best_k:
        ax.axvline(best_k, color=PALETTE[1], linestyle="--", linewidth=1)
    ax.set_xlabel("number of clusters (k)")
    ax.set_ylabel("silhouette score")
    ax.set_title("k is chosen from the data, not assumed", loc="left",
                 fontweight="600")
    O.fig(fig, "Silhouette measures how well each message sits in its own cluster "
               "versus the next nearest one. The peak is the natural number of "
               "groups.")
    log(f"  k={best_k} chosen by silhouette ({best_s:.3f})")
    O.p(f"Best k = {best_k} (silhouette {best_s:.3f}). This answers 'how many "
        f"clusters — 5, 6 or more?' from the data rather than by choice.")

    km = KMeans(n_clusters=best_k, random_state=seed, n_init=10).fit(Xd)
    user["_cluster"] = km.labels_

    # name the clusters with c-TF-IDF
    v2 = TfidfVectorizer(max_features=30000, ngram_range=(1, 2), min_df=2,
                         max_df=0.7, stop_words="english", sublinear_tf=True)
    M = v2.fit_transform(user["_clean"])
    terms = np.array(v2.get_feature_names_out())
    rows = []
    for c in sorted(set(km.labels_)):
        m = (km.labels_ == c)
        inside = np.asarray(M[m].mean(axis=0)).ravel()
        outside = np.asarray(M[~m].mean(axis=0)).ravel()
        idx = (inside - outside).argsort()[::-1][:12]
        ex = user.loc[m, "_text"].head(2).tolist()
        rows.append({"cluster": int(c), "size": int(m.sum()),
                     "pct": round(100.0 * m.mean(), 2),
                     "top_terms": ", ".join(terms[idx]),
                     "example_1": str(ex[0])[:160] if ex else "",
                     "example_2": str(ex[1])[:160] if len(ex) > 1 else ""})
    CT = pd.DataFrame(rows).sort_values("size", ascending=False)
    O.csv(CT, "p4_02_cluster_terms.csv")
    O.h("What each cluster is about", 3)
    O.table(CT, max_rows=40)
    O.note("Cluster names come from c-TF-IDF: the words that make this cluster "
           "different from every other cluster, not simply its most common words. "
           "An SME reads this table and gives each cluster a name — that is the "
           "detailed intent layer.")

    lab_col = C.get("turn_label")
    if lab_col:
        y = user[lab_col].fillna("__unlabelled__").astype(str)
        ct = pd.crosstab(user["_cluster"], y)
        keep = ct.sum(axis=1).sort_values(ascending=False).head(40).index
        ct = ct.loc[keep]
        rn = ct.div(ct.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
        O.h("Cluster × intent heat map", 3)
        O.fig(heat(rn.values, list(ct.columns), [f"cluster {i}" for i in ct.index],
                   "Cluster (rows) × intent (columns), row-normalised",
                   "share of cluster", cmap="YlGnBu"),
              "Each row is one cluster. The colour shows what share of that "
              "cluster carries each intent.")
        O.csv(ct.reset_index(), "p4_03_cluster_x_intent.csv")

        pur = pd.DataFrame({"cluster": ct.index,
                            "size": ct.sum(axis=1).values,
                            "dominant_intent": rn.idxmax(axis=1).values,
                            "purity": rn.max(axis=1).round(3).values})
        pur["reads_as"] = np.where(
            pur["purity"] > 0.8, "clean — this cluster is one intent",
            np.where(pur["purity"] > 0.5,
                     "mixed — probably a sub-intent split",
                     "impure — the intent label does not describe this group"))
        O.csv(pur.sort_values("size", ascending=False), "p4_04_cluster_purity.csv")
        O.h("Cluster purity and balance", 3)
        O.table(pur.sort_values("size", ascending=False), max_rows=40)
        O.note("Purity is the share of a cluster held by its dominant intent. "
               "High purity confirms the label is meaningful for that group. A "
               "large impure cluster is exactly where the taxonomy is failing and "
               "where SME review pays back most.")

        sub = pur[(pur["purity"] > 0.6) & (pur["size"] >= 20)]
        grp = (sub.groupby("dominant_intent")
               .agg(n_clusters=("cluster", "size"), turns=("size", "sum"))
               .reset_index())
        grp = grp[grp["n_clusters"] > 1]
        if len(grp):
            O.h("Sub-intents discovered beneath the coarse label", 3)
            O.csv(grp, "p4_05_sub_intents.csv")
            O.table(grp)
            O.note("Where one intent splits into several clean clusters, the data "
                   "is saying that label is an umbrella over distinct customer "
                   "situations. Those are the detailed intents — discovered, not "
                   "invented.")
    O.csv(user[[c for c in [C["case"], C["turn"], lab_col, "_text", "_cluster"]
                if c]], "p4_06_turns_with_clusters.csv")
    return user


