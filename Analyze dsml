BOILER_MIN_NGRAM = 6


def find_boilerplate(texts, top_k=200):
    """Data-derived template detection: long n-grams whose document frequency
    sits far above the content curve. Cutoff is the knee, not a constant."""
    dfc, n_docs = Counter(), 0
    for t in texts:
        if not isinstance(t, str) or len(t) < 60:
            continue
        n_docs += 1
        toks = re.findall(r"[a-z0-9<>_]+", t.lower())
        seen = set()
        for k in (BOILER_MIN_NGRAM, 9, 12):
            for i in range(0, max(0, len(toks) - k + 1), 2):
                g = " ".join(toks[i:i + k])
                if g not in seen:
                    seen.add(g)
                    dfc[g] += 1
    if not n_docs:
        return [], pd.DataFrame()
    ser = (pd.Series(dfc).sort_values(ascending=False).head(4000)) / n_docs
    v = ser.values[:top_k]
    if len(v) < 5:
        return [], pd.DataFrame()
    knee = int(np.argmin(np.diff(np.log(v + 1e-9)))) + 1
    cutoff = max(float(v[min(knee, len(v) - 1)]), 0.02)
    cands = ser[ser >= cutoff]
    keep = []
    for g in sorted(cands.index, key=len, reverse=True):
        if not any(g in k for k in keep):
            keep.append(g)
    return keep, pd.DataFrame({"template": keep,
                               "doc_frequency": [round(float(ser[g]), 4) for g in keep],
                               "derived_cutoff": round(cutoff, 4)})


TELECOM_TERMS = {
    r"\bhsi\b": "home internet service", r"\bmsisdn\b": "mobile number",
    r"\bimei\b": "device identifier", r"\biccid\b": "sim identifier",
    r"\bban\b": "billing account", r"\bsoc\b": "service code",
    r"\bapn\b": "access point name", r"\bvolte\b": "voice over lte",
    r"\bcpe\b": "customer premises equipment", r"\besim\b": "embedded sim",
    r"\bsim\b": "sim card", r"\brca\b": "root cause analysis",
}


def phase2(df, C, O, masker):
    log("\n=== PHASE 2  CLEANING ===")
    O.h("Phase 2 · Cleaning, and how X is built")

    steps = [{"step": "1 mask PII",
              "detail": f"{sum(masker.counts.values()):,} spans replaced with "
                        f"salted surrogates: {dict(masker.counts)}"}]

    res = []
    for name, rx in RESIDUE:
        n = int(df["_text"].str.contains(rx).sum())
        res.append({"check": name, "rows_with_residue": n,
                    "status": "PASS" if n == 0 else "REVIEW"})
    RES = pd.DataFrame(res)
    O.csv(RES, "p2_01_pii_residue_check.csv")
    if (RES["status"] == "REVIEW").any():
        O.warn("PII residue detected — inspect p2_01_pii_residue_check.csv before "
               "sharing any output from this run.")

    # X = user turns only
    if C["role"]:
        user = df[df["_role"] == "user"].copy()
        steps.append({"step": "2 keep user turns only",
                      "detail": f"{len(user):,} of {len(df):,} rows kept. Assistant "
                                f"turns removed from X — they contain the answer."})
    else:
        user = df.copy()
        steps.append({"step": "2 keep user turns only",
                      "detail": "no role column found; all rows kept"})

    # boilerplate
    tmpl, TM = find_boilerplate(user["_text"].str.lower().tolist())
    clean = user["_text"].str.lower()
    for g in tmpl:
        clean = clean.str.replace(re.escape(g), " ", regex=True)
    for pat, rep_ in TELECOM_TERMS.items():
        clean = clean.str.replace(pat, rep_, regex=True)
    clean = clean.str.replace(r"\s+", " ", regex=True).str.strip()
    user["_clean"] = clean
    if len(TM):
        O.csv(TM, "p2_02_detected_boilerplate.csv")
    steps.append({"step": "3 strip boilerplate",
                  "detail": f"{len(tmpl)} repeated templates removed; cutoff "
                            f"derived from the frequency curve, not chosen"})
    steps.append({"step": "4 expand telecom abbreviations",
                  "detail": f"{len(TELECOM_TERMS)} domain terms normalised"})

    before = len(user)
    user = user[user["_clean"].str.len() >= 3]
    steps.append({"step": "5 drop empty after cleaning",
                  "detail": f"{before - len(user):,} rows dropped"})

    dup = int(user["_clean"].duplicated().sum())
    steps.append({"step": "6 duplicate check",
                  "detail": f"{dup:,} rows share cleaned text with another row "
                            f"({100.0 * dup / max(len(user), 1):.1f}%). Kept for "
                            f"analysis; must be collapsed before any train/test "
                            f"split or the score is inflated."})

    S = pd.DataFrame(steps)
    O.csv(S, "p2_03_cleaning_steps.csv")
    O.table(S)
    O.note("X is now the cleaned text of user turns only. y_turn is the turn "
           "label on those same rows. Assistant turns are excluded by design.")
    O.csv(user[[c for c in [C["case"], C["turn"], C["turn_label"], C["conv_label"],
                            "_text", "_clean"] if c]].head(2000),
          "p2_04_cleaned_sample.csv")
    return user


