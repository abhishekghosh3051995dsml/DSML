def phase1(df, C, O):
    log("\n=== PHASE 1  DATA ANALYSIS ===")
    O.h("Phase 1 · Data analysis")

    # ---- 1.1 column inventory
    log("  1.1 column inventory")
    inv = []
    rev = {v: k for k, v in C.items() if v}
    for col in df.columns:
        s = df[col].dropna().astype(str)
        s = s[s.str.strip() != ""]
        inv.append({"column": col, "role": rev.get(col, ""),
                    "fill_pct": round(100.0 * len(s) / len(df), 2),
                    "distinct": int(s.nunique()),
                    "median_len": int(s.str.len().median()) if len(s) else 0,
                    "max_len": int(s.str.len().max()) if len(s) else 0,
                    "sample": (s.iloc[0][:120] if len(s) else "")})
    INV = pd.DataFrame(inv)
    O.csv(INV, "p1_01_column_inventory.csv")
    O.h("1.1 What is in each column", 3)
    O.table(INV, max_rows=40)
    missing = [k for k, v in C.items() if not v]
    if missing:
        O.warn(f"These roles were not found: {', '.join(missing)}. "
               f"Sections that need them are skipped.")

    # ---- 1.2 structure
    log("  1.2 structure and grain")
    O.h("1.2 Structure: what is one row?", 3)
    facts = [{"metric": "rows (turns)", "value": len(df)}]
    if C["case"]:
        facts.append({"metric": "distinct cases", "value": int(df[C["case"]].nunique())})
    if C["cid"]:
        facts.append({"metric": "distinct conversation ids",
                      "value": int(df[C["cid"]].nunique())})
    per_case = None
    if C["case"]:
        vc = df[C["case"]].value_counts()
        facts += [{"metric": "turns per case (mean)", "value": round(vc.mean(), 2)},
                  {"metric": "turns per case (max)", "value": int(vc.max())}]
        per_case = vc.value_counts().sort_index().rename_axis("turns_in_case") \
                     .reset_index(name="cases")
    F = pd.DataFrame(facts)
    O.csv(F, "p1_02_structure_facts.csv")
    O.table(F)

    # key agreement
    if C["case"] and C["cid"]:
        a = df.groupby(C["cid"])[C["case"]].nunique()
        b = df.groupby(C["case"])[C["cid"]].nunique()
        if int((a > 1).sum()) or int((b > 1).sum()):
            O.warn(f"{int((a > 1).sum())} conversation ids span several cases and "
                   f"{int((b > 1).sum())} cases span several conversation ids. The "
                   f"two keys disagree — the flattening is not a clean one-to-one "
                   f"expansion. Resolve before quoting per-conversation figures.")
        else:
            O.p("Case id and conversation id agree exactly — one case is one "
                "conversation.")

    if per_case is not None:
        fig, ax = plt.subplots(figsize=(8.5, 3.2))
        ax.bar(per_case["turns_in_case"].astype(str), per_case["cases"],
               color=PALETTE[2])
        ax.set_yscale("log")
        ax.set_xlabel("turns in the case")
        ax.set_ylabel("cases")
        ax.set_title("Turns per case", loc="left", fontweight="600")
        O.fig(fig, "Multi-turn cases are why one case can hold more than one intent.")
        O.csv(per_case, "p1_03_turns_per_case.csv")

    # ---- 1.3 roles
    if C["role"]:
        log("  1.3 roles and conversation shape")
        O.h("1.3 Who is speaking", 3)
        rc = df["_role"].value_counts()
        O.fig(barh(rc.index.tolist(), rc.values, "turns", "Turns by role"))
        if C["case"]:
            shape = (df.sort_values([C["case"], "_turn"]).groupby(C["case"])["_role"]
                     .apply(lambda x: ",".join("U" if r == "user" else
                                               "A" if r == "assistant" else "?"
                                               for r in x)))
            sh = (shape.value_counts().head(20).rename_axis("shape")
                  .reset_index(name="cases"))
            sh["pct"] = (100.0 * sh["cases"] / len(shape)).round(2)
            O.csv(sh, "p1_04_conversation_shapes.csv")
            O.table(sh)
            runs = shape.str.contains("A,A")
            O.p(f"{int(runs.sum()):,} cases ({100.0 * runs.mean():.1f}%) contain "
                f"consecutive system turns. The dialogue is not a strict "
                f"customer/system alternation, so turn-index parity cannot be used "
                f"to infer who is speaking.")
            firsts = (df.sort_values([C["case"], "_turn"]).groupby(C["case"])["_role"]
                      .first().value_counts())
            O.table(firsts.rename_axis("role_of_first_turn").reset_index(name="cases"))
            if len(firsts) > 1:
                O.warn("Turn 0 is not always the customer. A rule assuming "
                       "'index 0 = user' would mislabel those cases.")

    # ---- 1.4 labels
    log("  1.4 labels")
    O.h("1.4 The two label columns", 3)
    cov = []
    for key, nice in [("turn_label", "turn label"),
                      ("conv_label", "case label"),
                      ("predicted", "predicted (output slot)")]:
        col = C.get(key)
        if not col:
            continue
        v = df[col].fillna("").astype(str).str.strip()
        for role, g in df.assign(_v=v).groupby("_role"):
