def phase5(user, C, O):
    log("\n=== PHASE 5  TURN -> GLOBAL INTENT ===")
    O.h("Phase 5 · From turn intent to conversation intent")
    lab, case, conv = C.get("turn_label"), C.get("case"), C.get("conv_label")
    if not (lab and case):
        O.warn("Needs both a turn label and a case key. Skipped.")
        return

    u = user[user[lab].fillna("").astype(str).str.strip() != ""].copy()
    u = u.sort_values([case, "_turn"])
    seqs, verdicts = [], []
    for _, g in u.groupby(case):
        seqs.append(list(g[lab].astype(str)))
        if conv:
            v = g[conv].dropna().astype(str)
            verdicts.append(v.iloc[0] if len(v) else None)
        else:
            verdicts.append(None)

    labs = sorted({x for s in seqs for x in s})
    M = np.zeros((len(labs), len(labs)))
    li = {l: i for i, l in enumerate(labs)}
    for s in seqs:
        for a, b in zip(s, s[1:]):
            M[li[a], li[b]] += 1
    rs = M.sum(axis=1, keepdims=True)
    P = np.divide(M, rs, out=np.zeros_like(M), where=rs > 0)
    O.h("How intent moves through a conversation", 3)
    O.fig(heat(P, labs, labs, "Intent at turn t (rows) → turn t+1 (columns)",
               "probability", cmap="Blues"),
          "Read a row as: given what the customer wants now, what do they ask next?")
    O.csv(pd.DataFrame(M, index=labs, columns=labs).reset_index()
          .rename(columns={"index": "from\\to"}), "p5_01_transition_counts.csv")

    multi = [s for s in seqs if len(s) > 1]
    changed = [s for s in multi if len(set(s)) > 1]
    O.p(f"{len(seqs):,} conversations have at least one labelled user turn. "
        f"{len(multi):,} have more than one. Of those, {len(changed):,} "
        f"({100.0 * len(changed) / max(len(multi), 1):.1f}%) change intent "
        f"during the conversation.")
    if changed:
        J = pd.DataFrame(Counter(" → ".join(s) for s in changed).most_common(20),
                         columns=["journey", "conversations"])
        O.csv(J, "p5_02_intent_journeys.csv")
        O.h("Most common intent journeys", 3)
        O.table(J)
        O.note("This is the concrete evidence that a customer can open in query "
               "mode and end in RCA mode. A single label per conversation cannot "
               "represent that.")

    if conv and any(v is not None for v in verdicts):
        pairs = [(s, v) for s, v in zip(seqs, verdicts) if v is not None]
        cnt = Counter()
        for s, _ in pairs:
            cnt.update(s)
        rarity = {k: i for i, (k, _) in enumerate(sorted(cnt.items(),
                                                         key=lambda kv: kv[1]))}
        rules = {
            "first_turn": lambda s: s[0],
            "last_turn": lambda s: s[-1],
            "majority_vote": lambda s: Counter(s).most_common(1)[0][0],
            "rarest_class_wins": lambda s: min(s, key=lambda x: rarity.get(x, 1e9)),
        }
        rows = []
        for name, fn in rules.items():
            ok = [fn(s) == v for s, v in pairs]
            rows.append({"rule": name, "conversations": len(ok),
                         "agreement_pct": round(100.0 * np.mean(ok), 2)})
        RU = pd.DataFrame(rows).sort_values("agreement_pct", ascending=False)
        O.csv(RU, "p5_03_global_intent_rules.csv")
        O.h("Is the conversation label just a rule over the turns?", 3)
        O.fig(barh(RU["rule"].tolist(), RU["agreement_pct"].values,
                   "% agreement with the case label",
                   "Do simple rules reproduce the conversation verdict?",
                   color=PALETTE[2]))
        O.table(RU)
        best = RU.iloc[0]
        if best["agreement_pct"] >= 95:
            O.note(f"'{best['rule']}' reproduces the conversation label "
                   f"{best['agreement_pct']}% of the time. Global intent is that "
                   f"rule applied to the turn labels — so we implement the rule "
                   f"and do NOT train a second model. One turn-level model does "
                   f"the whole job.")
        else:
            O.warn(f"No simple rule explains the conversation label (best: "
                   f"'{best['rule']}' at {best['agreement_pct']}%). Global intent "
                   f"is a genuine second task and needs its own model over the "
                   f"turn sequence.")


# =============================================================================
# PHASE 6 - TWO LABEL SETS
# =============================================================================

def build_rules(texts, labels, min_z=2.5, top_n=40):
    KW = weighted_log_odds(texts, labels, top_n=top_n)
    if KW.empty:
        return {}
    KW = KW[KW["z_score"] >= min_z]
    r = defaultdict(dict)
    for _, x in KW.iterrows():
        r[x["class"]][x["keyword"]] = float(x["z_score"])
    return dict(r)


def apply_rules(texts, rules):
    classes = sorted(rules.keys())
    preds, confs = [], []
    for t in texts:
        toks = set(re.findall(r"[a-z][a-z_\-]{2,}", str(t).lower()))
        sc = {c: sum(w for k, w in rules[c].items() if k in toks) for c in classes}
        tot = sum(sc.values())
        if tot <= 0:
            preds.append(None); confs.append(0.0); continue
        rk = sorted(sc.items(), key=lambda kv: kv[1], reverse=True)
        top = rk[0][1]
        second = rk[1][1] if len(rk) > 1 else 0.0
        preds.append(rk[0][0])
        confs.append(round((top - second) / tot, 4))
    return preds, confs


def phase6(user, C, O, seed):
    log("\n=== PHASE 6  TWO LABEL SETS ===")
    O.h("Phase 6 · Two label sets, and whether they agree")
    lab = C.get("turn_label")
    if not lab:
        O.warn("No turn label column. Skipped.")
        return

    u = user[user[lab].fillna("").astype(str).str.strip() != ""].copy()
    texts = u["_clean"].tolist()
    y1 = u[lab].astype(str).values

    # out-of-fold so the comparison is a measurement, not a tautology
    pred = [None] * len(u)
    conf = [0.0] * len(u)
    vc = pd.Series(y1).value_counts()
    usable = vc[vc >= 5].index
    mask = np.array([v in usable for v in y1])
    idx = np.where(mask)[0]
    last_rules = {}
    if len(idx) >= 20:
        skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=seed)
        Xa = np.array(texts, dtype=object)[idx]
        ya = y1[idx]
        for tr, te in skf.split(Xa, ya):
            rules = build_rules(Xa[tr], ya[tr])
            if not rules:
                continue
            last_rules = rules
            p, c = apply_rules(Xa[te], rules)
            for j, kk in enumerate(te):
                pred[idx[kk]] = p[j]
                conf[idx[kk]] = c[j]

    u["_label_excel"] = y1
    u["_label_keyword"] = pred
    u["_confidence"] = conf

    if last_rules:
        RB = pd.DataFrame([{"class": c, "keyword": k, "weight": round(w, 3)}
                           for c, d in last_rules.items()
                           for k, w in sorted(d.items(), key=lambda kv: -kv[1])])
        O.csv(RB, "p6_01_keyword_rule_block.csv")
        O.h("The keyword rule block, learned from the data", 3)
        O.table(RB.groupby("class").head(12), max_rows=60)
        for i, cls in enumerate(sorted(last_rules)):
            d = sorted(last_rules[cls].items(), key=lambda kv: -kv[1])[:12]
            if d:
                O.fig(barh([k for k, _ in d], [w for _, w in d],
                           "z-score (higher = stronger indicator)",
                           f"Keywords indicating '{cls}'",
                           color=PALETTE[i % len(PALETTE)]))
        O.note("Learned with weighted log-odds under a Dirichlet prior, not raw "
               "counts. Fitted on one part of the data and scored on a part it "
               "never saw, so the agreement below is a real measurement rather "
               "than a restatement of the input.")

    covered = u["_label_keyword"].notna()
    O.p(f"The rule block reaches a decision on {int(covered.sum()):,} of "
        f"{len(u):,} labelled user turns ({100.0 * covered.mean():.1f}%). The "
        f"rest contain none of the learned keywords — an honest abstention "
        f"rather than a forced guess.")

    both = u[covered]
    if len(both):
        agree = float((both["_label_excel"] == both["_label_keyword"]).mean())
        kap = cohens_kappa(both["_label_excel"], both["_label_keyword"])
        K = pd.DataFrame([{"compared_rows": len(both),
                           "raw_agreement_pct": round(100 * agree, 2),
                           "cohens_kappa": kap,
                           "reads_as": ("almost perfect" if (kap or 0) > .8 else
                                        "substantial" if (kap or 0) > .6 else
                                        "moderate" if (kap or 0) > .4 else
                                        "fair" if (kap or 0) > .2 else "poor")}])
        O.csv(K, "p6_02_agreement.csv")
        O.h("Agreement between the two label sets", 3)
        O.table(K)
        O.note("Cohen's kappa corrects for the agreement two labellers would reach "
               "by chance. Raw agreement always looks good when one class "
               "dominates; kappa does not.")

        labs = sorted(set(both["_label_excel"]) | set(both["_label_keyword"]))
        CM = pd.crosstab(both["_label_excel"], both["_label_keyword"]) \
               .reindex(index=labs, columns=labs, fill_value=0)
        rn = CM.div(CM.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
        O.fig(heat(rn.values, labs, labs,
                   "Excel label (rows) vs keyword-derived label (columns)",
                   "share of row", cmap="Greens"),
              "The diagonal is agreement. Off-diagonal mass shows exactly which "
              "intents the two methods confuse.")
        O.csv(CM.reset_index(), "p6_03_label_confusion.csv")

        dis = both[both["_label_excel"] != both["_label_keyword"]]
        if len(dis):
            cols = [c for c in [C["case"], C["turn"], "_text", "_label_excel",
                                "_label_keyword", "_confidence"] if c]
            O.csv(dis[cols].head(800), "p6_04_disagreements_for_sme_review.csv")
            O.h("Where the two label sets disagree", 3)
            O.table(dis[["_text", "_label_excel", "_label_keyword",
                         "_confidence"]].head(25))
            O.note("This is the highest-value SME task in the project. Every row "
                   "is a case where two independent labelling methods reached "
                   "different conclusions — exactly where a human ruling settles "
                   "the taxonomy.")

        b = both.copy()
        b["_ok"] = (b["_label_excel"] == b["_label_keyword"])
        try:
            b["_bin"] = pd.qcut(b["_confidence"], 5, duplicates="drop")
            cal = (b.groupby("_bin", observed=True)
                   .agg(rows=("_ok", "size"), mean_confidence=("_confidence", "mean"),
                        agreement=("_ok", "mean")).reset_index())
            cal["_bin"] = cal["_bin"].astype(str)
            O.csv(cal.round(4), "p6_05_confidence_calibration.csv")
            fig, ax = plt.subplots(figsize=(7.5, 3.4))
            ax.plot(cal["mean_confidence"], cal["agreement"], marker="o",
                    color=PALETTE[1])
            ax.plot([0, 1], [0, 1], "--", color="#a0aec0", linewidth=1)
            ax.set_xlabel("confidence (margin between winner and runner-up)")
            ax.set_ylabel("agreement with the Excel label")
            ax.set_title("Is the confidence score meaningful?", loc="left",
                         fontweight="600")
            O.fig(fig, "A rising line means confidence carries real information. "
                       "The fixed per-class confidence in the source export does "
                       "not — it is the same number for every row of a class.")
        except Exception:
            pass

    O.csv(u[[c for c in [C["case"], C["turn"], "_text", "_label_excel",
                         "_label_keyword", "_confidence"] if c]],
          "p6_06_both_label_sets.csv")


# =============================================================================
# MAIN
# =============================================================================

def main():
    ap = argparse.ArgumentParser(
        description="NORA intent analysis - data analysis then data science")
    ap.add_argument("--input", required=True, help="flattened CSV")
    ap.add_argument("--outdir", default="nora_out")
    ap.add_argument("--salt-file", default="nora_salt.txt")
    ap.add_argument("--max-k", type=int, default=30)
    ap.add_argument("--sample", type=int, default=0)
    ap.add_argument("--seed", type=int, default=42)
    args = ap.parse_args()

    log("=" * 72)
    log("NORA INTENT ANALYSIS")
    log("=" * 72)
    log(f"reading {args.input}")
    df = pd.read_csv(args.input, low_memory=False, dtype=str,
                     keep_default_na=False,
                     na_values=["", "NA", "NaN", "null", "None", "nan"])
    log(f"  {len(df):,} rows x {len(df.columns)} columns")
    if args.sample and args.sample < len(df):
        df = df.sample(args.sample, random_state=args.seed).reset_index(drop=True)
        log(f"  sampled to {len(df):,} rows")

    C = discover_columns(df)
    log("  discovered columns:")
    for k, v in C.items():
        log(f"    {k:<12} -> {v}")

    if not C["text"]:
        raise SystemExit("BLOCKED: no message-content column found. "
                         "Check the header row of the CSV.")

    O = Out(args.outdir, "NORA Intent Analysis")
    O.p(f"Source: {os.path.basename(args.input)} — {len(df):,} rows, "
        f"{len(df.columns)} columns.")
    O.note("X is the text of user turns. y_turn is the per-turn label; y_global "
           "is the conversation label. Assistant turns are excluded from X "
           "because they contain the answer.")

    # normalise and mask before anything else
    salt = load_salt(args.salt_file)
    masker = Masker(salt)
    raw = (df[C["text"]].fillna("").astype(str)
           .str.replace(r"\\n|\\r|\\t", " ", regex=True)
           .str.replace(r"\s+", " ", regex=True).str.strip())
    df["_text"] = raw.map(masker.mask)
    log(f"  masked {sum(masker.counts.values()):,} PII spans "
        f"{dict(masker.counts)}")

    df["_role"] = (df[C["role"]].fillna("unknown").astype(str).str.strip().str.lower()
                   if C["role"] else "unknown")
    df["_turn"] = (pd.to_numeric(df[C["turn"]], errors="coerce")
                   if C["turn"] else np.arange(len(df)))

    df = phase1(df, C, O)
    user = phase2(df, C, O, masker)
    Xs, Xd, vec = phase3(user, C, O, args.seed)
    user = phase4(user, Xd, C, O, args.max_k, args.seed)
    phase5(user, C, O)
    phase6(user, C, O, args.seed)

    html = os.path.join(args.outdir, "nora_report.html")
    O.save(html)
    log("\n" + "=" * 72)
    log("DONE")
    log("=" * 72)
    log(f"  report : {os.path.abspath(html)}")
    log(f"  tables : {os.path.abspath(args.outdir)}")
    log(f"  salt   : {os.path.abspath(args.salt_file)}  (keep out of OneDrive)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
