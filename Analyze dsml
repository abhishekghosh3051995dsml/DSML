def find(cols, patterns, exclude=()):
    for pat in patterns:
        for c in cols:
            n = re.sub(r"[^a-z0-9]+", "_", str(c).lower())
            if any(re.search(e, n) for e in exclude):
                continue
            if re.search(pat, n):
                return c
    return None


def discover_columns(df):
    c = list(df.columns)
    return {
        "case":       find(c, [r"^source_row$", r"source.*row", r"^row$"]),
        "turn":       find(c, [r"message_index", r"turn.*index", r"^index$"]),
        "conv_label": find(c, [r"classification.*intent", r"case.*intent"]),
        "cid":        find(c, [r"data_cid$", r"(^|_)cid$", r"conversation.*id"]),
        "text":       find(c, [r"data_content$", r"content$", r"message.*text"]),
        "predicted":  find(c, [r"intent_predicted", r"predicted"]),
        "turn_label": find(c, [r"data_label$", r"(^|_)label$"],
                           exclude=[r"predicted"]),
        "role":       find(c, [r"^message_type$", r"message_type$", r"data_type$"]),
    }


# =============================================================================
# 2. PII MASKING
# =============================================================================
# Salted HMAC surrogates. The same real value always becomes the same code, so
# entity counting still works, but the raw identifier never reaches a chart, a
# CSV or a model. Ordered most specific first: a 15-digit IMEI must be caught
# before the generic phone-number rule can eat it.

PII_PATTERNS = [
    ("EMAIL",  re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b")),
    ("IPV4",   re.compile(r"\b(?:(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\.){3}"
                          r"(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\b")),
    ("EID",    re.compile(r"\b[0-9a-f]{32}\b", re.IGNORECASE)),
    ("ICCID",  re.compile(r"\b89\d{17,20}\b")),
    ("IMEI",   re.compile(r"\b\d{15,16}\b")),
    ("BAN",    re.compile(r"(?i)\b(?:BAN|account\s*(?:number|#)?)\s*[:#]?\s*(\d{8,12})\b")),
    ("MSISDN", re.compile(r"(?<!\d)(?:\+?1[\s\-.]?)?\(?\d{3}\)?[\s\-.]?\d{3}[\s\-.]?\d{4}(?!\d)")),
    ("LATLON", re.compile(r"(?<![\w.])-?\d{1,3}\.\d{4,}(?![\w.])")),
    ("ZIP",    re.compile(r"\b\d{5}(?:-\d{4})?\b")),
    ("URL",    re.compile(r"https?://\S+")),
]

NAME_FIELD_RE = re.compile(r"(?i)(customer\s*name|contact\s*name)\s*:\s*"
                           r"([A-Z][A-Za-z'\-]+(?:\s+[A-Z][A-Za-z'\-]+){0,3})")
ADDRESS_RE = re.compile(
    r"\b\d{1,6}\s+(?:[A-Za-z0-9.'\-]+\s+){0,4}"
    r"(?:st|street|rd|road|ave|avenue|blvd|boulevard|ln|lane|dr|drive|ct|court|"
    r"way|pl|place|ter|terrace|pkwy|parkway|hwy|highway|cir|circle)\b\.?",
    re.IGNORECASE)


class Masker:
    def __init__(self, salt):
        self.salt = salt
        self.counts = Counter()

    def _sur(self, kind, value):
        h = hmac.new(self.salt, f"{kind}|{value}".encode("utf-8", "ignore"),
                     hashlib.sha256).hexdigest()[:10]
        self.counts[kind] += 1
        return f"<{kind}_{h}>"

    def mask(self, text):
        if not isinstance(text, str) or not text:
            return text
        s = NAME_FIELD_RE.sub(
            lambda m: f"{m.group(1)}: {self._sur('NAME', m.group(2).lower())}", text)
        s = ADDRESS_RE.sub(lambda m: self._sur("ADDRESS", m.group(0).lower()), s)
        for kind, rx in PII_PATTERNS:
            def rep(m, kind=kind):
                g = m.group(1) if m.re.groups else m.group(0)
                return self._sur(kind, re.sub(r"\D", "", g) or g)
            s = rx.sub(rep, s)
        return s


def load_salt(path):
    if os.path.exists(path):
        with open(path) as f:
            v = f.read().strip()
        if v:
            return v.encode()
    v = secrets.token_hex(32)
    with open(path, "w") as f:
        f.write(v)
    log(f"    created salt file {path} — KEEP THIS OUT OF ONEDRIVE AND GIT")
    return v.encode()


