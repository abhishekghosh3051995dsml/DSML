def cramers_v(a, b):
    """Association between two categorical columns, 0 to 1, bias-corrected."""
    ct = pd.crosstab(a, b)
    if ct.shape[0] < 2 or ct.shape[1] < 2:
        return np.nan
    chi2 = chi2_contingency(ct, correction=False)[0]
    n = ct.values.sum()
    phi2 = chi2 / n
    r, k = ct.shape
    phi2c = max(0.0, phi2 - (k - 1) * (r - 1) / (n - 1))
    rc = r - (r - 1) ** 2 / (n - 1)
    kc = k - (k - 1) ** 2 / (n - 1)
    d = min(kc - 1, rc - 1)
    return float(np.sqrt(phi2c / d)) if d > 0 else np.nan


def theils_u(x, y):
    """U(x|y): how much of x's uncertainty y removes. Asymmetric, so it shows
    direction of dependence, which Cramer's V cannot."""
    px = pd.Series(x).value_counts(normalize=True)
    hx = float(-(px * np.log(px + 1e-12)).sum())
    if hx == 0:
        return 0.0
    d = pd.DataFrame({"x": x, "y": y})
    hxy = 0.0
    for _, g in d.groupby("y"):
        p = g["x"].value_counts(normalize=True)
        hxy += (len(g) / len(d)) * float(-(p * np.log(p + 1e-12)).sum())
    return float((hx - hxy) / hx)


def cohens_kappa(a, b):
    """Agreement corrected for what chance alone would produce."""
    a, b = pd.Series(a).astype(str), pd.Series(b).astype(str)
    m = a.notna() & b.notna()
    a, b = a[m], b[m]
    if len(a) == 0:
        return None
    po = float((a == b).mean())
    pa, pb = a.value_counts(normalize=True), b.value_counts(normalize=True)
    pe = float(sum(pa.get(k, 0) * pb.get(k, 0)
                   for k in set(pa.index) | set(pb.index)))
    return round((po - pe) / (1 - pe), 4) if pe < 1 else None


def weighted_log_odds(texts, labels, min_count=8, top_n=40):
    """
    Which words indicate which class, and how strongly.

    Weighted log-odds with an informative Dirichlet prior (Monroe, Colaresi &
    Quinn). Chosen over raw counts or plain PMI because both are dominated by
    rare words - a term seen 3 times in one class looks infinitely predictive.
    This shrinks rare terms toward zero and returns a z-score, so every keyword
    carries a confidence instead of an impression.
    """
    docs = pd.Series(texts).fillna("").astype(str).str.lower()
    y = pd.Series(labels).astype(str)
    tok = docs.str.findall(r"[a-z][a-z_\-]{2,}")
    total, per_class = Counter(), defaultdict(Counter)
    for t, lab in zip(tok, y):
        for w in set(t):
            total[w] += 1
            per_class[lab][w] += 1
    vocab = [w for w, n in total.items() if n >= min_count]
    if not vocab:
        return pd.DataFrame()
    a0 = sum(total[w] for w in vocab)
    rows = []
    for lab in per_class:
        ni = sum(per_class[lab][w] for w in vocab)
        nj = sum(total[w] - per_class[lab][w] for w in vocab)
        for w in vocab:
            yiw = per_class[lab][w]
            yjw = total[w] - yiw
            aw = total[w]
            num_i, num_j = yiw + aw, yjw + aw
            den_i, den_j = ni + a0 - num_i, nj + a0 - num_j
            if min(num_i, num_j, den_i, den_j) <= 0:
                continue
            delta = np.log(num_i / den_i) - np.log(num_j / den_j)
            z = delta / np.sqrt(1.0 / num_i + 1.0 / num_j)
            rows.append({"class": lab, "keyword": w, "doc_freq": total[w],
                         "in_class": yiw,
                         "pct_of_class": round(100.0 * yiw / max(ni, 1), 2),
                         "log_odds": round(float(delta), 4),
                         "z_score": round(float(z), 3)})
    out = pd.DataFrame(rows)
    if out.empty:
        return out
    out["strength"] = pd.cut(out["z_score"].abs(),
                             bins=[-np.inf, 1.96, 3.29, 5.0, np.inf],
                             labels=["not significant", "significant",
                                     "strong", "very strong"])
    return (out.sort_values(["class", "z_score"], ascending=[True, False])
            .groupby("class").head(top_n).reset_index(drop=True))


