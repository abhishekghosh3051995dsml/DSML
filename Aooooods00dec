                    break
        canon[(src, name)] = target
        if target != name:
            name_rows.append({"log table": src, "logged as": name, "same API as": target, "prefix in front": prefix})
PREFIXES = {r["prefix in front"] for r in name_rows if r["prefix in front"]}


def prefix_of(name):
