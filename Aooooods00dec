def parse_json(value):
    if not isinstance(value, str) or value.strip()[:1] not in ("[", "{"):
        return None
    for loader in (json.loads, ast.literal_eval):
        try:
            return loader(value)
        except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
            continue
    return None


def leaves(obj, prefix="", depth=0, out=None):
    out = {} if out is None else out
    if isinstance(obj, dict) and depth < 4:
        for k, v in obj.items():
            leaves(v, f"{prefix}.{k}" if prefix else str(k), depth + 1, out)
    elif not isinstance(obj, (dict, list)) and prefix:
        out[prefix] = obj
    return out


def get_path(doc, path):
    for part in path.split("."):
        if not isinstance(doc, dict) or part not in doc:
            return None
        doc = doc[part]
    return doc


def to_time(values, ceiling):
    s = values.astype(object) if isinstance(values, pd.Series) else pd.Series(list(values), dtype=object)
    full_index = s.index
    s = s[s.map(lambda v: v is not None and not isinstance(v, bool) and str(v).strip() != "")]
    if s.empty:
        return pd.Series(pd.NaT, index=full_index, dtype="datetime64[ns, UTC]")
    num = pd.to_numeric(s, errors="coerce")
    out = pd.Series(pd.NaT, index=s.index, dtype="datetime64[ns, UTC]")
    sec, ms = num.between(1e9, 1e10), num.between(1e12, 1e13)
    out[sec] = pd.to_datetime(num[sec], unit="s", utc=True)
    out[ms] = pd.to_datetime(num[ms], unit="ms", utc=True)
    text = num.isna() & s.map(lambda v: isinstance(v, str) and len(v) <= 40 and any(ch.isdigit() for ch in v))
    if text.any():
        out[text] = pd.to_datetime(s[text], errors="coerce", utc=True, format="mixed")
    out = out.where((out >= pd.Timestamp("2000-01-01", tz="UTC")) & (out <= ceiling))
    return out.reindex(full_index)


def bh(p):
    p = np.asarray(p, float)
    out = np.full(len(p), np.nan)
    ok = ~np.isnan(p)
    if ok.any():
        q = p[ok]
        order = np.argsort(q)
        adj = q[order] * len(q) / np.arange(1, len(q) + 1)
        adj = np.minimum.accumulate(adj[::-1])[::-1]
        res = np.empty_like(adj)
        res[order] = np.clip(adj, 0, 1)
        out[ok] = res
    return out


def pct(x):
    return f"{x:.0%}" if pd.notna(x) else "n/a"


