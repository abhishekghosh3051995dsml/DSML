drop, align_rows = [], []
for s in call_sources.index[1:]:
    a = calls[calls[SOURCE] == primary][[CASE, TOOL, "_k"]].reset_index().rename(columns={"index": "_ia"})
    b = calls[calls[SOURCE] == s][[CASE, TOOL, "_k"]].reset_index().rename(columns={"index": "_ib"})
    m = a.merge(b, on=[CASE, TOOL, "_k"])
