# %% Phase 6 - proof by counting: does each hand-off really lead to that specialist's work?

section("PHASE 6  Proof: what each hand-off leads to")
first_ho = ho.groupby([CASE, TOOL])["call_no"].min()
last_work = work.groupby([CASE, AGENT])["call_no"].max()
spec_rows = []
for t, a in HANDOFF.items():
    disp = set(ho.loc[ho[TOOL] == t, CASE])
    ran = set(work.loc[work[AGENT] == a, CASE])
    after = sum(1 for c in disp if last_work.get((c, a), -1) > first_ho[(c, t)])
    n_d, n_nd = len(disp), n - len(disp)
    both, without = len(disp & ran), len(ran - disp)
    if n_d and n_nd:
        odds, p = fisher_exact([[both, n_d - both], [without, n_nd - without]])
    else:
        odds, p = np.nan, np.nan
    own_calls = work[(work[AGENT] == a) & work[CASE].isin(disp)]
    spec_rows.append({"t": t, "a": a, "n_d": n_d, "n_nd": n_nd, "after": after, "without": without, "odds": odds, "p": p,
                      "apis": own_calls[TOOL].value_counts(), "calls": len(own_calls),
                      "err": (own_calls["outcome"] == "error").mean() if len(own_calls) else np.nan})
for r, q in zip(spec_rows, bh([r["p"] for r in spec_rows])):
    r["q"] = q
    r["after_s"] = r["after"] / r["n_d"] if r["n_d"] else np.nan
    r["without_s"] = r["without"] / r["n_nd"] if r["n_nd"] else np.nan
    if not r["n_nd"]:
        r["verdict"] = "Handed work in every interaction, so there is nothing to compare with"
    elif r["after_s"] > MAJORITY and r["without_s"] < r["after_s"] and r["q"] < ALPHA:
        r["verdict"] = "The hand-off drives the specialist's work"
    elif r["without_s"] >= MAJORITY:
        r["verdict"] = "The specialist works whether or not it is handed work"
    else:
        r["verdict"] = "No clear link"
SPECIALIST = {r["a"] for r in spec_rows if r["verdict"].startswith("The hand-off drives")}
calls["layer"] = np.select([is_ho, calls[AGENT].isin(SPECIALIST), calls[AGENT] == UNKNOWN_AGENT],
                           ["Hand-off", "Specialist", "Agent not recorded"], "Standard")
for r in spec_rows:
    r["layer"] = "Specialist" if r["a"] in SPECIALIST else "Standard"
    log.info(f"   {r['t']:<24} -> {r['a']:<24} handed work {r['n_d']:>5} · ran after {pct(r['after_s']):>4} · "
             f"ran without {pct(r['without_s']):>4}  {r['verdict']}")
