# %% Phase 8 - task plan: a dependency-aware DAG per class, learned from the order of steps in the traces

section("PHASE 8  Task plan (dependency DAG) of each class")
calls["task"] = calls[AGENT].astype(str) + " · " + calls[TOOL].astype(str)
FIRST = calls.groupby([CASE, "task"])["call_no"].min()
CASE_POS = {c: g.droplevel(0).to_dict() for c, g in FIRST.groupby(level=0, sort=False)}
TASK_LAYER = calls.groupby("task")["layer"].first()
TASK_SHARE = calls.groupby("task")[CASE].nunique() / n


def core_tasks(members, layers):
    m = len(members)
    pres = Counter(t for c in members for t in CASE_POS.get(c, {}) if TASK_LAYER.get(t) in layers)
    return sorted(t for t, k in pres.items() if k / m > MAJORITY)


def build_plan(members, tasks):
    k = len(tasks)
    if not k:
        return [], [], np.ones(len(members), bool), np.ones(len(members))
    P = np.full((len(members), k), np.inf)
    for i, c in enumerate(members):
        pos = CASE_POS.get(c, {})
        for j, t in enumerate(tasks):
            if t in pos:
                P[i, j] = pos[t]
    fin = np.isfinite(P)
    before = np.zeros((k, k))
    for a in range(k):
        both = fin[:, [a]] & fin
        before[a] = ((P[:, [a]] < P) & both).sum(0)
    pairs = [(a, b) for a in range(k) for b in range(k) if a != b and before[a, b] > before[b, a]]
    stats = []
    for a, b in pairs:
        ab, ba = before[a, b], before[b, a]
        stats.append((a, b, ab, ba, (ab - ba) / (ab + ba + 1), binomtest(int(ab), int(ab + ba), 0.5, alternative="greater").pvalue))
    qs = bh([s[5] for s in stats])
    kept = {(a, b): (ab, ba, d, q) for (a, b, ab, ba, d, _), q in zip(stats, qs) if d >= args.dependency and q < ALPHA}
    broken = []
    while True:
        indeg = {j: 0 for j in range(k)}
        for _, b in kept:
            indeg[b] += 1
        order, ready, seen = [], [j for j in range(k) if indeg[j] == 0], set()
        succ = {j: [b for a, b in kept if a == j] for j in range(k)}
        while ready:
            j = ready.pop()
            order.append(j)
            seen.add(j)
            for b in succ[j]:
                indeg[b] -= 1
                if indeg[b] == 0:
                    ready.append(b)
        if len(order) == k:
            break
        weakest = min((e for e in kept if e[0] not in seen and e[1] not in seen), key=lambda e: kept[e][2])
        broken.append((tasks[weakest[0]], tasks[weakest[1]]))
        kept.pop(weakest)
    reach = {j: set() for j in range(k)}
    for j in reversed(order):
        for a, b in kept:
            if a == j:
                reach[j] |= {b} | reach[b]
    reduced = {(a, b) for a, b in kept if not any(b in reach[x] for x in reach[a] if (a, x) in kept and x != b)}
    level = {}
    for j in order:
        level[j] = 1 + max((level[a] for a, b in reduced if b == j), default=0)
    stages = [[tasks[j] for j in sorted((j for j in range(k) if level[j] == s), key=lambda j: tasks[j])] for s in range(1, max(level.values()) + 1)]
    edges = [{"From task": tasks[a], "To task": tasks[b], "Traces with both": int(kept[(a, b)][0] + kept[(a, b)][1]),
              "From came first": int(kept[(a, b)][0]), "To came first": int(kept[(a, b)][1]),
              "Dependency (0-1)": round(float(kept[(a, b)][2]), 3), "p-value (corrected)": "below 1e-300" if kept[(a, b)][3] == 0 else float(f"{kept[(a, b)][3]:.3g}")}
             for a, b in sorted(reduced, key=lambda e: (level[e[0]], tasks[e[0]], tasks[e[1]]))]
    viol = np.zeros(len(members))
    seen_edges = np.zeros(len(members))
    for a, b in reduced:
        both = fin[:, a] & fin[:, b]
        seen_edges += both
        viol += both & (P[:, a] > P[:, b])
    follows = viol == 0
    respected = np.where(seen_edges > 0, 1 - viol / np.maximum(seen_edges, 1), 1.0)
    for a, b in broken:
        log.info(f"   cycle broken by dropping the weakest dependency {a} -> {b}")
    return stages, edges, follows, respected


def stage_text(stages):
    return "  →  ".join(f"[{i + 1}] " + "  ‖  ".join(s) for i, s in enumerate(stages)) or "none"


STD_TASKS = core_tasks(IDS, {"Standard"})
STD_STAGES, STD_EDGES, STD_FOLLOW, _ = build_plan(IDS, STD_TASKS)
overview("8. Task plan", "Standard layer plan (runs in every class)",
