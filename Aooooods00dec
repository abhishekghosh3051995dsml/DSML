    gap_s = pd.Series(calls.loc[m["_ia"], "_t"].values - calls.loc[m["_ib"], "_t"].values)
    gap_s = float(gap_s.dt.total_seconds().abs().median()) if len(m) else np.nan
    align_rows.append({"log table": s, "calls": len(b), "matched": len(m), "share": round(len(m) / max(len(b), 1), 4),
                       "identical input in matched pairs": round(same_input, 4), "median time apart (s)": gap_s})
    fill_in = pd.isna(ia) & pd.notna(ib)
