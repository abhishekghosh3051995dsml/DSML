per["api_calls"] = calls.groupby(CASE).size()
per["distinct_apis"] = calls.groupby(CASE)[TOOL].nunique()
per["steps"] = steps.groupby(CASE).size()
per["retries"] = calls.groupby(CASE)["retry"].sum().astype(int)
per["repeat_new_input"] = calls.groupby(CASE)["repeat_new_input"].sum().astype(int)
per["errors"] = calls[calls["outcome"] == "error"].groupby(CASE).size()
per = per.fillna({"errors": 0})
per["error_share"] = per["errors"] / per["api_calls"]
for label, c, meaning in (("Agents per interaction", "agents", "Different agents that ran at least one step"),
                          ("API calls per interaction", "api_calls", "Every call to an API or tool, retries included"),
                          ("Distinct APIs per interaction", "distinct_apis", "Different APIs or tools used"),
                          ("Retries per interaction", "retries", "Same API called again straight away with the identical input"),
