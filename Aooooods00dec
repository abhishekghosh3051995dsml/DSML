section("PHASE 3  Decomposition of every interaction")
calls = calls.reset_index(drop=True)
new_step = (calls[TOOL] != calls.groupby(CASE)[TOOL].shift()) | (calls[AGENT] != calls.groupby(CASE)[AGENT].shift())
calls["step_no"] = new_step.astype(int).groupby(calls[CASE]).cumsum()
steps = calls.groupby([CASE, "step_no"], sort=False).agg(agent=(AGENT, "first"), api=(TOOL, "first"), calls=(TOOL, "size"),
                                                        outcome=("outcome", "last")).reset_index()
same_step = (calls[CASE] == calls[CASE].shift()) & (calls["step_no"] == calls["step_no"].shift())
same_in = calls["_in"].fillna("\x00").eq(calls["_in"].shift().fillna("\x00"))
calls["retry"] = same_step & same_in
calls["repeat_new_input"] = same_step & ~same_in
IDS = calls[CASE].drop_duplicates().tolist()
n = len(IDS)
SEQ = steps.groupby(CASE, sort=False)["api"].agg(list).reindex(IDS).tolist()
STEP_LABEL = steps.assign(label=steps["agent"] + " · " + steps["api"]).groupby(CASE, sort=False)["label"].agg(list).reindex(IDS).tolist()
known = steps[steps["agent"] != UNKNOWN_AGENT]
AG_SEQ = known.groupby(CASE, sort=False)["agent"].agg(lambda s: [a for i, a in enumerate(s) if i == 0 or a != s.iloc[i - 1]]).reindex(IDS)
AG_SEQ = AG_SEQ.map(lambda x: x if isinstance(x, list) else []).tolist()

per = pd.DataFrame(index=pd.Index(IDS, name="interaction"))
if COL["cid"]:
    per["cid"] = calls.groupby(CASE)[COL["cid"]].first()
per["agents"] = [len(set(s)) for s in AG_SEQ]
