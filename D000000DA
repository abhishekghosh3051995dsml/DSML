# %% EDA - nested JSON columns

log.info("=" * 80)
log.info("6. EDA - nested JSON columns")
json_cols = [c for c in df.columns if kinds[c].startswith("json")]
js_rows, path_rows = [], []
for c in json_cols:
    p = parsed(c)
    ok = p.map(lambda x: isinstance(x, (list, dict)))
    lens = p.map(lambda x: len(x) if isinstance(x, (list, dict)) else np.nan).astype(float)
    hits, leaf_types, examples, depth = Counter(), defaultdict(Counter), {}, 0
    for obj in p[ok]:
        seen = set()
        for path, leaf in walk(obj):
            seen.add(path)
            leaf_types[path][type(leaf).__name__] += 1
            depth = max(depth, path.count(".") + path.count("[]"))
            if path not in examples and not is_empty(leaf):
                examples[path] = str(leaf)[:120]
        hits.update(seen)
    n_ok = int(ok.sum())
    js_rows.append({"column": c, "kind": kinds[c], "rows_with_value": int(df[c].notna().sum()), "parsed": n_ok,
                    "parse_failed": int(df[c].notna().sum()) - n_ok, "items_median": lens.median(), "items_max": lens.max(),
                    "distinct_key_paths": len(hits), "max_depth": depth, "paths_in_every_row": sum(1 for v in hits.values() if v == n_ok)})
    for path, h in hits.most_common(args.top_paths):
        path_rows.append({"column": c, "path": path or "(root)", "rows_with_path": h, "share_of_rows": round(h / n_ok, 3) if n_ok else np.nan,
                          "leaf_types": ", ".join(f"{k} {v}" for k, v in leaf_types[path].most_common()), "example": examples.get(path, "")})
json_struct = pd.DataFrame(js_rows)
json_paths = pd.DataFrame(path_rows, columns=["column", "path", "rows_with_path", "share_of_rows", "leaf_types", "example"])
