    dur = (t.groupby(grp).max() - t.groupby(grp).min()).dt.total_seconds()
    gp["duration_s"] = dur.round(1)
    metric(f"interaction duration from {TIME} (median / p90 / max s)", f"{dur.median():.0f} / {dur.quantile(0.9):.0f} / {dur.max():.0f}")
level_cols = [c for c in profile[(profile.level == "interaction") & profile.kind.isin(["categorical", "boolean"])].column if c != GROUP]
gp = gp.join(df.groupby(grp)[level_cols].first()) if level_cols else gp

# %% EDA - tool calls

log.info("=" * 80)
log.info("8. EDA - tool calls")
tool_summary = errors = input_keys = pd.DataFrame()
if TOOL:
    tr = df[df[TOOL].notna()].copy()
    tr["_group"] = grp.loc[tr.index]
    tr["outcome"] = [outcome(e, o) for e, o in zip(raw.loc[tr.index, ERR_COL] if ERR_COL else [None] * len(tr),
                                                  raw.loc[tr.index, OUT_COL] if OUT_COL else [None] * len(tr))]
    txt = (raw.loc[tr.index, ERR_COL].fillna("").astype(str) if ERR_COL else "") + " " + (raw.loc[tr.index, OUT_COL].fillna("").astype(str) if OUT_COL else "")
    tr["http_status"] = txt.str.extract(HTTP_STATUS, flags=re.I)[0]
    tr["signature"] = [signature(e if not is_empty(e) and str(e).strip() not in ("None", "") else o)
                       for e, o in zip(raw.loc[tr.index, ERR_COL] if ERR_COL else [None] * len(tr), raw.loc[tr.index, OUT_COL] if OUT_COL else [None] * len(tr))]
    metric("tool calls", len(tr))
    metric("distinct tools", tr[TOOL].nunique())
    oc = tr["outcome"].value_counts(normalize=True)
    metric("tool call outcomes", ", ".join(f"{k} {v:.0%}" for k, v in oc.items()))
    metric("HTTP status codes seen", {k: int(v) for k, v in tr["http_status"].value_counts().items()})
    if oc.get("failed", 0) >= 0.3:
        finding(f"{oc['failed']:.0%} of tool calls failed outright (API errors, unknown tools, invalid parameters).")

    g = tr.groupby(TOOL)
    tool_summary = pd.DataFrame({"calls": g.size(), "interactions": g["_group"].nunique()})
    tool_summary["share_of_interactions"] = (tool_summary.interactions / n_groups).round(3)
    tool_summary = tool_summary.join(pd.crosstab(tr[TOOL], tr["outcome"], normalize="index").round(3).add_suffix("_pct"))
    tool_summary["http_statuses"] = g["http_status"].agg(lambda s: ", ".join(f"{k} x{v}" for k, v in s.value_counts().items()))
    tool_summary["top_message"] = g["signature"].agg(lambda s: s.value_counts().index[0] if len(s) else "")
    tool_summary = tool_summary.sort_values("calls", ascending=False).rename_axis("tool").reset_index()
    show(tool_summary[["tool", "calls", "share_of_interactions"] + [c for c in tool_summary if c.endswith("_pct")]], "   tools", 40)
    always = tool_summary[tool_summary.share_of_interactions >= 0.8]
    if len(always):
        finding(f"{len(always)} tools run in 80%+ of interactions regardless of the case: {', '.join(always.tool[:10])}")
    never_ok = tool_summary[tool_summary.get("returned_pct", pd.Series(0, index=tool_summary.index)).fillna(0) == 0]
    if len(never_ok):
        finding(f"{len(never_ok)} tools never returned usable data in this sample: {', '.join(never_ok.tool[:10])}")

    bad = tr[tr.outcome.isin(["failed", "skipped", "empty"])]
    errors = bad.groupby(["outcome", "signature"]).agg(calls=(TOOL, "size"), interactions=("_group", "nunique"),
                                                      tools=(TOOL, lambda s: ", ".join(s.value_counts().index[:6])),
                                                      http_status=("http_status", lambda s: ", ".join(s.dropna().unique()[:4]))).reset_index()
    errors = errors.sort_values("calls", ascending=False)
    show(errors.head(15), "   most common failure / empty messages")

    rep = tr.assign(_in=raw.loc[tr.index, IN_COL].astype(str) if IN_COL else "").duplicated(["_group", TOOL, "_in"])
    gp = gp.join(tr.groupby("_group").agg(tool_calls=(TOOL, "size"), distinct_tools=(TOOL, "nunique"),
                                          tool_sequence=(TOOL, lambda s: " -> ".join(s.astype(str)))), how="left")
    gp = gp.join(pd.crosstab(tr["_group"], tr["outcome"]).add_prefix("tools_"), how="left")
    gp["repeated_calls"] = tr[rep].groupby("_group").size().reindex(gp.index).fillna(0).astype(int)
    if rep.sum():
        finding(f"{int(rep.sum())} tool calls repeat the same tool with the same input inside one interaction.")

    if IN_COL:
        ik = []
        for tool, s in parsed(IN_COL).loc[tr.index].groupby(tr[TOOL]):
            cnt, empt = Counter(), Counter()
            for d in s:
                for k, v in (d.items() if isinstance(d, dict) else []):
                    cnt[k] += 1
                    empt[k] += is_empty(v) or str(v).strip().lower() in ("none", "null", "nan")
            ik += [{"tool": tool, "input_key": k, "calls_with_key": n, "calls": len(s), "empty_value_pct": round(empt[k] / n, 3),
                    "example": next((str(d[k])[:80] for d in s if isinstance(d, dict) and not is_empty(d.get(k))), "")} for k, n in cnt.items()]
        input_keys = pd.DataFrame(ik)
        if len(input_keys):
            ek = input_keys[input_keys.empty_value_pct > 0]
            if len(ek):
                finding(f"{len(ek)} tool parameters are sometimes sent empty, e.g. {', '.join((ek.tool + '.' + ek.input_key).head(6))}")
gp = gp.rename_axis(GROUP or "row").reset_index()
show(gp.describe().T.round(1).reset_index(), "   interaction summary stats")

