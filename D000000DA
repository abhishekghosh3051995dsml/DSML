def parse_json(value, depth=0):
    if depth > 6:
        return value
    if isinstance(value, str):
        s = value.strip()
        if s[:1] in ("[", "{"):
            for loader in (json.loads, ast.literal_eval):
                try:
                    return parse_json(loader(s), depth + 1)
                except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
                    continue
        return value
    if isinstance(value, list):
        return [parse_json(v, depth + 1) for v in value]
    if isinstance(value, dict):
        return {k: parse_json(v, depth + 1) for k, v in value.items()}
    return value


PARSED = {}


def parsed(col):
    if col not in PARSED:
        PARSED[col] = df[col].map(parse_json)
    return PARSED[col]


def walk(obj, path=""):
    if isinstance(obj, dict):
        if not obj:
            yield path, obj
        for k, v in obj.items():
            yield from walk(v, f"{path}.{k}" if path else str(k))
    elif isinstance(obj, list):
        if not obj:
            yield path, obj
        for v in obj:
            yield from walk(v, f"{path}[]")
    else:
        yield path, obj


def is_empty(v):
    return v is None or (isinstance(v, (list, dict, str)) and len(v) == 0) or (isinstance(v, float) and np.isnan(v))


def to_datetime(s):
    try:
        return pd.to_datetime(s, errors="coerce", utc=True, format="mixed")
    except (TypeError, ValueError):
        return pd.to_datetime(s, errors="coerce", utc=True)


def fix_mojibake(v):
    if not isinstance(v, str) or not re.search(MOJIBAKE, v):
        return v
    try:
        return v.encode("cp1252").decode("utf-8")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return v


def infer_kind(s):
    s = s.dropna()
    if s.empty:
        return "empty"
    if pd.api.types.is_bool_dtype(s):
        return "boolean"
    if pd.api.types.is_numeric_dtype(s):
        return "boolean" if set(pd.unique(s)) <= {0, 1} else "numeric"
    txt = s.astype(str).str.strip()
    if txt.str[:1].isin(["[", "{"]).mean() >= 0.9:
        p = txt.head(200).map(parse_json)
        if p.map(lambda x: isinstance(x, (list, dict))).mean() >= 0.9:
            return "json_list" if p.map(lambda x: isinstance(x, list)).mean() >= 0.5 else "json_dict"
    if txt.str.lower().isin(["true", "false", "yes", "no"]).mean() >= 0.95:
        return "boolean"
    if pd.to_numeric(txt, errors="coerce").notna().mean() >= 0.95:
        return "numeric_text"
    if txt.str.contains(r"\d{4}-\d{2}-\d{2}|\d{1,2}/\d{1,2}/\d{2,4}").mean() >= 0.9 and to_datetime(txt).notna().mean() >= 0.9:
        return "datetime"
    nun, avg = txt.nunique(), txt.str.len().mean()
    if nun == 1:
        return "constant"
    if nun >= 0.95 * len(txt):
        return "free_text" if avg > 80 else "identifier"
    if nun <= max(20, 0.2 * len(txt)) and avg <= 80:
        return "categorical"
    return "free_text" if avg > 80 else "text"


def signature(text):
    t = str(text).lower()
    t = re.sub(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "<uuid>", t)
    t = re.sub(r"\b[0-9a-f]{12,}\b", "<hex>", t)
    t = re.sub(r"\d+", "#", t)
    return re.sub(r"\s+", " ", re.sub(r"[\"'{}\[\]]", "", t)).strip()[:110]


def outcome(err, out):
    e = "" if is_empty(err) else str(err)
    o = "" if is_empty(out) else str(out)
    text = f"{e} {o}"
    if re.search(FAILED, text, re.I):
        return "failed"
    if re.search(SKIPPED, text, re.I):
        return "skipped"
    if not e and re.search(EMPTY, o, re.I):
        return "empty"
    return "returned"


