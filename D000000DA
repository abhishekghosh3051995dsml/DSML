# %% Preparation - embedded record copies, keys, row grain

log.info("=" * 80)
log.info("3. PREPARATION - embedded documents, keys and what one row is")
envelope_rows, redundancy = [], []
for c in [c for c in df.columns if infer_kind(df[c]) == "json_dict"]:
    p = parsed(c)
    top = Counter(k for d in p if isinstance(d, dict) for k in d)
    overlap = [k for k in top if k in df.columns and k != c]
    if len(overlap) < 3:
        continue
    for k in overlap:
        a = p.map(lambda d: d.get(k) if isinstance(d, dict) else None).map(lambda v: None if is_empty(v) else str(v))
        b = df[k].map(lambda v: None if is_empty(v) else str(v))
        both = a.notna() & b.notna()
        redundancy.append({"json_column": c, "key": k, "rows_with_both": int(both.sum()),
                           "equal_share": round(float((a[both] == b[both]).mean()), 3) if both.any() else np.nan})
    new_keys = [k for k, n in top.items() if k not in df.columns and n >= 0.05 * len(df)]
    lifted = []
    for k in new_keys:
        vals = p.map(lambda d: d.get(k) if isinstance(d, dict) else None)
        vs = vals.map(lambda v: None if is_empty(v) else str(v))
        copies = [o for o in df.columns if (vs.notna() & (vs == df[o].astype(str))).sum() >= 0.99 * vs.notna().sum()]
        if copies:
            redundancy.append({"json_column": c, "key": k, "rows_with_both": int(vs.notna().sum()), "equal_share": 1.0, "copy_of": copies[0]})
            continue
        if vals.map(lambda v: isinstance(v, (str, int, float, bool)) or v is None).all():
            df[f"{c}.{k}"] = vals.map(lambda v: np.nan if is_empty(v) else v)
            envelope_rows.append({"json_column": c, "new_column": f"{c}.{k}", "rows": int(df[f'{c}.{k}'].notna().sum())})
            lifted.append(k)
    finding(f"'{c}' is a copy of the whole record: {len(overlap)} of its keys repeat existing columns; {len(lifted)} keys found only here, lifted out as columns ({', '.join(lifted[:8])}).")
redundancy = pd.DataFrame(redundancy, columns=["json_column", "key", "rows_with_both", "equal_share", "copy_of"])
