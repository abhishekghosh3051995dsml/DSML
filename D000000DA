def search_dirs():
    roots = [os.environ.get(k) for k in ("OneDriveCommercial", "OneDrive")]
    here = [Path.cwd()] + ([Path(__file__).resolve().parent] if "__file__" in globals() else [])
    dirs = here + [Path(r) / "Downloads" for r in roots if r] + [Path.home() / "Downloads"]
    return [d for d in dict.fromkeys(dirs) if d.is_dir()]


def locate():
    if args.file:
        return Path(args.file)
    matches = [p for d in search_dirs() for p in d.glob(args.pattern)]
    if not matches:
        raise FileNotFoundError(f"No file matching {args.pattern} in {search_dirs()}")
    return max(matches, key=lambda p: p.stat().st_mtime)


