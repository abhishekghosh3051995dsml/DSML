from openpyxl import load_workbook
from openpyxl.cell.cell import ILLEGAL_CHARACTERS_RE
from openpyxl.formatting.rule import ColorScaleRule
from openpyxl.styles import Alignment, Font, PatternFill

xlsx = OUT / f"{SRC.stem}_EDA.xlsx"
with pd.ExcelWriter(xlsx, engine="openpyxl") as xw:
    for name, frame in SHEETS.items():
        frame.map(lambda v: ILLEGAL_CHARACTERS_RE.sub("", v)[:32000] if isinstance(v, str) else v).to_excel(xw, sheet_name=name, index=False)
fills = {"failed": "F4CCCC", "empty": "FCE5CD", "skipped": "EFEFEF", "returned": "D9EAD3", "interaction": "CFE2F3"}
wb = load_workbook(xlsx)
for ws in wb.worksheets:
    ws.freeze_panes = "B2" if ws.title in ("Correlation", "Interactions") else "A2"
    if ws.max_row > 1:
        ws.auto_filter.ref = ws.dimensions
    for j, cell in enumerate(ws[1], start=1):
        cell.font, cell.fill = Font(bold=True, color="FFFFFF"), PatternFill("solid", fgColor="1C5CAB")
        cell.alignment = Alignment(vertical="center", wrap_text=True)
        width = max(len(str(ws.cell(i, j).value or "")) for i in range(1, min(ws.max_row, 200) + 1))
        ws.column_dimensions[cell.column_letter].width = max(9, min(70, width + 2))
        if cell.value in ("outcome", "level"):
            for i in range(2, ws.max_row + 1):
                f = fills.get(ws.cell(i, j).value)
                if f:
                    ws.cell(i, j).fill = PatternFill("solid", fgColor=f)
        if (str(cell.value).endswith("_pct") or cell.value in ("share_of_rows", "share_of_interactions", "pct", "equal_share")) and ws.max_row > 1:
            ws.conditional_formatting.add(f"{cell.column_letter}2:{cell.column_letter}{ws.max_row}",
                                          ColorScaleRule(start_type="num", start_value=0, start_color="FFFFFF", end_type="num", end_value=1, end_color="2A78D6"))
    if ws.title == "Correlation" and ws.max_row > 1:
        ws.conditional_formatting.add(f"B2:{ws.cell(ws.max_row, ws.max_column).coordinate}",
                                      ColorScaleRule(start_type="num", start_value=-1, start_color="E34948", mid_type="num", mid_value=0,
                                                     mid_color="FFFFFF", end_type="num", end_value=1, end_color="2A78D6"))
wb.save(xlsx)
