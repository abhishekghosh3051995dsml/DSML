            if STATE_CUE_RE.search(s):rows.append({"context_type":"STATE","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.80,"sentence_index":i,"evidence_ref":ref})
            if TIME_RE.search(s):rows.append({"context_type":"TEMPORAL","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.92,"sentence_index":i,"evidence_ref":ref})
            continue
        if role in {"assistant","evidence"}:
