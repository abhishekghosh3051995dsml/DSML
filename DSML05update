    return Config(input_path=a.input_path,outdir=a.outdir,mode=a.mode,model_dir=a.model_dir,profile=a.profile,seed=a.seed,sample_rows=a.sample_rows,test_size=a.test_size,validation_within_development=a.validation_within_development,split_trials=a.split_trials,ontology_path=a.ontology_path,stopword_seed_path=a.stopword_seed_path,lsa_components=a.lsa_components,topic_components=a.topic_components,max_word_features=a.max_word_features,max_char_features=a.max_char_features,word_weight=a.word_weight,char_weight=a.char_weight,signature_weight=a.signature_weight,lsa_weight=a.lsa_weight,topic_weight=a.topic_weight,template_df_ratio=a.template_df_ratio,model_search_trials=a.model_search_trials,stability_repeats=a.stability_repeats,representative_examples=a.representative_examples,top_cluster_terms=a.top_cluster_terms,projection_sample=a.projection_sample,heatmap_top_n=a.heatmap_top_n,centroid_quantile=a.centroid_quantile,centroid_min_similarity=a.centroid_min_similarity,centroid_margin=a.centroid_margin,selection_target_coverage=a.selection_target_coverage,business_min_coverage=a.business_min_coverage,business_max_outlier_rate=a.business_max_outlier_rate,business_max_largest_cluster_share=a.business_max_largest_cluster_share,business_min_clusters=a.business_min_clusters,business_min_problem_normalization_coverage=a.business_min_problem_normalization_coverage,business_max_low_confidence_entity_fraction=a.business_max_low_confidence_entity_fraction,business_entity_confidence_floor=a.business_entity_confidence_floor,metric_bootstrap_repeats=a.metric_bootstrap_repeats,persist_model=not a.no_persist_model,pseudonym_key_env=a.pseudonym_key_env,fail_on_business_readiness=a.fail_on_business_readiness)

