@dataclass
class NoiseModel:
    learned_stopwords: set[str]
    template_phrases: set[str]
    protected_phrases: set[str]
    protected_unigrams: set[str]
    descriptor_blocklist: set[str]
    stopword_threshold: float
    template_threshold: float
    threshold_method: str


@dataclass
class LatentModel:
    vectorizer: FeatureUnion
    svd: TruncatedSVD
    normalizer: Normalizer
    batch_size: int

    def transform(self, texts: Sequence[str], signatures: Sequence[str]) -> np.ndarray:
        rows = [{"text": str(t), "semantic": str(s)} for t, s in zip(texts, signatures)]
        parts: List[np.ndarray] = []
        bs = max(1, self.batch_size)
        for start in range(0, len(rows), bs):
            x = self.vectorizer.transform(rows[start:start + bs])
            z = self.normalizer.transform(self.svd.transform(x))
            parts.append(np.asarray(z, dtype=np.float32))
        if not parts:
            return np.empty((0, int(self.svd.n_components)), dtype=np.float32)
        return np.vstack(parts)


@dataclass
class ClusterModel:
    method: str
    reducer: Any
    clusterer: Any
    parameters: Dict[str, Any]
    silhouette: Optional[float]
    assigned_fraction: float
    stability_ari: Optional[float]
