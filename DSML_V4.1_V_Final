# ---------------------------------------------------------------------------
# Generic utilities
# ---------------------------------------------------------------------------

def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def configure_logging() -> None:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s | %(levelname)s | %(message)s",
        datefmt="%H:%M:%S",
    )


def normalize_space(value: Any) -> str:
    return re.sub(r"\s+", " ", str(value or "")).strip()


def tokenize(value: Any) -> List[str]:
    return [m.group(0).lower() for m in TOKEN_RE.finditer(str(value or ""))]


def normalize_term(value: Any) -> str:
    return " ".join(tokenize(value))


def normalise_key(value: Any) -> str:
    return re.sub(r"[^a-z0-9]+", "_", str(value).strip().lower()).strip("_")


def safe_float(value: Any, default: float = 0.0) -> float:
    try:
        x = float(value)
        return x if np.isfinite(x) else default
    except Exception:
        return default


def to_plain(value: Any) -> Any:
    if value is None:
        return None
    if isinstance(value, dict):
        return {str(k): to_plain(v) for k, v in value.items()}
    if isinstance(value, (list, tuple, set)):
        return [to_plain(v) for v in value]
    if isinstance(value, np.ndarray):
        return [to_plain(v) for v in value.tolist()]
    if isinstance(value, np.integer):
        return int(value)
    if isinstance(value, np.floating):
        return None if not np.isfinite(value) else float(value)
    try:
        if pd.isna(value):
            return None
    except Exception:
        pass
    return value


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with Path(path).open("rb") as handle:
        for block in iter(lambda: handle.read(chunk_size), b""):
            h.update(block)
    return h.hexdigest()


def source_fingerprint() -> str:
    try:
        return sha256_file(Path(__file__).resolve())
    except Exception:
        return sha256_bytes(f"{PIPELINE_NAME}|{PIPELINE_VERSION}".encode("utf-8"))


def package_versions() -> Dict[str, str]:
    out = {
        "python": platform.python_version(),
        "numpy": np.__version__,
        "pandas": pd.__version__,
    }
    try:
        import sklearn
        out["scikit_learn"] = sklearn.__version__
    except Exception:
        pass
    for name in ("scipy", "matplotlib", "joblib", "hdbscan", "umap", "rdflib"):
        try:
            module = __import__(name)
            out[name] = str(getattr(module, "__version__", "installed"))
        except Exception:
            out[name] = "not_available"
    return out


def dependency_audit(config: Config, outdir: Path) -> Dict[str, Any]:
    required = {
        "numpy": True,
        "pandas": True,
        "scipy": True,
        "sklearn": True,
        "matplotlib": True,
        "joblib": True,
        "hdbscan": config.profile == "production",
        "umap": False,
        "rdflib": any(Path(p).suffix.lower() in {".ttl", ".rdf", ".owl", ".xml", ".jsonld", ".nt", ".n3"} for p in config.ontology_paths),
    }
    rows = []
    missing_required = []
    for module_name, is_required in required.items():
        installed = importlib.util.find_spec(module_name) is not None
        rows.append({"module": module_name, "required": is_required, "installed": installed})
        if is_required and not installed:
            missing_required.append(module_name)
    payload = {
        "checked_at_utc": utc_now_iso(),
        "profile": config.profile,
        "packages": rows,
        "missing_required": missing_required,
        "runtime_versions": package_versions(),
    }
    (outdir / "dependency_audit.json").write_text(
        json.dumps(to_plain(payload), indent=2), encoding="utf-8"
    )
    if missing_required:
        raise RuntimeError("Missing required Python packages: " + ", ".join(missing_required))
    return payload


def robust_upper_fence(values: Sequence[float], multiplier: float = 1.5) -> float:
    arr = np.asarray([v for v in values if np.isfinite(v)], dtype=float)
    if not len(arr):
        return float("inf")
    q1, q3 = np.quantile(arr, [0.25, 0.75])
    return float(q3 + multiplier * (q3 - q1))


def distribution_upper_tail(values: Sequence[float], seed: int) -> Tuple[float, str]:
    arr = np.asarray([v for v in values if np.isfinite(v)], dtype=float)
    if not len(arr):
        return float("inf"), "empty"
    if len(arr) < 20 or float(np.std(arr)) < 1e-9:
        return robust_upper_fence(arr), "robust_upper_fence"
    x = arr.reshape(-1, 1)
    try:
        g1 = GaussianMixture(n_components=1, random_state=seed).fit(x)
        g2 = GaussianMixture(n_components=2, random_state=seed).fit(x)
        if g2.bic(x) + 2.0 < g1.bic(x):
            means = g2.means_.ravel()
            hi = int(np.argmax(means))
            lo = int(np.argmin(means))
            grid = np.linspace(float(arr.min()), float(arr.max()), 4096).reshape(-1, 1)
            d = g2.predict_proba(grid)[:, hi] - g2.predict_proba(grid)[:, lo]
            crossings = np.flatnonzero(np.signbit(d[:-1]) != np.signbit(d[1:]))
            if len(crossings):
                return float(grid[int(crossings[-1]) + 1, 0]), "gmm_bic_two_component"
            return float(np.mean(means)), "gmm_midpoint"
    except Exception:
        pass
    return robust_upper_fence(arr), "robust_upper_fence"


def percentile_rank(series: pd.Series, higher_is_better: bool = True) -> pd.Series:
    x = pd.to_numeric(series, errors="coerce")
    if x.notna().sum() <= 1:
        return pd.Series(np.full(len(series), 0.5), index=series.index)
    return x.rank(pct=True, ascending=higher_is_better).fillna(0.0)


def dedupe_dicts(rows: Sequence[Dict[str, Any]], keys: Sequence[str]) -> List[Dict[str, Any]]:
    best: Dict[Tuple[Any, ...], Dict[str, Any]] = {}
    for row in rows:
        key = tuple(str(row.get(k, "")) for k in keys)
        if key not in best or safe_float(row.get("confidence")) > safe_float(best[key].get("confidence")):
            best[key] = dict(row)
    return list(best.values())


# ---------------------------------------------------------------------------
# Privacy, input discovery and grouped boundaries
# ---------------------------------------------------------------------------

def redact_pii(text: str) -> str:
    value = str(text or "")
    for name, pattern in PII_PATTERNS:
        value = pattern.sub(f" [redacted_{name}] ", value)
    return normalize_space(value)


def sanitize_text(text: str) -> str:
    value = html_lib.unescape(str(text or ""))
    value = SCRIPT_STYLE_RE.sub(" ", value)
    value = HTML_TAG_RE.sub(" ", value)
    value = CSS_FRAGMENT_RE.sub(" ", value)
    value = FIELD_LABEL_RE.sub(" ", value)
    value = re.sub(r"\[\s*redacted_[a-z0-9_]+\s*\]|\bredacted_[a-z0-9_]+\b", " ", value, flags=re.I)
    return normalize_space(value)


def resolve_pseudonym_key(config: Config) -> Tuple[bytes, str, str]:
    raw = os.environ.get(config.pseudonym_key_env, "") if config.pseudonym_key_env else ""
    if raw:
        key = hashlib.sha256(raw.encode("utf-8")).digest()
        return key, f"environment:{config.pseudonym_key_env}", sha256_bytes(key)[:16]
    if config.profile == "production":
        raise RuntimeError(
            f"Production profile requires a stable pseudonym key in environment variable {config.pseudonym_key_env}."
        )
    key = secrets.token_bytes(32)
    LOGGER.warning("Fast-development profile is using an ephemeral pseudonym key; cache reuse is disabled.")
    return key, "ephemeral_per_run", sha256_bytes(key)[:16]


def pseudonymize(value: Any, key: bytes) -> str:
    return hashlib.blake2b(
        str(value or "").encode("utf-8", errors="ignore"),
        key=key,
        digest_size=12,
    ).hexdigest()


def find_column(columns: Sequence[str], patterns: Sequence[str]) -> Optional[str]:
    normalized = {c: normalise_key(c) for c in columns}
    for pattern in patterns:
        for column, key in normalized.items():
            if re.search(pattern, key):
                return column
    return None


def discover_schema(df: pd.DataFrame) -> Dict[str, Optional[str]]:
    cols = list(df.columns)
    return {
        "case": find_column(cols, [r"^source_row$", r"source.*row", r"case.*id", r"ticket.*id"]),
        "turn": find_column(cols, [r"message_index", r"turn.*index", r"sequence", r"^index$"]),
        "conversation": find_column(cols, [r"message.*cid", r"^cid$", r"conversation.*id", r"interaction.*id"]),
        "text": find_column(cols, [r"message.*content", r"^content$", r"^text$", r"message.*text"]),
        "upstream_label": find_column(cols, [r"classification.*intent", r"upstream.*label", r"^intent$"]),
        "role": find_column(cols, [r"^message_type$", r"message.*type", r"^role$"]),
    }


def infer_role(row: pd.Series, role_col: Optional[str]) -> str:
    values: List[str] = []
    if role_col and role_col in row.index:
        values.append(str(row.get(role_col, "")))
    for column in row.index:
        key = normalise_key(column)
        if "role" in key or "type" in key:
            values.append(str(row.get(column, "")))
    joined = " ".join(values).lower()
    if re.search(r"\b(user|customer|human|subscriber)\b", joined):
        return "customer"
    if re.search(r"\b(assistant|agent|bot)\b", joined):
        return "assistant"
    if re.search(r"\b(tool|function|evidence|system)\b", joined):
        return "evidence"
    return "unknown"


def group_preserving_sample(frame: pd.DataFrame, target_rows: int, seed: int) -> pd.DataFrame:
    if target_rows <= 0 or len(frame) <= target_rows:
        return frame.copy()
    stats = frame.groupby("_group", sort=False).size().reset_index(name="rows")
    rng = np.random.default_rng(seed)
    selected: List[str] = []
    running = 0
    for pos in rng.permutation(len(stats)).tolist():
        group = str(stats.at[pos, "_group"])
        size = int(stats.at[pos, "rows"])
        if not selected or abs(target_rows - (running + size)) <= abs(target_rows - running):
            selected.append(group)
            running += size
        elif running >= target_rows:
            break
    return frame[frame["_group"].isin(set(selected))].copy().reset_index(drop=True)


def load_and_prepare(config: Config) -> Tuple[pd.DataFrame, Dict[str, Optional[str]]]:
    path = Path(config.input_path)
    if not path.exists():
        raise FileNotFoundError(f"Input CSV not found: {path}")
    df = pd.read_csv(path, low_memory=False)
    schema = discover_schema(df)
    if not schema["text"]:
        raise ValueError("Unable to discover message text column.")

    frame = df.copy().reset_index(drop=True)
    frame["_row_id"] = np.arange(len(frame), dtype=int)
    frame["_raw_text"] = frame[schema["text"]].fillna("").astype(str)
    frame["_redacted_text"] = frame["_raw_text"].map(redact_pii)
    frame["_sanitized_text"] = frame["_redacted_text"].map(sanitize_text)
    frame["_role"] = frame.apply(lambda r: infer_role(r, schema["role"]), axis=1)
    frame["_case"] = (
        frame[schema["case"]].fillna("").astype(str)
        if schema["case"]
        else "row_" + frame["_row_id"].astype(str)
    )
    frame["_conversation"] = (
        frame[schema["conversation"]].fillna("").astype(str)
        if schema["conversation"]
        else frame["_case"]
    )
    frame["_group"] = frame["_conversation"].where(frame["_conversation"].str.len() > 0, frame["_case"])
    frame["_group"] = frame["_group"].where(
        frame["_group"].str.len() > 0,
        "row_" + frame["_row_id"].astype(str),
    )
    frame["_upstream_label"] = (
        frame[schema["upstream_label"]].fillna("").astype(str)
        if schema["upstream_label"]
        else ""
    )

    if config.sample_rows > 0:
        frame = group_preserving_sample(frame, config.sample_rows, config.seed)
        frame["_row_id"] = np.arange(len(frame), dtype=int)

    LOGGER.info(
        "rows=%d customer=%d assistant=%d evidence=%d unknown=%d",
        len(frame),
        int((frame["_role"] == "customer").sum()),
        int((frame["_role"] == "assistant").sum()),
        int((frame["_role"] == "evidence").sum()),
        int((frame["_role"] == "unknown").sum()),
    )
    return frame, schema


def _choose_group_subset(
    frame: pd.DataFrame,
    groups: Sequence[str],
    target_ratio: float,
    seed: int,
    trials: int,
) -> set[str]:
    stats = (
        frame[frame["_group"].isin(set(groups))]
        .groupby("_group", sort=False)
        .size()
        .reset_index(name="rows")
    )
    total = int(stats["rows"].sum())
    target = int(round(total * target_ratio))
    best: Optional[Tuple[float, set[str]]] = None
    for trial in range(max(8, trials)):
        rng = np.random.default_rng(seed + trial * 10007)
        chosen: List[int] = []
        running = 0
        for pos in rng.permutation(len(stats)).tolist():
            size = int(stats.at[pos, "rows"])
            if not chosen or abs(target - (running + size)) <= abs(target - running):
                chosen.append(pos)
                running += size
            elif running >= target:
                break
        selected = set(stats.loc[chosen, "_group"].astype(str))
        score = abs(running / max(total, 1) - target_ratio)
        if best is None or score < best[0]:
            best = (score, selected)
    if best is None:
        raise RuntimeError("Unable to construct grouped split.")
    return best[1]


def assign_splits(frame: pd.DataFrame, config: Config) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    out = frame.copy()
    groups = sorted(out["_group"].astype(str).unique())
    if len(groups) < 5:
        raise RuntimeError("Too few interaction groups for grouped split.")

    locked_groups = _choose_group_subset(
        out, groups, config.test_size, config.seed + 11, config.split_trials
    )
    development_groups = [g for g in groups if g not in locked_groups]
    validation_groups = _choose_group_subset(
        out[out["_group"].isin(development_groups)],
        development_groups,
        config.validation_within_development,
        config.seed + 29,
        config.split_trials,
    )

    out["data_split"] = "train"
    out.loc[out["_group"].isin(validation_groups), "data_split"] = "validation"
    out.loc[out["_group"].isin(locked_groups), "data_split"] = "locked_test"

    group_sets = {
        split: set(out.loc[out["data_split"] == split, "_group"].astype(str))
        for split in ("train", "validation", "locked_test")
    }
    overlap = (
        len(group_sets["train"] & group_sets["validation"])
        + len(group_sets["train"] & group_sets["locked_test"])
        + len(group_sets["validation"] & group_sets["locked_test"])
    )
    if overlap:
        raise AssertionError("Grouped split leakage detected.")

    return out, {
        "group_overlap_count": overlap,
        "rows": {split: int((out["data_split"] == split).sum()) for split in group_sets},
        "groups": {split: len(values) for split, values in group_sets.items()},
        "outer_locked_test_target": config.test_size,
        "validation_within_development_target": config.validation_within_development,
        "selection_boundary": "train_and_validation_only",
    }


def split_group_fingerprint(frame: pd.DataFrame, split: str) -> str:
    values = sorted(frame.loc[frame["data_split"] == split, "_group"].astype(str).unique())
    return sha256_bytes("\n".join(values).encode("utf-8"))


# ---------------------------------------------------------------------------
# Optional local ontology support
# ---------------------------------------------------------------------------

def _local_name(uri: Any) -> str:
    value = str(uri or "")
    tail = re.split(r"[/#:]", value)[-1]
    tail = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", tail)
    return normalize_space(tail.replace("_", "-").replace("-", " "))


def _parse_lexicon_file(path: Path) -> List[OntologyEntry]:
    if path.suffix.lower() == ".csv":
        rows = pd.read_csv(path).to_dict(orient="records")
    elif path.suffix.lower() == ".jsonl":
        rows = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
    elif path.suffix.lower() == ".json":
        payload = json.loads(path.read_text(encoding="utf-8"))
        rows = payload if isinstance(payload, list) else payload.get("entries", [])
    else:
        raise ValueError(f"Unsupported lexicon format: {path.suffix}")

    entries: List[OntologyEntry] = []
    for row in rows:
        canonical = str(row.get("canonical_name", "")).strip()
        if not canonical:
            continue
        raw_synonyms = row.get("synonyms", [])
        if isinstance(raw_synonyms, str):
            synonyms = [x.strip() for x in re.split(r"[|;]", raw_synonyms) if x.strip()]
        elif isinstance(raw_synonyms, list):
            synonyms = [str(x).strip() for x in raw_synonyms if str(x).strip()]
        else:
            synonyms = []
        entries.append(
            OntologyEntry(
                canonical_name=canonical,
                entity_type=str(row.get("entity_type", "DOMAIN_CONCEPT")).strip() or "DOMAIN_CONCEPT",
                synonyms=synonyms,
                parent=str(row.get("parent", "")).strip() or None,
                source=str(row.get("source", path.name)).strip() or path.name,
                source_ref=str(row.get("source_ref", "")).strip() or None,
                uri=str(row.get("uri", "")).strip() or None,
            )
        )
    return entries


def _parse_rdf_ontology(path: Path) -> List[OntologyEntry]:
    try:
        from rdflib import Graph
        from rdflib.namespace import RDF, RDFS, SKOS
    except Exception as exc:
        raise RuntimeError("RDF-family ontology input requires rdflib.") from exc

    format_map = {
        ".ttl": "turtle",
        ".rdf": "xml",
        ".owl": "xml",
        ".xml": "xml",
        ".jsonld": "json-ld",
        ".nt": "nt",
        ".n3": "n3",
    }
    graph = Graph()
    graph.parse(path.as_posix(), format=format_map.get(path.suffix.lower()))

    subjects = set(graph.subjects(RDFS.label, None))
    subjects.update(graph.subjects(SKOS.prefLabel, None))
    subjects.update(graph.subjects(RDF.type, None))

    entries: List[OntologyEntry] = []
    for subject in subjects:
        labels = [str(x) for x in graph.objects(subject, SKOS.prefLabel)]
        labels += [str(x) for x in graph.objects(subject, RDFS.label)]
        canonical = normalize_space(labels[0]) if labels else _local_name(subject)
        if not canonical:
            continue

        alt = [str(x) for x in graph.objects(subject, SKOS.altLabel)]
        synonyms = list(dict.fromkeys(normalize_space(x) for x in labels[1:] + alt if normalize_space(x)))

        types = [_local_name(x) for x in graph.objects(subject, RDF.type)]
        entity_type = next((x for x in types if x), "DOMAIN_CONCEPT")

        parents = [str(x) for x in graph.objects(subject, RDFS.subClassOf)]
        parents += [str(x) for x in graph.objects(subject, SKOS.broader)]
        parent = _local_name(parents[0]) if parents else None

        entries.append(
            OntologyEntry(
                canonical_name=canonical,
                entity_type=entity_type.upper().replace(" ", "_"),
                synonyms=synonyms,
                parent=parent,
                source=path.name,
                source_ref=str(subject),
                uri=str(subject),
            )
        )
    return entries


def load_ontologies(paths: Sequence[str]) -> Tuple[List[OntologyEntry], str, pd.DataFrame]:
    if not paths:
        return [], "reference_alignment_only", pd.DataFrame()

    entries: List[OntologyEntry] = []
    inventory_rows: List[Dict[str, Any]] = []
    graph_backed = False
    for raw in paths:
        path = Path(raw)
        if not path.exists():
            raise FileNotFoundError(f"Ontology file not found: {path}")
        suffix = path.suffix.lower()
        if suffix in {".csv", ".json", ".jsonl"}:
            local_entries = _parse_lexicon_file(path)
            kind = "lexicon"
        elif suffix in {".ttl", ".rdf", ".owl", ".xml", ".jsonld", ".nt", ".n3"}:
            local_entries = _parse_rdf_ontology(path)
            kind = "graph"
            graph_backed = True
        else:
            raise ValueError(f"Unsupported ontology format: {path.suffix}")

        entries.extend(local_entries)
        inventory_rows.append(
            {
                "file": path.name,
                "kind": kind,
                "entries": len(local_entries),
                "sha256": sha256_file(path),
            }
        )

    deduped: Dict[Tuple[str, str], OntologyEntry] = {}
    for entry in entries:
        key = (normalize_term(entry.canonical_name), normalize_term(entry.entity_type))
        if not key[0]:
            continue
        if key not in deduped:
            deduped[key] = entry
        else:
            current = deduped[key]
            current.synonyms = list(dict.fromkeys(current.synonyms + entry.synonyms))
            if not current.parent:
                current.parent = entry.parent
            if not current.uri:
                current.uri = entry.uri

    mode = "graph_backed_local_ontology" if graph_backed else "lexicon_backed_local_ontology"
    return list(deduped.values()), mode, pd.DataFrame(inventory_rows)


class OntologyMatcher:
    def __init__(self, entries: Sequence[OntologyEntry], threshold: float):
        self.entries = list(entries)
        self.threshold = float(threshold)
        self.aliases: List[Tuple[str, int]] = []
        for index, entry in enumerate(self.entries):
            for name in [entry.canonical_name] + list(entry.synonyms):
                normalized = normalize_term(name)
                if normalized:
                    self.aliases.append((normalized, index))

        self.vectorizer: Optional[TfidfVectorizer] = None
        self.matrix: Optional[sparse.csr_matrix] = None
        if self.aliases:
            self.vectorizer = TfidfVectorizer(
                analyzer="char_wb", ngram_range=(3, 5), min_df=1, norm="l2"
            )
            self.matrix = self.vectorizer.fit_transform([x[0] for x in self.aliases]).tocsr()

    def exact_mentions(self, text: str) -> List[Dict[str, Any]]:
        normalized = " " + normalize_term(text) + " "
        rows: List[Dict[str, Any]] = []
        for alias, index in self.aliases:
            if f" {alias} " not in normalized:
                continue
            entry = self.entries[index]
            rows.append(
                {
                    "surface": alias,
                    "canonical_name": entry.canonical_name,
                    "entity_type": entry.entity_type,
                    "parent": entry.parent,
                    "source": entry.source,
                    "source_ref": entry.source_ref,
                    "uri": entry.uri,
                    "confidence": 0.97,
                    "method": "ontology_exact",
                }
            )
        return dedupe_dicts(rows, ("canonical_name", "entity_type", "surface"))

    def fuzzy_match(self, phrase: str) -> Optional[Dict[str, Any]]:
        if self.vectorizer is None or self.matrix is None or not normalize_term(phrase):
            return None
        query = self.vectorizer.transform([normalize_term(phrase)])
        similarities = np.asarray(query @ self.matrix.T).ravel()
        if not len(similarities):
            return None
        index = int(np.argmax(similarities))
        score = float(similarities[index])
        if score < self.threshold:
            return None
        entry = self.entries[self.aliases[index][1]]
        return {
            "surface": normalize_term(phrase),
            "canonical_name": entry.canonical_name,
            "entity_type": entry.entity_type,
            "parent": entry.parent,
            "source": entry.source,
            "source_ref": entry.source_ref,
            "uri": entry.uri,
            "confidence": float(min(0.95, 0.60 + 0.40 * score)),
            "method": "ontology_char_similarity",
        }


# ---------------------------------------------------------------------------
# Duplicate families, corpus-trained stopwords and signal protection
# ---------------------------------------------------------------------------

def adaptive_min_df(n_docs: int) -> int:
    return max(2, int(round(math.log2(max(n_docs, 4)) / 2.0)))


def load_stopword_seed(path: Optional[str]) -> set[str]:
    # Default seeds are language-level stopwords and structural artifacts only.
    # Domain and interaction terminology is learned from the corpus.
    terms = set(SAFE_ENGLISH_STOPWORDS) | set(STRUCTURAL_TOKENS)
    if not path:
        return terms
    source = Path(path)
    if not source.exists():
        raise FileNotFoundError(f"Stopword seed file not found: {source}")
    if source.suffix.lower() == ".csv":
        data = pd.read_csv(source)
        if data.empty:
            return terms
        column = "term" if "term" in data.columns else str(data.columns[0])
        values = data[column].dropna().astype(str).tolist()
    else:
        values = [x.strip() for x in source.read_text(encoding="utf-8").splitlines() if x.strip()]
    terms.update(normalize_term(x) for x in values if normalize_term(x))
    terms -= NEGATION_KEEP
    return terms


def exact_text_hash(text: str) -> str:
    return sha256_bytes(normalize_term(text).encode("utf-8"))[:20]


def build_duplicate_families(texts: Sequence[str]) -> Tuple[np.ndarray, pd.DataFrame, Dict[str, Any]]:
    values = [normalize_term(x) for x in texts]
    token_df: Counter[str] = Counter()
    for value in values:
        token_df.update(set(tokenize(value)))

    positive = np.asarray([v for v in token_df.values() if v > 0], dtype=float)
    if len(positive):
        q1 = float(np.quantile(positive, 0.25))
        slot_cut = max(2, int(round(q1)))
    else:
        slot_cut = 2

    skeletons: List[str] = []
    exact_hashes: List[str] = []
    for value in values:
        toks = tokenize(value)
        exact_hash = exact_text_hash(value)
        exact_hashes.append(exact_hash)
        skeleton: List[str] = []
        slot_open = False
        for token in toks:
            if token_df.get(token, 0) <= slot_cut and token not in SAFE_ENGLISH_STOPWORDS:
                if not slot_open:
                    skeleton.append("slot")
                    slot_open = True
            else:
                skeleton.append(token)
                slot_open = False
        informative = [x for x in skeleton if x != "slot"]
        signature = " ".join(skeleton)
        if len(informative) < 3:
            signature = "exact " + exact_hash
        skeletons.append(signature)

    family_ids = np.asarray(
        [sha256_bytes(x.encode("utf-8"))[:20] for x in skeletons], dtype=object
    )
    counts = Counter(family_ids.tolist())
    exact_counts = Counter(exact_hashes)

    audit_rows = []
    for family, count in sorted(counts.items(), key=lambda x: (-x[1], x[0])):
        members = np.flatnonzero(family_ids == family)
        exact_variants = len({exact_hashes[i] for i in members.tolist()})
        audit_rows.append(
            {
                "duplicate_family": family,
                "family_size": int(count),
                "exact_variant_count": int(exact_variants),
                "near_duplicate_family": bool(count > 1 and exact_variants > 1),
            }
        )

    summary = {
        "documents": len(values),
        "families": len(counts),
        "duplicate_documents": int(sum(max(0, n - 1) for n in counts.values())),
        "exact_duplicate_documents": int(sum(max(0, n - 1) for n in exact_counts.values())),
        "slot_document_frequency_cutoff": slot_cut,
        "family_collapse_ratio": float(len(counts) / max(len(values), 1)),
    }
    return family_ids, pd.DataFrame(audit_rows), summary


def family_representative_indices(family_ids: np.ndarray) -> np.ndarray:
    seen: set[str] = set()
    indices: List[int] = []
    for index, family in enumerate(family_ids.tolist()):
        if family in seen:
            continue
        seen.add(family)
        indices.append(index)
    return np.asarray(indices, dtype=int)


def family_majority_labels(family_ids: np.ndarray, labels: np.ndarray) -> np.ndarray:
    output: List[int] = []
    for family in dict.fromkeys(family_ids.tolist()):
        values = labels[family_ids == family]
        output.append(Counter(values.tolist()).most_common(1)[0][0])
    return np.asarray(output, dtype=int)


def fit_preliminary_partition(texts: Sequence[str], seed: int) -> np.ndarray:
    values = list(texts)
    if len(values) < 10:
        return np.zeros(len(values), dtype=int)
    vectorizer = TfidfVectorizer(
        ngram_range=(1, 2),
        min_df=adaptive_min_df(len(values)),
        max_features=45000,
        sublinear_tf=True,
        norm="l2",
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b",
    )
    try:
        matrix = vectorizer.fit_transform(values)
    except ValueError:
        vectorizer.set_params(min_df=1)
        matrix = vectorizer.fit_transform(values)
    n_components = min(96, matrix.shape[0] - 1, matrix.shape[1] - 1)
    if n_components < 2:
        return np.zeros(len(values), dtype=int)
    latent = TruncatedSVD(n_components=n_components, random_state=seed).fit_transform(matrix)
    latent = Normalizer(copy=False).fit_transform(latent)
    n_clusters = max(2, min(28, int(round(math.sqrt(len(values)) / 1.7))))
    return MiniBatchKMeans(
        n_clusters=n_clusters,
        random_state=seed,
        batch_size=min(2048, max(128, len(values))),
        n_init="auto",
    ).fit_predict(latent).astype(int)


def term_cluster_entropy(matrix: sparse.csr_matrix, labels: np.ndarray) -> np.ndarray:
    ids = sorted(set(int(x) for x in labels.tolist()))
    if len(ids) < 2:
        return np.ones(matrix.shape[1], dtype=float)
    counts = np.zeros((len(ids), matrix.shape[1]), dtype=np.float64)
    for row, cluster_id in enumerate(ids):
        counts[row] = np.asarray((matrix[labels == cluster_id] > 0).sum(axis=0)).ravel()
    totals = counts.sum(axis=0)
    totals[totals == 0] = 1.0
    probabilities = counts / totals
    entropy = -np.sum(
        np.where(probabilities > 0, probabilities * np.log(probabilities + 1e-12), 0.0),
        axis=0,
    )
    return entropy / max(math.log(len(ids)), 1e-12)


def max_regularized_log_odds_z(matrix: sparse.csr_matrix, labels: np.ndarray) -> np.ndarray:
    binary = (matrix > 0).astype(np.int8)
    total = np.asarray(binary.sum(axis=0)).ravel().astype(float)
    n_docs = binary.shape[0]
    output = np.zeros(binary.shape[1], dtype=float)
    alpha = 0.5
    for cluster_id in sorted(set(int(x) for x in labels.tolist())):
        mask = labels == cluster_id
        inside = np.asarray(binary[mask].sum(axis=0)).ravel().astype(float)
        outside = total - inside
        n_inside = float(mask.sum())
        n_outside = float(n_docs - mask.sum())
        log_inside = np.log((inside + alpha) / np.maximum(n_inside - inside + alpha, 1e-9))
        log_outside = np.log((outside + alpha) / np.maximum(n_outside - outside + alpha, 1e-9))
        delta = log_inside - log_outside
        variance = 1.0 / (inside + alpha) + 1.0 / (outside + alpha)
        output = np.maximum(output, delta / np.sqrt(np.maximum(variance, 1e-9)))
    return output


def boundary_document_frequency(
    texts: Sequence[str], max_ngram: int = 3, boundary: int = 6
) -> Counter[str]:
    output: Counter[str] = Counter()
    for text in texts:
        toks = tokenize(text)
        seen: set[str] = set()
        for ngram_order in range(2, max_ngram + 1):
            for index in range(max(0, len(toks) - ngram_order + 1)):
                if index < boundary or index + ngram_order > max(0, len(toks) - boundary):
                    seen.add(" ".join(toks[index:index + ngram_order]))
        output.update(seen)
    return output


def phrase_association_npmi(
    phrase: str,
    phrase_df: float,
    unigram_df: Mapping[str, float],
    n_docs: int,
) -> float:
    toks = phrase.split()
    if len(toks) < 2 or phrase_df <= 0 or n_docs <= 0:
        return float("nan")
    p_phrase = max(float(phrase_df) / n_docs, 1e-12)
    expected = 1.0
    for token in toks:
        expected *= max(float(unigram_df.get(token, 0.0)) / n_docs, 1e-12)
    denominator = -math.log(min(p_phrase, 1.0 - 1e-12))
    if denominator <= 1e-12:
        return 0.0
    return float(np.clip(math.log(p_phrase / expected) / denominator, -1.0, 1.0))


def extract_key_values(text: str, row_ref: str) -> List[Dict[str, Any]]:
    rows: List[Dict[str, Any]] = []
    for match in KV_RE.finditer(text):
        key = normalize_space(LEADING_OBSERVATION_VERB_RE.sub("", normalize_space(match.group("key"))))
        value = normalize_space(match.group("value"))
        if tokenize(key) and value:
            rows.append(
                {
                    "key": key,
                    "value": value,
                    "normalized_key": normalize_term(key),
                    "normalized_value": normalize_term(value),
                    "unit": None,
                    "confidence": 0.92,
                    "method": "explicit_key_value",
                    "evidence_ref": row_ref,
                }
            )
    for match in MEASUREMENT_RE.finditer(text):
        key = normalize_space(LEADING_OBSERVATION_VERB_RE.sub("", normalize_space(match.group("key"))))
        raw_value = match.group("value")
        unit = match.group("unit")
        try:
            normalized_value: Any = float(raw_value)
        except Exception:
            normalized_value = raw_value
        rows.append(
            {
                "key": key,
                "value": raw_value,
                "normalized_key": normalize_term(key),
                "normalized_value": normalized_value,
                "unit": unit,
                "confidence": 0.97,
                "method": "measurement_pattern",
                "evidence_ref": row_ref,
            }
        )
    for match in ERROR_CODE_RE.finditer(text):
        rows.append(
            {
                "key": "error_code",
                "value": match.group(1),
                "normalized_key": "error_code",
                "normalized_value": match.group(1).upper(),
                "unit": None,
                "confidence": 0.91,
                "method": "error_code_pattern",
                "evidence_ref": row_ref,
            }
        )
    return dedupe_dicts(rows, ("normalized_key", "normalized_value", "unit", "evidence_ref"))


def derive_structured_protected_terms(frame: pd.DataFrame) -> set[str]:
    protected = set(NEGATION_KEEP)
    for _, row in frame.iterrows():
        for kv in extract_key_values(str(row["_sanitized_text"]), str(row["_row_ref"])):
            key = normalize_term(kv["key"])
            if key:
                protected.add(key)
                protected.update(key.split())
            if kv.get("unit"):
                protected.add(normalize_term(kv["unit"]))
    return protected


def _family_presence_matrix(
    matrix: sparse.csr_matrix,
    family_ids: np.ndarray,
) -> Tuple[sparse.csr_matrix, np.ndarray]:
    unique = list(dict.fromkeys(family_ids.tolist()))
    family_index = {family: i for i, family in enumerate(unique)}
    rows = np.asarray([family_index[x] for x in family_ids.tolist()], dtype=int)
    cols = np.arange(len(family_ids), dtype=int)
    membership = sparse.csr_matrix(
        (np.ones(len(rows), dtype=np.int8), (rows, cols)),
        shape=(len(unique), len(family_ids)),
    )
    counts = membership @ (matrix > 0).astype(np.int8)
    counts.data[:] = 1
    return counts.tocsr(), np.asarray(unique, dtype=object)


def mine_protected_phrases(
    texts: Sequence[str],
    labels: np.ndarray,
    family_ids: np.ndarray,
    seed_terms: set[str],
    config: Config,
) -> pd.DataFrame:
    vectorizer = CountVectorizer(
        ngram_range=(1, 3),
        min_df=max(2, config.phrase_min_df),
        binary=True,
        max_features=max(config.phrase_top_candidates * 10, 25000),
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b",
    )
    try:
        raw_matrix = vectorizer.fit_transform(list(texts)).tocsr()
    except ValueError:
        return pd.DataFrame(
            columns=[
                "phrase", "ngram_order", "document_frequency", "family_document_frequency",
                "duplicate_survival_ratio", "specificity", "association_npmi", "log_odds_z",
                "boundary_ratio", "template_likelihood", "content_ratio", "phrase_score",
                "selected_as_domain_signal", "rescued_unigram",
            ]
        )

    terms = np.asarray(vectorizer.get_feature_names_out())
    order = np.asarray([str(term).count(" ") + 1 for term in terms], dtype=int)
    raw_df = np.asarray(raw_matrix.sum(axis=0)).ravel().astype(float)

    family_matrix, unique_families = _family_presence_matrix(raw_matrix, family_ids)
    family_df = np.asarray(family_matrix.sum(axis=0)).ravel().astype(float)
    family_labels = family_majority_labels(family_ids, labels)
    specificity = 1.0 - term_cluster_entropy(family_matrix, family_labels)
    log_odds = max_regularized_log_odds_z(family_matrix, family_labels)

    raw_prevalence = raw_df / max(len(texts), 1)
    family_prevalence = family_df / max(len(unique_families), 1)
    duplicate_survival = np.minimum(
        1.0,
        family_prevalence / np.maximum(raw_prevalence, 1e-12),
    )
    duplicate_pressure = 1.0 - duplicate_survival

    unigram_df = {
        str(term): float(freq)
        for term, freq, ngram_order in zip(terms.tolist(), family_df.tolist(), order.tolist())
        if ngram_order == 1
    }
    association = np.asarray(
        [
            phrase_association_npmi(str(term), float(freq), unigram_df, len(unique_families))
            if ngram_order > 1 else np.nan
            for term, freq, ngram_order in zip(terms.tolist(), family_df.tolist(), order.tolist())
        ]
    )

    boundary_df = boundary_document_frequency(texts, 3)
    boundary_ratio = np.asarray(
        [
            boundary_df.get(str(term), 0) / max(float(freq), 1.0)
            if ngram_order > 1 else 0.0
            for term, freq, ngram_order in zip(terms.tolist(), raw_df.tolist(), order.tolist())
        ]
    )

    support_rank = pd.Series(family_df).rank(pct=True).to_numpy(float)
    specificity_rank = pd.Series(specificity).rank(pct=True).to_numpy(float)
    log_odds_rank = pd.Series(log_odds).rank(pct=True).to_numpy(float)
    boundary_rank = pd.Series(boundary_ratio).rank(pct=True).to_numpy(float)
    duplicate_rank = pd.Series(duplicate_pressure).rank(pct=True).to_numpy(float)
    broadness_rank = pd.Series(1.0 - specificity).rank(pct=True).to_numpy(float)
    weak_discrimination_rank = pd.Series(-log_odds).rank(pct=True).to_numpy(float)

    def content_token(token: str) -> bool:
        # Language stopword lists are priors, not absolute exclusions. A token
        # can be rescued when corpus evidence shows that it participates in a
        # stable discriminative phrase. Only structural artifacts are forbidden.
        return token not in STRUCTURAL_TOKENS and not token.startswith("redacted")

    content_ratio = np.asarray(
        [
            len([token for token in str(term).split() if content_token(token)]) / max(ngram_order, 1)
            for term, ngram_order in zip(terms.tolist(), order.tolist())
        ],
        dtype=float,
    )
    edge_clean = np.asarray(
        [
            bool(str(term).split())
            and content_token(str(term).split()[0])
            and content_token(str(term).split()[-1])
            for term in terms.tolist()
        ],
        dtype=bool,
    )

    template_likelihood = np.power(
        np.clip(boundary_rank, 1e-9, 1.0)
        * np.clip(duplicate_rank, 1e-9, 1.0)
        * np.clip(broadness_rank, 1e-9, 1.0)
        * np.clip(weak_discrimination_rank, 1e-9, 1.0),
        0.25,
    )
    template_cut, template_cut_method = distribution_upper_tail(
        template_likelihood[order > 1], config.seed + 173
    ) if np.any(order > 1) else (float("inf"), "empty")

    association_unit = np.where(np.isfinite(association), (association + 1.0) / 2.0, 0.5)
    signal_score = np.power(
        np.clip(support_rank, 1e-9, 1.0)
        * np.clip(specificity_rank, 1e-9, 1.0)
        * np.clip(log_odds_rank, 1e-9, 1.0)
        * np.clip(association_unit, 1e-9, 1.0)
        * np.clip(content_ratio, 1e-9, 1.0)
        * np.clip(1.0 - template_likelihood, 1e-9, 1.0),
        1.0 / 6.0,
    )

    invalid = ~edge_clean
    multi = order > 1
    invalid |= multi & (~np.isfinite(association) | (association <= 0.0))
    if np.isfinite(template_cut):
        invalid |= multi & (template_likelihood >= template_cut)
    signal_score[invalid] = 0.0

    valid_scores = signal_score[signal_score > 0]
    selection_cut, selection_method = (
        distribution_upper_tail(valid_scores, config.seed + 191)
        if len(valid_scores)
        else (float("inf"), "empty")
    )
    selected = (
        signal_score >= selection_cut
        if np.isfinite(selection_cut)
        else np.zeros(len(signal_score), dtype=bool)
    )

    # Multiword phrases provide corpus-driven rescue evidence for component tokens.
    selected_multi = {
        str(term)
        for term, flag, ngram_order in zip(terms.tolist(), selected.tolist(), order.tolist())
        if flag and ngram_order > 1
    }
    rescue_tokens = {token for phrase in selected_multi for token in phrase.split() if content_token(token)}
    rescued = np.asarray(
        [ngram_order == 1 and str(term) in rescue_tokens for term, ngram_order in zip(terms.tolist(), order.tolist())],
        dtype=bool,
    )

    # Allow highly discriminative single-token concepts without a manual telecom list.
    unigram_mask = order == 1
    if np.any(unigram_mask):
        unigram_cut, _ = distribution_upper_tail(log_odds[unigram_mask], config.seed + 197)
        selected |= unigram_mask & edge_clean & (
            rescued | (log_odds >= unigram_cut)
        ) & (family_df >= max(2, config.phrase_min_df))

    table = pd.DataFrame(
        {
            "phrase": terms,
            "ngram_order": order,
            "document_frequency": raw_df.astype(int),
            "family_document_frequency": family_df.astype(int),
            "duplicate_survival_ratio": duplicate_survival,
            "specificity": specificity,
            "association_npmi": association,
            "log_odds_z": log_odds,
            "boundary_ratio": boundary_ratio,
            "template_likelihood": template_likelihood,
            "template_threshold": template_cut,
            "template_threshold_method": template_cut_method,
            "content_ratio": content_ratio,
            "phrase_score": signal_score,
            "selection_threshold": selection_cut,
            "selection_threshold_method": selection_method,
            "selected_as_domain_signal": selected,
            "rescued_unigram": rescued,
        }
    )
    return table.sort_values(
        ["selected_as_domain_signal", "rescued_unigram", "phrase_score", "family_document_frequency"],
        ascending=[False, False, False, False],
    ).head(config.phrase_top_candidates).reset_index(drop=True)


def learn_noise_model(
    texts: Sequence[str],
    labels: np.ndarray,
    family_ids: np.ndarray,
    structured_protected: set[str],
    phrase_table: pd.DataFrame,
    seed_terms: set[str],
    config: Config,
) -> Tuple[NoiseModel, pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    values = list(texts)
    vectorizer = CountVectorizer(
        ngram_range=(1, config.noise_ngram_max),
        min_df=adaptive_min_df(len(values)),
        binary=True,
        max_features=config.candidate_noise_features,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b",
    )
    try:
        raw_matrix = vectorizer.fit_transform(values).tocsr()
    except ValueError:
        vectorizer.set_params(min_df=1)
        raw_matrix = vectorizer.fit_transform(values).tocsr()

    terms = np.asarray(vectorizer.get_feature_names_out())
    order = np.asarray([str(term).count(" ") + 1 for term in terms], dtype=int)
    raw_df = np.asarray(raw_matrix.sum(axis=0)).ravel().astype(float)
    raw_ratio = raw_df / max(len(values), 1)

    family_matrix, unique_families = _family_presence_matrix(raw_matrix, family_ids)
    family_df = np.asarray(family_matrix.sum(axis=0)).ravel().astype(float)
    family_ratio = family_df / max(len(unique_families), 1)
    family_labels = family_majority_labels(family_ids, labels)
    entropy = term_cluster_entropy(family_matrix, family_labels)
    log_odds = max_regularized_log_odds_z(family_matrix, family_labels)

    duplicate_survival = np.minimum(
        1.0,
        family_ratio / np.maximum(raw_ratio, 1e-12),
    )
    duplicate_pressure = 1.0 - duplicate_survival

    frequency_rank = pd.Series(family_ratio).rank(pct=True).to_numpy(float)
    entropy_rank = pd.Series(entropy).rank(pct=True).to_numpy(float)
    discrimination_rank = pd.Series(log_odds).rank(pct=True).to_numpy(float)

    stopword_score = np.power(
        np.clip(frequency_rank, 1e-9, 1.0)
        * np.clip(entropy_rank, 1e-9, 1.0)
        * np.clip(1.0 - discrimination_rank + 1e-6, 1e-9, 1.0),
        1.0 / 3.0,
    )
    unigram_mask = order == 1
    stopword_cut, stopword_method = distribution_upper_tail(
        stopword_score[unigram_mask], config.seed + 71
    )

    boundary_df = boundary_document_frequency(values, config.noise_ngram_max)
    boundary_ratio = np.asarray(
        [
            boundary_df.get(str(term), 0) / max(float(freq), 1.0)
            if ngram_order > 1 else 0.0
            for term, freq, ngram_order in zip(terms.tolist(), raw_df.tolist(), order.tolist())
        ]
    )
    boundary_rank = pd.Series(boundary_ratio).rank(pct=True).to_numpy(float)
    duplicate_rank = pd.Series(duplicate_pressure).rank(pct=True).to_numpy(float)
    weak_rank = pd.Series(-log_odds).rank(pct=True).to_numpy(float)
    template_score = np.power(
        np.clip(boundary_rank, 1e-9, 1.0)
        * np.clip(duplicate_rank, 1e-9, 1.0)
        * np.clip(entropy_rank, 1e-9, 1.0)
        * np.clip(weak_rank, 1e-9, 1.0),
        0.25,
    )
    phrase_mask = order > 1
    template_cut, template_method = distribution_upper_tail(
        template_score[phrase_mask], config.seed + 101
    ) if np.any(phrase_mask) else (float("inf"), "empty")

    selected_signals = set()
    rescue_unigrams = set()
    if not phrase_table.empty:
        selected_signals = set(
            phrase_table.loc[phrase_table["selected_as_domain_signal"] == True, "phrase"].astype(str)
        )
        if "rescued_unigram" in phrase_table.columns:
            rescue_unigrams = set(
                phrase_table.loc[phrase_table["rescued_unigram"] == True, "phrase"].astype(str)
            )

    protected_unigrams = set(structured_protected) | set(NEGATION_KEEP) | rescue_unigrams
    protected_unigrams.update(x for x in selected_signals if len(x.split()) == 1)
    protected_phrases = {x for x in selected_signals if len(x.split()) > 1}

    # Corpus-driven unigram rescue: a frequent token can still carry domain
    # meaning when it is concentrated in a subset of provisional semantic
    # regions. This is deliberately learned from the corpus rather than from a
    # telecom whitelist. Duplicate-family collapse prevents copied templates
    # from manufacturing false discrimination.
    unigram_discrimination_rank = np.zeros(len(terms), dtype=float)
    unigram_specificity_rank = np.zeros(len(terms), dtype=float)
    if np.any(unigram_mask):
        unigram_discrimination_rank[unigram_mask] = (
            pd.Series(log_odds[unigram_mask]).rank(pct=True).to_numpy(float)
        )
        unigram_specificity_rank[unigram_mask] = (
            pd.Series((1.0 - entropy)[unigram_mask]).rank(pct=True).to_numpy(float)
        )
    semantic_rescue_score = np.sqrt(
        np.clip(unigram_discrimination_rank, 1e-9, 1.0)
        * np.clip(unigram_specificity_rank, 1e-9, 1.0)
    )
    rescue_candidates = semantic_rescue_score[unigram_mask]
    semantic_rescue_cut, semantic_rescue_method = distribution_upper_tail(
        rescue_candidates, config.seed + 83
    )
    contextual_rescue = (
        unigram_mask
        & (semantic_rescue_score >= semantic_rescue_cut)
        & np.asarray([
            not any(token in STRUCTURAL_TOKENS for token in str(term).split())
            for term in terms.tolist()
        ], dtype=bool)
    )
    contextual_rescue_terms = set(terms[contextual_rescue].astype(str))
    protected_unigrams.update(contextual_rescue_terms)

    seed_prior = np.asarray(
        [
            ngram_order == 1 and str(term) in seed_terms
            for term, ngram_order in zip(terms.tolist(), order.tolist())
        ],
        dtype=bool,
    )
    structural_force = np.asarray(
        [
            any(token in STRUCTURAL_TOKENS for token in str(term).split())
            for term in terms.tolist()
        ],
        dtype=bool,
    )
    protected = np.asarray(
        [
            str(term) in protected_unigrams
            or str(term) in protected_phrases
            or any(token in NEGATION_KEEP for token in str(term).split())
            for term in terms.tolist()
        ],
        dtype=bool,
    )

    # Seed membership alone never removes a token. It is only a prior label in
    # the audit; removal still requires corpus evidence unless the token is a
    # structural artifact. This prevents domain words that happen to occur in a
    # generic language list from being deleted automatically.
    learned_stop = unigram_mask & (stopword_score >= stopword_cut) & (~protected)
    template_noise = (
        phrase_mask & (template_score >= template_cut) & (~protected)
        if np.isfinite(template_cut)
        else np.zeros(len(terms), dtype=bool)
    )
    selected = (learned_stop | structural_force | template_noise) & (~protected)

    reasons: List[str] = []
    for index in range(len(terms)):
        if contextual_rescue[index]:
            reasons.append("contextual_discriminative_rescue")
        elif protected[index]:
            reasons.append("protected_semantic_signal")
        elif structural_force[index]:
            reasons.append("structural_artifact")
        elif learned_stop[index] and seed_prior[index]:
            reasons.append("seed_supported_corpus_stopword")
        elif template_noise[index]:
            reasons.append("duplicate_aware_template")
        elif learned_stop[index]:
            reasons.append("learned_corpus_stopword")
        else:
            reasons.append("retained")

    audit = pd.DataFrame(
        {
            "term": terms,
            "ngram_order": order,
            "document_frequency": raw_df.astype(int),
            "family_document_frequency": family_df.astype(int),
            "document_frequency_ratio": raw_ratio,
            "family_frequency_ratio": family_ratio,
            "duplicate_survival_ratio": duplicate_survival,
            "cluster_entropy": entropy,
            "max_regularized_log_odds_z": log_odds,
            "semantic_rescue_score": semantic_rescue_score,
            "semantic_rescue_threshold": semantic_rescue_cut,
            "semantic_rescue_threshold_method": semantic_rescue_method,
            "contextual_rescue": contextual_rescue,
            "boundary_ratio": boundary_ratio,
            "stopword_score": stopword_score,
            "stopword_threshold": stopword_cut,
            "template_score": template_score,
            "template_threshold": template_cut,
            "selected_as_noise": selected,
            "protected": protected,
            "reason": reasons,
        }
    ).sort_values(
        ["selected_as_noise", "protected", "stopword_score", "max_regularized_log_odds_z"],
        ascending=[False, False, False, False],
    ).reset_index(drop=True)

    learned_stopwords = set(terms[selected & (order == 1)].astype(str))
    template_phrases = set(terms[selected & (order > 1)].astype(str))
    model = NoiseModel(
        learned_stopwords=learned_stopwords,
        template_phrases=template_phrases,
        protected_phrases=protected_phrases,
        protected_unigrams=protected_unigrams,
        descriptor_blocklist=(
            learned_stopwords | template_phrases | set(STRUCTURAL_TOKENS)
        ),
        stopword_threshold=float(stopword_cut),
        template_threshold=float(template_cut),
        threshold_method=f"stop:{stopword_method}+template:{template_method}+family_collapse+phrase_rescue",
    )
    stopword_export = audit[
        (audit["selected_as_noise"] == True) & (audit["ngram_order"] == 1)
    ].copy()
    template_export = audit[
        (audit["selected_as_noise"] == True) & (audit["ngram_order"] > 1)
    ].copy()
    return model, audit, stopword_export, template_export


def apply_noise_model(text: str, model: NoiseModel) -> str:
    tokens = tokenize(text)
    if not tokens:
        return ""

    protected = np.zeros(len(tokens), dtype=bool)
    max_phrase = max([len(x.split()) for x in model.protected_phrases], default=1)
    for ngram_order in range(max_phrase, 1, -1):
        for index in range(max(0, len(tokens) - ngram_order + 1)):
            if " ".join(tokens[index:index + ngram_order]) in model.protected_phrases:
                protected[index:index + ngram_order] = True
    for index, token in enumerate(tokens):
        if token in model.protected_unigrams:
            protected[index] = True

    drop = np.zeros(len(tokens), dtype=bool)
    max_template = max([len(x.split()) for x in model.template_phrases], default=1)
    for ngram_order in range(max_template, 1, -1):
        for index in range(max(0, len(tokens) - ngram_order + 1)):
            if protected[index:index + ngram_order].any():
                continue
            if " ".join(tokens[index:index + ngram_order]) in model.template_phrases:
                drop[index:index + ngram_order] = True
    for index, token in enumerate(tokens):
        if not protected[index] and token in model.learned_stopwords:
            drop[index] = True

    kept = [token for token, is_drop in zip(tokens, drop.tolist()) if not is_drop]
    return " ".join(tokens) if len(kept) < 2 else " ".join(kept)


# ---------------------------------------------------------------------------
# Entity, context, evidence and semantic dictionary construction
# ---------------------------------------------------------------------------

def split_sentences(text: str) -> List[str]:
    return [
        normalize_space(part)
        for part in SENTENCE_SPLIT_RE.split(str(text or ""))
        if len(tokenize(part)) >= 2
    ]


def classify_sentence_context(sentence: str) -> List[Tuple[str, float]]:
    output: List[Tuple[str, float]] = []
    tests = (
        (DIAGNOSTIC_CUE_RE, "DIAGNOSTIC", 0.82),
        (CAUSE_CUE_RE, "ROOT_CAUSE", 0.91),
        (REMEDIATION_CUE_RE, "REMEDIATION", 0.87),
        (STATE_CUE_RE, "STATE", 0.80),
        (IMPACT_CUE_RE, "SYMPTOM_OR_IMPACT", 0.80),
        (TIME_RE, "TEMPORAL", 0.92),
        (ACTION_VERB_RE, "ACTION", 0.78),
    )
    for pattern, label, confidence in tests:
        if pattern.search(sentence):
            output.append((label, confidence))
    return output


def context_records(text: str, row_ref: str, role: str) -> List[Dict[str, Any]]:
    rows: List[Dict[str, Any]] = []
    for index, sentence in enumerate(split_sentences(text)):
        for context_type, confidence in classify_sentence_context(sentence):
            rows.append(
                {
                    "context_type": context_type,
                    "statement": sentence,
                    "role": role,
                    "confidence": confidence,
                    "sentence_index": index,
                    "evidence_ref": row_ref,
                }
            )
    return rows


def role_entities(role: str, row_ref: str) -> List[Dict[str, Any]]:
    mapping = {
        "customer": [("customer", "ACTOR")],
        "assistant": [("assistant", "ACTOR"), ("call_center", "CHANNEL_OR_ACTOR")],
        "evidence": [("evidence_source", "SYSTEM_OR_SOURCE")],
    }
    rows = []
    for name, entity_type in mapping.get(role, []):
        rows.append(
            {
                "surface": name,
                "canonical_name": name,
                "entity_type": entity_type,
                "confidence": 0.99,
                "method": "interaction_role",
                "source_ref": "TR292A" if entity_type in {"ACTOR", "CHANNEL_OR_ACTOR"} else "TR292G",
                "uri": None,
                "evidence_ref": row_ref,
            }
        )
    return rows


def kv_entities(kvs: Sequence[Dict[str, Any]], ontology: OntologyMatcher) -> List[Dict[str, Any]]:
    rows: List[Dict[str, Any]] = []
    for kv in kvs:
        key = str(kv["normalized_key"])
        match = ontology.fuzzy_match(key)
        if match:
            match["evidence_ref"] = kv["evidence_ref"]
            rows.append(match)
        else:
            rows.append(
                {
                    "surface": key,
                    "canonical_name": key,
                    "entity_type": "ATTRIBUTE_OR_METRIC",
                    "confidence": 0.90 if kv.get("unit") else 0.80,
                    "method": "structured_key",
                    "source_ref": "TR292D/TR292G" if kv.get("unit") else "TR292G",
                    "uri": None,
                    "evidence_ref": kv["evidence_ref"],
                }
            )
    return dedupe_dicts(rows, ("canonical_name", "entity_type", "evidence_ref"))


def phrase_entities(
    text: str,
    row_ref: str,
    phrase_table: pd.DataFrame,
    ontology: OntologyMatcher,
) -> List[Dict[str, Any]]:
    normalized = " " + normalize_term(text) + " "
    rows: List[Dict[str, Any]] = []
    for item in ontology.exact_mentions(text):
        item["evidence_ref"] = row_ref
        rows.append(item)

    if phrase_table.empty:
        return dedupe_dicts(rows, ("canonical_name", "entity_type", "evidence_ref"))

    candidates = phrase_table
    if "selected_as_domain_signal" in candidates.columns:
        candidates = candidates[candidates["selected_as_domain_signal"] == True]

    matches: List[Tuple[str, float, int]] = []
    for rec in candidates.head(1500).itertuples(index=False):
        phrase = str(rec.phrase)
        if ACTION_VERB_RE.search(phrase) or CAUSE_CUE_RE.search(phrase) or REMEDIATION_CUE_RE.search(phrase):
            continue
        if f" {phrase} " in normalized:
            matches.append((phrase, float(rec.phrase_score), int(rec.ngram_order)))

    selected: List[Tuple[str, float, int]] = []
    for phrase, score, ngram_order in sorted(matches, key=lambda x: (-x[2], -x[1], x[0])):
        toks = set(phrase.split())
        overlap = False
        for existing, _, _ in selected:
            existing_tokens = set(existing.split())
            union = toks | existing_tokens
            if toks.issubset(existing_tokens) or len(toks & existing_tokens) / max(len(union), 1) >= 0.75:
                overlap = True
                break
        if overlap:
            continue
        selected.append((phrase, score, ngram_order))
        if len(selected) >= 12:
            break

    for phrase, score, _ in selected:
        match = ontology.fuzzy_match(phrase)
        if match:
            match["evidence_ref"] = row_ref
            rows.append(match)
        else:
            rows.append(
                {
                    "surface": phrase,
                    "canonical_name": phrase,
                    "entity_type": "DOMAIN_CONCEPT",
                    "confidence": float(np.clip(0.54 + 0.36 * score, 0.54, 0.89)),
                    "method": "corpus_phrase_mining",
                    "source_ref": "TR290/TR292-aligned",
                    "uri": None,
                    "evidence_ref": row_ref,
                }
            )
    return dedupe_dicts(rows, ("canonical_name", "entity_type", "evidence_ref"))


def extract_entities_for_row(
    text: str,
    role: str,
    row_ref: str,
    kvs: Sequence[Dict[str, Any]],
    phrase_table: pd.DataFrame,
    ontology: OntologyMatcher,
) -> List[Dict[str, Any]]:
    rows = (
        role_entities(role, row_ref)
        + kv_entities(kvs, ontology)
        + phrase_entities(text, row_ref, phrase_table, ontology)
    )
    return dedupe_dicts(rows, ("canonical_name", "entity_type", "evidence_ref"))


def normalize_statement_signature(text: str) -> str:
    return " ".join(
        [token for token in tokenize(text) if token not in SAFE_ENGLISH_STOPWORDS][:30]
    )


def build_evidence_records(
    contexts: Sequence[Dict[str, Any]],
    kvs: Sequence[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    by_ref: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for kv in kvs:
        by_ref[kv["evidence_ref"]].append(kv)

    rows: List[Dict[str, Any]] = []
    for context in contexts:
        if context["context_type"] not in {"DIAGNOSTIC", "STATE", "SYMPTOM_OR_IMPACT"}:
            continue
        linked = by_ref.get(context["evidence_ref"], [])
        base = 0.44
        if context["role"] == "evidence":
            base += 0.27
        elif context["role"] == "assistant":
            base += 0.13
        if linked:
            base += 0.14
        if DIAGNOSTIC_CUE_RE.search(context["statement"]):
            base += 0.09
        if context["context_type"] == "DIAGNOSTIC":
            base += 0.05
        rows.append(
            {
                "evidence_type": context["context_type"],
                "statement": context["statement"],
                "role": context["role"],
                "key_values": linked[:12],
                "confidence": float(context["confidence"]),
                "evidence_strength": float(np.clip(base, 0.0, 0.99)),
                "evidence_ref": context["evidence_ref"],
                "_sig": normalize_statement_signature(context["statement"]),
            }
        )

    for kv in kvs:
        if kv.get("unit"):
            statement = f"{kv['key']}={kv['value']} {kv['unit']}"
            rows.append(
                {
                    "evidence_type": "MEASUREMENT",
                    "statement": statement,
                    "role": None,
                    "key_values": [kv],
                    "confidence": float(kv["confidence"]),
                    "evidence_strength": 0.95,
                    "evidence_ref": kv["evidence_ref"],
                    "_sig": normalize_statement_signature(f"{kv['key']} {kv['unit']}"),
                }
            )

    refs: Dict[str, set[str]] = defaultdict(set)
    roles: Dict[str, set[str]] = defaultdict(set)
    for row in rows:
        if row["_sig"]:
            refs[row["_sig"]].add(row["evidence_ref"])
            roles[row["_sig"]].add(str(row.get("role") or ""))

    for row in rows:
        ref_count = len(refs.get(row["_sig"], set())) or 1
        role_count = len([x for x in roles.get(row["_sig"], set()) if x]) or 1
        row["corroboration_count"] = ref_count
        row["role_diversity"] = role_count
        row["evidence_strength"] = float(
            min(
                0.99,
                row["evidence_strength"]
                + min(0.08, 0.02 * max(0, ref_count - 1))
                + min(0.05, 0.025 * max(0, role_count - 1)),
            )
        )
        row.pop("_sig", None)
    return dedupe_dicts(rows, ("evidence_type", "statement", "evidence_ref"))


def build_cause_records(
    contexts: Sequence[Dict[str, Any]],
    evidence: Sequence[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    by_ref: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for row in evidence:
        by_ref[row["evidence_ref"]].append(row)
    output: List[Dict[str, Any]] = []
    for context in contexts:
        if context["context_type"] != "ROOT_CAUSE":
            continue
        linked = by_ref.get(context["evidence_ref"], [])
        support = (
            float(np.mean([safe_float(x.get("evidence_strength")) for x in linked]))
            if linked else 0.0
        )
        output.append(
            {
                "statement": context["statement"],
                "confidence": float(min(0.97, 0.76 + 0.15 * support + (0.05 if linked else 0.0))),
                "linked_evidence_refs": sorted({x["evidence_ref"] for x in linked}),
                "supporting_evidence_count": len(linked),
                "evidence_ref": context["evidence_ref"],
            }
        )
    return dedupe_dicts(output, ("statement", "evidence_ref"))


def build_remediation_records(
    contexts: Sequence[Dict[str, Any]],
    evidence: Sequence[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    by_ref: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for row in evidence:
        by_ref[row["evidence_ref"]].append(row)
    output: List[Dict[str, Any]] = []
    for context in contexts:
        if context["context_type"] not in {"REMEDIATION", "ACTION"}:
            continue
        linked = by_ref.get(context["evidence_ref"], [])
        support = (
            float(np.mean([safe_float(x.get("evidence_strength")) for x in linked]))
            if linked else 0.0
        )
        output.append(
            {
                "statement": context["statement"],
                "action_type": context["context_type"],
                "confidence": float(
                    min(0.96, safe_float(context["confidence"]) + 0.05 * support + (0.03 if linked else 0.0))
                ),
                "linked_evidence_refs": sorted({x["evidence_ref"] for x in linked}),
                "supporting_evidence_count": len(linked),
                "evidence_ref": context["evidence_ref"],
            }
        )
    return dedupe_dicts(output, ("statement", "action_type", "evidence_ref"))


def build_relationships(
    entities: Sequence[Dict[str, Any]],
    contexts: Sequence[Dict[str, Any]],
    kvs: Sequence[Dict[str, Any]],
    causes: Sequence[Dict[str, Any]],
    remediations: Sequence[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    by_ref_entities: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    by_ref_contexts: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for entity in entities:
        by_ref_entities[entity["evidence_ref"]].append(entity)
    for context in contexts:
        by_ref_contexts[context["evidence_ref"]].append(context)

    output: List[Dict[str, Any]] = []
    for ref, local_entities in by_ref_entities.items():
        strong = sorted(
            local_entities,
            key=lambda x: safe_float(x.get("confidence")),
            reverse=True,
        )[:8]
        emitted = 0
        for i in range(len(strong)):
            for j in range(i + 1, len(strong)):
                left, right = strong[i], strong[j]
                if left["canonical_name"] == right["canonical_name"]:
                    continue
                if left["entity_type"] == right["entity_type"] == "DOMAIN_CONCEPT":
                    continue
                output.append(
                    {
                        "subject": left["canonical_name"],
                        "predicate": "CO_OBSERVED_WITH",
                        "object": right["canonical_name"],
                        "confidence": float(
                            min(safe_float(left["confidence"]), safe_float(right["confidence"])) * 0.78
                        ),
                        "evidence_ref": ref,
                        "source_ref": "TR292-aligned",
                    }
                )
                emitted += 1
                if emitted >= 8:
                    break
            if emitted >= 8:
                break

    for kv in kvs:
        local_entities = by_ref_entities.get(kv["evidence_ref"], [])
        candidates = [
            entity for entity in local_entities
            if entity["entity_type"] not in {"ACTOR", "CHANNEL_OR_ACTOR"}
        ]
        subject = (
            max(candidates or local_entities, key=lambda x: safe_float(x.get("confidence")))["canonical_name"]
            if local_entities else "interaction"
        )
        obj = f"{kv['normalized_key']}={kv['normalized_value']}" + (
            f" {kv['unit']}" if kv.get("unit") else ""
        )
        output.append(
            {
                "subject": subject,
                "predicate": "HAS_OBSERVATION" if kv.get("unit") else "HAS_ATTRIBUTE",
                "object": obj,
                "confidence": float(min(0.97, safe_float(kv["confidence"]))),
                "evidence_ref": kv["evidence_ref"],
                "source_ref": "TR292D/TR292G" if kv.get("unit") else "TR292G",
            }
        )

    for cause in causes:
        output.append(
            {
                "subject": "observed_issue",
                "predicate": "HAS_POSSIBLE_CAUSE",
                "object": cause["statement"],
                "confidence": cause["confidence"],
                "evidence_ref": cause["evidence_ref"],
                "source_ref": "TR290/TR292-aligned",
            }
        )
    for remediation in remediations:
        output.append(
            {
                "subject": "observed_issue",
                "predicate": "HAS_REMEDIATION",
                "object": remediation["statement"],
                "confidence": remediation["confidence"],
                "evidence_ref": remediation["evidence_ref"],
                "source_ref": "TR292C-aligned",
            }
        )

    for ref, local_contexts in by_ref_contexts.items():
        states = [x for x in local_contexts if x["context_type"] == "STATE"][:3]
        local_entities = by_ref_entities.get(ref, [])
        candidates = [
            entity for entity in local_entities
            if entity["entity_type"] not in {"ACTOR", "CHANNEL_OR_ACTOR"}
        ]
        subject = (
            max(candidates or local_entities, key=lambda x: safe_float(x.get("confidence")))["canonical_name"]
            if local_entities else "interaction"
        )
        for state in states:
            output.append(
                {
                    "subject": subject,
                    "predicate": "HAS_STATE",
                    "object": state["statement"],
                    "confidence": float(safe_float(state["confidence"]) * 0.90),
                    "evidence_ref": ref,
                    "source_ref": "TR292A/TR292G-aligned",
                }
            )
    return dedupe_dicts(output, ("subject", "predicate", "object", "evidence_ref"))


def semantic_signature(record: Dict[str, Any]) -> str:
    tokens: List[str] = []
    for entity in record["entities"]:
        tokens.extend(
            [
                "etype_" + normalize_term(entity["entity_type"]).replace(" ", "_"),
                "entity_" + normalize_term(entity["canonical_name"]).replace(" ", "_"),
            ]
        )
    for context in record["context"]:
        tokens.append("context_" + normalize_term(context["context_type"]).replace(" ", "_"))
    for kv in record["key_values"]:
        tokens.append("kvkey_" + normalize_term(kv["normalized_key"]).replace(" ", "_"))
        if kv.get("unit"):
            tokens.append("unit_" + normalize_term(kv["unit"]).replace(" ", "_"))
    for relation in record["relationships"]:
        tokens.append("relation_" + normalize_term(relation["predicate"]).replace(" ", "_"))
    if record["root_cause"]:
        tokens.append("has_root_cause")
    if record["remediation"]:
        tokens.append("has_remediation")
    return " ".join(sorted(set(x for x in tokens if x and not x.endswith("_"))))


def descriptor_signature(record: Dict[str, Any]) -> str:
    parts = [
        str(entity["canonical_name"])
        for entity in record["entities"]
        if entity["entity_type"] not in {"ACTOR", "CHANNEL_OR_ACTOR", "SYSTEM_OR_SOURCE"}
    ]
    parts.extend(str(kv["normalized_key"]) for kv in record["key_values"])
    parts.extend(
        value.lower().replace("_", " ")
        for value in sorted(set(context["context_type"] for context in record["context"]))
    )
    return " ".join(dict.fromkeys(normalize_space(x) for x in parts if normalize_space(x)))


def ontology_alignment_summary(record: Dict[str, Any], ontology_mode: str) -> Dict[str, Any]:
    refs: Counter[str] = Counter()
    for field_name in ("entities", "relationships"):
        for item in record[field_name]:
            value = str(item.get("source_ref") or "").strip()
            if value:
                refs[value] += 1
    if record["key_values"]:
        refs["TR292D/TR292G"] += len(record["key_values"])
    if record["diagnostic_evidence"]:
        refs["TR292G"] += len(record["diagnostic_evidence"])
    if record["remediation"]:
        refs["TR292C"] += len(record["remediation"])
    return {
        "mode": ontology_mode,
        "aligned_references": dict(refs),
        "formal_graph_semantics_loaded": ontology_mode == "graph_backed_local_ontology",
    }


def build_semantic_view(record: Dict[str, Any], ontology_mode: str) -> Dict[str, Any]:
    actors = sorted({
        entity["canonical_name"]
        for entity in record["entities"]
        if entity["entity_type"] in {"ACTOR", "CHANNEL_OR_ACTOR"}
    })
    concepts = sorted({
        entity["canonical_name"]
        for entity in record["entities"]
        if entity["entity_type"] not in {"ACTOR", "CHANNEL_OR_ACTOR", "SYSTEM_OR_SOURCE"}
    })
    conditions = [
        context["statement"]
        for context in record["context"]
        if context["context_type"] in {"STATE", "SYMPTOM_OR_IMPACT", "TEMPORAL"}
    ]
    functions = [item["statement"] for item in record["remediation"]]
    observations = [item["statement"] for item in record["diagnostic_evidence"]]
    return {
        "common_model_view": {
            "actors": actors,
            "concepts": concepts[:30],
            "conditions": conditions[:30],
            "observations": observations[:30],
            "functions_or_actions": functions[:30],
        },
        "ontology_alignment": ontology_alignment_summary(record, ontology_mode),
    }


def build_interaction_records(
    frame: pd.DataFrame,
    phrase_table: pd.DataFrame,
    ontology: OntologyMatcher,
    ontology_mode: str,
    noise_model: NoiseModel,
    pseudonym_key: bytes,
    policy: str,
) -> List[Dict[str, Any]]:
    records: List[Dict[str, Any]] = []
    for group, block in frame.groupby("_group", sort=False):
        entities: List[Dict[str, Any]] = []
        contexts: List[Dict[str, Any]] = []
        kvs: List[Dict[str, Any]] = []
        clean_parts: List[str] = []
        roles: Counter[str] = Counter()
        upstream: Counter[str] = Counter()

        for _, row in block.iterrows():
            text = str(row["_sanitized_text"])
            role = str(row["_role"])
            ref = str(row["_row_ref"])
            roles[role] += 1
            label = str(row["_upstream_label"] or "")
            if label:
                upstream[label] += 1

            local_kv = extract_key_values(text, ref)
            local_context = context_records(text, ref, role)
            local_entities = extract_entities_for_row(
                text, role, ref, local_kv, phrase_table, ontology
            )
            kvs.extend(local_kv)
            contexts.extend(local_context)
            entities.extend(local_entities)
            clean_parts.append(
                apply_noise_model(text, noise_model)
                if policy == "learned_clean"
                else normalize_term(text)
            )

        entities = dedupe_dicts(entities, ("canonical_name", "entity_type", "evidence_ref"))
        contexts = dedupe_dicts(contexts, ("context_type", "statement", "evidence_ref"))
        kvs = dedupe_dicts(kvs, ("normalized_key", "normalized_value", "unit", "evidence_ref"))
        evidence = build_evidence_records(contexts, kvs)
        causes = build_cause_records(contexts, evidence)
        remediations = build_remediation_records(contexts, evidence)
        relationships = build_relationships(entities, contexts, kvs, causes, remediations)

        record: Dict[str, Any] = {
            "interaction_ref": pseudonymize(group, pseudonym_key),
            "data_split": str(block["data_split"].iloc[0]),
            "roles": dict(roles),
            "upstream_labels_passthrough": dict(upstream),
            "entities": entities,
            "context": contexts,
            "key_values": kvs,
            "diagnostic_evidence": evidence,
            "root_cause": causes,
            "remediation": remediations,
            "relationships": relationships,
            "confidence_summary": {
                "entity_mean": float(np.mean([safe_float(x["confidence"]) for x in entities])) if entities else None,
                "context_mean": float(np.mean([safe_float(x["confidence"]) for x in contexts])) if contexts else None,
                "evidence_strength_mean": float(np.mean([safe_float(x["evidence_strength"]) for x in evidence])) if evidence else None,
                "root_cause_mean": float(np.mean([safe_float(x["confidence"]) for x in causes])) if causes else None,
                "remediation_mean": float(np.mean([safe_float(x["confidence"]) for x in remediations])) if remediations else None,
            },
            "_clean_text": normalize_space(" ".join(clean_parts)),
        }
        record["semantic_signature"] = semantic_signature(record)
        record["_descriptor_text"] = descriptor_signature(record)
        record["semantic_view"] = build_semantic_view(record, ontology_mode)
        records.append(record)
    return records


# ---------------------------------------------------------------------------
# Hybrid representation, semantic coherence and clustering
# ---------------------------------------------------------------------------

class FieldSelector:
    def __init__(self, field_name: str):
        self.field_name = field_name

    def fit(self, X: Sequence[Dict[str, str]], y: Any = None) -> "FieldSelector":
        return self

    def transform(self, X: Sequence[Dict[str, str]]) -> List[str]:
        return [str(row.get(self.field_name, "")) for row in X]

    def get_params(self, deep: bool = True) -> Dict[str, Any]:
        return {"field_name": self.field_name}

    def set_params(self, **params: Any) -> "FieldSelector":
        if "field_name" in params:
            self.field_name = params["field_name"]
        return self


def build_hybrid_vectorizer(config: Config, n_docs: int) -> FeatureUnion:
    min_df = adaptive_min_df(n_docs)
    word = Pipeline(
        [
            ("select", FieldSelector("text")),
            (
                "tfidf",
                TfidfVectorizer(
                    ngram_range=(1, 3),
                    min_df=min_df,
                    max_features=config.max_word_features,
                    sublinear_tf=True,
                    norm="l2",
                    token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b",
                ),
            ),
        ]
    )
    char = Pipeline(
        [
            ("select", FieldSelector("text")),
            (
                "tfidf",
                TfidfVectorizer(
                    analyzer="char_wb",
                    ngram_range=(3, 5),
                    min_df=min_df,
                    max_features=config.max_char_features,
                    sublinear_tf=True,
                    norm="l2",
                ),
            ),
        ]
    )
    semantic = Pipeline(
        [
            ("select", FieldSelector("semantic")),
            (
                "tfidf",
                TfidfVectorizer(
                    ngram_range=(1, 2),
                    min_df=1,
                    max_features=config.max_semantic_features,
                    sublinear_tf=True,
                    norm="l2",
                    token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b",
                ),
            ),
        ]
    )
    return FeatureUnion(
        [("word", word), ("char", char), ("semantic", semantic)],
        transformer_weights={
            "word": config.word_weight,
            "char": config.char_weight,
            "semantic": config.semantic_weight,
        },
    )


def fit_latent(
    texts: Sequence[str], signatures: Sequence[str], config: Config
) -> Tuple[LatentModel, np.ndarray]:
    rows = [{"text": str(t), "semantic": str(s)} for t, s in zip(texts, signatures)]
    vectorizer = build_hybrid_vectorizer(config, len(rows))
    try:
        matrix = vectorizer.fit_transform(rows)
    except ValueError:
        vectorizer = build_hybrid_vectorizer(config, max(2, len(rows)))
        for _, pipeline in vectorizer.transformer_list:
            if hasattr(pipeline, "named_steps") and "tfidf" in pipeline.named_steps:
                pipeline.named_steps["tfidf"].set_params(min_df=1)
        matrix = vectorizer.fit_transform(rows)

    n_components = min(config.svd_components, matrix.shape[0] - 1, matrix.shape[1] - 1)
    if n_components < 2:
        raise RuntimeError("Insufficient samples/features for latent representation.")

    svd = TruncatedSVD(n_components=n_components, random_state=config.seed)
    latent = svd.fit_transform(matrix)
    normalizer = Normalizer(copy=False)
    latent = normalizer.fit_transform(latent)
    return (
        LatentModel(vectorizer, svd, normalizer, config.transform_batch_size),
        np.asarray(latent, dtype=np.float32),
    )


def safe_silhouette_details(
    vectors: np.ndarray,
    labels: np.ndarray,
    seed: int,
    max_rows: int = 3000,
) -> Tuple[Optional[float], Optional[float], int]:
    mask = labels != -1
    valid_indices = np.flatnonzero(mask)
    if len(valid_indices) < 3 or len(set(labels[mask].tolist())) < 2:
        return None, None, 0

    rng = np.random.default_rng(seed)
    if len(valid_indices) > max_rows:
        valid_indices = np.sort(rng.choice(valid_indices, max_rows, replace=False))
    sample_vectors = vectors[valid_indices]
    sample_labels = labels[valid_indices]
    try:
        samples = silhouette_samples(sample_vectors, sample_labels, metric="cosine")
        mean = float(np.mean(samples))
        se = float(np.std(samples, ddof=1) / math.sqrt(max(len(samples), 1))) if len(samples) > 1 else 0.0
        if not np.isfinite(mean):
            return None, None, 0
        return mean, se, len(samples)
    except Exception:
        try:
            mean = float(
                silhouette_score(
                    sample_vectors,
                    sample_labels,
                    metric="cosine",
                    random_state=seed,
                )
            )
            return mean if np.isfinite(mean) else None, None, len(sample_vectors)
        except Exception:
            return None, None, 0


def cluster_entropy(labels: np.ndarray) -> float:
    valid = labels[labels != -1]
    if not len(valid):
        return 0.0
    counts = np.asarray(list(Counter(valid.tolist()).values()), dtype=float)
    probabilities = counts / counts.sum()
    return float(
        -np.sum(probabilities * np.log(probabilities + 1e-12))
        / max(math.log(max(len(counts), 2)), 1e-12)
    )


def binomial_standard_error(probability: float, n: int) -> float:
    if n <= 0:
        return 0.0
    p = float(np.clip(probability, 0.0, 1.0))
    return float(math.sqrt(max(p * (1.0 - p), 0.0) / n))


def descriptor_allowed(term: str, noise_model: NoiseModel) -> bool:
    normalized = normalize_term(term)
    if not normalized or normalized in noise_model.descriptor_blocklist:
        return False
    toks = normalized.split()
    if any(token in STRUCTURAL_TOKENS or token.startswith("redacted") for token in toks):
        return False
    content = [
        token for token in toks
        if token not in noise_model.learned_stopwords
        and token not in STRUCTURAL_TOKENS
    ]
    return len(content) >= (1 if len(toks) == 1 else 2)


def _pair_npmi(binary_matrix: sparse.csr_matrix, left: int, right: int) -> Optional[float]:
    n_docs = binary_matrix.shape[0]
    if n_docs <= 1:
        return None
    left_col = binary_matrix[:, left]
    right_col = binary_matrix[:, right]
    left_df = float(left_col.sum())
    right_df = float(right_col.sum())
    co_df = float(left_col.multiply(right_col).sum())
    if left_df <= 0 or right_df <= 0 or co_df <= 0:
        return None
    p_left = left_df / n_docs
    p_right = right_df / n_docs
    p_both = co_df / n_docs
    denominator = -math.log(max(p_both, 1e-12))
    if denominator <= 1e-12:
        return None
    return float(np.clip(math.log(p_both / max(p_left * p_right, 1e-12)) / denominator, -1.0, 1.0))


def semantic_coherence_details(
    texts: Sequence[str],
    labels: np.ndarray,
    noise_model: NoiseModel,
    top_terms: int,
    seed: int,
    bootstrap_repeats: int,
) -> Tuple[Optional[float], Optional[float], pd.DataFrame]:
    valid_mask = labels != -1
    if int(valid_mask.sum()) < 3 or len(set(labels[valid_mask].tolist())) < 2:
        return None, None, pd.DataFrame()

    values = [str(x) for x in texts]
    min_df = max(2, adaptive_min_df(len(values)))
    vectorizer = CountVectorizer(
        ngram_range=(1, 2),
        min_df=min_df,
        binary=True,
        max_features=50000,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b",
    )
    try:
        matrix = vectorizer.fit_transform(values).tocsr()
    except ValueError:
        vectorizer.set_params(min_df=1)
        try:
            matrix = vectorizer.fit_transform(values).tocsr()
        except ValueError:
            return None, None, pd.DataFrame()

    terms = np.asarray(vectorizer.get_feature_names_out())
    allowed = np.asarray([descriptor_allowed(str(term), noise_model) for term in terms], dtype=bool)
    rows: List[Dict[str, Any]] = []

    for cluster_id in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cluster_id)
        if len(idx) < 3:
            continue
        local = matrix[idx]
        local_df = np.asarray(local.sum(axis=0)).ravel().astype(float)
        global_df = np.asarray(matrix.sum(axis=0)).ravel().astype(float)
        specificity = np.log(
            (local_df + 0.5) / max(len(idx), 1)
        ) - np.log(
            (np.maximum(global_df - local_df, 0.0) + 0.5)
            / max(len(values) - len(idx), 1)
        )
        specificity[~allowed] = -np.inf
        selected = [
            int(i) for i in np.argsort(specificity)[::-1]
            if np.isfinite(specificity[i]) and local_df[i] > 0
        ][:max(3, top_terms)]
        if len(selected) < 2:
            continue

        pair_values: List[float] = []
        for i in range(len(selected)):
            for j in range(i + 1, len(selected)):
                value = _pair_npmi(local, selected[i], selected[j])
                if value is not None and np.isfinite(value):
                    pair_values.append(value)
        if not pair_values:
            continue
        rows.append(
            {
                "cluster_id": cluster_id,
                "count": len(idx),
                "coherence_npmi": float(np.mean(pair_values)),
                "pair_count": len(pair_values),
                "top_terms": "; ".join(str(terms[i]) for i in selected),
            }
        )

    details = pd.DataFrame(rows)
    if details.empty:
        return None, None, details

    weights = details["count"].to_numpy(dtype=float)
    values_arr = details["coherence_npmi"].to_numpy(dtype=float)
    weighted_mean = float(np.average(values_arr, weights=weights))

    if len(details) == 1 or bootstrap_repeats <= 1:
        return weighted_mean, 0.0, details

    rng = np.random.default_rng(seed)
    probabilities = weights / weights.sum()
    boot = []
    for _ in range(bootstrap_repeats):
        sampled = rng.choice(len(details), size=len(details), replace=True, p=probabilities)
        boot.append(float(np.mean(values_arr[sampled])))
    se = float(np.std(boot, ddof=1)) if len(boot) > 1 else 0.0
    return weighted_mean, se, details


def candidate_metrics(
    vectors: np.ndarray,
    labels: np.ndarray,
    seed: int,
    texts: Optional[Sequence[str]] = None,
    noise_model: Optional[NoiseModel] = None,
    config: Optional[Config] = None,
) -> Dict[str, Any]:
    valid = labels[labels != -1]
    largest = max(Counter(valid.tolist()).values()) / len(valid) if len(valid) else 1.0
    silhouette, silhouette_se, silhouette_n = safe_silhouette_details(vectors, labels, seed)
    assigned_fraction = float(np.mean(labels != -1)) if len(labels) else 0.0
    result: Dict[str, Any] = {
        "silhouette": float(silhouette) if silhouette is not None else np.nan,
        "silhouette_standard_error": silhouette_se,
        "silhouette_evaluated_rows": silhouette_n,
        "assigned_fraction": assigned_fraction,
        "assigned_fraction_standard_error": binomial_standard_error(assigned_fraction, len(labels)),
        "noise_rate": float(np.mean(labels == -1)) if len(labels) else 1.0,
        "balance_entropy": cluster_entropy(labels),
        "n_clusters": float(len(set(valid.tolist()))),
        "largest_cluster_share": float(largest),
    }
    if texts is not None and noise_model is not None and config is not None:
        coherence, coherence_se, _ = semantic_coherence_details(
            texts,
            labels,
            noise_model,
            config.coherence_top_terms,
            seed + 911,
            config.coherence_bootstrap_repeats,
        )
        result["semantic_coherence_npmi"] = coherence
        result["semantic_coherence_standard_error"] = coherence_se
    return result


def derive_hdbscan_grid(n_rows: int, trials: int) -> List[Dict[str, Any]]:
    if n_rows < 8:
        return []
    root = math.sqrt(n_rows)
    logn = math.log2(max(n_rows, 4))
    min_cluster_sizes = sorted(
        set(
            max(5, min(max(5, n_rows // 3), int(round(value))))
            for value in (1.5 * logn, 0.30 * root, 0.50 * root, 0.80 * root)
        )
    )
    rows: List[Dict[str, Any]] = []
    for min_cluster_size in min_cluster_sizes:
        min_samples_values = sorted(
            set(
                max(2, min(min_cluster_size, int(round(value))))
                for value in (logn, math.sqrt(min_cluster_size), min_cluster_size / 3.0)
            )
        )
        for min_samples in min_samples_values:
            for method in ("eom", "leaf"):
                rows.append(
                    {
                        "min_cluster_size": min_cluster_size,
                        "min_samples": min_samples,
                        "cluster_selection_method": method,
                    }
                )
    if len(rows) <= trials:
        return rows
    indices = np.linspace(0, len(rows) - 1, trials).round().astype(int)
    return [rows[i] for i in sorted(set(indices.tolist()))]


def derive_umap_grid(n_rows: int, trials: int) -> List[Dict[str, Any]]:
    base = derive_hdbscan_grid(n_rows, max(4, trials // 2))
    root = math.sqrt(max(n_rows, 4))
    logn = math.log2(max(n_rows, 4))
    neighbors = sorted(
        set(
            min(n_rows - 1, max(5, int(round(value))))
            for value in (logn, 2 * logn, root * 0.5, root)
        )
    )
    dimensions = sorted(
        set(max(2, int(round(value))) for value in (5, logn, min(15, 1.5 * logn)))
    )
    rows = [
        {
            **params,
            "n_neighbors": n_neighbors,
            "n_components": n_components,
            "min_dist": 0.0,
        }
        for params in base
        for n_neighbors in neighbors
        for n_components in dimensions
    ]
    if len(rows) <= trials:
        return rows
    indices = np.linspace(0, len(rows) - 1, trials).round().astype(int)
    return [rows[i] for i in sorted(set(indices.tolist()))]


def fit_direct_hdbscan_once(
    vectors: np.ndarray, params: Dict[str, Any]
) -> Tuple[Any, np.ndarray, np.ndarray]:
    from hdbscan import HDBSCAN

    clusterer = HDBSCAN(
        min_cluster_size=int(params["min_cluster_size"]),
        min_samples=int(params["min_samples"]),
        metric="euclidean",
        cluster_selection_method=str(params["cluster_selection_method"]),
        prediction_data=True,
        core_dist_n_jobs=-1,
    )
    labels = clusterer.fit_predict(vectors).astype(int)
    strengths = np.asarray(clusterer.probabilities_, dtype=float)
    return clusterer, labels, strengths


def fit_umap_hdbscan_once(
    vectors: np.ndarray,
    params: Dict[str, Any],
    seed: int,
) -> Tuple[Any, Any, np.ndarray, np.ndarray]:
    from hdbscan import HDBSCAN
    from umap import UMAP

    reducer = UMAP(
        n_neighbors=int(params["n_neighbors"]),
        n_components=int(params["n_components"]),
        min_dist=float(params["min_dist"]),
        metric="cosine",
        random_state=seed,
        transform_seed=seed,
        low_memory=True,
    )
    reduced = reducer.fit_transform(vectors)
    clusterer = HDBSCAN(
        min_cluster_size=int(params["min_cluster_size"]),
        min_samples=int(params["min_samples"]),
        metric="euclidean",
        cluster_selection_method=str(params["cluster_selection_method"]),
        prediction_data=True,
        core_dist_n_jobs=-1,
    )
    labels = clusterer.fit_predict(reduced).astype(int)
    strengths = np.asarray(clusterer.probabilities_, dtype=float)
    return reducer, clusterer, labels, strengths


def stability_for_candidate(
    vectors: np.ndarray,
    method: str,
    params: Dict[str, Any],
    seed: int,
    repeats: int,
) -> Tuple[float, float]:
    if len(vectors) < 10:
        return 0.0, 0.0
    n_rows = len(vectors)
    sample_n = max(8, int(round(0.85 * n_rows)))
    runs: List[Tuple[np.ndarray, np.ndarray]] = []
    for repeat in range(max(2, repeats)):
        rng = np.random.default_rng(seed + repeat * 1009)
        indices = np.sort(rng.choice(n_rows, sample_n, replace=False))
        local = dict(params)
        ratio = sample_n / n_rows
        local["min_cluster_size"] = max(
            5,
            min(max(5, sample_n // 3), int(round(local["min_cluster_size"] * ratio))),
        )
        local["min_samples"] = max(
            2,
            min(local["min_cluster_size"], int(round(local["min_samples"] * ratio))),
        )
        try:
            if method == "direct_hdbscan":
                _, labels, _ = fit_direct_hdbscan_once(vectors[indices], local)
            else:
                local["n_neighbors"] = min(int(local["n_neighbors"]), sample_n - 1)
                _, _, labels, _ = fit_umap_hdbscan_once(
                    vectors[indices], local, seed + repeat * 97
                )
            runs.append((indices, labels))
        except Exception:
            continue

    aris: List[float] = []
    jaccards: List[float] = []
    for i in range(len(runs)):
        for j in range(i + 1, len(runs)):
            left_idx, left_labels = runs[i]
            right_idx, right_labels = runs[j]
            common, left_pos, right_pos = np.intersect1d(
                left_idx, right_idx, return_indices=True
            )
            if len(common) < 3:
                continue
            left = left_labels[left_pos]
            right = right_labels[right_pos]
            aris.append(float(adjusted_rand_score(left, right)))
            left_outliers = set(np.flatnonzero(left == -1).tolist())
            right_outliers = set(np.flatnonzero(right == -1).tolist())
            union = left_outliers | right_outliers
            jaccards.append(
                1.0 if not union else len(left_outliers & right_outliers) / len(union)
            )
    return (
        float(np.mean(aris)) if aris else 0.0,
        float(np.mean(jaccards)) if jaccards else 0.0,
    )


def fit_kmeans_fallback(
    vectors: np.ndarray,
    texts: Sequence[str],
    noise_model: NoiseModel,
    config: Config,
) -> Tuple[ClusterModel, np.ndarray, np.ndarray, pd.DataFrame]:
    rows: List[Dict[str, Any]] = []
    models: Dict[int, Any] = {}
    max_k = max(2, min(40, int(round(math.sqrt(max(len(vectors), 4))))))
    for k in range(2, max_k + 1):
        model = MiniBatchKMeans(
            n_clusters=k,
            random_state=config.seed,
            batch_size=min(4096, max(128, len(vectors))),
            n_init="auto",
        )
        labels = model.fit_predict(vectors).astype(int)
        metrics = candidate_metrics(
            vectors, labels, config.seed, texts, noise_model, config
        )
        if np.isfinite(safe_float(metrics.get("silhouette"), np.nan)):
            rows.append({"method": "minibatch_kmeans", "k": k, **metrics})
            models[k] = model
    table = pd.DataFrame(rows)
    if table.empty:
        raise RuntimeError("Unable to fit clustering fallback.")
    table["score"] = pd.concat(
        [
            percentile_rank(table["silhouette"], True),
            percentile_rank(table["semantic_coherence_npmi"], True),
            percentile_rank(table["balance_entropy"], True),
            percentile_rank(table["largest_cluster_share"], False),
        ],
        axis=1,
    ).mean(axis=1)
    best = table.sort_values("score", ascending=False).iloc[0]
    model = models[int(best["k"])]
    labels = model.predict(vectors).astype(int)
    strengths = 1.0 / (1.0 + np.min(model.transform(vectors), axis=1))
    cluster_model = ClusterModel(
        "minibatch_kmeans",
        None,
        model,
        {"k": int(best["k"])},
        safe_float(best["silhouette"]),
        1.0,
        None,
        None,
    )
    return cluster_model, labels, strengths, table.sort_values("score", ascending=False).reset_index(drop=True)


def fit_cluster_search(
    vectors: np.ndarray,
    texts: Sequence[str],
    noise_model: NoiseModel,
    config: Config,
) -> Tuple[ClusterModel, np.ndarray, np.ndarray, pd.DataFrame]:
    if importlib.util.find_spec("hdbscan") is None:
        if config.profile == "production":
            raise RuntimeError("Production profile requires hdbscan.")
        LOGGER.warning("HDBSCAN unavailable in fast-development profile; using MiniBatchKMeans fallback.")
        return fit_kmeans_fallback(vectors, texts, noise_model, config)

    if config.search_sample_rows > 0 and len(vectors) > config.search_sample_rows:
        rng = np.random.default_rng(config.seed)
        search_idx = np.sort(
            rng.choice(len(vectors), config.search_sample_rows, replace=False)
        )
        search_vectors = vectors[search_idx]
        search_texts = [texts[i] for i in search_idx.tolist()]
    else:
        search_vectors = vectors
        search_texts = list(texts)

    rows: List[Dict[str, Any]] = []
    direct_trials = max(4, config.model_search_trials // 2)
    for params in derive_hdbscan_grid(len(search_vectors), direct_trials):
        try:
            _, labels, _ = fit_direct_hdbscan_once(search_vectors, params)
            metrics = candidate_metrics(search_vectors, labels, config.seed)
            if metrics["n_clusters"] >= 2 and np.isfinite(safe_float(metrics["silhouette"], np.nan)):
                rows.append({"method": "direct_hdbscan", **params, **metrics})
        except Exception:
            continue

    if importlib.util.find_spec("umap") is not None:
        for params in derive_umap_grid(
            len(search_vectors), max(4, config.model_search_trials - direct_trials)
        ):
            try:
                _, _, labels, _ = fit_umap_hdbscan_once(
                    search_vectors, params, config.seed
                )
                metrics = candidate_metrics(search_vectors, labels, config.seed)
                if metrics["n_clusters"] >= 2 and np.isfinite(safe_float(metrics["silhouette"], np.nan)):
                    rows.append({"method": "umap_hdbscan", **params, **metrics})
            except Exception:
                continue

    if not rows:
        if config.profile == "production":
            raise RuntimeError("No valid density-clustering candidate was found.")
        return fit_kmeans_fallback(vectors, texts, noise_model, config)

    table = pd.DataFrame(rows)
    table["coarse_score"] = pd.concat(
        [
            percentile_rank(table["silhouette"], True),
            percentile_rank(table["balance_entropy"], True),
            percentile_rank(table["largest_cluster_share"], False),
            percentile_rank(table["assigned_fraction"], True),
        ],
        axis=1,
    ).mean(axis=1)
    table["stability_ari"] = np.nan
    table["outlier_jaccard"] = np.nan
    table["semantic_coherence_npmi"] = np.nan
    table["semantic_coherence_standard_error"] = np.nan

    top_indices = table.nlargest(
        min(len(table), max(2, int(round(math.sqrt(len(table)))))),
        "coarse_score",
    ).index.tolist()
    for index in top_indices:
        method = str(table.at[index, "method"])
        params: Dict[str, Any] = {
            "min_cluster_size": int(table.at[index, "min_cluster_size"]),
            "min_samples": int(table.at[index, "min_samples"]),
            "cluster_selection_method": str(table.at[index, "cluster_selection_method"]),
        }
        if method == "umap_hdbscan":
            params.update(
                {
                    "n_neighbors": int(table.at[index, "n_neighbors"]),
                    "n_components": int(table.at[index, "n_components"]),
                    "min_dist": float(table.at[index, "min_dist"]),
                }
            )
        ari, jaccard = stability_for_candidate(
            search_vectors,
            method,
            params,
            config.seed + 303,
            config.stability_repeats,
        )
        table.at[index, "stability_ari"] = ari
        table.at[index, "outlier_jaccard"] = jaccard

        try:
            if method == "direct_hdbscan":
                _, labels, _ = fit_direct_hdbscan_once(search_vectors, params)
            else:
                _, _, labels, _ = fit_umap_hdbscan_once(search_vectors, params, config.seed)
            coherence, coherence_se, _ = semantic_coherence_details(
                search_texts,
                labels,
                noise_model,
                config.coherence_top_terms,
                config.seed + 509,
                min(config.coherence_bootstrap_repeats, 100),
            )
            table.at[index, "semantic_coherence_npmi"] = coherence
            table.at[index, "semantic_coherence_standard_error"] = coherence_se
        except Exception:
            pass

    table["score"] = pd.concat(
        [
            percentile_rank(table["silhouette"], True),
            percentile_rank(table["semantic_coherence_npmi"], True),
            percentile_rank(table["balance_entropy"], True),
            percentile_rank(table["largest_cluster_share"], False),
            percentile_rank(table["assigned_fraction"], True),
            percentile_rank(table["stability_ari"], True),
            percentile_rank(table["outlier_jaccard"], True),
        ],
        axis=1,
    ).mean(axis=1)

    best = table.sort_values("score", ascending=False).iloc[0]
    method = str(best["method"])
    params = {
        "min_cluster_size": int(best["min_cluster_size"]),
        "min_samples": int(best["min_samples"]),
        "cluster_selection_method": str(best["cluster_selection_method"]),
    }
    if method == "umap_hdbscan":
        params.update(
            {
                "n_neighbors": int(best["n_neighbors"]),
                "n_components": int(best["n_components"]),
                "min_dist": float(best["min_dist"]),
            }
        )

    if len(search_vectors) < len(vectors):
        ratio = len(vectors) / len(search_vectors)
        params["min_cluster_size"] = max(
            5,
            min(max(5, len(vectors) // 3), int(round(params["min_cluster_size"] * ratio))),
        )
        params["min_samples"] = max(
            2,
            min(params["min_cluster_size"], int(round(params["min_samples"] * ratio))),
        )
        if method == "umap_hdbscan":
            params["n_neighbors"] = min(params["n_neighbors"], len(vectors) - 1)

    if method == "direct_hdbscan":
        clusterer, labels, strengths = fit_direct_hdbscan_once(vectors, params)
        reducer = None
    else:
        reducer, clusterer, labels, strengths = fit_umap_hdbscan_once(
            vectors, params, config.seed
        )

    metrics = candidate_metrics(
        vectors,
        labels,
        config.seed,
        texts,
        noise_model,
        config,
    )
    ari, jaccard = stability_for_candidate(
        vectors,
        method,
        params,
        config.seed + 707,
        config.stability_repeats,
    )
    cluster_model = ClusterModel(
        method=method,
        reducer=reducer,
        clusterer=clusterer,
        parameters=params,
        silhouette=(
            float(metrics["silhouette"])
            if np.isfinite(safe_float(metrics.get("silhouette"), np.nan))
            else None
        ),
        assigned_fraction=float(metrics["assigned_fraction"]),
        stability_ari=ari,
        outlier_jaccard=jaccard,
    )
    return cluster_model, labels, strengths, table.sort_values("score", ascending=False).reset_index(drop=True)


def predict_cluster(model: ClusterModel, vectors: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
    if not len(vectors):
        return np.asarray([], dtype=int), np.asarray([], dtype=float)
    if model.method in {"direct_hdbscan", "umap_hdbscan"}:
        from hdbscan.prediction import approximate_predict

        data = vectors if model.reducer is None else model.reducer.transform(vectors)
        labels, strengths = approximate_predict(model.clusterer, data)
        return labels.astype(int), strengths.astype(float)
    labels = model.clusterer.predict(vectors).astype(int)
    strengths = 1.0 / (1.0 + np.min(model.clusterer.transform(vectors), axis=1))
    return labels, strengths


def evaluation_metrics(
    model: ClusterModel,
    latent: LatentModel,
    records: Sequence[Dict[str, Any]],
    noise_model: NoiseModel,
    config: Config,
) -> Tuple[Dict[str, Any], np.ndarray, np.ndarray, np.ndarray, pd.DataFrame]:
    if not records:
        return {}, np.empty((0, 0)), np.asarray([], dtype=int), np.asarray([], dtype=float), pd.DataFrame()
    texts = [record["_clean_text"] for record in records]
    signatures = [record["semantic_signature"] for record in records]
    vectors = latent.transform(texts, signatures)
    labels, strengths = predict_cluster(model, vectors)
    metrics = candidate_metrics(
        vectors,
        labels,
        config.seed,
        texts,
        noise_model,
        config,
    )
    metrics["mean_strength"] = (
        float(np.mean(strengths[labels != -1])) if np.any(labels != -1) else np.nan
    )
    _, _, coherence_details = semantic_coherence_details(
        texts,
        labels,
        noise_model,
        config.coherence_top_terms,
        config.seed + 1013,
        config.coherence_bootstrap_repeats,
    )
    return metrics, vectors, labels, strengths, coherence_details


def policy_quality_score(
    train_metrics: Mapping[str, Any],
    validation_metrics: Mapping[str, Any],
    cluster_model: ClusterModel,
) -> float:
    # Selection is validation-led. Weights are only an internal ranking device;
    # semantic validation is reported separately by the quality gate.
    validation_silhouette = safe_float(validation_metrics.get("silhouette"), -1.0)
    validation_coherence = safe_float(validation_metrics.get("semantic_coherence_npmi"), -1.0)
    validation_assigned = safe_float(validation_metrics.get("assigned_fraction"), 0.0)
    validation_balance = safe_float(validation_metrics.get("balance_entropy"), 0.0)
    validation_largest = safe_float(validation_metrics.get("largest_cluster_share"), 1.0)
    train_silhouette = safe_float(train_metrics.get("silhouette"), -1.0)
    stability = safe_float(cluster_model.stability_ari, 0.0)
    return float(
        0.30 * validation_silhouette
        + 0.24 * validation_coherence
        + 0.12 * validation_assigned
        + 0.10 * validation_balance
        + 0.08 * (1.0 - validation_largest)
        + 0.08 * train_silhouette
        + 0.08 * stability
    )


def fit_policy(
    policy: str,
    development_frame: pd.DataFrame,
    phrase_table: pd.DataFrame,
    ontology: OntologyMatcher,
    ontology_mode: str,
    noise_model: NoiseModel,
    key: bytes,
    config: Config,
) -> Tuple[PolicyResult, List[Dict[str, Any]]]:
    records = build_interaction_records(
        development_frame,
        phrase_table,
        ontology,
        ontology_mode,
        noise_model,
        key,
        policy,
    )
    train_records = [record for record in records if record["data_split"] == "train"]
    validation_records = [record for record in records if record["data_split"] == "validation"]
    if len(train_records) < 20:
        raise RuntimeError(f"Too few training interactions after grouping: {len(train_records)}")

    train_texts = [record["_clean_text"] for record in train_records]
    train_signatures = [record["semantic_signature"] for record in train_records]
    latent, vectors = fit_latent(train_texts, train_signatures, config)
    cluster_model, labels, strengths, search_table = fit_cluster_search(
        vectors, train_texts, noise_model, config
    )
    train_metrics = candidate_metrics(
        vectors,
        labels,
        config.seed,
        train_texts,
        noise_model,
        config,
    )
    train_metrics["mean_strength"] = (
        float(np.mean(strengths[labels != -1])) if np.any(labels != -1) else np.nan
    )
    validation_metrics, _, _, _, _ = evaluation_metrics(
        cluster_model,
        latent,
        validation_records,
        noise_model,
        config,
    )
    score = policy_quality_score(train_metrics, validation_metrics, cluster_model)
    result = PolicyResult(
        policy=policy,
        latent=latent,
        cluster_model=cluster_model,
        train_vectors=vectors,
        train_labels=labels,
        train_strengths=strengths,
        train_metrics=train_metrics,
        validation_metrics=validation_metrics,
        search_table=search_table,
        score=score,
    )
    return result, records


def build_policy_table(results: Sequence[PolicyResult]) -> pd.DataFrame:
    rows = []
    for result in results:
        rows.append(
            {
                "policy": result.policy,
                "score": result.score,
                "train_silhouette": result.train_metrics.get("silhouette"),
                "train_semantic_coherence": result.train_metrics.get("semantic_coherence_npmi"),
                "validation_silhouette": result.validation_metrics.get("silhouette"),
                "validation_semantic_coherence": result.validation_metrics.get("semantic_coherence_npmi"),
                "validation_assigned_fraction": result.validation_metrics.get("assigned_fraction"),
                "validation_noise_rate": result.validation_metrics.get("noise_rate"),
                "validation_balance_entropy": result.validation_metrics.get("balance_entropy"),
                "validation_largest_cluster_share": result.validation_metrics.get("largest_cluster_share"),
                "stability_ari": result.cluster_model.stability_ari,
                "outlier_jaccard": result.cluster_model.outlier_jaccard,
                "cluster_method": result.cluster_model.method,
            }
        )
    return pd.DataFrame(rows).sort_values("score", ascending=False).reset_index(drop=True)


def combined_standard_error(left: Mapping[str, Any], right: Mapping[str, Any], key: str) -> float:
    left_se = safe_float(left.get(key), 0.0)
    right_se = safe_float(right.get(key), 0.0)
    return float(math.sqrt(left_se * left_se + right_se * right_se))


def choose_policy(results: Sequence[PolicyResult]) -> Tuple[PolicyResult, Dict[str, Any]]:
    if not results:
        raise RuntimeError("No clustering policy result is available.")
    ranked = sorted(results, key=lambda result: result.score, reverse=True)
    best = ranked[0]
    raw = next((result for result in results if result.policy == "raw"), None)
    clean = next((result for result in results if result.policy == "learned_clean"), None)
    decision = {
        "selected": best.policy,
        "selection_basis": "train_and_validation_only",
        "guard_applied": False,
        "guard_reason": None,
    }

    if raw is None or clean is None or best.policy != "learned_clean":
        return best, decision

    sil_tolerance = 1.96 * combined_standard_error(
        raw.validation_metrics,
        clean.validation_metrics,
        "silhouette_standard_error",
    )
    coherence_tolerance = 1.96 * combined_standard_error(
        raw.validation_metrics,
        clean.validation_metrics,
        "semantic_coherence_standard_error",
    )
    raw_sil = safe_float(raw.validation_metrics.get("silhouette"), -1.0)
    clean_sil = safe_float(clean.validation_metrics.get("silhouette"), -1.0)
    raw_coh = safe_float(raw.validation_metrics.get("semantic_coherence_npmi"), -1.0)
    clean_coh = safe_float(clean.validation_metrics.get("semantic_coherence_npmi"), -1.0)

    if clean_sil < raw_sil - sil_tolerance:
        decision.update(
            {
                "selected": "raw",
                "guard_applied": True,
                "guard_reason": "clean_policy_silhouette_regression",
                "silhouette_tolerance": sil_tolerance,
            }
        )
        return raw, decision
    if clean_coh < raw_coh - coherence_tolerance:
        decision.update(
            {
                "selected": "raw",
                "guard_applied": True,
                "guard_reason": "clean_policy_semantic_coherence_regression",
                "semantic_coherence_tolerance": coherence_tolerance,
            }
        )
        return raw, decision
    return best, decision


# ---------------------------------------------------------------------------
# Descriptors, cluster diagnostics and quality gate
# ---------------------------------------------------------------------------

def _jaccard_terms(left: str, right: str) -> float:
    a, b = set(left.split()), set(right.split())
    return len(a & b) / max(len(a | b), 1)


def cluster_descriptions(
    descriptor_texts: Sequence[str],
    cleaned_texts: Sequence[str],
    labels: np.ndarray,
    noise_model: NoiseModel,
    phrase_table: pd.DataFrame,
    top_n: int,
) -> Dict[int, Dict[str, Any]]:
    cluster_ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if not cluster_ids:
        return {}

    documents = [
        normalize_space(f"{descriptor_texts[i]} {cleaned_texts[i]}")
        for i in range(len(cleaned_texts))
    ]
    vectorizer = CountVectorizer(
        ngram_range=(1, 3),
        min_df=1,
        max_features=70000,
        binary=False,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b",
    )
    matrix = vectorizer.fit_transform(documents).tocsr().astype(np.float64)
    terms = np.asarray(vectorizer.get_feature_names_out())
    order = np.asarray([str(term).count(" ") + 1 for term in terms], dtype=int)
    allowed = np.asarray([descriptor_allowed(str(term), noise_model) for term in terms], dtype=bool)

    phrase_bonus: Dict[str, float] = {}
    if not phrase_table.empty:
        for rec in phrase_table.itertuples(index=False):
            if bool(getattr(rec, "selected_as_domain_signal", False)):
                phrase_bonus[str(rec.phrase)] = safe_float(getattr(rec, "phrase_score", 0.0))

    binary = (matrix > 0).astype(np.int8)
    total_df = np.asarray(binary.sum(axis=0)).ravel().astype(float)
    n_docs = len(documents)
    output: Dict[int, Dict[str, Any]] = {}

    for cluster_id in cluster_ids:
        mask = labels == cluster_id
        local = matrix[mask]
        local_binary = binary[mask]
        local_count = int(mask.sum())
        local_tf = np.asarray(local.sum(axis=0)).ravel().astype(float)
        tf_total = max(float(local_tf.sum()), 1.0)
        local_tf /= tf_total

        class_presence = []
        for other_id in cluster_ids:
            class_presence.append(
                np.asarray((matrix[labels == other_id] > 0).sum(axis=0)).ravel() > 0
            )
        class_df = np.sum(np.vstack(class_presence), axis=0).astype(float)
        ctfidf = local_tf * (np.log((1.0 + len(cluster_ids)) / (1.0 + class_df)) + 1.0)

        local_df = np.asarray(local_binary.sum(axis=0)).ravel().astype(float)
        outside_df = total_df - local_df
        alpha = 0.5
        log_odds = np.log(
            (local_df + alpha) / np.maximum(local_count - local_df + alpha, 1e-9)
        ) - np.log(
            (outside_df + alpha)
            / np.maximum((n_docs - local_count) - outside_df + alpha, 1e-9)
        )
        log_odds_unit = 1.0 / (1.0 + np.exp(-np.clip(log_odds, -20, 20)))

        score = ctfidf * (0.65 + 0.35 * log_odds_unit)
        score *= 1.0 + 0.10 * np.maximum(order - 1, 0)
        for index, term in enumerate(terms.tolist()):
            if term in phrase_bonus:
                score[index] *= 1.0 + 0.30 * phrase_bonus[term]
        score[~allowed] = 0.0

        candidates = [
            int(index) for index in np.argsort(score)[::-1]
            if score[index] > 0
        ]
        chosen: List[int] = []
        for index in candidates:
            term = str(terms[index])
            if any(_jaccard_terms(term, str(terms[old])) > 0.68 for old in chosen):
                continue
            # Multiword expressions are preferred when the score is close.
            if order[index] == 1:
                nearby_multi = [
                    j for j in candidates[:40]
                    if order[j] > 1 and term in str(terms[j]).split() and score[j] >= 0.72 * score[index]
                ]
                if nearby_multi:
                    continue
            chosen.append(index)
            if len(chosen) >= top_n:
                break

        keywords = [
            {
                "term": str(terms[index]),
                "weight": float(score[index]),
                "ngram_order": int(order[index]),
            }
            for index in chosen
        ]
        output[cluster_id] = {
            "descriptor": " | ".join(item["term"] for item in keywords[:5]) or f"cluster_{cluster_id}",
            "keywords": keywords,
        }
    return output


def descriptor_contamination(
    descriptions: Dict[int, Dict[str, Any]],
    noise_model: NoiseModel,
) -> float:
    terms = [
        str(item["term"])
        for payload in descriptions.values()
        for item in payload.get("keywords", [])
    ]
    if not terms:
        return float("nan")
    return float(
        sum(1 for term in terms if not descriptor_allowed(term, noise_model)) / len(terms)
    )


def cluster_catalog(
    records: Sequence[Dict[str, Any]],
    vectors: np.ndarray,
    labels: np.ndarray,
    strengths: np.ndarray,
    descriptions: Dict[int, Dict[str, Any]],
    coherence_details: pd.DataFrame,
    config: Config,
) -> pd.DataFrame:
    rows: List[Dict[str, Any]] = []
    assigned = max(int(np.sum(labels != -1)), 1)
    coherence_map = (
        coherence_details.set_index("cluster_id").to_dict(orient="index")
        if not coherence_details.empty and "cluster_id" in coherence_details.columns
        else {}
    )
    for cluster_id in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cluster_id)
        centroid = vectors[idx].mean(axis=0)
        norm = float(np.linalg.norm(centroid))
        if norm > 0:
            centroid = centroid / norm
        similarities = vectors[idx] @ centroid
        cohesion = float(np.mean(similarities)) if len(idx) else np.nan
        representative_order = idx[
            np.argsort(similarities)[::-1][:config.representative_examples]
        ]
        examples = [
            {
                "interaction_ref": records[pos]["interaction_ref"],
                "entities": [
                    entity["canonical_name"] for entity in records[pos]["entities"][:8]
                ],
                "context_types": sorted(
                    set(item["context_type"] for item in records[pos]["context"])
                ),
            }
            for pos in representative_order.tolist()
        ]
        local_coherence = coherence_map.get(cluster_id, {})
        rows.append(
            {
                "cluster_id": cluster_id,
                "count": len(idx),
                "share_of_assigned_pct": 100.0 * len(idx) / assigned,
                "mean_strength": float(np.mean(strengths[idx])) if len(idx) else np.nan,
                "cohesion": cohesion,
                "semantic_coherence_npmi": local_coherence.get("coherence_npmi"),
                "descriptor": descriptions.get(cluster_id, {}).get(
                    "descriptor", f"cluster_{cluster_id}"
                ),
                "top_terms": "; ".join(
                    item["term"]
                    for item in descriptions.get(cluster_id, {}).get("keywords", [])[
                        :config.top_cluster_terms
                    ]
                ),
                "representative_structures": json.dumps(examples, ensure_ascii=False),
            }
        )
    if not rows:
        return pd.DataFrame()
    return pd.DataFrame(rows).sort_values("count", ascending=False).reset_index(drop=True)


def cluster_similarity_table(
    vectors: np.ndarray,
    labels: np.ndarray,
    descriptions: Dict[int, Dict[str, Any]],
) -> pd.DataFrame:
    cluster_ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    centroids: Dict[int, np.ndarray] = {}
    for cluster_id in cluster_ids:
        centroid = vectors[labels == cluster_id].mean(axis=0)
        norm = float(np.linalg.norm(centroid))
        centroids[cluster_id] = centroid / norm if norm > 0 else centroid
    rows = []
    for i, left in enumerate(cluster_ids):
        for right in cluster_ids[i + 1:]:
            rows.append(
                {
                    "cluster_a": left,
                    "cluster_b": right,
                    "cosine_similarity": float(centroids[left] @ centroids[right]),
                    "descriptor_a": descriptions.get(left, {}).get("descriptor", f"cluster_{left}"),
                    "descriptor_b": descriptions.get(right, {}).get("descriptor", f"cluster_{right}"),
                }
            )
    if not rows:
        return pd.DataFrame()
    return pd.DataFrame(rows).sort_values("cosine_similarity", ascending=False).reset_index(drop=True)


def save_cluster_heatmap(
    vectors: np.ndarray,
    labels: np.ndarray,
    descriptions: Dict[int, Dict[str, Any]],
    path: Path,
    top_n: int,
) -> None:
    cluster_ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if len(cluster_ids) < 2:
        return
    counts = {cluster_id: int(np.sum(labels == cluster_id)) for cluster_id in cluster_ids}
    cluster_ids = sorted(cluster_ids, key=lambda x: counts[x], reverse=True)[:max(2, top_n)]
    centroids = []
    for cluster_id in cluster_ids:
        centroid = vectors[labels == cluster_id].mean(axis=0)
        norm = float(np.linalg.norm(centroid))
        centroids.append(centroid / norm if norm > 0 else centroid)
    matrix = np.clip(np.vstack(centroids) @ np.vstack(centroids).T, -1.0, 1.0)

    if len(cluster_ids) >= 3:
        distance = np.clip(1.0 - matrix, 0.0, 2.0)
        np.fill_diagonal(distance, 0.0)
        order = leaves_list(
            linkage(squareform(distance, checks=False), method="average")
        ).tolist()
        cluster_ids = [cluster_ids[i] for i in order]
        matrix = matrix[np.ix_(order, order)]

    labels_text = [
        f"{cluster_id}: {descriptions.get(cluster_id, {}).get('descriptor', f'cluster_{cluster_id}').split(' | ')[0][:28]}"
        for cluster_id in cluster_ids
    ]
    size = max(9, min(18, 0.58 * len(cluster_ids) + 5))
    fig, ax = plt.subplots(figsize=(size, size))
    image = ax.imshow(matrix, vmin=-1, vmax=1, aspect="auto")
    ax.set_title("NORA 4.1.1 semantic cluster centroid similarity")
    ax.set_xticks(np.arange(len(cluster_ids)))
    ax.set_yticks(np.arange(len(cluster_ids)))
    ax.set_xticklabels(labels_text, rotation=90, fontsize=8)
    ax.set_yticklabels(labels_text, fontsize=8)
    if len(cluster_ids) <= 24:
        for i in range(len(cluster_ids)):
            for j in range(len(cluster_ids)):
                ax.text(j, i, f"{matrix[i, j]:.2f}", ha="center", va="center", fontsize=6)
    fig.colorbar(image, ax=ax, fraction=0.046, pad=0.04, label="Centroid cosine similarity")
    fig.tight_layout()
    fig.savefig(path, dpi=180, bbox_inches="tight")
    plt.close(fig)


def save_entity_type_heatmap(records: Sequence[Dict[str, Any]], path: Path) -> None:
    entity_types = sorted(
        set(entity["entity_type"] for record in records for entity in record["entities"])
    )
    if len(entity_types) < 2:
        return
    index = {entity_type: i for i, entity_type in enumerate(entity_types)}
    matrix = np.zeros((len(entity_types), len(entity_types)), dtype=float)
    for record in records:
        present = sorted(set(entity["entity_type"] for entity in record["entities"]))
        for left in present:
            matrix[index[left], index[left]] += 1
        for i, left in enumerate(present):
            for right in present[i + 1:]:
                matrix[index[left], index[right]] += 1
                matrix[index[right], index[left]] += 1
    diagonal = np.maximum(np.diag(matrix), 1.0)
    normalized = matrix / np.sqrt(diagonal[:, None] * diagonal[None, :])
    fig, ax = plt.subplots(
        figsize=(max(9, len(entity_types) * 0.5), max(8, len(entity_types) * 0.45))
    )
    image = ax.imshow(normalized, vmin=0, vmax=1, aspect="auto")
    ax.set_title("Entity-type interaction co-occurrence")
    ax.set_xticks(np.arange(len(entity_types)))
    ax.set_yticks(np.arange(len(entity_types)))
    ax.set_xticklabels(entity_types, rotation=90, fontsize=8)
    ax.set_yticklabels(entity_types, fontsize=8)
    fig.colorbar(image, ax=ax, fraction=0.046, pad=0.04, label="Normalized co-occurrence")
    fig.tight_layout()
    fig.savefig(path, dpi=180, bbox_inches="tight")
    plt.close(fig)


def save_cluster_projection(
    vectors: np.ndarray,
    labels: np.ndarray,
    descriptions: Dict[int, Dict[str, Any]],
    path: Path,
    seed: int,
    sample_n: int,
) -> None:
    if len(vectors) < 5:
        return
    rng = np.random.default_rng(seed)
    indices = (
        np.sort(rng.choice(len(vectors), sample_n, replace=False))
        if sample_n > 0 and len(vectors) > sample_n
        else np.arange(len(vectors))
    )
    sample_vectors = vectors[indices]
    sample_labels = labels[indices]
    method = "t-SNE"
    try:
        from umap import UMAP

        coords = UMAP(
            n_components=2,
            n_neighbors=min(30, max(5, int(math.sqrt(len(sample_vectors))))),
            min_dist=0.05,
            metric="cosine",
            random_state=seed,
            transform_seed=seed,
        ).fit_transform(sample_vectors)
        method = "UMAP"
    except Exception:
        perplexity = min(30, max(5, (len(sample_vectors) - 1) // 4))
        coords = TSNE(
            n_components=2,
            perplexity=perplexity,
            init="pca",
            learning_rate="auto",
            random_state=seed,
            metric="cosine",
        ).fit_transform(sample_vectors)

    fig, ax = plt.subplots(figsize=(13, 9))
    unique = sorted(set(int(x) for x in sample_labels.tolist()))
    for cluster_id in unique:
        mask = sample_labels == cluster_id
        label = "outlier" if cluster_id == -1 else (
            f"{cluster_id}: "
            + descriptions.get(cluster_id, {}).get("descriptor", f"cluster_{cluster_id}").split(" | ")[0][:30]
        )
        ax.scatter(coords[mask, 0], coords[mask, 1], s=13, alpha=0.72, label=label)
    ax.set_title(f"Entity-context semantic clusters ({method} projection)")
    ax.set_xlabel(f"{method} component 1")
    ax.set_ylabel(f"{method} component 2")
    if len(unique) <= 24:
        ax.legend(fontsize=7, loc="best")
    fig.tight_layout()
    fig.savefig(path, dpi=180, bbox_inches="tight")
    plt.close(fig)


def save_cluster_size_distribution(catalog: pd.DataFrame, path: Path) -> None:
    if catalog.empty:
        return
    view = catalog.sort_values("count", ascending=False).head(40)
    fig, ax = plt.subplots(figsize=(12, 7))
    ax.bar(view["cluster_id"].astype(str), view["count"].astype(float))
    ax.set_title("Semantic cluster sizes")
    ax.set_xlabel("Cluster ID")
    ax.set_ylabel("Interaction count")
    ax.tick_params(axis="x", rotation=90)
    fig.tight_layout()
    fig.savefig(path, dpi=180, bbox_inches="tight")
    plt.close(fig)


def save_cluster_upstream_contingency(
    records: Sequence[Dict[str, Any]],
    labels: np.ndarray,
    csv_path: Path,
    png_path: Path,
    top_labels: int,
) -> Dict[str, Any]:
    pairs: List[Tuple[int, str]] = []
    for record, cluster_id in zip(records, labels.tolist()):
        upstream = record.get("upstream_labels_passthrough", {}) or {}
        if upstream:
            label = max(upstream.items(), key=lambda x: x[1])[0]
            if label:
                pairs.append((int(cluster_id), str(label)))
    if len(pairs) < 10:
        return {
            "generated": False,
            "reason": "insufficient_upstream_label_coverage",
        }

    frame = pd.DataFrame(pairs, columns=["cluster_id", "upstream_label"])
    keep = frame["upstream_label"].value_counts().head(max(2, top_labels)).index
    frame = frame[frame["upstream_label"].isin(keep)]
    matrix = pd.crosstab(frame["cluster_id"], frame["upstream_label"])
    matrix.to_csv(csv_path)

    fig, ax = plt.subplots(
        figsize=(max(10, 0.55 * matrix.shape[1] + 6), max(8, 0.42 * matrix.shape[0] + 5))
    )
    image = ax.imshow(matrix.to_numpy(float), aspect="auto")
    ax.set_title("Semantic cluster vs upstream-label contingency (diagnostic only)")
    ax.set_xlabel("Upstream label")
    ax.set_ylabel("Semantic cluster")
    ax.set_xticks(np.arange(matrix.shape[1]))
    ax.set_xticklabels(matrix.columns.astype(str), rotation=90, fontsize=7)
    ax.set_yticks(np.arange(matrix.shape[0]))
    ax.set_yticklabels(matrix.index.astype(str), fontsize=8)
    fig.colorbar(image, ax=ax, fraction=0.046, pad=0.04, label="Count")
    fig.tight_layout()
    fig.savefig(png_path, dpi=180, bbox_inches="tight")
    plt.close(fig)
    return {
        "generated": True,
        "kind": "cluster_label_contingency_not_classifier_accuracy",
        "rows_used": int(len(frame)),
        "clusters": int(matrix.shape[0]),
        "upstream_labels": int(matrix.shape[1]),
    }


def hash_string_set(values: Iterable[str]) -> str:
    return sha256_bytes("\n".join(sorted(set(str(x) for x in values))).encode("utf-8"))


def write_selection_lock(
    outdir: Path,
    frame: pd.DataFrame,
    config: Config,
    selected: PolicyResult,
    policy_decision: Dict[str, Any],
    noise_model: NoiseModel,
    phrase_table: pd.DataFrame,
    code_hash: str,
) -> Dict[str, Any]:
    protected_signals = (
        phrase_table.loc[phrase_table["selected_as_domain_signal"] == True, "phrase"].astype(str).tolist()
        if not phrase_table.empty else []
    )
    payload = {
        "created_at_utc": utc_now_iso(),
        "pipeline_version": PIPELINE_VERSION,
        "source_fingerprint": code_hash,
        "selection_boundary": "train_and_validation_only",
        "locked_test_used_for_selection": False,
        "selected_noise_policy": selected.policy,
        "policy_decision": policy_decision,
        "cluster_method": selected.cluster_model.method,
        "cluster_parameters": selected.cluster_model.parameters,
        "train_group_fingerprint": split_group_fingerprint(frame, "train"),
        "validation_group_fingerprint": split_group_fingerprint(frame, "validation"),
        "locked_test_group_fingerprint": split_group_fingerprint(frame, "locked_test"),
        "learned_stopword_fingerprint": hash_string_set(noise_model.learned_stopwords),
        "template_phrase_fingerprint": hash_string_set(noise_model.template_phrases),
        "protected_signal_fingerprint": hash_string_set(protected_signals),
        "configuration_fingerprint": sha256_bytes(
            json.dumps(
                {k: v for k, v in asdict(config).items() if k not in {"outdir", "model_dir"}},
                sort_keys=True,
                default=str,
            ).encode("utf-8")
        ),
    }
    path = outdir / "selection_lock.json"
    path.write_text(json.dumps(to_plain(payload), indent=2), encoding="utf-8")
    payload["file_sha256"] = sha256_file(path)
    return payload


def _metric_regression_check(
    name: str,
    validation: Mapping[str, Any],
    locked: Mapping[str, Any],
    value_key: str,
    se_key: str,
    critical: bool,
) -> Dict[str, Any]:
    validation_value = validation.get(value_key)
    locked_value = locked.get(value_key)
    if validation_value is None or locked_value is None:
        return {
            "name": name,
            "status": "UNAVAILABLE",
            "critical": critical,
            "validation": validation_value,
            "locked_test": locked_value,
        }
    try:
        validation_value = float(validation_value)
        locked_value = float(locked_value)
    except Exception:
        return {
            "name": name,
            "status": "UNAVAILABLE",
            "critical": critical,
            "validation": validation_value,
            "locked_test": locked_value,
        }
    if not np.isfinite(validation_value) or not np.isfinite(locked_value):
        return {
            "name": name,
            "status": "UNAVAILABLE",
            "critical": critical,
            "validation": validation_value,
            "locked_test": locked_value,
        }

    validation_se = safe_float(validation.get(se_key), 0.0)
    locked_se = safe_float(locked.get(se_key), 0.0)
    tolerance = 1.96 * math.sqrt(validation_se ** 2 + locked_se ** 2)
    delta = locked_value - validation_value
    status = "PASS" if delta >= -tolerance else "FAIL" if critical else "WARN"
    return {
        "name": name,
        "status": status,
        "critical": critical,
        "validation": validation_value,
        "locked_test": locked_value,
        "delta": delta,
        "data_driven_tolerance": tolerance,
        "validation_standard_error": validation_se,
        "locked_test_standard_error": locked_se,
    }


def build_quality_gate(
    validation_metrics: Mapping[str, Any],
    locked_metrics: Mapping[str, Any],
    descriptor_contamination_rate: float,
    selection_lock: Mapping[str, Any],
) -> Dict[str, Any]:
    checks = [
        _metric_regression_check(
            "silhouette_non_regression",
            validation_metrics,
            locked_metrics,
            "silhouette",
            "silhouette_standard_error",
            True,
        ),
        _metric_regression_check(
            "semantic_coherence_non_regression",
            validation_metrics,
            locked_metrics,
            "semantic_coherence_npmi",
            "semantic_coherence_standard_error",
            True,
        ),
        _metric_regression_check(
            "assigned_fraction_non_regression",
            validation_metrics,
            locked_metrics,
            "assigned_fraction",
            "assigned_fraction_standard_error",
            False,
        ),
    ]

    locked_clusters = safe_float(locked_metrics.get("n_clusters"), 0.0)
    checks.append(
        {
            "name": "locked_test_cluster_coverage",
            "status": "PASS" if locked_clusters >= 2 else "FAIL",
            "critical": True,
            "locked_test_n_clusters": locked_clusters,
        }
    )
    contamination_ok = (
        np.isnan(descriptor_contamination_rate)
        or descriptor_contamination_rate <= 1e-12
    )
    checks.append(
        {
            "name": "descriptor_noise_exclusion",
            "status": "PASS" if contamination_ok else "FAIL",
            "critical": True,
            "descriptor_contamination_rate": descriptor_contamination_rate,
        }
    )
    checks.append(
        {
            "name": "selection_boundary_integrity",
            "status": "PASS" if selection_lock.get("locked_test_used_for_selection") is False else "FAIL",
            "critical": True,
        }
    )

    critical_fail = any(
        check["status"] == "FAIL" and check.get("critical") for check in checks
    )
    warning = any(check["status"] in {"WARN", "UNAVAILABLE"} for check in checks)
    semantic_status = "FAIL" if critical_fail else "WARN" if warning else "PASS"
    return {
        "execution_status": "SUCCESS",
        "semantic_validation_status": semantic_status,
        "selection_boundary": "train_and_validation_only",
        "checks": checks,
        "interpretation": (
            "Execution success means the pipeline completed. Semantic validation status reports whether "
            "cluster behavior remained coherent on the untouched locked-test partition."
        ),
    }


def flatten_field(records: Sequence[Dict[str, Any]], field_name: str) -> pd.DataFrame:
    rows: List[Dict[str, Any]] = []
    for record in records:
        for item in record[field_name]:
            row = {"interaction_ref": record["interaction_ref"], **item}
            for key, value in list(row.items()):
                if isinstance(value, (list, dict)):
                    row[key] = json.dumps(value, ensure_ascii=False)
            rows.append(row)
    return pd.DataFrame(rows)


def public_dictionary_record(
    record: Dict[str, Any],
    cluster_id: int,
    cluster_strength: float,
    descriptor: str,
) -> Dict[str, Any]:
    output = {key: value for key, value in record.items() if not key.startswith("_")}
    output["semantic_cluster"] = {
        "cluster_id": int(cluster_id),
        "cluster_strength": float(cluster_strength),
        "descriptor": descriptor,
    }
    return output


def cluster_summary_json(
    labels: np.ndarray,
    strengths: np.ndarray,
    catalog: pd.DataFrame,
    descriptions: Dict[int, Dict[str, Any]],
) -> Dict[str, Any]:
    assigned = labels[labels != -1]
    return {
        "total_records": int(len(labels)),
        "assigned_records": int(np.sum(labels != -1)),
        "outlier_records": int(np.sum(labels == -1)),
        "assigned_fraction": float(np.mean(labels != -1)) if len(labels) else 0.0,
        "cluster_count": int(len(set(assigned.tolist()))),
        "mean_cluster_strength": float(np.mean(strengths[labels != -1])) if np.any(labels != -1) else None,
        "clusters": [
            {
                "cluster_id": int(row.cluster_id),
                "count": int(row.count),
                "share_of_assigned_pct": safe_float(row.share_of_assigned_pct),
                "cohesion": safe_float(row.cohesion),
                "semantic_coherence_npmi": to_plain(row.semantic_coherence_npmi),
                "descriptor": descriptions.get(int(row.cluster_id), {}).get(
                    "descriptor", f"cluster_{int(row.cluster_id)}"
                ),
            }
            for row in catalog.itertuples(index=False)
        ] if not catalog.empty else [],
    }


