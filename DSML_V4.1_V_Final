TOKEN_RE = re.compile(r"(?u)\b[a-zA-Z][a-zA-Z0-9_'\-]{1,}\b")
SENTENCE_SPLIT_RE = re.compile(r"(?<=[.!?;])\s+|\n+")
KV_RE = re.compile(
    r"(?im)(?P<key>[A-Za-z][A-Za-z0-9 _/\-]{1,60})\s*[:=]\s*"
    r"(?P<value>[^\n|;]{1,180})"
)
MEASUREMENT_RE = re.compile(
    r"(?i)\b(?P<key>[A-Za-z][A-Za-z0-9 _/\-]{1,50}?)\s*[:=]?\s*"
    r"(?P<value>-?\d+(?:\.\d+)?)\s*"
    r"(?P<unit>dBm|dB|ms|s|sec|seconds?|Mbps|Gbps|Kbps|MB|GB|GiB|%|"
    r"MHz|GHz|kHz|mV|V|A|mA|W|km|m|mi|hours?|hrs?|minutes?|mins?)\b"
)
ERROR_CODE_RE = re.compile(
    r"(?i)\b(?:error|code|status)\s*[:=#-]?\s*([A-Z]{1,10}[-_]?\d{2,8}|\d{3,8})\b"
)
TIME_RE = re.compile(
    r"(?i)\b(?:today|yesterday|tomorrow|last\s+(?:night|week|month)|"
    r"since\s+\w+|for\s+\d+\s+(?:minutes?|hours?|days?|weeks?|months?)|"
    r"\d+\s+(?:minutes?|hours?|days?|weeks?|months?)\s+ago)\b"
)
CAUSE_CUE_RE = re.compile(
    r"(?i)\b(?:root\s*cause|caused\s+by|due\s+to|because\s+of|because|"
    r"attribut(?:ed|able)\s+to|result(?:ed|ing)?\s+from|identified\s+as)\b"
)
REMEDIATION_CUE_RE = re.compile(
    r"(?i)\b(?:recommend(?:ed|ation)?|resolve(?:d|tion)?|remediat(?:e|ion)|"
    r"reboot|restart|reset|replace|update|upgrade|reprovision|provision|"
    r"refresh|reconnect|retest|power\s*cycle|factory\s*reset|escalat(?:e|ed|ion)|"
    r"enable|disable|configure|reconfigure)\b"
)
DIAGNOSTIC_CUE_RE = re.compile(
    r"(?i)\b(?:check(?:ed)?|verify|verified|test(?:ed)?|diagnos(?:e|ed|tic)|"
    r"trace|query|lookup|inspect(?:ed)?|measure(?:d|ment)?|signal|alarm|telemetry|"
    r"status|registration|provisioning|snapshot|counter|metric|observ(?:e|ed|ation)|"
    r"retriev(?:e|ed|al))\b"
)
STATE_CUE_RE = re.compile(
    r"(?i)\b(?:online|offline|active|inactive|registered|not[- ]registered|"
    r"connected|disconnected|blocked|enabled|disabled|failed|failing|degraded|"
    r"normal|healthy|unhealthy|available|unavailable|throttled|provisioned|"
    r"unprovisioned)\b"
)
IMPACT_CUE_RE = re.compile(
    r"(?i)\b(?:unable|cannot|can't|not\s+working|no\s+(?:service|data|internet|signal)|"
    r"dropp(?:ed|ing)|slow|latency|intermittent|outage|degrad(?:ed|ation)|failed|"
    r"failure|impact(?:ed|ing)?|poor\s+coverage|weak\s+signal)\b"
)
ACTION_VERB_RE = re.compile(
    r"(?i)\b(?:reboot|restart|reset|replace|update|upgrade|provision|reprovision|"
    r"refresh|reconnect|retest|check|verify|test|query|lookup|escalate|activate|"
    r"deactivate|enable|disable|configure|reconfigure|change|remove|add)\b"
)
LEADING_OBSERVATION_VERB_RE = re.compile(
    r"(?i)^\s*(?:checked?|verified?|queried?|retrieved?|returned?|observed?|measured?)\s+"
)
SCRIPT_STYLE_RE = re.compile(r"(?is)<(?:script|style)\b[^>]*>.*?</(?:script|style)>")
HTML_TAG_RE = re.compile(r"(?is)<[^>]+>")
CSS_FRAGMENT_RE = re.compile(
    r"(?i)\b(?:style|color|font|background|border|padding|margin|display|width|height)"
