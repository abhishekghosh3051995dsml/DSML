def write_html_summary(
    outdir: Path,
    report: Dict[str, Any],
    quality_gate: Dict[str, Any],
    catalog: pd.DataFrame,
    stopwords: pd.DataFrame,
    templates: pd.DataFrame,
    phrases: pd.DataFrame,
    entity_df: pd.DataFrame,
    context_df: pd.DataFrame,
    similarity: pd.DataFrame,
    policy_table: pd.DataFrame,
) -> Path:
    executive = outdir / "executive"
    executive.mkdir(parents=True, exist_ok=True)
    quality = report["quality"]
    counts = report["counts"]

    metrics = pd.DataFrame(
        [
            {
                "split": split,
                **{
                    key: (quality.get(split, {}) or {}).get(key)
                    for key in (
                        "silhouette",
                        "silhouette_standard_error",
                        "semantic_coherence_npmi",
                        "semantic_coherence_standard_error",
                        "assigned_fraction",
                        "noise_rate",
                        "balance_entropy",
                        "n_clusters",
                        "largest_cluster_share",
                        "mean_strength",
                    )
                },
            }
            for split in ("train", "validation", "locked_test")
        ]
    )
    gate_table = pd.DataFrame(quality_gate.get("checks", []))
    entity_types = (
        entity_df["entity_type"].value_counts().head(30).rename_axis("entity_type").reset_index(name="count")
        if not entity_df.empty and "entity_type" in entity_df.columns else pd.DataFrame()
    )
    context_types = (
        context_df["context_type"].value_counts().rename_axis("context_type").reset_index(name="count")
        if not context_df.empty and "context_type" in context_df.columns else pd.DataFrame()
    )

    parts = [
        "<!doctype html><html><head><meta charset='utf-8'><title>NORA Entity-Context 4.1.1</title>",
        "<style>body{font-family:Arial,sans-serif;margin:28px;color:#222}"
        "table{border-collapse:collapse;width:100%;margin:12px 0}"
        "th,td{border:1px solid #ccc;padding:7px;font-size:13px;vertical-align:top}"
        "th{background:#111;color:white}.card{background:#f4f4f4;padding:14px;border-radius:8px;margin:12px 0}"
        ".pass{color:#176b2c}.warn{color:#9a6500}.fail{color:#a22020}img{max-width:100%;margin:10px 0}"
        "code{background:#eee;padding:2px 4px}</style></head><body>",
        "<h1>NORA Entity-Context 4.1.1</h1>",
        "<div class='card'>",
        f"<b>Execution:</b> {html_lib.escape(str(quality_gate['execution_status']))}<br>",
        f"<b>Semantic validation:</b> {html_lib.escape(str(quality_gate['semantic_validation_status']))}<br>",
        f"<b>Selected noise policy:</b> {html_lib.escape(str(report['noise_policy']['selected']))}<br>",
        f"<b>Interactions:</b> {counts['interactions']}<br>",
        f"<b>Semantic clusters:</b> {counts['semantic_clusters']}<br>",
        f"<b>Outliers:</b> {counts['semantic_outliers']}<br>",
        f"<b>Learned stopwords:</b> {counts['learned_stopwords']}<br>",
        f"<b>Suppressed templates:</b> {counts['template_phrases']}<br>",
        f"<b>Protected domain signals:</b> {counts['protected_domain_signals']}<br>",
        f"<b>Entities:</b> {counts['entities']}<br>",
        f"<b>Diagnostic evidence:</b> {counts['diagnostic_evidence']}<br>",
        f"<b>Root-cause records:</b> {counts['root_cause_records']}<br>",
        f"<b>Remediation records:</b> {counts['remediation_records']}<br>",
        f"<b>Ontology mode:</b> {html_lib.escape(str(report['ontology']['mode']))}",
        "</div>",
        "<h2>Boundary and lock</h2>",
        "<p>Stopword learning, phrase protection, noise-policy selection, representation fitting and cluster-model selection "
        "use only the training and validation partitions. The locked-test partition is evaluated only after "
        "<code>selection_lock.json</code> is written.</p>",
        "<h2>Quality gate</h2>",
        gate_table.to_html(index=False, escape=True) if not gate_table.empty else "<p>No gate checks available.</p>",
        "<h2>Noise-policy ablation</h2>",
        policy_table.to_html(index=False, float_format=lambda x: f"{x:.4f}" if pd.notna(x) else ""),
        "<h2>Train / validation / locked-test diagnostics</h2>",
        metrics.to_html(index=False, float_format=lambda x: f"{x:.4f}" if pd.notna(x) else ""),
        "<h2>Noise learning</h2>",
        "<p>Duplicate-family collapse reduces repeated template influence. A unigram is removed only when its corpus behavior "
        "supports background status and no structured or multiword semantic rescue is present. Multiword phrases are rejected "
        "as templates when duplicate pressure, boundary regularity, broad distribution and weak discrimination indicate "
        "reused interaction scaffolding.</p>",
    ]

    if not catalog.empty:
        columns = [
            c for c in (
                "cluster_id", "count", "share_of_assigned_pct", "mean_strength",
                "cohesion", "semantic_coherence_npmi", "descriptor"
            ) if c in catalog.columns
        ]
        parts += [
            "<h2>Semantic clusters</h2>",
            catalog.head(40)[columns].to_html(
                index=False,
                float_format=lambda x: f"{x:.4f}" if pd.notna(x) else "",
            ),
        ]
    if not stopwords.empty:
        columns = [
            c for c in (
                "term", "family_frequency_ratio", "duplicate_survival_ratio", "cluster_entropy",
                "max_regularized_log_odds_z", "stopword_score", "reason"
            ) if c in stopwords.columns
        ]
        parts += [
            "<h2>Learned stopwords</h2>",
            stopwords.head(40)[columns].to_html(
                index=False,
                float_format=lambda x: f"{x:.4f}" if pd.notna(x) else "",
            ),
        ]
    if not templates.empty:
        columns = [
            c for c in (
                "term", "document_frequency_ratio", "duplicate_survival_ratio", "boundary_ratio",
                "template_score", "reason"
            ) if c in templates.columns
        ]
        parts += [
            "<h2>Suppressed template phrases</h2>",
            templates.head(40)[columns].to_html(
                index=False,
                float_format=lambda x: f"{x:.4f}" if pd.notna(x) else "",
            ),
        ]
    if not phrases.empty:
        view = phrases[phrases["selected_as_domain_signal"] == True].head(40)
        columns = [
            c for c in (
                "phrase", "ngram_order", "family_document_frequency", "duplicate_survival_ratio",
                "specificity", "association_npmi", "log_odds_z", "template_likelihood",
                "phrase_score", "rescued_unigram"
            ) if c in view.columns
        ]
        parts += [
            "<h2>Protected domain signals</h2>",
            view[columns].to_html(
                index=False,
                float_format=lambda x: f"{x:.4f}" if pd.notna(x) else "",
            ),
        ]
    if not entity_types.empty:
        parts += ["<h2>Entity types</h2>", entity_types.to_html(index=False)]
    if not context_types.empty:
        parts += ["<h2>Context types</h2>", context_types.to_html(index=False)]
    if not similarity.empty:
        parts += [
            "<h2>Most similar cluster pairs</h2>",
            similarity.head(25).to_html(
                index=False,
                float_format=lambda x: f"{x:.4f}" if pd.notna(x) else "",
            ),
        ]

    parts += [
        "<h2>TM Forum semantic alignment</h2>",
        "<p>The script includes current reference metadata for TR290 and TR292-family concepts and can ingest local "
        "CSV/JSON lexicons or RDF-family ontology files. Formal graph-backed normalization is reported only when such "
        "files are actually supplied; otherwise the run is explicitly marked as reference alignment only.</p>",
    ]

    for image, title in (
        ("semantic_cluster_similarity_heatmap.png", "Semantic cluster similarity"),
        ("entity_type_cooccurrence_heatmap.png", "Entity-type co-occurrence"),
        ("semantic_cluster_projection.png", "2D semantic cluster projection"),
        ("semantic_cluster_size_distribution.png", "Cluster size distribution"),
        ("cluster_upstream_contingency_heatmap.png", "Cluster/upstream-label diagnostic contingency"),
    ):
        if (outdir / image).exists():
            parts += [f"<h2>{title}</h2>", f"<img src='../{image}'>"]

    parts += [
        "<h2>Structured dictionary output</h2>",
        "<p><code>nora_entity_context_dictionary.jsonl</code> is streaming-friendly and "
        "<code>nora_entity_context_dictionary.json</code> is consolidated. Each record contains entities, context, "
        "key-values, evidence, possible cause, remediation, relationships, semantic view and cluster assignment.</p>",
        "<h2>Classification-style matrix</h2>",
        "<p>A true classifier confusion matrix is not valid for unsupervised clusters without supervised ground truth. "
        "When upstream labels are available, the pipeline emits a post-hoc cluster/upstream-label contingency matrix "
        "for diagnostics only; those labels are never used to fit or select clusters.</p>",
        "</body></html>",
    ]
    path = executive / "nora_entity_context_v4_1_1_summary.html"
    path.write_text("".join(parts), encoding="utf-8")
    return path


# ---------------------------------------------------------------------------
# Cache identity and training
# ---------------------------------------------------------------------------

def development_cache_signature(
    frame: pd.DataFrame,
    config: Config,
    ontology_entries: Sequence[OntologyEntry],
    seed_terms: set[str],
    code_hash: str,
    key_fingerprint: str,
) -> str:
    hasher = hashlib.sha256()
    hasher.update(PIPELINE_VERSION.encode("utf-8"))
    hasher.update(code_hash.encode("utf-8"))
    hasher.update(key_fingerprint.encode("utf-8"))
    payload = {
        key: value
        for key, value in asdict(config).items()
        if key not in {"outdir", "model_dir", "persist_model", "enable_cache", "fail_on_quality_gate"}
    }
    hasher.update(json.dumps(payload, sort_keys=True, default=str).encode("utf-8"))
    hasher.update(
        json.dumps([asdict(entry) for entry in ontology_entries], sort_keys=True, default=str).encode("utf-8")
    )
    hasher.update(json.dumps(sorted(seed_terms)).encode("utf-8"))

    development = frame[frame["data_split"] != "locked_test"]
    for row in development[["_group", "data_split", "_role", "_sanitized_text"]].astype(str).itertuples(index=False, name=None):
        hasher.update("\x1f".join(row).encode("utf-8", errors="ignore"))
        hasher.update(b"\n")
    return hasher.hexdigest()


def save_json(path: Path, payload: Any) -> None:
    path.write_text(
        json.dumps(to_plain(payload), indent=2, ensure_ascii=False),
        encoding="utf-8",
    )


def run_train(config: Config) -> Dict[str, Any]:
    np.random.seed(config.seed)
    outdir = Path(config.outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    (outdir / "executive").mkdir(parents=True, exist_ok=True)
    started_at = utc_now_iso()
    code_hash = source_fingerprint()
    stage_rows: List[Dict[str, Any]] = []

    dependency_info = dependency_audit(config, outdir)

    t0 = time.perf_counter()
    frame, schema = load_and_prepare(config)
    frame, split_audit = assign_splits(frame, config)
    pseudonym_key, key_source, key_fingerprint = resolve_pseudonym_key(config)
    frame["_row_ref"] = [
        pseudonymize(f"{group}|{row_id}", pseudonym_key)
        for group, row_id in zip(frame["_group"].astype(str), frame["_row_id"].astype(str))
    ]
    stage_rows.append(
        {
            "stage": "load_split_privacy",
            "seconds": time.perf_counter() - t0,
            "cache_hit": False,
        }
    )

    t0 = time.perf_counter()
    ontology_entries, ontology_mode, ontology_inventory = load_ontologies(config.ontology_paths)
    ontology = OntologyMatcher(ontology_entries, config.ontology_match_threshold)
    seed_terms = load_stopword_seed(config.stopword_seed_path)
    pd.DataFrame(ONTOLOGY_ALIGNMENT_ROWS).to_csv(
        outdir / "ontology_alignment_reference.csv", index=False
    )
    pd.DataFrame([asdict(entry) for entry in ontology_entries]).to_csv(
        outdir / "ontology_entries_loaded.csv", index=False
    )
    ontology_inventory.to_csv(outdir / "ontology_inventory.csv", index=False)
    save_json(
        outdir / "ontology_inventory.json",
        {
            "mode": ontology_mode,
            "files": ontology_inventory.to_dict(orient="records"),
            "entries_loaded": len(ontology_entries),
        },
    )
    pd.DataFrame(
        columns=["canonical_name", "entity_type", "synonyms", "parent", "source", "source_ref", "uri"]
    ).to_csv(outdir / "ontology_lexicon_template.csv", index=False)
    pd.DataFrame({"term": sorted(seed_terms)}).to_csv(
        outdir / "stopword_seed_used.csv", index=False
    )
    stage_rows.append(
        {
            "stage": "ontology_and_seed_load",
            "seconds": time.perf_counter() - t0,
            "cache_hit": False,
        }
    )

    effective_cache = config.enable_cache and key_source != "ephemeral_per_run"
    cache_dir = outdir / config.cache_dir_name
    cache_dir.mkdir(parents=True, exist_ok=True)
    cache_key = development_cache_signature(
        frame,
        config,
        ontology_entries,
        seed_terms,
        code_hash,
        key_fingerprint,
    )
    cache_path = cache_dir / f"development_core_{cache_key}.joblib"
    core: Optional[Dict[str, Any]] = None
    cache_hit = False

    if effective_cache and cache_path.exists():
        try:
            payload = joblib.load(cache_path)
            if (
                payload.get("pipeline_version") == PIPELINE_VERSION
                and payload.get("source_fingerprint") == code_hash
                and payload.get("key_fingerprint") == key_fingerprint
            ):
                core = payload["core"]
                cache_hit = True
                LOGGER.info("CACHE HIT: %s", cache_path.name)
        except Exception as exc:
            LOGGER.warning("Ignoring unreadable cache: %s", exc)

    if core is None:
        train_frame = frame[frame["data_split"] == "train"].copy()
        development_frame = frame[frame["data_split"] != "locked_test"].copy()

        t0 = time.perf_counter()
        train_texts = train_frame["_sanitized_text"].astype(str).tolist()
        provisional_labels = fit_preliminary_partition(train_texts, config.seed)
        family_ids, duplicate_audit, duplicate_summary = build_duplicate_families(train_texts)
        structured_protected = derive_structured_protected_terms(train_frame)
        phrase_table = mine_protected_phrases(
            train_texts,
            provisional_labels,
            family_ids,
            seed_terms,
            config,
        )
        noise_model, noise_audit, stopword_export, template_export = learn_noise_model(
            train_texts,
            provisional_labels,
            family_ids,
            structured_protected,
            phrase_table,
            seed_terms,
            config,
        )
        stage_rows.append(
            {
                "stage": "duplicate_noise_signal_learning",
                "seconds": time.perf_counter() - t0,
                "cache_hit": False,
            }
        )

        t0 = time.perf_counter()
        results: List[PolicyResult] = []
        recordsets: Dict[str, List[Dict[str, Any]]] = {}
        for policy in ("raw", "learned_clean"):
            LOGGER.info("Fitting development clustering policy: %s", policy)
            result, records = fit_policy(
                policy,
                development_frame,
                phrase_table,
                ontology,
                ontology_mode,
                noise_model,
                pseudonym_key,
                config,
            )
            results.append(result)
            recordsets[policy] = records

        selected, policy_decision = choose_policy(results)
        development_records = recordsets[selected.policy]
        policy_table = build_policy_table(results)
        stage_rows.append(
            {
                "stage": "development_policy_selection",
                "seconds": time.perf_counter() - t0,
                "cache_hit": False,
            }
        )

        t0 = time.perf_counter()
        train_records = [
            record for record in development_records if record["data_split"] == "train"
        ]
        validation_records = [
            record for record in development_records if record["data_split"] == "validation"
        ]
        descriptions = cluster_descriptions(
            [record["_descriptor_text"] for record in train_records],
            [record["_clean_text"] for record in train_records],
            selected.train_labels,
            noise_model,
            phrase_table,
            config.top_cluster_terms,
        )
        contamination = descriptor_contamination(descriptions, noise_model)
        stage_rows.append(
            {
                "stage": "development_descriptors",
                "seconds": time.perf_counter() - t0,
                "cache_hit": False,
            }
        )

        core = {
            "noise_model": noise_model,
            "noise_audit": noise_audit,
            "stopword_export": stopword_export,
            "template_export": template_export,
            "phrase_table": phrase_table,
            "duplicate_audit": duplicate_audit,
            "duplicate_summary": duplicate_summary,
            "policy_table": policy_table,
            "policy_decision": policy_decision,
            "selected": selected,
            "development_records": development_records,
            "train_records": train_records,
            "validation_records": validation_records,
            "descriptions": descriptions,
            "descriptor_contamination_rate": contamination,
        }
        if effective_cache:
            temp_path = cache_path.with_suffix(".tmp.joblib")
            joblib.dump(
                {
                    "pipeline_version": PIPELINE_VERSION,
                    "source_fingerprint": code_hash,
                    "key_fingerprint": key_fingerprint,
                    "core": core,
                },
                temp_path,
                compress=3,
            )
            os.replace(temp_path, cache_path)
    else:
        stage_rows.append(
            {"stage": "development_core_cache", "seconds": 0.0, "cache_hit": True}
        )

    noise_model: NoiseModel = core["noise_model"]
    noise_audit: pd.DataFrame = core["noise_audit"]
    stopword_export: pd.DataFrame = core["stopword_export"]
    template_export: pd.DataFrame = core["template_export"]
    phrase_table: pd.DataFrame = core["phrase_table"]
    duplicate_audit: pd.DataFrame = core["duplicate_audit"]
    duplicate_summary: Dict[str, Any] = core["duplicate_summary"]
    policy_table: pd.DataFrame = core["policy_table"]
    policy_decision: Dict[str, Any] = core["policy_decision"]
    selected: PolicyResult = core["selected"]
    development_records: List[Dict[str, Any]] = core["development_records"]
    descriptions: Dict[int, Dict[str, Any]] = core["descriptions"]

    # Freeze every development-time decision before any locked-test content is transformed.
    t0 = time.perf_counter()
    selection_lock = write_selection_lock(
        outdir,
        frame,
        config,
        selected,
        policy_decision,
        noise_model,
        phrase_table,
        code_hash,
    )
    stage_rows.append(
        {
            "stage": "selection_lock",
            "seconds": time.perf_counter() - t0,
            "cache_hit": False,
        }
    )

    # Locked-test evaluation starts only after the lock file exists.
    t0 = time.perf_counter()
    locked_frame = frame[frame["data_split"] == "locked_test"].copy()
    locked_records = build_interaction_records(
        locked_frame,
        phrase_table,
        ontology,
        ontology_mode,
        noise_model,
        pseudonym_key,
        selected.policy,
    )
    locked_metrics, locked_vectors, locked_labels, locked_strengths, locked_coherence = evaluation_metrics(
        selected.cluster_model,
        selected.latent,
        locked_records,
        noise_model,
        config,
    )
    stage_rows.append(
        {
            "stage": "locked_test_evaluation",
            "seconds": time.perf_counter() - t0,
            "cache_hit": False,
        }
    )

    all_records = development_records + locked_records
    t0 = time.perf_counter()
    all_vectors = selected.latent.transform(
        [record["_clean_text"] for record in all_records],
        [record["semantic_signature"] for record in all_records],
    )
    all_labels, all_strengths = predict_cluster(selected.cluster_model, all_vectors)
    train_positions = [
        i for i, record in enumerate(all_records) if record["data_split"] == "train"
    ]
    if len(train_positions) == len(selected.train_labels):
        for position, label, strength in zip(
            train_positions,
            selected.train_labels.tolist(),
            selected.train_strengths.tolist(),
        ):
            all_labels[position] = int(label)
            all_strengths[position] = float(strength)

    _, _, all_coherence = semantic_coherence_details(
        [record["_clean_text"] for record in all_records],
        all_labels,
        noise_model,
        config.coherence_top_terms,
        config.seed + 1709,
        config.coherence_bootstrap_repeats,
    )
    catalog = cluster_catalog(
        all_records,
        all_vectors,
        all_labels,
        all_strengths,
        descriptions,
        all_coherence,
        config,
    )
    similarity = cluster_similarity_table(all_vectors, all_labels, descriptions)
    stage_rows.append(
        {
            "stage": "all_split_transform_catalog",
            "seconds": time.perf_counter() - t0,
            "cache_hit": False,
        }
    )

    validation_metrics = selected.validation_metrics
    quality_gate = build_quality_gate(
        validation_metrics,
        locked_metrics,
        core["descriptor_contamination_rate"],
        selection_lock,
    )
    save_json(outdir / "quality_gate.json", quality_gate)

    t0 = time.perf_counter()
    public_records = [
        public_dictionary_record(
            record,
            int(all_labels[index]),
            float(all_strengths[index]),
            "unassigned"
            if int(all_labels[index]) == -1
            else descriptions.get(int(all_labels[index]), {}).get(
                "descriptor", f"cluster_{int(all_labels[index])}"
            ),
        )
        for index, record in enumerate(all_records)
    ]

    jsonl_path = outdir / "nora_entity_context_dictionary.jsonl"
    with jsonl_path.open("w", encoding="utf-8") as handle:
        for record in public_records:
            handle.write(json.dumps(to_plain(record), ensure_ascii=False) + "\n")
    json_path = outdir / "nora_entity_context_dictionary.json"
    save_json(
        json_path,
        {
            "pipeline": PIPELINE_NAME,
            "pipeline_version": PIPELINE_VERSION,
            "scope_lock": SCOPE_LOCK,
            "selection_lock_file": "selection_lock.json",
            "records": public_records,
        },
    )

    entity_df = flatten_field(public_records, "entities")
    context_df = flatten_field(public_records, "context")
    kv_df = flatten_field(public_records, "key_values")
    evidence_df = flatten_field(public_records, "diagnostic_evidence")
    cause_df = flatten_field(public_records, "root_cause")
    remediation_df = flatten_field(public_records, "remediation")
    relationship_df = flatten_field(public_records, "relationships")

    csv_outputs = (
        (entity_df, "entities.csv"),
        (context_df, "context.csv"),
        (kv_df, "key_values.csv"),
        (evidence_df, "diagnostic_evidence.csv"),
        (cause_df, "root_cause.csv"),
        (remediation_df, "remediation.csv"),
        (relationship_df, "relationships.csv"),
        (noise_audit, "noise_learning_audit.csv"),
        (stopword_export, "learned_stopwords.csv"),
        (template_export, "suppressed_template_phrases.csv"),
        (phrase_table, "protected_domain_signals.csv"),
        (duplicate_audit, "duplicate_family_audit.csv"),
        (policy_table, "noise_policy_ablation.csv"),
        (selected.search_table, "cluster_model_search.csv"),
        (catalog, "semantic_cluster_catalog.csv"),
        (similarity, "similar_cluster_pairs.csv"),
        (locked_coherence, "locked_test_cluster_coherence.csv"),
        (all_coherence, "all_cluster_coherence.csv"),
    )
    for data, filename in csv_outputs:
        data.to_csv(outdir / filename, index=False)

    save_cluster_heatmap(
        all_vectors,
        all_labels,
        descriptions,
        outdir / "semantic_cluster_similarity_heatmap.png",
        config.heatmap_top_n,
    )
    save_entity_type_heatmap(
        public_records,
        outdir / "entity_type_cooccurrence_heatmap.png",
    )
    save_cluster_projection(
        all_vectors,
        all_labels,
        descriptions,
        outdir / "semantic_cluster_projection.png",
        config.seed,
        config.projection_sample,
    )
    save_cluster_size_distribution(
        catalog,
        outdir / "semantic_cluster_size_distribution.png",
    )
    contingency_info = save_cluster_upstream_contingency(
        public_records,
        all_labels,
        outdir / "cluster_upstream_contingency_matrix.csv",
        outdir / "cluster_upstream_contingency_heatmap.png",
        config.contingency_top_labels,
    )

    cluster_summary = cluster_summary_json(
        all_labels,
        all_strengths,
        catalog,
        descriptions,
    )
    save_json(outdir / "cluster_summary.json", cluster_summary)
    save_json(outdir / "duplicate_family_summary.json", duplicate_summary)
    stage_rows.append(
        {
            "stage": "exports_and_visuals",
            "seconds": time.perf_counter() - t0,
            "cache_hit": False,
        }
    )

    model_info: Dict[str, Any] = {}
    if config.persist_model:
        t0 = time.perf_counter()
        bundle = PipelineBundle(
            pipeline_name=PIPELINE_NAME,
            pipeline_version=PIPELINE_VERSION,
            source_fingerprint=code_hash,
            ontology_entries=[asdict(entry) for entry in ontology_entries],
            ontology_mode=ontology_mode,
            noise_model=noise_model,
            domain_phrases=phrase_table.to_dict(orient="records"),
            selected_noise_policy=selected.policy,
            latent_model=selected.latent,
            cluster_model=selected.cluster_model,
            cluster_descriptions=descriptions,
            config={
                key: value
                for key, value in asdict(config).items()
                if key not in {"input_path", "outdir", "model_dir"}
            },
        )
        model_path = outdir / "nora_entity_context_v4_1_1_model.joblib"
        joblib.dump(
            {
                "artifact_format": ARTIFACT_FORMAT_VERSION,
                "runtime_versions": package_versions(),
                "source_fingerprint": code_hash,
                "bundle": bundle,
            },
            model_path,
            compress=3,
        )
        model_info = {
            "model_file": model_path.name,
            "model_sha256": sha256_file(model_path),
        }
        stage_rows.append(
            {
                "stage": "model_persistence",
                "seconds": time.perf_counter() - t0,
                "cache_hit": False,
            }
        )

    counts = {
        "interactions": len(public_records),
        "entities": len(entity_df),
        "context_records": len(context_df),
        "key_values": len(kv_df),
        "diagnostic_evidence": len(evidence_df),
        "root_cause_records": len(cause_df),
        "remediation_records": len(remediation_df),
        "relationships": len(relationship_df),
        "learned_stopwords": len(noise_model.learned_stopwords),
        "template_phrases": len(noise_model.template_phrases),
        "protected_domain_signals": int(phrase_table["selected_as_domain_signal"].sum()) if not phrase_table.empty else 0,
        "semantic_clusters": cluster_summary["cluster_count"],
        "semantic_outliers": cluster_summary["outlier_records"],
    }
    quality = {
        "train": selected.train_metrics,
        "validation": validation_metrics,
        "locked_test": locked_metrics,
        "descriptor_contamination_rate": core["descriptor_contamination_rate"],
        "cluster_method": selected.cluster_model.method,
        "cluster_parameters": selected.cluster_model.parameters,
        "stability_ari": selected.cluster_model.stability_ari,
        "outlier_jaccard": selected.cluster_model.outlier_jaccard,
    }

    report = {
        "pipeline": PIPELINE_NAME,
        "pipeline_version": PIPELINE_VERSION,
        "execution_status": "SUCCESS",
        "semantic_validation_status": quality_gate["semantic_validation_status"],
        "started_at_utc": started_at,
        "completed_at_utc": utc_now_iso(),
        "source_fingerprint": code_hash,
        "cache_hit": cache_hit,
        "cache_enabled_for_run": effective_cache,
        "runtime_versions": package_versions(),
        "dependency_audit": dependency_info,
        "schema": schema,
        "split_audit": split_audit,
        "scope_lock": SCOPE_LOCK,
        "selection_lock": selection_lock,
        "noise_policy": {
            "selected": selected.policy,
            "decision": policy_decision,
            "ablation_file": "noise_policy_ablation.csv",
            "learned_stopword_file": "learned_stopwords.csv",
            "suppressed_template_file": "suppressed_template_phrases.csv",
            "protected_signal_file": "protected_domain_signals.csv",
            "duplicate_family_file": "duplicate_family_audit.csv",
        },
        "counts": counts,
        "quality": quality,
        "quality_gate_file": "quality_gate.json",
        "ontology": {
            "mode": ontology_mode,
            "external_entries_loaded": len(ontology_entries),
            "inventory_file": "ontology_inventory.json",
            "alignment_reference": "ontology_alignment_reference.csv",
            "alignment_families": [
                "TR290",
                "TR290V",
                "TR292",
                "TR292A",
                "TR292C",
                "TR292D",
                "TR292G",
            ],
            "formal_ontology_claim": ontology_mode == "graph_backed_local_ontology",
        },
        "dictionary_outputs": {
            "jsonl": jsonl_path.name,
            "json": json_path.name,
        },
        "cluster_outputs": {
            "summary": "cluster_summary.json",
            "catalog": "semantic_cluster_catalog.csv",
            "similarity_heatmap": "semantic_cluster_similarity_heatmap.png",
            "projection": "semantic_cluster_projection.png",
            "size_distribution": "semantic_cluster_size_distribution.png",
            "cluster_label_matrix": contingency_info,
        },
        "privacy": {
            "raw_identifiers_exported": False,
            "pseudonym_key_source": key_source,
            "pseudonym_key_fingerprint": key_fingerprint,
        },
        "model": model_info,
        "stage_metrics": stage_rows,
    }

    report_path = outdir / "nora_entity_context_v4_1_1_report.json"
    save_json(report_path, report)
    pd.DataFrame(stage_rows).to_csv(outdir / "stage_metrics.csv", index=False)

    html_path = write_html_summary(
        outdir,
        report,
        quality_gate,
        catalog,
        stopword_export,
        template_export,
        phrase_table,
        entity_df,
        context_df,
        similarity,
        policy_table,
    )

    manifest = {
        "artifact_format": ARTIFACT_FORMAT_VERSION,
        "pipeline": PIPELINE_NAME,
        "pipeline_version": PIPELINE_VERSION,
        "source_fingerprint": code_hash,
        "created_at_utc": utc_now_iso(),
        "runtime_versions": package_versions(),
        "selection_lock_sha256": sha256_file(outdir / "selection_lock.json"),
        "quality_gate_sha256": sha256_file(outdir / "quality_gate.json"),
        "artifacts": {
            "model": model_info,
            "report": {
                "file": report_path.name,
                "sha256": sha256_file(report_path),
            },
            "dictionary_json": {
                "file": json_path.name,
                "sha256": sha256_file(json_path),
            },
            "dictionary_jsonl": {
                "file": jsonl_path.name,
                "sha256": sha256_file(jsonl_path),
            },
            "html": {
                "file": str(html_path.relative_to(outdir)),
                "sha256": sha256_file(html_path),
            },
            "cluster_summary": {
                "file": "cluster_summary.json",
                "sha256": sha256_file(outdir / "cluster_summary.json"),
            },
        },
    }
    save_json(outdir / "model_manifest.json", manifest)

    LOGGER.info(
        "COMPLETE: execution=%s semantic_validation=%s clusters=%d outdir=%s",
        report["execution_status"],
        report["semantic_validation_status"],
        counts["semantic_clusters"],
        outdir.resolve(),
    )
    return report


# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------

def run_inference(config: Config) -> Dict[str, Any]:
    outdir = Path(config.outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    dependency_audit(config, outdir)

    model_dir = Path(config.model_dir or "")
    manifest_path = model_dir / "model_manifest.json"
    if not manifest_path.exists():
        raise FileNotFoundError(f"Model manifest not found: {manifest_path}")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    model_meta = manifest.get("artifacts", {}).get("model", {})
    model_file = model_meta.get("model_file")
    if not model_file:
        raise RuntimeError("Model file is not recorded in the manifest.")

    model_path = model_dir / model_file
    if model_meta.get("model_sha256") and sha256_file(model_path) != model_meta["model_sha256"]:
        raise RuntimeError("Model checksum mismatch.")
    payload = joblib.load(model_path)
    if payload.get("artifact_format") != ARTIFACT_FORMAT_VERSION:
        raise RuntimeError("Artifact format mismatch; retrain with NORA Entity-Context 4.1.1.")
    bundle: PipelineBundle = payload["bundle"]

    frame, schema = load_and_prepare(config)
    key, key_source, key_fingerprint = resolve_pseudonym_key(config)
    frame["data_split"] = "inference"
    frame["_row_ref"] = [
        pseudonymize(f"{group}|{row_id}", key)
        for group, row_id in zip(frame["_group"].astype(str), frame["_row_id"].astype(str))
    ]

    ontology = OntologyMatcher(
        [OntologyEntry(**entry) for entry in bundle.ontology_entries],
        config.ontology_match_threshold,
    )
    phrase_table = pd.DataFrame(bundle.domain_phrases)
    records = build_interaction_records(
        frame,
        phrase_table,
        ontology,
        bundle.ontology_mode,
        bundle.noise_model,
        key,
        bundle.selected_noise_policy,
    )
    vectors = bundle.latent_model.transform(
        [record["_clean_text"] for record in records],
        [record["semantic_signature"] for record in records],
    )
    labels, strengths = predict_cluster(bundle.cluster_model, vectors)
    public_records = [
        public_dictionary_record(
            record,
            int(labels[index]),
            float(strengths[index]),
            "unassigned"
            if int(labels[index]) == -1
            else bundle.cluster_descriptions.get(int(labels[index]), {}).get(
                "descriptor", f"cluster_{int(labels[index])}"
            ),
        )
        for index, record in enumerate(records)
    ]

    jsonl_path = outdir / "nora_entity_context_inference.jsonl"
    with jsonl_path.open("w", encoding="utf-8") as handle:
        for record in public_records:
            handle.write(json.dumps(to_plain(record), ensure_ascii=False) + "\n")
    json_path = outdir / "nora_entity_context_inference.json"
    save_json(
        json_path,
        {
            "pipeline": PIPELINE_NAME,
            "pipeline_version": PIPELINE_VERSION,
            "records": public_records,
        },
    )

    report = {
        "pipeline": PIPELINE_NAME,
        "pipeline_version": PIPELINE_VERSION,
        "mode": "infer",
        "execution_status": "SUCCESS",
        "input_rows": len(frame),
        "interaction_records": len(public_records),
        "assigned_fraction": float(np.mean(labels != -1)) if len(labels) else 0.0,
        "cluster_count": int(len(set(labels[labels != -1].tolist()))),
        "pseudonym_key_source": key_source,
        "pseudonym_key_fingerprint": key_fingerprint,
        "schema": schema,
        "noise_policy": bundle.selected_noise_policy,
        "ontology_mode": bundle.ontology_mode,
        "outputs": {
            "jsonl": jsonl_path.name,
            "json": json_path.name,
        },
    }
    save_json(outdir / "nora_entity_context_inference_report.json", report)
    return report


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def parse_args(argv: Optional[Sequence[str]] = None) -> Config:
    parser = argparse.ArgumentParser(description=PIPELINE_NAME)
    parser.add_argument("--mode", choices=["train", "infer"], default="train")
    parser.add_argument("--profile", choices=["fast_dev", "production"], default="production")
    parser.add_argument("--input", required=True, dest="input_path")
    parser.add_argument("--outdir", default="nora_entity_context_v411_out")
    parser.add_argument("--model-dir")
    parser.add_argument(
        "--ontology",
        action="append",
        default=[],
        help=(
            "Optional local ontology/lexicon file. Repeat for multiple files. "
            "Supported: CSV, JSON, JSONL, TTL, RDF, OWL, XML, JSON-LD, NT, N3."
        ),
    )
    parser.add_argument("--stopword-seed", dest="stopword_seed_path")
    parser.add_argument("--seed", type=int, default=DEFAULT_SEED)
    parser.add_argument("--sample", type=int, default=0, dest="sample_rows")
    parser.add_argument("--test-size", type=float, default=0.20)
    parser.add_argument("--validation-within-development", type=float, default=0.15)
    parser.add_argument("--split-trials", type=int, default=64)
    parser.add_argument("--max-word-features", type=int, default=70000)
    parser.add_argument("--max-char-features", type=int, default=90000)
    parser.add_argument("--max-semantic-features", type=int, default=50000)
    parser.add_argument("--svd-components", type=int, default=192)
    parser.add_argument("--candidate-noise-features", type=int, default=70000)
    parser.add_argument("--noise-ngram-max", type=int, default=3)
    parser.add_argument("--model-search-trials", type=int, default=20)
    parser.add_argument("--stability-repeats", type=int, default=4)
    parser.add_argument("--search-sample-rows", type=int, default=8000)
    parser.add_argument("--transform-batch-size", type=int, default=4096)
    parser.add_argument("--representative-examples", type=int, default=4)
    parser.add_argument("--ontology-match-threshold", type=float, default=0.82)
    parser.add_argument("--phrase-min-df", type=int, default=3)
    parser.add_argument("--phrase-top-candidates", type=int, default=5000)
    parser.add_argument("--semantic-weight", type=float, default=2.10)
    parser.add_argument("--word-weight", type=float, default=0.75)
    parser.add_argument("--char-weight", type=float, default=0.30)
    parser.add_argument("--no-persist-model", action="store_true")
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--pseudonym-key-env", default="NORA_PSEUDONYM_KEY")
    parser.add_argument("--heatmap-top-n", type=int, default=24)
    parser.add_argument("--top-cluster-terms", type=int, default=10)
    parser.add_argument("--projection-sample", type=int, default=3000)
    parser.add_argument("--contingency-top-labels", type=int, default=25)
    parser.add_argument("--coherence-top-terms", type=int, default=10)
    parser.add_argument("--coherence-bootstrap-repeats", type=int, default=200)
    parser.add_argument("--fail-on-quality-gate", action="store_true")
    args = parser.parse_args(argv)

    if not 0.05 <= args.test_size <= 0.40:
        parser.error("--test-size must be between 0.05 and 0.40")
    if not 0.05 <= args.validation_within_development <= 0.35:
        parser.error("--validation-within-development must be between 0.05 and 0.35")
    if args.mode == "infer" and not args.model_dir:
        parser.error("--model-dir is required for inference")
    if not 0.50 <= args.ontology_match_threshold <= 0.99:
        parser.error("--ontology-match-threshold must be between 0.50 and 0.99")
    if args.coherence_bootstrap_repeats < 20:
        parser.error("--coherence-bootstrap-repeats must be at least 20")

    if args.profile == "fast_dev":
        args.model_search_trials = min(args.model_search_trials, 8)
        args.stability_repeats = min(args.stability_repeats, 3)
        args.search_sample_rows = min(args.search_sample_rows, 4000)
        args.phrase_top_candidates = min(args.phrase_top_candidates, 2500)
        args.svd_components = min(args.svd_components, 128)
        args.projection_sample = min(args.projection_sample, 1500)
        args.coherence_bootstrap_repeats = min(args.coherence_bootstrap_repeats, 100)

    return Config(
        input_path=args.input_path,
        outdir=args.outdir,
        mode=args.mode,
        model_dir=args.model_dir,
        ontology_paths=tuple(args.ontology),
        stopword_seed_path=args.stopword_seed_path,
        profile=args.profile,
        seed=args.seed,
        sample_rows=args.sample_rows,
        test_size=args.test_size,
        validation_within_development=args.validation_within_development,
        split_trials=args.split_trials,
        max_word_features=args.max_word_features,
        max_char_features=args.max_char_features,
        max_semantic_features=args.max_semantic_features,
        svd_components=args.svd_components,
        candidate_noise_features=args.candidate_noise_features,
        noise_ngram_max=args.noise_ngram_max,
        model_search_trials=args.model_search_trials,
        stability_repeats=args.stability_repeats,
        search_sample_rows=args.search_sample_rows,
        transform_batch_size=args.transform_batch_size,
        representative_examples=args.representative_examples,
        ontology_match_threshold=args.ontology_match_threshold,
        phrase_min_df=args.phrase_min_df,
        phrase_top_candidates=args.phrase_top_candidates,
        semantic_weight=args.semantic_weight,
        word_weight=args.word_weight,
        char_weight=args.char_weight,
        persist_model=not args.no_persist_model,
        enable_cache=not args.no_cache,
        pseudonym_key_env=args.pseudonym_key_env,
        heatmap_top_n=args.heatmap_top_n,
        top_cluster_terms=args.top_cluster_terms,
        projection_sample=args.projection_sample,
        contingency_top_labels=args.contingency_top_labels,
        coherence_top_terms=args.coherence_top_terms,
        coherence_bootstrap_repeats=args.coherence_bootstrap_repeats,
        fail_on_quality_gate=args.fail_on_quality_gate,
    )


def main(argv: Optional[Sequence[str]] = None) -> int:
    configure_logging()
    try:
        config = parse_args(argv)
        if config.mode == "train":
            report = run_train(config)
            if (
                config.fail_on_quality_gate
                and report.get("semantic_validation_status") == "FAIL"
            ):
                LOGGER.error("Semantic quality gate failed.")
                return 2
        else:
            run_inference(config)
        return 0
    except KeyboardInterrupt:
        LOGGER.error("Interrupted by user.")
        return 130
    except Exception as exc:
        LOGGER.exception("Pipeline failed: %s", exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
