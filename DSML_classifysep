        causes = build_cause_records(contexts, evidence)
        remediation = build_remediation_records(contexts, evidence)
        relationships = build_relationships(entities, contexts, kvs, causes, remediation)
        base = imap[str(group)]
        actor_names = []
        for entity in entities:
            if entity.get("entity_type") == "ACTOR":
                name = str(entity.get("canonical_name", "")).strip()
                if name and name not in actor_names:
                    actor_names.append(name)

        rows.append({
            "interaction_ref": base["interaction_ref"],
            "data_split": base["data_split"],
            "message_count": base["message_count"],
            "upstream_labels_passthrough": base["upstream_labels_passthrough"],
            "content": {
                "customer_problem": str(base["customer_text"]),
                "assistant_response": str(base["assistant_text"]),
                "evidence_text": str(base["evidence_text"]),
            },
            "actors": actor_names,
            "entities": entities,
            "context": contexts,
            "key_values": kvs,
            "diagnostic_evidence": evidence,
            "root_cause": causes,
            "remediation": remediation,
            "relationships": relationships,
            "evidence_summary": {
                "entity_mean": float(np.mean([safe_float(x["evidence_strength"]) for x in entities])) if entities else None,
                "context_mean": float(np.mean([safe_float(x["evidence_strength"]) for x in contexts])) if contexts else None,
                "diagnostic_mean": float(np.mean([safe_float(x["evidence_strength"]) for x in evidence])) if evidence else None,
                "root_cause_mean": float(np.mean([safe_float(x["evidence_strength"]) for x in causes])) if causes else None,
                "remediation_mean": float(np.mean([safe_float(x["evidence_strength"]) for x in remediation])) if remediation else None,
            },
            "_customer_text": str(base["customer_text"]),
            "_customer_clean_text": apply_noise_model(str(base["customer_text"]), noise),
            "_customer_semantic_signature": customer_semantic_signature(
                customer_entities, customer_contexts
            ),
            "_assistant_text": str(base["assistant_text"]),
            "_evidence_text": str(base["evidence_text"]),
        })
