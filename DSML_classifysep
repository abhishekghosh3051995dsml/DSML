    if a.mode=="infer" and not a.model_dir:p.error("--model-dir is required for inference")
    if a.profile=="fast_dev":a.model_search_trials=min(a.model_search_trials,8);a.stability_repeats=min(a.stability_repeats,3);a.phrase_top_candidates=min(a.phrase_top_candidates,2500);a.svd_components=min(a.svd_components,128);a.projection_sample=min(a.projection_sample,1500);a.metric_bootstrap_repeats=min(a.metric_bootstrap_repeats,20)
    return Config(input_path=a.input_path,outdir=a.outdir,mode=a.mode,model_dir=a.model_dir,entity_seed_path=a.entity_seed_path,stopword_seed_path=a.stopword_seed_path,profile=a.profile,seed=a.seed,sample_rows=a.sample_rows,test_size=a.test_size,validation_within_development=a.validation_within_development,split_trials=a.split_trials,max_word_features=a.max_word_features,max_char_features=a.max_char_features,max_semantic_features=a.max_semantic_features,svd_components=a.svd_components,candidate_noise_features=a.candidate_noise_features,noise_ngram_max=a.noise_ngram_max,duplicate_projection_components=a.duplicate_projection_components,duplicate_neighbors=a.duplicate_neighbors,model_search_trials=a.model_search_trials,stability_repeats=a.stability_repeats,transform_batch_size=a.transform_batch_size,representative_examples=a.representative_examples,phrase_min_df=a.phrase_min_df,phrase_top_candidates=a.phrase_top_candidates,semantic_weight=a.semantic_weight,word_weight=a.word_weight,char_weight=a.char_weight,persist_model=not a.no_persist_model,enable_cache=not a.no_cache,pseudonym_key_env=a.pseudonym_key_env,heatmap_top_n=a.heatmap_top_n,top_cluster_terms=a.top_cluster_terms,projection_sample=a.projection_sample,coherence_top_terms=a.coherence_top_terms,metric_bootstrap_repeats=a.metric_bootstrap_repeats,fail_on_quality_gate=a.fail_on_quality_gate)

def main(argv=None):
    configure_logging()
    try:
        c=parse_args(argv)
        if c.mode=="train":
            report=run_train(c)
            if c.fail_on_quality_gate and report.get("semantic_validation_status")=="FAIL":LOGGER.error("Semantic quality gate failed.");return 2
        else:run_inference(c)
        return 0
    except KeyboardInterrupt:LOGGER.error("Interrupted by user.");return 130
    except Exception as exc:LOGGER.exception("Pipeline failed: %s",exc);return 1

if __name__=="__main__":sys.exit(main())
