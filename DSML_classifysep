    if role=="customer":rows.append({"surface":"customer","canonical_name":"customer","entity_type":"ACTOR","evidence_strength":.99,"method":"interaction_role","evidence_ref":ref})
    if role=="assistant":rows.append({"surface":"assistant","canonical_name":"assistant","entity_type":"ACTOR","evidence_strength":.99,"method":"interaction_role","evidence_ref":ref})
    joined=f"{role_source} {text}"
    if USER_MENTION_RE.search(joined):rows.append({"surface":"user","canonical_name":"user","entity_type":"ACTOR","evidence_strength":.94,"method":"explicit_actor_mention","evidence_ref":ref})
    if CUSTOMER_MENTION_RE.search(text) and role!="customer":rows.append({"surface":"customer","canonical_name":"customer","entity_type":"ACTOR","evidence_strength":.94,"method":"explicit_actor_mention","evidence_ref":ref})
    m=CALL_CENTER_RE.search(joined)
    if m:rows.append({"surface":m.group(0),"canonical_name":"call center","entity_type":"ACTOR","evidence_strength":.95,"method":"explicit_actor_mention","evidence_ref":ref})
    return dedupe_dicts(rows,("canonical_name","entity_type","evidence_ref"))

def extract_domain_cue_entities(text,ref):
    n=" "+normalize_term(text)+" ";rows=[]
    service_phrases=("mobile data","voice calls","voice call","text messaging","wi-fi calling","wifi calling")
    covered=set()
    for phrase in service_phrases:
        if f" {phrase} " in n:
            rows.append({"surface":phrase,"canonical_name":phrase,"entity_type":"SERVICE","evidence_strength":.88,"method":"domain_cue","evidence_ref":ref});covered.update(phrase.split())
    for token in tokenize(text):
        if token in DEVICE_CUES:
            rows.append({"surface":token,"canonical_name":token,"entity_type":"DEVICE_OR_RESOURCE","evidence_strength":.86,"method":"domain_cue","evidence_ref":ref})
        if token in NETWORK_CUES:
            rows.append({"surface":token,"canonical_name":token,"entity_type":"NETWORK_TECHNOLOGY","evidence_strength":.86,"method":"domain_cue","evidence_ref":ref})
        if token in NETWORK_DOMAIN_CUES:
            rows.append({"surface":token,"canonical_name":token,"entity_type":"NETWORK_DOMAIN","evidence_strength":.82,"method":"domain_cue","evidence_ref":ref})
        if token in SERVICE_CUES and token not in covered and token not in DEVICE_CUES and token not in NETWORK_CUES and token not in NETWORK_DOMAIN_CUES:
            rows.append({"surface":token,"canonical_name":token,"entity_type":"SERVICE","evidence_strength":.84,"method":"domain_cue","evidence_ref":ref})
    return dedupe_dicts(rows,("canonical_name","entity_type","evidence_ref"))

