        entities, contexts, kvs = [], [], []
        customer_entities, customer_contexts = [], []
        for _, row in block.iterrows():
            text = str(row["_sanitized_text"])
            role = str(row["_role"])
            role_source = str(row["_role_source"])
            ref = str(row["_row_ref"])
            local_kv = extract_key_values(text, ref)
