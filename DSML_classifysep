                text, role, ref, SAFE_ENGLISH_STOPWORDS | noise.learned_stopwords
            )
            local_entities = extract_structured_entities(
                text, role, role_source, ref, local_context, local_kv, pt, entity_matcher
            )
            kvs.extend(local_kv)
