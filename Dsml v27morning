def cluster_similarity_table(
    vectors: np.ndarray, labels: np.ndarray, descriptions: Dict[int, Dict[str, Any]]
) -> pd.DataFrame:
    ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if len(ids) < 2:
        return pd.DataFrame(columns=["cluster_a", "cluster_b", "cosine_similarity", "descriptor_a", "descriptor_b"])
    centroids = []
    for cid in ids:
        c = vectors[labels == cid].mean(axis=0)
        norm = np.linalg.norm(c)
        centroids.append(c / norm if norm > 0 else c)
    matrix = np.vstack(centroids)
    sims = matrix @ matrix.T
    rows = []
    for i, a in enumerate(ids):
        for j in range(i + 1, len(ids)):
            b = ids[j]
            rows.append({
                "cluster_a": a,
                "cluster_b": b,
                "cosine_similarity": float(sims[i, j]),
                "descriptor_a": descriptions.get(a, {}).get("descriptor", f"cluster_{a}"),
                "descriptor_b": descriptions.get(b, {}).get("descriptor", f"cluster_{b}"),
            })
    return pd.DataFrame(rows).sort_values("cosine_similarity", ascending=False).reset_index(drop=True)


def save_annotated_similarity_heatmap(
    vectors: np.ndarray,
    labels: np.ndarray,
    descriptions: Dict[int, Dict[str, Any]],
    path: Path,
    title: str,
    top_n: int,
) -> None:
    ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if len(ids) < 2:
        return
    counts = {cid: int(np.sum(labels == cid)) for cid in ids}
    ids = sorted(ids, key=lambda c: counts[c], reverse=True)[:max(2, top_n)]
    centroids = []
    for cid in ids:
        c = vectors[labels == cid].mean(axis=0)
        norm = np.linalg.norm(c)
        centroids.append(c / norm if norm > 0 else c)
    sims = np.clip(np.vstack(centroids) @ np.vstack(centroids).T, -1.0, 1.0)
    if len(ids) >= 3:
        dist = np.clip(1.0 - sims, 0.0, 2.0)
        np.fill_diagonal(dist, 0.0)
        order = leaves_list(linkage(squareform(dist, checks=False), method="average")).tolist()
        ids = [ids[i] for i in order]
        sims = sims[np.ix_(order, order)]
    labels_text = []
    for cid in ids:
        desc = str(descriptions.get(cid, {}).get("descriptor", f"cluster_{cid}"))
        labels_text.append(f"{cid}: {desc.split(' | ')[0][:28]}")
    size = max(9.0, min(18.0, 0.62 * len(ids) + 5.0))
    fig, ax = plt.subplots(figsize=(size, size))
    image = ax.imshow(sims, cmap="RdBu_r", vmin=-1.0, vmax=1.0, aspect="auto")
    ax.set_title(title, fontsize=14, pad=16)
    ax.set_xticks(np.arange(len(ids)))
    ax.set_yticks(np.arange(len(ids)))
    ax.set_xticklabels(labels_text, rotation=90, fontsize=8)
    ax.set_yticklabels(labels_text, fontsize=8)
    ax.set_xlabel("Cluster ID : primary descriptor")
    ax.set_ylabel("Cluster ID : primary descriptor")
    if len(ids) <= 24:
        for i in range(len(ids)):
            for j in range(len(ids)):
                value = float(sims[i, j])
                ax.text(
                    j, i, f"{value:.2f}", ha="center", va="center",
                    fontsize=6.8, color="white" if abs(value) >= 0.58 else "black",
                )
    cbar = fig.colorbar(image, ax=ax, fraction=0.046, pad=0.04)
    cbar.set_label("Centroid cosine similarity (-1 to +1)")
    fig.tight_layout()
    fig.savefig(path, dpi=180, bbox_inches="tight")
    plt.close(fig)


