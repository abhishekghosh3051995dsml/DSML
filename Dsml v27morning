def descriptor_term_allowed(term: str, noise_model: NoiseModel) -> bool:
    normalized = " ".join(tokenize(term))
    if not normalized:
        return False
    tokens = normalized.split()
    if any(t in STRUCTURAL_PLACEHOLDER_TOKENS for t in tokens):
        return False
    if normalized in noise_model.descriptor_blocklist and normalized not in noise_model.protected_phrases:
        return False
    if len(tokens) == 1:
        if tokens[0] in NEGATION_KEEP or tokens[0] in GENERIC_FUNCTION_TOKENS:
            return False
        if tokens[0] in noise_model.unigrams and tokens[0] not in noise_model.protected_unigrams:
            return False
        return True
    content = [
        t for t in tokens
        if t not in noise_model.unigrams
        and t not in STRUCTURAL_PLACEHOLDER_TOKENS
        and t not in NEGATION_KEEP
        and t not in GENERIC_FUNCTION_TOKENS
    ]
    has_negation = any(t in NEGATION_KEEP for t in tokens)
    if len(content) < 2 and not (has_negation and len(content) >= 1):
        return False
    return True


def diverse_top_terms(terms: np.ndarray, scores: np.ndarray, top_n: int) -> List[int]:
    ranked = [int(i) for i in np.argsort(scores)[::-1] if scores[int(i)] > 0]
    chosen: List[int] = []
    while ranked and len(chosen) < top_n:
        best_idx = None
        best_value = float("-inf")
        for idx in ranked[: min(250, len(ranked))]:
            tokens = set(str(terms[idx]).split())
            redundancy = 0.0
            if chosen:
                redundancy = max(
                    len(tokens & set(str(terms[c]).split())) / max(len(tokens | set(str(terms[c]).split())), 1)
                    for c in chosen
                )
            value = float(scores[idx]) * (1.0 - 0.75 * redundancy)
            if value > best_value:
                best_value = value
                best_idx = idx
        if best_idx is None:
            break
        chosen.append(best_idx)
        ranked.remove(best_idx)
    return chosen


def discriminative_descriptions(
    texts: Sequence[str],
    labels: np.ndarray,
    noise_model: NoiseModel,
    config: Config,
) -> Tuple[Dict[int, Dict[str, Any]], pd.DataFrame]:
    ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if not ids:
        return {}, pd.DataFrame()

    vectorizer = CountVectorizer(
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(1, 3),
        min_df=1,
        max_features=config.descriptor_max_features,
        binary=False,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b",
        stop_words=None,
    )
    counts = vectorizer.fit_transform(list(texts)).tocsr().astype(np.float64)
    binary = (counts > 0).astype(np.float64).tocsr()
    terms = np.asarray(vectorizer.get_feature_names_out())
    global_counts = np.asarray(counts.sum(axis=0)).ravel().astype(float)
    global_df = np.asarray(binary.sum(axis=0)).ravel().astype(float)
    total_tokens = float(global_counts.sum())
    total_docs = float(len(texts))

    prior_strength = max(10.0, math.sqrt(max(total_tokens, 1.0)))
    prior_prob = np.clip(global_counts / max(total_tokens, 1.0), 1e-12, 1.0)
    alpha = prior_strength * prior_prob
    alpha0 = float(alpha.sum())

    # BM25-inspired class weighting on grouped cluster counts.
    grouped_counts = []
    grouped_df = []
    for cid in ids:
        mask = labels == cid
        grouped_counts.append(np.asarray(counts[mask].sum(axis=0)).ravel().astype(float))
        grouped_df.append(np.asarray(binary[mask].sum(axis=0)).ravel().astype(float))
    class_counts = np.vstack(grouped_counts)
    class_df = np.vstack(grouped_df)
    class_token_totals = class_counts.sum(axis=1)
    avg_class_tokens = max(float(np.mean(class_token_totals)), 1.0)
    corpus_term_frequency = class_counts.sum(axis=0)
    bm25_idf = np.log1p(np.maximum((avg_class_tokens - corpus_term_frequency + 0.5) / (corpus_term_frequency + 0.5), 1e-12))

    audit_rows: List[Dict[str, Any]] = []
    output: Dict[int, Dict[str, Any]] = {}

    for row_idx, cid in enumerate(ids):
        cluster_mask = labels == cid
        cluster_docs = int(cluster_mask.sum())
        cluster_counts = class_counts[row_idx]
        cluster_df = class_df[row_idx]
        rest_counts = global_counts - cluster_counts
        rest_tokens = max(total_tokens - class_token_totals[row_idx], 1.0)

        tf = cluster_counts / max(class_token_totals[row_idx], 1.0)
        tf = np.sqrt(tf)
        bm25_ctfidf = tf * bm25_idf

        delta = (
            np.log((cluster_counts + alpha) / np.maximum(class_token_totals[row_idx] + alpha0 - cluster_counts - alpha, 1e-12))
            - np.log((rest_counts + alpha) / np.maximum(rest_tokens + alpha0 - rest_counts - alpha, 1e-12))
        )
        var = 1.0 / np.maximum(cluster_counts + alpha, 1e-12) + 1.0 / np.maximum(rest_counts + alpha, 1e-12)
        log_odds_z = delta / np.sqrt(np.maximum(var, 1e-12))
        log_odds_z = np.maximum(log_odds_z, 0.0)

        cluster_rate = cluster_df / max(cluster_docs, 1)
        global_rate = global_df / max(total_docs, 1.0)
        specificity = np.clip(cluster_rate / np.maximum(global_rate, 1e-12), 0.0, 50.0)
        specificity_unit = 1.0 - np.exp(-specificity / 3.0)
        support_unit = np.sqrt(np.clip(cluster_rate, 0.0, 1.0))

        eligible = np.zeros(len(terms), dtype=bool)
        phrase_assoc = np.zeros(len(terms), dtype=float)
        min_support = max(int(config.descriptor_min_support), int(round(math.log2(max(cluster_docs, 4)) / 2.0)))
        support_mask = (cluster_df >= min_support) & (log_odds_z > 0.0)
        z_floor = float(np.median(log_odds_z[support_mask])) if support_mask.any() else 0.0
        unigram_df_map = {
            str(term): float(global_df[i])
            for i, term in enumerate(terms.tolist())
            if " " not in str(term)
        }
        for j, term in enumerate(terms.tolist()):
            normalized = str(term)
            if cluster_df[j] < min_support:
                continue
            if not descriptor_term_allowed(normalized, noise_model):
                continue
            if normalized not in noise_model.protected_phrases and normalized not in noise_model.protected_unigrams:
                if log_odds_z[j] < z_floor:
                    continue
            if " " in normalized:
                assoc = phrase_association_npmi(normalized, global_df[j], unigram_df_map, len(texts))
                phrase_assoc[j] = (assoc + 1.0) / 2.0 if np.isfinite(assoc) else 0.0
                if phrase_assoc[j] <= 0.25 and normalized not in noise_model.protected_phrases:
                    continue
            else:
                phrase_assoc[j] = 1.0
            eligible[j] = True

        components = np.vstack([
            pd.Series(bm25_ctfidf).rank(pct=True).to_numpy(float),
            pd.Series(log_odds_z).rank(pct=True).to_numpy(float),
            np.clip(specificity_unit, 0.0, 1.0),
            np.clip(support_unit, 0.0, 1.0),
            np.clip(phrase_assoc, 0.0, 1.0),
        ])
        combined = np.exp(np.mean(np.log(np.clip(components, 1e-9, 1.0)), axis=0))
        combined[~eligible] = 0.0
        chosen = diverse_top_terms(terms, combined, config.descriptor_top_terms)

        keywords = []
        for j in chosen:
            item = {
                "term": str(terms[j]),
                "score": float(combined[j]),
                "cluster_document_frequency": int(cluster_df[j]),
                "cluster_document_rate": float(cluster_rate[j]),
                "global_document_rate": float(global_rate[j]),
                "specificity_ratio": float(specificity[j]),
                "log_odds_z": float(log_odds_z[j]),
                "bm25_ctfidf": float(bm25_ctfidf[j]),
                "cluster_log_odds_z_floor": float(z_floor),
            }
            keywords.append(item)
            audit_rows.append({"cluster_id": cid, **item})

        output[cid] = {
            "descriptor": " | ".join(x["term"] for x in keywords[:5]) or f"cluster_{cid}",
            "keywords": keywords,
        }

    return output, pd.DataFrame(audit_rows)


def descriptor_term_map(descriptions: Dict[int, Dict[str, Any]], top_terms: int) -> Dict[int, List[str]]:
    out: Dict[int, List[str]] = {}
    for cid, payload in descriptions.items():
        terms: List[str] = []
        for item in payload.get("keywords", [])[:max(2, top_terms)]:
            term = " ".join(tokenize(str(item.get("term", ""))))
            if term and term not in terms:
                terms.append(term)
        out[int(cid)] = terms
    return out


def reference_term_matrix(reference_texts: Sequence[str], term_maps: Sequence[Dict[int, List[str]]]) -> Tuple[sparse.csr_matrix, Dict[str, int]]:
    vocabulary_terms = sorted({term for mapping in term_maps for terms in mapping.values() for term in terms})
    if not vocabulary_terms:
        return sparse.csr_matrix((len(reference_texts), 0), dtype=np.int8), {}
    vocabulary = {term: idx for idx, term in enumerate(vocabulary_terms)}
    vectorizer = CountVectorizer(
        lowercase=True, strip_accents="unicode", ngram_range=(1, 3),
        binary=True, vocabulary=vocabulary,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b",
    )
    matrix = vectorizer.transform(list(reference_texts)).tocsr()
    matrix.data[:] = 1
    return matrix, vocabulary


def npmi_from_matrix(
    matrix: sparse.csr_matrix,
    vocabulary: Dict[str, int],
    term_map: Dict[int, List[str]],
    row_indices: Optional[np.ndarray] = None,
) -> Tuple[float, Dict[int, float]]:
    view = matrix if row_indices is None else matrix[np.asarray(row_indices, dtype=int)]
    n_docs = int(view.shape[0])
    if n_docs <= 0:
        return float("nan"), {}
    df = np.asarray(view.sum(axis=0)).ravel().astype(float)
    per_cluster: Dict[int, float] = {}
    for cid, terms in term_map.items():
        cols = list(dict.fromkeys(vocabulary[t] for t in terms if t in vocabulary))
        if len(cols) < 2:
            per_cluster[int(cid)] = float("nan")
            continue
        scores: List[float] = []
        for i in range(len(cols)):
            for j in range(i + 1, len(cols)):
                a, b = cols[i], cols[j]
                p_a, p_b = df[a] / n_docs, df[b] / n_docs
                joint = float(view[:, a].multiply(view[:, b]).sum())
                p_ab = joint / n_docs
                if p_a <= 0 or p_b <= 0:
                    continue
                if p_ab <= 0:
                    scores.append(-1.0)
                    continue
                if p_ab >= 1.0 - 1e-12:
                    scores.append(0.0)
                    continue
                denom = -math.log(p_ab)
                if denom > 1e-12:
                    scores.append(float(math.log(p_ab / (p_a * p_b)) / denom))
        per_cluster[int(cid)] = float(np.mean(scores)) if scores else float("nan")
    finite = [v for v in per_cluster.values() if np.isfinite(v)]
    return (float(np.mean(finite)) if finite else float("nan")), per_cluster


def descriptor_diversity_metrics(term_map: Dict[int, List[str]]) -> Dict[str, float]:
    phrases = [term for terms in term_map.values() for term in terms]
    phrase_diversity = len(set(phrases)) / len(phrases) if phrases else float("nan")
    tokens = [token for phrase in phrases for token in tokenize(phrase)]
    token_diversity = len(set(tokens)) / len(tokens) if tokens else float("nan")
    cluster_sets = [set(token for phrase in terms for token in tokenize(phrase)) for terms in term_map.values()]
    overlaps: List[float] = []
    for i in range(len(cluster_sets)):
        for j in range(i + 1, len(cluster_sets)):
            union = cluster_sets[i] | cluster_sets[j]
            if union:
                overlaps.append(len(cluster_sets[i] & cluster_sets[j]) / len(union))
    redundancy = float(np.mean(overlaps)) if overlaps else 0.0
    vals = [x for x in (phrase_diversity, token_diversity, 1.0 - redundancy) if np.isfinite(x)]
    return {
        "descriptor_phrase_diversity": float(phrase_diversity),
        "descriptor_token_diversity": float(token_diversity),
        "descriptor_pairwise_jaccard_redundancy": redundancy,
        "descriptor_diversity_composite": float(np.mean(vals)) if vals else float("nan"),
    }


def interpretability_metrics(
    reference_texts: Sequence[str], descriptions: Dict[int, Dict[str, Any]], top_terms: int
) -> Tuple[Dict[str, float], Dict[int, float]]:
    term_map = descriptor_term_map(descriptions, top_terms)
    matrix, vocabulary = reference_term_matrix(reference_texts, [term_map])
    coherence, per_cluster = npmi_from_matrix(matrix, vocabulary, term_map)
    return {"npmi_coherence": coherence, **descriptor_diversity_metrics(term_map)}, per_cluster

