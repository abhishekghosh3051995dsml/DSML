def cluster_model_to_payload(model: ClusterModel) -> Dict[str, Any]:
    return {
        "method": model.method,
        "reducer": model.reducer,
        "clusterer": model.clusterer,
        "parameters": model.parameters,
        "global_stability_ari": model.global_stability_ari,
        "assigned_stability_ari": model.assigned_stability_ari,
        "outlier_jaccard": model.outlier_jaccard,
        "silhouette": model.silhouette,
        "density_validity": model.density_validity,
        "weighted_persistence": model.weighted_persistence,
        "selection_score": model.selection_score,
    }


def cluster_model_from_payload(payload: Dict[str, Any]) -> ClusterModel:
    return ClusterModel(**payload)


def recovery_to_payload(model: Optional[OutlierRecoveryModel]) -> Optional[Dict[str, Any]]:
    if model is None:
        return None
    return {
        "cluster_ids": np.asarray(model.cluster_ids, dtype=int),
        "centroids": np.asarray(model.centroids, dtype=np.float32),
        "similarity_floors": {int(k): float(v) for k, v in model.similarity_floors.items()},
        "margin_floors": {int(k): float(v) for k, v in model.margin_floors.items()},
        "fit_rows": int(model.fit_rows),
        "enabled": bool(model.enabled),
    }


def recovery_from_payload(payload: Optional[Dict[str, Any]]) -> Optional[OutlierRecoveryModel]:
    if not payload:
        return None
    return OutlierRecoveryModel(
        cluster_ids=np.asarray(payload.get("cluster_ids", []), dtype=int),
        centroids=np.asarray(payload.get("centroids", []), dtype=np.float32),
        similarity_floors={int(k): float(v) for k, v in payload.get("similarity_floors", {}).items()},
        margin_floors={int(k): float(v) for k, v in payload.get("margin_floors", {}).items()},
        fit_rows=int(payload.get("fit_rows", 0)),
        enabled=bool(payload.get("enabled", True)),
    )


def scrub_persisted_config(config: Dict[str, Any]) -> Dict[str, Any]:
    blocked = {"input_path", "outdir", "model_dir"}
    return {k: to_plain(v) for k, v in config.items() if k not in blocked}


def bundle_to_payload(bundle: CorpusBundle) -> Dict[str, Any]:
    return {
