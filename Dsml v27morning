def cache_signature(frame: pd.DataFrame, text_col: str, corpus_name: str, config: Config) -> str:
    h = hashlib.sha256()
    h.update(PIPELINE_VERSION.encode())
    h.update(corpus_name.encode())
    cfg = scrub_persisted_config(asdict(config))
    for key in ("export_review_text", "persist_models", "enable_cache"):
        cfg.pop(key, None)
    h.update(json.dumps(cfg, sort_keys=True).encode())
    cols = [c for c in ("_group", "data_split", text_col) if c in frame.columns]
    for row in frame[cols].astype(str).itertuples(index=False, name=None):
        h.update("\x1f".join(row).encode("utf-8", errors="ignore"))
        h.update(b"\n")
    return h.hexdigest()


def process_corpus_cached(
    frame: pd.DataFrame, text_col: str, corpus_name: str, config: Config
) -> Tuple[Dict[str, Any], bool]:
    if not config.enable_cache:
        return process_corpus(frame, text_col, corpus_name, config), False
    cache_dir = Path(config.outdir) / config.cache_dir_name
    cache_dir.mkdir(parents=True, exist_ok=True)
    path = cache_dir / f"{corpus_name}_{cache_signature(frame, text_col, corpus_name, config)}.joblib"
    if path.exists():
        try:
            payload = joblib.load(path)
            if isinstance(payload, dict) and payload.get("pipeline_version") == PIPELINE_VERSION:
                LOGGER.info("%s: CACHE HIT %s", corpus_name, path.name)
                return payload["result"], True
        except Exception as exc:
            LOGGER.warning("%s: cache ignored: %s", corpus_name, exc)
    result = process_corpus(frame, text_col, corpus_name, config)
    tmp = path.with_suffix(".tmp.joblib")
    joblib.dump({"pipeline_version": PIPELINE_VERSION, "result": result}, tmp, compress=3)
    os.replace(tmp, path)
    return result, False

