def persist_result(
    result: Dict[str, Any],
    prefix: str,
    outdir: Path,
    pseudonym_key: bytes,
    persist_models: bool,
    export_review_text: bool,
) -> Dict[str, Any]:
    safe_rows = privacy_safe_rows(result, pseudonym_key, export_review_text)
    pii_cols = ["phase2_cluster_descriptor"] + (["redacted_text"] if export_review_text else [])
    pii_scan = residual_pii_counts(safe_rows, pii_cols)
    if any(v > 0 for v in pii_scan.values()):
        raise RuntimeError(f"Privacy guard blocked {prefix} row export; residual counts={pii_scan}")
    safe_rows.to_csv(outdir / f"{prefix}_phase2_rows.csv", index=False)

    frames = [
        ("noise_table", "noise_terms"),
        ("protected_signal_table", "protected_signals"),
        ("noise_consensus_audit", "noise_consensus_audit"),
        ("noise_policy_ablation", "noise_policy_ablation"),
        ("representation_search", "representation_search"),
        ("duplicate_pairs", "duplicate_pairs"),
        ("duplicate_families", "duplicate_families"),
        ("model_search", "cluster_model_search"),
        ("semantic_model_rerank", "cluster_semantic_rerank"),
        ("baseline_model_search", "reference_model_search"),
        ("refinement_audit", "refinement_audit"),
        ("merge_audit", "merge_audit"),
        ("outlier_recovery_audit", "outlier_recovery_audit"),
        ("structural_audit", "structural_safety_audit"),
        ("semantic_audit", "semantic_regression_audit"),
        ("descriptor_audit", "descriptor_term_scores"),
        ("cluster_catalog", "cluster_catalog"),
        ("before_after", "before_after_metrics"),
    ]
    file_hashes: Dict[str, str] = {}
    for key, suffix in frames:
        frame = sanitize_frame_for_export(result.get(key, pd.DataFrame()).copy())
        if not export_review_text and "representative_examples" in frame.columns:
            frame = frame.drop(columns=["representative_examples"])
        human_cols = [c for c in ("descriptor", "top_terms", "representative_examples") if c in frame.columns]
        scan = residual_pii_counts(frame, human_cols)
        if any(v > 0 for v in scan.values()):
            raise RuntimeError(f"Privacy guard blocked {prefix}_{suffix}.csv; residual counts={scan}")
        path = outdir / f"{prefix}_{suffix}.csv"
        frame.to_csv(path, index=False)
        file_hashes[path.name] = sha256_file(path)

    save_horizontal_cluster_chart(
        result["cluster_catalog"],
        f"NORA Phase 2.7 refined {prefix} clusters",
        outdir / f"{prefix}_phase2_cluster_sizes.png",
    )
    save_noise_chart(result["noise_table"], outdir / f"{prefix}_learned_noise.png")
    save_signal_chart(result["protected_signal_table"], outdir / f"{prefix}_protected_signals.png")
    save_annotated_similarity_heatmap(
        result["development_vectors"], result["development_labels"], result["bundle"].descriptions,
        outdir / f"{prefix}_cluster_similarity_heatmap.png",
        f"{prefix.title()} cluster centroid similarity",
        int(result["bundle"].config.get("similarity_heatmap_top_n", 20)),
    )
    pairs = cluster_similarity_table(
        result["development_vectors"], result["development_labels"], result["bundle"].descriptions
    )
    pairs.to_csv(outdir / f"{prefix}_top_similar_cluster_pairs.csv", index=False)

    ba = result["before_after"]
    if not ba.empty:
        save_bar_chart(
            ba["stage"].tolist(), ba["silhouette"].fillna(0).tolist(),
            f"{prefix.title()} silhouette: reference vs improved partition",
            "Cosine silhouette", outdir / f"{prefix}_before_after_silhouette.png",
        )
        save_bar_chart(
            ba["stage"].tolist(), ba["npmi_coherence"].fillna(0).tolist(),
            f"{prefix.title()} descriptor coherence: reference vs improved partition",
            "NPMI coherence", outdir / f"{prefix}_before_after_interpretability.png",
        )
        save_bar_chart(
            ba["stage"].tolist(), (100.0 * ba["largest_cluster_share"].fillna(0)).tolist(),
            f"{prefix.title()} largest-cluster dominance",
            "Largest cluster share (%)", outdir / f"{prefix}_before_after_largest_cluster.png",
        )

    model_info: Dict[str, Any] = {}
    if persist_models:
        model_path = outdir / f"{prefix}_model.joblib"
        joblib.dump(bundle_to_payload(result["bundle"]), model_path, compress=3)
        model_info = {
            "model_file": model_path.name,
            "model_sha256": sha256_file(model_path),
            "artifact_format": ARTIFACT_FORMAT_VERSION,
        }
    return {
        "residual_pii_patterns": pii_scan,
        "safe_export_rows": len(safe_rows),
        "review_text_exported": bool(export_review_text),
        "audit_file_sha256": file_hashes,
        **model_info,
    }


