def cluster_size_entropy(labels: np.ndarray) -> float:
    valid = labels[labels != -1]
    if len(valid) == 0:
        return 0.0
    counts = np.asarray(list(Counter(valid.tolist()).values()), dtype=float)
    p = counts / counts.sum()
    entropy = -np.sum(p * np.log(p + 1e-12))
    denom = math.log(max(len(counts), 2))
    return float(entropy / denom) if denom > 0 else 0.0


def safe_silhouette(vectors: np.ndarray, labels: np.ndarray, seed: int) -> Optional[float]:
    mask = labels != -1
    if mask.sum() < 3 or len(set(labels[mask].tolist())) < 2:
        return None
    try:
        return float(silhouette_score(
            vectors[mask], labels[mask], metric="cosine",
            sample_size=min(5000, int(mask.sum())), random_state=seed,
        ))
    except Exception:
        return None


def safe_density_validity(space: np.ndarray, labels: np.ndarray, seed: int) -> Optional[float]:
    mask = labels != -1
    if mask.sum() < 10 or len(set(labels[mask].tolist())) < 2:
        return None
    idx = np.flatnonzero(mask)
    if len(idx) > 4000:
        rng = np.random.default_rng(seed)
        idx = np.sort(rng.choice(idx, size=4000, replace=False))
    try:
        from hdbscan.validity import validity_index
        value = float(validity_index(space[idx], labels[idx], metric="euclidean"))
        return value if np.isfinite(value) else None
    except Exception:
        return None


def weighted_cluster_persistence(clusterer: Any, labels: np.ndarray) -> Optional[float]:
    try:
        persistence = np.asarray(clusterer.cluster_persistence_, dtype=float)
    except Exception:
        return None
    if persistence.size == 0:
        return None
    counts = Counter(int(x) for x in labels.tolist() if int(x) != -1)
    weights = np.asarray([counts.get(i, 0) for i in range(len(persistence))], dtype=float)
    return float(np.average(persistence, weights=weights)) if weights.sum() > 0 else float(np.mean(persistence))


def evaluate_cluster_candidate(
    vectors: np.ndarray,
    labels: np.ndarray,
    seed: int,
    density_space: Optional[np.ndarray] = None,
    clusterer: Any = None,
) -> Dict[str, float]:
    sil = safe_silhouette(vectors, labels, seed)
    valid = labels[labels != -1]
    n_clusters = len(set(valid.tolist()))
    largest_share = 1.0
    if len(valid):
        largest_share = max(Counter(valid.tolist()).values()) / len(valid)
    density_validity = safe_density_validity(density_space, labels, seed) if density_space is not None else None
    persistence = weighted_cluster_persistence(clusterer, labels) if clusterer is not None else None
    return {
        "silhouette": float(sil) if sil is not None else float("nan"),
        "density_validity": float(density_validity) if density_validity is not None else float("nan"),
        "weighted_persistence": float(persistence) if persistence is not None else float("nan"),
        "noise_rate": float(np.mean(labels == -1)),
        "balance_entropy": cluster_size_entropy(labels),
        "n_clusters": float(n_clusters),
        "largest_cluster_share": float(largest_share),
        "assigned_fraction": float(np.mean(labels != -1)),
    }


def derive_hdbscan_grid(n: int, trials: int) -> List[Dict[str, Any]]:
    if n < 8:
        return []
    logn = max(3.0, math.log2(n))
    sqrtn = math.sqrt(n)
    mcs = sorted(set(
        max(5, min(n // 3, int(round(x))))
        for x in (0.20 * sqrtn, 0.35 * sqrtn, 0.55 * sqrtn, 0.80 * sqrtn, 1.10 * sqrtn, 1.5 * logn)
    ))
    rows: List[Dict[str, Any]] = []
    for cluster_size in mcs:
        samples = sorted(set(
            max(1, min(cluster_size, int(round(x))))
            for x in (1.0, math.sqrt(max(cluster_size, 2)), math.log2(max(n, 4)), cluster_size / 3.0)
        ))
        for min_samples in samples:
            for method in ("eom", "leaf"):
                rows.append({
                    "min_cluster_size": int(cluster_size),
                    "min_samples": int(min_samples),
                    "cluster_selection_method": method,
                })
    if len(rows) <= trials:
        return rows
    positions = np.linspace(0, len(rows) - 1, trials).round().astype(int)
    return [rows[i] for i in sorted(set(positions.tolist()))]


def derive_umap_grid(n: int, trials: int) -> List[Dict[str, Any]]:
    if n < 8:
        return []
    logn = max(3.0, math.log2(n))
    sqrtn = math.sqrt(n)
    neighbors = sorted(set(min(n - 1, max(5, int(round(x)))) for x in (logn, 1.5 * logn, 2.5 * logn, sqrtn)))
    components = sorted(set(max(2, min(15, int(round(x)))) for x in (5.0, logn, 1.4 * logn)))
    rows: List[Dict[str, Any]] = []
    hgrid = derive_hdbscan_grid(n, max(4, trials))
    for nn in neighbors:
        for nc in components:
            for md in (0.0, min(0.10, 1.0 / math.sqrt(max(nn, 1)))):
                for hp in hgrid:
                    rows.append({
                        "n_neighbors": int(nn),
                        "n_components": int(nc),
                        "min_dist": float(md),
                        **hp,
                    })
    if len(rows) <= trials:
        return rows
    positions = np.linspace(0, len(rows) - 1, trials).round().astype(int)
    return [rows[i] for i in sorted(set(positions.tolist()))]


def fit_hdbscan_direct_once(vectors: np.ndarray, params: Dict[str, Any]) -> Tuple[Any, np.ndarray, np.ndarray, np.ndarray]:
    from hdbscan import HDBSCAN
    clusterer = HDBSCAN(
        min_cluster_size=int(params["min_cluster_size"]),
        min_samples=int(params["min_samples"]),
        metric="euclidean",
        cluster_selection_method=str(params["cluster_selection_method"]),
        prediction_data=True,
        core_dist_n_jobs=-1,
    )
    labels = clusterer.fit_predict(vectors).astype(int)
    strengths = np.asarray(clusterer.probabilities_, dtype=float)
    return clusterer, labels, strengths, np.asarray(vectors, dtype=np.float32)


def fit_umap_hdbscan_once(vectors: np.ndarray, params: Dict[str, Any], seed: int) -> Tuple[Any, Any, np.ndarray, np.ndarray, np.ndarray]:
    from umap import UMAP
    from hdbscan import HDBSCAN
    reducer = UMAP(
        n_neighbors=int(params["n_neighbors"]),
        n_components=int(params["n_components"]),
        min_dist=float(params["min_dist"]),
        metric="cosine",
        random_state=seed,
        transform_seed=seed,
        low_memory=True,
    )
    reduced = reducer.fit_transform(vectors)
    clusterer = HDBSCAN(
        min_cluster_size=int(params["min_cluster_size"]),
        min_samples=int(params["min_samples"]),
        metric="euclidean",
        cluster_selection_method=str(params["cluster_selection_method"]),
        prediction_data=True,
        core_dist_n_jobs=-1,
    )
    labels = clusterer.fit_predict(reduced).astype(int)
    strengths = np.asarray(clusterer.probabilities_, dtype=float)
    return reducer, clusterer, labels, strengths, np.asarray(reduced, dtype=np.float32)


def stability_for_candidate(
    vectors: np.ndarray,
    family: str,
    params: Dict[str, Any],
    seed: int,
    repeats: int,
    subsample_fraction: float,
) -> Dict[str, float]:
    n = len(vectors)
    if n < 8:
        return {"global_ari": 0.0, "assigned_ari": 0.0, "outlier_jaccard": 0.0}
    frac = float(min(max(subsample_fraction, 0.60), 1.0))
    sample_n = max(8, min(n, int(round(frac * n))))
    runs: List[Tuple[np.ndarray, np.ndarray]] = []
    for i in range(max(2, repeats)):
        rng = np.random.default_rng(seed + i * 9973)
        idx = np.arange(n, dtype=int) if sample_n == n else np.sort(rng.choice(n, size=sample_n, replace=False))
        local = dict(params)
        ratio = sample_n / n
        local["min_cluster_size"] = max(5, min(sample_n // 3, int(round(int(params["min_cluster_size"]) * ratio))))
        local["min_samples"] = max(1, min(local["min_cluster_size"], int(round(int(params["min_samples"]) * ratio))))
        try:
            if family == "direct_hdbscan":
                _, labels, _, _ = fit_hdbscan_direct_once(vectors[idx], local)
            else:
                local["n_neighbors"] = min(int(params["n_neighbors"]), sample_n - 1)
                _, _, labels, _, _ = fit_umap_hdbscan_once(vectors[idx], local, seed + i * 997)
            runs.append((idx, labels))
        except Exception:
            return {"global_ari": 0.0, "assigned_ari": 0.0, "outlier_jaccard": 0.0}

    global_ari: List[float] = []
    assigned_ari: List[float] = []
    outlier_jaccard: List[float] = []
    for i in range(len(runs)):
        for j in range(i + 1, len(runs)):
            idx_a, lab_a = runs[i]
            idx_b, lab_b = runs[j]
            common, ia, ib = np.intersect1d(idx_a, idx_b, assume_unique=True, return_indices=True)
            if len(common) < 3:
                continue
            a, b = lab_a[ia], lab_b[ib]
            global_ari.append(float(adjusted_rand_score(a, b)))
            mask = (a != -1) & (b != -1)
            if mask.sum() >= 3 and len(set(a[mask])) >= 2 and len(set(b[mask])) >= 2:
                assigned_ari.append(float(adjusted_rand_score(a[mask], b[mask])))
            ao = set(np.flatnonzero(a == -1).tolist())
            bo = set(np.flatnonzero(b == -1).tolist())
            union = ao | bo
            outlier_jaccard.append(1.0 if not union else len(ao & bo) / len(union))
    return {
        "global_ari": float(np.mean(global_ari)) if global_ari else 0.0,
        "assigned_ari": float(np.mean(assigned_ari)) if assigned_ari else 0.0,
        "outlier_jaccard": float(np.mean(outlier_jaccard)) if outlier_jaccard else 0.0,
    }


def fit_kmeans_fallback(vectors: np.ndarray, seed: int) -> Tuple[ClusterModel, np.ndarray, np.ndarray, pd.DataFrame]:
    n = len(vectors)
    max_k = max(2, min(int(round(math.sqrt(max(n, 4)))), 40))
    rows: List[Dict[str, Any]] = []
    for k in range(2, max_k + 1):
        model = MiniBatchKMeans(
            n_clusters=k, random_state=seed,
            batch_size=min(4096, max(256, n)), n_init="auto",
        )
        labels = model.fit_predict(vectors).astype(int)
        metrics = evaluate_cluster_candidate(vectors, labels, seed)
        if metrics["n_clusters"] >= 2 and np.isfinite(metrics["silhouette"]):
            rows.append({"method": "minibatch_kmeans", "k": k, **metrics})
    if not rows:
        raise RuntimeError("Unable to fit fallback clusterer.")
    table = pd.DataFrame(rows)
    table["selection_score"] = pd.concat([
        percentile_rank(table["silhouette"], True),
        percentile_rank(table["balance_entropy"], True),
        percentile_rank(table["largest_cluster_share"], False),
    ], axis=1).mean(axis=1)
    best = table.loc[table["selection_score"].idxmax()]
    k = int(best["k"])
    model = MiniBatchKMeans(n_clusters=k, random_state=seed, batch_size=min(4096, max(256, n)), n_init="auto")
    labels = model.fit_predict(vectors).astype(int)
    strengths = np.ones(len(labels), dtype=float)
    wrapped = ClusterModel(
        method="minibatch_kmeans", reducer=None, clusterer=model,
        parameters={"k": k}, global_stability_ari=None,
        assigned_stability_ari=None, outlier_jaccard=None,
        silhouette=safe_silhouette(vectors, labels, seed),
        density_validity=None, weighted_persistence=None,
        selection_score=float(best["selection_score"]),
    )
    return wrapped, labels, strengths, table.sort_values("selection_score", ascending=False).reset_index(drop=True)


def fit_cluster_search(vectors: np.ndarray, config: Config, seed: Optional[int] = None) -> Tuple[ClusterModel, np.ndarray, np.ndarray, pd.DataFrame]:
    seed = config.seed if seed is None else int(seed)
    if len(vectors) < 8:
        return fit_kmeans_fallback(vectors, seed)
    try:
        import hdbscan  # noqa: F401
    except ImportError:
        return fit_kmeans_fallback(vectors, seed)

    if len(vectors) > config.search_sample_rows > 0:
        rng = np.random.default_rng(seed)
        idx = np.sort(rng.choice(len(vectors), size=config.search_sample_rows, replace=False))
        search_vectors = vectors[idx]
    else:
        search_vectors = vectors

    rows: List[Dict[str, Any]] = []
    direct_grid = derive_hdbscan_grid(len(search_vectors), max(6, config.model_search_trials // 2))
    for params in direct_grid:
        try:
            clusterer, labels, _, density_space = fit_hdbscan_direct_once(search_vectors, params)
            metrics = evaluate_cluster_candidate(search_vectors, labels, seed, density_space, clusterer)
            if metrics["n_clusters"] >= 2:
                rows.append({"family": "direct_hdbscan", **params, **metrics})
        except Exception:
            pass

    try:
        import umap  # noqa: F401
        umap_grid = derive_umap_grid(len(search_vectors), max(6, config.model_search_trials // 2))
        for params in umap_grid:
            try:
                _, clusterer, labels, _, density_space = fit_umap_hdbscan_once(search_vectors, params, seed)
                metrics = evaluate_cluster_candidate(search_vectors, labels, seed, density_space, clusterer)
                if metrics["n_clusters"] >= 2:
                    rows.append({"family": "umap_hdbscan", **params, **metrics})
            except Exception:
                pass
    except ImportError:
        pass

    if not rows:
        return fit_kmeans_fallback(vectors, seed)

    table = pd.DataFrame(rows)
    noise_rank = table["noise_rate"].rank(pct=True)
    table["noise_plausibility"] = 1.0 - 2.0 * np.abs(noise_rank - 0.5)
    coarse = [
        percentile_rank(table["silhouette"], True),
        percentile_rank(table["density_validity"], True),
        percentile_rank(table["weighted_persistence"], True),
        percentile_rank(table["balance_entropy"], True),
        percentile_rank(table["largest_cluster_share"], False),
        table["noise_plausibility"].fillna(0.5),
    ]
    table["coarse_score"] = pd.concat(coarse, axis=1).median(axis=1)

    top_n = max(3, min(len(table), int(round(math.sqrt(len(table)))) + 2))
    top_idx = table.nlargest(top_n, "coarse_score").index.tolist()
    for key in ("global_ari", "assigned_ari", "outlier_jaccard"):
        table[key] = np.nan
    for idx in top_idx:
        row = table.loc[idx]
        family = str(row["family"])
        keys = ["min_cluster_size", "min_samples", "cluster_selection_method"]
        if family == "umap_hdbscan":
            keys += ["n_neighbors", "n_components", "min_dist"]
        params = {k: row[k] for k in keys}
        stab = stability_for_candidate(
            search_vectors, family, params, seed,
            config.stability_repeats, config.stability_subsample_fraction,
        )
        for key, value in stab.items():
            table.at[idx, key] = value

    final = [
        percentile_rank(table["silhouette"], True),
        percentile_rank(table["density_validity"], True),
        percentile_rank(table["weighted_persistence"], True),
        percentile_rank(table["balance_entropy"], True),
        percentile_rank(table["largest_cluster_share"], False),
        table["noise_plausibility"].fillna(0.5),
        percentile_rank(table["assigned_ari"], True),
        percentile_rank(table["outlier_jaccard"], True),
    ]
    table["selection_score"] = pd.concat(final, axis=1).median(axis=1)
    best = table.loc[table["selection_score"].idxmax()]
    family = str(best["family"])

    params = {
        "min_cluster_size": int(best["min_cluster_size"]),
        "min_samples": int(best["min_samples"]),
        "cluster_selection_method": str(best["cluster_selection_method"]),
    }
    if family == "umap_hdbscan":
        params.update({
            "n_neighbors": int(best["n_neighbors"]),
            "n_components": int(best["n_components"]),
            "min_dist": float(best["min_dist"]),
        })

    if len(search_vectors) < len(vectors):
        ratio = len(vectors) / len(search_vectors)
        params["min_cluster_size"] = max(5, min(len(vectors) // 3, int(round(params["min_cluster_size"] * ratio))))
        params["min_samples"] = max(1, min(params["min_cluster_size"], int(round(params["min_samples"] * ratio))))
        if family == "umap_hdbscan":
            params["n_neighbors"] = min(params["n_neighbors"], len(vectors) - 1)

    if family == "direct_hdbscan":
        clusterer, labels, strengths, density_space = fit_hdbscan_direct_once(vectors, params)
        reducer = None
    else:
        reducer, clusterer, labels, strengths, density_space = fit_umap_hdbscan_once(vectors, params, seed)
    metrics = evaluate_cluster_candidate(vectors, labels, seed, density_space, clusterer)

    stability = stability_for_candidate(
        vectors if len(vectors) <= config.search_sample_rows else search_vectors,
        family,
        params if len(vectors) <= config.search_sample_rows else {
            **params,
            "min_cluster_size": max(5, int(round(params["min_cluster_size"] * len(search_vectors) / len(vectors)))),
            "min_samples": max(1, int(round(params["min_samples"] * len(search_vectors) / len(vectors)))),
            **({"n_neighbors": min(params.get("n_neighbors", 5), len(search_vectors) - 1)} if family == "umap_hdbscan" else {}),
        },
        seed + 3571,
        config.stability_repeats,
        config.stability_subsample_fraction,
    )

    model = ClusterModel(
        method=family,
        reducer=reducer,
        clusterer=clusterer,
        parameters={**params, "search_rows": int(len(search_vectors)), "fit_rows": int(len(vectors))},
        global_stability_ari=float(stability.get("global_ari", np.nan)),
        assigned_stability_ari=float(stability.get("assigned_ari", np.nan)),
        outlier_jaccard=float(stability.get("outlier_jaccard", np.nan)),
        silhouette=float(metrics["silhouette"]) if np.isfinite(metrics["silhouette"]) else None,
        density_validity=float(metrics["density_validity"]) if np.isfinite(metrics["density_validity"]) else None,
        weighted_persistence=float(metrics["weighted_persistence"]) if np.isfinite(metrics["weighted_persistence"]) else None,
        selection_score=float(best["selection_score"]),
    )
    return model, labels, strengths, table.sort_values("selection_score", ascending=False).reset_index(drop=True)



def fit_cluster_search_with_semantic_rerank(
    vectors: np.ndarray,
    source_texts: Sequence[str],
    noise_model: NoiseModel,
    config: Config,
    seed: Optional[int] = None,
) -> Tuple[ClusterModel, np.ndarray, np.ndarray, pd.DataFrame, pd.DataFrame]:
    """Run structural search, then rerank the strongest candidates by descriptor quality.

    The expensive semantic rerank is intentionally limited to a small set of
    structurally competitive candidates and uses development text only.
    """
    seed = config.seed if seed is None else int(seed)
    base_model, base_labels, base_strengths, search = fit_cluster_search(vectors, config, seed)
    if base_model.method == "minibatch_kmeans" or search.empty or "family" not in search.columns:
        return base_model, base_labels, base_strengths, search, pd.DataFrame()

    top = search.sort_values("selection_score", ascending=False).head(min(5, len(search))).copy()
    search_rows = min(len(vectors), config.search_sample_rows) if config.search_sample_rows > 0 else len(vectors)
    rerank_rows: List[Dict[str, Any]] = []
    fitted: Dict[int, Tuple[ClusterModel, np.ndarray, np.ndarray]] = {}

    for pos, (_, row) in enumerate(top.iterrows()):
        family = str(row["family"])
        params = {
            "min_cluster_size": int(row["min_cluster_size"]),
            "min_samples": int(row["min_samples"]),
            "cluster_selection_method": str(row["cluster_selection_method"]),
        }
        if family == "umap_hdbscan":
            params.update({
                "n_neighbors": int(row["n_neighbors"]),
                "n_components": int(row["n_components"]),
                "min_dist": float(row["min_dist"]),
            })
        if search_rows < len(vectors):
            ratio = len(vectors) / max(search_rows, 1)
            params["min_cluster_size"] = max(
                5, min(len(vectors) // 3, int(round(params["min_cluster_size"] * ratio)))
            )
            params["min_samples"] = max(
                1, min(params["min_cluster_size"], int(round(params["min_samples"] * ratio)))
            )
            if family == "umap_hdbscan":
                params["n_neighbors"] = min(params["n_neighbors"], len(vectors) - 1)
        try:
            if family == "direct_hdbscan":
                clusterer, labels, strengths, density_space = fit_hdbscan_direct_once(vectors, params)
                reducer = None
            else:
                reducer, clusterer, labels, strengths, density_space = fit_umap_hdbscan_once(
                    vectors, params, seed + 1777 * (pos + 1)
                )
            if len(set(int(x) for x in labels.tolist() if int(x) != -1)) < 2:
                continue
            metrics = final_partition_metrics(vectors, labels, strengths, seed)
            descriptions, _ = discriminative_descriptions(source_texts, labels, noise_model, config)
            interp, _ = interpretability_metrics(source_texts, descriptions, config.descriptor_top_terms)
            metrics.update(interp)
            stability = stability_for_candidate(
                vectors if len(vectors) <= config.search_sample_rows else vectors[:config.search_sample_rows],
                family,
                params if len(vectors) <= config.search_sample_rows else {
                    **params,
                    "min_cluster_size": max(5, int(round(params["min_cluster_size"] * config.search_sample_rows / len(vectors)))),
                    "min_samples": max(1, int(round(params["min_samples"] * config.search_sample_rows / len(vectors)))),
                    **({"n_neighbors": min(params.get("n_neighbors", 5), config.search_sample_rows - 1)} if family == "umap_hdbscan" else {}),
                },
                seed + 7331 + pos,
                max(2, min(config.stability_repeats, 4)),
                config.stability_subsample_fraction,
            )
            density = safe_density_validity(density_space, labels, seed)
            persistence = weighted_cluster_persistence(clusterer, labels)
            wrapped = ClusterModel(
                method=family,
                reducer=reducer,
                clusterer=clusterer,
                parameters={**params, "search_rows": int(search_rows), "fit_rows": int(len(vectors))},
                global_stability_ari=float(stability.get("global_ari", np.nan)),
                assigned_stability_ari=float(stability.get("assigned_ari", np.nan)),
                outlier_jaccard=float(stability.get("outlier_jaccard", np.nan)),
                silhouette=float(metrics["silhouette"]) if np.isfinite(metrics["silhouette"]) else None,
                density_validity=float(density) if density is not None and np.isfinite(density) else None,
                weighted_persistence=float(persistence) if persistence is not None and np.isfinite(persistence) else None,
                selection_score=None,
            )
            fitted[pos] = (wrapped, labels, strengths)
            rerank_rows.append({
                "candidate_id": pos,
                "family": family,
                **params,
                **metrics,
                "density_validity": density,
                "weighted_persistence": persistence,
                "global_ari": stability.get("global_ari"),
                "assigned_ari": stability.get("assigned_ari"),
                "outlier_jaccard": stability.get("outlier_jaccard"),
            })
        except Exception as exc:
            rerank_rows.append({"candidate_id": pos, "family": family, "status": "failed", "reason": str(exc)})

    rerank = pd.DataFrame(rerank_rows)
    if rerank.empty:
        return base_model, base_labels, base_strengths, search, rerank
    ok = rerank[~rerank.get("status", pd.Series(index=rerank.index, dtype=object)).eq("failed")].copy()
    if ok.empty:
        return base_model, base_labels, base_strengths, search, rerank

    score_parts = []
    for metric, high in (
        ("npmi_coherence", True),
        ("descriptor_diversity_composite", True),
        ("mean_cluster_cohesion", True),
        ("silhouette", True),
        ("balance_entropy", True),
        ("centroid_separation", True),
        ("assigned_ari", True),
        ("outlier_jaccard", True),
        ("weighted_persistence", True),
        ("largest_cluster_share", False),
    ):
        if metric in ok.columns:
            score_parts.append(percentile_rank(ok[metric], high))
    ok["semantic_structural_score"] = pd.concat(score_parts, axis=1).mean(axis=1) if score_parts else 0.5
    best = ok.sort_values("semantic_structural_score", ascending=False).iloc[0]
    cid = int(best["candidate_id"])
    model, labels, strengths = fitted[cid]
    model.selection_score = float(best["semantic_structural_score"])
    rerank = rerank.merge(
        ok[["candidate_id", "semantic_structural_score"]], on="candidate_id", how="left"
    )
    rerank["selected"] = rerank["candidate_id"].eq(cid)
    return model, labels, strengths, search, rerank


def predict_cluster(model: ClusterModel, vectors: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
    if len(vectors) == 0:
        return np.asarray([], dtype=int), np.asarray([], dtype=float)
    if model.method in {"direct_hdbscan", "umap_hdbscan"}:
        try:
            from hdbscan.prediction import approximate_predict
            space = vectors if model.method == "direct_hdbscan" else model.reducer.transform(vectors)
            labels, strengths = approximate_predict(model.clusterer, space)
            return labels.astype(int), strengths.astype(float)
        except Exception:
            return np.full(len(vectors), -1, dtype=int), np.zeros(len(vectors), dtype=float)
    if model.method == "minibatch_kmeans":
        labels = model.clusterer.predict(vectors).astype(int)
        return labels, np.ones(len(labels), dtype=float)
    return np.full(len(vectors), -1, dtype=int), np.zeros(len(vectors), dtype=float)

# ---------------------------------------------------------------------------
# Corpus-derived noise learning with discriminative signal protection
# ---------------------------------------------------------------------------

def term_cluster_entropy(matrix: sparse.csr_matrix, labels: np.ndarray) -> np.ndarray:
    valid_clusters = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if len(valid_clusters) < 2:
        return np.ones(matrix.shape[1], dtype=float)
    counts = np.zeros((len(valid_clusters), matrix.shape[1]), dtype=np.float64)
    for row_idx, cluster_id in enumerate(valid_clusters):
        mask = labels == cluster_id
        if mask.any():
            counts[row_idx] = np.asarray((matrix[mask] > 0).sum(axis=0)).ravel()
    total = counts.sum(axis=0)
    total[total == 0] = 1.0
    p = counts / total[None, :]
    entropy = -np.sum(np.where(p > 0, p * np.log(p + 1e-12), 0.0), axis=0)
    return entropy / max(math.log(len(valid_clusters)), 1e-12)


def regularized_log_odds_max_z(matrix: sparse.csr_matrix, labels: np.ndarray) -> np.ndarray:
    """One-vs-rest discriminative strength from binary document presence.

    A corpus-derived beta prior shrinks very rare terms, preventing singletons
    from appearing highly discriminative only because of tiny counts.
    """
    valid = labels != -1
    x = (matrix[valid] > 0).astype(np.float64).tocsr()
    y = labels[valid]
    if x.shape[0] < 4 or len(set(y.tolist())) < 2:
        return np.zeros(matrix.shape[1], dtype=float)

    global_df = np.asarray(x.sum(axis=0)).ravel().astype(float)
    total_docs = float(x.shape[0])
    prior_strength = max(2.0, math.sqrt(total_docs))
    global_rate = np.clip(global_df / max(total_docs, 1.0), 1e-6, 1.0 - 1e-6)
    alpha = prior_strength * global_rate
    beta = prior_strength * (1.0 - global_rate)

    max_z = np.zeros(x.shape[1], dtype=float)
    for cid in sorted(set(int(v) for v in y.tolist())):
        in_mask = y == cid
        n_in = float(in_mask.sum())
        n_out = float(len(y) - in_mask.sum())
        if n_in <= 0 or n_out <= 0:
            continue
        a = np.asarray(x[in_mask].sum(axis=0)).ravel().astype(float)
        b = global_df - a
        p_in_num = a + alpha
        p_in_den = (n_in - a) + beta
        p_out_num = b + alpha
        p_out_den = (n_out - b) + beta
        delta = np.log(p_in_num / np.maximum(p_in_den, 1e-12)) - np.log(p_out_num / np.maximum(p_out_den, 1e-12))
        var = (
            1.0 / np.maximum(p_in_num, 1e-12)
            + 1.0 / np.maximum(p_in_den, 1e-12)
            + 1.0 / np.maximum(p_out_num, 1e-12)
            + 1.0 / np.maximum(p_out_den, 1e-12)
        )
        z = np.abs(delta / np.sqrt(np.maximum(var, 1e-12)))
        max_z = np.maximum(max_z, z)
    return max_z


def build_noise_label_ensemble(
    vectors: np.ndarray,
    baseline_model: ClusterModel,
    baseline_labels: np.ndarray,
    config: Config,
) -> Tuple[List[np.ndarray], pd.DataFrame]:
    labelings: List[np.ndarray] = [np.asarray(baseline_labels, dtype=int)]
    audit: List[Dict[str, Any]] = [{
        "consensus_run": 0,
        "method": "baseline_partition",
        "rows_fit": int(len(vectors)),
        "n_clusters": int(len(set(int(x) for x in baseline_labels.tolist() if int(x) != -1))),
        "noise_rate": float(np.mean(np.asarray(baseline_labels) == -1)),
        "accepted": True,
    }]
    target = max(1, int(config.noise_consensus_models))
    if target <= 1 or len(vectors) < 8:
        return labelings, pd.DataFrame(audit)

    sample_cap = config.search_sample_rows if config.search_sample_rows > 0 else len(vectors)
    sample_n = min(len(vectors), max(8, int(sample_cap)))
    for run in range(1, target):
        rng = np.random.default_rng(config.seed + 16127 * run)
        idx = np.arange(len(vectors), dtype=int) if sample_n == len(vectors) else np.sort(
            rng.choice(len(vectors), size=sample_n, replace=False)
        )
        try:
            local_cfg = Config(**{
                **asdict(config),
                "model_search_trials": max(6, min(config.model_search_trials, 10)),
                "stability_repeats": max(2, min(config.stability_repeats, 3)),
                "search_sample_rows": sample_n,
            })
            model, _, _, _ = fit_cluster_search(vectors[idx], local_cfg, seed=config.seed + run * 3571)
            labels, _ = predict_cluster(model, vectors)
            n_clusters = len(set(int(x) for x in labels.tolist() if int(x) != -1))
            accepted = n_clusters >= 2
            audit.append({
                "consensus_run": run,
                "method": model.method,
                "rows_fit": int(sample_n),
                "n_clusters": int(n_clusters),
                "noise_rate": float(np.mean(labels == -1)),
                "accepted": bool(accepted),
            })
            if accepted:
                labelings.append(np.asarray(labels, dtype=int))
        except Exception as exc:
            audit.append({
                "consensus_run": run,
                "method": "failed",
                "rows_fit": int(sample_n),
                "n_clusters": 0,
                "noise_rate": np.nan,
                "accepted": False,
                "reason": str(exc),
            })
    return labelings, pd.DataFrame(audit)


def _boundary_phrase_document_frequency(texts: Sequence[str], max_ngram: int, boundary_tokens: int) -> Counter[str]:
    counts: Counter[str] = Counter()
    for text in texts:
        tokens = tokenize(text)
        seen: set[str] = set()
        for n in range(2, max(2, max_ngram) + 1):
            if len(tokens) < n:
                continue
            for i in range(0, len(tokens) - n + 1):
                if i < boundary_tokens or (i + n) > max(0, len(tokens) - boundary_tokens):
                    seen.add(" ".join(tokens[i:i+n]))
        counts.update(seen)
    return counts


def phrase_association_npmi(phrase: str, phrase_df: float, unigram_df: Dict[str, float], n_docs: int) -> float:
    tokens = phrase.split()
    if len(tokens) < 2 or phrase_df <= 0 or n_docs <= 0:
        return float("nan")
    p_phrase = np.clip(float(phrase_df) / n_docs, 1e-12, 1.0 - 1e-12)
    token_probs = [np.clip(float(unigram_df.get(t, 0.0)) / n_docs, 1e-12, 1.0) for t in tokens]
    expected = float(np.prod(token_probs))
    if expected <= 0:
        return float("nan")
    pmi = math.log(p_phrase / expected)
    denom = -math.log(p_phrase)
    return float(np.clip(pmi / denom, -1.0, 1.0)) if denom > 1e-12 else 0.0


def learn_noise_model(
    texts: Sequence[str],
    provisional_labelings: Sequence[np.ndarray] | np.ndarray,
    config: Config,
) -> Tuple[NoiseModel, pd.DataFrame]:
    values = [sanitize_model_text(x) for x in texts]
    min_df = adaptive_min_df(len(values))
    vectorizer = CountVectorizer(
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(1, config.noise_max_ngram),
        min_df=min_df,
        max_df=1.0,
        max_features=config.candidate_noise_features,
        binary=True,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b",
        stop_words=None,
    )
    matrix = vectorizer.fit_transform(values).tocsr()
    terms = np.asarray(vectorizer.get_feature_names_out())
    df = np.asarray(matrix.sum(axis=0)).ravel().astype(float)
    df_ratio = df / max(len(values), 1)
    orders = np.asarray([str(t).count(" ") + 1 for t in terms], dtype=int)

    if isinstance(provisional_labelings, np.ndarray):
        labelings = [provisional_labelings]
    else:
        labelings = [np.asarray(x, dtype=int) for x in provisional_labelings]
    valid_labelings = [
        x for x in labelings
        if len(x) == len(values) and len(set(int(v) for v in x.tolist() if int(v) != -1)) >= 2
    ]
    if not valid_labelings:
        valid_labelings = [np.asarray(labelings[0], dtype=int)]

    entropy_stack = np.vstack([term_cluster_entropy(matrix, labels) for labels in valid_labelings])
    entropy = np.median(entropy_stack, axis=0)
    specificity = 1.0 - np.clip(entropy, 0.0, 1.0)

    z_stack = np.vstack([regularized_log_odds_max_z(matrix, labels) for labels in valid_labelings])
    discriminative_z = np.median(z_stack, axis=0)
    z_rank = pd.Series(discriminative_z).rank(pct=True).to_numpy(dtype=float)
    freq_rank = pd.Series(df_ratio).rank(pct=True).to_numpy(dtype=float)
    signal_suppression_ceiling = float(np.median(z_rank[np.isfinite(z_rank)])) if np.isfinite(z_rank).any() else 0.5
    signal_protection_floor = float(np.quantile(z_rank[np.isfinite(z_rank)], 0.75)) if np.isfinite(z_rank).any() else 0.75

    # Background noise should be frequent, diffuse across clusterings, and not
    # strongly discriminative. This explicitly separates "common" from "noise".
    noise_score = np.power(
        np.clip(freq_rank, 1e-9, 1.0)
        * np.clip(entropy, 1e-9, 1.0)
        * np.clip(1.0 - z_rank, 1e-9, 1.0),
        1.0 / 3.0,
    )
    threshold, threshold_method = distribution_upper_tail_cutoff(noise_score, config.seed)
    robust_noise_floor = float(np.quantile(noise_score[np.isfinite(noise_score)], 0.75)) if np.isfinite(noise_score).any() else float("inf")
    if np.isfinite(threshold):
        threshold = max(float(threshold), robust_noise_floor)
    else:
        threshold = robust_noise_floor
    selected_full = (
        (noise_score >= threshold)
        & (z_rank <= signal_suppression_ceiling)
    ) if np.isfinite(threshold) else np.zeros(len(terms), dtype=bool)

    # Bootstrap consensus for background terms.
    selection_count = np.zeros(len(terms), dtype=float)
    valid_evaluations = 0
    repeats = max(0, int(config.noise_stability_repeats))
    frac = float(min(max(config.noise_subsample_fraction, 0.60), 1.0))
    sample_n = max(20, min(len(values), int(round(frac * len(values)))))
    if repeats and len(values) >= 30:
        for li, labels in enumerate(valid_labelings):
            for r in range(repeats):
                rng = np.random.default_rng(config.seed + 1009 * (r + 1) + 65537 * li)
                idx = np.arange(len(values), dtype=int) if sample_n == len(values) else np.sort(
                    rng.choice(len(values), size=sample_n, replace=False)
                )
                sub = matrix[idx]
                sub_labels = labels[idx]
                if len(set(int(v) for v in sub_labels.tolist() if int(v) != -1)) < 2:
                    continue
                sub_df = np.asarray(sub.sum(axis=0)).ravel().astype(float)
                sub_ratio = sub_df / max(len(idx), 1)
                sub_freq_rank = pd.Series(sub_ratio).rank(pct=True).to_numpy(float)
                sub_entropy = term_cluster_entropy(sub, sub_labels)
                sub_z = regularized_log_odds_max_z(sub, sub_labels)
                sub_z_rank = pd.Series(sub_z).rank(pct=True).to_numpy(float)
                sub_score = np.power(
                    np.clip(sub_freq_rank, 1e-9, 1.0)
                    * np.clip(sub_entropy, 1e-9, 1.0)
                    * np.clip(1.0 - sub_z_rank, 1e-9, 1.0),
                    1.0 / 3.0,
                )
                sub_threshold, _ = distribution_upper_tail_cutoff(sub_score, config.seed + r + li * 997)
                if np.isfinite(sub_threshold):
                    selection_count += (sub_score >= sub_threshold).astype(float)
                    valid_evaluations += 1

    if valid_evaluations:
        stability_rate = selection_count / valid_evaluations
        majority_rate = math.ceil(valid_evaluations / 2) / valid_evaluations
        selected = selected_full & (stability_rate >= majority_rate)
        selection_method = f"{threshold_method}+bootstrap_consensus"
    else:
        stability_rate = selected_full.astype(float)
        majority_rate = 1.0
        selected = selected_full
        selection_method = threshold_method

    boundary_df = _boundary_phrase_document_frequency(
        values, config.noise_max_ngram, max(1, config.template_boundary_tokens)
    )
    boundary_ratio = np.asarray([
        min(1.0, boundary_df.get(str(term), 0) / max(float(freq), 1.0)) if order > 1 else 0.0
        for term, freq, order in zip(terms.tolist(), df.tolist(), orders.tolist())
    ], dtype=float)

    phrase_mask = orders > 1
    template_score = np.power(
        np.clip(freq_rank, 1e-9, 1.0)
        * np.clip(entropy, 1e-9, 1.0)
        * np.clip(boundary_ratio, 1e-9, 1.0)
        * np.clip(1.0 - z_rank, 1e-9, 1.0),
        0.25,
    )
    template_threshold, template_method = (
        distribution_upper_tail_cutoff(template_score[phrase_mask], config.seed + 211)
        if phrase_mask.any() else (float("inf"), "empty")
    )
    if phrase_mask.any():
        phrase_template_floor = float(np.quantile(template_score[phrase_mask], 0.75))
        template_threshold = max(float(template_threshold), phrase_template_floor) if np.isfinite(template_threshold) else phrase_template_floor
    template_selected = (
        phrase_mask
        & np.isfinite(template_threshold)
        & (template_score >= template_threshold)
        & (z_rank <= signal_suppression_ceiling)
    )

    unigram_df = {
        str(term): float(freq)
        for term, freq, order in zip(terms.tolist(), df.tolist(), orders.tolist())
        if order == 1
    }
    association = np.full(len(terms), np.nan, dtype=float)
    phrase_content_tokens = np.zeros(len(terms), dtype=int)
    candidate_noise_unigrams = set(terms[selected_full & (orders == 1)].astype(str).tolist())
    for i, (term, order) in enumerate(zip(terms.tolist(), orders.tolist())):
        if order > 1:
            toks = [
                t for t in str(term).split()
                if t not in STRUCTURAL_PLACEHOLDER_TOKENS
                and (t not in candidate_noise_unigrams or t in NEGATION_KEEP)
            ]
            phrase_content_tokens[i] = len(toks)
            association[i] = phrase_association_npmi(str(term), df[i], unigram_df, len(values))

    assoc_unit = np.where(np.isfinite(association), (association + 1.0) / 2.0, 0.0)
    phrase_support_rank = np.zeros(len(terms), dtype=float)
    if phrase_mask.any():
        phrase_support_rank[phrase_mask] = pd.Series(df_ratio[phrase_mask]).rank(pct=True).to_numpy(float)
    phrase_quality = np.zeros(len(terms), dtype=float)
    valid_phrase = (
        phrase_mask
        & (phrase_content_tokens >= max(1, int(config.phrase_min_content_tokens)))
        & np.asarray([not any(t in STRUCTURAL_PLACEHOLDER_TOKENS for t in str(term).split()) for term in terms])
    )
    phrase_quality[valid_phrase] = np.power(
        np.clip(phrase_support_rank[valid_phrase], 1e-9, 1.0)
        * np.clip(specificity[valid_phrase], 1e-9, 1.0)
        * np.clip(z_rank[valid_phrase], 1e-9, 1.0)
        * np.clip(assoc_unit[valid_phrase], 1e-9, 1.0),
        0.25,
    )
    phrase_quality_threshold, phrase_quality_method = (
        distribution_upper_tail_cutoff(phrase_quality[valid_phrase], config.seed + 431)
        if valid_phrase.any() else (float("inf"), "empty")
    )
    if valid_phrase.any():
        phrase_signal_floor = float(np.quantile(phrase_quality[valid_phrase], 0.75))
        phrase_quality_threshold = min(float(phrase_quality_threshold), phrase_signal_floor) if np.isfinite(phrase_quality_threshold) else phrase_signal_floor
    strong_phrase_signal = (
        phrase_mask
        & (z_rank >= signal_protection_floor)
        & (df >= min_df)
        & np.asarray([not any(t in STRUCTURAL_PLACEHOLDER_TOKENS for t in str(term).split()) for term in terms])
    )
    protected_phrase = (
        (
            valid_phrase
            & np.isfinite(phrase_quality_threshold)
            & (phrase_quality >= phrase_quality_threshold)
        )
        | strong_phrase_signal
    ) & (~template_selected)

    unigram_mask = orders == 1
    unigram_signal_threshold, unigram_signal_method = (
        distribution_upper_tail_cutoff(discriminative_z[unigram_mask], config.seed + 557)
        if unigram_mask.any() else (float("inf"), "empty")
    )
    if unigram_mask.any():
        unigram_signal_floor = float(np.quantile(discriminative_z[unigram_mask], 0.75))
        unigram_signal_threshold = min(float(unigram_signal_threshold), unigram_signal_floor) if np.isfinite(unigram_signal_threshold) else unigram_signal_floor
    function_word_mask = np.asarray([str(term) in GENERIC_FUNCTION_TOKENS for term in terms], dtype=bool)
    protected_unigram = (
        unigram_mask
        & (~function_word_mask)
        & (z_rank >= signal_protection_floor)
        & (discriminative_z > 0.0)
    )
    for i, term in enumerate(terms.tolist()):
        if str(term) in NEGATION_KEEP:
            protected_unigram[i] = True

    # A protected signal can never be removed solely because it is frequent.
    selected = selected & (~protected_unigram) & (~protected_phrase)
    template_selected = template_selected & (~protected_phrase)

    selected_unigrams = set(terms[selected & unigram_mask].astype(str).tolist())
    selected_phrases = set(terms[(selected | template_selected) & phrase_mask].astype(str).tolist())
    protected_phrases = set(terms[protected_phrase].astype(str).tolist())
    protected_unigrams = set(terms[protected_unigram].astype(str).tolist())
    descriptor_blocklist = set(terms[selected | template_selected].astype(str).tolist()) | set(STRUCTURAL_PLACEHOLDER_TOKENS)
    descriptor_blocklist -= protected_phrases
    descriptor_blocklist -= protected_unigrams

    scope = []
    for i, term in enumerate(terms.tolist()):
        if protected_phrase[i] or protected_unigram[i]:
            scope.append("protected_signal")
        elif template_selected[i]:
            scope.append("template_suppression")
        elif selected[i]:
            scope.append("background_suppression")
        else:
            scope.append("retained")

    table = pd.DataFrame({
        "term": terms,
        "ngram_order": orders,
        "development_document_frequency": df.astype(int),
        "document_frequency_ratio": df_ratio,
        "median_cluster_entropy": entropy,
        "cluster_specificity": specificity,
        "max_regularized_log_odds_z": discriminative_z,
        "signal_percentile": z_rank,
        "signal_suppression_ceiling": signal_suppression_ceiling,
        "signal_protection_floor": signal_protection_floor,
        "noise_score": noise_score,
        "noise_threshold": threshold,
        "noise_threshold_method": threshold_method,
        "noise_upper_quartile_floor": robust_noise_floor,
        "consensus_evaluations": valid_evaluations,
        "consensus_selection_rate": stability_rate,
        "consensus_majority_rate": majority_rate,
        "boundary_position_ratio": boundary_ratio,
        "template_score": template_score,
        "template_threshold": template_threshold,
        "template_threshold_method": template_method,
        "phrase_association_npmi": association,
        "phrase_quality_score": phrase_quality,
        "phrase_quality_threshold": phrase_quality_threshold,
        "phrase_quality_threshold_method": phrase_quality_method,
        "unigram_signal_threshold": unigram_signal_threshold,
        "unigram_signal_threshold_method": unigram_signal_method,
        "protected_signal": protected_phrase | protected_unigram,
        "selected_as_noise": selected | template_selected,
        "suppression_scope": scope,
    }).sort_values(
        ["protected_signal", "selected_as_noise", "phrase_quality_score", "max_regularized_log_odds_z", "noise_score"],
        ascending=[False, False, False, False, False],
    ).reset_index(drop=True)

    model = NoiseModel(
        unigrams=selected_unigrams,
        template_phrases=selected_phrases,
        descriptor_blocklist=descriptor_blocklist,
        protected_phrases=protected_phrases,
        protected_unigrams=protected_unigrams,
        structural_terms=set(STRUCTURAL_PLACEHOLDER_TOKENS),
        score_threshold=float(threshold),
        selection_method=(
            selection_method
            + f"+template:{template_method}"
            + f"+phrase_signal:{phrase_quality_method}"
            + f"+unigram_signal:{unigram_signal_method}"
        ),
    )
    return model, table


def apply_noise_model(text: str, model: NoiseModel) -> str:
    tokens = tokenize(sanitize_model_text(text))
    if not tokens:
        return ""

    protected = np.zeros(len(tokens), dtype=bool)
    for i, token in enumerate(tokens):
        if token in model.protected_unigrams or token in NEGATION_KEEP:
            protected[i] = True

    max_protect = max([len(x.split()) for x in model.protected_phrases], default=1)
    for n in range(max_protect, 1, -1):
        for i in range(0, max(0, len(tokens) - n + 1)):
            if " ".join(tokens[i:i+n]) in model.protected_phrases:
                for pos in range(i, i + n):
                    token = tokens[pos]
                    if token not in model.unigrams or token in model.protected_unigrams or token in NEGATION_KEEP:
                        protected[pos] = True

    drop = np.zeros(len(tokens), dtype=bool)
    max_ngram = max([len(x.split()) for x in model.template_phrases], default=1)
    for n in range(max_ngram, 1, -1):
        for i in range(0, max(0, len(tokens) - n + 1)):
            if protected[i:i+n].any() or drop[i:i+n].any():
                continue
            if " ".join(tokens[i:i+n]) in model.template_phrases:
                drop[i:i+n] = True

    for i, token in enumerate(tokens):
        if protected[i] or drop[i]:
            continue
        if token in model.structural_terms or token in model.unigrams:
            drop[i] = True

    kept = [tok for tok, flag in zip(tokens, drop.tolist()) if not flag]
    return " ".join(kept) if len(kept) >= 2 else " ".join(tokens)

