def descriptor_strength_metrics(descriptions: Dict[int, Dict[str, Any]]) -> Dict[str, float]:
    items = [
        item
        for payload in descriptions.values()
        for item in payload.get("keywords", [])
    ]
    if not items:
        return {
            "mean_specificity_score": float("nan"),
            "mean_log_odds_score": float("nan"),
            "mean_support_score": float("nan"),
            "descriptor_strength_composite": float("nan"),
        }
    specificity = []
    log_odds = []
    support = []
    for item in items:
        spec = max(float(item.get("specificity_ratio", 0.0)), 0.0)
        z = max(float(item.get("log_odds_z", 0.0)), 0.0)
        rate = float(np.clip(item.get("cluster_document_rate", 0.0), 0.0, 1.0))
        specificity.append(1.0 - math.exp(-max(spec - 1.0, 0.0) / 2.0))
        log_odds.append(1.0 - math.exp(-z / 3.0))
        support.append(math.sqrt(rate))
    a = float(np.mean(specificity)) if specificity else float("nan")
    b = float(np.mean(log_odds)) if log_odds else float("nan")
    c = float(np.mean(support)) if support else float("nan")
    vals = [x for x in (a, b, c) if np.isfinite(x)]
    return {
        "mean_specificity_score": a,
        "mean_log_odds_score": b,
        "mean_support_score": c,
        "descriptor_strength_composite": float(np.mean(vals)) if vals else float("nan"),
    }


def semantic_quality_composite(
    npmi_value: float,
    diversity: Dict[str, float],
    strength: Dict[str, float],
) -> float:
    components = []
    if np.isfinite(npmi_value):
        components.append(float(np.clip((npmi_value + 1.0) / 2.0, 0.0, 1.0)))
    div = float(diversity.get("descriptor_diversity_composite", np.nan))
    if np.isfinite(div):
        components.append(float(np.clip(div, 0.0, 1.0)))
    st = float(strength.get("descriptor_strength_composite", np.nan))
    if np.isfinite(st):
        components.append(float(np.clip(st, 0.0, 1.0)))
    return float(np.mean(components)) if components else float("nan")


def semantic_regression_guard(
    reference_texts: Sequence[str],
    baseline_descriptions: Dict[int, Dict[str, Any]],
    candidate_descriptions: Dict[int, Dict[str, Any]],
    config: Config,
) -> Tuple[bool, pd.DataFrame, Dict[str, Any]]:
    baseline_terms = descriptor_term_map(baseline_descriptions, config.descriptor_top_terms)
    candidate_terms = descriptor_term_map(candidate_descriptions, config.descriptor_top_terms)
    matrix, vocabulary = reference_term_matrix(reference_texts, [baseline_terms, candidate_terms])
    b_npmi, _ = npmi_from_matrix(matrix, vocabulary, baseline_terms)
    c_npmi, _ = npmi_from_matrix(matrix, vocabulary, candidate_terms)
    b_div = descriptor_diversity_metrics(baseline_terms)
    c_div = descriptor_diversity_metrics(candidate_terms)
    b_strength = descriptor_strength_metrics(baseline_descriptions)
    c_strength = descriptor_strength_metrics(candidate_descriptions)
    b_composite = semantic_quality_composite(b_npmi, b_div, b_strength)
    c_composite = semantic_quality_composite(c_npmi, c_div, c_strength)

    repeats = max(0, int(config.semantic_bootstrap_repeats))
    frac = float(min(max(config.semantic_bootstrap_fraction, 0.50), 1.0))
    sample_n = max(10, min(matrix.shape[0], int(round(frac * matrix.shape[0])))) if matrix.shape[0] else 0
    deltas: List[float] = []
    if repeats and sample_n and np.isfinite(b_npmi) and np.isfinite(c_npmi):
        rng = np.random.default_rng(config.seed + 9901)
        for _ in range(repeats):
            idx = rng.choice(matrix.shape[0], size=sample_n, replace=True)
            b, _ = npmi_from_matrix(matrix, vocabulary, baseline_terms, idx)
            c, _ = npmi_from_matrix(matrix, vocabulary, candidate_terms, idx)
            if np.isfinite(b) and np.isfinite(c):
                deltas.append(float(c - b))
    alpha = float(min(max(config.semantic_guard_alpha, 0.001), 0.25))
    if deltas:
        lower = float(np.quantile(deltas, alpha / 2.0))
        upper = float(np.quantile(deltas, 1.0 - alpha / 2.0))
        median = float(np.median(deltas))
    else:
        lower = upper = median = float("nan")

    regression = bool(np.isfinite(upper) and upper < 0.0)
    composite_regression = bool(
        np.isfinite(b_composite) and np.isfinite(c_composite) and c_composite < b_composite
    )
    strength_regression = bool(
        np.isfinite(b_strength["descriptor_strength_composite"])
        and np.isfinite(c_strength["descriptor_strength_composite"])
        and c_strength["descriptor_strength_composite"] < b_strength["descriptor_strength_composite"]
    )
    granularity_comparable = len(baseline_descriptions) == len(candidate_descriptions)
    supported_semantic_regression = (
        regression and composite_regression and strength_regression and granularity_comparable
    )
    mode = str(config.semantic_guard_mode).lower()
    allowed = not (supported_semantic_regression and mode == "block")
    if supported_semantic_regression and mode == "block":
        status = "BLOCK"
    elif regression and not granularity_comparable:
        status = "PASS_GRANULARITY_CHANGED_NO_AUTOMATIC_VETO"
    elif regression and not supported_semantic_regression:
        status = "PASS_COMPENSATED_BY_DISCRIMINATION_AND_DIVERSITY"
    elif regression:
        status = "WARN"
    elif np.isfinite(lower) and lower > 0:
        status = "PASS_IMPROVED"
    else:
        status = "PASS_NO_SIGNIFICANT_REGRESSION"

    audit = pd.DataFrame([
        {
            "check": "npmi_fixed_reference",
            "baseline": b_npmi,
            "candidate": c_npmi,
            "delta": c_npmi - b_npmi if np.isfinite(c_npmi) and np.isfinite(b_npmi) else np.nan,
            "bootstrap_delta_median": median,
            "bootstrap_delta_ci_lower": lower,
            "bootstrap_delta_ci_upper": upper,
            "passed": bool(allowed),
        },
        {
            "check": "descriptor_diversity_composite",
            "baseline": b_div["descriptor_diversity_composite"],
            "candidate": c_div["descriptor_diversity_composite"],
            "delta": c_div["descriptor_diversity_composite"] - b_div["descriptor_diversity_composite"],
            "bootstrap_delta_median": np.nan,
            "bootstrap_delta_ci_lower": np.nan,
            "bootstrap_delta_ci_upper": np.nan,
            "passed": True,
        },
        {
            "check": "descriptor_strength_composite",
            "baseline": b_strength["descriptor_strength_composite"],
            "candidate": c_strength["descriptor_strength_composite"],
            "delta": c_strength["descriptor_strength_composite"] - b_strength["descriptor_strength_composite"],
            "bootstrap_delta_median": np.nan,
            "bootstrap_delta_ci_lower": np.nan,
            "bootstrap_delta_ci_upper": np.nan,
            "passed": not strength_regression,
        },
        {
            "check": "semantic_quality_composite",
            "baseline": b_composite,
            "candidate": c_composite,
            "delta": c_composite - b_composite if np.isfinite(c_composite) and np.isfinite(b_composite) else np.nan,
            "bootstrap_delta_median": np.nan,
            "bootstrap_delta_ci_lower": np.nan,
            "bootstrap_delta_ci_upper": np.nan,
            "passed": not composite_regression,
        },
    ])
    summary = {
        "status": status,
        "deployment_allowed": bool(allowed),
        "baseline_npmi_coherence": b_npmi,
        "candidate_npmi_coherence": c_npmi,
        "bootstrap_delta_median": median,
        "bootstrap_delta_ci_lower": lower,
        "bootstrap_delta_ci_upper": upper,
        "bootstrap_repeats_valid": len(deltas),
        "alpha": alpha,
        "npmi_statistically_supported_regression": regression,
        "supported_semantic_regression": supported_semantic_regression,
        "granularity_comparable": granularity_comparable,
        "baseline_cluster_count": len(baseline_descriptions),
        "candidate_cluster_count": len(candidate_descriptions),
        "baseline_descriptor_diversity": b_div,
        "candidate_descriptor_diversity": c_div,
        "baseline_descriptor_strength": b_strength,
        "candidate_descriptor_strength": c_strength,
        "baseline_semantic_quality_composite": b_composite,
        "candidate_semantic_quality_composite": c_composite,
    }
    return allowed, audit, summary


def local_cluster_cohesion(vectors: np.ndarray, labels: np.ndarray) -> Dict[int, float]:
    out: Dict[int, float] = {}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cid)
        if len(idx) < 3:
            out[cid] = 1.0
            continue
        centroid = vectors[idx].mean(axis=0)
        norm = np.linalg.norm(centroid)
        if norm > 0:
            centroid /= norm
        out[cid] = float(np.mean(vectors[idx] @ centroid))
    return out


def final_partition_metrics(
    vectors: np.ndarray,
    labels: np.ndarray,
    strengths: np.ndarray,
    seed: int,
    assignment_source: Optional[np.ndarray] = None,
) -> Dict[str, float]:
    labels = np.asarray(labels, dtype=int)
    strengths = np.asarray(strengths, dtype=float)
    sources = (
        np.asarray(assignment_source, dtype=object)
        if assignment_source is not None
        else np.asarray(["native" if int(x) != -1 else "outlier" for x in labels], dtype=object)
    )
    metrics = evaluate_cluster_candidate(vectors, labels, seed)
    cohesion = local_cluster_cohesion(vectors, labels)
    sizes = {cid: int((labels == cid).sum()) for cid in cohesion}
    if sizes:
        metrics["mean_cluster_cohesion"] = float(
            sum(cohesion[cid] * sizes[cid] for cid in sizes) / max(sum(sizes.values()), 1)
        )
        metrics["median_cluster_cohesion"] = float(np.median(list(cohesion.values())))
    else:
        metrics["mean_cluster_cohesion"] = float("nan")
        metrics["median_cluster_cohesion"] = float("nan")
    ids = sorted(sizes)
    separation = float("nan")
    if len(ids) >= 2:
        centroids = []
        for cid in ids:
            c = vectors[labels == cid].mean(axis=0)
            norm = np.linalg.norm(c)
            centroids.append(c / norm if norm > 0 else c)
        matrix = np.vstack(centroids)
        sims = matrix @ matrix.T
        np.fill_diagonal(sims, -np.inf)
        separation = float(np.mean(1.0 - np.max(sims, axis=1)))
    metrics["centroid_separation"] = separation
    recovered = sources == "recovered_outlier"
    native = (labels != -1) & (~recovered)
    metrics["recovered_outlier_fraction"] = float(np.mean(recovered)) if len(labels) else 0.0
    metrics["mean_native_assigned_strength"] = float(np.mean(strengths[native])) if native.any() else float("nan")
    return metrics


def select_noise_policy(
    texts: Sequence[str], noise_model: NoiseModel, config: Config
) -> Tuple[str, pd.DataFrame]:
    requested = str(config.noise_policy).lower()
    allowed = ("shared_clean", "word_only", "raw")
    if requested != "auto":
        if requested not in allowed:
            raise ValueError(f"Unsupported noise policy: {requested}")
        return requested, pd.DataFrame([{"policy": requested, "selected": True, "selection_reason": "explicit_configuration"}])

    values = [sanitize_model_text(x) for x in texts]
    if len(values) > config.noise_policy_sample_rows > 0:
        rng = np.random.default_rng(config.seed + 2713)
        idx = np.sort(rng.choice(len(values), size=config.noise_policy_sample_rows, replace=False))
        sample = [values[i] for i in idx.tolist()]
    else:
        sample = values

    profile = representation_profile_candidates(config, len(sample))[0]
    rows: List[Dict[str, Any]] = []
    descriptions: Dict[str, Dict[int, Dict[str, Any]]] = {}
    for pidx, policy in enumerate(allowed):
        try:
            model_text = prepare_model_texts(sample, noise_model, policy)
            latent, vectors = fit_latent(
                model_text, config, profile,
                noise_model=noise_model if policy == "word_only" else None,
                noise_policy=policy,
            )
            local_cfg = Config(**{
                **asdict(config),
                "model_search_trials": max(6, min(config.model_search_trials, config.noise_policy_search_trials)),
                "stability_repeats": max(2, min(config.stability_repeats, 3)),
                "search_sample_rows": min(len(sample), config.search_sample_rows),
            })
            model, labels, strengths, _ = fit_cluster_search(vectors, local_cfg, seed=config.seed + 101 * (pidx + 1))
            desc, _ = discriminative_descriptions(sample, labels, noise_model, config)
            descriptions[policy] = desc
            metrics = final_partition_metrics(vectors, labels, strengths, config.seed)
            interp, _ = interpretability_metrics(sample, desc, config.descriptor_top_terms)
            rows.append({"policy": policy, "status": "ok", **metrics, **interp, "cluster_method": model.method})
        except Exception as exc:
            rows.append({"policy": policy, "status": "failed", "reason": str(exc)})

    table = pd.DataFrame(rows)
    ok = table[table["status"].eq("ok")].copy()
    if ok.empty:
        return "raw", table

    raw_desc = descriptions.get("raw", {})
    semantic_allowed: Dict[str, bool] = {"raw": True}
    semantic_status: Dict[str, str] = {"raw": "REFERENCE"}
    for policy in ("shared_clean", "word_only"):
        if policy not in descriptions or not raw_desc:
            semantic_allowed[policy] = False
            semantic_status[policy] = "UNAVAILABLE"
            continue
        flag, _, summary = semantic_regression_guard(sample, raw_desc, descriptions[policy], config)
        semantic_allowed[policy] = bool(flag)
        semantic_status[policy] = str(summary["status"])

    ok["semantic_allowed"] = ok["policy"].map(lambda x: semantic_allowed.get(str(x), False))
    ok["structurally_valid"] = (
        (pd.to_numeric(ok["n_clusters"], errors="coerce") >= 2)
        & (pd.to_numeric(ok["assigned_fraction"], errors="coerce") > 0)
        & (pd.to_numeric(ok["largest_cluster_share"], errors="coerce") < 1)
    )
    candidates = ok[ok["semantic_allowed"] & ok["structurally_valid"]].copy()
    if candidates.empty:
        candidates = ok[ok["policy"].eq("raw")].copy()
    if candidates.empty:
        candidates = ok.copy()

    score_parts = []
    for metric, high in (
        ("npmi_coherence", True),
        ("descriptor_diversity_composite", True),
        ("mean_cluster_cohesion", True),
        ("silhouette", True),
        ("balance_entropy", True),
        ("centroid_separation", True),
        ("largest_cluster_share", False),
    ):
        if metric in candidates.columns:
            score_parts.append(percentile_rank(candidates[metric], high))
    candidates["selection_score"] = pd.concat(score_parts, axis=1).mean(axis=1) if score_parts else 0.5
    selected = str(candidates.sort_values("selection_score", ascending=False).iloc[0]["policy"])
    table["semantic_status"] = table["policy"].map(lambda x: semantic_status.get(str(x), "UNKNOWN"))
    table["selected"] = table["policy"].eq(selected)
    return selected, table


def representation_search(
    model_texts: Sequence[str],
    source_texts: Sequence[str],
    noise_model: NoiseModel,
    noise_policy: str,
    config: Config,
) -> Tuple[Dict[str, Any], pd.DataFrame]:
    values = list(model_texts)
    source = list(source_texts)
    if len(values) > config.representation_search_rows > 0:
        rng = np.random.default_rng(config.seed + 8081)
        idx = np.sort(rng.choice(len(values), size=config.representation_search_rows, replace=False))
        sample_model = [values[i] for i in idx.tolist()]
        sample_source = [source[i] for i in idx.tolist()]
    else:
        sample_model, sample_source = values, source

    rows: List[Dict[str, Any]] = []
    profiles = representation_profile_candidates(config, len(sample_model))
    for pidx, profile in enumerate(profiles):
        try:
            latent, vectors = fit_latent(
                sample_model, config, profile,
                noise_model=noise_model if noise_policy == "word_only" else None,
                noise_policy=noise_policy,
            )
            local_cfg = Config(**{
                **asdict(config),
                "model_search_trials": max(8, min(config.model_search_trials, 12)),
                "stability_repeats": max(2, min(config.stability_repeats, 3)),
                "search_sample_rows": min(len(sample_model), config.search_sample_rows),
            })
            model, labels, strengths, _ = fit_cluster_search(vectors, local_cfg, seed=config.seed + 619 * (pidx + 1))
            desc, _ = discriminative_descriptions(sample_source, labels, noise_model, config)
            metrics = final_partition_metrics(vectors, labels, strengths, config.seed)
            interp, _ = interpretability_metrics(sample_source, desc, config.descriptor_top_terms)
            rows.append({
                "profile_id": pidx,
                **profile,
                "cluster_method": model.method,
                "assigned_stability_ari": model.assigned_stability_ari,
                "outlier_jaccard": model.outlier_jaccard,
                **metrics,
                **interp,
            })
        except Exception as exc:
            rows.append({"profile_id": pidx, **profile, "status": "failed", "reason": str(exc)})

    table = pd.DataFrame(rows)
    ok = table[~table.get("status", pd.Series(index=table.index, dtype=object)).eq("failed")].copy()
    if ok.empty:
        return profiles[0], table
    score_parts = []
    for metric, high in (
        ("npmi_coherence", True),
        ("descriptor_diversity_composite", True),
        ("mean_cluster_cohesion", True),
        ("silhouette", True),
        ("balance_entropy", True),
        ("centroid_separation", True),
        ("assigned_stability_ari", True),
        ("largest_cluster_share", False),
    ):
        if metric in ok.columns:
            score_parts.append(percentile_rank(ok[metric], high))
    ok["selection_score"] = pd.concat(score_parts, axis=1).mean(axis=1) if score_parts else 0.5
    best = ok.sort_values("selection_score", ascending=False).iloc[0]
    profile = {
        "svd_components": int(best["svd_components"]),
        "word_weight": float(best["word_weight"]),
        "char_weight": float(best["char_weight"]),
    }
    table = table.merge(ok[["profile_id", "selection_score"]], on="profile_id", how="left")
    table["selected"] = table["profile_id"].eq(int(best["profile_id"]))
    return profile, table

