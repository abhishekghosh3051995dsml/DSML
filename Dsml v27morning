def fit_reference_baseline(
    texts: Sequence[str], config: Config
) -> Tuple[LatentModel, ClusterModel, np.ndarray, np.ndarray, np.ndarray, pd.DataFrame, Dict[int, Dict[str, Any]], NoiseModel]:
    profile = representation_profile_candidates(config, len(texts))[0]
    latent, vectors = fit_latent(texts, config, profile, noise_policy="raw")
    model, labels, strengths, search = fit_cluster_search(vectors, config, seed=config.seed)
    empty_noise = NoiseModel(
        unigrams=set(), template_phrases=set(), descriptor_blocklist=set(),
        protected_phrases=set(), protected_unigrams=set(),
        structural_terms=set(STRUCTURAL_PLACEHOLDER_TOKENS),
        score_threshold=float("inf"), selection_method="reference",
    )
    descriptions, _ = discriminative_descriptions(texts, labels, empty_noise, config)
    return latent, model, vectors, labels, strengths, search, descriptions, empty_noise


def process_corpus(
    frame: pd.DataFrame,
    text_col: str,
    corpus_name: str,
    config: Config,
) -> Dict[str, Any]:
    LOGGER.info("[%s] Phase-2 corpus processing: %s", "3/9" if corpus_name == "customer" else "7/9", corpus_name)
    data = frame.copy().reset_index(drop=True)
    data[text_col] = data[text_col].fillna("").astype(str).map(lambda x: sanitize_model_text(redact_pii(x)))
    data = data[data[text_col].map(lambda x: len(tokenize(x)) >= 2)].reset_index(drop=True)

    dev = data[data["data_split"].eq("development")].copy().reset_index()
    if len(dev) < 30:
        raise RuntimeError(f"Too few development rows for {corpus_name}: {len(dev)}")
    unique_dev = dev[["index", text_col]].drop_duplicates(text_col).reset_index(drop=True)
    unique_raw = unique_dev[text_col].astype(str).tolist()
    if len(unique_raw) < 30:
        raise RuntimeError(f"{corpus_name}: only {len(unique_raw)} distinct development texts")

    LOGGER.info("%s: fitting reference baseline", corpus_name)
    (
        baseline_latent, baseline_cluster, baseline_vectors, baseline_labels,
        baseline_strengths, baseline_search, baseline_desc_initial, baseline_noise,
    ) = fit_reference_baseline(unique_raw, config)
    baseline_metrics = final_partition_metrics(
        baseline_vectors, baseline_labels, baseline_strengths, config.seed
    )
    baseline_interp, baseline_per_npmi = interpretability_metrics(
        unique_raw, baseline_desc_initial, config.descriptor_top_terms
    )
    baseline_metrics.update(baseline_interp)

    LOGGER.info("%s: learning corpus-derived noise with signal protection", corpus_name)
    labelings, noise_consensus_audit = build_noise_label_ensemble(
        baseline_vectors, baseline_cluster, baseline_labels, config
    )
    noise_model, noise_table = learn_noise_model(unique_raw, labelings, config)
    protected_signal_table = noise_table[noise_table["protected_signal"] == True].copy()

    # Rebuild baseline descriptions under the same descriptor blocking policy.
    baseline_descriptions, baseline_descriptor_audit = discriminative_descriptions(
        unique_raw, baseline_labels, noise_model, config
    )
    baseline_interp, baseline_per_npmi = interpretability_metrics(
        unique_raw, baseline_descriptions, config.descriptor_top_terms
    )
    baseline_metrics.update(baseline_interp)

    selected_policy, noise_policy_ablation = select_noise_policy(unique_raw, noise_model, config)
    model_unique = prepare_model_texts(unique_raw, noise_model, selected_policy)

    LOGGER.info("%s: selecting representation profile", corpus_name)
    selected_profile, representation_search_table = representation_search(
        model_unique, unique_raw, noise_model, selected_policy, config
    )

    LOGGER.info("%s: detecting near-duplicate families", corpus_name)
    family_ids, duplicate_pairs, duplicate_cutoff, duplicate_method, duplicate_projection = detect_duplicate_families(
        model_unique, config
    )
    reps, duplicate_families = choose_family_representatives(family_ids, duplicate_projection)
    fit_rep_positions = reps.copy()
    if len(fit_rep_positions) > config.max_cluster_fit_rows:
        rng = np.random.default_rng(config.seed)
        chosen = np.sort(rng.choice(len(fit_rep_positions), size=config.max_cluster_fit_rows, replace=False))
        fit_rep_positions = fit_rep_positions[chosen]
    fit_texts = [model_unique[i] for i in fit_rep_positions.tolist()]

    LOGGER.info("%s: fitting selected representation and cluster-family search", corpus_name)
    latent, fit_vectors = fit_latent(
        fit_texts,
        config,
        selected_profile,
        noise_model=noise_model if selected_policy == "word_only" else None,
        noise_policy=selected_policy,
    )
    cluster_model, fit_labels, fit_strengths, search_table, semantic_rerank_table = fit_cluster_search_with_semantic_rerank(
        fit_vectors, [unique_raw[i] for i in fit_rep_positions.tolist()], noise_model, config
    )
    refined_labels, refined_strengths, refinement_audit, refinement_rules = refine_clusters(
        fit_vectors, fit_labels, fit_strengths, config
    )
    final_fit_labels, merge_map, merge_audit = statistically_justified_merge(
        fit_vectors, refined_labels, config
    )

    rep_assignment: Dict[int, Tuple[int, float]] = {
        int(unique_pos): (int(final_fit_labels[pos]), float(refined_strengths[pos]))
        for pos, unique_pos in enumerate(fit_rep_positions.tolist())
    }
    missing_reps = [int(i) for i in reps.tolist() if int(i) not in rep_assignment]
    if missing_reps:
        vec = latent.transform([model_unique[i] for i in missing_reps])
        labs, sts = predict_with_refinements(cluster_model, refinement_rules, vec, merge_map)
        for i, lab, st in zip(missing_reps, labs.tolist(), sts.tolist()):
            rep_assignment[i] = (int(lab), float(st))

    rep_by_family = {
        int(row.duplicate_family_id): int(row.representative_index)
        for row in duplicate_families.itertuples()
    }
    family_to_assignment = {
        fam: rep_assignment.get(rep_idx, (-1, 0.0))
        for fam, rep_idx in rep_by_family.items()
    }
    unique_labels_pre = np.asarray([family_to_assignment[int(fam)][0] for fam in family_ids], dtype=int)
    unique_strengths = np.asarray([family_to_assignment[int(fam)][1] for fam in family_ids], dtype=float)
    unique_vectors = latent.transform(model_unique)

    recovery_model, recovery_audit = fit_outlier_recovery_model(unique_vectors, unique_labels_pre, config)
    (
        unique_labels, unique_strengths, unique_sources,
        unique_recovery_similarity, unique_recovery_margin,
    ) = apply_outlier_recovery_model(unique_vectors, unique_labels_pre, unique_strengths, recovery_model)

    descriptions, descriptor_audit = discriminative_descriptions(
        unique_raw, unique_labels, noise_model, config
    )
    candidate_interp, candidate_per_npmi = interpretability_metrics(
        unique_raw, descriptions, config.descriptor_top_terms
    )
    candidate_metrics = final_partition_metrics(
        unique_vectors, unique_labels, unique_strengths, config.seed, unique_sources
    )
    candidate_metrics.update(candidate_interp)

    structural_ok, structural_audit, structural_summary = structural_safety_gate(
        candidate_metrics, search_table, cluster_model
    )
    semantic_ok, semantic_audit, semantic_summary = semantic_regression_guard(
        unique_raw, baseline_descriptions, descriptions, config
    )
    deploy_candidate = bool(structural_ok and semantic_ok)

    deployed_policy = selected_policy
    deployed_mode = (
        "noise_reduced" if selected_policy == "shared_clean"
        else "word_only_feature_suppression" if selected_policy == "word_only"
        else "raw_redacted"
    )
    deployed_metrics = dict(candidate_metrics)
    deployed_sources = unique_sources.copy()
    deployed_rec_sim = unique_recovery_similarity.copy()
    deployed_rec_margin = unique_recovery_margin.copy()
    reverted = False

    if not deploy_candidate and config.on_regression == "revert":
        LOGGER.warning("%s: deployment checks failed; reverting to reference baseline", corpus_name)
        latent = baseline_latent
        cluster_model = baseline_cluster
        refinement_rules = []
        merge_map = {}
        recovery_model = None
        unique_vectors = baseline_vectors
        unique_labels = np.asarray(baseline_labels, dtype=int)
        unique_strengths = np.asarray(baseline_strengths, dtype=float)
        deployed_sources = np.asarray(["native" if int(x) != -1 else "outlier" for x in unique_labels], dtype=object)
        deployed_rec_sim = np.full(len(unique_labels), np.nan)
        deployed_rec_margin = np.full(len(unique_labels), np.nan)
        descriptions = baseline_descriptions
        descriptor_audit = baseline_descriptor_audit
        candidate_per_npmi = baseline_per_npmi
        deployed_metrics = dict(baseline_metrics)
        deployed_policy = "raw"
        deployed_mode = "raw_redacted"
        reverted = True

    catalog = cluster_catalog(
        unique_raw,
        unique_vectors,
        unique_labels,
        unique_strengths,
        descriptions,
        cluster_model,
        per_cluster_npmi=candidate_per_npmi,
        assignment_source=deployed_sources,
        representative_count=5,
    )

    exact_map: Dict[str, Tuple[int, float, str, float, float]] = {
        str(raw): (int(lab), float(st), str(src), float(rs), float(rm))
        for raw, lab, st, src, rs, rm in zip(
            unique_raw,
            unique_labels.tolist(),
            unique_strengths.tolist(),
            deployed_sources.tolist(),
            deployed_rec_sim.tolist(),
            deployed_rec_margin.tolist(),
        )
    }

    labels_all = np.full(len(data), -1, dtype=int)
    strengths_all = np.zeros(len(data), dtype=float)
    source_all = np.asarray(["outlier"] * len(data), dtype=object)
    rec_sim_all = np.full(len(data), np.nan)
    rec_margin_all = np.full(len(data), np.nan)
    model_text_all: List[str] = []
    unseen_positions: List[int] = []
    unseen_texts: List[str] = []

    for i, raw in enumerate(data[text_col].astype(str).tolist()):
        model_text = prepare_model_texts([raw], noise_model, deployed_policy)[0]
        model_text_all.append(model_text)
        hit = exact_map.get(raw)
        if hit is not None and data.at[i, "data_split"] == "development":
            labels_all[i], strengths_all[i], source_all[i], rec_sim_all[i], rec_margin_all[i] = hit
        else:
            unseen_positions.append(i)
            unseen_texts.append(model_text)

    if unseen_positions:
        vec = latent.transform(unseen_texts)
        labs, sts, srcs, rs, rm = predict_final_partition(
            cluster_model, refinement_rules, vec, merge_map, recovery_model
        )
        for pos, lab, st, src, a, b in zip(
            unseen_positions, labs.tolist(), sts.tolist(), srcs.tolist(), rs.tolist(), rm.tolist()
        ):
            labels_all[pos] = int(lab)
            strengths_all[pos] = float(st)
            source_all[pos] = str(src)
            rec_sim_all[pos] = float(a)
            rec_margin_all[pos] = float(b)

    data["phase2_model_text"] = model_text_all
    data["phase2_cluster_id"] = labels_all
    data["phase2_cluster_strength"] = strengths_all
    data["phase2_assignment_source"] = source_all
    data["phase2_recovery_similarity"] = rec_sim_all
    data["phase2_recovery_margin"] = rec_margin_all
    data["phase2_cluster_descriptor"] = [
        "unassigned" if int(lab) == -1
        else descriptions.get(int(lab), {}).get("descriptor", f"cluster_{int(lab)}")
        for lab in labels_all.tolist()
    ]

    test_mask = data["data_split"].eq("locked_test").to_numpy()
    locked_test_metrics: Dict[str, Any] = {}
    if test_mask.any():
        test_texts = [model_text_all[i] for i in np.flatnonzero(test_mask).tolist()]
        test_vectors = latent.transform(test_texts)
        locked_test_metrics = final_partition_metrics(
            test_vectors,
            labels_all[test_mask],
            strengths_all[test_mask],
            config.seed,
            source_all[test_mask],
        )
        test_interp, _ = interpretability_metrics(
            [str(data.loc[i, text_col]) for i in np.flatnonzero(test_mask).tolist()],
            descriptions,
            config.descriptor_top_terms,
        )
        locked_test_metrics.update(test_interp)

    before_after = pd.DataFrame([
        {"stage": "reference_baseline", **baseline_metrics},
        {"stage": "attempted_improved_partition", **candidate_metrics},
        {"stage": "deployed_partition", **deployed_metrics},
    ])

    dev_mask = data["data_split"].eq("development").to_numpy()
    reference_distribution = cluster_distribution(labels_all[dev_mask])
    reference_outlier_rate = float(np.mean(labels_all[dev_mask] == -1)) if dev_mask.any() else 0.0
    native_mask = dev_mask & (source_all != "recovered_outlier")
    reference_strength = strength_quantiles(strengths_all[native_mask]) if native_mask.any() else {}
    reference_recovery_rate = float(np.mean(source_all[dev_mask] == "recovered_outlier")) if dev_mask.any() else 0.0
    if test_mask.any():
        locked_test_metrics["cluster_distribution_js_distance_vs_development"] = cluster_js_distance(
            reference_distribution, cluster_distribution(labels_all[test_mask])
        )

    contamination = descriptor_contamination_metrics(descriptions, noise_model)
    deployed_metrics.update(contamination)
    quality_scores = cluster_quality_index(deployed_metrics, cluster_model, contamination)

    bundle = CorpusBundle(
        pipeline_name=PIPELINE_NAME,
        pipeline_version=PIPELINE_VERSION,
        corpus_name=corpus_name,
        noise_model=noise_model,
        noise_policy=deployed_policy,
        latent_model=latent,
        cluster_model=cluster_model,
        refinement_rules=refinement_rules,
        merge_map=merge_map,
        outlier_recovery_model=recovery_model,
        descriptions=descriptions,
        model_text_mode=deployed_mode,
        reference_cluster_distribution=reference_distribution,
        reference_outlier_rate=reference_outlier_rate,
        reference_strength_quantiles=reference_strength,
        reference_recovery_rate=reference_recovery_rate,
        config=asdict(config),
    )

    summary = {
        "corpus": corpus_name,
        "development_rows": int((data["data_split"] == "development").sum()),
        "locked_test_rows": int((data["data_split"] == "locked_test").sum()),
        "unique_development_texts": len(unique_raw),
        "noise_consensus_clusterings": len(labelings),
        "learned_noise_unigrams": len(noise_model.unigrams),
        "learned_noise_template_phrases": len(noise_model.template_phrases),
        "protected_signal_phrases": len(noise_model.protected_phrases),
        "protected_signal_unigrams": len(noise_model.protected_unigrams),
        "noise_selection_method": noise_model.selection_method,
        "noise_policy_selected": selected_policy,
        "noise_policy_deployed": deployed_policy,
        "representation_profile": dict(latent.profile),
        "near_duplicate_similarity_cutoff": duplicate_cutoff,
        "near_duplicate_method": duplicate_method,
        "near_duplicate_families": int(len(set(family_ids.tolist()))),
        "cluster_fit_representatives": len(fit_texts),
        "cluster_method": cluster_model.method,
        "selected_parameters": cluster_model.parameters,
        "merge_mapping_size": len(merge_map),
        "outlier_recovery": {
            "enabled": bool(config.reassign_outliers),
            "outliers_before": int(np.sum(unique_labels_pre == -1)),
            "outliers_after": int(np.sum(unique_labels == -1)),
