def representative_examples(
    texts: Sequence[str], vectors: np.ndarray, labels: np.ndarray, per_cluster: int
) -> Dict[int, List[str]]:
    out: Dict[int, List[str]] = {}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cid)
        if len(idx) == 0:
            continue
        c = vectors[idx].mean(axis=0)
        norm = np.linalg.norm(c)
        if norm > 0:
            c /= norm
        sims = vectors[idx] @ c
        order = idx[np.argsort(sims)[::-1][:per_cluster]]
        out[cid] = [redact_pii(str(texts[i])) for i in order.tolist()]
    return out


def cluster_catalog(
    texts: Sequence[str],
    vectors: np.ndarray,
    labels: np.ndarray,
    strengths: np.ndarray,
    descriptions: Dict[int, Dict[str, Any]],
    model: ClusterModel,
    per_cluster_npmi: Optional[Dict[int, float]] = None,
    assignment_source: Optional[np.ndarray] = None,
    representative_count: int = 5,
) -> pd.DataFrame:
    reps = representative_examples(texts, vectors, labels, representative_count)
    cohesion = local_cluster_cohesion(vectors, labels)
    sources = (
        np.asarray(assignment_source, dtype=object)
        if assignment_source is not None
        else np.asarray(["native" if int(x) != -1 else "outlier" for x in labels], dtype=object)
    )
    n_nonoutlier = max(int(np.sum(labels != -1)), 1)
    rows: List[Dict[str, Any]] = []
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cid)
        native_idx = idx[sources[idx] != "recovered_outlier"]
        rows.append({
            "cluster_id": cid,
            "count": len(idx),
            "share_of_nonoutliers_pct": 100.0 * len(idx) / n_nonoutlier,
            "recovered_outlier_count": int(np.sum(sources[idx] == "recovered_outlier")),
            "mean_native_membership_strength": float(np.mean(strengths[native_idx])) if len(native_idx) else np.nan,
            "cohesion_mean_cosine_to_centroid": cohesion.get(cid, np.nan),
            "npmi_coherence": (per_cluster_npmi or {}).get(cid, np.nan),
            "descriptor": descriptions.get(cid, {}).get("descriptor", f"cluster_{cid}"),
            "top_terms": "; ".join(x["term"] for x in descriptions.get(cid, {}).get("keywords", [])[:12]),
            "representative_examples": " || ".join(reps.get(cid, [])),
            "global_stability_ari": model.global_stability_ari,
            "assigned_stability_ari": model.assigned_stability_ari,
            "outlier_jaccard": model.outlier_jaccard,
        })
    return pd.DataFrame(rows).sort_values("count", ascending=False).reset_index(drop=True) if rows else pd.DataFrame()


def structural_safety_gate(
    candidate: Dict[str, float], candidate_search: pd.DataFrame, model: ClusterModel
) -> Tuple[bool, pd.DataFrame, Dict[str, Any]]:
    rows: List[Dict[str, Any]] = []
    hard = [
        ("at_least_two_clusters", float(candidate.get("n_clusters", 0.0)) >= 2.0, candidate.get("n_clusters"), 2.0),
        ("not_single_cluster_collapse", float(candidate.get("largest_cluster_share", 1.0)) < 1.0, candidate.get("largest_cluster_share"), 1.0),
        ("some_records_assigned", float(candidate.get("assigned_fraction", 0.0)) > 0.0, candidate.get("assigned_fraction"), 0.0),
    ]
    for name, ok, observed, boundary in hard:
        rows.append({"condition": name, "passed": bool(ok), "observed": observed, "boundary": boundary, "basis": "hard_invariant"})

    for metric, side in (
        ("silhouette", "lower"),
        ("balance_entropy", "lower"),
        ("largest_cluster_share", "upper"),
        ("noise_rate", "upper"),
    ):
        values = pd.to_numeric(candidate_search.get(metric, pd.Series(dtype=float)), errors="coerce").dropna().to_numpy(float)
        observed = float(candidate.get(metric, np.nan))
        if len(values) < 4 or not np.isfinite(observed):
            continue
        boundary = robust_lower_fence(values) if side == "lower" else robust_upper_fence(values)
        ok = observed >= boundary if side == "lower" else observed <= boundary
        rows.append({
            "condition": f"search_fence_{metric}",
            "passed": bool(ok),
            "observed": observed,
            "boundary": boundary,
            "basis": f"development_search_{side}_fence",
        })
    failed = [r["condition"] for r in rows if not r["passed"]]
    return len(failed) == 0, pd.DataFrame(rows), {
        "passed": len(failed) == 0,
        "failed_conditions": failed,
        "gate_scope": "structural_safety_only",
    }


def descriptor_contamination_metrics(
    descriptions: Dict[int, Dict[str, Any]], noise_model: NoiseModel
) -> Dict[str, float]:
    terms = [str(x.get("term", "")) for payload in descriptions.values() for x in payload.get("keywords", [])]
    if not terms:
        return {"descriptor_contamination_rate": float("nan"), "placeholder_contamination_rate": float("nan")}
    bad = 0
    placeholder = 0
    for term in terms:
        toks = tokenize(term)
        if any(t in STRUCTURAL_PLACEHOLDER_TOKENS for t in toks):
            placeholder += 1
        if not descriptor_term_allowed(term, noise_model):
            bad += 1
    return {
        "descriptor_contamination_rate": bad / len(terms),
        "placeholder_contamination_rate": placeholder / len(terms),
    }


def bounded01(value: Any, low: float, high: float) -> Optional[float]:
    try:
        x = float(value)
    except Exception:
        return None
    if not np.isfinite(x) or high <= low:
        return None
    return float(np.clip((x - low) / (high - low), 0.0, 1.0))


def cluster_quality_index(
    metrics: Dict[str, Any], model: ClusterModel, contamination: Dict[str, float]
) -> Dict[str, float]:
    semantic = [
        bounded01(metrics.get("npmi_coherence"), -1.0, 1.0),
        bounded01(metrics.get("descriptor_diversity_composite"), 0.0, 1.0),
        bounded01(metrics.get("mean_cluster_cohesion"), 0.0, 1.0),
        None if not np.isfinite(float(contamination.get("descriptor_contamination_rate", np.nan)))
        else 1.0 - float(contamination["descriptor_contamination_rate"]),
    ]
    structural = [
        bounded01(metrics.get("silhouette"), -1.0, 1.0),
        bounded01(metrics.get("balance_entropy"), 0.0, 1.0),
        None if not np.isfinite(float(metrics.get("largest_cluster_share", np.nan)))
        else 1.0 - float(metrics["largest_cluster_share"]),
        bounded01(metrics.get("assigned_fraction"), 0.0, 1.0),
    ]
    stability = [
        bounded01(model.assigned_stability_ari, -1.0, 1.0),
        bounded01(model.outlier_jaccard, 0.0, 1.0),
        bounded01(model.weighted_persistence, 0.0, 1.0),
    ]
    def avg(values: Sequence[Optional[float]]) -> float:
        vals = [float(v) for v in values if v is not None and np.isfinite(v)]
        return float(np.mean(vals)) if vals else float("nan")
    a, b, c = avg(semantic), avg(structural), avg(stability)
    fam = [x for x in (a, b, c) if np.isfinite(x)]
    return {
        "semantic_quality_score": 100.0 * a if np.isfinite(a) else np.nan,
        "structural_quality_score": 100.0 * b if np.isfinite(b) else np.nan,
        "stability_quality_score": 100.0 * c if np.isfinite(c) else np.nan,
        "cluster_quality_index": 100.0 * float(np.mean(fam)) if fam else np.nan,
    }

