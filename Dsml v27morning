def sanitize_frame_for_export(frame: pd.DataFrame) -> pd.DataFrame:
    out = frame.copy()
    for col in out.select_dtypes(include=["object"]).columns:
        out[col] = out[col].map(lambda x: redact_pii(str(x)) if x is not None else x)
    return out


def residual_pii_counts(frame: pd.DataFrame, text_columns: Sequence[str]) -> Dict[str, int]:
    counts = {name: 0 for name, _ in PII_PATTERNS}
    for col in text_columns:
        if col not in frame.columns:
            continue
        for value in frame[col].fillna("").astype(str):
            for name, pattern in PII_PATTERNS:
                if pattern.search(value):
                    counts[name] += 1
    return counts


