def adaptive_min_df(n_docs: int) -> int:
    return max(2, int(round(math.log2(max(n_docs, 4)) / 2.0)))


def representation_profile_candidates(config: Config, n_docs: int) -> List[Dict[str, Any]]:
    base = int(config.svd_components)
    dims = sorted(set(
        max(24, min(base, int(round(x))))
        for x in (min(64, base), min(96, base), min(128, base), base)
    ))
    char_weights = [0.20, 0.35, 0.50, 0.70]
    candidates: List[Dict[str, Any]] = []
    for i, dim in enumerate(dims):
        cw = char_weights[min(i, len(char_weights) - 1)]
        candidates.append({"svd_components": int(dim), "word_weight": 1.0, "char_weight": float(cw)})
    candidates.append({"svd_components": int(min(base, max(32, int(round(math.sqrt(max(n_docs, 16)) * 4))))), "word_weight": 1.0, "char_weight": 0.30})
    unique: List[Dict[str, Any]] = []
    seen = set()
    for c in candidates:
        key = (c["svd_components"], c["word_weight"], c["char_weight"])
        if key not in seen:
            seen.add(key)
            unique.append(c)
    return unique[:max(1, config.representation_profiles)]


def build_vectorizer(
    config: Config,
    n_docs: int,
    profile: Dict[str, Any],
    min_df_override: Optional[int] = None,
    word_vocabulary: Optional[Sequence[str]] = None,
) -> FeatureUnion:
    min_df = int(min_df_override) if min_df_override is not None else adaptive_min_df(n_docs)
    word = TfidfVectorizer(
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(1, 3),
        min_df=min_df,
        max_df=1.0,
        max_features=config.max_word_features,
        sublinear_tf=True,
        norm="l2",
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b",
        stop_words=None,
        vocabulary=list(word_vocabulary) if word_vocabulary is not None else None,
    )
    char = TfidfVectorizer(
        analyzer="char_wb",
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(3, 5),
        min_df=min_df,
        max_features=config.max_char_features,
        sublinear_tf=True,
        norm="l2",
    )
    return FeatureUnion(
        [("word", word), ("char", char)],
        transformer_weights={
            "word": float(profile.get("word_weight", 1.0)),
            "char": float(profile.get("char_weight", 0.35)),
        },
    )


def suppressed_word_vocabulary(texts: Sequence[str], config: Config, noise_model: NoiseModel, profile: Dict[str, Any]) -> Optional[List[str]]:
    values = list(texts)
    probe = build_vectorizer(config, len(values), profile)
    try:
        probe.fit(values)
    except ValueError:
        probe = build_vectorizer(config, len(values), profile, min_df_override=1)
        probe.fit(values)
    word_vec = dict(probe.transformer_list)["word"]
    blocked = set(noise_model.descriptor_blocklist) | noise_model.model_terms()
    protected = set(noise_model.protected_unigrams)
    vocab = [
        term for term in word_vec.get_feature_names_out().tolist()
        if (term not in blocked or term in protected)
    ]
    return vocab if len(vocab) >= 10 else None


def prepare_model_texts(texts: Sequence[str], noise_model: NoiseModel, policy: str) -> List[str]:
    values = [str(x) for x in texts]
    policy = str(policy).lower()
    if policy == "shared_clean":
        return [apply_noise_model(x, noise_model) for x in values]
    if policy in {"word_only", "raw"}:
        return values
    raise ValueError(f"Unsupported noise policy: {policy}")


def fit_latent(
    texts: Sequence[str],
    config: Config,
    profile: Dict[str, Any],
    noise_model: Optional[NoiseModel] = None,
    noise_policy: str = "raw",
) -> Tuple[LatentModel, np.ndarray]:
    values = list(texts)
    if len(values) < 3:
        raise RuntimeError("Insufficient texts for latent representation.")
    word_vocabulary = None
    if noise_model is not None and str(noise_policy).lower() == "word_only":
        word_vocabulary = suppressed_word_vocabulary(values, config, noise_model, profile)
    vectorizer = build_vectorizer(config, len(values), profile, word_vocabulary=word_vocabulary)
    try:
        x = vectorizer.fit_transform(values)
    except ValueError:
        vectorizer = build_vectorizer(config, len(values), profile, min_df_override=1, word_vocabulary=word_vocabulary)
        x = vectorizer.fit_transform(values)
    n_components = min(int(profile.get("svd_components", config.svd_components)), x.shape[0] - 1, x.shape[1] - 1)
    if n_components < 2:
        raise RuntimeError("Insufficient samples/features for SVD.")
    svd = TruncatedSVD(n_components=n_components, random_state=config.seed)
    z = svd.fit_transform(x)
    normalizer = Normalizer(copy=False)
    z = normalizer.fit_transform(z)
    model = LatentModel(
        vectorizer=vectorizer,
        svd=svd,
        normalizer=normalizer,
        batch_size=config.transform_batch_size,
        profile=dict(profile),
    )
    return model, np.asarray(z, dtype=np.float32)


