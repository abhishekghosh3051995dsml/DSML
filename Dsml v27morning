def build_assistant_units(frame: pd.DataFrame, config: Config) -> pd.DataFrame:
    rows: List[Dict[str, Any]] = []
    assistant = frame[frame["_role"].eq("assistant")].copy()
    for _, row in assistant.iterrows():
        raw = str(row.get("_model_base_text", row.get("_text", "")))
        pieces: List[str] = []
        for part in SENTENCE_SPLIT_RE.split(raw):
            part = BULLET_PREFIX_RE.sub("", part.strip())
            if not part:
                continue
            if SHORT_HEADING_RE.match(part) and len(tokenize(part)) <= 6:
                continue
            if len(tokenize(part)) >= 3:
                pieces.append(part)

        merged: List[str] = []
        buffer: List[str] = []
        token_count = 0
        for piece in pieces:
            n = len(tokenize(piece))
            if buffer and token_count + n > config.assistant_max_unit_tokens:
                merged.append(" ".join(buffer))
                buffer = []
                token_count = 0
            buffer.append(piece)
            token_count += n
            if token_count >= config.assistant_target_unit_tokens:
                merged.append(" ".join(buffer))
                buffer = []
                token_count = 0
        if buffer:
            if merged and token_count < config.assistant_min_unit_tokens:
                merged[-1] = merged[-1] + " " + " ".join(buffer)
            else:
                merged.append(" ".join(buffer))

        for unit_idx, text in enumerate(merged):
            if len(tokenize(text)) < config.assistant_min_unit_tokens:
                continue
            rows.append({
                "_row_id": int(row["_row_id"]),
                "_case": str(row["_case"]),
                "_conversation": str(row["_conversation"]),
                "_group": str(row["_group"]),
                "data_split": str(row["data_split"]),
                "unit_index": unit_idx,
                "assistant_unit": redact_pii(text),
            })
    units = pd.DataFrame(rows)
    if not units.empty and config.assistant_max_units > 0 and len(units) > config.assistant_max_units:
        LOGGER.warning(
            "assistant units=%d exceed advisory threshold=%d; retaining all rows; fit/search caps remain active",
            len(units), config.assistant_max_units,
        )
    return units


