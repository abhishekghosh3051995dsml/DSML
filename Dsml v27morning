def parse_args(argv: Optional[Sequence[str]] = None) -> Config:
    parser = argparse.ArgumentParser(
        description=f"{PIPELINE_NAME} - offline noise suppression and detailed-intent cluster refinement"
    )
    parser.add_argument("--mode", choices=["train", "infer"], default="train")
    parser.add_argument("--profile", choices=["fast_dev", "production"], default="production")
    parser.add_argument("--input", required=True, dest="input_path")
    parser.add_argument("--outdir", default="nora_phase2_v270_out")
    parser.add_argument("--model-dir", default=None)
    parser.add_argument("--report-json", default="nora_phase2_v270_report.json")
    parser.add_argument("--seed", type=int, default=DEFAULT_SEED)
    parser.add_argument("--sample", type=int, default=0, dest="sample_rows")
    parser.add_argument("--test-size", type=float, default=0.20)
    parser.add_argument("--split-trials", type=int, default=64)

    parser.add_argument("--max-word-features", type=int, default=70000)
    parser.add_argument("--max-char-features", type=int, default=80000)
    parser.add_argument("--svd-components", type=int, default=160)
    parser.add_argument("--representation-search-rows", type=int, default=4000)
    parser.add_argument("--representation-profiles", type=int, default=4)

    parser.add_argument("--candidate-noise-features", type=int, default=70000)
    parser.add_argument("--noise-max-ngram", type=int, default=3)
    parser.add_argument("--noise-stability-repeats", type=int, default=5)
    parser.add_argument("--noise-consensus-models", type=int, default=4)
    parser.add_argument("--noise-subsample-fraction", type=float, default=0.80)
    parser.add_argument("--noise-policy", choices=["auto", "shared_clean", "word_only", "raw"], default="auto")
    parser.add_argument("--noise-policy-search-trials", type=int, default=8)
    parser.add_argument("--noise-policy-sample-rows", type=int, default=4000)

    parser.add_argument("--model-search-trials", type=int, default=24)
    parser.add_argument("--stability-repeats", type=int, default=5)
    parser.add_argument("--stability-subsample-fraction", type=float, default=0.85)
    parser.add_argument("--search-sample-rows", type=int, default=8000)
    parser.add_argument("--recursive-max-depth", type=int, default=2)
    parser.add_argument("--max-cluster-fit-rows", type=int, default=30000)

    parser.add_argument("--descriptor-top-terms", type=int, default=12)
    parser.add_argument("--descriptor-min-support", type=int, default=2)
    parser.add_argument("--descriptor-max-features", type=int, default=60000)
    parser.add_argument("--phrase-min-content-tokens", type=int, default=2)
    parser.add_argument("--template-boundary-tokens", type=int, default=6)

    parser.add_argument("--duplicate-projection-components", type=int, default=64)
    parser.add_argument("--duplicate-neighbors", type=int, default=10)
    parser.add_argument("--ann-min-rows", type=int, default=5000)
    parser.add_argument("--transform-batch-size", type=int, default=4096)

    parser.add_argument("--skip-assistant", action="store_true")
    parser.add_argument("--assistant-max-units", type=int, default=120000)
    parser.add_argument("--assistant-min-unit-tokens", type=int, default=12)
    parser.add_argument("--assistant-target-unit-tokens", type=int, default=36)
    parser.add_argument("--assistant-max-unit-tokens", type=int, default=70)

    parser.add_argument("--no-reassign-outliers", action="store_true")
    parser.add_argument("--no-merge-clusters", action="store_true")
    parser.add_argument("--semantic-guard-mode", choices=["block", "warn"], default="block")
    parser.add_argument("--semantic-bootstrap-repeats", type=int, default=64)
    parser.add_argument("--semantic-bootstrap-fraction", type=float, default=0.80)
    parser.add_argument("--semantic-guard-alpha", type=float, default=0.05)
    parser.add_argument("--on-regression", choices=["report", "revert"], default="revert")

    parser.add_argument("--export-review-text", action="store_true")
    parser.add_argument("--pseudonym-key-env", default="NORA_PSEUDONYM_KEY")
    parser.add_argument("--no-persist-models", action="store_true")
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--similarity-heatmap-top-n", type=int, default=20)

    args = parser.parse_args(argv)

    if args.profile == "fast_dev":
        args.model_search_trials = min(args.model_search_trials, 10)
        args.stability_repeats = min(args.stability_repeats, 3)
        args.noise_stability_repeats = min(args.noise_stability_repeats, 3)
        args.noise_consensus_models = min(args.noise_consensus_models, 2)
        args.semantic_bootstrap_repeats = min(args.semantic_bootstrap_repeats, 32)
        args.search_sample_rows = min(args.search_sample_rows, 4000)
        args.representation_profiles = min(args.representation_profiles, 2)

    if args.mode == "train" and not (0.05 <= args.test_size <= 0.40):
        parser.error("--test-size must be between 0.05 and 0.40")
    if not (0.60 <= args.noise_subsample_fraction <= 1.0):
        parser.error("--noise-subsample-fraction must be between 0.60 and 1.0")
    if not (0.60 <= args.stability_subsample_fraction <= 1.0):
        parser.error("--stability-subsample-fraction must be between 0.60 and 1.0")
    if not (0.50 <= args.semantic_bootstrap_fraction <= 1.0):
        parser.error("--semantic-bootstrap-fraction must be between 0.50 and 1.0")
    if args.mode == "infer" and not args.model_dir:
        parser.error("--model-dir is required when --mode infer")

    return Config(
        input_path=args.input_path,
        outdir=args.outdir,
        report_json=args.report_json,
        mode=args.mode,
        model_dir=args.model_dir,
        profile=args.profile,
        seed=args.seed,
        sample_rows=args.sample_rows,
        test_size=args.test_size,
        split_trials=args.split_trials,
        max_word_features=args.max_word_features,
        max_char_features=args.max_char_features,
        svd_components=args.svd_components,
        representation_search_rows=args.representation_search_rows,
        representation_profiles=args.representation_profiles,
        candidate_noise_features=args.candidate_noise_features,
        noise_max_ngram=args.noise_max_ngram,
        noise_stability_repeats=args.noise_stability_repeats,
        noise_consensus_models=args.noise_consensus_models,
        noise_subsample_fraction=args.noise_subsample_fraction,
        noise_policy=args.noise_policy,
        noise_policy_search_trials=args.noise_policy_search_trials,
        noise_policy_sample_rows=args.noise_policy_sample_rows,
        model_search_trials=args.model_search_trials,
        stability_repeats=args.stability_repeats,
        search_sample_rows=args.search_sample_rows,
        stability_subsample_fraction=args.stability_subsample_fraction,
        recursive_max_depth=args.recursive_max_depth,
        max_cluster_fit_rows=args.max_cluster_fit_rows,
        descriptor_top_terms=args.descriptor_top_terms,
        descriptor_min_support=args.descriptor_min_support,
        descriptor_max_features=args.descriptor_max_features,
        phrase_min_content_tokens=args.phrase_min_content_tokens,
        template_boundary_tokens=args.template_boundary_tokens,
        duplicate_projection_components=args.duplicate_projection_components,
        duplicate_neighbors=args.duplicate_neighbors,
        ann_min_rows=args.ann_min_rows,
        transform_batch_size=args.transform_batch_size,
        reassign_outliers=not args.no_reassign_outliers,
        export_review_text=args.export_review_text,
        pseudonym_key_env=args.pseudonym_key_env,
        include_assistant=not args.skip_assistant,
        assistant_max_units=args.assistant_max_units,
        assistant_min_unit_tokens=args.assistant_min_unit_tokens,
        assistant_target_unit_tokens=args.assistant_target_unit_tokens,
        assistant_max_unit_tokens=args.assistant_max_unit_tokens,
        on_regression=args.on_regression,
        persist_models=not args.no_persist_models,
        merge_clusters=not args.no_merge_clusters,
        semantic_guard_mode=args.semantic_guard_mode,
        semantic_bootstrap_repeats=args.semantic_bootstrap_repeats,
        semantic_bootstrap_fraction=args.semantic_bootstrap_fraction,
        semantic_guard_alpha=args.semantic_guard_alpha,
        enable_cache=not args.no_cache,
        similarity_heatmap_top_n=args.similarity_heatmap_top_n,
    )


def main(argv: Optional[Sequence[str]] = None) -> int:
    configure_logging()
    try:
        config = parse_args(argv)
        if config.mode == "train":
            run_train(config)
        else:
            run_inference(config)
        return 0
    except KeyboardInterrupt:
        LOGGER.error("Interrupted by user.")
        return 130
    except Exception as exc:
        LOGGER.exception("Phase 2 failed: %s", exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
