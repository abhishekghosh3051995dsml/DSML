    frame, schema = load_and_prepare(config)
    frame, split_audit = assign_group_split(frame, config)
    pseudonym_key, pseudonym_key_source = resolve_pseudonym_key(config)

    stage_rows: List[Dict[str, Any]] = []
    cache_hits = 0

    customer = frame[frame["_role"].eq("user")].copy().reset_index(drop=True)
    if len(customer) < 30:
        raise RuntimeError("Too few user/customer rows detected.")

    t0 = time.perf_counter()
    customer_result, customer_cache_hit = process_corpus_cached(customer, "_model_base_text", "customer", config)
    cache_hits += int(customer_cache_hit)
    stage_rows.append({"stage": "customer_process", "seconds": time.perf_counter() - t0, "cache_hit": customer_cache_hit})

    t0 = time.perf_counter()
    customer_export = persist_result(
        customer_result, "customer", outdir, pseudonym_key,
        config.persist_models, config.export_review_text,
    )
    stage_rows.append({"stage": "customer_persist", "seconds": time.perf_counter() - t0, "cache_hit": False})

    assistant_result: Optional[Dict[str, Any]] = None
    assistant_export: Optional[Dict[str, Any]] = None
    assistant_skip_reason: Optional[str] = None
    if config.include_assistant:
        LOGGER.info("[6/9] Building assistant semantic units")
        t0 = time.perf_counter()
        units = build_assistant_units(frame, config)
        stage_rows.append({"stage": "assistant_unit_build", "seconds": time.perf_counter() - t0, "cache_hit": False})
        if len(units) >= 30:
            try:
                t0 = time.perf_counter()
                assistant_result, assistant_cache_hit = process_corpus_cached(
                    units, "assistant_unit", "assistant", config
                )
                cache_hits += int(assistant_cache_hit)
                stage_rows.append({"stage": "assistant_process", "seconds": time.perf_counter() - t0, "cache_hit": assistant_cache_hit})

                t0 = time.perf_counter()
                assistant_export = persist_result(
                    assistant_result, "assistant", outdir, pseudonym_key,
                    config.persist_models, config.export_review_text,
                )
                stage_rows.append({"stage": "assistant_persist", "seconds": time.perf_counter() - t0, "cache_hit": False})
            except Exception as exc:
                assistant_skip_reason = str(exc)
                LOGGER.warning("Assistant processing skipped: %s", exc)
        else:
            assistant_skip_reason = f"only {len(units)} semantic units available, 30 required"
            LOGGER.warning("Assistant processing skipped: %s", assistant_skip_reason)
    else:
        assistant_skip_reason = "disabled with --skip-assistant"

    LOGGER.info("[8/9] Writing consolidated report and manifest")
    any_revert = bool(customer_result["summary"].get("reverted_to_reference")) or bool(
        assistant_result and assistant_result["summary"].get("reverted_to_reference")
    )
    pipeline_status = "SUCCESS_WITH_SAFETY_REVERT" if any_revert else "SUCCESS"
    report = {
        "pipeline_status": pipeline_status,
        "cache_hits": cache_hits,
        "pipeline": PIPELINE_NAME,
        "pipeline_version": PIPELINE_VERSION,
        "run_id": run_id,
        "started_at_utc": started_at,
        "completed_at_utc": utc_now_iso(),
        "architecture": (
            "group-isolated development/test -> privacy redaction -> structural sanitation -> reference baseline -> "
            "multi-partition corpus noise estimation -> discriminative signal protection -> noise-policy ablation -> "
            "representation profile search -> word/character TF-IDF -> TruncatedSVD/LSA -> near-duplicate family control -> "
            "direct HDBSCAN plus UMAP/HDBSCAN family search -> perturbation stability -> recursive refinement -> "
            "statistically supported merge -> conservative outlier recovery -> BM25-inspired c-TF-IDF plus regularized log-odds descriptors -> "
            "structural and semantic guards -> locked-test transform only -> persisted inference and drift monitoring"
        ),
        "config": scrub_persisted_config(asdict(config)),
        "schema": schema,
        "runtime_versions": package_versions(),
        "split_audit": split_audit,
        "dataset": {
            "rows": len(frame),
            "user_rows": int((frame["_role"] == "user").sum()),
            "assistant_rows": int((frame["_role"] == "assistant").sum()),
            "development_rows": int((frame["data_split"] == "development").sum()),
            "locked_test_rows": int((frame["data_split"] == "locked_test").sum()),
        },
        "customer": customer_result["summary"],
        "customer_export_privacy_audit": customer_export,
        "assistant": assistant_result["summary"] if assistant_result else {
            "status": "skipped", "reason": assistant_skip_reason,
        },
        "assistant_export_privacy_audit": assistant_export,
        "governance": {
            "cluster_labels": "unsupervised candidate groups, not supervised ground truth",
            "noise_terms": "development-corpus statistical background/template terms with explicit signal protection",
            "locked_test": (
                "never used to fit noise terms, signal protection, noise policy, representation profile, duplicate cutoff, "
                "vocabulary, SVD, UMAP, clustering, merge, recovery boundaries, or semantic guard"
            ),
            "privacy": (
                "raw input text and raw business identifiers are not exported; row-level text is omitted by default"
            ),
            "pseudonym_key_source": pseudonym_key_source,
        },
    }

    stage_metrics = pd.DataFrame(stage_rows)
    report["stage_metrics"] = stage_metrics.to_dict(orient="records")
    report_path = outdir / config.report_json
    report_path.write_text(json.dumps(to_plain(report), indent=2), encoding="utf-8")
    report_sha256 = sha256_file(report_path)

    save_quality_card(report, outdir / "nora_phase2_quality_checks.png")
    summary_path = write_executive_summary(
        outdir, report, customer_result, assistant_result, stage_metrics, cache_hits
    )

    manifest = {
        "pipeline": PIPELINE_NAME,
        "version": PIPELINE_VERSION,
        "run_id": run_id,
        "created_at_utc": utc_now_iso(),
        "created_for_mode": "train",
        "artifact_format": ARTIFACT_FORMAT_VERSION,
        "runtime_versions": package_versions(),
        "artifacts": {
            "customer_model": customer_export.get("model_file"),
            "customer_model_sha256": customer_export.get("model_sha256"),
            "assistant_model": assistant_export.get("model_file") if assistant_export else None,
            "assistant_model_sha256": assistant_export.get("model_sha256") if assistant_export else None,
            "report": config.report_json,
            "report_sha256": report_sha256,
        },
        "privacy": {
            "review_text_exported": bool(config.export_review_text),
            "pseudonym_key_source": pseudonym_key_source,
            "pseudonym_secret_persisted": False,
        },
        "security_note": "Load persisted joblib artifacts only from the trusted model directory and verify SHA-256 before load.",
    }
    (outdir / "model_manifest.json").write_text(json.dumps(to_plain(manifest), indent=2), encoding="utf-8")

    LOGGER.info("[9/9] COMPLETE")
    LOGGER.info("output directory: %s", outdir.resolve())
    LOGGER.info("report: %s", report_path.resolve())
    LOGGER.info("summary: %s", summary_path.resolve())
    return report


def run_inference(config: Config) -> Dict[str, Any]:
    run_id = secrets.token_hex(8)
    started_at = utc_now_iso()
    outdir = Path(config.outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    model_dir = Path(config.model_dir or "")
    manifest_path = model_dir / "model_manifest.json"
    if not manifest_path.exists():
        raise FileNotFoundError(f"Model manifest not found: {manifest_path}")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("artifact_format") != ARTIFACT_FORMAT_VERSION:
        raise RuntimeError("Artifact format mismatch; retrain before inference.")
    artifacts = manifest.get("artifacts", {})

    customer_path = model_dir / (artifacts.get("customer_model") or "customer_model.joblib")
    if not customer_path.exists():
        raise FileNotFoundError(f"Customer model artifact not found: {customer_path}")
    customer_bundle = load_bundle(customer_path, artifacts.get("customer_model_sha256"))

    assistant_bundle: Optional[CorpusBundle] = None
    assistant_file = artifacts.get("assistant_model")
    if assistant_file and config.include_assistant:
        assistant_path = model_dir / assistant_file
        if assistant_path.exists():
            assistant_bundle = load_bundle(assistant_path, artifacts.get("assistant_model_sha256"))

    frame, schema = load_and_prepare(config)
    pseudonym_key, pseudonym_key_source = resolve_pseudonym_key(config)
    outputs: List[pd.DataFrame] = []
    drift: Dict[str, Any] = {}

    def build_safe_output(source: pd.DataFrame, detail: Dict[str, Any], corpus: str, unit_index: Optional[pd.Series] = None) -> pd.DataFrame:
        safe = pd.DataFrame({
            "row_id": source["_row_id"].astype(int),
            "case_ref": source["_case"].map(lambda x: pseudonymize(x, pseudonym_key)),
            "conversation_ref": source["_conversation"].map(lambda x: pseudonymize(x, pseudonym_key)),
            "cluster_id": detail["labels"],
            "native_cluster_strength": detail["native_strengths"],
            "assignment_source": detail["assignment_source"],
            "recovery_similarity": detail["recovery_similarity"],
            "recovery_margin": detail["recovery_margin"],
            "cluster_descriptor": detail["descriptors"],
            "corpus": corpus,
        })
        if unit_index is not None:
            safe["unit_index"] = unit_index.astype(int).values
        if config.export_review_text:
            safe["redacted_text"] = detail["redacted"]
        return safe

    def drift_payload(bundle: CorpusBundle, detail: Dict[str, Any]) -> Dict[str, Any]:
        labels = np.asarray(detail["labels"], dtype=int)
        strengths = np.asarray(detail["native_strengths"], dtype=float)
        sources = np.asarray(detail["assignment_source"], dtype=object)
        native = sources != "recovered_outlier"
        return {
            "cluster_js_distance": cluster_js_distance(
                bundle.reference_cluster_distribution, cluster_distribution(labels)
            ),
            "reference_outlier_rate": bundle.reference_outlier_rate,
            "observed_outlier_rate": float(np.mean(labels == -1)) if len(labels) else 0.0,
            "reference_recovery_rate": bundle.reference_recovery_rate,
            "observed_recovery_rate": float(np.mean(sources == "recovered_outlier")) if len(sources) else 0.0,
            "reference_native_strength_quantiles": bundle.reference_strength_quantiles,
            "observed_native_strength_quantiles": strength_quantiles(strengths[native]) if native.any() else {},
            "noise_policy": bundle.noise_policy,
            "representation_profile": bundle.latent_model.profile,
            "cluster_method": bundle.cluster_model.method,
        }

    customer = frame[frame["_role"].eq("user")].copy().reset_index(drop=True)
    if len(customer):
        detail = customer_bundle.transform_texts_detailed(customer["_text"].tolist())
        outputs.append(build_safe_output(customer, detail, "customer"))
        drift["customer"] = drift_payload(customer_bundle, detail)

    if assistant_bundle is not None:
        units = build_assistant_units(frame.assign(data_split="inference"), config)
        if len(units):
            detail = assistant_bundle.transform_texts_detailed(units["assistant_unit"].tolist())
            outputs.append(build_safe_output(units, detail, "assistant", units["unit_index"]))
            drift["assistant"] = drift_payload(assistant_bundle, detail)

    combined = pd.concat(outputs, ignore_index=True) if outputs else pd.DataFrame()
    inference_path = outdir / "nora_phase2_inference.csv"
    pii_scan = {name: 0 for name, _ in PII_PATTERNS}
    if not combined.empty:
        scan_cols = ["cluster_descriptor"] + (["redacted_text"] if config.export_review_text else [])
        pii_scan = residual_pii_counts(combined, scan_cols)
        if any(v > 0 for v in pii_scan.values()):
            raise RuntimeError(f"Privacy guard blocked inference export; residual counts={pii_scan}")
        combined.to_csv(inference_path, index=False)

    report = {
        "pipeline": PIPELINE_NAME,
        "pipeline_version": PIPELINE_VERSION,
        "run_id": run_id,
        "started_at_utc": started_at,
        "completed_at_utc": utc_now_iso(),
        "mode": "infer",
        "input_rows": len(frame),
        "output_rows": len(combined),
        "schema": schema,
        "runtime_versions": package_versions(),
        "artifact_manifest_verified": True,
        "privacy": {
            "review_text_exported": bool(config.export_review_text),
            "residual_pattern_scan": pii_scan,
            "pseudonym_key_source": pseudonym_key_source,
        },
        "drift": drift,
    }
    (outdir / "nora_phase2_inference_report.json").write_text(
        json.dumps(to_plain(report), indent=2), encoding="utf-8"
    )
    LOGGER.info("Inference complete: %d output rows", len(combined))
    return report


