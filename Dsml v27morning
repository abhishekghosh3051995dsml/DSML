        "descriptions": {int(k): v for k, v in bundle.descriptions.items()},
        "reference_cluster_distribution": {int(k): float(v) for k, v in bundle.reference_cluster_distribution.items()},
        "reference_outlier_rate": float(bundle.reference_outlier_rate),
        "reference_strength_quantiles": {str(k): float(v) for k, v in bundle.reference_strength_quantiles.items()},
        "reference_recovery_rate": float(bundle.reference_recovery_rate),
    }


def payload_to_bundle(payload: Dict[str, Any]) -> CorpusBundle:
    if payload.get("format_version") != ARTIFACT_FORMAT_VERSION:
        raise RuntimeError("Artifact format mismatch; retrain before inference.")
    noise = payload["noise_model"]
    latent = payload["latent_model"]
    return CorpusBundle(
        pipeline_name=str(payload["pipeline_name"]),
        pipeline_version=str(payload["pipeline_version"]),
        corpus_name=str(payload["corpus_name"]),
        noise_model=NoiseModel(
            unigrams=set(noise.get("unigrams", [])),
            template_phrases=set(noise.get("template_phrases", [])),
            descriptor_blocklist=set(noise.get("descriptor_blocklist", [])),
            protected_phrases=set(noise.get("protected_phrases", [])),
            protected_unigrams=set(noise.get("protected_unigrams", [])),
            structural_terms=set(noise.get("structural_terms", [])),
            score_threshold=float(noise.get("score_threshold", 0.0)),
            selection_method=str(noise.get("selection_method", "unknown")),
        ),
        noise_policy=str(payload.get("noise_policy", "raw")),
        latent_model=LatentModel(
            vectorizer=latent["vectorizer"],
            svd=latent["svd"],
            normalizer=latent["normalizer"],
            batch_size=int(latent.get("batch_size", 4096)),
            profile=dict(latent.get("profile", {})),
        ),
        cluster_model=cluster_model_from_payload(payload["cluster_model"]),
        refinement_rules=[
            RefinementRule(
                parent_cluster=int(rule["parent_cluster"]),
                model=cluster_model_from_payload(rule["model"]),
                child_id_map={int(k): int(v) for k, v in rule["child_id_map"].items()},
                depth=int(rule["depth"]),
            )
            for rule in payload.get("refinement_rules", [])
        ],
        merge_map={int(k): int(v) for k, v in payload.get("merge_map", {}).items()},
        outlier_recovery_model=recovery_from_payload(payload.get("outlier_recovery_model")),
        descriptions={int(k): v for k, v in payload.get("descriptions", {}).items()},
        model_text_mode=str(payload.get("model_text_mode", "raw_redacted")),
        reference_cluster_distribution={int(k): float(v) for k, v in payload.get("reference_cluster_distribution", {}).items()},
        reference_outlier_rate=float(payload.get("reference_outlier_rate", 0.0)),
        reference_strength_quantiles={str(k): float(v) for k, v in payload.get("reference_strength_quantiles", {}).items()},
        reference_recovery_rate=float(payload.get("reference_recovery_rate", 0.0)),
        config=dict(payload.get("config", {})),
    )


def validate_runtime_compatibility(payload: Dict[str, Any]) -> None:
    trained = payload.get("runtime_versions", {})
    current = package_versions()
    a = str(trained.get("scikit_learn", ""))
    b = str(current.get("scikit_learn", ""))
    if a and b and a.split(".")[:2] != b.split(".")[:2]:
        raise RuntimeError(f"scikit-learn runtime mismatch: trained={a}, current={b}")


def load_bundle(path: Path, expected_sha256: Optional[str] = None) -> CorpusBundle:
    if expected_sha256 and sha256_file(path) != expected_sha256:
        raise RuntimeError(f"Artifact checksum mismatch for {path.name}")
    payload = joblib.load(path)
    if not isinstance(payload, dict):
        raise RuntimeError("Unsupported artifact type")
    validate_runtime_compatibility(payload)
    return payload_to_bundle(payload)

