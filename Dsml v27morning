def cohesion_gain_bootstrap(
    vectors: np.ndarray,
    parent_idx: np.ndarray,
    child_labels: np.ndarray,
    seed: int,
    repeats: int = 160,
) -> Tuple[float, float]:
    block = vectors[parent_idx]
    parent_centroid = block.mean(axis=0)
    norm = np.linalg.norm(parent_centroid)
    if norm > 0:
        parent_centroid /= norm
    parent_sim = block @ parent_centroid

    child_sim = np.zeros(len(block), dtype=float)
    for cid in sorted(set(int(x) for x in child_labels.tolist() if int(x) != -1)):
        local = np.flatnonzero(child_labels == cid)
        centroid = block[local].mean(axis=0)
        cnorm = np.linalg.norm(centroid)
        if cnorm > 0:
            centroid /= cnorm
        child_sim[local] = block[local] @ centroid
    assigned = child_labels != -1
    if assigned.sum() < 3:
        return 0.0, 0.0
    delta = child_sim[assigned] - parent_sim[assigned]
    rng = np.random.default_rng(seed)
    means = [float(np.mean(rng.choice(delta, size=len(delta), replace=True))) for _ in range(repeats)]
    return float(np.mean(delta)), float(np.quantile(means, 0.025))


def refine_clusters(
    vectors: np.ndarray,
    labels: np.ndarray,
    strengths: np.ndarray,
    config: Config,
) -> Tuple[np.ndarray, np.ndarray, pd.DataFrame, List[RefinementRule]]:
    labels = np.asarray(labels, dtype=int).copy()
    strengths = np.asarray(strengths, dtype=float).copy()
    audit: List[Dict[str, Any]] = []
    rules: List[RefinementRule] = []
    next_id = max([x for x in labels.tolist() if x >= 0], default=-1) + 1

    for depth in range(config.recursive_max_depth):
        ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
        if len(ids) < 2:
            break
        sizes = {cid: int(np.sum(labels == cid)) for cid in ids}
        cohesion = local_cluster_cohesion(vectors, labels)
        size_fence = robust_upper_fence(list(sizes.values()))
        cohesion_floor = robust_lower_fence(list(cohesion.values()))
        candidates = [cid for cid in ids if sizes[cid] > size_fence or cohesion[cid] < cohesion_floor]
        if not candidates:
            break

        any_split = False
        for cid in candidates:
            idx = np.flatnonzero(labels == cid)
            if len(idx) < max(12, int(round(math.sqrt(max(len(vectors), 16))))):
                audit.append({"depth": depth + 1, "parent_cluster": cid, "status": "skipped", "reason": "insufficient_support"})
                continue
            local_cfg = Config(**{
                **asdict(config),
                "model_search_trials": max(8, config.model_search_trials // 2),
                "stability_repeats": max(2, config.stability_repeats - 1),
                "recursive_max_depth": 0,
                "search_sample_rows": min(len(idx), config.search_sample_rows),
            })
            try:
                child_model, child_labels, child_strengths, child_search = fit_cluster_search(
                    vectors[idx], local_cfg, seed=config.seed + depth * 1009 + cid + 1
                )
            except Exception as exc:
                audit.append({"depth": depth + 1, "parent_cluster": cid, "status": "failed", "reason": str(exc)})
                continue
            child_ids = sorted(set(int(x) for x in child_labels.tolist() if int(x) != -1))
            if len(child_ids) < 2:
                audit.append({"depth": depth + 1, "parent_cluster": cid, "status": "rejected", "reason": "fewer_than_two_children"})
                continue
            mean_gain, lower_gain = cohesion_gain_bootstrap(vectors, idx, child_labels, config.seed + cid + 7717)
            child_sil = safe_silhouette(vectors[idx], child_labels, config.seed)
            child_balance = cluster_size_entropy(child_labels)
            largest_child = max(Counter(child_labels[child_labels != -1].tolist()).values()) / max(int(np.sum(child_labels != -1)), 1)
            stability = child_model.assigned_stability_ari
            search_stability = pd.to_numeric(child_search.get("assigned_ari", pd.Series(dtype=float)), errors="coerce").dropna()
            stability_floor = float(search_stability.median()) if len(search_stability) else -1.0
            accept = (
                lower_gain > 0.0
                and child_sil is not None and child_sil > 0.0
                and child_balance > 0.0
                and largest_child < 0.90
                and (stability is None or not np.isfinite(stability) or stability >= stability_floor)
            )
            audit.append({
                "depth": depth + 1,
                "parent_cluster": cid,
                "parent_size": len(idx),
                "child_clusters": len(child_ids),
                "cohesion_gain_mean": mean_gain,
                "cohesion_gain_bootstrap_lower_95": lower_gain,
                "child_silhouette": child_sil,
                "child_balance_entropy": child_balance,
                "largest_child_share": largest_child,
                "child_assigned_stability_ari": stability,
                "status": "accepted" if accept else "rejected",
            })
            if not accept:
                continue
            mapping = {child: next_id + pos for pos, child in enumerate(child_ids)}
            next_id += len(child_ids)
            rules.append(RefinementRule(
                parent_cluster=int(cid), model=child_model,
                child_id_map={int(k): int(v) for k, v in mapping.items()}, depth=depth + 1,
            ))
            for local_pos, global_pos in enumerate(idx.tolist()):
                child = int(child_labels[local_pos])
                if child == -1:
                    continue
                labels[global_pos] = mapping[child]
                strengths[global_pos] = float(child_strengths[local_pos])
            any_split = True
        if not any_split:
            break
    return labels, strengths, pd.DataFrame(audit), rules


def apply_merge_map(labels: np.ndarray, merge_map: Optional[Dict[int, int]] = None) -> np.ndarray:
    if not merge_map:
        return np.asarray(labels, dtype=int).copy()
    return np.asarray([
        -1 if int(label) == -1 else int(merge_map.get(int(label), int(label)))
        for label in np.asarray(labels, dtype=int).tolist()
    ], dtype=int)


def statistically_justified_merge(
    vectors: np.ndarray,
    labels: np.ndarray,
    config: Config,
) -> Tuple[np.ndarray, Dict[int, int], pd.DataFrame]:
    base = np.asarray(labels, dtype=int)
    if not config.merge_clusters:
        return base.copy(), {}, pd.DataFrame([{"status": "disabled"}])
    ids = sorted(set(int(x) for x in base.tolist() if int(x) != -1))
    if len(ids) < 3:
        return base.copy(), {}, pd.DataFrame([{"status": "not_required"}])

    centroids: Dict[int, np.ndarray] = {}
    cohesion = local_cluster_cohesion(vectors, base)
    for cid in ids:
        c = vectors[base == cid].mean(axis=0)
        norm = np.linalg.norm(c)
        centroids[cid] = c / norm if norm > 0 else c
    pairs: Dict[Tuple[int, int], float] = {}
    vals: List[float] = []
    for i, left in enumerate(ids):
        for right in ids[i + 1:]:
            sim = float(centroids[left] @ centroids[right])
            pairs[(left, right)] = sim
            vals.append(sim)
    threshold, method = distribution_upper_tail_cutoff(vals, config.seed + 4241)
    if method != "gmm_bic_two_component" or not np.isfinite(threshold):
        return base.copy(), {}, pd.DataFrame([{
            "status": "no_merge", "threshold_method": method,
            "merge_threshold": threshold,
            "reason": "no_supported_high_similarity_component",
        }])

    groups: List[set[int]] = [{cid} for cid in ids]
    audit: List[Dict[str, Any]] = []
    for sim, left, right in sorted([(v, a, b) for (a, b), v in pairs.items() if v >= threshold], reverse=True):
        gi = next((i for i, g in enumerate(groups) if left in g), None)
        gj = next((i for i, g in enumerate(groups) if right in g), None)
        if gi is None or gj is None or gi == gj:
            continue
        g1, g2 = groups[gi], groups[gj]
        cross = []
        for a in g1:
            for b in g2:
                key = (a, b) if a < b else (b, a)
                cross.append(pairs[key])
        complete_link_ok = bool(cross) and min(cross) >= threshold
        members = g1 | g2
        idx = np.flatnonzero(np.isin(base, list(members)))
        c = vectors[idx].mean(axis=0)
        norm = np.linalg.norm(c)
        if norm > 0:
            c /= norm
        merged_cohesion = float(np.mean(vectors[idx] @ c)) if len(idx) else float("nan")
        floor = min(cohesion.get(cid, -1.0) for cid in members)
        cohesion_ok = np.isfinite(merged_cohesion) and merged_cohesion >= floor
        accept = complete_link_ok and cohesion_ok
        audit.append({
            "status": "accepted" if accept else "rejected",
            "left_group": ";".join(map(str, sorted(g1))),
            "right_group": ";".join(map(str, sorted(g2))),
            "candidate_centroid_cosine": sim,
            "minimum_cross_centroid_cosine": min(cross) if cross else np.nan,
            "merge_threshold": threshold,
            "threshold_method": method,
            "merged_cohesion": merged_cohesion,
            "constituent_cohesion_floor": floor,
        })
        if accept:
            new_group = members
            for index in sorted((gi, gj), reverse=True):
                groups.pop(index)
            groups.append(new_group)

    merge_map: Dict[int, int] = {}
    for group in groups:
        canonical = min(group)
        for cid in group:
            if cid != canonical:
                merge_map[int(cid)] = int(canonical)
    return apply_merge_map(base, merge_map), merge_map, pd.DataFrame(audit)


def predict_with_refinements(
    base_model: ClusterModel,
    rules: Sequence[RefinementRule],
    vectors: np.ndarray,
    merge_map: Optional[Dict[int, int]] = None,
) -> Tuple[np.ndarray, np.ndarray]:
    labels, strengths = predict_cluster(base_model, vectors)
    labels = labels.astype(int)
    strengths = strengths.astype(float)
    for rule in rules:
        idx = np.flatnonzero(labels == int(rule.parent_cluster))
        if len(idx) == 0:
            continue
        child_labels, child_strengths = predict_cluster(rule.model, vectors[idx])
        for local_pos, global_pos in enumerate(idx.tolist()):
            mapped = rule.child_id_map.get(int(child_labels[local_pos]))
            if mapped is not None:
                labels[global_pos] = int(mapped)
                strengths[global_pos] = float(child_strengths[local_pos])
    return apply_merge_map(labels, merge_map), strengths


def fit_outlier_recovery_model(
    vectors: np.ndarray,
    labels: np.ndarray,
    config: Config,
) -> Tuple[Optional[OutlierRecoveryModel], pd.DataFrame]:
    labels = np.asarray(labels, dtype=int)
    ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if not config.reassign_outliers or len(ids) < 2:
        return None, pd.DataFrame([{"status": "disabled_or_unavailable"}])
    centroids = []
    for cid in ids:
        c = vectors[labels == cid].mean(axis=0)
        norm = np.linalg.norm(c)
        centroids.append(c / norm if norm > 0 else c)
    matrix = np.vstack(centroids).astype(np.float32)
    similarities = np.asarray(vectors @ matrix.T, dtype=float)
    sim_floors: Dict[int, float] = {}
    margin_floors: Dict[int, float] = {}
    rows: List[Dict[str, Any]] = []
    for col, cid in enumerate(ids):
        idx = np.flatnonzero(labels == cid)
        own = similarities[idx, col]
        other = np.delete(similarities[idx], col, axis=1)
        second = np.max(other, axis=1) if other.shape[1] else np.full(len(idx), -1.0)
        margin = own - second
        sim_floor, sim_method = distribution_lower_tail_cutoff(own, config.seed + 4001 + cid)
        margin_floor, margin_method = distribution_lower_tail_cutoff(margin, config.seed + 7001 + cid)
        sim_floors[cid] = float(np.clip(sim_floor, -1.0, 1.0)) if np.isfinite(sim_floor) else float("inf")
        margin_floors[cid] = float(np.clip(margin_floor, -2.0, 2.0)) if np.isfinite(margin_floor) else float("inf")
        rows.append({
            "cluster_id": cid,
            "assigned_members": len(idx),
            "similarity_floor": sim_floors[cid],
            "similarity_floor_method": sim_method,
            "margin_floor": margin_floors[cid],
            "margin_floor_method": margin_method,
        })
    return OutlierRecoveryModel(
        cluster_ids=np.asarray(ids, dtype=int),
        centroids=matrix,
        similarity_floors=sim_floors,
        margin_floors=margin_floors,
        fit_rows=int(np.sum(labels != -1)),
        enabled=True,
    ), pd.DataFrame(rows)


def apply_outlier_recovery_model(
    vectors: np.ndarray,
    labels: np.ndarray,
    strengths: np.ndarray,
    model: Optional[OutlierRecoveryModel],
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    labels = np.asarray(labels, dtype=int).copy()
    strengths = np.asarray(strengths, dtype=float).copy()
    source = np.asarray(["native" if int(x) != -1 else "outlier" for x in labels], dtype=object)
    rec_sim = np.full(len(labels), np.nan, dtype=float)
    rec_margin = np.full(len(labels), np.nan, dtype=float)
    if model is None or not model.enabled or len(model.cluster_ids) < 2:
        return labels, strengths, source, rec_sim, rec_margin
    outliers = np.flatnonzero(labels == -1)
    if len(outliers) == 0:
        return labels, strengths, source, rec_sim, rec_margin
    sims = np.asarray(vectors[outliers] @ model.centroids.T, dtype=float)
    order = np.argsort(sims, axis=1)
    best_pos = order[:, -1]
    second_pos = order[:, -2]
    best = sims[np.arange(len(outliers)), best_pos]
    second = sims[np.arange(len(outliers)), second_pos]
    margin = best - second
    for local, row in enumerate(outliers.tolist()):
        cid = int(model.cluster_ids[int(best_pos[local])])
        rec_sim[row] = float(best[local])
        rec_margin[row] = float(margin[local])
        if best[local] >= model.similarity_floors.get(cid, float("inf")) and margin[local] >= model.margin_floors.get(cid, float("inf")):
            labels[row] = cid
            source[row] = "recovered_outlier"
    return labels, strengths, source, rec_sim, rec_margin


def predict_final_partition(
    base_model: ClusterModel,
    rules: Sequence[RefinementRule],
    vectors: np.ndarray,
    merge_map: Optional[Dict[int, int]],
    recovery_model: Optional[OutlierRecoveryModel],
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    labels, strengths = predict_with_refinements(base_model, rules, vectors, merge_map)
    return apply_outlier_recovery_model(vectors, labels, strengths, recovery_model)


