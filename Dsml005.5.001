("email",re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b")),("url",re.compile(r"https?://\S+",re.I)),
("ipv4",re.compile(r"\b(?:(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\.){3}(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\b")),
("mac",re.compile(r"\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b")),("uuid",re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b")),
("iccid",re.compile(r"\b89\d{17,20}\b")),("imei",re.compile(r"\b\d{14,17}\b")),("phone",re.compile(r"(?<!\d)(?:\+?\d{1,3}[\s\-.]?)?\(?\d{3}\)?[\s\-.]?\d{3}[\s\-.]?\d{4}(?!\d)")),
("coordinate",re.compile(r"\b(?:lat(?:itude)?|lon(?:gitude)?)\s*[:=]?\s*-?\d{1,3}(?:\.\d+)?\b",re.I)),("zip",re.compile(r"(?<!\d)\d{5}(?:-\d{4})?(?!\d)")),("long_number",re.compile(r"(?<!\d)\d{7,}(?!\d)")))
STREET_ADDRESS_RE=re.compile(r"(?i)\b\d{1,6}\s+(?:[A-Za-z0-9.'\-]+\s+){0,5}(?:street|st|road|rd|avenue|ave|boulevard|blvd|lane|ln|drive|dr|court|ct|way|parkway|pkwy|highway|hwy)\b(?:\s+(?:apt|unit|suite|#)\s*[A-Za-z0-9\-]+)?")
