    internal_entities=sum(len(r.get("entities",[])) for r in records);internal_candidates=sum(len(r.get("entity_candidates",[])) for r in records);internal_context=sum(len(r.get("context",[])) for r in records);internal_participants=sum(len(r.get("participant_evidence",[])) for r in records);counts={"interactions":len(records),"clusterable_customer_interactions":len(clusterable),"fine_semantic_clusters":len(set(fine_labels.tolist())),"hierarchical_leaf_clusters":len(set(leaf_ids.tolist())),"macro_semantic_clusters":len(set(macro_labels.tolist())),"assigned_customer_interactions":len(clusterable),"customer_outliers":0,"fine_assignment_coverage_pct":100.0 if clusterable else 0.0,"workflow_clusters":len(set(workflow_labels.tolist())),"entity_profile_clusters":len(set(entity_labels.tolist())),"relation_motif_clusters":len(set(relation_labels.tolist())),"participant_mentions":internal_participants,"entities":internal_entities,"entity_review_candidates":internal_candidates,"context_records":internal_context,"attributes":sum(len(r.get("attributes",[])) for r in records),"measurements":sum(len(r.get("measurements",[])) for r in records),"diagnostic_evidence":sum(len(r.get("diagnostic_evidence",[])) for r in records),"root_cause_records":sum(len(r.get("root_cause",[])) for r in records),"remediation_records":sum(len(r.get("remediation",[])) for r in records),"relationships":sum(len(r.get("relationships",[])) for r in records),"latent_topics":int(len(topic_catalog_df)) if not topic_catalog_df.empty else 0}
    quality={"validation":selection_val_metrics,"locked_test":test_metrics,"all_clusterable":all_metrics,"fine_selected_k":selected_k,"fine_model_search_best":to_plain(best),"fine_partition_consensus_stability":overall_stability,"fine_cluster_stability":fine_stability,"analytics_metrics":analytics_metrics,"intent_alignment":intent_metrics}
    report={"pipeline":PIPELINE_NAME,"pipeline_version":PIPELINE_VERSION,"execution_status":"SUCCESS","statistical_validation_status":stat_status,"analytics_readiness_status":analytics_status,"business_readiness_status":analytics_status,"privacy_review_status":privacy_summary.get("residual_gate_status"),"started_at_utc":started,"completed_at_utc":utc_now_iso(),"external_pretrained_models_used":False,"representation":"precision-filtered word/char/structure-signature TF-IDF + LSA + NMF + local PPMI/SVD/SIF + stability-gated hierarchical semantic and structural lenses","schema":schema,"split_audit":split_audit,"counts":counts,"quality":quality,"privacy":{**privacy_summary,"pseudonym_key_source":key_source,"public_text_suppressed":not public_examples_safe},"cluster_id_contract":{"fine_first_cluster_id":1,"unknown_id":-1,"unknown_reserved_for_non_clusterable_only":True},"dictionary_contract":{"layers":["participants","entities","context","resolution","relations","analysis"]},"stage_metrics":stages}
    rp=outdir/"nora_entity_context_v5_5_report.json";rp.write_text(json.dumps(to_plain(report),indent=2,ensure_ascii=False),encoding="utf-8");pd.DataFrame(stages).to_csv(outdir/"stage_metrics.csv",index=False);html=write_html_summary_v55(outdir,report,fine_catalog,macro_catalog,leaf_catalog,workflow_catalog,entity_profile_catalog,relation_motif_catalog,ps,es,cts,rs,relation_summary_df,stat_gate,analytics_gate,fine_sim,subaudit,fingerprint_summary,public_examples_safe)
