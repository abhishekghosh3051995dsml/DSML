@dataclass
class PipelineBundle: pipeline_name:str; pipeline_version:str; ontology:List[Dict[str,Any]]; stopwords:List[str]; problem_normalizer:ProblemNormalizerModel; representation:RepresentationModel; cluster_model:ClusterModel; cluster_descriptions:Dict[int,Dict[str,Any]]; config:Dict[str,Any]

def utc_now_iso(): return datetime.now(timezone.utc).isoformat()
def configure_logging(): logging.basicConfig(level=logging.INFO,format="%(asctime)s | %(levelname)s | %(message)s",datefmt="%H:%M:%S")
def normalize_space(v): return re.sub(r"\s+"," ",str(v or "")).strip()
def tokenize(v): return [m.group(0).lower().strip(".") for m in TOKEN_RE.finditer(str(v or ""))]
def normalize_term(v): return " ".join(tokenize(v))
def normalise_key(v): return re.sub(r"[^a-z0-9]+","_",str(v or "").strip().lower()).strip("_")
def safe_float(v,d=0.0):
    try: x=float(v); return x if np.isfinite(x) else d
    except Exception: return d
def to_plain(v):
    if v is None:return None
    if isinstance(v,dict):return {str(k):to_plain(x) for k,x in v.items()}
    if isinstance(v,(list,tuple,set)):return [to_plain(x) for x in v]
    if isinstance(v,np.ndarray):return [to_plain(x) for x in v.tolist()]
    if isinstance(v,np.integer):return int(v)
    if isinstance(v,np.floating):return None if not np.isfinite(v) else float(v)
    try:
        if pd.isna(v):return None
    except Exception:pass
    return v
def sha256_file(path,chunk_size=1024*1024):
    h=hashlib.sha256()
    with Path(path).open("rb") as f:
        for b in iter(lambda:f.read(chunk_size),b""):h.update(b)
    return h.hexdigest()
def current_code_fingerprint():
    try:return sha256_file(Path(__file__).resolve())
    except Exception:return hashlib.sha256(f"{PIPELINE_NAME}:{PIPELINE_VERSION}".encode()).hexdigest()
def package_versions():
    out={"python":platform.python_version(),"numpy":np.__version__,"pandas":pd.__version__,"joblib":str(getattr(joblib,"__version__","installed"))}
    try:
        import sklearn;out["scikit_learn"]=sklearn.__version__
    except Exception:pass
    try:
        import scipy;out["scipy"]=scipy.__version__
    except Exception:pass
    return out
def dedupe_dicts(rows,keys,score_key="evidence_strength"):
    best={}
    for row in rows:
        item=dict(row);k=tuple(str(item.get(x,"")) for x in keys)
        if k not in best or safe_float(item.get(score_key))>safe_float(best[k].get(score_key)):best[k]=item
    return list(best.values())
def resolve_pseudonym_key(c):
    raw=os.environ.get(c.pseudonym_key_env,"") if c.pseudonym_key_env else ""
    if raw:return hashlib.sha256(raw.encode()).digest(),f"environment:{c.pseudonym_key_env}"
    if c.profile=="production":raise RuntimeError(f"Production profile requires environment variable {c.pseudonym_key_env}.")
    return hashlib.sha256(f"{PIPELINE_VERSION}|{c.seed}|development-only".encode()).digest(),"deterministic_development_key"
def pseudonymize(v,key): return hashlib.blake2b(str(v or "").encode("utf-8",errors="ignore"),key=key,digest_size=12).hexdigest()
def sanitize_html(text):
    v=html_lib.unescape(str(text or ""));v=SCRIPT_STYLE_RE.sub(" ",v);v=HTML_TAG_RE.sub(" ",v);v=CSS_FRAGMENT_RE.sub(" ",v);return normalize_space(v)
def normalize_linguistic_text(text):
    v=PII_PLACEHOLDER_RE.sub(" ",str(text or ""));subs=[(r"(?i)\bcan't\b|\bcant\b","cannot"),(r"(?i)\bwon't\b","will not"),(r"(?i)\bdoesn't\b","does not"),(r"(?i)\bisn't\b","is not"),(r"(?i)\baren't\b","are not"),(r"(?i)\bnot able to\b","unable to")]
    for p,r in subs:v=re.sub(p,r,v)
    return normalize_space(re.sub(r"\bN/?A\b"," ",v,flags=re.I))
def adaptive_min_df(n): return 1 if n<20 else max(2,min(8,int(round(math.log2(max(n,4))/2))))
def percentile_rank(s,higher=True):
    x=pd.to_numeric(s,errors="coerce");return pd.Series(np.full(len(s),.5),index=s.index) if x.notna().sum()<=1 else x.rank(pct=True,ascending=True if higher else False).fillna(0.0)

def _apply_matches(value,matches):
    merged=[]
    for s,e,label in sorted(matches,key=lambda x:(x[0],-(x[1]-x[0]))):
        if e<=s:continue
        if merged and s<merged[-1][1]:
            ps,pe,pl=merged[-1]
            if e>pe:merged[-1]=(ps,e,pl)
            continue
        merged.append((s,e,label))
    out=value
    for s,e,label in reversed(merged):out=out[:s]+f" [REDACTED_{label.upper()}] "+out[e:]
    return normalize_space(out)
def deterministic_pii_redact(text):
    v=sanitize_html(text);findings=[];spans=[]
    for name,p in PII_PATTERNS:
        for m in p.finditer(v):spans.append((m.start(),m.end(),name));findings.append({"type":name,"source":"regex"})
    for name,p,grp in (("address",STREET_ADDRESS_RE,None),("person",TEMPLATE_PERSON_RE,"name"),("person",LABELED_PERSON_RE,"name"),("sensitive_field",SENSITIVE_FIELD_RE,1)):
        for m in p.finditer(v):
            s,e=m.span(grp) if grp else m.span();spans.append((s,e,name));findings.append({"type":name,"source":"context_pattern"})
    return _apply_matches(v,spans),findings

def residual_pii_findings(text):
    """Residual privacy scan with severity.

    Deterministic identifiers/address residue are HARD. Ambiguous proper names are
    SOFT review findings: they are useful to inspect but must not fail the
    analytics pipeline by themselves.
    """
    v=str(text or "");rows=[]
    for name,p in PII_PATTERNS:
        for m in p.finditer(v):
            rows.append({"type":name,"text":m.group(0)[:80],"source":"regex_residual","severity":"HARD"})
    for m in STREET_ADDRESS_RE.finditer(v):
        rows.append({"type":"address","text":m.group(0)[:100],"source":"address_residual","severity":"HARD"})
    for m in TEMPLATE_PERSON_RE.finditer(v):
        rows.append({"type":"person","text":m.group("name")[:80],"source":"template_person_residual","severity":"SOFT"})
    for m in PROPER_NAME_RESIDUAL_RE.finditer(v):
        phrase=normalize_space(m.group(0))
        if phrase not in PROPER_NAME_SAFE and not phrase.startswith("REDACTED") and not CALL_CENTER_RE.search(phrase):
            rows.append({"type":"possible_person_or_location","text":phrase[:80],"source":"proper_name_residual","severity":"SOFT"})
    return rows

def public_safe_phrase(text):
    """Return a display-safe phrase while preserving useful telecom semantics.

    HARD identifiers are already redacted upstream. Ambiguous title-case names or
    locations are masked only in public examples; this avoids suppressing an
    entire entity/context table because of a soft privacy review finding.
    """
    v=str(text or "")
    spans=[]
    for m in TEMPLATE_PERSON_RE.finditer(v):
        spans.append((*m.span("name"),"NAME_OR_LOCATION"))
    for m in PROPER_NAME_RESIDUAL_RE.finditer(v):
        phrase=normalize_space(m.group(0))
        if phrase not in PROPER_NAME_SAFE and not phrase.startswith("REDACTED") and not CALL_CENTER_RE.search(phrase):
            spans.append((m.start(),m.end(),"NAME_OR_LOCATION"))
    return _apply_matches(v,spans) if spans else normalize_space(v)

def privacy_prepare_frame(frame):
    out=frame.copy();red=[];all_find=[];res=[]
    for idx,raw in zip(out.index.tolist(),out["_raw_text"].astype(str).tolist()):
        text,find=deterministic_pii_redact(raw);red.append(text)
        all_find.extend({"row_index":idx,**x} for x in find)
        res.extend({"row_index":idx,**x} for x in residual_pii_findings(text))
    out["_redacted_text"]=red;out["_sanitized_text"]=out["_redacted_text"].map(sanitize_html)
    residual=pd.DataFrame(res)
    if residual.empty:
        hard=soft=0;status="PASS"
    else:
        hard=int((residual["severity"].astype(str)=="HARD").sum())
        soft=int((residual["severity"].astype(str)=="SOFT").sum())
        status="FAIL" if hard else "WARN"
    summary={
        "rows":len(out),
        "redaction_findings":len(all_find),
        "residual_findings":len(res),
        "hard_residual_findings":hard,
        "soft_residual_findings":soft,
        "residual_gate_status":status,
        "public_examples_safe":bool(hard==0 and soft==0),
        "model_persistence_safe":bool(hard==0),
        "external_pretrained_model_used":False,
    }
    return out,summary,residual

def find_column(cols,patterns):
    norm={c:normalise_key(c) for c in cols}
    for p in patterns:
        for c,k in norm.items():
            if re.search(p,k):return c
    return None
def discover_schema(df):
    c=list(df.columns);return {"case":find_column(c,[r"^source_row$",r"source.*row",r"case.*id",r"ticket.*id"]),"turn":find_column(c,[r"message_index",r"turn.*index",r"sequence",r"^index$"]),"conversation":find_column(c,[r"message.*cid",r"^cid$",r"conversation.*id",r"interaction.*id"]),"text":find_column(c,[r"message.*content",r"^content$",r"^text$",r"message.*text"]),"upstream_label":find_column(c,[r"classification.*intent",r"upstream.*label",r"^intent$"]),"role":find_column(c,[r"^message_type$",r"message.*type",r"^role$"])}
def infer_role(row,role_col):
    vals=[]
    if role_col and role_col in row.index:vals.append(str(row.get(role_col,"")))
    for col in row.index:
        k=normalise_key(col)
        if "role" in k or k.endswith("type"):vals.append(str(row.get(col,"")))
    j=" ".join(vals).lower();raw=" | ".join(vals)
    if re.search(r"\b(user|customer|human|subscriber)\b",j):return "customer",raw
    if re.search(r"\b(assistant|agent|bot)\b",j):return "assistant",raw
    if re.search(r"\b(tool|function|evidence|system)\b",j):return "evidence",raw
    return "unknown",raw
def group_preserving_sample(f,target,seed):
    if target<=0 or len(f)<=target:return f.copy()
    s=f.groupby("_group",sort=False).size().reset_index(name="rows");rng=np.random.default_rng(seed);sel=[];running=0
    for pos in rng.permutation(len(s)).tolist():
        g,size=str(s.at[pos,"_group"]),int(s.at[pos,"rows"])
        if not sel or abs(target-(running+size))<=abs(target-running):sel.append(g);running+=size
        elif running>=target:break
    return f[f["_group"].isin(set(sel))].copy().reset_index(drop=True)
def load_raw_frame(c):
    p=Path(c.input_path)
    if not p.exists():raise FileNotFoundError(f"Input CSV not found: {p}")
    df=pd.read_csv(p,low_memory=False);s=discover_schema(df)
    if not s["text"]:raise ValueError("Unable to discover message text column.")
    f=df.copy().reset_index(drop=True);f["_row_id"]=np.arange(len(f),dtype=int);f["_raw_text"]=f[s["text"]].fillna("").astype(str);roles=f.apply(lambda r:infer_role(r,s["role"]),axis=1);f["_role"]=[x[0] for x in roles];f["_role_source"]=[x[1] for x in roles];f["_case"]=f[s["case"]].fillna("").astype(str) if s["case"] else "row_"+f["_row_id"].astype(str);f["_conversation"]=f[s["conversation"]].fillna("").astype(str) if s["conversation"] else f["_case"];f["_group"]=f["_conversation"].where(f["_conversation"].str.len()>0,f["_case"]);f["_group"]=f["_group"].where(f["_group"].str.len()>0,"row_"+f["_row_id"].astype(str));f["_upstream_label"]=f[s["upstream_label"]].fillna("").astype(str) if s["upstream_label"] else ""
    if c.sample_rows>0:f=group_preserving_sample(f,c.sample_rows,c.seed);f["_row_id"]=np.arange(len(f),dtype=int)
    LOGGER.info("rows=%d customer=%d assistant=%d evidence=%d unknown=%d",len(f),int((f["_role"]=="customer").sum()),int((f["_role"]=="assistant").sum()),int((f["_role"]=="evidence").sum()),int((f["_role"]=="unknown").sum()));return f,s
def _choose_group_subset(f,groups,ratio,seed,trials):
    s=f[f["_group"].isin(set(groups))].groupby("_group",sort=False).size().reset_index(name="rows");total=int(s["rows"].sum());target=int(round(total*ratio));best=None
    for trial in range(max(8,trials)):
        rng=np.random.default_rng(seed+trial*10007);chosen=[];running=0
        for pos in rng.permutation(len(s)).tolist():
            size=int(s.at[pos,"rows"])
            if not chosen or abs(target-(running+size))<=abs(target-running):chosen.append(pos);running+=size
            elif running>=target:break
        selected=set(s.loc[chosen,"_group"].astype(str));score=abs(running/max(total,1)-ratio)
        if best is None or score<best[0]:best=(score,selected)
    if best is None:raise RuntimeError("Unable to construct grouped split.")
    return best[1]
def assign_splits(f,c):
    out=f.copy();groups=sorted(out["_group"].astype(str).unique())
    if len(groups)<5:raise RuntimeError("Too few interaction groups for train/validation/locked-test split.")
    test=_choose_group_subset(out,groups,c.test_size,c.seed+11,c.split_trials);dev=[g for g in groups if g not in test];val=_choose_group_subset(out[out["_group"].isin(dev)],dev,c.validation_within_development,c.seed+29,c.split_trials);out["data_split"]="train";out.loc[out["_group"].isin(val),"data_split"]="validation";out.loc[out["_group"].isin(test),"data_split"]="locked_test";gs={s:set(out.loc[out["data_split"]==s,"_group"].astype(str)) for s in ("train","validation","locked_test")};overlap=len(gs["train"]&gs["validation"])+len(gs["train"]&gs["locked_test"])+len(gs["validation"]&gs["locked_test"])
    if overlap:raise AssertionError("Grouped split leakage detected.")
    return out,{"group_overlap_count":overlap,"rows":{s:int((out["data_split"]==s).sum()) for s in gs},"groups":{s:len(v) for s,v in gs.items()},"outer_locked_test_target":c.test_size,"validation_within_development_target":c.validation_within_development}
def aggregate_interactions(frame,key):
    rows=[]
    for group,b in frame.groupby("_group",sort=False):
        text=lambda role:normalize_space(" ".join(b.loc[b["_role"]==role,"_sanitized_text"].astype(str).tolist()))
        rows.append({"_group":str(group),"interaction_ref":pseudonymize(group,key),"data_split":str(b["data_split"].iloc[0]),"customer_text":text("customer"),"assistant_text":text("assistant"),"evidence_text":text("evidence"),"unknown_text":text("unknown"),"message_count":int(len(b)),"upstream_labels_passthrough":dict(Counter(x for x in b["_upstream_label"].astype(str) if x)),"row_refs":b["_row_ref"].astype(str).tolist()})
    return pd.DataFrame(rows)

# ---------------------------------------------------------------------------
# Controlled ontology, participants, problem normalization and extraction
# ---------------------------------------------------------------------------

def load_stopword_seed(path:Optional[str])->set[str]:
    terms=set(BACKGROUND_TERMS)|set(STRUCTURAL_TOKENS)
    if not path:return terms
    p=Path(path)
    if not p.exists():raise FileNotFoundError(f"Stopword seed file not found: {p}")
    if p.suffix.lower()==".csv":
        d=pd.read_csv(p);col="term" if "term" in d.columns else str(d.columns[0]);vals=d[col].dropna().astype(str).tolist()
    else:vals=[x.strip() for x in p.read_text(encoding="utf-8").splitlines() if x.strip()]
    terms.update(normalize_term(x) for x in vals if normalize_term(x));return terms

def load_ontology(path:Optional[str])->List[OntologyEntry]:
    if not path:return []
    p=Path(path)
    if not p.exists():raise FileNotFoundError(f"Ontology file not found: {p}")
    if p.suffix.lower()==".csv":rows=pd.read_csv(p).fillna("").to_dict("records")
    elif p.suffix.lower()==".jsonl":rows=[json.loads(x) for x in p.read_text(encoding="utf-8").splitlines() if x.strip()]
    elif p.suffix.lower()==".json":
        z=json.loads(p.read_text(encoding="utf-8"));rows=z if isinstance(z,list) else z.get("entries",[])
    else:raise ValueError("Ontology must be CSV, JSON, or JSONL.")
    allowed={"DEVICE_MODEL","DEVICE_TYPE","SERVICE","NETWORK_TECHNOLOGY","NETWORK_PROTOCOL","NETWORK_RESOURCE","METRIC","ORGANIZATION","PRODUCT","PLAN_OR_SOC"}
    out=[]
    for r in rows:
        name=normalize_space(r.get("canonical_name",""));etype=normalize_space(r.get("entity_type","")).upper();raw=r.get("synonyms",[])
        if not name or not etype:continue
        if etype not in allowed:raise ValueError(f"Unsupported ontology entity_type={etype} for {name}")
        if isinstance(raw,str):syn=[normalize_space(x) for x in re.split(r"[|;]",raw) if normalize_space(x)]
        elif isinstance(raw,list):syn=[normalize_space(x) for x in raw if normalize_space(x)]
        else:syn=[]
        out.append(OntologyEntry(name,etype,syn))
    return out

class OntologyMatcher:
    def __init__(self,entries:Sequence[OntologyEntry]):
        self.entries=list(entries);self.aliases=[]
        for i,e in enumerate(self.entries):
            for alias in [e.canonical_name]+list(e.synonyms):
                n=normalize_term(alias)
                if n:self.aliases.append((n,i))
        self.aliases.sort(key=lambda x:len(x[0].split()),reverse=True)
    def extract(self,text,ref):
        n=" "+normalize_term(text)+" ";rows=[]
        for alias,i in self.aliases:
            if f" {alias} " in n:
                e=self.entries[i];rows.append({"surface":alias,"canonical_name":normalize_space(e.canonical_name),"entity_type":e.entity_type,"evidence_strength":.99,"method":"approved_ontology","evidence_ref":ref})
        return dedupe_dicts(rows,("canonical_name","entity_type","evidence_ref"))


def extract_participants(text,role,role_source,ref):
    """Extract participant concepts without the old generic ACTOR type.

    `customer`/`assistant` are canonical interaction participants.
    `user` is preserved as a source-role alias or explicit mention so downstream
    consumers can keep the original terminology without confusing it with a
    separate customer.
    """
    rows=[]
    def add(name,strength,method,semantics):
        rows.append({"participant":name,"participant_semantics":semantics,"evidence_strength":strength,"method":method,"evidence_ref":ref})
    if role=="customer":
        add("customer",.99,"interaction_role","canonical_participant")
        if re.search(r"\buser\b",str(role_source),re.I):
            add("user",.98,"source_role_alias","source_role_alias")
    if role=="assistant":
        add("assistant",.99,"interaction_role","canonical_participant")
    # Explicit text mentions are separate from role metadata.
    if USER_MENTION_RE.search(str(text)):
        add("user",.94,"explicit_mention","explicit_mention")
    if CUSTOMER_MENTION_RE.search(str(text)) and role!="customer":
        add("customer",.94,"explicit_mention","explicit_mention")
    if CALL_CENTER_RE.search(f"{role_source} {text}"):
        add("call center",.95,"explicit_mention","service_channel")
    return dedupe_dicts(rows,("participant","participant_semantics","evidence_ref"))

def _protected_domain_tokens():
    out=set(DEVICE_TYPE_CUES)|set(NETWORK_TECH_CUES)|set(NETWORK_DOMAIN_CUES)
    for phrase in SERVICE_PHRASES:out.update(tokenize(phrase))
    return out

def learn_template_phrases(texts:Sequence[str],df_ratio:float)->set[str]:
    vals=[normalize_linguistic_text(x) for x in texts if len(tokenize(x))>=2]
    if len(vals)<8:return set()
    min_df=max(2,int(math.ceil(len(vals)*df_ratio)));max_df=max(min_df,min(len(vals),int(math.floor(len(vals)*.985))))
    v=CountVectorizer(ngram_range=(2,4),binary=True,min_df=min_df,max_df=max_df,token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b",max_features=25000)
    try:x=v.fit_transform(vals)
    except ValueError:return set()
    terms=v.get_feature_names_out();df=np.asarray(x.sum(axis=0)).ravel();protected=_protected_domain_tokens();out=set()
    for term,freq in zip(terms,df):
        toks=set(tokenize(term))
        if not toks or toks&protected or any(z in NEGATION_KEEP for z in toks):continue
        if IMPACT_CUE_RE.search(term) or REQUEST_CUE_RE.search(term) or any(z in {"working","connect","connected","disconnect","receive","send","slow","latency","outage","signal","coverage","drop","dropping","failed","failure"} for z in toks):continue
        if BOILERPLATE_CUE_RE.search(term) or float(freq)/len(vals)>=max(df_ratio,.30):out.add(normalize_term(term))
    return out

def fit_problem_normalizer(train_texts:Sequence[str],c:Config,stopword_seed:set[str])->ProblemNormalizerModel:
    vals=[normalize_linguistic_text(x) for x in train_texts if len(tokenize(x))>=c.min_problem_tokens]
    if not vals:raise RuntimeError("No customer text available to fit problem normalizer.")
    templates=learn_template_phrases(vals,c.template_df_ratio)
    stops=(SAFE_ENGLISH_STOPWORDS|stopword_seed|BACKGROUND_TERMS)-NEGATION_KEEP
    vec=TfidfVectorizer(ngram_range=(1,2),min_df=1,max_df=.995,max_features=min(60000,c.max_word_features),sublinear_tf=True,norm=None,stop_words=sorted(stops),token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b")
    try:vec.fit(vals)
    except ValueError:
        vec=TfidfVectorizer(ngram_range=(1,2),min_df=1,max_features=min(60000,c.max_word_features),norm=None,token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b");vec.fit(vals)
    return ProblemNormalizerModel(vec,templates,set(stops))

def strip_learned_templates(text:str,templates:set[str])->str:
    toks=tokenize(text)
    if not toks or not templates:return normalize_space(text)
    drop=np.zeros(len(toks),dtype=bool);bylen=defaultdict(set)
    for p in templates:bylen[len(p.split())].add(p)
    for n in sorted(bylen,reverse=True):
        for i in range(max(0,len(toks)-n+1)):
            if " ".join(toks[i:i+n]) in bylen[n]:drop[i:i+n]=True
    keep=[t for t,d in zip(toks,drop) if not d]
    return " ".join(keep)

def _idf_clause_score(clause:str,model:ProblemNormalizerModel)->float:
    toks=tokenize(clause)
    if not toks:return 0.0
    vocab=model.vectorizer.vocabulary_;idf=getattr(model.vectorizer,"idf_",None)
    vals=[]
    if idf is not None:
        for t in toks:
            j=vocab.get(t)
            if j is not None:vals.append(float(idf[j]))
    return float(np.mean(vals)) if vals else 0.0

def normalize_problem_clause(text:str,model:ProblemNormalizerModel)->Tuple[str,float,str]:
    raw=normalize_linguistic_text(text)
    clauses=[normalize_space(LEADIN_RE.sub("",x)) for x in CLAUSE_SPLIT_RE.split(raw) if len(tokenize(x))>=2]
    if not clauses:clauses=[normalize_space(LEADIN_RE.sub("",raw))]
    scored=[]
    for clause in clauses:
        stripped=strip_learned_templates(clause,model.learned_template_phrases);candidate=normalize_space(stripped or clause)
        tok=tokenize(candidate)
        if len(tok)<2:continue
        signal=2.4*bool(IMPACT_CUE_RE.search(candidate))+1.6*bool(REQUEST_CUE_RE.search(candidate))+1.0*bool(set(tok)&(_protected_domain_tokens()))
        idf=.35*_idf_clause_score(candidate,model);boiler=1.8*bool(BOILERPLATE_CUE_RE.search(candidate));noise=.8*(sum(t in BACKGROUND_TERMS for t in tok)/max(len(tok),1));score=signal+idf-boiler-noise
        scored.append((score,candidate))
    if not scored:return normalize_space(raw),0.0,"fallback_full_text"
    scored.sort(key=lambda x:(x[0],len(tokenize(x[1]))),reverse=True);score,best=scored[0]
    best=normalize_space(LEADIN_RE.sub("",best))
    if not best or len(tokenize(best))<2:best=normalize_space(raw)
    conf=float(np.clip(.50+.08*max(score,0),.50,.99));method="clause_signal_tfidf_normalizer" if best!=raw else "full_text_normalized"
    return best,conf,method

def _canonical_entity(surface):return normalize_space(surface).lower()

def _entity_precision_score(entity:Mapping[str,Any],text:str,role:str)->float:
    """Calibrate extraction confidence without an external NER model.

    The score starts from the extractor's evidence strength and then uses only
    local structural evidence: extraction method, lexical specificity, role,
    and whether the sentence actually carries problem/diagnostic/remediation
    signal. Generic nouns are deliberately penalized because they inflated the
    v5.2 entity counts without adding much analytical value.
    """
    base=safe_float(entity.get("evidence_strength"),0.0)
    name=normalize_term(entity.get("canonical_name",""));etype=str(entity.get("entity_type","")).upper();method=str(entity.get("method","")).lower()
    score=base
    if method=="approved_ontology":score=max(score,.99)
    if etype=="DEVICE_MODEL":score+=.035
    if etype=="METRIC":score+=.025
    if role=="customer" and (IMPACT_CUE_RE.search(text) or REQUEST_CUE_RE.search(text)):score+=.035
    if role in {"assistant","evidence"} and (DIAGNOSTIC_CUE_RE.search(text) or REMEDIATION_CUE_RE.search(text) or CAUSE_CUE_RE.search(text)):score+=.025
    if len(tokenize(name))>=2:score+=.02
    if name in GENERIC_ENTITY_VALUES and method!="approved_ontology":score-=.10
    if etype=="NETWORK_RESOURCE" and name=="network" and method!="approved_ontology":score-=.05
    return float(np.clip(score,0.0,.995))

def precision_filter_entities(entities:Sequence[Mapping[str,Any]],text:str,role:str,c:Config):
    """Return accepted entities and review candidates.

    Coverage is not silently discarded: lower-confidence candidates are retained
    in `entity_candidates` for audit/ontology expansion, while only accepted
    entities influence clustering, relation construction and business metrics.
    """
    accepted=[];candidates=[]
    for raw in entities:
        e=dict(raw);score=_entity_precision_score(e,text,role);name=normalize_term(e.get("canonical_name",""))
        threshold=c.entity_generic_accept_confidence if name in GENERIC_ENTITY_VALUES and str(e.get("method",""))!="approved_ontology" else c.entity_accept_confidence
        e["precision_score"]=score;e["acceptance_threshold"]=float(threshold)
        if score>=threshold:
            e["acceptance_status"]="ACCEPTED";accepted.append(e)
        else:
            e["acceptance_status"]="REVIEW_CANDIDATE";candidates.append(e)
    return dedupe_dicts(accepted,("canonical_name","entity_type","evidence_ref"),score_key="precision_score"),dedupe_dicts(candidates,("canonical_name","entity_type","evidence_ref"),score_key="precision_score")

def _stable_node_id(interaction_ref:str,node_type:str,label:str)->str:
    payload=f"{interaction_ref}|{node_type}|{normalize_space(label).lower()}".encode("utf-8",errors="ignore")
    return hashlib.sha1(payload).hexdigest()[:20]

def _relation_row(interaction_ref,subject_type,subject_label,predicate,object_type,object_label,confidence,evidence_ref,source_rule,status=None):
    sid=_stable_node_id(interaction_ref,subject_type,subject_label);oid=_stable_node_id(interaction_ref,object_type,object_label)
    rid=hashlib.sha1(f"{interaction_ref}|{sid}|{predicate}|{oid}|{evidence_ref}".encode()).hexdigest()[:24]
    row={"relation_id":rid,"interaction_ref":interaction_ref,"subject_id":sid,"subject_type":subject_type,"subject":normalize_space(subject_label),"predicate":predicate,"object_id":oid,"object_type":object_type,"object":normalize_space(object_label),"relation_confidence":float(np.clip(confidence,0,1)),"evidence_strength":float(np.clip(confidence,0,1)),"evidence_ref":str(evidence_ref),"source_rule":source_rule}
    if status is not None:row["status"]=status
    return row

def extract_device_model_candidates(text,ref):
    """Precision-first device-model extraction without pretrained NER.

    Approved ontology aliases remain the preferred source. The bootstrap path
    accepts explicit model fields or a contextual name only when it contains a
    genuine model-number signal and is not better explained as radio band,
    network technology, measurement/unit, account/site/code, or tooling text.
    """
    rows=[]
    stop={"since","with","using","on","for","from","and","or","that","which","because","number","line","account","site","case","ticket","issue","issues","service","data","internet","network","mobile","not","working","slow","tools","tool","downstream","upstream"}
    reject={"band","ghz","mhz","khz","mbps","gbps","kbps","dbm","db","rsrp","rsrq","sinr","pci","cell","site","tower","standalone","nsa","sa","lte","nr","ims","volte","apn","5g","4g","3g"}
    pronouns={"the","their","my","your","this","that","our","a","an"}
    explicit=re.compile(r"(?i)\b(?:device|phone|handset|router|gateway|modem|watch|tablet)?\s*model\s*[:=#-]\s*(?P<model>[A-Za-z0-9][A-Za-z0-9+_.\-/]*(?:\s+[A-Za-z0-9][A-Za-z0-9+_.\-/]*){0,3})")
    contextual=re.compile(r"(?i)\b(?:using|on|with)\s+(?:an?\s+)?(?P<model>[A-Za-z][A-Za-z0-9+_.\-]{1,24}\s+[A-Za-z0-9][A-Za-z0-9+_.\-]{0,24}(?:\s+[A-Za-z0-9][A-Za-z0-9+_.\-]{0,24})?)")
    for method,patt,strength in (("explicit_device_model_field",explicit,.97),("device_context_alphanumeric",contextual,.84)):
        for m in patt.finditer(text):
            parts=[x.strip(".,;:()[]{}") for x in m.group("model").split()]
            while parts and normalize_term(parts[0]) in pronouns:parts.pop(0)
            while parts and normalize_term(parts[-1]) in NETWORK_TECH_CUES:parts.pop()
            clean=[]
            for part in parts:
                n=normalize_term(part)
                if n in stop:break
                clean.append(part)
            surface=normalize_space(" ".join(clean));toks=tokenize(surface);low=set(toks)
            if not toks or len(toks)>4:continue
            if any(t in {"number","account","site","case","ticket","error","code"} for t in toks):continue
            if method=="device_context_alphanumeric":
                # Require a digit-bearing token not itself a known network-tech token.
                modelish=[x.lower().strip(".,;:()[]{}") for x in surface.split() if re.search(r"\d",x)]
                if not modelish or all(normalize_term(x) in NETWORK_TECH_CUES for x in modelish):continue
                if low & reject:continue
                # A bare numeric value is not a model unless paired with a non-generic name.
                alpha=[t for t in toks if not re.search(r"\d",t) and t not in stop and t not in reject]
                mixed=[x for x in modelish if re.search(r"[A-Za-z]",x) and re.search(r"\d",x)]
                if not mixed and not alpha:continue
            if len(toks)==1 and not re.search(r"[A-Za-z].*\d|\d.*[A-Za-z]|[-_.+]",surface):continue
            rows.append({"surface":surface,"canonical_name":surface,"entity_type":"DEVICE_MODEL","evidence_strength":strength,"method":method,"evidence_ref":ref})
    return dedupe_dicts(rows,("canonical_name","entity_type","evidence_ref"))

def extract_bootstrap_domain_entities(text,ref):
    n=" "+normalize_term(text)+" ";rows=[];covered=set()
    for phrase,canonical in sorted(SERVICE_PHRASES.items(),key=lambda x:len(x[0]),reverse=True):
        if f" {normalize_term(phrase)} " in n:
            rows.append({"surface":phrase,"canonical_name":canonical,"entity_type":"SERVICE","evidence_strength":.88,"method":"conservative_domain_cue","evidence_ref":ref});covered.update(tokenize(phrase))
    for tok in tokenize(text):
        if tok in DEVICE_TYPE_CUES:rows.append({"surface":tok,"canonical_name":tok,"entity_type":"DEVICE_TYPE","evidence_strength":.88,"method":"conservative_domain_cue","evidence_ref":ref})
        if tok in NETWORK_TECH_CUES:rows.append({"surface":tok,"canonical_name":tok,"entity_type":"NETWORK_TECHNOLOGY","evidence_strength":.90,"method":"conservative_domain_cue","evidence_ref":ref})
        if tok in NETWORK_DOMAIN_CUES:rows.append({"surface":tok,"canonical_name":"network","entity_type":"NETWORK_RESOURCE","evidence_strength":.82,"method":"conservative_domain_cue","evidence_ref":ref})
    return dedupe_dicts(rows,("canonical_name","entity_type","evidence_ref"))

def _valid_key(k):
    n=normalize_term(k);t=tokenize(n)
    if not n or len(t)>6 or len(t)<1:return False
    if n in GENERIC_ATTRIBUTE_KEYS or KEY_REJECT_PREFIX.search(n):return False
    if KEY_SENTENCE_VERB_RE.search(n) and len(t)>2:return False
    content=[x for x in t if x not in SAFE_ENGLISH_STOPWORDS and x not in BACKGROUND_TERMS]
    return bool(content) and len(content)/len(t)>=.50

def extract_observations(text,ref):
    attrs=[];meas=[]
    for m in MEASUREMENT_RE.finditer(text):
        k=normalize_space(m.group("key"));k=re.sub(r"(?i)^\s*(?:checked?|verified?|queried?|retrieved?|returned?|observed?|measured?)\s+","",k).strip()
        if not _valid_key(k):continue
        try:v=float(m.group("value"))
        except Exception:continue
        unit=m.group("unit");meas.append({"key":k,"normalized_key":normalize_term(k),"value":v,"unit":unit,"evidence_strength":.97,"method":"validated_numeric_measurement","evidence_ref":ref})
    for m in KV_RE.finditer(text):
        k=normalize_space(m.group("key"));v=normalize_space(m.group("value"));
        if not _valid_key(k) or not v or len(tokenize(v))>16:continue
        if any(x["normalized_key"]==normalize_term(k) for x in meas):continue
        attrs.append({"key":k,"normalized_key":normalize_term(k),"value":v,"normalized_value":normalize_term(v),"evidence_strength":.88,"method":"validated_explicit_attribute","evidence_ref":ref})
    for m in ERROR_CODE_RE.finditer(text):attrs.append({"key":"error_code","normalized_key":"error_code","value":m.group(1),"normalized_value":m.group(1).upper(),"evidence_strength":.94,"method":"error_code_pattern","evidence_ref":ref})
    return dedupe_dicts(attrs,("normalized_key","normalized_value","evidence_ref")),dedupe_dicts(meas,("normalized_key","value","unit","evidence_ref"))

def metric_entities_from_measurements(measurements,ref):
    return dedupe_dicts([{"surface":m["key"],"canonical_name":m["normalized_key"],"entity_type":"METRIC","evidence_strength":.96,"method":"validated_measurement_key","evidence_ref":ref} for m in measurements],("canonical_name","entity_type","evidence_ref"))

def salient_phrase(sentence,stopwords,max_tokens=9):
    vals=[t for t in tokenize(sentence) if t not in stopwords and t not in BACKGROUND_TERMS and t not in STRUCTURAL_TOKENS]
    return " ".join(vals[:max_tokens])

def root_cause_status(sentence):
    if CAUSE_UNKNOWN_RE.search(sentence):return "NOT_DETERMINED"
    if CAUSE_RULED_OUT_RE.search(sentence):return "RULED_OUT"
    if CAUSE_SUSPECTED_RE.search(sentence):return "SUSPECTED"
    # Require an affirmative causal construction before calling it confirmed.
    if re.search(r"(?i)\b(?:confirmed|identified\s+as|caused\s+by|due\s+to|because\s+of|resulted\s+from|attributed\s+to)\b",sentence):
        return "CONFIRMED"
    return "SUSPECTED"

def _substantive_root_cause(sentence:str)->bool:
    if CAUSE_UNKNOWN_RE.search(sentence) or CAUSE_RULED_OUT_RE.search(sentence):return True
    toks=[t for t in tokenize(sentence) if t not in GENERIC_CAUSE_TOKENS and t not in SAFE_ENGLISH_STOPWORDS and t not in BACKGROUND_TERMS]
    return len(toks)>=2

def extract_context(text,role,ref,stopwords):
    """Precision-first context extraction with mutually exclusive primary semantics.

    A sentence may still carry STATE/TEMPORAL context in addition to its primary
    function, but ROOT_CAUSE, REMEDIATION and DIAGNOSTIC are no longer emitted
    redundantly from the same generic sentence.
    """
    rows=[]
    for i,s in enumerate([normalize_space(x) for x in SENTENCE_SPLIT_RE.split(str(text or "")) if len(tokenize(x))>=2]):
        summary=salient_phrase(s,stopwords)
        if role=="customer":
            if IMPACT_CUE_RE.search(s):rows.append({"context_type":"SYMPTOM_OR_IMPACT","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.88,"sentence_index":i,"evidence_ref":ref})
            if STATE_CUE_RE.search(s):rows.append({"context_type":"STATE","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.82,"sentence_index":i,"evidence_ref":ref})
            if TIME_RE.search(s):rows.append({"context_type":"TEMPORAL","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.92,"sentence_index":i,"evidence_ref":ref})
            continue
        if role in {"assistant","evidence"}:
            is_cause=bool(CAUSE_CUE_RE.search(s) or CAUSE_UNKNOWN_RE.search(s) or CAUSE_RULED_OUT_RE.search(s)) and _substantive_root_cause(s)
            is_remediation=bool(REMEDIATION_ACTION_RE.search(s))
            is_diagnostic=bool(DIAGNOSTIC_CUE_RE.search(s))
            if is_cause:
                rows.append({"context_type":"ROOT_CAUSE","statement":s,"summary_phrase":summary,"root_cause_status":root_cause_status(s),"role":role,"evidence_strength":.93,"sentence_index":i,"evidence_ref":ref})
            elif is_remediation:
                rows.append({"context_type":"REMEDIATION","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.91,"sentence_index":i,"evidence_ref":ref})
            elif is_diagnostic:
                rows.append({"context_type":"DIAGNOSTIC","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.87,"sentence_index":i,"evidence_ref":ref})
            if STATE_CUE_RE.search(s):rows.append({"context_type":"STATE","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.83,"sentence_index":i,"evidence_ref":ref})
            if role=="evidence" and IMPACT_CUE_RE.search(s):rows.append({"context_type":"SYMPTOM_OR_IMPACT","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.83,"sentence_index":i,"evidence_ref":ref})
            if TIME_RE.search(s):rows.append({"context_type":"TEMPORAL","statement":s,"summary_phrase":summary,"role":role,"evidence_strength":.92,"sentence_index":i,"evidence_ref":ref})
    return rows

def build_evidence_records(contexts,attributes,measurements):
    linked=defaultdict(list)
    for x in list(attributes)+list(measurements):linked[str(x["evidence_ref"])].append(x)
    rows=[]
    for c in contexts:
        if c["context_type"] not in {"DIAGNOSTIC","STATE","SYMPTOM_OR_IMPACT"}:continue
        obs=linked.get(str(c["evidence_ref"]),[]);rows.append({"evidence_type":c["context_type"],"statement":c["statement"],"role":c.get("role"),"observations":obs[:12],"evidence_strength":float(min(.99,safe_float(c.get("evidence_strength"),.75)+(.06 if obs else 0))),"evidence_ref":c["evidence_ref"]})
    for m in measurements:rows.append({"evidence_type":"MEASUREMENT","statement":f"{m['key']}={m['value']} {m['unit']}","role":None,"observations":[m],"evidence_strength":.97,"evidence_ref":m["evidence_ref"]})
    return dedupe_dicts(rows,("evidence_type","statement","evidence_ref"))

def build_cause_records(contexts,evidence):
    by=defaultdict(list)
    for x in evidence:by[str(x["evidence_ref"])].append(x)
    rows=[]
    for c in contexts:
        if c["context_type"]!="ROOT_CAUSE":continue
        support=by.get(str(c["evidence_ref"]),[]);status=c.get("root_cause_status","SUSPECTED");strength={"CONFIRMED":.92,"SUSPECTED":.76,"RULED_OUT":.88,"NOT_DETERMINED":.96}.get(status,.75)
        rows.append({"statement":c["statement"],"status":status,"evidence_strength":strength,"supporting_evidence_count":len(support),"linked_evidence_refs":sorted({str(x["evidence_ref"]) for x in support}),"evidence_ref":c["evidence_ref"]})
    return dedupe_dicts(rows,("statement","status","evidence_ref"))

def build_remediation_records(contexts,evidence):
    by=defaultdict(list)
    for x in evidence:by[str(x["evidence_ref"])].append(x)
    rows=[]
    for c in contexts:
        if c["context_type"]!="REMEDIATION":continue
        support=by.get(str(c["evidence_ref"]),[]);rows.append({"statement":c["statement"],"evidence_strength":safe_float(c.get("evidence_strength"),.86),"supporting_evidence_count":len(support),"linked_evidence_refs":sorted({str(x["evidence_ref"]) for x in support}),"evidence_ref":c["evidence_ref"]})
    return dedupe_dicts(rows,("statement","evidence_ref"))

def build_relationships(participants,entities,contexts,attributes,measurements,causes,remediations,interaction_ref,problem_text,min_confidence=.72):
    """Build a typed, provenance-preserving local relation graph.

    Relations are asserted only when supported by the same evidence reference
    or by an explicit interaction-level structure (problem->cause/remediation).
    This deliberately avoids speculative cross-sentence causal links.
    """
    byent=defaultdict(list);byctx=defaultdict(list);byp=defaultdict(list);rows=[]
    for e in entities:byent[str(e["evidence_ref"])].append(e)
    for x in contexts:byctx[str(x["evidence_ref"])].append(x)
    for p in participants:byp[str(p["evidence_ref"])].append(p)
    problem_label=normalize_space(problem_text) or "customer problem"
    problem_ref="interaction:"+str(interaction_ref)

    # Canonical customer -> problem anchor.
    customer=[p for p in participants if p.get("participant")=="customer"]
    if customer:
        rows.append(_relation_row(interaction_ref,"PARTICIPANT","customer","REPORTS_PROBLEM","CUSTOMER_PROBLEM",problem_label,.98,problem_ref,"interaction_problem_anchor"))

    refs=set(byent)|set(byctx)|set(byp)
    for ref in refs:
        ents=byent.get(ref,[]);ctxs=byctx.get(ref,[]);parts=byp.get(ref,[])
        resources=[x for x in ents if str(x.get("entity_type")) in RELATION_RESOURCE_TYPES]
        symptoms=[x for x in ctxs if x.get("context_type")=="SYMPTOM_OR_IMPACT"]
        diagnostics=[x for x in ctxs if x.get("context_type")=="DIAGNOSTIC"]
        states=[x for x in ctxs if x.get("context_type")=="STATE"]
        temporals=[x for x in ctxs if x.get("context_type")=="TEMPORAL"]
        is_customer_ref=any(p.get("participant")=="customer" and p.get("participant_semantics") in {"canonical_participant","source_role_alias"} for p in parts)

        for p0 in parts[:4]:
            for sym in symptoms[:4]:
                conf=min(safe_float(p0.get("evidence_strength"),.8),safe_float(sym.get("evidence_strength"),.8))
                rows.append(_relation_row(interaction_ref,"PARTICIPANT",p0.get("participant","participant"),"EXPERIENCES","SYMPTOM_OR_IMPACT",sym.get("summary_phrase") or sym.get("statement",""),conf,ref,"same_evidence_participant_symptom"))

        if is_customer_ref:
            for e in resources[:8]:
                conf=min(.97,safe_float(e.get("precision_score",e.get("evidence_strength")),.8)+.03)
                rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"INVOLVES_RESOURCE",str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),conf,ref,"customer_problem_resource"))

        for sym in symptoms[:4]:
            for e in resources[:6]:
                conf=min(safe_float(sym.get("evidence_strength"),.8),safe_float(e.get("precision_score",e.get("evidence_strength")),.8))
                rows.append(_relation_row(interaction_ref,"SYMPTOM_OR_IMPACT",sym.get("summary_phrase") or sym.get("statement",""),"AFFECTS_RESOURCE",str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),conf,ref,"same_evidence_symptom_resource"))

        for d in diagnostics[:4]:
            rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"HAS_DIAGNOSTIC","DIAGNOSTIC",d.get("summary_phrase") or d.get("statement",""),safe_float(d.get("evidence_strength"),.8),ref,"diagnostic_for_problem"))
            for e in resources[:5]:
                conf=min(safe_float(d.get("evidence_strength"),.8),safe_float(e.get("precision_score",e.get("evidence_strength")),.8))
                rows.append(_relation_row(interaction_ref,"DIAGNOSTIC",d.get("summary_phrase") or d.get("statement",""),"OBSERVES_RESOURCE",str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),conf,ref,"same_evidence_diagnostic_resource"))

        for st in states[:4]:
            for e in resources[:5]:
                conf=min(safe_float(st.get("evidence_strength"),.8),safe_float(e.get("precision_score",e.get("evidence_strength")),.8))
                rows.append(_relation_row(interaction_ref,str(e.get("entity_type","ENTITY")),e.get("canonical_name",""),"HAS_STATE","STATE",st.get("summary_phrase") or st.get("statement",""),conf,ref,"same_evidence_resource_state"))
        for t in temporals[:3]:
            rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"HAS_TEMPORAL_CONTEXT","TEMPORAL",t.get("summary_phrase") or t.get("statement",""),safe_float(t.get("evidence_strength"),.8),ref,"problem_temporal_context"))

    for x in attributes:
        rows.append(_relation_row(interaction_ref,"INTERACTION",str(interaction_ref),"HAS_ATTRIBUTE","ATTRIBUTE",f"{x['normalized_key']}={x['normalized_value']}",safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"explicit_key_value"))
    for x in measurements:
        rows.append(_relation_row(interaction_ref,"INTERACTION",str(interaction_ref),"HAS_MEASUREMENT","MEASUREMENT",f"{x['normalized_key']}={x['value']} {x['unit']}",safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"numeric_measurement"))
    for x in causes:
        pred={"CONFIRMED":"HAS_CONFIRMED_CAUSE","SUSPECTED":"HAS_SUSPECTED_CAUSE","RULED_OUT":"HAS_RULED_OUT_CAUSE","NOT_DETERMINED":"CAUSE_NOT_DETERMINED"}.get(x.get("status"),"HAS_CAUSE_CONTEXT")
        rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,pred,"ROOT_CAUSE",x.get("statement",""),safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"root_cause_link",status=x.get("status")))
    for x in remediations:
        rows.append(_relation_row(interaction_ref,"CUSTOMER_PROBLEM",problem_label,"HAS_REMEDIATION","REMEDIATION",x.get("statement",""),safe_float(x.get("evidence_strength"),.8),x.get("evidence_ref"),"remediation_link"))

    rows=[r for r in rows if safe_float(r.get("relation_confidence"),0)>=float(min_confidence) and r.get("subject") and r.get("object")]
    return dedupe_dicts(rows,("subject_id","predicate","object_id","evidence_ref"),score_key="relation_confidence")

def semantic_signature(entities,contexts,problem_text=""):
    """Structure-aware customer-problem signature used alongside lexical text.

    This is not an intent label. It is a sparse relational fingerprint built
    only from accepted customer-side entities/context plus broad polarity/state
    cues, which improves semantic purity without pretrained embeddings.
    """
    toks=[];entity_tokens=[]
    for e in entities:
        et=normalise_key(e.get("entity_type",""));name=normalise_key(e.get("canonical_name",""))
        if not et:continue
        toks.append("etype_"+et)
        if str(e.get("entity_type","")) in STRUCTURAL_ENTITY_TYPES and name:
            token=f"entity_{et}_{name}";toks.append(token);entity_tokens.append((et,name))
    for c0 in contexts:
        ct=str(c0.get("context_type",""))
        if ct in {"SYMPTOM_OR_IMPACT","STATE","TEMPORAL","CUSTOMER_PROBLEM"}:toks.append("context_"+normalise_key(ct))
    # Entity co-occurrence encodes lightweight relation structure without
    # importing assistant-side RCA/remediation into customer-problem clustering.
    for i,(et1,n1) in enumerate(entity_tokens[:10]):
        for et2,n2 in entity_tokens[i+1:10]:
            a,b=sorted((f"{et1}_{n1}",f"{et2}_{n2}"));toks.append(f"pair_{a}__{b}")
    p=str(problem_text or "")
    if IMPACT_CUE_RE.search(p):toks.append("problem_has_impact")
    if REQUEST_CUE_RE.search(p):toks.append("problem_has_request")
    if STATE_CUE_RE.search(p):toks.append("problem_has_state")
    if any(x in tokenize(p) for x in NEGATION_KEEP):toks.append("problem_has_negation")
    return " ".join(sorted(set(x for x in toks if x and not x.endswith("_"))))

def build_records(frame,interactions,normalizer,ontology_matcher,stopwords,c:Config):
    rows=[];imap=interactions.set_index("_group").to_dict("index")
    for group,block in frame.groupby("_group",sort=False):
        participants=[];entities=[];entity_candidates=[];contexts=[];attributes=[];measurements=[];customer_entities=[];customer_contexts=[]
        for _,row in block.iterrows():
            text=str(row["_sanitized_text"]);role=str(row["_role"]);ref=str(row["_row_ref"]);role_source=str(row["_role_source"])
            participants.extend(extract_participants(text,role,role_source,ref));a,m=extract_observations(text,ref);attributes.extend(a);measurements.extend(m)
            local_context=extract_context(text,role,ref,stopwords);contexts.extend(local_context)
            raw_entities=ontology_matcher.extract(text,ref)+extract_bootstrap_domain_entities(text,ref)+extract_device_model_candidates(text,ref)+metric_entities_from_measurements(m,ref)
            local_entities,local_candidates=precision_filter_entities(raw_entities,text,role,c)
            entities.extend(local_entities);entity_candidates.extend(local_candidates)
            if role=="customer":customer_entities.extend(local_entities);customer_contexts.extend(local_context)
        base=imap[str(group)];normalized_problem,norm_conf,norm_method=normalize_problem_clause(str(base["customer_text"]),normalizer)
        if normalized_problem:
            contexts.append({"context_type":"CUSTOMER_PROBLEM","statement":normalized_problem,"summary_phrase":normalized_problem,"role":"customer","evidence_strength":norm_conf,"sentence_index":None,"evidence_ref":"interaction:"+str(base["interaction_ref"]),"normalization_method":norm_method})
            customer_contexts.append(contexts[-1])
        participants=dedupe_dicts(participants,("participant","evidence_ref"));entities=dedupe_dicts(entities,("canonical_name","entity_type","evidence_ref"),score_key="precision_score");entity_candidates=dedupe_dicts(entity_candidates,("canonical_name","entity_type","evidence_ref"),score_key="precision_score");contexts=dedupe_dicts(contexts,("context_type","statement","evidence_ref"));attributes=dedupe_dicts(attributes,("normalized_key","normalized_value","evidence_ref"));measurements=dedupe_dicts(measurements,("normalized_key","value","unit","evidence_ref"))
        evidence=build_evidence_records(contexts,attributes,measurements);causes=build_cause_records(contexts,evidence);remediation=build_remediation_records(contexts,evidence)
        relationships=build_relationships(participants,entities,contexts,attributes,measurements,causes,remediation,str(base["interaction_ref"]),normalized_problem,c.relation_min_confidence)
        participant_names=[]
        for p0 in participants:
            if p0["participant"] not in participant_names:participant_names.append(p0["participant"])
        rows.append({"interaction_ref":base["interaction_ref"],"data_split":base["data_split"],"message_count":base["message_count"],"upstream_labels_passthrough":base["upstream_labels_passthrough"],"participants":participant_names,"participant_evidence":participants,"content":{"customer_source_redacted":str(base["customer_text"]),"customer_problem_normalized":normalized_problem,"customer_problem_normalization_confidence":norm_conf,"assistant_response_redacted":str(base["assistant_text"]),"evidence_text_redacted":str(base["evidence_text"])},"entities":entities,"entity_candidates":entity_candidates,"context":contexts,"attributes":attributes,"measurements":measurements,"diagnostic_evidence":evidence,"root_cause":causes,"remediation":remediation,"relationships":relationships,"_customer_problem":normalized_problem,"_semantic_signature":semantic_signature(customer_entities,customer_contexts,normalized_problem)})
    return rows

# ---------------------------------------------------------------------------
# Classical semantic representation: TF-IDF + LSA + NMF topics
# ---------------------------------------------------------------------------

def _fit_vectorizer_with_fallback(vectorizer,texts):
    try:return vectorizer.fit_transform(texts)
    except ValueError:
        vectorizer.set_params(min_df=1,max_df=1.0);return vectorizer.fit_transform(texts)

def _choose_topic_components(n_docs,n_features,requested):
    upper=max(2,min(24,n_docs-1,n_features-1))
    if requested and requested>0:return max(2,min(int(requested),upper))
    return max(2,min(16,int(round(math.sqrt(max(n_docs,4))/1.5)),upper))


def _build_local_distributional_model(texts:Sequence[str],c:Config,stopwords:set[str])->Tuple[Optional[LocalDistributionalModel],np.ndarray]:
    """Train local PPMI/SVD word embeddings and SIF document vectors.

    This is entirely corpus-local: no pretrained weights, external API, or model
    download. It complements LSA/NMF when exact wording differs but terms appear
    in similar local contexts.
    """
    docs=[tokenize(x) for x in texts]
    n_docs=len(docs)
    if n_docs<8:
        return None,np.zeros((n_docs,0),dtype=np.float32)
    df=Counter();tf=Counter()
    blocked=set(stopwords)|SAFE_ENGLISH_STOPWORDS|BACKGROUND_TERMS|STRUCTURAL_TOKENS
    for toks in docs:
        clean=[t for t in toks if t not in blocked and len(t)>=2]
        tf.update(clean);df.update(set(clean))
    vocab_terms=[t for t,_ in tf.most_common(c.local_max_vocab) if df[t]>=max(1,int(c.local_min_df))]
    if len(vocab_terms)<8:
        return None,np.zeros((n_docs,0),dtype=np.float32)
    vocab={t:i for i,t in enumerate(vocab_terms)}
    rows=[];cols=[];vals=[];window=max(1,int(c.local_context_window))
    co=defaultdict(float)
    total_tokens=0
    for toks in docs:
        ids=[vocab[t] for t in toks if t in vocab];total_tokens+=len(ids)
        for i,a in enumerate(ids):
            lo=max(0,i-window);hi=min(len(ids),i+window+1)
            for j in range(lo,hi):
                if i==j:continue
                b=ids[j];co[(a,b)]+=1.0/max(abs(i-j),1)
    if not co:
        return None,np.zeros((n_docs,0),dtype=np.float32)
    for (a,b),v in co.items():rows.append(a);cols.append(b);vals.append(v)
    mat=sparse.coo_matrix((np.asarray(vals,dtype=np.float64),(rows,cols)),shape=(len(vocab),len(vocab))).tocsr()
    row_sum=np.asarray(mat.sum(axis=1)).ravel()+1e-12;col_sum=np.asarray(mat.sum(axis=0)).ravel()+1e-12;total=float(mat.sum())+1e-12
    coo=mat.tocoo(copy=True)
    pmi=np.log((coo.data*total)/(row_sum[coo.row]*col_sum[coo.col])+1e-12)
    keep=pmi>0
    ppmi=sparse.coo_matrix((pmi[keep],(coo.row[keep],coo.col[keep])),shape=mat.shape).tocsr()
    dims=min(max(2,int(c.local_embedding_components)),ppmi.shape[0]-1,ppmi.shape[1]-1)
    if dims<2 or ppmi.nnz==0:
        return None,np.zeros((n_docs,0),dtype=np.float32)
    svd=TruncatedSVD(n_components=dims,random_state=c.seed,n_iter=7)
    emb=np.asarray(svd.fit_transform(ppmi),dtype=np.float32)
    emb=Normalizer(copy=False).fit_transform(emb).astype(np.float32)
    probs=np.zeros(len(vocab),dtype=np.float32)
    denom=max(float(sum(tf[t] for t in vocab_terms)),1.0)
    for t,i in vocab.items():probs[i]=float(tf[t]/denom)
    model=LocalDistributionalModel(vocabulary=vocab,embeddings=emb,token_probability=probs,principal_component=None,sif_a=float(c.sif_a))
    z=_transform_local_distributional(model,texts,remove_pc=False)
    if z.shape[1] and len(z)>=3:
        try:
            pc=TruncatedSVD(n_components=1,random_state=c.seed).fit(z).components_[0].astype(np.float32)
            pc=pc/max(float(np.linalg.norm(pc)),1e-12);model.principal_component=pc
            z=_transform_local_distributional(model,texts,remove_pc=True)
        except Exception:
            pass
    return model,z

def _transform_local_distributional(model:Optional[LocalDistributionalModel],texts:Sequence[str],remove_pc:bool=True)->np.ndarray:
    if model is None:
        return np.zeros((len(texts),0),dtype=np.float32)
    out=np.zeros((len(texts),model.embeddings.shape[1]),dtype=np.float32)
    a=max(float(model.sif_a),1e-8)
    for r,text in enumerate(texts):
        ids=[model.vocabulary[t] for t in tokenize(text) if t in model.vocabulary]
        if not ids:continue
        w=np.asarray([a/(a+float(model.token_probability[i])) for i in ids],dtype=np.float32)
        vec=(model.embeddings[np.asarray(ids,dtype=int)]*w[:,None]).sum(axis=0)/max(float(w.sum()),1e-12)
        out[r]=vec
    if remove_pc and model.principal_component is not None:
        pc=np.asarray(model.principal_component,dtype=np.float32)
        out=out-(out@pc)[:,None]*pc[None,:]
    return np.asarray(Normalizer(copy=False).fit_transform(out),dtype=np.float32)


def fit_representation(texts,signatures,c,stopwords):
    vals=[str(x) for x in texts];sigs=[str(x) if str(x).strip() else "no_signature" for x in signatures];md=adaptive_min_df(len(vals));stops=sorted((SAFE_ENGLISH_STOPWORDS|set(stopwords))-NEGATION_KEEP)
    word=TfidfVectorizer(ngram_range=(1,3),min_df=md,max_df=.99,max_features=c.max_word_features,sublinear_tf=True,norm="l2",stop_words=stops,token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b")
    char=TfidfVectorizer(analyzer="char_wb",ngram_range=(3,5),min_df=md,max_features=c.max_char_features,sublinear_tf=True,norm="l2")
    sig=TfidfVectorizer(ngram_range=(1,2),min_df=1,max_features=30000,sublinear_tf=True,norm="l2",token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b")
    xw=_fit_vectorizer_with_fallback(word,vals);xc=_fit_vectorizer_with_fallback(char,vals);xs=_fit_vectorizer_with_fallback(sig,sigs)
    x=sparse.hstack([xw*c.word_weight,xc*c.char_weight,xs*c.signature_weight],format="csr")
    nc=min(c.lsa_components,x.shape[0]-1,x.shape[1]-1)
    if nc<2:raise RuntimeError("Insufficient samples/features for LSA representation.")
    svd=TruncatedSVD(n_components=nc,algorithm="randomized",n_iter=7,random_state=c.seed);z_lsa=svd.fit_transform(x)
    nt=_choose_topic_components(len(vals),xw.shape[1],c.topic_components)
    topic=None;z_topic=np.zeros((len(vals),0),dtype=np.float32)
    if nt>=2 and xw.shape[1]>=2:
        try:
            if MiniBatchNMF is not None and len(vals)>=1500:
                topic=MiniBatchNMF(n_components=nt,init="nndsvda",random_state=c.seed,batch_size=min(1024,max(64,len(vals)//8)),max_iter=220)
            else:
                topic=NMF(n_components=nt,init="nndsvda",random_state=c.seed,max_iter=350,solver="cd")
            z_topic=topic.fit_transform(xw)
        except Exception as exc:
            LOGGER.warning("NMF topic layer disabled after fit failure: %s",exc);topic=None;z_topic=np.zeros((len(vals),0),dtype=np.float32)
    local_model,z_local=_build_local_distributional_model(vals,c,set(stopwords))
    blocks=[np.asarray(z_lsa,dtype=np.float32)*c.lsa_weight]
    if z_topic.shape[1]:blocks.append(np.asarray(z_topic,dtype=np.float32)*c.topic_weight)
    if z_local.shape[1]:blocks.append(np.asarray(z_local,dtype=np.float32)*c.local_embedding_weight)
    combined=np.hstack(blocks)
    normalizer=Normalizer(copy=False);z=normalizer.fit_transform(combined)
    model=RepresentationModel(word,char,sig,svd,topic,local_model,normalizer,c.word_weight,c.char_weight,c.signature_weight,c.lsa_weight,c.topic_weight,c.local_embedding_weight)
    return model,np.asarray(z,dtype=np.float32)

def transform_representation(model,texts,signatures):
    vals=[str(x) for x in texts];sigs=[str(x) if str(x).strip() else "no_signature" for x in signatures]
    xw=model.word_vectorizer.transform(vals);xc=model.char_vectorizer.transform(vals);xs=model.signature_vectorizer.transform(sigs)
    x=sparse.hstack([xw*model.word_weight,xc*model.char_weight,xs*model.signature_weight],format="csr")
    z_lsa=model.svd.transform(x)*model.lsa_weight
    blocks=[np.asarray(z_lsa,dtype=np.float32)]
    if model.topic_model is not None:
        blocks.append(np.asarray(model.topic_model.transform(xw),dtype=np.float32)*model.topic_weight)
    z_local=_transform_local_distributional(model.local_distributional,vals,remove_pc=True)
    if z_local.shape[1]:
        blocks.append(z_local*model.local_embedding_weight)
    combined=np.hstack(blocks)
    return np.asarray(model.normalizer.transform(combined),dtype=np.float32)

def safe_silhouette(v,l,seed):
    m=np.asarray(l)!=-1
    if int(m.sum())<3 or len(set(np.asarray(l)[m].tolist()))<2:return None
    try:
        return float(silhouette_score(v[m],np.asarray(l)[m],metric="euclidean",sample_size=min(5000,int(m.sum())),random_state=seed))
    except Exception:return None

def cluster_entropy(labels):
    valid=np.asarray(labels);valid=valid[valid!=-1]
    if not len(valid):return 0.0
    a=np.asarray(list(Counter(valid.tolist()).values()),float);p=a/a.sum();return float(-np.sum(p*np.log(p+1e-12))/max(math.log(max(len(a),2)),1e-12))

def top_terms_by_cluster(texts,labels,stopwords,topn):
    ids=sorted(set(int(x) for x in np.asarray(labels).tolist() if int(x)!=-1))
    if not ids:return {}
    v=TfidfVectorizer(ngram_range=(1,3),min_df=1,stop_words=sorted((SAFE_ENGLISH_STOPWORDS|set(stopwords))-NEGATION_KEEP),sublinear_tf=True,token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b")
    try:x=v.fit_transform(list(texts))
    except ValueError:return {}
    terms=np.asarray(v.get_feature_names_out());out={}
    for cid in ids:
        score=np.asarray(x[np.asarray(labels)==cid].mean(axis=0)).ravel();cand=[]
        for j in np.argsort(score)[::-1]:
            if score[j]<=0:continue
            term=str(terms[j]);toks=term.split()
            if all(t in BACKGROUND_TERMS or t in stopwords for t in toks):continue
            if BOILERPLATE_CUE_RE.search(term):continue
            cand.append(term)
            if len(cand)>=topn:break
        out[cid]=cand
    return out

def coherence_npmi(texts,labels,stopwords,topn):
    ids=sorted(set(int(x) for x in np.asarray(labels).tolist() if int(x)!=-1))
    if not ids:return None,{}
    tops=top_terms_by_cluster(texts,labels,stopwords,topn);v=CountVectorizer(ngram_range=(1,2),min_df=1,binary=True,stop_words=sorted((SAFE_ENGLISH_STOPWORDS|set(stopwords))-NEGATION_KEEP),token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b")
    try:x=v.fit_transform(list(texts)).tocsr()
    except ValueError:return None,{}
    vocab=v.vocabulary_;n=max(x.shape[0],1);df=np.asarray(x.sum(axis=0)).ravel().astype(float);scores={}
    for cid in ids:
        terms=[t for t in tops.get(cid,[]) if t in vocab];pairs=[]
        for i,a in enumerate(terms):
            ia=int(vocab[a]);pa=df[ia]/n
            for b in terms[i+1:]:
                ib=int(vocab[b]);pb=df[ib]/n;co=float(x[:,ia].multiply(x[:,ib]).sum())
                if co<=0:continue
                pab=co/n;den=-math.log(max(pab,1e-12))
                if den>1e-12:pairs.append(float(np.clip(math.log(pab/max(pa*pb,1e-12))/den,-1,1)))
        scores[cid]=float(np.mean(pairs)) if pairs else float("nan")
    vals=[x for x in scores.values() if np.isfinite(x)];return (float(np.mean(vals)) if vals else None),scores

def signature_purity(signatures,labels):
    """Cluster purity over structure-aware signature tokens.

    For each cluster, build a core signature from tokens present in at least
    30% of its assigned documents and average Jaccard agreement with that core.
    This favors clusters that are not merely lexically close, but also share
    service/device/context structure.
    """
    if signatures is None:return None,{}
    labels=np.asarray(labels,dtype=int);vals=list(signatures)
    if len(vals)!=len(labels):return None,{}
    per={}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x)!=-1)):
        idx=np.flatnonzero(labels==cid)
        if len(idx)==0:continue
        docs=[set(str(vals[i]).split()) for i in idx]
        freq=Counter(t for d in docs for t in d)
        core={t for t,n in freq.items() if n/max(len(docs),1)>=.30 and not t.startswith("etype_")}
        if not core:
            core={t for t,_ in freq.most_common(min(5,len(freq)))}
        sims=[]
        for d in docs:
            if not d and not core:sims.append(1.0)
            elif not d or not core:sims.append(0.0)
            else:sims.append(len(d&core)/max(len(d|core),1))
        per[cid]=float(np.mean(sims)) if sims else float("nan")
    good=[v for v in per.values() if np.isfinite(v)]
    return (float(np.mean(good)) if good else None),per

def metric_standard_error(v,l,name,seed,repeats):
    n=len(l)
    if n<20 or repeats<2:return None
    rng=np.random.default_rng(seed);vals=[]
    for _ in range(repeats):
        idx=np.sort(rng.choice(n,max(10,int(round(.8*n))),replace=False));ll=np.asarray(l)[idx]
        if name=="silhouette":x=safe_silhouette(v[idx],ll,seed)
        elif name=="assigned_fraction":x=float(np.mean(ll!=-1))
        else:x=None
        if x is not None and np.isfinite(x):vals.append(float(x))
    return float(np.std(vals,ddof=1)) if len(vals)>=2 else None

def evaluate_clustering(v,l,texts,stopwords,c,bootstrap=False,signatures=None):
    l=np.asarray(l,dtype=int);valid=l[l!=-1];largest=max(Counter(valid.tolist()).values())/len(valid) if len(valid) else 1.0;sil=safe_silhouette(v,l,c.seed);coh,per=coherence_npmi(texts,l,stopwords,c.top_cluster_terms);sig_purity,sig_per=signature_purity(signatures,l)
    out={"silhouette":sil,"semantic_coherence_npmi":coh,"signature_purity":sig_purity,"assigned_fraction":float(np.mean(l!=-1)) if len(l) else 0.0,"noise_rate":float(np.mean(l==-1)) if len(l) else 0.0,"balance_entropy":cluster_entropy(l),"n_clusters":int(len(set(valid.tolist()))),"largest_cluster_share":float(largest),"assigned_count":int(np.sum(l!=-1)),"cluster_coherence":per,"cluster_signature_purity":sig_per}
    if bootstrap:
        out["silhouette_standard_error"]=metric_standard_error(v,l,"silhouette",c.seed+701,c.metric_bootstrap_repeats);out["assigned_fraction_standard_error"]=metric_standard_error(v,l,"assigned_fraction",c.seed+703,c.metric_bootstrap_repeats);finite=[x for x in per.values() if np.isfinite(x)];out["semantic_coherence_npmi_standard_error"]=float(np.std(finite,ddof=1)/math.sqrt(len(finite))) if len(finite)>=2 else None
        sfinite=[x for x in sig_per.values() if np.isfinite(x)];out["signature_purity_standard_error"]=float(np.std(sfinite,ddof=1)/math.sqrt(len(sfinite))) if len(sfinite)>=2 else None
    return out

def _normalise_cluster_ids(labels,train_vectors):
    labels=np.asarray(labels,dtype=int);ids=[int(x) for x in sorted(set(labels.tolist())) if int(x)!=-1]
    if not ids:return labels.copy(),{},{}
    rows=[]
    for cid in ids:
        idx=np.flatnonzero(labels==cid);cent=np.asarray(train_vectors[idx].mean(axis=0),float);signature=tuple(np.round(cent[:min(12,len(cent))],6).tolist());rows.append((cid,-len(idx),signature))
    rows.sort(key=lambda x:(x[1],x[2],x[0]));raw_to_public={raw:i+1 for i,(raw,_,__) in enumerate(rows)};public_to_raw={v:k for k,v in raw_to_public.items()};out=np.asarray([raw_to_public.get(int(x),-1) for x in labels],dtype=int);return out,raw_to_public,public_to_raw

def _cosine_to_centroid(v,centroid):return np.asarray(v@centroid,dtype=float).ravel()

def _calibrate_centroids(v,labels,c):
    cents={};thresholds={}
    for cid in sorted(set(int(x) for x in np.asarray(labels).tolist() if int(x)!=-1)):
        idx=np.flatnonzero(np.asarray(labels)==cid);cent=np.asarray(v[idx].mean(axis=0),dtype=np.float32);norm=float(np.linalg.norm(cent));cent=cent/max(norm,1e-12);sims=_cosine_to_centroid(v[idx],cent);q=float(np.quantile(sims,c.centroid_quantile)) if len(sims) else c.centroid_min_similarity;threshold=max(c.centroid_min_similarity,min(.95,q-.02));cents[cid]=cent;thresholds[cid]=threshold
    return cents,thresholds

def _predict_by_centroids(model,v):
    ids=sorted(model.centroid_vectors)
    if not ids or not len(v):return np.full(len(v),-1,dtype=int),np.zeros(len(v)),np.asarray(["unassigned"]*len(v),dtype=object)
    mat=np.vstack([model.centroid_vectors[i] for i in ids]);sims=np.asarray(v@mat.T,dtype=float);order=np.argsort(sims,axis=1)[:,::-1];labels=np.full(len(v),-1,dtype=int);strength=np.zeros(len(v));source=np.asarray(["unassigned"]*len(v),dtype=object)
    for i in range(len(v)):
        j=int(order[i,0]);cid=ids[j];best=float(sims[i,j]);second=float(sims[i,int(order[i,1])]) if len(ids)>1 else -1.0;threshold=float(model.centroid_thresholds.get(cid,.99))
        if best>=threshold and (best-second)>=model.centroid_margin:labels[i]=cid;strength[i]=best;source[i]="centroid_recovery"
    return labels,strength,source

def predict_cluster(model,v):
    # Production inference deliberately uses calibrated public centroids for all methods.
    return _predict_by_centroids(model,v)

def _k_distance_eps(v,min_samples):
    k=min(max(2,int(min_samples)),len(v));dist,_=NearestNeighbors(n_neighbors=k,metric="euclidean",n_jobs=-1).fit(v).kneighbors(v);kd=np.sort(dist[:,-1]);return sorted(set(round(float(x),6) for x in np.quantile(kd,[.55,.65,.75,.82,.88,.92]).tolist() if np.isfinite(x) and x>1e-6))

def _density_min_samples(n):
    b=max(4,int(round(math.log2(max(n,4)))));return sorted(set(max(3,int(round(x))) for x in (.65*b,b,1.35*b)))

def _candidate_stability(v,method,params,seed,repeats):
    if len(v)<24 or repeats<2:return 0.0
    rng=np.random.default_rng(seed);sn=max(16,int(.82*len(v)));runs=[]
    for r in range(repeats):
        idx=np.sort(rng.choice(len(v),sn,replace=False))
        try:
            if method=="dbscan":lab=DBSCAN(eps=params["eps"],min_samples=params["min_samples"],metric="euclidean",n_jobs=-1).fit_predict(v[idx])
            elif method=="optics":
                with warnings.catch_warnings():
                    warnings.filterwarnings("ignore",message="divide by zero encountered in divide",category=RuntimeWarning)
                    lab=OPTICS(min_samples=params["min_samples"],min_cluster_size=params["min_cluster_size"],xi=params["xi"],metric="euclidean",n_jobs=-1).fit_predict(v[idx])
            elif method=="hdbscan" and HDBSCAN is not None:
                lab=HDBSCAN(min_cluster_size=params["min_cluster_size"],min_samples=params["min_samples"],cluster_selection_method=params["cluster_selection_method"],metric="euclidean",n_jobs=-1,copy=False).fit_predict(v[idx])
            else:lab=MiniBatchKMeans(n_clusters=params["n_clusters"],random_state=seed+r,batch_size=min(1024,max(128,sn)),n_init="auto").fit_predict(v[idx])
            runs.append((idx,np.asarray(lab,dtype=int)))
        except Exception:pass
    vals=[]
    for i in range(len(runs)):
        for j in range(i+1,len(runs)):
            ia,la=runs[i];ib,lb=runs[j];common,aidx,bidx=np.intersect1d(ia,ib,return_indices=True)
            if len(common)>=4:vals.append(float(adjusted_rand_score(la[aidx],lb[bidx])))
    return float(np.mean(vals)) if vals else 0.0

def _make_model(method,estimator,params,train_raw_labels,tv,c):
    public,raw_to_public,public_to_raw=_normalise_cluster_ids(train_raw_labels,tv);cents,thresholds=_calibrate_centroids(tv,public,c);return ClusterModel(method,estimator,params,raw_to_public,public_to_raw,cents,thresholds,c.centroid_margin),public

def _direct_public_from_raw(raw,model):return np.asarray([model.raw_to_public.get(int(x),-1) if int(x)!=-1 else -1 for x in np.asarray(raw).tolist()],dtype=int)

def fit_candidate_models(tv,ttexts,tsigs,vv,vtexts,vsigs,stopwords,c):
    candidates=[];store={};cid=0;mss=_density_min_samples(len(tv))
    def record(method,est,params,raw_labels):
        nonlocal cid
        raw_labels=np.asarray(raw_labels,dtype=int)
        if len(set(int(x) for x in raw_labels.tolist() if int(x)!=-1))<2:return
        model,tl=_make_model(method,est,params,raw_labels,tv,c);vl,vs,_=_predict_by_centroids(model,vv);tm=evaluate_clustering(tv,tl,ttexts,stopwords,c,signatures=tsigs);vm=evaluate_clustering(vv,vl,vtexts,stopwords,c,signatures=vsigs)
        candidates.append({"candidate_id":cid,"method":method,**params,"train_silhouette":tm["silhouette"],"train_coherence":tm["semantic_coherence_npmi"],"train_signature_purity":tm.get("signature_purity"),"train_assigned_fraction":tm["assigned_fraction"],"validation_silhouette":vm["silhouette"],"validation_coherence":vm["semantic_coherence_npmi"],"validation_signature_purity":vm.get("signature_purity"),"validation_assigned_fraction":vm["assigned_fraction"],"validation_balance_entropy":vm["balance_entropy"],"validation_largest_cluster_share":vm["largest_cluster_share"],"validation_n_clusters":vm["n_clusters"]});store[cid]=(model,tl,vl,vs);cid+=1
    budget=max(8,c.model_search_trials)
    for ms in mss:
        epss=_k_distance_eps(tv,ms);take=max(2,int(math.ceil(budget/(max(len(mss),1)*2))))
        if len(epss)>take:epss=[epss[i] for i in np.linspace(0,len(epss)-1,take).round().astype(int)]
        for eps in epss:
            try:
                est=DBSCAN(eps=float(eps),min_samples=int(ms),metric="euclidean",n_jobs=-1);record("dbscan",est,{"eps":float(eps),"min_samples":int(ms)},est.fit_predict(tv))
            except Exception:pass
    # HDBSCAN/OPTICS handle variable-density structure using scikit-learn only.
    if HDBSCAN is not None:
        root=max(5,int(round(math.sqrt(len(tv))*.45)))
        mcs_values=sorted(set(max(5,min(max(5,len(tv)//3),int(round(v)))) for v in (root,.7*root,1.4*root)))
        for mcs in mcs_values:
            for ms in mss:
                for selection_method in ("eom","leaf"):
                    try:
                        est=HDBSCAN(min_cluster_size=int(mcs),min_samples=min(int(ms),int(mcs)),cluster_selection_method=selection_method,metric="euclidean",n_jobs=-1,copy=False);record("hdbscan",est,{"min_cluster_size":int(mcs),"min_samples":min(int(ms),int(mcs)),"cluster_selection_method":selection_method},est.fit_predict(tv))
                    except Exception:pass
    for ms in mss:
        for xi in (.035,.05,.075):
            try:
                mcs=max(ms+1,int(round(max(5,math.sqrt(len(tv))*.45))));est=OPTICS(min_samples=int(ms),min_cluster_size=int(mcs),xi=float(xi),metric="euclidean",n_jobs=-1)
                with warnings.catch_warnings():
                    warnings.filterwarnings("ignore",message="divide by zero encountered in divide",category=RuntimeWarning)
                    raw=est.fit_predict(tv)
                record("optics",est,{"min_samples":int(ms),"min_cluster_size":int(mcs),"xi":float(xi)},raw)
            except Exception:pass
    # Centroid discovery fallback: scalable, but still rejects uncertain validation/inference cases.
    maxk=min(20,max(3,int(round(math.sqrt(len(tv))))))
    ks=sorted(set([k for k in (3,4,5,6,7,8,10,12,maxk) if 2<=k<len(tv)]))
    for k in ks:
        try:
            est=MiniBatchKMeans(n_clusters=k,random_state=c.seed,batch_size=min(2048,max(128,len(tv))),n_init="auto",reassignment_ratio=.01);record("minibatch_kmeans",est,{"n_clusters":int(k)},est.fit_predict(tv))
        except Exception:pass
    tab=pd.DataFrame(candidates)
    if tab.empty:raise RuntimeError("No valid unsupervised clustering candidate produced at least two clusters.")
    ranks=[]
    for name,higher in (("validation_silhouette",True),("validation_coherence",True),("validation_signature_purity",True),("validation_assigned_fraction",True),("validation_balance_entropy",True),("validation_largest_cluster_share",False)):
        rn="rank_"+name;tab[rn]=percentile_rank(tab[name],higher);ranks.append(rn)
    # Explicitly reward adequate coverage instead of silently preferring tiny clean clusters.
    cov=pd.to_numeric(tab["validation_assigned_fraction"],errors="coerce").fillna(0.0);tab["coverage_target_score"]=1.0-np.minimum(np.abs(cov-c.selection_target_coverage)/max(c.selection_target_coverage,1e-9),1.0);ranks.append("coverage_target_score")
    tab["selection_score"]=tab[ranks].median(axis=1);top=tab.nlargest(min(8,len(tab)),"selection_score")["candidate_id"].astype(int).tolist();tab["stability_ari"]=np.nan
    for i in top:
        model,_,_,_=store[i];tab.loc[tab["candidate_id"]==i,"stability_ari"]=_candidate_stability(tv,model.method,model.parameters,c.seed+500,c.stability_repeats)
    tab["rank_stability"]=percentile_rank(tab["stability_ari"],True);tab["final_score"]=tab[ranks+["rank_stability"]].median(axis=1);tab["validation_structural_valid"]=(tab["validation_n_clusters"].fillna(0)>=2)&(tab["validation_largest_cluster_share"].fillna(1.0)<=.75)&(pd.to_numeric(tab["validation_signature_purity"],errors="coerce").fillna(0.0)>=max(.10,c.analytics_min_signature_purity*.45))
    eligible=tab[tab["validation_structural_valid"]].copy() if bool(tab["validation_structural_valid"].any()) else tab.copy();best=eligible.sort_values(["final_score","validation_assigned_fraction","validation_coherence","validation_silhouette"],ascending=False).iloc[0];i=int(best["candidate_id"]);model,tl,vl,vs=store[i]
    return model,tl,np.ones(len(tl),dtype=float),vl,vs,tab.sort_values(["validation_structural_valid","final_score","validation_assigned_fraction"],ascending=[False,False,False]).reset_index(drop=True)

# ---------------------------------------------------------------------------
# Cluster descriptions, exports and visuals
# ---------------------------------------------------------------------------

def descriptor_allowed(term,stopwords):
    n=normalize_term(term);t=n.split()
    if not n or any(x in STRUCTURAL_TOKENS for x in t) or BOILERPLATE_CUE_RE.search(n):return False
    blocked=SAFE_ENGLISH_STOPWORDS|BACKGROUND_TERMS|set(stopwords);content=[x for x in t if x not in blocked]
    return bool(content) and len(content)/len(t)>=.60 and t[0] not in BACKGROUND_TERMS


def cluster_descriptions(texts,labels,stopwords,topn):
    """Contrastive cluster descriptors.

    Terms are scored high only when common inside a cluster and comparatively
    uncommon outside it. This avoids generic labels such as company/template
    words while retaining multi-word problem phrases.
    """
    labels=np.asarray(labels,dtype=int)
    ids=sorted(set(int(x) for x in labels.tolist() if int(x)!=-1))
    if not ids:return {}
    stops=sorted((SAFE_ENGLISH_STOPWORDS|set(stopwords))-NEGATION_KEEP)
    v=TfidfVectorizer(ngram_range=(1,3),min_df=1,max_df=.995,max_features=60000,stop_words=stops,sublinear_tf=True,token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b")
    try:x=v.fit_transform(list(texts)).tocsr()
    except ValueError:return {cid:{"descriptor":f"cluster_{cid}","keywords":[]} for cid in ids}
    terms=np.asarray(v.get_feature_names_out())
    binx=(x>0).astype(np.int8);global_df=np.asarray(binx.sum(axis=0)).ravel()/max(len(texts),1)
    out={}
    for cid in ids:
        m=labels==cid;inside=np.asarray(x[m].mean(axis=0)).ravel()
        outside=np.asarray(x[~m].mean(axis=0)).ravel() if int((~m).sum()) else np.zeros_like(inside)
        contrast=np.log1p(inside/np.maximum(outside,1e-6))
        specificity=np.clip(1.0-global_df,0.05,1.0)
        score=inside*contrast*specificity
        chosen=[]
        for j in np.argsort(score)[::-1]:
            if score[j]<=0:continue
            term=str(terms[j])
            if not descriptor_allowed(term,stopwords):continue
            toks=term.split()
            # Very common single tokens rarely make useful business labels.
            if len(toks)==1 and global_df[j]>.35:continue
            tokset=set(toks)
            if any(len(tokset&set(e.split()))/max(len(tokset|set(e.split())),1)>.72 for e,_ in chosen):continue
            chosen.append((term,float(score[j])))
            if len(chosen)>=max(topn,6):break
        # Prefer phrases, but retain a discriminative unigram when phrases are sparse.
        multi=[x for x in chosen if len(x[0].split())>1];single=[x for x in chosen if len(x[0].split())==1]
        display=(multi[:3] if len(multi)>=2 else (multi+single)[:3])
        out[cid]={
            "descriptor":" / ".join(t for t,_ in display) or f"cluster_{cid}",
            "keywords":[{"term":t,"weight":w} for t,w in chosen[:topn]],
        }
    return out

def substantive_relation_coverage(records):
    substantive={"INVOLVES_RESOURCE","AFFECTS_RESOURCE","HAS_DIAGNOSTIC","OBSERVES_RESOURCE","HAS_STATE","HAS_CONFIRMED_CAUSE","HAS_SUSPECTED_CAUSE","HAS_RULED_OUT_CAUSE","CAUSE_NOT_DETERMINED","HAS_REMEDIATION","HAS_MEASUREMENT"}
    if not records:return 0.0
    good=sum(any(str(x.get("predicate")) in substantive for x in r.get("relationships",[])) for r in records)
    return float(good/len(records))

def relation_structure_purity(records,labels):
    """Mean within-cluster agreement of typed relation signatures."""
    labels=np.asarray(labels,dtype=int);per={}
    if len(records)!=len(labels):return None,{}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x)!=-1)):
        idx=np.flatnonzero(labels==cid);docs=[]
        for i in idx:
            sig=set()
            for rel in records[i].get("relationships",[]):
                pred=str(rel.get("predicate",""));ot=str(rel.get("object_type",""));obj=normalize_term(rel.get("object",""))
                if pred in {"REPORTS_PROBLEM","HAS_ATTRIBUTE","HAS_TEMPORAL_CONTEXT"}:continue
                if not pred or not ot:continue
                if ot in RELATION_RESOURCE_TYPES and obj:sig.add(f"{pred}|{ot}|{obj}")
                else:sig.add(f"{pred}|{ot}")
            docs.append(sig)
        freq=Counter(t for d in docs for t in d)
        core={t for t,n in freq.items() if n/max(len(docs),1)>=.30}
        if not core:core={t for t,_ in freq.most_common(min(6,len(freq)))}
        sims=[]
        for d in docs:
            if not d and not core:sims.append(1.0)
            elif not d or not core:sims.append(0.0)
            else:sims.append(len(d&core)/max(len(d|core),1))
        per[cid]=float(np.mean(sims)) if sims else float("nan")
    vals=[x for x in per.values() if np.isfinite(x)]
    return (float(np.mean(vals)) if vals else None),per

def cluster_catalog(records,v,l,strengths,desc,coh,c,privacy_safe):
    rows=[];l=np.asarray(l,dtype=int);assigned=max(int(np.sum(l!=-1)),1)
    _,sig_per=signature_purity([r.get("_semantic_signature","") for r in records],l)
    _,rel_per=relation_structure_purity(records,l)
    for cid in sorted(set(int(x) for x in l.tolist() if int(x)!=-1)):
        idx=np.flatnonzero(l==cid);cent=np.asarray(v[idx].mean(axis=0),float);cent=cent/max(float(np.linalg.norm(cent)),1e-12);sims=np.asarray(v[idx]@cent).ravel();order=idx[np.argsort(sims)[::-1][:c.representative_examples]];ec=Counter();cc=Counter();rc=Counter();examples=[]
        for p0 in idx.tolist():
            for e in records[p0].get("entities",[]):ec[f"{e['entity_type']}:{e['canonical_name']}"]+=1
            for x in records[p0].get("context",[]):cc[str(x.get("context_type"))]+=1
            for rel in records[p0].get("relationships",[]):
                pred=str(rel.get("predicate",""))
                if pred and pred not in {"REPORTS_PROBLEM","HAS_ATTRIBUTE"}:rc[pred]+=1
        if privacy_safe:
            for p0 in order.tolist():examples.append({"interaction_ref":records[p0]["interaction_ref"],"normalized_customer_problem":records[p0]["_customer_problem"][:700],"entities":[f"{e['entity_type']}:{e['canonical_name']}" for e in records[p0].get("entities",[])][:10]})
        subset=[records[i] for i in idx.tolist()]
        rows.append({"cluster_id":cid,"meaning":desc.get(cid,{}).get("descriptor",f"cluster_{cid}"),"count":len(idx),"share_of_assigned_pct":100*len(idx)/assigned,"mean_strength":float(np.mean(np.asarray(strengths)[idx])) if len(idx) else np.nan,"cohesion":float(np.mean(sims)) if len(idx) else np.nan,"semantic_coherence_npmi":coh.get(cid),"signature_purity":sig_per.get(cid),"relation_structure_purity":rel_per.get(cid),"substantive_relation_coverage":substantive_relation_coverage(subset),"top_entities":"; ".join(x for x,_ in ec.most_common(8)),"top_context_types":"; ".join(x for x,_ in cc.most_common(6)),"top_relation_types":"; ".join(x for x,_ in rc.most_common(8)),"top_terms":"; ".join(x["term"] for x in desc.get(cid,{}).get("keywords",[])[:c.top_cluster_terms]),"representative_examples":json.dumps(examples,ensure_ascii=False)})
    return pd.DataFrame(rows).sort_values("count",ascending=False).reset_index(drop=True) if rows else pd.DataFrame()

def cluster_similarity_table(v,l,desc):
    ids=sorted(set(int(x) for x in np.asarray(l).tolist() if int(x)!=-1));cent={}
    for cid in ids:
        x=np.asarray(v[np.asarray(l)==cid].mean(axis=0),float);cent[cid]=x/max(float(np.linalg.norm(x)),1e-12)
    rows=[{"cluster_a":a,"cluster_b":b,"cosine_similarity":float(cent[a]@cent[b]),"meaning_a":desc.get(a,{}).get("descriptor",f"cluster_{a}"),"meaning_b":desc.get(b,{}).get("descriptor",f"cluster_{b}")} for i,a in enumerate(ids) for b in ids[i+1:]]
    return pd.DataFrame(rows).sort_values("cosine_similarity",ascending=False).reset_index(drop=True) if rows else pd.DataFrame()

def save_cluster_heatmap(v,l,desc,path,topn):
    ids=sorted(set(int(x) for x in np.asarray(l).tolist() if int(x)!=-1))
    if len(ids)<2:return
    counts={cid:int(np.sum(np.asarray(l)==cid)) for cid in ids};ids=sorted(ids,key=lambda x:counts[x],reverse=True)[:max(2,topn)];cents=[]
    for cid in ids:
        x=np.asarray(v[np.asarray(l)==cid].mean(axis=0),float);cents.append(x/max(float(np.linalg.norm(x)),1e-12))
    mat=np.clip(np.vstack(cents)@np.vstack(cents).T,-1,1)
    if len(ids)>=3:
        d=np.clip(1-mat,0,2);np.fill_diagonal(d,0);order=leaves_list(linkage(squareform(d,checks=False),method="average")).tolist();ids=[ids[i] for i in order];mat=mat[np.ix_(order,order)]
    labels=[f"{cid}: {desc.get(cid,{}).get('descriptor',f'cluster_{cid}')[:32]}" for cid in ids];size=max(9,min(18,.58*len(ids)+5));fig,ax=plt.subplots(figsize=(size,size));im=ax.imshow(mat,vmin=-1,vmax=1,aspect="auto",cmap="coolwarm");ax.set_title("Semantic cluster similarity");ax.set_xticks(np.arange(len(ids)));ax.set_yticks(np.arange(len(ids)));ax.set_xticklabels(labels,rotation=90,fontsize=8);ax.set_yticklabels(labels,fontsize=8)
    if len(ids)<=24:
        for i in range(len(ids)):
            for j in range(len(ids)):ax.text(j,i,f"{mat[i,j]:.2f}",ha="center",va="center",fontsize=6)
    fig.colorbar(im,ax=ax,fraction=.046,pad=.04,label="Centroid cosine similarity");fig.tight_layout();fig.savefig(path,dpi=180,bbox_inches="tight");plt.close(fig)

def save_cluster_projection(v,l,desc,path,seed,sample_n):
    if len(v)<5:return
    rng=np.random.default_rng(seed);idx=np.sort(rng.choice(len(v),sample_n,replace=False)) if sample_n>0 and len(v)>sample_n else np.arange(len(v));vv=v[idx];ll=np.asarray(l)[idx];perplexity=min(30,max(3,(len(vv)-1)//4));coords=TSNE(n_components=2,perplexity=perplexity,init="pca",learning_rate="auto",random_state=seed,metric="cosine").fit_transform(vv)
    fig,ax=plt.subplots(figsize=(12,9));ids=sorted(set(int(x) for x in ll.tolist()))
    for cid in ids:
        m=ll==cid;label="UNKNOWN/OUTLIER" if cid==-1 else f"{cid}: {desc.get(cid,{}).get('descriptor',f'cluster_{cid}')[:28]} (n={int(m.sum())})";ax.scatter(coords[m,0],coords[m,1],s=13,alpha=.72,label=label)
    ax.set_title("Customer problem clusters (t-SNE diagnostic projection)");ax.set_xlabel("t-SNE component 1");ax.set_ylabel("t-SNE component 2")
    if len(ids)<=20:ax.legend(fontsize=7,loc="best")
    fig.tight_layout();fig.savefig(path,dpi=180,bbox_inches="tight");plt.close(fig)

def save_cluster_sizes(l,desc,path):
    counts=Counter(int(x) for x in np.asarray(l).tolist() if int(x)!=-1)
    if not counts:return
    ids=[x for x,_ in counts.most_common()];vals=[counts[x] for x in ids];labels=[f"{x}\n{desc.get(x,{}).get('descriptor',f'cluster_{x}')[:22]}" for x in ids];fig,ax=plt.subplots(figsize=(max(10,min(18,len(ids)*.75)),7));ax.bar(np.arange(len(ids)),vals);ax.set_title("Discovered customer problem cluster sizes");ax.set_ylabel("Interaction count");ax.set_xlabel("Cluster (IDs start at 1; -1 reserved for UNKNOWN/OUTLIER)");ax.set_xticks(np.arange(len(ids)));ax.set_xticklabels(labels,rotation=60,ha="right",fontsize=8);fig.tight_layout();fig.savefig(path,dpi=180,bbox_inches="tight");plt.close(fig)

def save_entity_type_counts(records,path):
    counts=Counter(e["entity_type"] for r in records for e in r.get("entities",[]))
    if not counts:return
    items=counts.most_common(20);names=[x[0] for x in items][::-1];vals=[x[1] for x in items][::-1];fig,ax=plt.subplots(figsize=(10,max(6,.42*len(items)+2)));ax.barh(np.arange(len(names)),vals);ax.set_yticks(np.arange(len(names)));ax.set_yticklabels(names,fontsize=8);ax.set_xlabel("Extracted entity count");ax.set_title("Extracted entity types (participants excluded)");fig.tight_layout();fig.savefig(path,dpi=180,bbox_inches="tight");plt.close(fig)

def flatten_field(records,name):
    rows=[]
    for r in records:
        for item in r.get(name,[]):
            row={"interaction_ref":r["interaction_ref"],**item}
            for k,v in list(row.items()):
                if isinstance(v,(list,dict)):row[k]=json.dumps(v,ensure_ascii=False)
            rows.append(row)
    return pd.DataFrame(rows)

def participant_summary_table(records):
    interactions=Counter();semantics=defaultdict(Counter)
    for r in records:
        for p in set(r.get("participants",[])):interactions[str(p)]+=1
        for e in r.get("participant_evidence",[]):
            name=str(e.get("participant","")).strip()
            if name:semantics[name][str(e.get("participant_semantics","unspecified"))]+=1
    rows=[]
    for name,count in interactions.most_common():
        sem="; ".join(f"{k}:{v}" for k,v in semantics[name].most_common())
        rows.append({"participant":name,"interaction_count":count,"semantics":sem})
    return pd.DataFrame(rows)

def entity_summary_table(records):
    values=defaultdict(Counter)
    for r in records:
        for e in r.get("entities",[]):
            name=normalize_space(e.get("canonical_name",""));etype=str(e.get("entity_type",""))
            if name and etype and not _contains_hard_pii(name):values[etype][name]+=1
    return pd.DataFrame([{"entity_type":etype,"count":sum(cnt.values()),"example_values":"; ".join(x for x,_ in cnt.most_common(12))} for etype,cnt in sorted(values.items(),key=lambda x:-sum(x[1].values()))])

def entity_precision_audit_table(records):
    rows=[]
    for status,field in (("ACCEPTED","entities"),("REVIEW_CANDIDATE","entity_candidates")):
        by=defaultdict(list);methods=defaultdict(Counter)
        for r in records:
            for e in r.get(field,[]):
                key=str(e.get("entity_type","UNKNOWN"));by[key].append(safe_float(e.get("precision_score",e.get("evidence_strength")),0));methods[key][str(e.get("method",""))]+=1
        for etype,vals in by.items():
            rows.append({"entity_type":etype,"status":status,"count":len(vals),"mean_precision_score":float(np.mean(vals)) if vals else np.nan,"methods":"; ".join(f"{k}:{v}" for k,v in methods[etype].most_common())})
    return pd.DataFrame(rows).sort_values(["status","count"],ascending=[True,False]).reset_index(drop=True) if rows else pd.DataFrame()

def context_summary_table(records):
    counts=Counter();examples=defaultdict(Counter)
    for r in records:
        for x in r.get("context",[]):
            kind=str(x.get("context_type",""))
            phrase=public_safe_phrase(normalize_space(x.get("summary_phrase") or x.get("statement") or ""))
            if kind:
                counts[kind]+=1
                if phrase:examples[kind][phrase]+=1
    return pd.DataFrame([{"context_type":k,"count":v,"example_phrases":"; ".join(x for x,_ in examples[k].most_common(8))} for k,v in counts.most_common()])

def root_cause_status_summary(records):
    c=Counter(x.get("status","UNKNOWN") for r in records for x in r.get("root_cause",[]));return pd.DataFrame([{"root_cause_status":k,"count":v} for k,v in c.most_common()])


def latent_topic_tables(records,representation):
    """Return latent NMF topic assignments/catalog as a secondary analysis lens."""
    if representation.topic_model is None or not records:
        return pd.DataFrame(),pd.DataFrame(),{}
    texts=[str(r.get("_customer_problem","")) for r in records]
    xw=representation.word_vectorizer.transform(texts)
    z=np.asarray(representation.topic_model.transform(xw),dtype=float)
    if z.ndim!=2 or z.shape[1]==0:return pd.DataFrame(),pd.DataFrame(),{}
    denom=z.sum(axis=1,keepdims=True);prob=np.divide(z,denom,out=np.zeros_like(z),where=denom>0)
    dom=np.argmax(prob,axis=1);strength=np.max(prob,axis=1)
    terms=np.asarray(representation.word_vectorizer.get_feature_names_out())
    catalog=[];topic_meanings={}
    comps=np.asarray(representation.topic_model.components_,dtype=float)
    for tid in range(comps.shape[0]):
        top=[str(terms[j]) for j in np.argsort(comps[tid])[::-1][:10] if comps[tid,j]>0]
        meaning=" / ".join(top[:4]) if top else f"topic_{tid+1}"
        topic_meanings[tid+1]=meaning
        catalog.append({"topic_id":tid+1,"meaning":meaning,"top_terms":"; ".join(top),"interaction_count":int(np.sum(dom==tid))})
    assigns=[]
    topic_map={}
    for r,t,s in zip(records,dom.tolist(),strength.tolist()):
        tid=int(t)+1;topic_map[str(r["interaction_ref"])]={"topic_id":tid,"topic_strength":float(s),"meaning":topic_meanings.get(tid,f"topic_{tid}")}
        assigns.append({"interaction_ref":r["interaction_ref"],"topic_id":tid,"topic_strength":float(s),"topic_meaning":topic_meanings.get(tid,f"topic_{tid}")})
    return pd.DataFrame(assigns),pd.DataFrame(catalog).sort_values("interaction_count",ascending=False).reset_index(drop=True),topic_map

def _pair_profile_table(records,field,kind_key,value_key):
    docs=[]
    universe=Counter()
    for r in records:
        vals=set()
        for x in r.get(field,[]):
            kind=str(x.get(kind_key,"")).strip();val=normalize_space(x.get(value_key,""))
            if kind and val:vals.add(f"{kind}:{val}")
        if vals:docs.append(vals);universe.update(vals)
    n=max(len(docs),1);pairs=Counter()
    for vals in docs:
        ordered=sorted(vals)
        for i,a in enumerate(ordered):
            for b in ordered[i+1:]:pairs[(a,b)]+=1
    rows=[]
    for (a,b),co in pairs.items():
        pa=universe[a]/n;pb=universe[b]/n;pab=co/n
        pmi=math.log(max(pab,1e-12)/max(pa*pb,1e-12))
        rows.append({"item_a":a,"item_b":b,"cooccurrence_count":co,"pmi":pmi})
    return pd.DataFrame(rows).sort_values(["cooccurrence_count","pmi"],ascending=[False,False]).reset_index(drop=True) if rows else pd.DataFrame()

def entity_cooccurrence_table(records):
    return _pair_profile_table(records,"entities","entity_type","canonical_name")

def context_cooccurrence_table(records):
    # Context types only; statement text is deliberately not used here.
    pseudo=[]
    for r in records:
        rr=dict(r);rr["_context_profile"]=[{"kind":"CONTEXT","value":str(x.get("context_type",""))} for x in r.get("context",[])]
        pseudo.append(rr)
    return _pair_profile_table(pseudo,"_context_profile","kind","value")

def resolution_dataset(records):
    rows=[]
    for r in records:
        ref=r["interaction_ref"]
        for x in r.get("root_cause",[]):
            rows.append({"interaction_ref":ref,"resolution_type":"ROOT_CAUSE","status":x.get("status"),"statement":x.get("statement"),"evidence_strength":x.get("evidence_strength"),"supporting_evidence_count":x.get("supporting_evidence_count"),"evidence_ref":x.get("evidence_ref")})
        for x in r.get("remediation",[]):
            rows.append({"interaction_ref":ref,"resolution_type":"REMEDIATION","status":"PROPOSED_OR_TAKEN","statement":x.get("statement"),"evidence_strength":x.get("evidence_strength"),"supporting_evidence_count":x.get("supporting_evidence_count"),"evidence_ref":x.get("evidence_ref")})
    return pd.DataFrame(rows)

def cluster_intent_alignment(records):
    """Post-hoc diagnostic only; upstream intent labels never train/select clusters."""
    rows=[];y_cluster=[];y_intent=[]
    for r in records:
        cid=int((r.get("semantic_cluster") or {}).get("cluster_id",-1))
        if cid==-1:continue
        labels=r.get("upstream_labels_passthrough") or {}
        if not isinstance(labels,dict) or not labels:continue
        label=max(labels.items(),key=lambda kv:(kv[1],str(kv[0])))[0]
        if not str(label).strip():continue
        y_cluster.append(cid);y_intent.append(str(label))
        rows.append({"interaction_ref":r.get("interaction_ref"),"cluster_id":cid,"upstream_intent":str(label)})
    if not rows:return pd.DataFrame(),pd.DataFrame(),{}
    raw=pd.DataFrame(rows)
    ct=pd.crosstab(raw["cluster_id"],raw["upstream_intent"])
    cross=ct.reset_index()
    metrics={"evaluated_interactions":len(rows)}
    if len(set(y_cluster))>=2 and len(set(y_intent))>=2:
        metrics.update({"nmi":float(normalized_mutual_info_score(y_intent,y_cluster)),
                        "adjusted_mi":float(adjusted_mutual_info_score(y_intent,y_cluster))})
    # Per-cluster entropy and dominant-intent share show where one semantic
    # problem cluster spans several intent labels (or vice versa).
    per=[]
    for cid,row in ct.iterrows():
        a=row.to_numpy(dtype=float);total=float(a.sum())
        if total<=0:continue
        prob=a/total;nz=prob[prob>0]
        ent=float(-np.sum(nz*np.log(nz))/max(math.log(max(len(prob),2)),1e-12))
        j=int(np.argmax(a))
        per.append({"cluster_id":int(cid),"dominant_upstream_intent":str(ct.columns[j]),
                    "dominant_intent_share":float(a[j]/total),"intent_entropy":ent,
                    "evaluated_interactions":int(total)})
    metrics["per_cluster"]=per
    return raw,cross,metrics

def ontology_alignment_table(records,ontology_entries):
    """Map extracted entity instances to the approved ontology when supplied."""
    aliases={}
    for e in ontology_entries or []:
        canonical=normalize_term(getattr(e,"canonical_name",""))
        etype=str(getattr(e,"entity_type","")).upper()
        for a in [getattr(e,"canonical_name","")]+list(getattr(e,"synonyms",[]) or []):
            n=normalize_term(a)
            if n:aliases[(etype,n)]=canonical or n
    counts=Counter()
    methods=defaultdict(Counter)
    for r in records:
        for e in r.get("entities",[]):
            et=str(e.get("entity_type","")).upper();name=normalize_term(e.get("canonical_name",""))
            if not et or not name:continue
            counts[(et,name)]+=1;methods[(et,name)][str(e.get("method",""))]+=1
    rows=[]
    ontology_supplied=bool(ontology_entries)
    for (et,name),count in counts.most_common():
        mapped=aliases.get((et,name))
        status="MATCHED" if mapped else "UNMAPPED" if ontology_supplied else "ONTOLOGY_NOT_PROVIDED"
        rows.append({"entity_type":et,"extracted_value":name,"count":count,
                     "ontology_status":status,"ontology_canonical":mapped or "",
                     "extraction_methods":"; ".join(k for k,_ in methods[(et,name)].most_common())})
    return pd.DataFrame(rows)

def graph_node_table(records):
    rows={}
    for r in records:
        ref=str(r.get("interaction_ref"))
        for rel in r.get("relationships",[]):
            for side in ("subject","object"):
                nid=str(rel.get(f"{side}_id",""));nt=str(rel.get(f"{side}_type",""));label=normalize_space(rel.get(side,""))
                if not nid or not nt or not label:continue
                key=(ref,nid)
                rows[key]={"interaction_ref":ref,"node_id":nid,"node_type":nt,"label":label}
    return pd.DataFrame(list(rows.values())) if rows else pd.DataFrame(columns=["interaction_ref","node_id","node_type","label"])

def relation_summary_table(records):
    c=Counter();conf=defaultdict(list)
    for r in records:
        for rel in r.get("relationships",[]):
            key=(str(rel.get("subject_type","")),str(rel.get("predicate","")),str(rel.get("object_type","")))
            if key[1]:c[key]+=1;conf[key].append(safe_float(rel.get("relation_confidence"),0))
    rows=[]
    for key,n in c.most_common():
        rows.append({"subject_type":key[0],"predicate":key[1],"object_type":key[2],"count":n,"mean_confidence":float(np.mean(conf[key])) if conf[key] else np.nan})
    return pd.DataFrame(rows)

def interaction_dictionary_table(records):
    """One row per interaction for analysts who prefer CSV over JSON/JSONL."""
    rows=[]
    for r in records:
        layers=r.get("dictionary_layers",{}) or {}
        analysis=layers.get("analysis",{}) or {}
        cluster=analysis.get("semantic_cluster",{}) or {}
        topic=analysis.get("latent_topic",{}) or {}
        rows.append({
            "interaction_ref":r.get("interaction_ref"),
            "data_split":r.get("data_split"),
            "participants":json.dumps(layers.get("participants",{}),ensure_ascii=False),
            "entities":json.dumps(layers.get("entities",{}),ensure_ascii=False),
            "context":json.dumps(layers.get("context",{}),ensure_ascii=False),
            "resolution":json.dumps(layers.get("resolution",{}),ensure_ascii=False),
            "relations":json.dumps(layers.get("relations",{}),ensure_ascii=False),
            "semantic_cluster_id":cluster.get("cluster_id"),
            "semantic_cluster_meaning":cluster.get("meaning"),
            "cluster_strength":cluster.get("cluster_strength"),
            "latent_topic_id":topic.get("topic_id") if isinstance(topic,dict) else None,
            "latent_topic_meaning":topic.get("meaning") if isinstance(topic,dict) else None,
        })
    return pd.DataFrame(rows)

def cluster_assignment_table(records):
    rows=[]
    for r in records:
        cl=r.get("semantic_cluster",{});content=r.get("content",{});rows.append({"interaction_ref":r.get("interaction_ref"),"data_split":r.get("data_split"),"cluster_id":cl.get("cluster_id"),"clustered":cl.get("clustered"),"cluster_strength":cl.get("cluster_strength"),"assignment_source":cl.get("assignment_source"),"cluster_meaning":cl.get("meaning"),"customer_problem_normalized":content.get("customer_problem_normalized",""),"participants":"; ".join(r.get("participants",[])),"top_entities":"; ".join(f"{e.get('entity_type')}:{e.get('canonical_name')}" for e in r.get("entities",[])[:12])})
    return pd.DataFrame(rows)


def _contains_hard_pii(value)->bool:
    v=str(value or "")
    for _,p in PII_PATTERNS:
        if p.search(v):return True
    return bool(STREET_ADDRESS_RE.search(v) or SENSITIVE_FIELD_RE.search(v))

def _safe_structured_entities(entities):
    out=[]
    for e in entities:
        item=dict(e);name=str(item.get("canonical_name",""))
        if _contains_hard_pii(name):item["canonical_name"]="[REDACTED_HARD_PII]";item["surface"]="[REDACTED_HARD_PII]"
        out.append(item)
    return out

def _privacy_slim_context(items,public_examples_safe):
    out=[]
    for x in items:
        item=dict(x)
        if not public_examples_safe:
            # Keep structured semantics visible while masking only the risky
            # free-text surface. This is deliberately field-level, not a global
            # suppression switch.
            if "statement" in item:item["statement"]=public_safe_phrase(item.get("statement",""))
            if "summary_phrase" in item:item["summary_phrase"]=public_safe_phrase(item.get("summary_phrase",""))
        out.append(item)
    return out

def _privacy_slim_relations(items,public_examples_safe):
    out=[]
    for rel in items:
        item=dict(rel)
        if not public_examples_safe:
            item["subject"]=public_safe_phrase(item.get("subject",""))
            item["object"]=public_safe_phrase(item.get("object",""))
        out.append(item)
    return out

def public_dictionary_record(r,cid,strength,meaning,source,public_examples_safe,hard_privacy_safe,latent_topic=None):
    out={k:v for k,v in r.items() if not k.startswith("_")}
    out["entities"]=_safe_structured_entities(out.get("entities",[]))
    out["entity_candidates"]=_safe_structured_entities(out.get("entity_candidates",[]))
    out["context"]=_privacy_slim_context(out.get("context",[]),public_examples_safe)
    out["diagnostic_evidence"]=_privacy_slim_context(out.get("diagnostic_evidence",[]),public_examples_safe)
    out["root_cause"]=_privacy_slim_context(out.get("root_cause",[]),public_examples_safe)
    out["remediation"]=_privacy_slim_context(out.get("remediation",[]),public_examples_safe)
    if not public_examples_safe:
        content=dict(out.get("content",{}))
        content["customer_source_redacted"]="[SUPPRESSED_PUBLIC_EXAMPLE]"
        content["assistant_response_redacted"]="[SUPPRESSED_PUBLIC_EXAMPLE]"
        content["evidence_text_redacted"]="[SUPPRESSED_PUBLIC_EXAMPLE]"
        # The problem clause is the core analytic artifact; keep its normalized form.
        out["content"]=content
    out["relationships"]=_privacy_slim_relations(out.get("relationships",[]),public_examples_safe)
    if not hard_privacy_safe:
        out["relationships"]=[]
    eby=defaultdict(list);cby=defaultdict(list)
    for e in out.get("entities",[]):
        et=str(e.get("entity_type",""));name=str(e.get("canonical_name","")).strip()
        if et and name and name not in eby[et]:eby[et].append(name)
    for x in out.get("context",[]):
        kind=str(x.get("context_type",""));phrase=normalize_space(x.get("summary_phrase") or "")
        if kind and phrase and phrase not in cby[kind]:cby[kind].append(phrase)
    out["entities_by_type"]=dict(eby);out["context_by_type"]=dict(cby)
    out["semantic_cluster"]={"cluster_id":int(cid),"cluster_strength":float(strength),"meaning":str(meaning),"clustered":bool(int(cid)!=-1),"assignment_source":str(source)}
    if latent_topic is not None:out["latent_topic"]=dict(latent_topic)
    out["dictionary_layers"]={
        "participants":{
            "values":list(out.get("participants",[])),
            "evidence":out.get("participant_evidence",[]),
        },
        "entities":{
            "by_type":dict(eby),
            "records":out.get("entities",[]),
            "review_candidates":out.get("entity_candidates",[]),
            "attributes":out.get("attributes",[]),
            "measurements":out.get("measurements",[]),
        },
        "context":{
            "by_type":dict(cby),
            "records":out.get("context",[]),
        },
        "resolution":{
            "root_cause":out.get("root_cause",[]),
            "remediation":out.get("remediation",[]),
            "diagnostic_evidence":out.get("diagnostic_evidence",[]),
        },
        "relations":{
            "records":out.get("relationships",[]),
        },
        "analysis":{
            "semantic_cluster":out["semantic_cluster"],
            "latent_topic":out.get("latent_topic"),
        },
    }
    return out

def pooled_tolerance(a,b,metric):
    sa=safe_float(a.get(f"{metric}_standard_error"),float("nan"));sb=safe_float(b.get(f"{metric}_standard_error"),float("nan"))
    if np.isfinite(sa) and np.isfinite(sb):return float(2.0*math.sqrt(sa*sa+sb*sb))
    if np.isfinite(sa):return float(2.0*sa)
    if np.isfinite(sb):return float(2.0*sb)
    return None

def build_statistical_gate(validation,locked):
    rows=[]
    for metric in ("silhouette","semantic_coherence_npmi","signature_purity","assigned_fraction"):
        v=validation.get(metric);t=locked.get(metric);tol=pooled_tolerance(validation,locked,metric)
        if v is None or t is None or not np.isfinite(safe_float(v,float("nan"))) or not np.isfinite(safe_float(t,float("nan"))):status="WARN";delta=None
        else:
            delta=float(t)-float(v);status="PASS" if tol is not None and delta>=-tol else "WARN" if tol is None else "FAIL"
        rows.append({"check":f"locked_{metric}_non_regression","status":status,"validation":v,"locked_test":t,"delta":delta,"data_driven_tolerance":tol})
    rows.append({"check":"validation_cluster_coverage","status":"PASS" if int(validation.get("n_clusters") or 0)>=2 else "FAIL","validation":validation.get("n_clusters"),"locked_test":locked.get("n_clusters")})
    rows.append({"check":"locked_cluster_coverage","status":"PASS" if int(locked.get("n_clusters") or 0)>=2 else "FAIL","validation":validation.get("n_clusters"),"locked_test":locked.get("n_clusters")})
    status="FAIL" if any(x["status"]=="FAIL" for x in rows) else "WARN" if any(x["status"]=="WARN" for x in rows) else "PASS";return status,pd.DataFrame(rows)

def _problem_normalization_coverage(records,c):
    eligible=[r for r in records if len(tokenize(r.get("content",{}).get("customer_source_redacted","")))>=c.min_problem_tokens]
    if not eligible:return 0.0
    good=sum(len(tokenize(r.get("content",{}).get("customer_problem_normalized","")))>=c.min_problem_tokens for r in eligible);return good/len(eligible)

def _low_confidence_entity_fraction(records,c):
    vals=[safe_float(e.get("evidence_strength"),0) for r in records for e in r.get("entities",[])]
    return float(np.mean(np.asarray(vals)<c.business_entity_confidence_floor)) if vals else 0.0


def build_business_gate(records,cluster_records,labels,privacy_summary,validation_metrics,c):
    """Analytics/business readiness gate focused on measurable DS quality.

    Privacy remains a separate review signal. v5.3 adds structure-purity and
    substantive relation-coverage checks so a statistically clean clustering
    cannot pass while the entity/context graph is weak.
    """
    labels=np.asarray(labels,dtype=int)
    coverage=float(np.mean(labels!=-1)) if len(labels) else 0.0
    outlier=1-coverage;valid=labels[labels!=-1]
    largest=max(Counter(valid.tolist()).values())/len(valid) if len(valid) else 1.0
    nclusters=len(set(valid.tolist()))
    normcov=_problem_normalization_coverage(records,c)
    lowentity=_low_confidence_entity_fraction(records,c)
    relation_cov=substantive_relation_coverage(cluster_records)
    relation_purity,_=relation_structure_purity(cluster_records,labels)
    vsil=validation_metrics.get("silhouette")
    vcoh=validation_metrics.get("semantic_coherence_npmi")
    vsig=validation_metrics.get("signature_purity")
    rows=[
        {"check":"assignment_coverage","status":"PASS" if coverage>=c.business_min_coverage else "FAIL","value":coverage,"required":f">={c.business_min_coverage}"},
        {"check":"outlier_rate","status":"PASS" if outlier<=c.business_max_outlier_rate else "FAIL","value":outlier,"required":f"<={c.business_max_outlier_rate}"},
        {"check":"minimum_cluster_count","status":"PASS" if nclusters>=c.business_min_clusters else "FAIL","value":nclusters,"required":f">={c.business_min_clusters}"},
        {"check":"largest_cluster_dominance","status":"PASS" if largest<=c.business_max_largest_cluster_share else "FAIL","value":largest,"required":f"<={c.business_max_largest_cluster_share}"},
        {"check":"problem_normalization_coverage","status":"PASS" if normcov>=c.business_min_problem_normalization_coverage else "FAIL","value":normcov,"required":f">={c.business_min_problem_normalization_coverage}"},
        {"check":"low_confidence_entity_fraction","status":"PASS" if lowentity<=c.business_max_low_confidence_entity_fraction else "FAIL","value":lowentity,"required":f"<={c.business_max_low_confidence_entity_fraction}"},
        {"check":"substantive_relation_coverage","status":"PASS" if relation_cov>=c.analytics_min_relation_coverage else "FAIL","value":relation_cov,"required":f">={c.analytics_min_relation_coverage}"},
        {"check":"relation_structure_purity","status":"PASS" if relation_purity is not None and relation_purity>=c.analytics_min_relation_structure_purity else "FAIL","value":relation_purity,"required":f">={c.analytics_min_relation_structure_purity}"},
        {"check":"validation_silhouette_floor","status":"PASS" if vsil is not None and safe_float(vsil,-1)>=c.analytics_min_validation_silhouette else "FAIL","value":vsil,"required":f">={c.analytics_min_validation_silhouette}"},
        {"check":"validation_semantic_coherence_floor","status":"PASS" if vcoh is not None and safe_float(vcoh,-1)>=c.analytics_min_validation_coherence else "FAIL","value":vcoh,"required":f">={c.analytics_min_validation_coherence}"},
        {"check":"validation_signature_purity_floor","status":"PASS" if vsig is not None and safe_float(vsig,-1)>=c.analytics_min_signature_purity else "FAIL","value":vsig,"required":f">={c.analytics_min_signature_purity}"},
        {"check":"external_pretrained_model_absence","status":"PASS","value":False,"required":"False"},
        {"check":"privacy_review_status","status":str(privacy_summary.get("residual_gate_status","UNKNOWN")),"value":int(privacy_summary.get("residual_findings",0)),"required":"reported separately"},
    ]
    analytic=[x for x in rows if x["check"]!="privacy_review_status"]
    status="PASS" if all(x["status"]=="PASS" for x in analytic) else "FAIL"
    return status,pd.DataFrame(rows),{
        "coverage":coverage,"outlier_rate":outlier,"n_clusters":nclusters,
        "largest_cluster_share":largest,"problem_normalization_coverage":normcov,
        "low_confidence_entity_fraction":lowentity,"substantive_relation_coverage":relation_cov,"relation_structure_purity":relation_purity,
        "validation_silhouette":vsil,"validation_semantic_coherence_npmi":vcoh,
        "validation_signature_purity":vsig,
    }

def write_selection_lock(outdir,cluster_model,split_audit,search_table,c):
    best=search_table.iloc[0].to_dict() if not search_table.empty else {};payload={"pipeline_version":PIPELINE_VERSION,"created_at_utc":utc_now_iso(),"code_fingerprint_sha256":current_code_fingerprint(),"selection_partitions":["train","validation"],"locked_test_used_for_selection":False,"selected_method":cluster_model.method,"selected_parameters":cluster_model.parameters,"public_cluster_ids_start_at":1,"outlier_id":-1,"selected_candidate_summary":to_plain(best),"split_audit":split_audit,"seed":c.seed};path=outdir/"selection_lock.json";path.write_text(json.dumps(to_plain(payload),indent=2,ensure_ascii=False),encoding="utf-8");return path


def write_html_summary(outdir,report,catalog,participant_summary,entity_summary,context_summary,root_summary,sim,stat_gate,business_gate,public_examples_safe,topic_catalog=None,alignment_metrics=None,relation_summary=None):
    ex=outdir/"executive";ex.mkdir(parents=True,exist_ok=True);counts=report["counts"];quality=report["quality"];privacy=report["privacy"]
    parts=["<!doctype html><html><head><meta charset='utf-8'><title>NORA Entity-Context v5.3</title><style>body{font-family:Arial,sans-serif;margin:28px;color:#222}table{border-collapse:collapse;width:100%;margin:12px 0 24px}th,td{border:1px solid #ccc;padding:7px;font-size:13px;vertical-align:top}th{background:#111;color:#fff}.card{background:#f4f4f4;padding:16px;border-radius:8px;margin:12px 0}.example{background:#fafafa;border-left:4px solid #888;padding:9px;margin:7px 0}.warn{background:#fff4e5;padding:12px}.ok{background:#ecf8ee;padding:12px}</style></head><body>",
    "<h1>NORA Entity-Context v5.3 — Precision / Semantic Purity / Relation Structure</h1>",
    f"<div class='card'><b>Execution:</b> {html_lib.escape(str(report['execution_status']))}<br><b>Statistical validation:</b> {report['statistical_validation_status']}<br><b>Analytics readiness:</b> {report['analytics_readiness_status']}<br><b>Privacy review:</b> {privacy.get('residual_gate_status')} (hard={privacy.get('hard_residual_findings',0)}, soft={privacy.get('soft_residual_findings',0)})<br><b>Selected clustering method:</b> {html_lib.escape(str(quality.get('selected_method')))}<br><b>Interactions:</b> {counts['interactions']}<br><b>Clusterable customer interactions:</b> {counts['clusterable_customer_interactions']}<br><b>Discovered semantic clusters:</b> {counts['semantic_clusters']}<br><b>Assigned:</b> {counts['assigned_customer_interactions']}<br><b>UNKNOWN/OUTLIER:</b> {counts['customer_outliers']}<br><b>Assignment coverage:</b> {counts['assignment_coverage_pct']:.2f}%<br><b>Entities:</b> {counts['entities']}<br><b>Participants:</b> {counts['participant_mentions']}<br><b>Contexts:</b> {counts['context_records']}</div>"]
    if privacy.get("residual_gate_status")=="WARN":
        parts.append("<div class='warn'><b>Privacy review warning.</b> Only ambiguous proper-name/person/location residue remains. This does not fail analytics readiness. Raw public examples are suppressed, while safe structured entity/context summaries remain visible.</div>")
    elif privacy.get("residual_gate_status")=="FAIL":
        parts.append("<div class='warn'><b>Hard privacy residue detected.</b> Raw public examples are suppressed and model persistence is blocked. Structured telecom summaries remain available after field-level filtering.</div>")
    else:
        parts.append("<div class='ok'><b>Privacy review passed.</b></div>")
    parts.append("<h2>Semantic clusters</h2>")
    if not catalog.empty:
        cols=[x for x in ("cluster_id","meaning","count","share_of_assigned_pct","mean_strength","cohesion","semantic_coherence_npmi","signature_purity","relation_structure_purity","substantive_relation_coverage","top_entities","top_context_types","top_relation_types") if x in catalog.columns]
        parts.append(catalog[cols].to_html(index=False,escape=True,float_format=lambda x:f"{x:.4f}" if pd.notna(x) else ""))
        parts.append("<h2>Cluster details</h2>")
        for row in catalog.itertuples(index=False):
            parts.append(f"<h3>Cluster {int(row.cluster_id)} — {html_lib.escape(str(row.meaning))}</h3><p><b>Interactions:</b> {int(row.count)} &nbsp; <b>Share:</b> {safe_float(row.share_of_assigned_pct):.2f}% &nbsp; <b>Cohesion:</b> {safe_float(row.cohesion):.4f}</p>")
            if public_examples_safe:
                try:examples=json.loads(str(row.representative_examples))
                except Exception:examples=[]
                for e in examples:
                    parts.append(f"<div class='example'><b>Normalized customer problem:</b> {html_lib.escape(str(e.get('normalized_customer_problem','')))}<br><b>Extracted entities:</b> {html_lib.escape('; '.join(e.get('entities',[]))) or '—'}</div>")
    if topic_catalog is not None and not topic_catalog.empty:
        parts.append("<h2>Latent NMF topics — secondary lens</h2>")
        parts.append("<p>These are not replacements for semantic clusters. They expose overlapping corpus themes that may sit across multiple customer-problem clusters.</p>")
        parts.append(topic_catalog.to_html(index=False,escape=True,float_format=lambda x:f"{x:.4f}" if pd.notna(x) else ""))
    parts.append("<h2>Participants</h2>");parts.append(participant_summary.to_html(index=False,escape=True) if not participant_summary.empty else "<p>No participants extracted.</p>")
    parts.append("<h2>Entity extraction</h2>");parts.append(entity_summary.to_html(index=False,escape=True) if not entity_summary.empty else "<p>No entities extracted.</p>")
    parts.append("<h2>Context extraction</h2>");parts.append(context_summary.to_html(index=False,escape=True) if not context_summary.empty else "<p>No context extracted.</p>")
    if relation_summary is not None:
        parts.append("<h2>Relation structure</h2>");parts.append(relation_summary.to_html(index=False,escape=True,float_format=lambda x:f"{x:.4f}" if isinstance(x,(float,np.floating)) and np.isfinite(x) else str(x)) if not relation_summary.empty else "<p>No typed relations extracted.</p>")
    parts.append("<h2>Root-cause status</h2>");parts.append(root_summary.to_html(index=False,escape=True) if not root_summary.empty else "<p>No root-cause statements extracted.</p>")
    parts += ["<h2>Statistical validation gate</h2>",stat_gate.to_html(index=False,escape=True,float_format=lambda x:f"{x:.4f}" if isinstance(x,(float,np.floating)) and np.isfinite(x) else str(x)),"<h2>Analytics readiness gate</h2>",business_gate.to_html(index=False,escape=True,float_format=lambda x:f"{x:.4f}" if isinstance(x,(float,np.floating)) and np.isfinite(x) else str(x))]
    if alignment_metrics:
        parts.append("<h2>External intent-alignment diagnostic</h2>")
        parts.append("<p>Upstream intent labels are used only for post-hoc comparison, never to train or select clusters.</p>")
        parts.append(pd.DataFrame([alignment_metrics]).to_html(index=False,escape=True,float_format=lambda x:f"{x:.4f}" if isinstance(x,(float,np.floating)) else str(x)))
    if not sim.empty:parts += ["<h2>Most similar cluster pairs</h2>",sim.head(20).to_html(index=False,escape=True,float_format=lambda x:f"{x:.4f}")]
    for img,title in (("semantic_cluster_similarity_heatmap.png","Cluster similarity heatmap"),("semantic_cluster_projection.png","2D diagnostic projection"),("semantic_cluster_size_distribution.png","Cluster size distribution"),("entity_type_counts.png","Entity extraction counts")):
        if (outdir/img).exists():parts += [f"<h2>{title}</h2>",f"<img src='../{img}' style='max-width:100%'>"]
    parts += ["<h2>Structured dictionary output</h2><p>Each interaction is exported as participants, precision-filtered entities/observations, context, resolution, typed relations, and a separate analysis layer containing semantic cluster and latent topic. Lower-confidence entity candidates remain available in an audit layer instead of contaminating the primary graph.</p>",
    "<h2>Method</h2><p>Classical/local NLP only: deterministic PII redaction + severity-aware residual review → train-only customer-problem normalizer → precision-calibrated ontology/conservative entity extraction → typed relation graph → word/character/structure-signature TF-IDF → TruncatedSVD/LSA + NMF topic factors + locally trained PPMI/SVD/SIF distributional embeddings → HDBSCAN/OPTICS/DBSCAN/MiniBatchKMeans candidate search → calibrated centroid recovery/rejection → locked-test validation. No pretrained language model, BERT/SentenceTransformer, GLiNER, BGE, Hugging Face model, API, or external model download is used.</p>","</body></html>"]
    path=ex/"nora_entity_context_v5_3_summary.html";path.write_text("".join(parts),encoding="utf-8");return path

def _strength_for_labels(model,v,labels):
    out=np.zeros(len(labels),dtype=float)
    for i,cid in enumerate(np.asarray(labels,dtype=int)):
        if cid==-1 or cid not in model.centroid_vectors:continue
        out[i]=float(np.clip(np.dot(v[i],model.centroid_vectors[cid]),0,1))
    return out

def _privacy_safe_residual_table(residual_df):
    if residual_df.empty:return residual_df
    out=residual_df.drop(columns=["text"],errors="ignore").copy()
    return out

def _safe_summary_tables(records,public_examples_safe,hard_privacy_safe):
    # Structured telecom entities/context summaries remain visible even when
    # free-text examples are suppressed. Hard PII values are already filtered.
    ps=participant_summary_table(records)
    es=entity_summary_table(records)
    cs=context_summary_table(records)
    rs=root_cause_status_summary(records)
    return ps,es,cs,rs


# ===========================================================================
# v5.5 architectural revision
# Full-coverage fine semantics + hierarchical sub-intents + stability gates +
# macro families + independent structural lenses + cross-lens fingerprints.
# This layer deliberately reuses the proven v5.3 extraction/privacy/relation
# machinery above and replaces only the clustering/analysis contract.
# ===========================================================================

from scipy.optimize import linear_sum_assignment


@dataclass(frozen=True)
class ConfigV55(Config):
    fine_min_clusters:int=6
    fine_max_clusters:int=40
    fine_min_cluster_size:int=6
    macro_min_clusters:int=3
    macro_max_clusters:int=10
    subintent_min_child_size:int=5
    subintent_max_children:int=5
    subintent_stability_repeats:int=8
    subintent_min_stability:float=.62
    subintent_min_silhouette:float=.08
    subintent_min_signature_purity:float=.50
    subintent_min_signature_gain:float=.00
    confidence_high_similarity:float=.68
    confidence_high_margin:float=.10
    confidence_high_stability:float=.72
    confidence_medium_similarity:float=.48
    confidence_medium_margin:float=.025
    analytics_min_fine_stability:float=.55
    analytics_max_low_confidence_fraction:float=.60
    workflow_max_clusters:int=10
    entity_profile_max_clusters:int=10
    relation_motif_max_clusters:int=10
    structural_lens_min_cluster_size:int=8


@dataclass
class LensModelV55:
    name:str
    vectorizer:TfidfVectorizer
    svd:Optional[TruncatedSVD]
    normalizer:Normalizer
    centroid_vectors:Dict[int,np.ndarray]
    descriptions:Dict[int,str]
    n_clusters:int
    selected_metrics:Dict[str,Any]


@dataclass
class SubintentModelV55:
    parent_cluster_id:int
    centroid_vectors:Dict[int,np.ndarray]
    descriptions:Dict[int,Dict[str,Any]]
    stability_ari:float
    silhouette:float
    signature_purity:float
    relation_structure_purity:float


@dataclass
class PipelineBundleV55:
    pipeline_name:str
    pipeline_version:str
    ontology:List[Dict[str,Any]]
    stopwords:List[str]
    problem_normalizer:ProblemNormalizerModel
    representation:RepresentationModel
    fine_cluster_model:ClusterModel
    fine_descriptions:Dict[int,Dict[str,Any]]
    fine_cluster_stability:Dict[int,float]
    macro_map:Dict[int,int]
    macro_descriptions:Dict[int,Dict[str,Any]]
    subintent_models:Dict[int,SubintentModelV55]
    workflow_model:Optional[LensModelV55]
    entity_profile_model:Optional[LensModelV55]
    relation_motif_model:Optional[LensModelV55]
    config:Dict[str,Any]


def _safe_rank(series:pd.Series,higher:bool=True)->pd.Series:
    s=pd.to_numeric(series,errors="coerce")
    if not s.notna().any():return pd.Series(np.zeros(len(s)),index=s.index,dtype=float)
    fill=float(s.median()) if s.notna().any() else 0.0
    return percentile_rank(s.fillna(fill),higher)


def _full_centroid_predict(model:ClusterModel,v:np.ndarray):
    """Nearest-centroid assignment with no rejection for usable records.

    Returns primary and secondary memberships. Uncertainty is retained as a
    score/margin/flag, never converted to UNKNOWN merely for low confidence.
    """
    ids=sorted(int(x) for x in model.centroid_vectors)
    n=len(v)
    if not ids or n==0:
        return (np.full(n,-1,dtype=int),np.zeros(n),np.full(n,-1,dtype=int),np.zeros(n),np.zeros(n),np.asarray(["not_clusterable"]*n,dtype=object))
    mat=np.vstack([model.centroid_vectors[i] for i in ids])
    sims=np.asarray(v@mat.T,dtype=float)
    order=np.argsort(sims,axis=1)[:,::-1]
    primary=np.empty(n,dtype=int);secondary=np.full(n,-1,dtype=int)
    pscore=np.zeros(n,dtype=float);sscore=np.zeros(n,dtype=float);margin=np.zeros(n,dtype=float)
    for i in range(n):
        j=int(order[i,0]);primary[i]=ids[j];pscore[i]=float(sims[i,j])
        if len(ids)>1:
            j2=int(order[i,1]);secondary[i]=ids[j2];sscore[i]=float(sims[i,j2])
        margin[i]=pscore[i]-sscore[i]
    return primary,pscore,secondary,sscore,margin,np.asarray(["nearest_centroid_full_coverage"]*n,dtype=object)


def _confidence_band(best:float,margin:float,stability:float,c:ConfigV55)->str:
    if best>=c.confidence_high_similarity and margin>=c.confidence_high_margin and stability>=c.confidence_high_stability:return "HIGH"
    if best>=c.confidence_medium_similarity and margin>=c.confidence_medium_margin:return "MEDIUM"
    return "LOW"


def _kmeans_stability(v:np.ndarray,k:int,seed:int,repeats:int)->float:
    if len(v)<max(10,k*2) or repeats<2:return 0.0
    labs=[]
    for r in range(repeats):
        try:
            est=MiniBatchKMeans(n_clusters=k,random_state=seed+7919*r,batch_size=min(2048,max(128,len(v))),n_init="auto",reassignment_ratio=.005)
            labs.append(np.asarray(est.fit_predict(v),dtype=int))
        except Exception:
            pass
    vals=[]
    for i in range(len(labs)):
        for j in range(i+1,len(labs)):
            vals.append(float(adjusted_rand_score(labs[i],labs[j])))
    return float(np.mean(vals)) if vals else 0.0


def _align_run_to_reference(reference:np.ndarray,run:np.ndarray)->np.ndarray:
    reference=np.asarray(reference,dtype=int);run=np.asarray(run,dtype=int)
    rids=sorted(set(reference.tolist()));uids=sorted(set(run.tolist()))
    mat=np.zeros((len(rids),len(uids)),dtype=int)
    ri={v:i for i,v in enumerate(rids)};ui={v:i for i,v in enumerate(uids)}
    for a,b in zip(reference.tolist(),run.tolist()):mat[ri[a],ui[b]]+=1
    rows,cols=linear_sum_assignment(-mat)
    mapping={uids[c]:rids[r] for r,c in zip(rows.tolist(),cols.tolist())}
    return np.asarray([mapping.get(int(x),int(x)) for x in run],dtype=int)


def consensus_stability_profile(v:np.ndarray,reference:np.ndarray,k:int,seed:int,repeats:int):
    reference=np.asarray(reference,dtype=int)
    if len(reference)==0:return np.zeros(0),{},0.0
    agreements=np.zeros(len(reference),dtype=float);completed=0
    for r in range(max(2,repeats)):
        try:
            est=MiniBatchKMeans(n_clusters=k,random_state=seed+12347*(r+1),batch_size=min(2048,max(128,len(v))),n_init="auto",reassignment_ratio=.005)
            lab=np.asarray(est.fit_predict(v),dtype=int);aligned=_align_run_to_reference(reference,lab)
            agreements+=(aligned==reference).astype(float);completed+=1
        except Exception:
            pass
    if completed==0:return np.zeros(len(reference)),{},0.0
    scores=agreements/completed
    per={int(cid):float(np.mean(scores[reference==cid])) for cid in sorted(set(reference.tolist()))}
    return scores,per,float(np.mean(scores))


def fit_full_coverage_fine_model(tv,ttexts,tsigs,vv,vtexts,vsigs,stopwords,c:ConfigV55):
    """Select a defensible full-coverage semantic partition.

    Coverage is a contract, not a selection metric. Candidate K values are
    compared on geometry, semantic coherence, structure-signature purity,
    balance, and repeated-seed stability. Granularity is only a weak tiebreaker.
    """
    max_support=max(2,len(tv)//max(2,c.fine_min_cluster_size))
    upper=min(c.fine_max_clusters,max_support,len(tv)-1)
    lower=min(max(2,c.fine_min_clusters),upper)
    if upper<2:raise RuntimeError("Insufficient train interactions for full-coverage clustering.")
    ks=list(range(lower,upper+1))
    budget=max(6,c.model_search_trials)
    if len(ks)>budget:
        pos=np.linspace(0,len(ks)-1,budget).round().astype(int)
        ks=sorted(set(ks[i] for i in pos.tolist()))
    rows=[];store={}
    for k in ks:
        try:
            est=MiniBatchKMeans(n_clusters=int(k),random_state=c.seed,batch_size=min(2048,max(128,len(tv))),n_init="auto",reassignment_ratio=.005)
            raw=np.asarray(est.fit_predict(tv),dtype=int)
            model,tl=_make_model("minibatch_kmeans_full_coverage",est,{"n_clusters":int(k)},raw,tv,c)
            vl,_,_,_,_,_=_full_centroid_predict(model,vv)
            tm=evaluate_clustering(tv,tl,ttexts,stopwords,c,signatures=tsigs)
            vm=evaluate_clustering(vv,vl,vtexts,stopwords,c,signatures=vsigs)
            cnt=Counter(tl.tolist());min_support=min(cnt.values()) if cnt else 0
            stability=_kmeans_stability(tv,int(k),c.seed+500,c.stability_repeats)
            rows.append({
                "candidate_k":int(k),"train_silhouette":tm.get("silhouette"),"validation_silhouette":vm.get("silhouette"),
                "validation_coherence":vm.get("semantic_coherence_npmi"),"validation_signature_purity":vm.get("signature_purity"),
                "validation_balance_entropy":vm.get("balance_entropy"),"validation_largest_cluster_share":vm.get("largest_cluster_share"),
                "train_min_cluster_size":int(min_support),"stability_ari":stability,
            })
            store[int(k)]=(model,tl,vl)
        except Exception as exc:
            LOGGER.debug("fine candidate k=%s failed: %s",k,exc)
    tab=pd.DataFrame(rows)
    if tab.empty:raise RuntimeError("No full-coverage fine semantic candidate could be fit.")
    tab["rank_silhouette"]=_safe_rank(tab["validation_silhouette"],True)
    tab["rank_coherence"]=_safe_rank(tab["validation_coherence"],True)
    tab["rank_signature"]=_safe_rank(tab["validation_signature_purity"],True)
    tab["rank_balance"]=_safe_rank(tab["validation_balance_entropy"],True)
    tab["rank_stability"]=_safe_rank(tab["stability_ari"],True)
    denom=max(float(tab["candidate_k"].max()-tab["candidate_k"].min()),1.0)
    tab["granularity_score"]=(tab["candidate_k"]-tab["candidate_k"].min())/denom
    tab["support_factor"]=np.minimum(1.0,pd.to_numeric(tab["train_min_cluster_size"],errors="coerce").fillna(0)/max(c.fine_min_cluster_size,1))
    tab["structural_valid"]=(tab["train_min_cluster_size"]>=max(3,int(math.ceil(.60*c.fine_min_cluster_size))))&(tab["validation_largest_cluster_share"].fillna(1.0)<=max(.50,c.business_max_largest_cluster_share+.08))
    tab["selection_score"]=(
        .24*tab["rank_silhouette"]+.20*tab["rank_coherence"]+.20*tab["rank_signature"]+
        .18*tab["rank_stability"]+.10*tab["rank_balance"]+.08*tab["granularity_score"]
    )*(.80+.20*tab["support_factor"])
    eligible=tab[tab["structural_valid"]].copy() if bool(tab["structural_valid"].any()) else tab.copy()
    best=eligible.sort_values(["selection_score","stability_ari","validation_signature_purity","candidate_k"],ascending=[False,False,False,False]).iloc[0]
    k=int(best["candidate_k"]);selection_model,tl,vl=store[k]
    return selection_model,tl,vl,tab.sort_values(["structural_valid","selection_score"],ascending=[False,False]).reset_index(drop=True),best.to_dict()


def refit_fine_model(dev_v:np.ndarray,k:int,c:ConfigV55):
    est=MiniBatchKMeans(n_clusters=int(k),random_state=c.seed+991,batch_size=min(2048,max(128,len(dev_v))),n_init="auto",reassignment_ratio=.005)
    raw=np.asarray(est.fit_predict(dev_v),dtype=int)
    return _make_model("minibatch_kmeans_full_coverage",est,{"n_clusters":int(k),"coverage_contract":"full"},raw,dev_v,c)


def fit_macro_clusters(fine_model:ClusterModel,fine_counts:Mapping[int,int],c:ConfigV55):
    fine_ids=sorted(int(x) for x in fine_model.centroid_vectors)
    if len(fine_ids)<=2:
        return {x:1 for x in fine_ids},{1:{"descriptor":"all customer problems","keywords":[]}},pd.DataFrame()
    x=np.vstack([fine_model.centroid_vectors[i] for i in fine_ids])
    weights=np.asarray([max(1,int(fine_counts.get(i,1))) for i in fine_ids],dtype=float)
    upper=min(c.macro_max_clusters,len(fine_ids)-1)
    lower=min(max(2,c.macro_min_clusters),upper)
    rows=[];store={}
    for k in range(lower,upper+1):
        try:
            est=MiniBatchKMeans(n_clusters=k,random_state=c.seed+1401,batch_size=max(32,len(x)),n_init="auto",reassignment_ratio=.0)
            try:raw=est.fit_predict(x,sample_weight=weights)
            except TypeError:raw=est.fit_predict(x)
            sil=safe_silhouette(x,np.asarray(raw,dtype=int),c.seed)
            ent=cluster_entropy(np.asarray(raw,dtype=int));stab=_kmeans_stability(x,k,c.seed+1403,max(3,min(c.stability_repeats,6)))
            rows.append({"macro_k":k,"silhouette":sil,"balance_entropy":ent,"stability_ari":stab});store[k]=np.asarray(raw,dtype=int)
        except Exception:pass
    tab=pd.DataFrame(rows)
    if tab.empty:
        raw=np.zeros(len(fine_ids),dtype=int);k=1
    else:
        tab["rank_silhouette"]=_safe_rank(tab["silhouette"],True);tab["rank_balance"]=_safe_rank(tab["balance_entropy"],True);tab["rank_stability"]=_safe_rank(tab["stability_ari"],True)
        tab["score"]=.55*tab["rank_silhouette"]+.20*tab["rank_balance"]+.25*tab["rank_stability"]
        k=int(tab.sort_values(["score","stability_ari"],ascending=False).iloc[0]["macro_k"]);raw=store[k]
    public,raw_to_public,_=_normalise_cluster_ids(raw,x)
    mapping={fine_ids[i]:int(public[i]) for i in range(len(fine_ids))}
    desc={cid:{"descriptor":f"macro_family_{cid}","keywords":[]} for cid in sorted(set(mapping.values()))}
    return mapping,desc,tab.sort_values("score",ascending=False).reset_index(drop=True) if not tab.empty and "score" in tab else tab


def _signature_parent_purity(signatures:Sequence[str])->float:
    if not signatures:return 0.0
    p,_=signature_purity(signatures,np.ones(len(signatures),dtype=int));return safe_float(p,0.0)


def _relation_parent_purity(records:Sequence[Mapping[str,Any]])->float:
    if not records:return 0.0
    p,_=relation_structure_purity(records,np.ones(len(records),dtype=int));return safe_float(p,0.0)


def discover_subintents(dev_records,dev_v,dev_fine_labels,stopwords,c:ConfigV55):
    models={};audit=[];dev_fine_labels=np.asarray(dev_fine_labels,dtype=int)
    for parent in sorted(set(int(x) for x in dev_fine_labels.tolist())):
        idx=np.flatnonzero(dev_fine_labels==parent);n=len(idx)
        local_records=[dev_records[i] for i in idx.tolist()];texts=[r["_customer_problem"] for r in local_records];sigs=[r["_semantic_signature"] for r in local_records]
        parent_sig=_signature_parent_purity(sigs);parent_rel=_relation_parent_purity(local_records)
        maxk=min(c.subintent_max_children,n//max(1,c.subintent_min_child_size))
        if n<2*c.subintent_min_child_size or maxk<2:
            audit.append({"parent_cluster_id":parent,"candidate_k":0,"n":n,"accepted":False,"reason":"insufficient_support","parent_signature_purity":parent_sig,"parent_relation_purity":parent_rel})
            continue
        candidates=[];store={}
        for k in range(2,maxk+1):
            try:
                est=MiniBatchKMeans(n_clusters=k,random_state=c.seed+parent*101+k,batch_size=max(32,n),n_init="auto",reassignment_ratio=.0)
                raw=np.asarray(est.fit_predict(dev_v[idx]),dtype=int);pub,_,_=_normalise_cluster_ids(raw,dev_v[idx])
                cnt=Counter(pub.tolist());minchild=min(cnt.values()) if cnt else 0;largest=max(cnt.values())/n if cnt else 1.0
                sil=safe_silhouette(dev_v[idx],pub,c.seed);sig,_=signature_purity(sigs,pub);rel,_=relation_structure_purity(local_records,pub)
                stability=_kmeans_stability(dev_v[idx],k,c.seed+parent*37,c.subintent_stability_repeats)
                sigv=safe_float(sig,0.0);relv=safe_float(rel,0.0);silv=safe_float(sil,-1.0)
                accepted=(minchild>=c.subintent_min_child_size and stability>=c.subintent_min_stability and silv>=c.subintent_min_silhouette and sigv>=max(c.subintent_min_signature_purity,parent_sig+c.subintent_min_signature_gain) and largest<=.82)
                score=.45*stability+.30*max(0.0,silv)+.20*sigv+.05*relv
                row={"parent_cluster_id":parent,"candidate_k":k,"n":n,"min_child_size":minchild,"largest_child_share":largest,"silhouette":silv,"stability_ari":stability,"signature_purity":sigv,"relation_structure_purity":relv,"parent_signature_purity":parent_sig,"parent_relation_purity":parent_rel,"accepted":accepted,"score":score,"reason":"accepted_candidate" if accepted else "quality_gate"}
                candidates.append(row);store[k]=(pub,est)
            except Exception as exc:
                candidates.append({"parent_cluster_id":parent,"candidate_k":k,"n":n,"accepted":False,"reason":f"fit_error:{type(exc).__name__}"})
        audit.extend(candidates)
        ok=[x for x in candidates if x.get("accepted")]
        if not ok:continue
        best=sorted(ok,key=lambda x:(safe_float(x.get("score")),safe_float(x.get("stability_ari")),safe_float(x.get("signature_purity"))),reverse=True)[0];k=int(best["candidate_k"]);pub,_=store[k]
        cents={}
        for child in sorted(set(int(x) for x in pub.tolist())):
            ci=np.flatnonzero(pub==child);cent=np.asarray(dev_v[idx][ci].mean(axis=0),dtype=np.float32);cent=cent/max(float(np.linalg.norm(cent)),1e-12);cents[child]=cent
        desc=cluster_descriptions(texts,pub,stopwords,c.top_cluster_terms)
        models[parent]=SubintentModelV55(parent,cents,desc,float(best["stability_ari"]),float(best["silhouette"]),float(best["signature_purity"]),float(best["relation_structure_purity"]))
    return models,pd.DataFrame(audit)


def assign_subintents(v:np.ndarray,fine_labels:np.ndarray,models:Mapping[int,SubintentModelV55],fine_descriptions:Mapping[int,Mapping[str,Any]]):
    fine_labels=np.asarray(fine_labels,dtype=int);leaf=[];child_ids=[];strengths=[];stabilities=[];meanings=[]
    for i,parent in enumerate(fine_labels.tolist()):
        m=models.get(int(parent))
        if m is None:
            leaf.append(f"F{int(parent)}");child_ids.append(0);strengths.append(1.0);stabilities.append(1.0);meanings.append(str(fine_descriptions.get(int(parent),{}).get("descriptor",f"cluster_{parent}")));continue
        ids=sorted(m.centroid_vectors);mat=np.vstack([m.centroid_vectors[x] for x in ids]);s=np.asarray(v[i]@mat.T,dtype=float).ravel();j=int(np.argmax(s));child=ids[j]
        leaf.append(f"F{int(parent)}.S{int(child)}");child_ids.append(int(child));strengths.append(float(s[j]));stabilities.append(float(m.stability_ari));meanings.append(str(m.descriptions.get(int(child),{}).get("descriptor",f"subintent_{parent}_{child}")))
    return np.asarray(leaf,dtype=object),np.asarray(child_ids,dtype=int),np.asarray(strengths,dtype=float),np.asarray(stabilities,dtype=float),np.asarray(meanings,dtype=object)


def _workflow_signature(r:Mapping[str,Any])->str:
    toks=[]
    participants=[normalise_key(x) for x in r.get("participants",[]) if normalize_space(x)]
    toks.extend("participant_"+x for x in participants)
    seq=[]
    for x in r.get("context",[]):
        ct=normalise_key(x.get("context_type",""))
        if ct:seq.append(ct);toks.append("ctx_"+ct)
    for a,b in zip(seq,seq[1:]):toks.append(f"transition_{a}__{b}")
    for rel in r.get("relationships",[]):
        p=normalise_key(rel.get("predicate",""))
        if p:toks.append("pred_"+p)
    for rc in r.get("root_cause",[]):
        st=normalise_key(rc.get("status",""))
        if st:toks.append("rc_"+st)
    if r.get("remediation"):toks.append("has_remediation")
    if r.get("diagnostic_evidence"):toks.append("has_diagnostic")
    return " ".join(toks) if toks else "workflow_none"


def _entity_profile_signature(r:Mapping[str,Any])->str:
    toks=[];pairs=[]
    for e in r.get("entities",[]):
        et=normalise_key(e.get("entity_type",""));name=normalise_key(e.get("canonical_name",""))
        if et:toks.append("etype_"+et)
        if et and name:toks.append(f"entity_{et}_{name}");pairs.append(f"{et}_{name}")
    for i,a in enumerate(sorted(set(pairs))[:12]):
        for b in sorted(set(pairs))[i+1:12]:toks.append(f"epair_{a}__{b}")
    return " ".join(toks) if toks else "entity_profile_none"


def _relation_motif_signature(r:Mapping[str,Any])->str:
    toks=[];preds=[]
    for rel in r.get("relationships",[]):
        s=normalise_key(rel.get("subject_type",""));p=normalise_key(rel.get("predicate",""));o=normalise_key(rel.get("object_type",""))
        if p:preds.append(p);toks.append("pred_"+p)
        if s and p and o:toks.append(f"motif_{s}__{p}__{o}")
    for a,b in zip(preds,preds[1:]):toks.append(f"rtransition_{a}__{b}")
    return " ".join(toks) if toks else "relation_motif_none"


def _fit_lens_representation(docs:Sequence[str],seed:int):
    vec=TfidfVectorizer(ngram_range=(1,2),min_df=1,max_df=.995,sublinear_tf=True,norm="l2",token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9_]{1,}\b")
    x=_fit_vectorizer_with_fallback(vec,[str(d) if str(d).strip() else "none" for d in docs])
    nc=min(32,x.shape[0]-1,x.shape[1]-1)
    svd=None
    if nc>=2:
        svd=TruncatedSVD(n_components=nc,random_state=seed,n_iter=7);z=svd.fit_transform(x)
    else:z=x.toarray()
    norm=Normalizer(copy=False);z=norm.fit_transform(np.asarray(z,dtype=np.float32))
    return vec,svd,norm,np.asarray(z,dtype=np.float32)


def _transform_lens(model:LensModelV55,docs:Sequence[str])->np.ndarray:
    x=model.vectorizer.transform([str(d) if str(d).strip() else "none" for d in docs]);z=model.svd.transform(x) if model.svd is not None else x.toarray();return np.asarray(model.normalizer.transform(np.asarray(z,dtype=np.float32)),dtype=np.float32)


def _lens_descriptions(docs:Sequence[str],labels:np.ndarray,topn:int=6)->Dict[int,str]:
    out={};labels=np.asarray(labels,dtype=int)
    for cid in sorted(set(labels.tolist())):
        cnt=Counter()
        for i in np.flatnonzero(labels==cid).tolist():cnt.update(str(docs[i]).split())
        terms=[t for t,_ in cnt.most_common(topn) if t and not t.endswith("_none")]
        out[int(cid)]=" / ".join(terms[:4]) if terms else f"cluster_{cid}"
    return out


def fit_structural_lens(dev_records,name:str,c:ConfigV55):
    if name=="workflow":builder=_workflow_signature;maxk=c.workflow_max_clusters
    elif name=="entity_profile":builder=_entity_profile_signature;maxk=c.entity_profile_max_clusters
    elif name=="relation_motif":builder=_relation_motif_signature;maxk=c.relation_motif_max_clusters
    else:raise ValueError(name)
    docs=[builder(r) for r in dev_records];vec,svd,norm,z=_fit_lens_representation(docs,c.seed+hash(name)%1000)
    support=max(2,len(z)//max(2,c.structural_lens_min_cluster_size));upper=min(maxk,support,len(z)-1)
    if upper<2:return None,np.ones(len(z),dtype=int),pd.DataFrame(),docs
    rows=[];store={}
    for k in range(2,upper+1):
        try:
            est=MiniBatchKMeans(n_clusters=k,random_state=c.seed+len(name)*101+k,batch_size=min(1024,max(64,len(z))),n_init="auto",reassignment_ratio=.005)
            raw=np.asarray(est.fit_predict(z),dtype=int);pub,_,_=_normalise_cluster_ids(raw,z);cnt=Counter(pub.tolist())
            sil=safe_silhouette(z,pub,c.seed);stab=_kmeans_stability(z,k,c.seed+1701,max(3,min(c.stability_repeats,6)));ent=cluster_entropy(pub);minsize=min(cnt.values()) if cnt else 0;largest=max(cnt.values())/len(pub) if cnt else 1
            rows.append({"k":k,"silhouette":sil,"stability_ari":stab,"balance_entropy":ent,"min_cluster_size":minsize,"largest_cluster_share":largest});store[k]=pub
        except Exception:pass
    tab=pd.DataFrame(rows)
    if tab.empty:return None,np.ones(len(z),dtype=int),tab,docs
    tab["rank_silhouette"]=_safe_rank(tab["silhouette"],True);tab["rank_stability"]=_safe_rank(tab["stability_ari"],True);tab["rank_balance"]=_safe_rank(tab["balance_entropy"],True)
    tab["valid"]=(tab["min_cluster_size"]>=max(3,int(.55*c.structural_lens_min_cluster_size)))&(tab["largest_cluster_share"]<=.80)
    tab["score"]=.50*tab["rank_silhouette"]+.30*tab["rank_stability"]+.20*tab["rank_balance"]
    eligible=tab[tab["valid"]] if bool(tab["valid"].any()) else tab;k=int(eligible.sort_values(["score","stability_ari"],ascending=False).iloc[0]["k"])
    labels=store[k];cents={}
    for cid in sorted(set(labels.tolist())):
        idx=np.flatnonzero(labels==cid);cent=np.asarray(z[idx].mean(axis=0),dtype=np.float32);cent=cent/max(float(np.linalg.norm(cent)),1e-12);cents[int(cid)]=cent
    desc=_lens_descriptions(docs,labels)
    model=LensModelV55(name,vec,svd,norm,cents,desc,k,tab[tab["k"]==k].iloc[0].to_dict())
    return model,labels,tab.sort_values(["valid","score"],ascending=[False,False]).reset_index(drop=True),docs


def predict_structural_lens(model:Optional[LensModelV55],records):
    if model is None:return np.ones(len(records),dtype=int),np.ones(len(records),dtype=float)
    builder={"workflow":_workflow_signature,"entity_profile":_entity_profile_signature,"relation_motif":_relation_motif_signature}[model.name]
    z=_transform_lens(model,[builder(r) for r in records]);ids=sorted(model.centroid_vectors);mat=np.vstack([model.centroid_vectors[i] for i in ids]);s=np.asarray(z@mat.T,dtype=float);j=np.argmax(s,axis=1);return np.asarray([ids[int(x)] for x in j],dtype=int),np.asarray([s[i,int(j[i])] for i in range(len(j))],dtype=float)


def lens_catalog(records,labels,name,model:Optional[LensModelV55]):
    labels=np.asarray(labels,dtype=int);rows=[]
    for cid in sorted(set(labels.tolist())):
        idx=np.flatnonzero(labels==cid);rows.append({"lens":name,"cluster_id":int(cid),"meaning":model.descriptions.get(int(cid),f"cluster_{cid}") if model else f"cluster_{cid}","count":len(idx),"share_pct":100*len(idx)/max(len(labels),1),"cohesion":float(np.mean([1.0])) if len(idx) else np.nan})
    return pd.DataFrame(rows).sort_values("count",ascending=False).reset_index(drop=True) if rows else pd.DataFrame()


def _macro_descriptions_from_assignments(records,fine_labels,macro_map,stopwords,topn):
    ml=np.asarray([macro_map.get(int(x),-1) for x in fine_labels],dtype=int);return cluster_descriptions([r["_customer_problem"] for r in records],ml,stopwords,topn),ml


def hierarchical_leaf_catalog(records,v,fine_labels,leaf_ids,leaf_meanings):
    rows=[];fine_labels=np.asarray(fine_labels,dtype=int);leaf_ids=np.asarray(leaf_ids,dtype=object);leaf_meanings=np.asarray(leaf_meanings,dtype=object)
    total=max(len(records),1)
    for leaf in sorted(set(leaf_ids.tolist())):
        idx=np.flatnonzero(leaf_ids==leaf);parent=int(fine_labels[idx[0]]) if len(idx) else -1;cent=np.asarray(v[idx].mean(axis=0),float) if len(idx) else np.zeros(v.shape[1]);cent=cent/max(float(np.linalg.norm(cent)),1e-12);cohesion=float(np.mean(v[idx]@cent)) if len(idx) else np.nan
        sp,_=signature_purity([records[i].get("_semantic_signature","") for i in idx.tolist()],np.ones(len(idx),dtype=int)) if len(idx) else (None,{})
        rows.append({"leaf_id":leaf,"parent_fine_cluster_id":parent,"meaning":str(leaf_meanings[idx[0]]) if len(idx) else leaf,"count":len(idx),"share_pct":100*len(idx)/total,"cohesion":cohesion,"signature_purity":sp})
    return pd.DataFrame(rows).sort_values("count",ascending=False).reset_index(drop=True) if rows else pd.DataFrame()


def _stable_fingerprint_id(parts:Sequence[Any])->str:
    raw="|".join(str(x) for x in parts);return hashlib.sha256(raw.encode("utf-8",errors="ignore")).hexdigest()[:18]


def build_fingerprint_table(records,analysis_by_ref):
    rows=[]
    for r in records:
        a=analysis_by_ref.get(str(r["interaction_ref"]),{})
        parts=[a.get("macro_cluster_id"),a.get("fine_cluster_id"),a.get("leaf_id"),a.get("workflow_cluster_id"),a.get("entity_profile_cluster_id"),a.get("relation_motif_cluster_id")]
        rows.append({"interaction_ref":r["interaction_ref"],"data_split":r.get("data_split"),"fingerprint_id":_stable_fingerprint_id(parts),"macro_cluster_id":a.get("macro_cluster_id"),"fine_cluster_id":a.get("fine_cluster_id"),"leaf_id":a.get("leaf_id"),"fine_primary_score":a.get("primary_score"),"fine_secondary_cluster_id":a.get("secondary_cluster_id"),"fine_secondary_score":a.get("secondary_score"),"fine_margin":a.get("margin"),"fine_confidence_band":a.get("confidence_band"),"fine_cluster_stability":a.get("cluster_stability"),"workflow_cluster_id":a.get("workflow_cluster_id"),"entity_profile_cluster_id":a.get("entity_profile_cluster_id"),"relation_motif_cluster_id":a.get("relation_motif_cluster_id")})
    return pd.DataFrame(rows)


def public_dictionary_record_v55(r,analysis,public_examples_safe,hard_privacy_safe,latent_topic=None):
    cid=int(analysis.get("fine_cluster_id",-1));meaning=str(analysis.get("fine_meaning","UNKNOWN/OUTLIER"));strength=safe_float(analysis.get("primary_score"),0.0);src=str(analysis.get("assignment_source","not_clusterable"))
    out=public_dictionary_record(r,cid,strength,meaning,src,public_examples_safe,hard_privacy_safe,latent_topic)
    out["semantic_cluster"].update({"secondary_cluster_id":int(analysis.get("secondary_cluster_id",-1)),"secondary_score":safe_float(analysis.get("secondary_score"),0.0),"margin":safe_float(analysis.get("margin"),0.0),"confidence_band":str(analysis.get("confidence_band","LOW")),"cluster_stability":safe_float(analysis.get("cluster_stability"),0.0)})
    out["semantic_hierarchy"]={"macro_cluster_id":analysis.get("macro_cluster_id"),"macro_meaning":analysis.get("macro_meaning"),"fine_cluster_id":cid,"fine_meaning":meaning,"leaf_id":analysis.get("leaf_id"),"subintent_id":analysis.get("subintent_id"),"subintent_meaning":analysis.get("subintent_meaning"),"subintent_strength":analysis.get("subintent_strength"),"subintent_stability":analysis.get("subintent_stability")}
    out["workflow_cluster"]={"cluster_id":analysis.get("workflow_cluster_id"),"strength":analysis.get("workflow_strength")}
    out["entity_profile_cluster"]={"cluster_id":analysis.get("entity_profile_cluster_id"),"strength":analysis.get("entity_profile_strength")}
    out["relation_motif_cluster"]={"cluster_id":analysis.get("relation_motif_cluster_id"),"strength":analysis.get("relation_motif_strength")}
    parts=[analysis.get("macro_cluster_id"),cid,analysis.get("leaf_id"),analysis.get("workflow_cluster_id"),analysis.get("entity_profile_cluster_id"),analysis.get("relation_motif_cluster_id")]
    out["interaction_fingerprint"]={"fingerprint_id":_stable_fingerprint_id(parts),"components":{"macro":analysis.get("macro_cluster_id"),"fine":cid,"leaf":analysis.get("leaf_id"),"workflow":analysis.get("workflow_cluster_id"),"entity_profile":analysis.get("entity_profile_cluster_id"),"relation_motif":analysis.get("relation_motif_cluster_id")}}
    out["dictionary_layers"]["analysis"]={"semantic_cluster":out["semantic_cluster"],"semantic_hierarchy":out["semantic_hierarchy"],"workflow_cluster":out["workflow_cluster"],"entity_profile_cluster":out["entity_profile_cluster"],"relation_motif_cluster":out["relation_motif_cluster"],"interaction_fingerprint":out["interaction_fingerprint"],"latent_topic":out.get("latent_topic")}
    return out


def cluster_assignment_table(records):
    rows=[]
    for r in records:
        cl=r.get("semantic_cluster",{});h=r.get("semantic_hierarchy",{});content=r.get("content",{});fp=r.get("interaction_fingerprint",{})
        rows.append({"interaction_ref":r.get("interaction_ref"),"data_split":r.get("data_split"),"macro_cluster_id":h.get("macro_cluster_id"),"macro_meaning":h.get("macro_meaning"),"cluster_id":cl.get("cluster_id"),"cluster_meaning":cl.get("meaning"),"cluster_strength":cl.get("cluster_strength"),"secondary_cluster_id":cl.get("secondary_cluster_id"),"secondary_score":cl.get("secondary_score"),"margin":cl.get("margin"),"confidence_band":cl.get("confidence_band"),"cluster_stability":cl.get("cluster_stability"),"leaf_id":h.get("leaf_id"),"subintent_id":h.get("subintent_id"),"subintent_meaning":h.get("subintent_meaning"),"workflow_cluster_id":(r.get("workflow_cluster") or {}).get("cluster_id"),"entity_profile_cluster_id":(r.get("entity_profile_cluster") or {}).get("cluster_id"),"relation_motif_cluster_id":(r.get("relation_motif_cluster") or {}).get("cluster_id"),"fingerprint_id":fp.get("fingerprint_id"),"assignment_source":cl.get("assignment_source"),"customer_problem_normalized":content.get("customer_problem_normalized",""),"participants":"; ".join(r.get("participants",[])),"top_entities":"; ".join(f"{e.get('entity_type')}:{e.get('canonical_name')}" for e in r.get("entities",[])[:12])})
    return pd.DataFrame(rows)


def interaction_dictionary_table(records):
    rows=[]
    for r in records:
        layers=r.get("dictionary_layers",{}) or {};analysis=layers.get("analysis",{}) or {};cluster=analysis.get("semantic_cluster",{}) or {};hier=analysis.get("semantic_hierarchy",{}) or {};topic=analysis.get("latent_topic",{}) or {}
        rows.append({"interaction_ref":r.get("interaction_ref"),"data_split":r.get("data_split"),"participants":json.dumps(layers.get("participants",{}),ensure_ascii=False),"entities":json.dumps(layers.get("entities",{}),ensure_ascii=False),"context":json.dumps(layers.get("context",{}),ensure_ascii=False),"resolution":json.dumps(layers.get("resolution",{}),ensure_ascii=False),"relations":json.dumps(layers.get("relations",{}),ensure_ascii=False),"macro_cluster_id":hier.get("macro_cluster_id"),"semantic_cluster_id":cluster.get("cluster_id"),"semantic_cluster_meaning":cluster.get("meaning"),"cluster_strength":cluster.get("cluster_strength"),"secondary_cluster_id":cluster.get("secondary_cluster_id"),"margin":cluster.get("margin"),"confidence_band":cluster.get("confidence_band"),"leaf_id":hier.get("leaf_id"),"subintent_meaning":hier.get("subintent_meaning"),"workflow_cluster_id":(analysis.get("workflow_cluster") or {}).get("cluster_id"),"entity_profile_cluster_id":(analysis.get("entity_profile_cluster") or {}).get("cluster_id"),"relation_motif_cluster_id":(analysis.get("relation_motif_cluster") or {}).get("cluster_id"),"fingerprint_id":(analysis.get("interaction_fingerprint") or {}).get("fingerprint_id"),"latent_topic_id":topic.get("topic_id") if isinstance(topic,dict) else None,"latent_topic_meaning":topic.get("meaning") if isinstance(topic,dict) else None})
    return pd.DataFrame(rows)


def save_named_heatmap(v,labels,descriptions,path,title,topn=30):
    labels=np.asarray(labels,dtype=int);ids=sorted(set(labels.tolist()))
    if len(ids)<2:return
    counts={cid:int(np.sum(labels==cid)) for cid in ids};ids=sorted(ids,key=lambda x:counts[x],reverse=True)[:max(2,topn)];cents=[]
    for cid in ids:
        x=np.asarray(v[labels==cid].mean(axis=0),float);cents.append(x/max(float(np.linalg.norm(x)),1e-12))
    mat=np.clip(np.vstack(cents)@np.vstack(cents).T,-1,1)
    if len(ids)>=3:
        d=np.clip(1-mat,0,2);np.fill_diagonal(d,0);order=leaves_list(linkage(squareform(d,checks=False),method="average")).tolist();ids=[ids[i] for i in order];mat=mat[np.ix_(order,order)]
    def dsc(cid):
        x=descriptions.get(cid,"") if isinstance(descriptions,dict) else "";x=x.get("descriptor","") if isinstance(x,dict) else x;return str(x or f"cluster_{cid}")
    names=[f"{cid}: {dsc(cid)[:32]}" for cid in ids];size=max(8,min(18,.55*len(ids)+5));fig,ax=plt.subplots(figsize=(size,size));im=ax.imshow(mat,vmin=-1,vmax=1,aspect="auto",cmap="coolwarm");ax.set_title(title);ax.set_xticks(np.arange(len(ids)));ax.set_yticks(np.arange(len(ids)));ax.set_xticklabels(names,rotation=90,fontsize=8);ax.set_yticklabels(names,fontsize=8)
    if len(ids)<=24:
        for i in range(len(ids)):
            for j in range(len(ids)):ax.text(j,i,f"{mat[i,j]:.2f}",ha="center",va="center",fontsize=6)
    fig.colorbar(im,ax=ax,fraction=.046,pad=.04,label="Centroid cosine similarity");fig.tight_layout();fig.savefig(path,dpi=180,bbox_inches="tight");plt.close(fig)


def build_v55_readiness_gate(records,cluster_records,labels,privacy_summary,validation_metrics,c:ConfigV55,fine_stability:float,low_conf_fraction:float,leaf_coverage:float):
    status,base,metrics=build_business_gate(records,cluster_records,labels,privacy_summary,validation_metrics,c)
    extra=[
        {"check":"full_coverage_contract","status":"PASS" if float(np.mean(np.asarray(labels)!=-1))>=.98 else "FAIL","value":float(np.mean(np.asarray(labels)!=-1)),"required":">=0.98"},
        {"check":"fine_partition_stability","status":"PASS" if fine_stability>=c.analytics_min_fine_stability else "FAIL","value":fine_stability,"required":f">={c.analytics_min_fine_stability}"},
        {"check":"hierarchical_leaf_coverage","status":"PASS" if leaf_coverage>=.98 else "FAIL","value":leaf_coverage,"required":">=0.98"},
        {"check":"low_confidence_fraction","status":"PASS" if low_conf_fraction<=c.analytics_max_low_confidence_fraction else "FAIL","value":low_conf_fraction,"required":f"<={c.analytics_max_low_confidence_fraction}"},
    ]
    out=pd.concat([base,pd.DataFrame(extra)],ignore_index=True);analytic=out[out["check"]!="privacy_review_status"];final="PASS" if bool((analytic["status"]=="PASS").all()) else "FAIL"
    metrics.update({"fine_partition_stability":fine_stability,"low_confidence_fraction":low_conf_fraction,"hierarchical_leaf_coverage":leaf_coverage})
    return final,out,metrics


def _html_table(df,cols=None):
    if df is None or df.empty:return "<p>No rows.</p>"
    x=df[cols] if cols else df
    return x.to_html(index=False,escape=True,float_format=lambda z:f"{z:.4f}" if isinstance(z,(float,np.floating)) and np.isfinite(z) else str(z))


def write_html_summary_v55(outdir,report,fine_catalog,macro_catalog,leaf_catalog,workflow_catalog,entity_profile_catalog,relation_motif_catalog,participant_summary,entity_summary,context_summary,root_summary,relation_summary,stat_gate,analytics_gate,fine_sim,subintent_audit,fingerprint_summary,public_examples_safe):
    ex=Path(outdir)/"executive";ex.mkdir(parents=True,exist_ok=True);counts=report["counts"];privacy=report["privacy"]
    parts=["<!doctype html><html><head><meta charset='utf-8'><title>NORA Entity-Context v5.5</title><style>body{font-family:Arial,sans-serif;margin:28px;color:#222}table{border-collapse:collapse;width:100%;margin:12px 0 24px}th,td{border:1px solid #ccc;padding:7px;font-size:13px;vertical-align:top}th{background:#111;color:#fff}.card{background:#f4f4f4;padding:16px;border-radius:8px;margin:12px 0}.warn{background:#fff4e5;padding:12px}.ok{background:#ecf8ee;padding:12px}</style></head><body>","<h1>NORA Entity-Context v5.5 — Hierarchical Sub-Intent Discovery + Stability + Cross-Lens Interaction Fingerprinting</h1>"]
    parts.append(f"<div class='card'><b>Execution:</b> {report['execution_status']}<br><b>Statistical validation:</b> {report['statistical_validation_status']}<br><b>Analytics readiness:</b> {report['analytics_readiness_status']}<br><b>Privacy review:</b> {privacy.get('residual_gate_status')}<br><b>Interactions:</b> {counts['interactions']}<br><b>Clusterable customer interactions:</b> {counts['clusterable_customer_interactions']}<br><b>Fine semantic clusters:</b> {counts['fine_semantic_clusters']}<br><b>Hierarchical leaf clusters:</b> {counts['hierarchical_leaf_clusters']}<br><b>Macro semantic clusters:</b> {counts['macro_semantic_clusters']}<br><b>Fine semantic assignment coverage:</b> {counts['fine_assignment_coverage_pct']:.2f}%<br><b>Workflow clusters:</b> {counts['workflow_clusters']}<br><b>Entity-profile clusters:</b> {counts['entity_profile_clusters']}<br><b>Relation-motif clusters:</b> {counts['relation_motif_clusters']}<br><b>Entities:</b> {counts['entities']} &nbsp; <b>Contexts:</b> {counts['context_records']} &nbsp; <b>Relations:</b> {counts['relationships']}</div>")
    parts.append("<div class='ok'><b>Coverage contract:</b> every interaction with a usable normalized customer problem receives a fine semantic cluster. Low confidence is retained as an uncertainty flag, not converted into an outlier.</div>")
    if privacy.get("residual_gate_status")!="PASS":parts.append("<div class='warn'><b>Privacy review is reported separately.</b> Structured analytics remain available under the existing public-text suppression rules.</div>")
    parts += ["<h2>Fine semantic clusters — primary customer-problem partition</h2>",_html_table(fine_catalog),"<h2>Hierarchical sub-intent leaves</h2>",_html_table(leaf_catalog),"<h2>Sub-intent stability audit</h2>",_html_table(subintent_audit),"<h2>Macro semantic clusters — higher-level families</h2>",_html_table(macro_catalog),"<h2>Workflow / interaction-pattern clusters</h2>",_html_table(workflow_catalog),"<h2>Entity-configuration clusters</h2>",_html_table(entity_profile_catalog),"<h2>Relation-structure motif clusters</h2>",_html_table(relation_motif_catalog),"<h2>Cross-lens fingerprint summary</h2>",_html_table(fingerprint_summary.head(30) if fingerprint_summary is not None else pd.DataFrame()),"<h2>Participants</h2>",_html_table(participant_summary),"<h2>Entity extraction</h2>",_html_table(entity_summary),"<h2>Context extraction</h2>",_html_table(context_summary),"<h2>Relation structure</h2>",_html_table(relation_summary),"<h2>Root-cause status</h2>",_html_table(root_summary),"<h2>Statistical validation gate</h2>",_html_table(stat_gate),"<h2>Analytics readiness gate</h2>",_html_table(analytics_gate)]
    if fine_sim is not None and not fine_sim.empty:parts += ["<h2>Most similar fine semantic cluster pairs</h2>",_html_table(fine_sim.head(30))]
    for img,title in (("fine_semantic_cluster_similarity.png","Fine semantic cluster similarity"),("macro_semantic_cluster_similarity.png","Macro semantic cluster similarity"),("workflow_cluster_similarity.png","Workflow cluster similarity"),("entity_profile_cluster_similarity.png","Entity profile cluster similarity"),("relation_motif_cluster_similarity.png","Relation motif cluster similarity"),("fine_semantic_cluster_projection.png","Fine semantic 2D diagnostic projection"),("fine_semantic_cluster_size_distribution.png","Fine semantic cluster size distribution"),("entity_type_counts.png","Entity extraction counts")):
        if (Path(outdir)/img).exists():parts += [f"<h2>{title}</h2>",f"<img src='../{img}' style='max-width:100%'>"]
    parts += ["<h2>Structured dictionary output</h2><p>Each interaction contains semantic macro + fine + hierarchical leaf assignments, soft-membership confidence, workflow/entity-profile/relation-motif structural clusters, latent topics, participants, entities, context, RCA/remediation, typed relations, and a deterministic cross-lens fingerprint.</p>","<h2>Method</h2><p>Classical/local NLP only: deterministic privacy handling → train-only problem normalization → precision entity/context/RCA/remediation extraction → word/character/structure-signature TF-IDF → LSA + NMF + locally trained PPMI/SVD/SIF representations → repeated-seed full-coverage centroid partition search → locked-test validation → stability-gated local sub-intent splitting → macro family discovery → independent workflow/entity-profile/relation-motif clustering → cross-lens interaction fingerprinting. No pretrained language model or external model download is used.</p>","</body></html>"]
    path=ex/"nora_entity_context_v5_5_summary.html";path.write_text("".join(parts),encoding="utf-8");return path


def _analysis_map_for_records(clusterable,cv,fine_model,fine_desc,fine_stability,macro_map,macro_desc,submodels,workflow_model,entity_model,relation_model,all_records,c:ConfigV55):
    fl,ps,sl,ss,margin,src=_full_centroid_predict(fine_model,cv)
    leaf,child,sstrength,sstability,smeaning=assign_subintents(cv,fl,submodels,fine_desc)
    workflow_labels,workflow_strength=predict_structural_lens(workflow_model,clusterable)
    entity_labels,entity_strength=predict_structural_lens(entity_model,clusterable)
    relation_labels,relation_strength=predict_structural_lens(relation_model,clusterable)
    amap={}
    for i,r in enumerate(clusterable):
        fid=int(fl[i]);stab=float(fine_stability.get(fid,0.0));mid=int(macro_map.get(fid,-1));conf=_confidence_band(float(ps[i]),float(margin[i]),stab,c)
        amap[str(r["interaction_ref"])]={"fine_cluster_id":fid,"fine_meaning":fine_desc.get(fid,{}).get("descriptor",f"cluster_{fid}"),"primary_score":float(ps[i]),"secondary_cluster_id":int(sl[i]),"secondary_score":float(ss[i]),"margin":float(margin[i]),"confidence_band":conf,"cluster_stability":stab,"assignment_source":str(src[i]),"macro_cluster_id":mid,"macro_meaning":macro_desc.get(mid,{}).get("descriptor",f"macro_{mid}"),"leaf_id":str(leaf[i]),"subintent_id":int(child[i]),"subintent_meaning":str(smeaning[i]),"subintent_strength":float(sstrength[i]),"subintent_stability":float(sstability[i]),"workflow_cluster_id":int(workflow_labels[i]),"workflow_strength":float(workflow_strength[i]),"entity_profile_cluster_id":int(entity_labels[i]),"entity_profile_strength":float(entity_strength[i]),"relation_motif_cluster_id":int(relation_labels[i]),"relation_motif_strength":float(relation_strength[i])}
    for r in all_records:
        if str(r["interaction_ref"]) not in amap:
            amap[str(r["interaction_ref"])]={"fine_cluster_id":-1,"fine_meaning":"NOT_CLUSTERABLE","primary_score":0.0,"secondary_cluster_id":-1,"secondary_score":0.0,"margin":0.0,"confidence_band":"NOT_CLUSTERABLE","cluster_stability":0.0,"assignment_source":"not_clusterable","macro_cluster_id":-1,"macro_meaning":"NOT_CLUSTERABLE","leaf_id":"NOT_CLUSTERABLE","subintent_id":-1,"subintent_meaning":"NOT_CLUSTERABLE","subintent_strength":0.0,"subintent_stability":0.0,"workflow_cluster_id":-1,"workflow_strength":0.0,"entity_profile_cluster_id":-1,"entity_profile_strength":0.0,"relation_motif_cluster_id":-1,"relation_motif_strength":0.0}
    return amap,fl,leaf,workflow_labels,entity_labels,relation_labels


def run_train_v55(c:ConfigV55):
    np.random.seed(c.seed);outdir=Path(c.outdir);diag=outdir/"diagnostics";ex=outdir/"executive";outdir.mkdir(parents=True,exist_ok=True);diag.mkdir(parents=True,exist_ok=True);ex.mkdir(parents=True,exist_ok=True);stages=[];started=utc_now_iso()
    t=time.perf_counter();frame,schema=load_raw_frame(c);frame,split_audit=assign_splits(frame,c);frame,privacy_summary,residual_df=privacy_prepare_frame(frame);key,key_source=resolve_pseudonym_key(c);frame["_row_ref"]=[pseudonymize(f"{g}|{rid}",key) for g,rid in zip(frame["_group"].astype(str),frame["_row_id"].astype(str))];interactions=aggregate_interactions(frame,key);public_examples_safe=bool(privacy_summary.get("public_examples_safe",False));hard_privacy_safe=bool(privacy_summary.get("model_persistence_safe",False));safe_residual=_privacy_safe_residual_table(residual_df);safe_residual.to_csv(diag/"residual_pii_findings.csv",index=False);stages.append({"stage":"load_split_privacy","seconds":time.perf_counter()-t})
    t=time.perf_counter();ontology=load_ontology(c.ontology_path);ontology_matcher=OntologyMatcher(ontology);stopwords=load_stopword_seed(c.stopword_seed_path);pd.DataFrame({"term":sorted(stopwords)}).to_csv(diag/"stopword_seed_used.csv",index=False);stages.append({"stage":"controlled_vocabulary_load","seconds":time.perf_counter()-t})
    t=time.perf_counter();train_customer=interactions[(interactions["data_split"]=="train")&(interactions["customer_text"].map(lambda x:len(tokenize(x))>=c.min_problem_tokens))].copy().reset_index(drop=True)
    if len(train_customer)<20:raise RuntimeError(f"Too few train customer interactions: {len(train_customer)}")
    normalizer=fit_problem_normalizer(train_customer["customer_text"].astype(str).tolist(),c,stopwords);pd.DataFrame({"learned_template_phrase":sorted(normalizer.learned_template_phrases)}).to_csv(diag/"learned_problem_templates.csv",index=False);stages.append({"stage":"train_only_problem_normalizer","seconds":time.perf_counter()-t})
    t=time.perf_counter();records=build_records(frame,interactions,normalizer,ontology_matcher,stopwords,c);clusterable=[r for r in records if len(tokenize(r["_customer_problem"]))>=c.min_problem_tokens];train_records=[r for r in clusterable if r["data_split"]=="train"];val_records=[r for r in clusterable if r["data_split"]=="validation"];test_records=[r for r in clusterable if r["data_split"]=="locked_test"]
    if len(train_records)<20 or len(val_records)<5 or len(test_records)<5:raise RuntimeError(f"Insufficient normalized problems: train={len(train_records)} validation={len(val_records)} locked={len(test_records)}")
    stages.append({"stage":"structured_extraction_and_normalization","seconds":time.perf_counter()-t})
    t=time.perf_counter();representation,tv=fit_representation([r["_customer_problem"] for r in train_records],[r["_semantic_signature"] for r in train_records],c,stopwords);vv=transform_representation(representation,[r["_customer_problem"] for r in val_records],[r["_semantic_signature"] for r in val_records]);selection_model,sel_tl,sel_vl,search,best=fit_full_coverage_fine_model(tv,[r["_customer_problem"] for r in train_records],[r["_semantic_signature"] for r in train_records],vv,[r["_customer_problem"] for r in val_records],[r["_semantic_signature"] for r in val_records],stopwords,c);search.to_csv(diag/"fine_cluster_model_search.csv",index=False);selected_k=int(best["candidate_k"]);selection_val_metrics=evaluate_clustering(vv,sel_vl,[r["_customer_problem"] for r in val_records],stopwords,c,bootstrap=True,signatures=[r["_semantic_signature"] for r in val_records]);stages.append({"stage":"fine_partition_model_selection","seconds":time.perf_counter()-t})
    t=time.perf_counter();dev_records=train_records+val_records;dev_v=np.vstack([tv,vv]);fine_model,dev_labels=refit_fine_model(dev_v,selected_k,c);fine_desc=cluster_descriptions([r["_customer_problem"] for r in dev_records],dev_labels,stopwords,c.top_cluster_terms);dev_consensus,fine_stability,overall_stability=consensus_stability_profile(dev_v,dev_labels,selected_k,c.seed+2701,max(c.stability_repeats,5));pd.DataFrame({"interaction_ref":[r["interaction_ref"] for r in dev_records],"fine_cluster_id":dev_labels,"consensus_stability":dev_consensus}).to_csv(diag/"fine_cluster_consensus_stability.csv",index=False);stages.append({"stage":"fine_partition_refit_and_consensus","seconds":time.perf_counter()-t})
    t=time.perf_counter();xv=transform_representation(representation,[r["_customer_problem"] for r in test_records],[r["_semantic_signature"] for r in test_records]);test_labels,*_= _full_centroid_predict(fine_model,xv);test_metrics=evaluate_clustering(xv,test_labels,[r["_customer_problem"] for r in test_records],stopwords,c,bootstrap=True,signatures=[r["_semantic_signature"] for r in test_records]);stat_status,stat_gate=build_statistical_gate(selection_val_metrics,test_metrics);stat_gate.to_csv(diag/"statistical_validation_gate.csv",index=False);stages.append({"stage":"locked_test_evaluation","seconds":time.perf_counter()-t})
    t=time.perf_counter();cv=transform_representation(representation,[r["_customer_problem"] for r in clusterable],[r["_semantic_signature"] for r in clusterable]);fine_labels,primary_scores,secondary_labels,secondary_scores,margins,_=_full_centroid_predict(fine_model,cv);all_metrics=evaluate_clustering(cv,fine_labels,[r["_customer_problem"] for r in clusterable],stopwords,c,signatures=[r["_semantic_signature"] for r in clusterable]);fine_counts=Counter(fine_labels.tolist());macro_map,macro_placeholder,macro_search=fit_macro_clusters(fine_model,fine_counts,c);macro_search.to_csv(diag/"macro_cluster_model_search.csv",index=False);macro_desc,macro_labels=_macro_descriptions_from_assignments(clusterable,fine_labels,macro_map,stopwords,c.top_cluster_terms);submodels,subaudit=discover_subintents(dev_records,dev_v,dev_labels,stopwords,c);subaudit.to_csv(diag/"subintent_split_audit.csv",index=False);leaf_ids,child_ids,sub_strength,sub_stability,sub_meaning=assign_subintents(cv,fine_labels,submodels,fine_desc);leaf_catalog=hierarchical_leaf_catalog(clusterable,cv,fine_labels,leaf_ids,sub_meaning);stages.append({"stage":"semantic_hierarchy_and_subintent_discovery","seconds":time.perf_counter()-t})
