TIME_RE=re.compile(r"(?i)\b(?:today|yesterday|tomorrow|last\s+(?:night|week|month)|since\s+\w+|for\s+\d+\s+(?:minutes?|hours?|days?|weeks?|months?)|\d+\s+(?:minutes?|hours?|days?|weeks?|months?)\s+ago)\b"); REQUEST_CUE_RE=re.compile(r"(?i)\b(?:need|needs|needed|want|wants|wanted|request(?:ed)?|question|questions|help\s+with|move|moved|transfer|cancel|activate|deactivate|change|replace|port)\b")
CALL_CENTER_RE=re.compile(r"(?i)\b(?:call\s*center|contact\s*center|care\s*center|customer\s*care|business\s*care)\b"); USER_MENTION_RE=re.compile(r"(?i)\buser\b"); CUSTOMER_MENTION_RE=re.compile(r"(?i)\bcustomer\b")
MEASUREMENT_RE=re.compile(r"(?i)\b(?P<key>[A-Za-z][A-Za-z0-9 _/\-]{1,45}?)\s*[:=]?\s*(?P<value>-?\d+(?:\.\d+)?)\s*(?P<unit>dBm|dB|ms|s|sec|seconds?|Mbps|Gbps|Kbps|MB|GB|GiB|%|MHz|GHz|kHz|mV|V|A|mA|W|hours?|hrs?|minutes?|mins?)\b"); KV_RE=re.compile(r"(?im)(?P<key>[A-Za-z][A-Za-z0-9 _/\-]{1,45})\s*[:=]\s*(?P<value>[^\n|;]{1,100})"); ERROR_CODE_RE=re.compile(r"(?i)\b(?:error|code|status)\s*[:=#-]?\s*([A-Z]{1,10}[-_]?\d{2,8}|\d{3,8})\b")
