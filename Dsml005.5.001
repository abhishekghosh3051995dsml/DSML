        bundle=PipelineBundleV55(PIPELINE_NAME,PIPELINE_VERSION,[asdict(x) for x in ontology],sorted(stopwords),normalizer,representation,fine_model,fine_desc,{int(k):float(v) for k,v in fine_stability.items()},{int(k):int(v) for k,v in macro_map.items()},macro_desc,submodels,workflow_model,entity_model,relation_model,{k:v for k,v in asdict(c).items() if k not in {"input_path","outdir","model_dir","persist_model"}});mp=outdir/"nora_entity_context_v5_5_model.joblib";joblib.dump({"artifact_format":ARTIFACT_FORMAT_VERSION,"code_fingerprint_sha256":current_code_fingerprint(),"runtime_versions":package_versions(),"bundle":bundle},mp,compress=3);model_info={"model_file":mp.name,"model_sha256":sha256_file(mp)}
    elif c.persist_model:LOGGER.warning("Model persistence skipped because HARD privacy residue remains.")
    report["model"]=model_info;rp.write_text(json.dumps(to_plain(report),indent=2,ensure_ascii=False),encoding="utf-8");manifest={"artifact_format":ARTIFACT_FORMAT_VERSION,"pipeline":PIPELINE_NAME,"pipeline_version":PIPELINE_VERSION,"created_at_utc":utc_now_iso(),"code_fingerprint_sha256":current_code_fingerprint(),"runtime_versions":package_versions(),"external_pretrained_models_used":False,"artifacts":{"model":model_info,"report":{"file":rp.name,"sha256":sha256_file(rp)},"dictionary_json":{"file":jsonp.name,"sha256":sha256_file(jsonp)},"dictionary_jsonl":{"file":jsonl.name,"sha256":sha256_file(jsonl)},"html":{"file":str(html.relative_to(outdir)),"sha256":sha256_file(html)}}};(outdir/"model_manifest.json").write_text(json.dumps(to_plain(manifest),indent=2,ensure_ascii=False),encoding="utf-8");LOGGER.info("COMPLETE V5.5: statistical=%s analytics=%s fine=%d leaves=%d macro=%d coverage=100.00%% stability=%.3f privacy=%s",stat_status,analytics_status,counts["fine_semantic_clusters"],counts["hierarchical_leaf_clusters"],counts["macro_semantic_clusters"],overall_stability,privacy_summary["residual_gate_status"]);return report


def run_inference_v55(c:ConfigV55):
    outdir=Path(c.outdir);outdir.mkdir(parents=True,exist_ok=True);md=Path(c.model_dir or "");manifest_path=md/"model_manifest.json"
    if not manifest_path.exists():raise FileNotFoundError(f"Model manifest not found: {manifest_path}")
    manifest=json.loads(manifest_path.read_text(encoding="utf-8"));meta=manifest.get("artifacts",{}).get("model",{});model_file=meta.get("model_file")
    if not model_file:raise RuntimeError("Persisted V5.5 model unavailable.")
    payload=joblib.load(md/model_file)
    if payload.get("artifact_format")!=ARTIFACT_FORMAT_VERSION:raise RuntimeError("Artifact format mismatch.")
    if payload.get("code_fingerprint_sha256")!=current_code_fingerprint():raise RuntimeError("Code fingerprint mismatch between training and inference runtime.")
    bundle=payload["bundle"];frame,schema=load_raw_frame(c);frame["data_split"]="inference";frame,privacy_summary,residual_df=privacy_prepare_frame(frame);key,key_source=resolve_pseudonym_key(c);frame["_row_ref"]=[pseudonymize(f"{g}|{rid}",key) for g,rid in zip(frame["_group"].astype(str),frame["_row_id"].astype(str))];interactions=aggregate_interactions(frame,key);matcher=OntologyMatcher([OntologyEntry(**x) for x in bundle.ontology]);records=build_records(frame,interactions,bundle.problem_normalizer,matcher,set(bundle.stopwords),c);clusterable=[r for r in records if len(tokenize(r["_customer_problem"]))>=c.min_problem_tokens]
    if clusterable:
        cv=transform_representation(bundle.representation,[r["_customer_problem"] for r in clusterable],[r["_semantic_signature"] for r in clusterable]);analysis_map,_,_,_,_,_=_analysis_map_for_records(clusterable,cv,bundle.fine_cluster_model,bundle.fine_descriptions,bundle.fine_cluster_stability,bundle.macro_map,bundle.macro_descriptions,bundle.subintent_models,bundle.workflow_model,bundle.entity_profile_model,bundle.relation_motif_model,records,c)
    else:analysis_map={str(r["interaction_ref"]):{"fine_cluster_id":-1,"fine_meaning":"NOT_CLUSTERABLE","assignment_source":"not_clusterable"} for r in records}
    topic_assign,topic_catalog,topic_map=latent_topic_tables(clusterable,bundle.representation);public_examples_safe=bool(privacy_summary.get("public_examples_safe",False));hard_privacy_safe=bool(privacy_summary.get("model_persistence_safe",False));public=[public_dictionary_record_v55(r,analysis_map[str(r["interaction_ref"])],public_examples_safe,hard_privacy_safe,topic_map.get(str(r["interaction_ref"]))) for r in records];out=outdir/"nora_entity_context_v5_5_inference.jsonl"
    with out.open("w",encoding="utf-8") as h:
        for r in public:h.write(json.dumps(to_plain(r),ensure_ascii=False)+"\n")
    cluster_assignment_table(public).to_csv(outdir/"semantic_cluster_assignments.csv",index=False);interaction_dictionary_table(public).to_csv(outdir/"interaction_dictionary.csv",index=False);flatten_field(public,"entities").to_csv(outdir/"entities.csv",index=False);flatten_field(public,"relationships").to_csv(outdir/"relationships.csv",index=False);fingerprints=build_fingerprint_table(records,analysis_map);fingerprints.to_csv(outdir/"interaction_fingerprints.csv",index=False);rep={"pipeline":PIPELINE_NAME,"pipeline_version":PIPELINE_VERSION,"mode":"infer","execution_status":"SUCCESS","privacy_review_status":privacy_summary["residual_gate_status"],"input_rows":len(frame),"interaction_records":len(public),"clusterable_customer_interactions":len(clusterable),"assigned_fraction":1.0 if clusterable else 0.0,"external_pretrained_models_used":False,"pseudonym_key_source":key_source,"schema":schema,"output":out.name};(outdir/"nora_entity_context_v5_5_inference_report.json").write_text(json.dumps(to_plain(rep),indent=2,ensure_ascii=False),encoding="utf-8");return rep


def parse_args_v55(argv=None):
    p=argparse.ArgumentParser(description=PIPELINE_NAME)
    p.add_argument("--mode",choices=["train","infer"],default="train");p.add_argument("--profile",choices=["fast_dev","production"],default="production");p.add_argument("--input",required=True,dest="input_path");p.add_argument("--outdir",default="nora_entity_context_v5_5_out");p.add_argument("--model-dir");p.add_argument("--ontology",dest="ontology_path",help="Optional internally approved CSV/JSON/JSONL ontology. No external model download.");p.add_argument("--stopword-seed",dest="stopword_seed_path");p.add_argument("--seed",type=int,default=DEFAULT_SEED);p.add_argument("--sample",type=int,default=0,dest="sample_rows");p.add_argument("--test-size",type=float,default=.20);p.add_argument("--validation-within-development",type=float,default=.15);p.add_argument("--split-trials",type=int,default=64)
