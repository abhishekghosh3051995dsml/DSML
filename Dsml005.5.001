BOILERPLATE_CUE_RE=re.compile(r"(?i)\b(?:customer\s+called|called\s+in|contacted\s+today|no\s+changes\s+made|warm\s+transfer|verified?\s+(?:the\s+)?account|account\s+verified|no\s+account\s+pop|with\s+issue|n/?a\s*#?|email\s*:?\s*n/?a|business\s+care|customer\s+care|connected\s+(?:the\s+)?customer|transfer(?:red)?\s+to)\b"); LEADIN_RE=re.compile(r"(?i)^\s*(?:customer|subscriber|caller|user)?\s*(?:called|contacted|reported|stated|says?|said|is\s+reporting|wanted\s+to\s+know|needs?\s+help\s+with)\b\s*(?:(?:in|today|us|to\s+report|regarding|about|that)\b)?\s*[:,-]?\s*")
KEY_REJECT_PREFIX=re.compile(r"(?i)^(?:the|a|an|this|that|there|customer|user|assistant|analysis|conclusion|summary|note|notes|following|result|results|because|however|therefore)\b"); KEY_SENTENCE_VERB_RE=re.compile(r"(?i)\b(?:is|are|was|were|has|have|had|can|could|should|would|will|reported|stated|called|shows?|showed|indicates?|provided|resulted)\b"); GENERIC_ATTRIBUTE_KEYS={"issue","issues","with issue","customer","user","details","detail","information","summary","conclusion","notes","note"}


