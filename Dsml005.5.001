PIPELINE_NAME="NORA Entity-Context v5.5 Hierarchical/Stability/Fingerprints Classical NLP"; PIPELINE_VERSION="5.5.0"; ARTIFACT_FORMAT_VERSION="nora-entity-context-v5-classical-bundle-5"; DEFAULT_SEED=42
LOGGER=logging.getLogger("nora_entity_context_v_5_5")
TOKEN_RE=re.compile(r"(?u)\b[a-zA-Z][a-zA-Z0-9_+'\-\.]{1,}\b"); SENTENCE_SPLIT_RE=re.compile(r"(?<=[.!?;])\s+|\n+|\s*\|\s*"); CLAUSE_SPLIT_RE=re.compile(r"(?<=[.!?;])\s+|\n+|\s*\|\s*|\s{2,}")
SCRIPT_STYLE_RE=re.compile(r"(?is)<(?:script|style)\b[^>]*>.*?</(?:script|style)>"); HTML_TAG_RE=re.compile(r"(?is)<[^>]+>"); CSS_FRAGMENT_RE=re.compile(r"(?i)\b(?:style|color|font|background|border|padding|margin|display|width|height)\s*[:=]\s*[^;|,]+[;]?")
