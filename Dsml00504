                    "train_silhouette_cosine":tm.get("silhouette_cosine"),"train_coherence":tm.get("semantic_coherence_npmi"),"train_signature_purity":tm.get("signature_purity"),
                    "validation_silhouette_cosine":vm.get("silhouette_cosine"),"validation_coherence":vm.get("semantic_coherence_npmi"),"validation_signature_purity":vm.get("signature_purity"),
                    "validation_balance_entropy":vm.get("balance_entropy"),"validation_largest_cluster_share":vm.get("largest_cluster_share"),"validation_centroid_separation":vm.get("centroid_separation"),
                    "validation_tiny_cluster_fraction":vm.get("tiny_cluster_fraction"),"stability_ari":stability,"resolution_fit":resolution_fit,
