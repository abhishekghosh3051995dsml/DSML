def pooled_tolerance(a,b,metric):
    sa=safe_float(a.get(f"{metric}_standard_error"),float("nan"));sb=safe_float(b.get(f"{metric}_standard_error"),float("nan"))
    if np.isfinite(sa) and np.isfinite(sb):return float(2.0*math.sqrt(sa*sa+sb*sb))
    if np.isfinite(sa):return float(2.0*sa)
    if np.isfinite(sb):return float(2.0*sb)
    return None

def build_statistical_gate(validation,locked):
    rows=[]
    for metric in ("silhouette","semantic_coherence_npmi","signature_purity","assigned_fraction"):
        v=validation.get(metric);t=locked.get(metric);tol=pooled_tolerance(validation,locked,metric)
        if v is None or t is None or not np.isfinite(safe_float(v,float("nan"))) or not np.isfinite(safe_float(t,float("nan"))):status="WARN";delta=None
        else:
            delta=float(t)-float(v);status="PASS" if tol is not None and delta>=-tol else "WARN" if tol is None else "FAIL"
        rows.append({"check":f"locked_{metric}_non_regression","status":status,"validation":v,"locked_test":t,"delta":delta,"data_driven_tolerance":tol})
    rows.append({"check":"validation_cluster_coverage","status":"PASS" if int(validation.get("n_clusters") or 0)>=2 else "FAIL","validation":validation.get("n_clusters"),"locked_test":locked.get("n_clusters")})
    rows.append({"check":"locked_cluster_coverage","status":"PASS" if int(locked.get("n_clusters") or 0)>=2 else "FAIL","validation":validation.get("n_clusters"),"locked_test":locked.get("n_clusters")})
    status="FAIL" if any(x["status"]=="FAIL" for x in rows) else "WARN" if any(x["status"]=="WARN" for x in rows) else "PASS";return status,pd.DataFrame(rows)

def _problem_normalization_coverage(records,c):
