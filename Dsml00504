def _fit_vectorizer_with_fallback(vectorizer,texts):
    try:return vectorizer.fit_transform(texts)
    except ValueError:
        vectorizer.set_params(min_df=1,max_df=1.0);return vectorizer.fit_transform(texts)

def _choose_topic_components(n_docs,n_features,requested):
    upper=max(2,min(24,n_docs-1,n_features-1))
    if requested and requested>0:return max(2,min(int(requested),upper))
    return max(2,min(16,int(round(math.sqrt(max(n_docs,4))/1.5)),upper))


def _build_local_distributional_model(texts:Sequence[str],c:Config,stopwords:set[str])->Tuple[Optional[LocalDistributionalModel],np.ndarray]:
    """Train local PPMI/SVD word embeddings and SIF document vectors.

