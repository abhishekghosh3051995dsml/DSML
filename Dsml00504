            specificity=math.log((len(records)+1)/(global_counter.get(k,0)+1))+1.0
            scored.append((k,float(v)*specificity/max(len(idx),1)))
        scored.sort(key=lambda x:(-x[1],x[0]));terms=[k for k,_ in scored[:topn]]
        pretty=[]
