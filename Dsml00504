    pronouns={"the","their","my","your","this","that","our","a","an"}
    explicit=re.compile(r"(?i)\b(?:device|phone|handset|router|gateway|modem|watch|tablet)?\s*model\s*[:=#-]\s*(?P<model>[A-Za-z0-9][A-Za-z0-9+_.\-/]*(?:\s+[A-Za-z0-9][A-Za-z0-9+_.\-/]*){0,3})")
    contextual=re.compile(r"(?i)\b(?:using|on|with)\s+(?:an?\s+)?(?P<model>[A-Za-z][A-Za-z0-9+_.\-]{1,24}\s+[A-Za-z0-9][A-Za-z0-9+_.\-]{0,24}(?:\s+[A-Za-z0-9][A-Za-z0-9+_.\-]{0,24})?)")
