            pretty.append(" → ".join(parts[1:]) if len(parts)>1 else t)
        out[int(cid)]={"descriptor":" / ".join(pretty[:3]) or f"{lens}_{cid}","keywords":[{"term":k,"weight":w} for k,w in scored[:topn]]}
    return out


