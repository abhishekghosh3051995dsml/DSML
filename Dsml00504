def _v54_cosine_silhouette(v, labels, seed):
    labels=np.asarray(labels,dtype=int)
    if len(labels)<4 or len(set(labels.tolist()))<2:return None
    try:
        return float(silhouette_score(v,labels,metric="cosine",sample_size=min(5000,len(labels)),random_state=seed))
    except Exception:return None


def _v54_resolution_candidates(n:int,scale:float,min_k:int,max_k:int,width:float)->List[int]:
    """Data-driven resolution range around scale*sqrt(n).

    This intentionally avoids a fixed target such as 12 or 40 clusters. As the
    corpus grows, the candidate resolution grows sub-linearly while preserving
    enough observations per cluster for stable descriptions.
    """
    if n<6:return [2]
    hard_max=max(2,min(int(max_k),n//max(2,4)))
    base=max(int(min_k),int(round(float(scale)*math.sqrt(max(n,1)))))
    base=min(base,hard_max)
    lo=max(int(min_k),int(round(base*(1.0-max(.10,min(width,.85))))))
    hi=min(hard_max,max(lo+2,int(round(base*(1.0+max(.10,min(width,.85)))))))
    grid=np.linspace(lo,hi,num=min(11,max(4,hi-lo+1)))
    vals={int(round(x)) for x in grid}
    vals.update({base,max(int(min_k),base-1),min(hard_max,base+1)})
    return sorted(k for k in vals if 2<=k<n)


def _v54_centroid_separation(v,labels)->float:
    labels=np.asarray(labels,dtype=int);ids=sorted(set(labels.tolist()))
    if len(ids)<2:return 0.0
    cents=[]
    for cid in ids:
        c=np.asarray(v[labels==cid].mean(axis=0),float);c=c/max(float(np.linalg.norm(c)),1e-12);cents.append(c)
    sim=np.clip(np.vstack(cents)@np.vstack(cents).T,-1,1);np.fill_diagonal(sim,-1)
    nearest=np.max(sim,axis=1)
    return float(np.clip(1.0-np.mean(nearest),0.0,2.0)/2.0)


def _v54_tiny_cluster_fraction(labels,c:Config)->float:
    labels=np.asarray(labels,dtype=int);n=max(len(labels),1);cnt=Counter(labels.tolist())
    return float(sum(v for v in cnt.values() if v<max(2,int(c.min_partition_cluster_size)))/n)


def _v54_partition_stability(v,k,method,c:Config,seed)->float:
    if len(v)<24 or c.stability_repeats<2:return 0.0
    rng=np.random.default_rng(seed);runs=[];take=max(18,int(round(.84*len(v))))
    for r in range(c.stability_repeats):
        idx=np.sort(rng.choice(len(v),take,replace=False))
        try:
            if method=="bisecting_kmeans" and BisectingKMeans is not None:
                est=BisectingKMeans(n_clusters=k,random_state=seed+r,bisecting_strategy="biggest_inertia")
            else:
                est=MiniBatchKMeans(n_clusters=k,random_state=seed+r,batch_size=min(2048,max(128,take)),n_init="auto",reassignment_ratio=.005)
            lab=est.fit_predict(v[idx]);runs.append((idx,np.asarray(lab,dtype=int)))
        except Exception:
            continue
    vals=[]
    for i in range(len(runs)):
        for j in range(i+1,len(runs)):
            ia,la=runs[i];ib,lb=runs[j];common,aidx,bidx=np.intersect1d(ia,ib,return_indices=True)
            if len(common)>=8:vals.append(float(adjusted_rand_score(la[aidx],lb[bidx])))
    return float(np.mean(vals)) if vals else 0.0


def _v54_fit_partition_model(v,k,method,c:Config,seed):
    if method=="bisecting_kmeans" and BisectingKMeans is not None:
        est=BisectingKMeans(n_clusters=int(k),random_state=seed,bisecting_strategy="biggest_inertia")
    else:
        est=MiniBatchKMeans(n_clusters=int(k),random_state=seed,batch_size=min(4096,max(256,len(v))),n_init="auto",reassignment_ratio=.005,max_no_improvement=20)
    raw=np.asarray(est.fit_predict(v),dtype=int)
    model,pub=_make_model(method,est,{"n_clusters":int(k)},raw,v,c)
    return model,pub


def _v54_predict_partition(model:ClusterModel,v,c:Config):
    """Coverage-first assignment: every vector receives its nearest public centroid.

    LOW/MEDIUM/HIGH confidence is reported separately; low confidence never gets
    silently converted into UNKNOWN. UNKNOWN remains reserved for interactions
    without a usable normalized customer-problem representation.
    """
