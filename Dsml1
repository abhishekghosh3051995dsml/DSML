    transitions: Counter = Counter()
    source_counter: Counter = Counter()

    for item in interactions.values():
        tools = item.tool_sequence()
        for source in tools:
            source_counter[source] += 1
        for current_tool, next_tool in zip(tools, tools[1:]):
            transitions[(current_tool, next_tool)] += 1

    rows: List[Dict[str, Any]] = []
    for (current_tool, next_tool), count in transitions.items():
        rows.append(
            {
                "current_tool": current_tool,
                "next_tool": next_tool,
                "transition_count": count,
                "transition_rate": safe_div(count, source_counter[current_tool]),
