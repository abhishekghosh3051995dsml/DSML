def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate production-grade A metrics from interactions.csv",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    parser.add_argument(
        "input_csv",
        nargs="*",
        default=[os.getenv("A_INTERACTIONS_CSV", "interactions.csv")],
        help="One or more CSV files, directories or globs.",
    )
    parser.add_argument(
        "--output-dir",
        default=os.getenv("A_METRICS_OUTPUT", "A_metrics_output"),
        help="Directory where metrics files are written.",
    )
    parser.add_argument("--start-date", default=None, help="Inclusive ISO start date, e.g. 2025-07-13")
    parser.add_argument("--end-date", default=None, help="Inclusive ISO end date, e.g. 2025-07-26")
    parser.add_argument(
        "--only-positive",
        action="store_true",
        help="Keep only interactions where the customer feedback is positive.",
    )
    parser.add_argument("--max-rows", type=int, default=None, help="Read at most N rows per file (smoke test).")
    parser.add_argument("--no-clustering", action="store_true", help="Disable intent/workflow clustering.")
    parser.add_argument(
        "--intent-threshold", type=float, default=DEFAULT_INTENT_THRESHOLD,
        help="Similarity threshold for intent clustering (0-1).",
    )
    parser.add_argument(
        "--workflow-threshold", type=float, default=DEFAULT_WORKFLOW_THRESHOLD,
        help="Similarity threshold for task-decomposition clustering (0-1).",
    )
    parser.add_argument(
        "--order-weight", type=float, default=DEFAULT_ORDER_WEIGHT,
        help="How much tool ORDER matters vs tool SET when clustering workflows (0-1).",
    )
    parser.add_argument(
        "--parallel-window", type=float, default=DEFAULT_PARALLEL_WINDOW_SECONDS,
        help="Seconds within which tool calls count as parallel fan-out.",
    )
    parser.add_argument(
        "--max-cluster-items", type=int, default=DEFAULT_MAX_CLUSTER_ITEMS,
        help="Above this many distinct labels, fall back to exact grouping.",
    )
    parser.add_argument(
        "--A-namespaces", default=",".join(DEFAULT_A_NAMESPACES),
        help="Comma-separated tool namespaces counted as A API calls.",
    )
    parser.add_argument(
        "--preview-chars", type=int, default=DEFAULT_PREVIEW_CHARS,
        help="Max characters kept per argument/result in the tool-call export.",
    )
    parser.add_argument("--quiet", action="store_true", help="Suppress progress logging.")

    return parser.parse_args()


def main() -> int:
    args = parse_args()

    input_files = expand_inputs(args.input_csv)
    missing = [str(path) for path in input_files if not path.exists()]
    if missing or not input_files:
        for path in missing:
            print(f"[ERROR] Input CSV not found: {path}", file=sys.stderr)
        if not input_files:
            print("[ERROR] No input files resolved.", file=sys.stderr)
        return 2

    output_dir = Path(args.output_dir).expanduser().resolve()
    ensure_output_dir(output_dir)

    A_namespaces = [ns.strip() for ns in args.A_namespaces.split(",") if ns.strip()]
    clustering_enabled = not args.no_clustering

    interactions, schema_counter, ingest_report = analyze_csv_files(
        input_files=input_files,
        A_namespaces=A_namespaces,
        preview_chars=args.preview_chars,
        parallel_window_seconds=args.parallel_window,
        max_rows=args.max_rows,
        quiet=args.quiet,
    )

    interactions, filter_report = filter_interactions(
        interactions,
        start_date=args.start_date,
        end_date=args.end_date,
        only_positive=args.only_positive,
    )
    log(
        f"[INFO] {filter_report['kept_interactions']:,} interactions kept after filters"
        f" (dropped: {filter_report['dropped'] or 'none'})",
        args.quiet,
    )

    if not interactions:
        print("[WARN] No interactions left after filtering. Check --start-date/--end-date/--only-positive.")
        write_json(output_dir / "10_global_metrics.json", {"warning": "no interactions", "filters": filter_report})
        return 0

    # ---- clustering -----------------------------------------------------
    log("[INFO] Clustering intents and task decompositions...", args.quiet)

    intent_weights: Counter = Counter()
    for item in interactions.values():
        for label in unique_preserve_order(item.intents + item.subintents):
            intent_weights[label] += 1

    problem_weights: Counter = Counter()
    for item in interactions.values():
        for label in unique_preserve_order(item.problems):
            problem_weights[label] += 1

    sequences: Dict[str, Sequence[str]] = {}
    workflow_weights: Counter = Counter()
    for item in interactions.values():
        sequence = item.tool_sequence()
        if not sequence:
            continue
        workflow_id = stable_hash(workflow_signature(sequence))
        sequences.setdefault(workflow_id, sequence)
        workflow_weights[workflow_id] += 1

    intent_clusters = cluster_texts(
        list(intent_weights), dict(intent_weights),
        threshold=args.intent_threshold, max_items=args.max_cluster_items, enabled=clustering_enabled,
    )
    problem_clusters = cluster_texts(
        list(problem_weights), dict(problem_weights),
        threshold=args.intent_threshold, max_items=args.max_cluster_items, enabled=clustering_enabled,
    )
    workflow_clusters = cluster_tool_sequences(
        sequences, dict(workflow_weights),
        threshold=args.workflow_threshold, order_weight=args.order_weight,
        max_items=args.max_cluster_items, enabled=clustering_enabled,
    )

    # ---- build metrics --------------------------------------------------
    log("[INFO] Building metrics...", args.quiet)

    interaction_rows = build_interaction_rows(interactions, intent_clusters, problem_clusters, workflow_clusters)
    tool_call_rows = build_tool_call_rows(interactions)
    tool_summary_rows = build_tool_summary(interactions)
    workflow_rows = build_workflow_summary(interactions, intent_clusters, workflow_clusters)
    intent_workflow_rows = build_intent_workflow_summary(
        interactions, intent_clusters, workflow_clusters, use_clusters=clustering_enabled
    )
    intent_workflow_matrix_rows = build_intent_workflow_matrix(interactions, intent_clusters, workflow_clusters)
    cooccurrence_rows = build_tool_cooccurrence(interactions)
    parallel_rows = build_parallel_group_rows(interactions)
    transition_rows = build_tool_transitions(interactions)
    intent_rows = build_intent_summary(interactions, intent_clusters)
    intent_cluster_rows = build_cluster_rows(intent_clusters, dict(intent_weights), "intent")
    problem_cluster_rows = build_cluster_rows(problem_clusters, dict(problem_weights), "problem")
    workflow_cluster_rows = build_cluster_rows(workflow_clusters, dict(workflow_weights), "task_decomposition")

    global_summary = build_global_summary(
        interactions, intent_clusters, problem_clusters, workflow_clusters, filter_report, ingest_report
    )

    # ---- write outputs --------------------------------------------------
    write_csv(output_dir / "01_interaction_metrics.csv", interaction_rows, INTERACTION_FIELDS)
    write_csv(output_dir / "02_tool_calls.csv", tool_call_rows, TOOL_CALL_FIELDS)
    write_csv(output_dir / "03_tool_summary.csv", tool_summary_rows, TOOL_SUMMARY_FIELDS)
    write_csv(output_dir / "04_workflow_summary.csv", workflow_rows, WORKFLOW_FIELDS)
    write_csv(output_dir / "05_intent_workflow_summary.csv", intent_workflow_rows, INTENT_WORKFLOW_FIELDS)
    write_csv(output_dir / "06_tool_cooccurrence.csv", cooccurrence_rows, COOCCURRENCE_FIELDS)
    write_csv(output_dir / "07_tool_transitions.csv", transition_rows, TRANSITION_FIELDS)
    write_csv(output_dir / "08_intent_summary.csv", intent_rows, INTENT_FIELDS)
    write_csv(
        output_dir / "09_schema_profile.csv",
        ({"field": name, "row_occurrence_count": count} for name, count in schema_counter.most_common()),
        ["field", "row_occurrence_count"],
    )
    write_json(output_dir / "10_global_metrics.json", global_summary)
    write_csv(output_dir / "11_intent_clusters.csv", intent_cluster_rows, CLUSTER_FIELDS)
    write_csv(output_dir / "12_task_decomposition_clusters.csv", workflow_cluster_rows, CLUSTER_FIELDS)
    write_csv(output_dir / "13_problem_clusters.csv", problem_cluster_rows, CLUSTER_FIELDS)
    write_csv(output_dir / "14_parallel_tool_groups.csv", parallel_rows, PARALLEL_FIELDS)
    write_csv(
        output_dir / "15_intent_workflow_matrix.csv",
        intent_workflow_matrix_rows,
        INTENT_WORKFLOW_MATRIX_FIELDS,
    )

    print_console_summary(global_summary)

    print()
    print(f"[DONE] Metrics written to:\n{output_dir}")
    print()
    print("Generated files:")
    for path in sorted(output_dir.glob("*")):
        print(f"  - {path.name}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
