TOOL_NAME_KEYS = {"function_name", "tool_name", "functionname", "toolname", "api_name", "apiname"}
ARG_KEYS = {"arguments", "args", "parameters", "params", "input"}
RESULT_KEYS = {"function_result", "tool_result", "result", "output", "response"}
ERROR_KEYS = {"error", "exception", "error_message", "errormessage", "err"}


def split_tool_name(tool_name: str) -> Tuple[str, str]:
    match = TOOL_NAME_PATTERN.match(tool_name.strip())
    if not match:
        return "", tool_name.strip()
    return match.group("namespace"), match.group("function")


def classify_tool_status(result: Any, error: Any) -> str:
    """
    Structured error field wins; only then do we fall back to text patterns.
    (v1 classified any payload containing the substring "error" as a failure,
    including payloads carrying `"error": null`.)
    """
    error_text = normalize_text(error)
    has_real_error = bool(error_text) and error_text.lower() not in NULLISH

    if has_real_error:
        lowered = error_text.lower()
        if any(pattern in lowered for pattern in SKIPPED_PATTERNS):
            return "skipped"
        return "error"

    result_text = normalize_text(result).lower()

    if not result_text or result_text in NULLISH:
        return "empty"

    if any(pattern in result_text for pattern in PARTIAL_PATTERNS):
        return "partial"

    if any(pattern in result_text for pattern in ERROR_PATTERNS):
        return "error"

    if any(pattern in result_text for pattern in NO_DATA_PATTERNS):
        return "no_data"

    if any(pattern in result_text for pattern in SKIPPED_PATTERNS):
        return "skipped"

    return "success"


def classify_side(node: Dict[str, Any], row_context: Dict[str, Any]) -> str:
    """Agent side vs tool side, per the notes' 'on tool side & on agent side'."""
    candidates: List[str] = []

    normalized = {normalize_key(k): v for k, v in node.items()}
    for key in SIDE_KEYS:
        if key in normalized and isinstance(normalized[key], (str, int, float)):
            candidates.append(normalize_text(normalized[key]).lower())

    if not candidates:
        for value in find_values_by_exact_keys(row_context, SIDE_KEYS):
            candidates.append(normalize_text(value).lower())

    for text in candidates:
        if not text:
            continue
        if any(hint in text for hint in AGENT_SIDE_HINTS):
            return "agent"
        if any(hint in text for hint in TOOL_SIDE_HINTS):
            return "tool"

    return DEFAULT_SIDE


def extract_step_key(node: Dict[str, Any], row_context: Dict[str, Any]) -> str:
    normalized = {normalize_key(k): v for k, v in node.items()}
    for key in STEP_KEYS:
        if key in normalized and isinstance(normalized[key], (str, int, float)):
            text = normalize_text(normalized[key])
            if text and text.lower() not in NULLISH:
                return text
    for value in find_values_by_exact_keys(row_context, STEP_KEYS):
        text = normalize_text(value)
        if text and text.lower() not in NULLISH:
            return text
    return ""


def extract_tool_calls(
    obj: Any,
    interaction_id: str,
    row_number: int,
    A_namespaces: Sequence[str],
    preview_chars: int,
    row_timestamp: Optional[datetime],
) -> List[ToolCall]:
    calls: List[ToolCall] = []

    def recurse(node: Any, path: Tuple[str, ...]) -> None:
        if isinstance(node, dict):
            normalized = {normalize_key(k): v for k, v in node.items()}

            tool_name = ""
            for key in TOOL_NAME_KEYS:
                value = normalized.get(key)
                if isinstance(value, str) and value.strip():
                    tool_name = value.strip()
                    break

            if not tool_name:
                name = normalized.get("name")
                if isinstance(name, str) and name.strip():
                    context_keys = set(normalized.keys())
                    if context_keys.intersection(ARG_KEYS | RESULT_KEYS | ERROR_KEYS):
                        tool_name = name.strip()

            if tool_name:
                arguments: Any = None
                result: Any = None
                error: Any = None

                for key in ARG_KEYS:
                    if key in normalized:
                        arguments = normalized[key]
                        break
                for key in RESULT_KEYS:
                    if key in normalized:
                        result = normalized[key]
                        break
                for key in ERROR_KEYS:
                    if key in normalized:
                        error = normalized[key]
                        break

                namespace, function_name = split_tool_name(tool_name)
                status = classify_tool_status(result=result, error=error)
                arguments_text = json_dumps_safe(arguments)
                result_text = json_dumps_safe(result)
                node_ts = extract_timestamp(node) or row_timestamp

                argument_keys = ""
                if isinstance(arguments, dict):
                    argument_keys = "|".join(sorted(normalize_key(k) for k in arguments))

                calls.append(
                    ToolCall(
                        interaction_id=interaction_id,
                        row_number=row_number,
                        call_index=0,  # assigned after ordering
                        tool_name=tool_name,
                        namespace=namespace,
                        function_name=function_name,
                        is_A_api=int(
                            (namespace or tool_name).lower() in {n.lower() for n in A_namespaces}
                        ),
                        side=classify_side(node, obj),
                        arguments=short_text(arguments_text, preview_chars),
                        argument_keys=argument_keys,
                        result=short_text(result_text, preview_chars),
                        error=short_text(normalize_text(error), preview_chars),
                        status=status,
                        is_success=int(status == "success"),
                        timestamp=iso_or_blank(node_ts),
                        step_key=extract_step_key(node, obj),
                        parallel_group="",     # assigned in finalisation
                        parallel_degree=1,
                        source_path=".".join(path),
                        result_length=len(result_text),
                        argument_length=len(arguments_text),
                    )
                )
                # Do not descend into a matched call's own payload: the result
                # body often echoes a nested "name"/"response" pair.
                return

            for key, value in node.items():
                recurse(value, path + (normalize_key(key),))

        elif isinstance(node, list):
            for idx, value in enumerate(node):
                recurse(value, path + (str(idx),))

    recurse(obj, ())

    # Deduplicate ONLY within this row. The same call object is frequently
    # serialised twice inside one row (raw + parsed). Genuine retries of the
    # same tool live in *different* rows and must be preserved, otherwise the
    # "repeated tool calls" metric silently under-reports.
    unique_calls: List[ToolCall] = []
    seen: Set[Tuple[str, str, str, str, str]] = set()
    for call in calls:
        fingerprint = (call.tool_name, call.arguments, call.result, call.error, call.timestamp)
        if fingerprint in seen:
            continue
        seen.add(fingerprint)
        unique_calls.append(call)

    return unique_calls


# ============================================================
# CSV ROW DECODING
# ============================================================

def decode_csv_row(row: Dict[str, Any]) -> Dict[str, Any]:
    decoded: Dict[str, Any] = {}
    for key, value in row.items():
        if key is None:
            continue
        if isinstance(value, list):        # DictReader restkey (ragged rows)
            value = " ".join(str(v) for v in value)
        decoded[str(key).strip()] = try_decode(value)
    return decoded


def raise_csv_field_limit() -> int:
    """
    CRITICAL FIX: the default 131,072-char field cap makes csv abort with
    "_csv.Error: field larger than field limit" on rows that carry a whole
    tool_history JSON blob in one cell.
    """
    limit = min(sys.maxsize, 2**31 - 1)
    while limit > 1024:
        try:
            csv.field_size_limit(limit)
            return limit
        except OverflowError:
            limit //= 2
    return csv.field_size_limit()


