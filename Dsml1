def expand_inputs(paths: Sequence[str]) -> List[Path]:
    """Accept files, directories and globs (so daily dumps just work)."""
    resolved: List[Path] = []
    for raw in paths:
        expanded = globlib.glob(os.path.expanduser(raw))
        candidates = [Path(p) for p in expanded] if expanded else [Path(os.path.expanduser(raw))]
        for candidate in candidates:
            if candidate.is_dir():
                resolved.extend(sorted(candidate.glob("*.csv")))
            else:
                resolved.append(candidate)

    unique: List[Path] = []
    seen: Set[str] = set()
    for path in resolved:
        key = str(path.resolve())
        if key not in seen:
            seen.add(key)
            unique.append(path.resolve())
    return unique


def analyze_csv_files(
    input_files: Sequence[Path],
    A_namespaces: Sequence[str],
    preview_chars: int,
    parallel_window_seconds: float,
    max_rows: Optional[int],
    quiet: bool,
) -> Tuple[Dict[str, InteractionAccumulator], Counter, Dict[str, Any]]:
    interactions: Dict[str, InteractionAccumulator] = {}
    schema_counter: Counter = Counter()

    limit = raise_csv_field_limit()
    log(f"[INFO] CSV field size limit set to {limit:,} characters", quiet)

    ingest_report: Dict[str, Any] = {
        "files": [],
        "total_rows": 0,
        "failed_rows": 0,
        "rows_without_native_id": 0,
    }

    for input_csv in input_files:
        log(f"[INFO] Reading: {input_csv}", quiet)
        file_rows = 0
        file_failures = 0

        with input_csv.open("r", encoding="utf-8-sig", errors="replace", newline="") as handle:
            reader = csv.DictReader(handle)

            if not reader.fieldnames:
                raise RuntimeError(f"CSV has no header row: {input_csv}")

            log("[INFO] CSV columns: " + ", ".join(str(c) for c in reader.fieldnames), quiet)

            for row_number, raw_row in enumerate(reader, start=1):
                if max_rows is not None and row_number > max_rows:
                    log(f"[INFO] Stopping early at --max-rows={max_rows}", quiet)
                    break

                if row_number % 10000 == 0:
                    log(f"[INFO] Processed {row_number:,} CSV rows...", quiet)

                try:
                    decoded_row = decode_csv_row(raw_row)

                    for key in decoded_row:
                        schema_counter[normalize_key(key)] += 1

                    interaction_id = find_interaction_id(decoded_row, row_number=row_number)
                    if interaction_id.startswith("row_"):
                        ingest_report["rows_without_native_id"] += 1

                    item = interactions.get(interaction_id)
                    if item is None:
                        item = InteractionAccumulator(interaction_id=interaction_id)
                        interactions[interaction_id] = item

                    item.source_row_count += 1
                    item.source_files.append(input_csv.name)

                    row_timestamp = find_any_timestamp(decoded_row)
                    if row_timestamp:
                        item.started_at = min(item.started_at or row_timestamp, row_timestamp)
                        item.ended_at = max(item.ended_at or row_timestamp, row_timestamp)

                    intents, subintents = extract_intents(decoded_row)
                    sentiment, feedback_values = extract_feedback(decoded_row)

                    item.problems.extend(extract_user_messages(decoded_row))
                    item.problem_categories.extend(extract_problem_categories(decoded_row))
                    item.intents.extend(intents)
                    item.subintents.extend(subintents)
                    item.workflow_names.extend(extract_workflow_names(decoded_row))
                    item.feedback_values.extend(feedback_values)

                    if sentiment == "negative":
                        item.sentiment = "negative"
                    elif sentiment == "positive" and item.sentiment != "negative":
                        item.sentiment = "positive"

                    item.tool_calls.extend(
                        extract_tool_calls(
                            decoded_row,
                            interaction_id=interaction_id,
                            row_number=row_number,
                            A_namespaces=A_namespaces,
                            preview_chars=preview_chars,
                            row_timestamp=row_timestamp,
                        )
                    )

                except Exception as exc:  # row-level isolation: never lose the file
                    file_failures += 1
                    ingest_report["failed_rows"] += 1
                    if file_failures <= 5:
                        log(f"[WARN] Row {row_number} in {input_csv.name} failed: {exc}", quiet)
                    continue

                file_rows += 1

        ingest_report["files"].append(
            {
                "file": str(input_csv),
                "rows": file_rows,
                "failed_rows": file_failures,
                "size_mb": round(input_csv.stat().st_size / 1e6, 2),
            }
        )
        ingest_report["total_rows"] += file_rows

    log("[INFO] Ordering tool calls and detecting parallel fan-out...", quiet)
    for item in interactions.values():
        finalize_interaction(item, parallel_window_seconds=parallel_window_seconds)

    log(f"[INFO] Discovered {len(interactions):,} interactions.", quiet)
    return interactions, schema_counter, ingest_report


