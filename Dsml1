@dataclass
class InteractionAccumulator:
    interaction_id: str
    source_row_count: int = 0

    problems: List[str] = field(default_factory=list)
    problem_categories: List[str] = field(default_factory=list)
    intents: List[str] = field(default_factory=list)
    subintents: List[str] = field(default_factory=list)
    workflow_names: List[str] = field(default_factory=list)
    tool_calls: List[ToolCall] = field(default_factory=list)

    feedback_values: List[str] = field(default_factory=list)
    sentiment: str = "unknown"

    started_at: Optional[datetime] = None
    ended_at: Optional[datetime] = None

    source_files: List[str] = field(default_factory=list)

    # ---- derived views -------------------------------------------------
    def tool_names(self) -> List[str]:
        return [call.tool_name for call in self.tool_calls]

    def tool_sequence(self, dedupe_consecutive: bool = True) -> List[str]:
        names = self.tool_names()
        if not dedupe_consecutive:
            return names
        out: List[str] = []
        for name in names:
            if not out or out[-1] != name:
                out.append(name)
        return out

    def primary_intent(self) -> str:
        return self.intents[0] if self.intents else ""

    def primary_problem(self) -> str:
        return self.problems[0] if self.problems else ""

    def parallel_groups(self) -> List[Tuple[str, ...]]:
        groups: Dict[str, Set[str]] = defaultdict(set)
        for call in self.tool_calls:
            if call.parallel_group:
                groups[call.parallel_group].add(call.tool_name)
        return [tuple(sorted(tools)) for tools in groups.values() if len(tools) > 1]

    def max_parallel_degree(self) -> int:
        return max((call.parallel_degree for call in self.tool_calls), default=0)


def workflow_signature(tool_names: Sequence[str]) -> str:
    normalized = [normalize_text(name) for name in tool_names if normalize_text(name)]
    return " -> ".join(normalized)


def workflow_set_signature(tool_names: Sequence[str]) -> str:
    return " | ".join(sorted(set(tool_names)))


def finalize_interaction(
    item: InteractionAccumulator,
    parallel_window_seconds: float,
) -> None:
    """Order tool calls by time, renumber, and assign parallel fan-out groups."""
    item.problems = unique_preserve_order(item.problems)
    item.problem_categories = unique_preserve_order(item.problem_categories)
    item.intents = unique_preserve_order(item.intents)
    item.subintents = unique_preserve_order(item.subintents)
    item.workflow_names = unique_preserve_order(item.workflow_names)
    item.feedback_values = unique_preserve_order(item.feedback_values)
    item.source_files = unique_preserve_order(item.source_files)

    # FIX: v1 relied purely on CSV row order. Order by timestamp when present,
    # falling back to row order, so workflow signatures are stable.
    def sort_key(entry: Tuple[int, ToolCall]) -> Tuple[int, float, int, int]:
        index, call = entry
        parsed = parse_timestamp(call.timestamp)
        if parsed is None:
            return (1, 0.0, call.row_number, index)
        return (0, parsed.timestamp(), call.row_number, index)

    ordered = [call for _, call in sorted(enumerate(item.tool_calls), key=sort_key)]
    item.tool_calls = ordered

    for idx, call in enumerate(item.tool_calls, start=1):
        call.call_index = idx

    # ---- parallel fan-out detection -----------------------------------
    # Priority: explicit step id > timestamp window > same source row.
    groups: Dict[str, List[ToolCall]] = defaultdict(list)
    anchor_ts: Optional[datetime] = None
    anchor_key = ""

    for call in item.tool_calls:
        if call.step_key:
            key = f"step::{call.step_key}"
        else:
            parsed = parse_timestamp(call.timestamp)
            if parsed is not None:
                if anchor_ts is None or (parsed - anchor_ts).total_seconds() > parallel_window_seconds:
                    anchor_ts = parsed
                    anchor_key = f"win::{parsed.isoformat()}"
                key = anchor_key
            else:
                key = f"row::{call.row_number}"
        groups[key].append(call)

    for key, group in groups.items():
        group_id = stable_hash(f"{item.interaction_id}::{key}", 12)
        distinct_tools = len({call.tool_name for call in group})
        for call in group:
            call.parallel_group = group_id
            call.parallel_degree = distinct_tools


# ============================================================
# CLUSTERING  (stdlib only: token blocking + union-find)
# ============================================================

class UnionFind:
    def __init__(self, size: int) -> None:
        self.parent = list(range(size))

    def find(self, x: int) -> int:
        while self.parent[x] != x:
            self.parent[x] = self.parent[self.parent[x]]
            x = self.parent[x]
        return x

    def union(self, a: int, b: int) -> None:
        ra, rb = self.find(a), self.find(b)
        if ra != rb:
            self.parent[max(ra, rb)] = min(ra, rb)


@dataclass
class ClusterResult:
    assignments: Dict[str, int] = field(default_factory=dict)
    representatives: Dict[int, str] = field(default_factory=dict)
    members: Dict[int, List[str]] = field(default_factory=dict)
    method: str = "none"

    @property
    def n_clusters(self) -> int:
        return len(self.members)

    def cluster_of(self, item: str) -> Optional[int]:
        return self.assignments.get(item)

    def label_of(self, item: str, default: str = "") -> str:
        cid = self.assignments.get(item)
        return self.representatives.get(cid, default) if cid is not None else default


def _package_clusters(
    items: Sequence[str],
    labels: Sequence[int],
    weights: Dict[str, int],
    method: str,
) -> ClusterResult:
    grouped: Dict[int, List[str]] = defaultdict(list)
    for item, label in zip(items, labels):
        grouped[int(label)].append(item)

    result = ClusterResult(method=method)
    ordered = sorted(grouped.items(), key=lambda kv: (-len(kv[1]), str(kv[0])))
    for new_id, (_, members) in enumerate(ordered):
        result.members[new_id] = sorted(members)
        result.representatives[new_id] = max(members, key=lambda m: (weights.get(m, 0), -len(m)))
        for member in members:
            result.assignments[member] = new_id
    return result


def _token_blocks(items: Sequence[str], tokens: Sequence[Set[str]]) -> Dict[str, List[int]]:
    """Inverted index so we only compare candidates that share a token."""
    blocks: Dict[str, List[int]] = defaultdict(list)
    for idx, token_set in enumerate(tokens):
        for token in token_set:
            blocks[token].append(idx)
    return blocks


def text_similarity(a: str, b: str, ta: Set[str], tb: Set[str]) -> float:
    if not a or not b:
        return 0.0
    jaccard = len(ta & tb) / len(ta | tb) if (ta or tb) else 0.0
    ratio = SequenceMatcher(None, a, b).ratio()
    return max(jaccard, 0.5 * jaccard + 0.5 * ratio)


def cluster_texts(
    values: Sequence[str],
    weights: Optional[Dict[str, int]] = None,
    threshold: float = DEFAULT_INTENT_THRESHOLD,
    max_items: int = DEFAULT_MAX_CLUSTER_ITEMS,
    enabled: bool = True,
) -> ClusterResult:
    """Cluster free-text labels (intents, sub-intents, problem statements)."""
    weights = weights or {}
    items = [v for v in unique_preserve_order(values) if str(v).strip()]

    if not items:
        return ClusterResult(method="empty")

    if not enabled:
        return _package_clusters(items, list(range(len(items))), weights, "disabled")

    normalized = [normalize_label(item) for item in items]

    if len(items) > max_items:
        buckets: Dict[str, int] = {}
        labels = [buckets.setdefault(text, len(buckets)) for text in normalized]
        return _package_clusters(items, labels, weights, "normalized-exact (size guard)")

    tokens = [set(text.split()) for text in normalized]
    blocks = _token_blocks(items, tokens)
    uf = UnionFind(len(items))

    compared: Set[Tuple[int, int]] = set()
    for candidates in blocks.values():
        if len(candidates) > 400:      # skip pathological stop-word blocks
            continue
        for i, j in combinations(candidates, 2):
            pair = (i, j) if i < j else (j, i)
            if pair in compared:
                continue
            compared.add(pair)
            if text_similarity(normalized[i], normalized[j], tokens[i], tokens[j]) >= threshold:
                uf.union(i, j)

    labels = [uf.find(i) for i in range(len(items))]
    return _package_clusters(items, labels, weights, "token-blocking + difflib union-find")


def sequence_similarity(
    seq_a: Sequence[str],
    seq_b: Sequence[str],
    set_a: Set[str],
    set_b: Set[str],
    order_weight: float,
) -> float:
    if not set_a or not set_b:
        return 0.0
    jaccard = len(set_a & set_b) / len(set_a | set_b)
    order = SequenceMatcher(None, list(seq_a), list(seq_b)).ratio()
    return (1 - order_weight) * jaccard + order_weight * order


def cluster_tool_sequences(
    sequences: Dict[str, Sequence[str]],
    weights: Optional[Dict[str, int]] = None,
    threshold: float = DEFAULT_WORKFLOW_THRESHOLD,
    order_weight: float = DEFAULT_ORDER_WEIGHT,
    max_items: int = DEFAULT_MAX_CLUSTER_ITEMS,
    enabled: bool = True,
) -> ClusterResult:
    """
    Task-decomposition clustering: do two workflows do essentially the same
    thing (same tools, similar order), or is a genuinely new decomposition
    generated each run?
    """
    weights = weights or {}
    keys = [key for key, seq in sequences.items() if seq]

    if not keys:
        return ClusterResult(method="empty")

    if not enabled:
        return _package_clusters(keys, list(range(len(keys))), weights, "disabled")

    sets = {key: set(sequences[key]) for key in keys}

    if len(keys) > max_items:
        buckets: Dict[Tuple[str, ...], int] = {}
        labels = [buckets.setdefault(tuple(sorted(sets[key])), len(buckets)) for key in keys]
        return _package_clusters(keys, labels, weights, "toolset-exact (size guard)")

    blocks: Dict[str, List[int]] = defaultdict(list)
    for idx, key in enumerate(keys):
        for tool in sets[key]:
            blocks[tool].append(idx)

    uf = UnionFind(len(keys))
    compared: Set[Tuple[int, int]] = set()
    for candidates in blocks.values():
        if len(candidates) > 400:
            continue
        for i, j in combinations(candidates, 2):
            pair = (i, j) if i < j else (j, i)
            if pair in compared:
                continue
            compared.add(pair)
            a, b = keys[i], keys[j]
            score = sequence_similarity(sequences[a], sequences[b], sets[a], sets[b], order_weight)
            if score >= threshold:
                uf.union(i, j)

    labels = [uf.find(i) for i in range(len(keys))]
    return _package_clusters(keys, labels, weights, "jaccard + sequence union-find")


# ============================================================
# FILTERS  (July window / positive-only baseline)
# ============================================================

def parse_boundary_date(value: Optional[str], end_of_day: bool = False) -> Optional[datetime]:
    if not value:
        return None
    parsed = parse_timestamp(value)
    if parsed is None:
        raise SystemExit(f"[ERROR] Invalid date '{value}'. Use ISO format, e.g. 2025-07-13")
    if end_of_day and (parsed.hour, parsed.minute, parsed.second) == (0, 0, 0):
        parsed = parsed.replace(hour=23, minute=59, second=59)
    return parsed


def filter_interactions(
    interactions: Dict[str, InteractionAccumulator],
    start_date: Optional[str],
    end_date: Optional[str],
    only_positive: bool,
) -> Tuple[Dict[str, InteractionAccumulator], Dict[str, Any]]:
    start = parse_boundary_date(start_date)
    end = parse_boundary_date(end_date, end_of_day=True)

    kept: Dict[str, InteractionAccumulator] = {}
    dropped: Counter = Counter()

    for key, item in interactions.items():
        reference = item.started_at or item.ended_at

        if (start or end) and reference is None:
            dropped["missing_timestamp"] += 1
            continue
        if start and reference and reference < start:
            dropped["before_start_date"] += 1
            continue
        if end and reference and reference > end:
            dropped["after_end_date"] += 1
            continue
        if only_positive and item.sentiment != "positive":
            dropped["not_positive"] += 1
            continue

        kept[key] = item

    report = {
        "start_date": start_date or "",
        "end_date": end_date or "",
        "only_positive": bool(only_positive),
        "input_interactions": len(interactions),
        "kept_interactions": len(kept),
        "dropped": dict(dropped),
    }
    return kept, report


