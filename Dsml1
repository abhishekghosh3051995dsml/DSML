def ensure_output_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def write_csv(path: Path, rows: Iterable[Dict[str, Any]], fieldnames: Sequence[str]) -> None:
    with path.open("w", encoding="utf-8-sig", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=list(fieldnames), extrasaction="ignore")
        writer.writeheader()
        for row in rows:
            writer.writerow(row)


def write_json(path: Path, payload: Any) -> None:
    with path.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=2, default=str)


# ============================================================
# PER-INTERACTION METRICS  (the 1:1 view)
# ============================================================

def build_interaction_rows(
    interactions: Dict[str, InteractionAccumulator],
    intent_clusters: ClusterResult,
    problem_clusters: ClusterResult,
    workflow_clusters: ClusterResult,
) -> List[Dict[str, Any]]:
    rows: List[Dict[str, Any]] = []

    for interaction_id, item in interactions.items():
        tool_names = item.tool_names()
        tool_counter = Counter(tool_names)
        status_counter = Counter(call.status for call in item.tool_calls)

        repeated_tools = {tool: count for tool, count in tool_counter.items() if count > 1}
        total_calls = len(item.tool_calls)

        sequence = item.tool_sequence()
        workflow = workflow_signature(sequence)
        workflow_id = stable_hash(workflow) if workflow else ""

        primary_intent = item.primary_intent()
        primary_problem = item.primary_problem()

        rows.append(
            {
                "interaction_id": interaction_id,
                "source_files": " | ".join(item.source_files),
                "source_row_count": item.source_row_count,
                "started_at": iso_or_blank(item.started_at),
                "ended_at": iso_or_blank(item.ended_at),

                "sentiment": item.sentiment,
                "feedback_values": " || ".join(item.feedback_values)[:500],

                "problem_count": len(item.problems),
                "problems": short_text(" || ".join(item.problems), 2000),
                "problem_categories": " || ".join(item.problem_categories),
                "problem_cluster_id": problem_clusters.cluster_of(primary_problem),
                "problem_cluster_label": short_text(problem_clusters.label_of(primary_problem), 200),

                "intent_count": len(item.intents),
                "intents": " || ".join(item.intents),
                "primary_intent": primary_intent,
                "intent_cluster_id": intent_clusters.cluster_of(primary_intent),
                "intent_cluster_label": intent_clusters.label_of(primary_intent),

                "subintent_count": len(item.subintents),
                "subintents": " || ".join(item.subintents),
                "subintent_cluster_labels": " || ".join(
                    unique_preserve_order(
                        [intent_clusters.label_of(s) for s in item.subintents if intent_clusters.label_of(s)]
                    )
                ),

                "declared_workflow_names": " || ".join(item.workflow_names)[:500],

                "tool_call_count": total_calls,
                "unique_tool_count": len(set(tool_names)),
                "tool_names": " || ".join(unique_preserve_order(tool_names)),

                "workflow": short_text(workflow, 4000),
                "workflow_id": workflow_id,
                "workflow_step_count": len(sequence),
                "workflow_tool_set": workflow_set_signature(tool_names),
