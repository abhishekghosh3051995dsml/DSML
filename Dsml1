def divergence_verdict(interaction_count: int, workflow_count: int, cluster_count: int) -> str:
    if not interaction_count:
        return "no data"
    ratio = workflow_count / interaction_count
    if ratio >= 0.8:
        base = "HIGH DIVERGENCE - a near-unique workflow almost every run"
    elif ratio >= 0.4:
        base = "MIXED - partial reuse with substantial per-run variation"
    else:
        base = "STABLE - workflows are largely reused"
    if cluster_count and workflow_count and cluster_count <= 0.5 * workflow_count:
        base += f" (collapses into {cluster_count} structural cluster(s) - variation is mostly cosmetic)"
    elif cluster_count and workflow_count and cluster_count < workflow_count:
        base += f" ({cluster_count} structural cluster(s) - decompositions are genuinely different)"
    return base


def build_intent_workflow_summary(
    interactions: Dict[str, InteractionAccumulator],
    intent_clusters: ClusterResult,
    workflow_clusters: ClusterResult,
    use_clusters: bool = True,
) -> List[Dict[str, Any]]:
    relationship: Dict[str, Dict[str, Any]] = defaultdict(
        lambda: {
            "interactions": set(),
            "workflow_counter": Counter(),
            "workflow_clusters": set(),
            "tool_counter": Counter(),
            "member_labels": set(),
            "positive": 0,
            "negative": 0,
            "tool_calls": 0,
        }
    )

    for interaction_id, item in interactions.items():
        sequence = item.tool_sequence()
        workflow = workflow_signature(sequence)
        workflow_id = stable_hash(workflow) if workflow else ""

        raw_intents = item.intents or ["__INTENT_NOT_AVAILABLE__"]
        if use_clusters:
            keys = unique_preserve_order(
                [intent_clusters.label_of(intent, intent) for intent in raw_intents]
            )
        else:
            keys = raw_intents

        for key, original in zip(keys, raw_intents):
            bucket = relationship[key]
            bucket["interactions"].add(interaction_id)
            bucket["member_labels"].add(original)
            bucket["tool_calls"] += len(item.tool_calls)

            if workflow_id:
                bucket["workflow_counter"][workflow_id] += 1
                cluster_id = workflow_clusters.cluster_of(workflow_id)
                if cluster_id is not None:
                    bucket["workflow_clusters"].add(cluster_id)

            for call in item.tool_calls:
                bucket["tool_counter"][call.tool_name] += 1

            if item.sentiment == "positive":
                bucket["positive"] += 1
            elif item.sentiment == "negative":
                bucket["negative"] += 1

    rows: List[Dict[str, Any]] = []
    for intent, data in relationship.items():
        interaction_count = len(data["interactions"])
        workflow_count = len(data["workflow_counter"])
        cluster_count = len(data["workflow_clusters"])

        dominant_workflow, dominant_count = ("", 0)
        if data["workflow_counter"]:
            dominant_workflow, dominant_count = data["workflow_counter"].most_common(1)[0]

        rows.append(
            {
                "intent_cluster": intent,
                "member_intent_labels": " || ".join(sorted(data["member_labels"]))[:800],
                "interaction_count": interaction_count,
                "distinct_workflow_count": workflow_count,
                "task_decomposition_cluster_count": cluster_count,
                "workflow_consistency_rate": safe_div(dominant_count, interaction_count),
                "workflow_reuse_ratio": round(1 - workflow_count / interaction_count, 6)
                if interaction_count else 0.0,
                "dominant_workflow_id": dominant_workflow,
                "dominant_workflow_count": dominant_count,
                "verdict": divergence_verdict(interaction_count, workflow_count, cluster_count),
                "avg_tool_calls": safe_div(data["tool_calls"], interaction_count, 4),
                "positive_interactions": data["positive"],
                "negative_interactions": data["negative"],
                "distinct_tool_count": len(data["tool_counter"]),
                "top_tools": json_dumps_safe(data["tool_counter"].most_common(20)),
                "workflow_distribution": json_dumps_safe(data["workflow_counter"].most_common(50)),
            }
        )

    rows.sort(key=lambda row: row["interaction_count"], reverse=True)
    return rows


