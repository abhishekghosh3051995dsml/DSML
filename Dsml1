USER_ROLES = {"user", "customer", "human", "subscriber", "caller", "end_user"}

PROBLEM_FALLBACK_PATTERNS = (
    "problem",
    "issue",
    "customer_query",
    "user_query",
    "complaint",
    "utterance",
    "question",
    "description",
)

PROBLEM_EXCLUDE_PATTERNS = (
    "id",
    "count",
    "status_code",
    "timestamp",
)


def extract_user_messages(obj: Any) -> List[str]:
    messages: List[str] = []

    def recurse(node: Any) -> None:
        if isinstance(node, dict):
            normalized = {normalize_key(k): v for k, v in node.items()}
            role = normalize_text(
                normalized.get("role", normalized.get("type", normalized.get("speaker", "")))
            ).lower()

            if role in USER_ROLES:
                for field_name in ("content", "text", "message", "query", "utterance", "data"):
                    if field_name not in normalized:
                        continue
                    value = normalized[field_name]
                    if isinstance(value, str):
                        text = normalize_text(value)
                        if text:
                            messages.append(text)
                    elif isinstance(value, dict):
                        for inner_name in ("content", "text", "message", "query", "utterance"):
                            inner = value.get(inner_name)
                            if isinstance(inner, str) and normalize_text(inner):
                                messages.append(normalize_text(inner))
                    elif isinstance(value, list):
                        for item in value:
                            if isinstance(item, str) and normalize_text(item):
                                messages.append(normalize_text(item))

            for value in node.values():
                recurse(value)

        elif isinstance(node, list):
            for value in node:
                recurse(value)

    recurse(obj)

    if not messages:
        fallback = find_values_by_key_patterns(
            obj,
            include_patterns=PROBLEM_FALLBACK_PATTERNS,
            exclude_patterns=PROBLEM_EXCLUDE_PATTERNS,
        )
        for value in fallback:
            if isinstance(value, str):
                text = normalize_text(value)
                if len(text) >= 3:
                    messages.append(text)

    return unique_preserve_order(messages)


def extract_problem_categories(obj: Any) -> List[str]:
    values = find_values_by_key_patterns(
        obj,
        include_patterns=("category", "problem_type", "issue_type", "topic", "bucket"),
        exclude_patterns=("id", "count"),
    )
    out = [normalize_text(v) for v in values if normalize_text(v)]
    return unique_preserve_order(out)


# ============================================================
# INTENT / SUBINTENT EXTRACTION
# ============================================================

INTENT_EXCLUDE_TOKENS = ("confidence", "score", "probability", "threshold", "id", "count", "index")


def extract_intents(obj: Any) -> Tuple[List[str], List[str]]:
    intents: List[str] = []
    subintents: List[str] = []

    for _, key, value in walk(obj):
        if not isinstance(value, (str, int, float)) or isinstance(value, bool):
            continue

        text = normalize_text(value)
        if not text or text.lower() in NULLISH:
            continue

        if "subintent" in key or "sub_intent" in key:
            subintents.append(text)
            continue

        if "intent" in key:
            if any(token in key for token in INTENT_EXCLUDE_TOKENS):
                continue
            intents.append(text)

    return unique_preserve_order(intents), unique_preserve_order(subintents)


def extract_workflow_names(obj: Any) -> List[str]:
    values = find_values_by_key_patterns(
        obj,
        include_patterns=("workflow", "playbook", "flow_name", "plan_name", "fixit_flow"),
        exclude_patterns=("id", "count", "index"),
    )
    out = [normalize_text(v) for v in values if normalize_text(v) and normalize_text(v).lower() not in NULLISH]
    return unique_preserve_order(out)


