# FEEDBACK / SENTIMENT EXTRACTION
# ============================================================

def classify_feedback_value(value: Any) -> str:
    text = normalize_text(value)
    if not text or text.lower() in NULLISH:
        return "unknown"
    # negative first: "not helpful" must not be caught by the "helpful" positive
    if any(pattern.search(text) for pattern in NEGATIVE_RE):
        return "negative"
    if any(pattern.search(text) for pattern in POSITIVE_RE):
        return "positive"
    return "unknown"


def extract_feedback(obj: Any) -> Tuple[str, List[str]]:
    """Return (sentiment, raw_feedback_values)."""
    raw_values = [
        normalize_text(v)
        for v in find_values_by_exact_keys(obj, FEEDBACK_KEYS)
        if normalize_text(v) and normalize_text(v).lower() not in NULLISH
    ]

    sentiment = "unknown"
    for value in raw_values:
        classified = classify_feedback_value(value)
        if classified == "negative":
            return "negative", unique_preserve_order(raw_values)
        if classified == "positive":
            sentiment = "positive"

    return sentiment, unique_preserve_order(raw_values)


