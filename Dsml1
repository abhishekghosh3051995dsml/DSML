def build_tool_cooccurrence(interactions: Dict[str, InteractionAccumulator]) -> List[Dict[str, Any]]:
    pair_counter: Counter = Counter()
    tool_interaction_counter: Counter = Counter()
    parallel_pair_counter: Counter = Counter()

    for item in interactions.values():
        unique_tools = sorted({call.tool_name for call in item.tool_calls})
        for tool in unique_tools:
            tool_interaction_counter[tool] += 1
        for tool_a, tool_b in combinations(unique_tools, 2):
            pair_counter[(tool_a, tool_b)] += 1

        for group in item.parallel_groups():
            for tool_a, tool_b in combinations(sorted(group), 2):
                parallel_pair_counter[(tool_a, tool_b)] += 1

    rows: List[Dict[str, Any]] = []
    for (tool_a, tool_b), count in pair_counter.items():
        denominator = min(tool_interaction_counter[tool_a], tool_interaction_counter[tool_b])
        rows.append(
            {
                "tool_a": tool_a,
                "tool_b": tool_b,
                "cooccurring_interactions": count,
                "parallel_cooccurrences": parallel_pair_counter[(tool_a, tool_b)],
                "tool_a_interactions": tool_interaction_counter[tool_a],
                "tool_b_interactions": tool_interaction_counter[tool_b],
                "association_rate": safe_div(count, denominator),
            }
        )

    rows.sort(key=lambda row: row["cooccurring_interactions"], reverse=True)
    return rows


