def find_interaction_id(obj: Any, row_number: int) -> str:
    normalized_priority = [normalize_key(x) for x in ID_PRIORITY]
    values_by_key: Dict[str, List[str]] = defaultdict(list)

    for _, key, value in walk(obj):
        if key in normalized_priority and isinstance(value, (str, int)):
            text = str(value).strip()
            if text and text.lower() not in NULLISH:
                values_by_key[key].append(text)

    for candidate in normalized_priority:
        if values_by_key[candidate]:
            return values_by_key[candidate][0]

    for value in find_values_by_key_patterns(obj, include_patterns=("id",)):
        text = str(value).strip()
        if len(text) >= 8:
            return text

    return f"row_{row_number:09d}"


