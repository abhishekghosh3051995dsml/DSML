            "avg_tool_calls_per_interaction": round(statistics.mean(calls_per_interaction), 4)
            if calls_per_interaction else 0,
            "median_tool_calls_per_interaction": round(statistics.median(calls_per_interaction), 4)
            if calls_per_interaction else 0,
            "max_tool_calls_in_interaction": max(calls_per_interaction, default=0),
            "workflow_clustering_method": workflow_clusters.method,
        },
        "M4_workflow_reuse": {
            "intent_clusters": intent_cluster_count,
            "distinct_workflows": distinct_workflows,
            "workflows_per_intent_cluster": safe_div(distinct_workflows, max(intent_cluster_count, 1), 2),
