def normalize_key(value: Any) -> str:
    if value is None:
        return ""
    return re.sub(r"[^a-z0-9]+", "_", str(value).strip().lower()).strip("_")


def normalize_text(value: Any) -> str:
    if value is None:
        return ""
    text = str(value)
    text = text.replace("\\n", " ").replace("\\r", " ").replace("\\t", " ")
    return re.sub(r"\s+", " ", text).strip()


def normalize_label(value: Any) -> str:
    """Aggressive normalisation used for clustering / dedup of labels."""
    return re.sub(r"[^a-z0-9]+", " ", str(value).lower()).strip()


def short_text(value: Any, limit: int = DEFAULT_PREVIEW_CHARS) -> str:
    text = normalize_text(value)
    return text if len(text) <= limit else text[:limit] + "..."


def stable_hash(value: str, length: int = 20) -> str:
    return hashlib.sha256(value.encode("utf-8", errors="ignore")).hexdigest()[:length]


def json_dumps_safe(value: Any) -> str:
    try:
        return json.dumps(value, ensure_ascii=False, default=str)
    except Exception:
        return str(value)


def unique_preserve_order(values: Iterable[Any]) -> List[Any]:
    seen: Set[str] = set()
    output: List[Any] = []
    for value in values:
        marker = json_dumps_safe(value)
        if marker not in seen:
            seen.add(marker)
            output.append(value)
    return output


def is_nullish(value: Any) -> bool:
    return normalize_text(value).strip().lower() in NULLISH


def safe_div(numerator: float, denominator: float, digits: int = 6) -> float:
    return round(numerator / denominator, digits) if denominator else 0.0


def pct(part: float, whole: float) -> float:
    return round(100.0 * part / whole, 2) if whole else 0.0


def log(message: str, quiet: bool = False) -> None:
    if not quiet:
        print(message, flush=True)


# ============================================================
# SAFE JSON / PYTHON-LITERAL DECODING
# ============================================================

def try_decode(value: Any, depth: int = 0) -> Any:
    """
    Decode JSON strings, Python literals and JSON-inside-JSON, recursively.
    Handles CSV-doubled quotes ("" -> ") and backslash-escaped quotes, which is
    exactly how the tool_history payloads arrive in these dumps.
    """
    if depth >= JSON_MAX_DEPTH:
        return value

    if isinstance(value, dict):
        return {k: try_decode(v, depth + 1) for k, v in value.items()}

    if isinstance(value, list):
        return [try_decode(v, depth + 1) for v in value]

    if not isinstance(value, str):
        return value

    text = value.strip()
    if len(text) < 2:
        return value

    if not ((text[0] == "{" and text[-1] == "}") or (text[0] == "[" and text[-1] == "]")):
        return value

    for candidate in _decode_candidates(text):
        try:
            return try_decode(json.loads(candidate), depth + 1)
        except Exception:
            continue

    try:
        decoded = ast.literal_eval(text)
        if isinstance(decoded, (dict, list, tuple)):
            return try_decode(list(decoded) if isinstance(decoded, tuple) else decoded, depth + 1)
    except Exception:
        pass

    return value


def _decode_candidates(text: str) -> Iterator[str]:
    """Progressive un-escaping attempts, cheapest first."""
    yield text
    if '""' in text:
        yield text.replace('""', '"')
    if '\\"' in text:
        yield text.replace('\\"', '"')
    if '""' in text and '\\"' in text:
        yield text.replace('""', '"').replace('\\"', '"')


# ============================================================
# RECURSIVE STRUCTURE WALKER
# ============================================================

def walk(obj: Any, path: Tuple[str, ...] = ()) -> Iterator[Tuple[Tuple[str, ...], str, Any]]:
    """Yield (path, normalized_key, value) across nested dict/list structures."""
    if isinstance(obj, dict):
        for key, value in obj.items():
            nkey = normalize_key(key)
            yield path, nkey, value
            yield from walk(value, path + (nkey,))
    elif isinstance(obj, list):
        for idx, value in enumerate(obj):
            yield from walk(value, path + (str(idx),))


def find_values_by_key_patterns(
    obj: Any,
    include_patterns: Sequence[str],
    exclude_patterns: Sequence[str] = (),
) -> List[Any]:
    output: List[Any] = []
    for _, key, value in walk(obj):
        if not key:
            continue
        if not any(pattern in key for pattern in include_patterns):
            continue
        if any(pattern in key for pattern in exclude_patterns):
            continue
        if isinstance(value, (str, int, float, bool)):
            output.append(value)
        elif isinstance(value, list):
            for item in value:
                if isinstance(item, (str, int, float, bool)):
                    output.append(item)
    return output


def find_values_by_exact_keys(obj: Any, keys: Sequence[str]) -> List[Any]:
    wanted = {normalize_key(k) for k in keys}
    output: List[Any] = []
    for _, key, value in walk(obj):
        if key in wanted and isinstance(value, (str, int, float, bool)):
            output.append(value)
    return output


# ============================================================
# TIMESTAMP PARSING
# ============================================================

def parse_timestamp(value: Any) -> Optional[datetime]:
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, datetime):
        return value if value.tzinfo else value.replace(tzinfo=timezone.utc)
    if isinstance(value, (int, float)):
        return _from_epoch(float(value))

    text = normalize_text(value)
    if not text or text.lower() in NULLISH:
        return None

    iso_text = text.replace("Z", "+00:00")
    try:
        parsed = datetime.fromisoformat(iso_text)
        return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
    except Exception:
        pass

    for fmt in TIMESTAMP_FORMATS:
        try:
            parsed = datetime.strptime(text, fmt)
            return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
        except Exception:
            continue

    stripped = text.replace(".", "", 1)
    if stripped.isdigit():
        return _from_epoch(float(text))

    return None


def _from_epoch(value: float) -> Optional[datetime]:
    if value <= 0:
        return None
    if value > 1e17:        # nanoseconds
        value /= 1e9
    elif value > 1e14:      # microseconds
        value /= 1e6
    elif value > 1e11:      # milliseconds
        value /= 1e3
    try:
        return datetime.fromtimestamp(value, tz=timezone.utc)
    except Exception:
        return None


def extract_timestamp(node: Dict[str, Any]) -> Optional[datetime]:
    normalized = {normalize_key(k): v for k, v in node.items()}
    for key in TIMESTAMP_KEYS:
        if key in normalized:
            parsed = parse_timestamp(normalized[key])
            if parsed:
                return parsed
    return None


def find_any_timestamp(obj: Any) -> Optional[datetime]:
    for value in find_values_by_exact_keys(obj, TIMESTAMP_KEYS):
        parsed = parse_timestamp(value)
        if parsed:
            return parsed
    return None


def iso_or_blank(value: Optional[datetime]) -> str:
    return value.isoformat() if value else ""


