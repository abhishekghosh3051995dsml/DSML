                1 for call in all_tool_calls if call.is_A_api and call.side == "agent"
            ),
            "A_calls_tool_side": sum(
                1 for call in all_tool_calls if call.is_A_api and call.side == "tool"
            ),
            "calls_agent_side": sum(1 for call in all_tool_calls if call.side == "agent"),
            "calls_tool_side": sum(1 for call in all_tool_calls if call.side == "tool"),
            "successful_tool_calls": status_counter["success"],
            "partial_tool_calls": status_counter["partial"],
            "no_data_tool_calls": status_counter["no_data"],
            "skipped_tool_calls": status_counter["skipped"],
            "error_tool_calls": status_counter["error"],
            "empty_tool_calls": status_counter["empty"],
            "tool_success_rate": safe_div(status_counter["success"], total_tool_calls),
            "tool_error_rate": safe_div(status_counter["error"], total_tool_calls),
            "tool_no_data_rate": safe_div(status_counter["no_data"], total_tool_calls),
            "interactions_with_parallel_calls": interactions_with_parallel,
            "max_parallel_degree": max(
                (item.max_parallel_degree() for item in interactions.values()), default=0
            ),
        },
        "M6_baseline": {
            "positive_samples": sentiment_counter["positive"],
            "negative_samples": sentiment_counter["negative"],
            "unlabelled_samples": sentiment_counter["unknown"],
            "positive_pct": pct(sentiment_counter["positive"], total_interactions),
            "negative_pct": pct(sentiment_counter["negative"], total_interactions),
            "window_start": iso_or_blank(min(timestamps)) if timestamps else "",
            "window_end": iso_or_blank(max(timestamps)) if timestamps else "",
            "interactions_with_timestamp": len(timestamps),
        },
        "data_quality": {
            "ingest": ingest_report,
            "filters": filter_report,
            "interactions_without_tool_calls": total_interactions - interactions_with_tools,
            "interactions_without_intent": total_interactions - interactions_with_intent,
            "interactions_without_problem": total_interactions - interactions_with_problem,
        },
    }


