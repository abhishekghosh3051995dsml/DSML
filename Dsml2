                   tick_labels=[str(r)[:14] for r in order], showfliers=False,
                   patch_artist=True,
                   boxprops=dict(facecolor="#bee3f8", edgecolor="#2b6cb0"),
                   medianprops=dict(color="#c05621", linewidth=2))
        ax.set_ylabel("characters")
        ax.set_title("Message length by role", loc="left", fontweight="600")
        R.fig(fig, "User messages are short problem statements; assistant "
                   "messages are long analyses. Two different populations.")

    # ---- 1.6 association, FIXED: labelled rows only -------------------------
    log("  1.6 association")
    if C.get("turn_label"):
        R.h("1.6 Which columns relate to the label", 3)
        lab_col = C["turn_label"]
        labelled = df[df[lab_col].fillna("").astype(str).str.strip() != ""].copy()
        R.note(f"Computed on the {len(labelled):,} rows that actually carry a "
               f"label. In v2 this ran across all {len(df):,} rows with the "
               f"unlabelled assistant rows filled in as a blank category, which "
               f"made the role column score 0.9999 and read as "
               f"'NEAR-DETERMINISTIC'. That was an artefact of the blank fill: "
               f"the role column was predicting whether a label existed, not "
               f"which label it was.")
        y = labelled[lab_col].astype(str)
        rows = []
        for c in labelled.columns:
            if c == lab_col or c in FORBIDDEN_OUTPUT_COLS or c == "_masked":
                continue
            nun = labelled[c].fillna("_").nunique()
            if nun < 2 or nun > 400:
                continue
            a = labelled[c].fillna("__blank__").astype(str)
            if a.nunique() > 200:
                a = a.where(a.isin(a.value_counts().head(200).index), "__other__")
            rows.append({"column": c, "cramers_v": round(cramers_v(a, y), 4),
                         "theils_u_label_given_column": round(theils_u(y, a), 4),
                         "distinct": int(a.nunique())})
        A = pd.DataFrame(rows).sort_values("cramers_v", ascending=False)
        if len(A):
            A["reads_as"] = np.where(
                A["cramers_v"] > 0.9,
                "NEAR-DETERMINISTIC - this column effectively IS the label",
                np.where(A["cramers_v"] > 0.5, "strong",
                         np.where(A["cramers_v"] > 0.2, "moderate", "weak")))
            R.csv(A, "p1_08_association_with_label.csv")
            R.table(A)
            R.fig(barh(A.head(12)["column"].tolist(),
                       A.head(12)["cramers_v"].fillna(0).values,
                       "Cramer's V", "Association with the per-message label",
                       color=PALETTE[3]))
            R.note("Cramer's V comes from the chi-square test of independence "
                   "and runs 0 to 1. Near 1 means that column already contains "
                   "the answer. Theil's U is asymmetric, so it also shows the "
                   "direction of the dependence.")
    return df


# =============================================================================
# PHASE 2  TEMPLATE EXTRACTION, MASKING, CLEANING
# =============================================================================

TELECOM_TERMS = {
    r"\bhsi\b": "home internet service", r"\bmsisdn\b": "mobile number",
    r"\bimei\b": "device identifier", r"\biccid\b": "sim identifier",
    r"\bban\b": "billing account", r"\bsoc\b": "service code",
    r"\bapn\b": "access point name", r"\bvolte\b": "voice over lte",
    r"\bcpe\b": "customer premises equipment", r"\besim\b": "embedded sim",
    r"\bcx\b": "customer", r"\brca\b": "root cause analysis",
}


def phase2(df, C, R):
    log("\n=== PHASE 2  TEMPLATE, MASKING, CLEANING ===")
    R.h("Phase 2 - Extracting the real problem statement")

    if C.get("role"):
        user = df[df["_role"] == "user"].copy()
    else:
        user = df.copy()
    log(f"  user messages: {len(user):,} of {len(df):,}")

    # capture the BEFORE median now, on the unfiltered frame (v2.1 fix)
    median_before = int(user["_raw"].str.len().median())

    log("  2.1 discovering the intake template")
    fields, payload, TR = discover_template(user["_raw"].tolist())
    if len(TR):
        R.h("2.1 The intake form, discovered from the data", 3)
        R.csv(TR, "p2_01_template_fields.csv")
        R.table(TR[TR["promoted"]], max_rows=30)
        R.note("These field labels were found by pattern and ranked by how "
               "often they appear; the cutoff is the knee of that frequency "
               "curve. Nothing about this form is written into the code, so a "
               "different intake layout in a future export is discovered the "
               "same way. The 'holds' column records what kind of identifier "
               "each field carries. No example VALUES are shown, and every "
               "field whose 'holds' is not free_text has its values dropped "
               "entirely rather than masked - a stable surrogate for a BAN is "
               "still a join key back to one customer.")
    if payload:
        cov = float(TR.loc[TR['field'] == payload, 'coverage_pct'].iloc[0])
        R.ok(f"Free-text payload field identified: '{payload}' "
             f"(present in {cov:.1f}% of user messages). This is the "
             f"customer's actual problem statement. Everything else on the "
             f"form is identifiers and is discarded.")
        prov("payload_field", payload, "DERIVED",
             "promoted free-text field with the greatest median word count")
        finding("INFO", "Intake form detected and split",
                f"{len(fields)} recurring fields; payload = '{payload}'.",
                "Model on the payload, not the whole form.")
        if cov < 30:
            R.warn(f"The payload field appears in only {cov:.1f}% of user "
                   f"messages, so the form-splitting path applies to a small "
                   f"minority of the data. The rest are free text and reach "
                   f"the model through span masking alone. Do not read the "
                   f"'model on the payload' fix as covering the corpus.")
            finding("MEDIUM", "Payload field has low coverage",
                    f"'{payload}' present in {cov:.1f}% of user messages.",
                    "Treat form-splitting as a minority path; most X is free "
                    "text.")
    else:
        R.warn("No free-text payload field could be identified. Falling back to "
               "the whole message as X.")

    log("  2.2 field-aware masking and gating")
    issue_txt, n_templated = [], 0
    for t in user["_raw"]:
        f, rest = split_fields(t)
        if f:
            n_templated += 1
        if payload and payload in f:
            body = GUARD.mask_field(payload, f[payload])
        elif f:
            # no payload field present: keep only free-text field values
            parts = [GUARD.mask_field(k, v) for k, v in f.items()
                     if field_kind(k) is None]
            body = " ".join(p for p in parts if p)
            if rest.strip():
                body = (body + " " + GUARD.mask_text(rest)).strip()
        else:
            body = GUARD.mask_text(t)
        issue_txt.append(body or "")

    user["_issue"] = pd.Series(issue_txt, index=user.index).fillna("")
    R.p(f"{n_templated:,} of {len(user):,} user messages "
        f"({100.0 * n_templated / max(len(user), 1):.1f}%) are form-structured; "
        f"the remainder are free text. Both paths converge on a single problem "
        f"statement field.")

    log("  2.3 normalising")
    clean = user["_issue"].str.lower()
    for pat, rep in TELECOM_TERMS.items():
        clean = clean.str.replace(pat, rep, regex=True)
    clean = (clean.str.replace(r"<([a-z]+)_[0-9a-f]+>", r" ", regex=True,
                               flags=re.IGNORECASE)
             .str.replace(r"\s+", " ", regex=True).str.strip())
    user["_clean"] = clean
    prov("telecom_abbreviations", len(TELECOM_TERMS), "DOMAIN_FACT",
         "SME lexicon; exported for review")

    before = len(user)
    user = user[user["_clean"].str.len() >= 3].copy()
    dup = int(user["_clean"].duplicated().sum())

    # ---- residue check on exactly what will be modelled --------------------
    res = []
    for name, rx in RESIDUE_CHECKS:
        probe = user["_clean"].map(lambda x: SURROGATE_RE.sub(" ", x))
        n = int(probe.str.contains(rx).sum())
        res.append({"check": name, "rows_with_residue": n,
                    "pct": round(100.0 * n / max(len(user), 1), 3),
                    "status": "PASS" if n == 0 else "REVIEW"})
    RES = pd.DataFrame(res)
    R.csv(RES, "p2_02_pii_residue_check.csv")
    R.h("PII residue check on the modelled text", 3)
    R.table(RES)
    if (RES["status"] == "REVIEW").any():
        R.warn("Residue detected in the modelled text. Note that these rows "
               "are still SAFE TO SHIP: any cell that fails these same checks "
               "is blanked by the output gate before it reaches this report or "
               "any CSV. This table tells you the masker missed something, not "
               "that something leaked.")
        finding("MEDIUM", "Masker missed a pattern",
                RES[RES.status == "REVIEW"].to_dict("records"),
                "Extend PII_PATTERNS so the gate has less work to do; no "
                "output is exposed either way.")
    else:
        R.ok("Nothing matching an identifier pattern remains in the text that "
             "will be modelled.")

    R.csv(GUARD.summary(), "p2_03_masking_summary.csv")

    steps = pd.DataFrame([
        {"step": "1 split the intake form into fields",
         "detail": f"{len(fields)} recurring fields discovered; "
                   f"payload = {payload or 'n/a'}"},
        {"step": "2 drop identifier fields, mask free text",
         "detail": f"{sum(GUARD.counts.values()):,} values dropped or replaced "
                   f"with salted surrogates"},
        {"step": "3 keep user messages only",
         "detail": f"{len(user):,} kept; assistant messages excluded from X "
                   f"because they contain the answer"},
        {"step": "4 reduce to the problem statement",
         "detail": f"median length {median_before} chars -> "
                   f"{int(user['_clean'].str.len().median())} chars after "
                   f"removing form furniture and identifiers"},
        {"step": "5 expand telecom abbreviations",
         "detail": f"{len(TELECOM_TERMS)} domain terms normalised"},
        {"step": "6 drop empty after cleaning",
         "detail": f"{before - len(user):,} dropped"},
        {"step": "7 duplicate check",
         "detail": f"{dup:,} messages repeat text already seen "
                   f"({100.0 * dup / max(len(user), 1):.1f}%). Kept for "
                   f"analysis; collapsed before clustering and before any "
                   f"train/test split."},
    ])
    R.h("2.2 Cleaning steps", 3)
    R.csv(steps, "p2_04_cleaning_steps.csv")
    R.table(steps)
    R.note("X is the customer's problem statement with every identifier "
           "removed. There is deliberately no before/after sample export in "
           "this version: v2 wrote one, and a before column is by definition "
           "raw customer data.")
    return user, fields, payload


# =============================================================================
# PHASE 3  EDA + PCA
# =============================================================================

def phase3(user, C, R, stopwords, seed):
    log("\n=== PHASE 3  EDA + PCA ===")
    R.h("Phase 3 - EDA and PCA: is the label learnable from the text?")

    vec = TfidfVectorizer(max_features=60000, ngram_range=(1, 2), min_df=3,
                          max_df=0.6, stop_words=list(stopwords),
                          sublinear_tf=True)
    Xs = vec.fit_transform(user["_clean"])
    log(f"  TF-IDF {Xs.shape}")
    k = int(min(200, Xs.shape[1] - 1, max(2, Xs.shape[0] - 1)))
    svd = TruncatedSVD(n_components=k, random_state=seed)
    Xd = svd.fit_transform(Xs)
    R.p(f"Vectorised to {Xs.shape[1]:,} TF-IDF features, compressed to {k} "
        f"components holding {svd.explained_variance_ratio_.sum():.1%} of the "
        f"variance.")
    prov("tfidf_vocabulary", Xs.shape[1], "DERIVED", "learned from this corpus")
    prov("svd_components", k, "REVIEW_GATE",
         "extraction width; retention decided by the criteria below")

    Z = StandardScaler().fit_transform(Xd)
    npc = int(min(30, Z.shape[1]))
    pca = PCA(n_components=npc, random_state=seed)
    P = pca.fit_transform(Z)
    ev = pca.explained_variance_ratio_
    scree = pd.DataFrame({"component": range(1, npc + 1),
                          "eigenvalue": np.round(pca.explained_variance_, 4),
                          "explained_variance_ratio": np.round(ev, 5),
                          "cumulative": np.round(np.cumsum(ev), 5)})
    scree["kaiser_retain"] = scree["eigenvalue"] > 1.0
    R.csv(scree, "p3_01_pca_scree.csv")
    n90 = int((scree["cumulative"] < 0.90).sum()) + 1
    prov("pca_components_kaiser", int(scree["kaiser_retain"].sum()), "DERIVED",
         "eigenvalue > 1")
    prov("pca_components_for_90pct", n90, "DERIVED", "cumulative variance")

    lab = C.get("turn_label")
    fig, axes = plt.subplots(1, 2, figsize=(12, 3.9))
    axes[0].bar(range(1, npc + 1), ev, color=PALETTE[0])
    axes[0].plot(range(1, npc + 1), np.cumsum(ev), color=PALETTE[1], marker="o",
                 markersize=3)
    axes[0].axhline(0.9, color="#a0aec0", linestyle="--", linewidth=1)
    axes[0].set_xlabel("component")
    axes[0].set_ylabel("explained variance")
    axes[0].set_title("scree (dashed = 90%)", loc="left", fontsize=10)
    if lab:
        y = user[lab].fillna("__blank__").astype(str)
        for i, u in enumerate(y.value_counts().head(8).index):
            m = (y == u).values
            axes[1].scatter(P[m, 0], P[m, 1], s=7, alpha=0.4,
                            color=PALETTE[i % len(PALETTE)], label=str(u)[:18])
        axes[1].legend(fontsize=7, markerscale=1.8, frameon=False)
        axes[1].set_title("PC1 vs PC2, coloured by label", loc="left", fontsize=10)
    axes[1].set_xlabel("PC1")
    axes[1].set_ylabel("PC2")
    R.fig(fig, "If the colours separate, the labels are learnable from the "
               "text. If they overlap completely, the taxonomy is the problem, "
               "not the model.")
    R.p(f"{int(scree['kaiser_retain'].sum())} components have eigenvalue > 1 "
        f"(Kaiser criterion); {n90} are needed for 90% of the variance.")

    if lab:
        y = user[lab].fillna("__blank__").astype(str).values
        rows = []
        for i in range(min(10, P.shape[1])):
            s = pd.Series(P[:, i])
            g = s.groupby(y)
            between, within = float(g.mean().var()), float(g.var().mean())
            rows.append({"component": f"PC{i+1}",
                         "between_group_var": round(between, 5),
                         "within_group_var": round(within, 5),
                         "fisher_ratio": round(between / within, 5) if within else None})
        FR = pd.DataFrame(rows).sort_values("fisher_ratio", ascending=False)
        FR["reads_as"] = np.where(FR["fisher_ratio"].fillna(0) > 0.1,
                                  "carries real class structure",
                                  "mostly within-class noise")
        R.csv(FR, "p3_02_pca_fisher_ratio.csv")
        R.h("Does any component separate the classes?", 3)
        R.table(FR)
        best = float(FR["fisher_ratio"].max() or 0)
        if best < 0.1:
            R.warn("No principal component separates the classes. The label is "
                   "not expressible as a direction in this representation - "
                   "expect weak linear performance and treat the taxonomy "
                   "itself as suspect.")
            finding("MEDIUM", "No component separates the classes",
                    f"best Fisher ratio {best:.3f}",
                    "Prioritise SME review of the taxonomy over model tuning.")
        elif best < 0.3:
            R.warn(f"The best component reaches a Fisher ratio of only "
                   f"{best:.3f}. There is some class structure but it is thin, "
                   f"and it sits on one component while the rest are noise.")
    return Xs, Xd, vec


# =============================================================================
# PHASE 4  CLUSTERING  (deduplicated, multi-criterion)
# =============================================================================

def phase4(user, C, R, stopwords, max_k, seed):
    log("\n=== PHASE 4  CLUSTERING ===")
    R.h("Phase 4 - Clustering: what customers actually talk about")

    # Deduplicate first. In v1 one sentence repeated 112 times became its own
    # cluster; that is a duplicate, not a topic. Weights keep the frequency
    # information without letting it dominate the geometry.
    grp = (user.groupby("_clean").size().rename("weight").reset_index())
    grp = grp[grp["_clean"].str.len() >= 8]
    R.p(f"{len(user):,} user messages collapse to {len(grp):,} distinct problem "
        f"statements. Clustering runs on the distinct texts with frequency "
        f"weights, so a single repeated sentence cannot form its own cluster.")
    prov("dedup_distinct_texts", len(grp), "DERIVED", "unique cleaned statements")
    if len(grp) < 40:
        R.warn("Too few distinct statements to cluster meaningfully.")
        return user

    vec = TfidfVectorizer(max_features=40000, ngram_range=(1, 2), min_df=2,
                          max_df=0.6, stop_words=list(stopwords), sublinear_tf=True)
    S = vec.fit_transform(grp["_clean"])
    kk = int(min(120, S.shape[1] - 1, max(2, S.shape[0] - 1)))
    D = TruncatedSVD(n_components=kk, random_state=seed).fit_transform(S)

    hi = max(3, min(max_k, len(grp) // 30))
    rows, models = [], {}
    for k in range(2, hi + 1):
        km = KMeans(n_clusters=k, random_state=seed, n_init=6).fit(D)
        try:
            sil = silhouette_score(D, km.labels_, sample_size=min(4000, len(D)),
                                   random_state=seed)
            ch = calinski_harabasz_score(D, km.labels_)
            db = davies_bouldin_score(D, km.labels_)
        except Exception:
            continue
        rows.append({"k": k, "silhouette": round(float(sil), 4),
                     "calinski_harabasz": round(float(ch), 1),
                     "davies_bouldin": round(float(db), 4)})
        models[k] = km
    SC = pd.DataFrame(rows)
    if SC.empty:
        R.warn("Cluster quality could not be computed.")
        return user
    R.csv(SC, "p4_01_cluster_quality_by_k.csv")

    k_sil = int(SC.loc[SC["silhouette"].idxmax(), "k"])
    k_ch = int(SC.loc[SC["calinski_harabasz"].idxmax(), "k"])
    k_db = int(SC.loc[SC["davies_bouldin"].idxmin(), "k"])
    votes = Counter([k_sil, k_ch, k_db])
    k_best = votes.most_common(1)[0][0]
    prov("k_selected", k_best, "DERIVED",
         f"majority of three criteria: silhouette={k_sil}, "
         f"Calinski-Harabasz={k_ch}, Davies-Bouldin={k_db}")

    fig, axes = plt.subplots(1, 3, figsize=(13, 3.2))
    for ax, col, ttl, best in [
            (axes[0], "silhouette", "silhouette (higher better)", k_sil),
            (axes[1], "calinski_harabasz", "Calinski-Harabasz (higher better)", k_ch),
            (axes[2], "davies_bouldin", "Davies-Bouldin (lower better)", k_db)]:
        ax.plot(SC["k"], SC[col], marker="o", markersize=3, color=PALETTE[0])
        ax.axvline(best, color=PALETTE[1], linestyle="--", linewidth=1)
        ax.set_xlabel("k")
        ax.set_title(ttl, loc="left", fontsize=9)
    R.fig(fig, "Three independent measures of cluster quality. Where they "
               "agree, the structure is real; where they disagree, it is weak.")
    R.table(SC)
    R.p(f"Selected k = {k_best}. Silhouette prefers {k_sil}, "
        f"Calinski-Harabasz prefers {k_ch}, Davies-Bouldin prefers {k_db}.")

    sil_best = float(SC["silhouette"].max())
    if sil_best < 0.25:
        R.warn(f"Peak silhouette is only {sil_best:.3f}. The problem statements "
               f"do not form well-separated groups in this representation - "
               f"the clusters below are weak and should be read as suggestive, "
               f"not as a taxonomy. Sentence embeddings would likely separate "
               f"this text better than TF-IDF.")
        finding("MEDIUM", "Weak cluster separation",
                f"peak silhouette {sil_best:.3f} at k={k_sil}",
                "Re-run with sentence embeddings before treating clusters as "
                "an intent taxonomy.")

    km = models[k_best]
    grp["_cluster"] = km.labels_

    # name the clusters with c-TF-IDF
    terms = np.array(vec.get_feature_names_out())
    rows = []
    for c in sorted(set(km.labels_)):
        m = (km.labels_ == c)
        inside = np.asarray(S[m].mean(axis=0)).ravel()
        outside = np.asarray(S[~m].mean(axis=0)).ravel()
        idx = (inside - outside).argsort()[::-1][:12]
        ex = (grp.loc[m].sort_values("weight", ascending=False)["_clean"]
              .head(3).tolist())
        rows.append({"cluster": int(c),
                     "distinct_statements": int(m.sum()),
                     "messages": int(grp.loc[m, "weight"].sum()),
                     "pct_of_messages": round(100.0 * grp.loc[m, "weight"].sum()
                                              / grp["weight"].sum(), 2),
                     "top_terms": ", ".join(terms[idx]),
                     "example_1": (ex[0][:150] if ex else ""),
                     "example_2": (ex[1][:150] if len(ex) > 1 else ""),
                     "example_3": (ex[2][:150] if len(ex) > 2 else "")})
    CT = pd.DataFrame(rows).sort_values("messages", ascending=False)
    ex_cols = ("example_1", "example_2", "example_3")
    R.csv(CT, "p4_02_cluster_terms.csv", free_text_cols=ex_cols)
    R.h("What each cluster is about", 3)
    R.table(CT, max_rows=40, free_text_cols=ex_cols)
    R.note("Cluster names come from c-TF-IDF: the words that make a cluster "
           "different from every other cluster, not simply its most common "
           "words. An SME reads this table and names each cluster - that is "
           "the detailed-intent layer, discovered rather than invented. The "
           "example columns are masked problem statements that also passed the "
           "output gate; any example that still looked like it held an "
           "identifier or a name was blanked rather than shown.")

    # a catch-all cluster is its own kind of degeneracy: flag it
    top = CT.iloc[0]
    if float(top["pct_of_messages"]) > 30:
        R.warn(f"Cluster {int(top['cluster'])} holds "
               f"{top['pct_of_messages']}% of all messages. A cluster that "
               f"absorbs a third or more of the corpus is a catch-all, not a "
               f"topic - it is where everything the representation could not "
               f"separate has landed. Read its terms as a residue list, not as "
               f"an intent.")
        finding("MEDIUM", "Catch-all cluster dominates",
                f"cluster {int(top['cluster'])} holds "
                f"{top['pct_of_messages']}% of messages",
                "Split it with sentence embeddings, and check whether a canned "
                "template (for example an outage notice) is pooling inside it.")

    user = user.merge(grp[["_clean", "_cluster"]], on="_clean", how="left")

    lab = C.get("turn_label")
    if lab:
        y = user[lab].fillna("__unlabelled__").astype(str)
        ct = pd.crosstab(user["_cluster"], y)
        keep = ct.sum(axis=1).sort_values(ascending=False).head(40).index
        ct = ct.loc[keep]
        rn = ct.div(ct.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
        R.h("Cluster x intent heat map", 3)
        R.fig(heat(rn.values, list(ct.columns),
                   [f"cluster {int(i)}" for i in ct.index],
                   "Cluster (rows) x intent (columns), row-normalised",
                   "share of cluster", cmap="YlGnBu"))
        R.csv(ct.reset_index(), "p4_03_cluster_x_intent.csv")

        pur = pd.DataFrame({"cluster": ct.index, "messages": ct.sum(axis=1).values,
                            "dominant_intent": rn.idxmax(axis=1).values,
                            "purity": rn.max(axis=1).round(3).values})
        base = float(y.value_counts(normalize=True).max())
        pur["lift_over_base_rate"] = (pur["purity"] - base).round(3)
        pur["reads_as"] = np.where(
            pur["lift_over_base_rate"] > 0.15,
            "informative - this cluster really is mostly one intent",
            np.where(pur["lift_over_base_rate"] > 0.05, "mildly informative",
                     "no better than guessing the majority class"))
        R.csv(pur.sort_values("messages", ascending=False), "p4_04_cluster_purity.csv")
        R.h("Cluster purity, compared against the base rate", 3)
        R.table(pur.sort_values("messages", ascending=False), max_rows=40)
        R.note(f"The majority class is {100 * base:.1f}% of messages, so a "
               f"cluster with purity below that is telling us nothing. The lift "
               f"column is the honest measure - purity minus the base rate.")
        prov("majority_class_base_rate", round(base, 4), "DERIVED",
             "share of the most common label")

    keepcols = [c for c in [C.get("case"), C.get("turn"), lab, "_clean", "_cluster"]
                if c]
    R.csv(user[keepcols], "p4_05_messages_with_clusters.csv",
          free_text_cols=("_clean",))
    return user


# =============================================================================
# PHASE 5  TURN INTENT -> CONVERSATION INTENT
# =============================================================================

def phase5(user, C, R):
    log("\n=== PHASE 5  TURN -> CONVERSATION INTENT ===")
    R.h("Phase 5 - From per-message intent to conversation intent")
    lab, case, conv = C.get("turn_label"), C.get("case"), C.get("conv_label")
    if not (lab and case):
        R.warn("Needs both a per-message label and a case key. Skipped.")
        return

    u = user[user[lab].fillna("").astype(str).str.strip() != ""].copy()
    u = u.sort_values([case, "_turn"])
    seqs, verdicts = [], []
    for _, g in u.groupby(case):
        seqs.append(list(g[lab].astype(str)))
        if conv:
            v = g[conv].dropna().astype(str)
            verdicts.append(v.iloc[0] if len(v) else None)
        else:
            verdicts.append(None)

    multi = [s for s in seqs if len(s) > 1]
    changed = [s for s in multi if len(set(s)) > 1]
    change_rate = len(changed) / max(len(multi), 1)

    labs = sorted({x for s in seqs for x in s})
    M = np.zeros((len(labs), len(labs)))
    li = {l: i for i, l in enumerate(labs)}
    for s in seqs:
        for a, b in zip(s, s[1:]):
            M[li[a], li[b]] += 1
    rs = M.sum(axis=1, keepdims=True)
    P = np.divide(M, rs, out=np.zeros_like(M), where=rs > 0)
    R.h("How intent moves through a conversation", 3)
    R.fig(heat(P, labs, labs, "Intent at message t (rows) -> message t+1 (columns)",
               "probability", cmap="Blues"))
    R.csv(pd.DataFrame(M, index=labs, columns=labs).reset_index()
          .rename(columns={"index": "from_to"}), "p5_01_transition_counts.csv")

    R.p(f"{len(seqs):,} conversations have at least one labelled user message. "
        f"{len(multi):,} have more than one. Of those, {len(changed):,} "
        f"({100 * change_rate:.1f}%) change intent during the conversation.")

    if change_rate == 0 and len(multi) > 0:
        R.warn("THE INTENT NEVER CHANGES WITHIN A CONVERSATION. Every labelled "
               "message in a conversation carries the same value. That means "
               "the per-message label is the CONVERSATION label copied down "
               "onto the messages - it is not an independent per-message "
               "judgement. Two consequences: (1) we do not actually have two "
               "label sources, we have one; (2) the rule test below is "
               "arithmetic, not a finding, because when every message shares a "
               "label, first / last / majority all return the same answer by "
               "construction.")
        finding("HIGH", "Per-message label does not vary within a conversation",
                f"{len(multi)} multi-message conversations, 0 with any change.",
                "Ask the data owner whether the per-message label is generated "
                "per message or inherited from the case. If inherited, a "
                "genuine per-message target must be created before "
                "message-level modelling means anything.")
    elif changed:
        J = pd.DataFrame(Counter(" -> ".join(s) for s in changed).most_common(20),
                         columns=["journey", "conversations"])
        R.csv(J, "p5_02_intent_journeys.csv")
        R.h("Most common intent journeys", 3)
        R.table(J)
        R.ok("Intent does change within conversations - the evidence for "
             "modelling the conversation as a sequence rather than a single "
             "label.")

    if conv and any(v is not None for v in verdicts):
        pairs = [(s, v) for s, v in zip(seqs, verdicts) if v is not None]
        cnt = Counter()
        for s, _ in pairs:
            cnt.update(s)
        rarity = {k: i for i, (k, _) in enumerate(sorted(cnt.items(),
                                                         key=lambda kv: kv[1]))}
        rules = {"first_message": lambda s: s[0],
                 "last_message": lambda s: s[-1],
                 "majority_vote": lambda s: Counter(s).most_common(1)[0][0],
                 "rarest_class_wins": lambda s: min(s, key=lambda x: rarity.get(x, 1e9))}
        rows = []
        for name, fn in rules.items():
            ok = [fn(s) == v for s, v in pairs]
            rows.append({"rule": name, "conversations": len(ok),
                         "agreement_pct": round(100.0 * np.mean(ok), 2)})
        RU = pd.DataFrame(rows).sort_values("agreement_pct", ascending=False)
        R.csv(RU, "p5_03_global_intent_rules.csv")
        R.h("Is the conversation label just a rule over the messages?", 3)
        R.fig(barh(RU["rule"].tolist(), RU["agreement_pct"].values,
                   "% agreement with the conversation label",
                   "Do simple rules reproduce the conversation verdict?",
                   color=PALETTE[2]))
        R.table(RU)
        spread = float(RU["agreement_pct"].max() - RU["agreement_pct"].min())
        if change_rate == 0:
            R.warn("All rules score identically because the label never varies "
                   "within a conversation. This table is VACUOUS on this export "
                   "and must not be reported as evidence that a rule was "
                   "discovered.")
        elif spread < 1.0:
            R.warn("All rules score within one point of each other, so this "
                   "test does not distinguish between them.")
        else:
            best = RU.iloc[0]
            R.ok(f"'{best['rule']}' reproduces the conversation label "
                 f"{best['agreement_pct']}% of the time, clearly ahead of the "
                 f"alternatives. Implement that rule rather than training a "
                 f"second model.")


# =============================================================================
# PHASE 6  TWO LABEL SETS
# =============================================================================

def build_rules(texts, labels, stopwords, min_z=2.5, top_n=40):
    KW = weighted_log_odds(texts, labels, stopwords, top_n=top_n)
    if KW.empty:
        return {}
    KW = KW[KW["z_score"] >= min_z]
    r = defaultdict(dict)
    for _, x in KW.iterrows():
        r[x["class"]][x["keyword"]] = float(x["z_score"])
    return dict(r)


def apply_rules(texts, rules):
    classes = sorted(rules.keys())
    preds, confs = [], []
    for t in texts:
        toks = set(re.findall(r"[a-z][a-z_\-]{2,}", str(t).lower()))
        sc = {c: sum(w for k, w in rules[c].items() if k in toks) for c in classes}
        tot = sum(sc.values())
        if tot <= 0:
            preds.append(None)
            confs.append(0.0)
            continue
        rk = sorted(sc.items(), key=lambda kv: kv[1], reverse=True)
        top = rk[0][1]
        second = rk[1][1] if len(rk) > 1 else 0.0
        preds.append(rk[0][0])
        confs.append(round((top - second) / tot, 4))
    return preds, confs


def phase6(user, C, R, stopwords, field_words, seed):
    log("\n=== PHASE 6  TWO LABEL SETS ===")
    R.h("Phase 6 - Two label sets, and whether they agree")
    lab = C.get("turn_label")
    if not lab:
        R.warn("No per-message label column. Skipped.")
        return

    u = user[user[lab].fillna("").astype(str).str.strip() != ""].copy()
    texts = u["_clean"].tolist()
    y1 = u[lab].astype(str).values

    R.note("The keyword vocabulary excludes generic English words, words that "
           "appear as intake-form field labels in this corpus, tokens above a "
           "derived frequency ceiling, and every customer name harvested from "
           "the corpus. In v1 none of these were removed, so the top "
           "'indicators' were 'can', 'what', 'the', 'name' and 'email' - the "
           "model was detecting which form a message used, not what the "
           "customer wanted.")

    pred = [None] * len(u)
    conf = [0.0] * len(u)
    vc = pd.Series(y1).value_counts()
    usable = vc[vc >= 5].index
    mask = np.array([v in usable for v in y1])
    idx = np.where(mask)[0]
    last_rules = {}
    if len(idx) >= 25 and len(usable) >= 2:
        skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=seed)
        Xa = np.array(texts, dtype=object)[idx]
        ya = y1[idx]
        for tr, te in skf.split(Xa, ya):
            rules = build_rules(Xa[tr], ya[tr], stopwords)
            if not rules:
                continue
            last_rules = rules
            p, c = apply_rules(Xa[te], rules)
            for j, kk in enumerate(te):
                pred[idx[kk]] = p[j]
                conf[idx[kk]] = c[j]
        prov("keyword_rule_cv_folds", 5, "REVIEW_GATE",
             "out-of-fold so agreement is a measurement, not a tautology")

    u["_label_existing"] = y1
    u["_label_keyword"] = pred
    u["_confidence"] = conf

    if last_rules:
        RB = pd.DataFrame([{"class": c, "keyword": k, "weight": round(w, 3)}
                           for c, d in last_rules.items()
                           for k, w in sorted(d.items(), key=lambda kv: -kv[1])])
        R.csv(RB, "p6_01_keyword_rule_block.csv")
        R.h("The keyword rule block, learned from the data", 3)
        R.table(RB.groupby("class").head(14), max_rows=70)
        for i, cls in enumerate(sorted(last_rules)):
            d = sorted(last_rules[cls].items(), key=lambda kv: -kv[1])[:12]
            if d:
                R.fig(barh([k for k, _ in d], [w for _, w in d],
                           "z-score (higher = stronger indicator)",
                           f"Keywords indicating '{cls}'",
                           color=PALETTE[i % len(PALETTE)]))

        # v2.1: state it plainly when a class learns almost nothing
        counts = RB.groupby("class").size()
        floor = max(5, int(0.25 * counts.max()))
        thin = counts[counts < floor]
        for cls, n in thin.items():
            R.warn(f"The '{cls}' class learned only {n} indicator words, "
                   f"against {int(counts.max())} for the strongest class. "
                   f"Inspect them before trusting this side of the rule block: "
                   f"if they are discourse words such as 'today' or "
                   f"'regarding' rather than fault vocabulary, the rule is "
                   f"detecting how the note was written, not what the problem "
                   f"was.")
            finding("MEDIUM", f"Thin keyword evidence for '{cls}'",
                    f"{n} indicators above the z threshold, vs "
                    f"{int(counts.max())} for the strongest class.",
                    "Check whether the indicators are telecom terms or note "
                    "boilerplate before using this class in a rule.")

    covered = u["_label_keyword"].notna()
    R.p(f"The rule block reaches a decision on {int(covered.sum()):,} of "
        f"{len(u):,} labelled user messages ({100.0 * covered.mean():.1f}%). "
        f"The rest contain none of the learned keywords - an honest abstention "
        f"rather than a forced guess.")

    both = u[covered]
    if len(both):
        agree = float((both["_label_existing"] == both["_label_keyword"]).mean())
        kap = cohens_kappa(both["_label_existing"], both["_label_keyword"])
        base = float(both["_label_existing"].value_counts(normalize=True).max())
        K = pd.DataFrame([{"compared_messages": len(both),
                           "raw_agreement_pct": round(100 * agree, 2),
                           "majority_class_base_rate_pct": round(100 * base, 2),
                           "cohens_kappa": kap,
                           "reads_as": ("almost perfect" if (kap or 0) > .8 else
                                        "substantial" if (kap or 0) > .6 else
                                        "moderate" if (kap or 0) > .4 else
                                        "fair" if (kap or 0) > .2 else "poor")}])
        R.csv(K, "p6_02_agreement.csv")
        R.h("Agreement between the two label sets", 3)
        R.table(K)
        R.note("Cohen's kappa corrects for the agreement two labellers would "
               "reach by chance. Raw agreement always flatters an imbalanced "
               "problem; kappa does not. Compare the raw figure against the "
               "majority base rate in the same row.")

        labs = sorted(set(both["_label_existing"]) | set(both["_label_keyword"]))
        CM = (pd.crosstab(both["_label_existing"], both["_label_keyword"])
              .reindex(index=labs, columns=labs, fill_value=0))
        rn = CM.div(CM.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
        R.fig(heat(rn.values, labs, labs,
                   "Existing label (rows) vs keyword-derived label (columns)",
                   "share of row", cmap="Greens"),
              "The diagonal is agreement. Off-diagonal mass shows which intents "
              "the two methods confuse.")
        R.csv(CM.reset_index(), "p6_03_label_confusion.csv")

        dis = both[both["_label_existing"] != both["_label_keyword"]].copy()
        if len(dis):
            dis = dis.sort_values("_confidence", ascending=False)
            cols = [c for c in [C.get("case"), C.get("turn"), "_clean",
                                "_label_existing", "_label_keyword",
                                "_confidence"] if c]
            R.csv(dis[cols].head(800),
                  "p6_04_disagreements_for_sme_review.csv",
                  free_text_cols=("_clean",))
            R.h("Where the two label sets disagree, highest confidence first", 3)
            R.table(dis[["_clean", "_label_existing", "_label_keyword",
                         "_confidence"]].head(25), free_text_cols=("_clean",))
            R.note("Sorted by confidence so the most clear-cut disagreements "
                   "come first. This file is the highest-value SME task in the "
                   "project: each row is a case where two independent methods "
                   "reached different conclusions. The text column is the "
                   "masked problem statement and has passed the output gate; "
                   "the case and turn ids let an SME find the original record "
                   "in the source system, which is where any identifier should "
                   "be looked up.")

        # ---- calibration, FIXED: needs at least three bins ------------------
        b = both.copy()
        b["_ok"] = (b["_label_existing"] == b["_label_keyword"])
        try:
            b["_bin"] = pd.qcut(b["_confidence"], 5, duplicates="drop")
            cal = (b.groupby("_bin", observed=True)
                   .agg(messages=("_ok", "size"),
                        mean_confidence=("_confidence", "mean"),
                        agreement=("_ok", "mean")).reset_index())
            cal["_bin"] = cal["_bin"].astype(str)
            R.csv(cal.round(4), "p6_05_confidence_calibration.csv")
            fig, ax = plt.subplots(figsize=(7.5, 3.4))
            ax.plot(cal["mean_confidence"], cal["agreement"], marker="o",
                    color=PALETTE[1], label="observed")
            ax.axhline(base, color="#a0aec0", linestyle=":", linewidth=1,
                       label="majority base rate")
            ax.plot([0, 1], [0, 1], "--", color="#cbd5e0", linewidth=1,
                    label="perfect calibration")
            ax.set_xlabel("confidence (margin between winner and runner-up)")
            ax.set_ylabel("agreement with the existing label")
            ax.legend(fontsize=7, frameon=False)
            ax.set_title("Is the confidence score meaningful?", loc="left",
                         fontweight="600")
            R.fig(fig, "A rising line means confidence carries real "
                       "information.")
            if len(cal) < 3:
                R.warn(f"The confidence score collapsed into {len(cal)} bin(s), "
                       f"so this chart has too few points to say anything. In "
                       f"v2 the monotonic check passed here trivially - a "
                       f"single point is monotonic by definition - and the "
                       f"report wrongly declared confidence a usable abstention "
                       f"threshold. It is not usable until the margin spreads "
                       f"out.")
                finding("MEDIUM", "Confidence score is degenerate",
                        f"qcut produced only {len(cal)} bin(s); the margin is "
                        f"near-constant.",
                        "Do not use confidence as an abstention threshold on "
                        "this export.")
            elif cal["agreement"].is_monotonic_increasing:
                R.ok("Confidence is monotonically informative across "
                     f"{len(cal)} bins: higher confidence really does mean "
                     "higher agreement. This is a usable abstention threshold "
                     "for production.")
        except Exception:
            pass

    outcols = [c for c in [C.get("case"), C.get("turn"), "_clean",
                           "_label_existing", "_label_keyword", "_confidence"]
               if c]
    R.csv(u[outcols], "p6_06_both_label_sets.csv", free_text_cols=("_clean",))


