def prov(name, value, kind, note):
    """
    kind is one of
      DERIVED      computed from this dataset at runtime
      DOMAIN_FACT  a fact about telecoms or an external contract, not an
                   assumption about the data (an IMEI is 15 digits)
      REVIEW_GATE  a convention that only decides what gets FLAGGED for a human;
                   it never alters a computed value
      SAFETY       a privacy control; it may blank an output but never changes
                   a computed number
    """
    PROVENANCE.append({"parameter": name, "value": str(value),
                       "provenance": kind, "note": note})


def finding(severity, title, detail, action=""):
