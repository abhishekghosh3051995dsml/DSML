def phase7(R):
    log("\n=== PHASE 7  FINDINGS ===")
    R.h("Phase 7 - Findings and recommended actions")
    if not FINDINGS:
        R.ok("No blocking issues detected in this run.")
        return
    F = pd.DataFrame(FINDINGS)
    F["detail"] = F["detail"].astype(str)
    order = {"HIGH": 0, "MEDIUM": 1, "INFO": 2}
    F["_o"] = F["severity"].map(order).fillna(3)
    F = F.sort_values("_o").drop(columns="_o")
    R.csv(F, "p7_01_findings.csv")
    R.table(F, max_rows=40)
    R.note("Severity HIGH means a number from this run should not be reported "
           "until the issue is resolved. MEDIUM means the analysis stands but "
           "the interpretation is constrained. INFO is context.")


# =============================================================================
# MAIN
# =============================================================================

def main():
    global GUARD

    ap = argparse.ArgumentParser(
        description="NORA intent analysis v2.1 - PII-hardened")
    ap.add_argument("--input", required=True)
    ap.add_argument("--outdir", default="nora_out_v2_1")
    ap.add_argument("--salt-file", default="nora_salt.txt")
    ap.add_argument("--max-k", type=int, default=30)
    ap.add_argument("--sample", type=int, default=0)
    ap.add_argument("--chunksize", type=int, default=200000)
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--no-free-text", action="store_true",
                    help="Strip every free-text column from every output. Use "
                         "this for anything leaving the team.")
    args = ap.parse_args()

    log("=" * 74)
    log("NORA INTENT ANALYSIS  v2.1   (PII-hardened)")
    log("=" * 74)
    log(f"reading {args.input}")

    reader = pd.read_csv(args.input, low_memory=False, dtype=str,
                         keep_default_na=False,
                         na_values=["", "NA", "NaN", "null", "None", "nan"],
                         chunksize=args.chunksize)
    df = pd.concat([c for c in reader], ignore_index=True)
    log(f"  {len(df):,} rows x {len(df.columns)} columns")
    if args.sample and args.sample < len(df):
        df = df.sample(args.sample, random_state=args.seed).reset_index(drop=True)
        log(f"  sampled to {len(df):,}")

    C = discover_columns(df)
    log("  discovered columns:")
    for k, v in C.items():
        log(f"    {k:<12} -> {v}")
    if not C.get("text"):
        raise SystemExit("BLOCKED: no message-content column found. Check the "
                         "header row of the CSV.")

    salt = load_salt(args.salt_file)
    GUARD = Guard(salt, allow_free_text=not args.no_free_text)
    prov("free_text_in_outputs", not args.no_free_text, "SAFETY",
         "when False, every free-text column is dropped from every output")

    df["_raw"] = (df[C["text"]].fillna("").astype(str)
                  .str.replace(r"\\r", " ", regex=True)
                  .str.replace(r"\\n", "\n", regex=True))

    # Build the name lexicon BEFORE anything is written anywhere.
    log("\n  building the name lexicon from the whole corpus")
    GUARD.build_name_lexicon(df["_raw"].tolist())

    df["_masked"] = df["_raw"].str.replace(r"\s+", " ", regex=True).str.strip() \
                              .map(GUARD.mask_text)
    df["_role"] = (df[C["role"]].fillna("unknown").astype(str).str.strip().str.lower()
                   if C.get("role") else "unknown")
    df["_turn"] = (pd.to_numeric(df[C["turn"]], errors="coerce")
                   if C.get("turn") else np.arange(len(df)))

    # The source content column and _raw never reach an output.
    FORBIDDEN_OUTPUT_COLS.add(C["text"])
    if C.get("cid"):
        FORBIDDEN_OUTPUT_COLS.add(C["cid"])

    R = Report(args.outdir, "NORA Intent Analysis - v2.1 (PII-hardened)")
    R.p(f"Source: {os.path.basename(args.input)} - {len(df):,} rows, "
        f"{len(df.columns)} columns.")
    R.note("X is the customer's problem statement extracted from user "
           "messages. y_turn is the per-message label; y_global is the "
           "conversation label. Assistant messages are excluded from X because "
           "they contain NORA's answer.")
    R.note("PRIVACY: every string in this report passed through a fail-closed "
           "gate. Identifier form fields (name, BAN, IMEI, ICCID, EID, MSISDN, "
           "callback number, email, address) are DROPPED, not masked. Customer "
           "names harvested from anywhere in the corpus are redacted "
           "everywhere and excluded from every vocabulary. The raw message "
           "column and the conversation id are excluded from all outputs by "
           "name. Any cell that still matched an identifier pattern after "
           "masking was blanked entirely rather than shown.")

    df = phase1(df, C, R)
    user, fields, payload = phase2(df, C, R)

    stopwords, field_words, over = build_stopwords(
        user["_clean"], fields, GUARD.name_lexicon)
    R.h("Vocabulary control", 3)
    R.csv(pd.DataFrame({"excluded_token": sorted(
        t for t in stopwords if t not in GUARD.name_lexicon)}),
        "p2_06_stopwords_used.csv")
    R.p(f"{len(stopwords):,} tokens excluded from keyword learning: generic "
        f"English function words, {len(field_words)} words that appear as "
        f"intake-form field labels in this corpus, {len(over)} tokens above "
        f"the derived frequency ceiling, and "
        f"{len(GUARD.name_lexicon)} harvested name tokens.")
    R.note("The exported stopword list deliberately omits the name tokens. "
           "Publishing the list of names we are blocking would defeat the "
           "point of blocking them.")

    Xs, Xd, vec = phase3(user, C, R, stopwords, args.seed)
    user = phase4(user, C, R, stopwords, args.max_k, args.seed)
    phase5(user, C, R)
    phase6(user, C, R, stopwords, field_words, args.seed)
    phase7(R)

    # ---- privacy gate report ----------------------------------------------
    R.h("Privacy gate", 2)
    GR = GUARD.gate_report()
    R.csv(GR, "privacy_gate_report.csv")
    R.table(GR)
    R.p(f"{GUARD.cells_checked:,} text cells were checked on their way to an "
        f"output. {GUARD.gate_blocks:,} were blanked because something "
        f"identifier-shaped survived masking.")
    prov("output_cells_checked", GUARD.cells_checked, "SAFETY",
         "text cells passed through the fail-closed gate")
    prov("output_cells_blanked", GUARD.gate_blocks, "SAFETY",
         "cells replaced with [REDACTED] rather than shipped")
    if GUARD.gate_blocks:
        R.note("Blanked cells are not a failure - they are the control "
               "working. Each one is a cell the masker did not fully clean and "
               "the gate refused to publish. If the count is large, extend "
               "PII_PATTERNS so more content survives review intact.")
    else:
        R.ok("No cell needed blanking: masking handled every string that "
             "reached an output.")

    PR = pd.DataFrame(PROVENANCE)
    R.csv(PR, "provenance_register.csv")
    R.h("Provenance of every constant used", 2)
    R.table(PR, max_rows=60)
    R.note("DERIVED means computed from this dataset at runtime. DOMAIN_FACT "
           "means a fact about telecoms or an external contract, not an "
           "assumption about the data. REVIEW_GATE means a convention that "
           "only decides what gets flagged for a human. SAFETY means a privacy "
           "control: it may blank an output but never changes a computed "
           "number.")

    html = os.path.join(args.outdir, "nora_report_v2_1.html")
    R.save(html)

    # The manifest lists column NAMES and settings only. No values, no samples.
    json.dump({"input": os.path.basename(args.input),
               "rows": int(len(df)),
               "columns": list(df.columns),
               "roles": C,
               "template_fields": fields,
               "payload_field": payload,
               "free_text_in_outputs": not args.no_free_text,
               "name_lexicon_size": len(GUARD.name_lexicon),
               "output_cells_checked": GUARD.cells_checked,
               "output_cells_blanked": GUARD.gate_blocks,
               "findings": [{k: str(v) for k, v in f.items()} for f in FINDINGS],
               "provenance": PROVENANCE},
              open(os.path.join(args.outdir, "run_manifest.json"), "w"), indent=2)

    log("\n" + "=" * 74)
    log("DONE")
    log("=" * 74)
    for f in sorted(FINDINGS,
                    key=lambda x: {"HIGH": 0, "MEDIUM": 1}.get(x["severity"], 2)):
        log(f"  [{f['severity']}] {f['finding']}")
    log(f"\n  report : {os.path.abspath(html)}")
    log(f"  tables : {os.path.abspath(args.outdir)}")
    log(f"  salt   : {os.path.abspath(args.salt_file)}   (keep out of OneDrive)")
    log(f"  privacy: {GUARD.cells_checked:,} cells gated, "
        f"{GUARD.gate_blocks:,} blanked, "
        f"{len(GUARD.name_lexicon):,} names blocked corpus-wide")
    return 0


if __name__ == "__main__":
    sys.exit(main())
