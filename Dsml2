                     "detail": detail, "recommended_action": action})


# =============================================================================
# 0.5  THE PII GATE
# =============================================================================
# Everything in this block exists to make one guarantee: no value that
# identifies a customer can appear in the HTML report, in any CSV, in any
# chart, or in the run manifest.
#
# Three layers, applied in this order, and then a fail-closed re-scan:
#
#   LAYER 1  cue-anchored redaction
#            Text like "caller/customername: astin clark yasmin" has no form
#            structure, so field parsing never sees it. This layer finds a
#            name-ish cue word followed by a colon or dash and blanks the words
#            after it. It runs FIRST, while capitalisation still survives.
#
#   LAYER 2  pattern masking
#            Email, URL, IP, EID, ICCID, IMEI, MSISDN, account number, lat/long,
#            ZIP and street address, replaced with salted surrogates. Longest
#            patterns first so a 15-digit IMEI is never eaten by the 9-digit
#            account rule.
#
#   LAYER 3  name-lexicon redaction
#            Every value ever seen in a name-type form field, ANYWHERE in the
#            corpus, becomes a redaction target EVERYWHERE in the corpus. A
#            name typed into free text in row 900 is caught because the same
#            name sat in a Customer Name field in row 40. Common English and
#            telecom words are protected so the lexicon cannot swallow ordinary
#            vocabulary.
#
#   GATE     residue re-scan
#            The masked string is scanned again with the surrogates stripped
#            out. If an email, a run of five or more digits, an IP, a name cue,
#            or a lexicon name is still present, the ENTIRE cell is replaced by
#            [REDACTED]. Blanking a cell is always acceptable; leaking is not.
#
# Identifier-type FORM FIELDS are handled more bluntly still: their values are
# never emitted at all, not even as surrogates, because a stable surrogate is a
# join key back to a person.

PII_PATTERNS = [
    ("URL",    re.compile(r"https?://\S+")),
    ("EMAIL",  re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b")),
    ("IPV4",   re.compile(r"\b(?:(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\.){3}"
                          r"(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\b")),
    ("EID",    re.compile(r"\b[0-9a-fA-F]{32}\b")),
    ("UUID",   re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                          r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b")),
    ("ICCID",  re.compile(r"\b89\d{17,20}\b")),
    ("IMEI",   re.compile(r"\b\d{14,17}\b")),
    ("MSISDN", re.compile(r"(?<!\d)(?:\+?\d{1,3}[\s\-.]?)?\(?\d{3}\)?[\s\-.]?"
                          r"\d{3}[\s\-.]?\d{4}(?!\d)")),
    ("ACCTNUM", re.compile(r"(?<!\d)\d{8}\d*(?!\d)")),
    ("LATLON", re.compile(r"(?<![\w.])-?\d{1,3}\.\d{4,}(?![\w.])")),
    ("NUMID",  re.compile(r"(?<!\d)\d{5,7}(?!\d)")),
]

ADDRESS_RE = re.compile(
    r"\b\d{1,6}\s+(?:[A-Za-z0-9.'\-]+\s+){0,4}"
    r"(?:st|street|rd|road|ave|avenue|blvd|boulevard|ln|lane|dr|drive|ct|court|"
    r"way|pl|place|ter|terrace|pkwy|parkway|hwy|highway|cir|circle|apt|suite|"
    r"ste|unit)\b\.?",
    re.IGNORECASE)

# A name cue followed by up to four words. Runs before lowercasing.
NAME_CUE_RE = re.compile(
    r"(?i)\b(?:customer\s*name|customername|caller\s*/?\s*customername|"
    r"contact\s*name|account\s*name|subscriber\s*name|caller|cust\s*name|"
    r"first\s*name|last\s*name|full\s*name|name\s*of\s*(?:customer|caller)|name)"
    r"\s*[:\-]\s*"
    r"(?P<val>[A-Za-z][A-Za-z'\-]{1,20}(?:\s+[A-Za-z][A-Za-z'\-]{1,20}){0,4})")

# Which parsed field keys hold which kind of identifier. Matched on the KEY, so
# it adapts to a new intake layout without code changes.
FIELD_KIND_HINTS = [
    ("NAME",    r"(customer|contact|account|subscriber|caller|first|last|full)?"
                r"_?name"),
    ("EMAIL",   r"e_?mail"),
    ("MSISDN",  r"(phone|mobile|msisdn|call_?back|number_?with_issue|with_issue|"
                r"line|contact_?number|callback)"),
    ("IMEI",    r"imei"),
    ("ICCID",   r"iccid|sim_?serial"),
    ("EID",     r"^eid$|euicc"),
    ("BAN",     r"^ban$|billing_?account|account_?number|acct"),
    ("ADDRESS", r"address|street|zip|postal|city|state|location"),
    ("IDENT",   r"^cid$|uuid|guid|ticket|case_?number|order_?number"),
]


def field_kind(key):
    """Return the identifier type a field key holds, or None for free text."""
    for kind, pat in FIELD_KIND_HINTS:
        if re.search(pat, key):
            return kind
    return None


# Words that must never be treated as a customer name even if someone typed
# them into a name field. Without this a name field containing "unknown" would
# blank the word "unknown" across the entire report.
NAME_LEXICON_PROTECTED = set(ENGLISH_STOP_WORDS) | {
    "customer", "cust", "caller", "rep", "care", "business", "consumer",
    "account", "line", "phone", "mobile", "device", "internet", "service",
    "data", "call", "calls", "text", "sim", "esim", "router", "gateway",
    "hotspot", "signal", "network", "wifi", "roaming", "plan", "ticket",
    "order", "status", "issue", "issues", "problem", "unknown", "none", "test",
    "testing", "null", "blank", "empty", "email", "name", "number", "info",
    "information", "verified", "verify", "resolved", "pending", "yes", "no",
    "true", "false", "home", "work", "office", "site", "tower", "outage",
    "inseego", "cradlepoint", "craddlepoint", "franklin", "samsung", "apple",
    "iphone", "android", "galaxy", "tmobile", "sprint", "magenta",
}

SURROGATE_RE = re.compile(r"<[A-Z_]+_[0-9a-f]{6,}>")

# What the fail-closed gate looks for AFTER masking. Surrogates are stripped
# before this runs so their hex tails do not trip the digit rule.
RESIDUE_CHECKS = [
    ("residual_email",
     re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")),
    ("residual_digit_run_5plus",
     re.compile(r"(?<!\d)\d{5,}(?!\d)")),
    ("residual_ipv4",
     re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")),
    ("residual_name_cue",
     re.compile(r"(?i)\b(?:customer|contact|caller|cust|subscriber)\s*"
                r"n?a?m?e?\s*[:\-]\s*[A-Za-z]{2,}\s+[A-Za-z]{2,}")),
    ("residual_hex32",
     re.compile(r"\b[0-9a-fA-F]{32}\b")),
]

REDACTED = "[REDACTED]"

# Columns that must never leave this process under any circumstance.
FORBIDDEN_OUTPUT_COLS = {"_raw", "_fields_masked", "_issue"}


class Guard:
    """The single choke point for anything that becomes an output."""

    def __init__(self, salt, allow_free_text=True):
        self.salt = salt
        self.counts = Counter()
        self.redactions = Counter()
        self.name_lexicon = set()
        self.name_re = None
        self.allow_free_text = allow_free_text
        self.gate_blocks = 0
        self.cells_checked = 0

    # ---- layer 3 setup -----------------------------------------------------

    def build_name_lexicon(self, texts):
        """
        Collect every token that has ever appeared in a name-type field, plus
        every token captured by a name cue in free text. These become redaction
        targets everywhere. Built once, before any output is produced.
        """
        toks = Counter()
        for t in texts:
            if not isinstance(t, str) or not t:
                continue
            fields, _ = split_fields(t)
            for k, v in fields.items():
                if field_kind(k) == "NAME":
                    for w in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", str(v)):
                        toks[w.lower()] += 1
            for m in NAME_CUE_RE.finditer(t):
                for w in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", m.group("val")):
                    toks[w.lower()] += 1

        lex = {w for w in toks
               if len(w) >= 3 and w not in NAME_LEXICON_PROTECTED}
        self.name_lexicon = lex
        if lex:
            # longest first so "maryanne" is matched before "mary"
            alts = "|".join(re.escape(w) for w in
                            sorted(lex, key=len, reverse=True))
            self.name_re = re.compile(r"(?i)\b(?:" + alts + r")\b")
        prov("name_lexicon_size", len(lex), "SAFETY",
             "distinct name tokens harvested from name-type fields and name "
             "cues; redacted everywhere and excluded from all vocabularies")
        log(f"    name lexicon: {len(lex):,} tokens harvested and blocked")
        return len(lex)

    # ---- masking primitives ------------------------------------------------

    def surrogate(self, kind, value):
        h = hmac.new(self.salt, f"{kind}|{value}".encode("utf-8", "ignore"),
                     hashlib.sha256).hexdigest()[:10]
        self.counts[kind] += 1
        return f"<{kind}_{h}>"

    def _cue(self, text):
        def rep(m):
            self.counts["NAME"] += 1
            return m.group(0)[:m.start("val") - m.start(0)] + \
                self.surrogate("NAME", m.group("val").lower())
        return NAME_CUE_RE.sub(rep, text)

    def _patterns(self, text):
        s = ADDRESS_RE.sub(
            lambda m: self.surrogate("ADDRESS", m.group(0).lower()), text)
        for kind, rx in PII_PATTERNS:
            s = rx.sub(lambda m, k=kind: self.surrogate(k, m.group(0)), s)
        return s

    def _names(self, text):
        if self.name_re is None:
            return text
        return self.name_re.sub(
            lambda m: self.surrogate("NAME", m.group(0).lower()), text)

    def mask_text(self, text):
        """All three layers, in order. Not yet gated."""
        if not isinstance(text, str) or not text:
            return text
        s = self._cue(text)
        s = self._patterns(s)
        s = self._names(s)
        return s

    def mask_field(self, key, value):
        """
        Whole-value handling for a parsed form field.
        Identifier fields are DROPPED, not surrogated: a stable surrogate for a
        BAN is still a join key back to one customer.
        """
        v = str(value or "").strip()
        if not v or v.upper() in {"N/A", "NA", "NONE", "NULL", "-"}:
            return ""
        kind = field_kind(key)
        if kind:
            self.counts[kind] += 1
            return ""
        return self.mask_text(v)

    # ---- the fail-closed gate ---------------------------------------------

    def residue(self, text):
        """Which residue checks fire on this string, surrogates removed."""
        probe = SURROGATE_RE.sub(" ", str(text))
        return [name for name, rx in RESIDUE_CHECKS if rx.search(probe)]

    def safe(self, text):
        """
        The only function permitted to produce output text.
        Mask, then re-scan. Anything still suspicious is blanked wholesale.
        """
        if text is None:
            return ""
        if not isinstance(text, str):
            text = str(text)
        if not text.strip():
            return text
        self.cells_checked += 1
        s = self.mask_text(text)
        hits = self.residue(s)
        if hits:
            self.gate_blocks += 1
            for h in hits:
                self.redactions[h] += 1
            return REDACTED
        return s

    def safe_frame(self, df, free_text_cols=()):
        """
        Sanitise a whole DataFrame on its way to a CSV or an HTML table.
        Drops forbidden columns outright, gates every remaining text cell, and
        drops free-text columns entirely when --no-free-text is set.
        """
        d = df.copy()
        for c in list(d.columns):
            if c in FORBIDDEN_OUTPUT_COLS:
                d = d.drop(columns=[c])
        if not self.allow_free_text:
            for c in list(d.columns):
                if c in free_text_cols:
                    d = d.drop(columns=[c])
        for c in d.columns:
            if d[c].dtype == object:
                d[c] = d[c].map(self.safe)
        return d

    def summary(self):
        rows = [{"entity_type": k, "values_masked_or_dropped": v}
                for k, v in sorted(self.counts.items())]
        return pd.DataFrame(rows)

    def gate_report(self):
        rows = [{"gate_check": k, "cells_blanked": v}
                for k, v in sorted(self.redactions.items())]
        if not rows:
            rows = [{"gate_check": "none", "cells_blanked": 0}]
        return pd.DataFrame(rows)


def load_salt(path):
    if os.path.exists(path):
        with open(path) as f:
            v = f.read().strip()
        if v:
            return v.encode()
    v = secrets.token_hex(32)
    with open(path, "w") as f:
        f.write(v)
    try:
        os.chmod(path, 0o600)
    except Exception:
        pass
    log(f"    created salt file {path}  - KEEP OUT OF ONEDRIVE AND GIT")
    return v.encode()


