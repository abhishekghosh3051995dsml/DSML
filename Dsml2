class Report:
    def __init__(self, outdir, title):
        self.dir = outdir
        os.makedirs(outdir, exist_ok=True)
        self.title = title
        self.blocks = []

    def csv(self, df, name, free_text_cols=()):
        safe = GUARD.safe_frame(df, free_text_cols=free_text_cols)
        p = os.path.join(self.dir, name)
        safe.to_csv(p, index=False)
        log(f"      -> {name}  ({len(safe):,} rows, {len(safe.columns)} cols)")
        return p

    def h(self, t, level=2):
        self.blocks.append(f"<h{level}>{htmlmod.escape(str(t))}</h{level}>")

    def p(self, t):
        self.blocks.append(f"<p>{htmlmod.escape(GUARD.safe(t))}</p>")

    def note(self, t):
        self.blocks.append(f'<div class="note">{htmlmod.escape(GUARD.safe(t))}</div>')

    def warn(self, t):
        self.blocks.append(f'<div class="warn">{htmlmod.escape(GUARD.safe(t))}</div>')

    def ok(self, t):
        self.blocks.append(f'<div class="good">{htmlmod.escape(GUARD.safe(t))}</div>')

    def fig(self, figure, caption=""):
        buf = io.BytesIO()
        figure.savefig(buf, format="png", bbox_inches="tight")
        plt.close(figure)
        b64 = base64.b64encode(buf.getvalue()).decode()
        cap = (f'<div class="cap">{htmlmod.escape(GUARD.safe(caption))}</div>'
               if caption else "")
        self.blocks.append(
            f'<div class="figbox"><img src="data:image/png;base64,{b64}"/>{cap}</div>')

    def table(self, df, max_rows=30, free_text_cols=()):
        d = GUARD.safe_frame(df.head(max_rows), free_text_cols=free_text_cols)
        for c in d.columns:
            d[c] = d[c].astype(str).str.slice(0, 240)
        self.blocks.append('<div class="tbl">' +
                           d.to_html(index=False, escape=True, border=0) + "</div>")

    def save(self, path):
        css = """
        body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,
        Helvetica,Arial,sans-serif;max-width:1120px;margin:0 auto;padding:32px;
        color:#1a202c;line-height:1.55;background:#fff}
        h1{font-size:27px;border-bottom:3px solid #2b6cb0;padding-bottom:10px}
        h2{font-size:20px;margin-top:44px;color:#2b6cb0;
        border-bottom:1px solid #e2e8f0;padding-bottom:6px}
        h3{font-size:15px;margin-top:24px;color:#4a5568}
        .note{background:#ebf8ff;border-left:4px solid #2b6cb0;padding:11px 14px;
        margin:14px 0;font-size:13.5px}
        .warn{background:#fffaf0;border-left:4px solid #c05621;padding:11px 14px;
        margin:14px 0;font-size:13.5px}
        .good{background:#f0fff4;border-left:4px solid #2f855a;padding:11px 14px;
        margin:14px 0;font-size:13.5px}
        .figbox{margin:20px 0;text-align:center}
        .figbox img{max-width:100%;border:1px solid #e2e8f0;border-radius:4px}
        .cap{font-size:12px;color:#718096;margin-top:6px;font-style:italic}
        .tbl{overflow-x:auto;margin:14px 0}
        table{border-collapse:collapse;font-size:12px;width:100%}
        th{background:#edf2f7;text-align:left;padding:7px 9px;
        border-bottom:2px solid #cbd5e0;white-space:nowrap}
        td{padding:6px 9px;border-bottom:1px solid #edf2f7;vertical-align:top}
        tr:nth-child(even) td{background:#fafbfc}
        .foot{margin-top:48px;padding-top:14px;border-top:1px solid #e2e8f0;
        font-size:12px;color:#718096}
        """
        doc = (f"<!DOCTYPE html><html><head><meta charset='utf-8'>"
               f"<title>{htmlmod.escape(self.title)}</title><style>{css}</style>"
               f"</head><body><h1>{htmlmod.escape(self.title)}</h1>"
               + "".join(self.blocks)
               + '<div class="foot">Every class name, keyword, template field, '
                 'cluster count and threshold in this report was discovered '
                 'from the input file. Every string in this report passed '
                 'through a fail-closed privacy gate: identifier form fields '
                 'are dropped rather than masked, customer names harvested '
                 'anywhere in the corpus are redacted everywhere, and any cell '
                 'still matching a residue pattern after masking was blanked '
                 'entirely. No raw message text appears in this report. See '
                 'provenance_register.csv and privacy_gate_report.csv.'
                 "</div></body></html>")
        with open(path, "w", encoding="utf-8") as f:
            f.write(doc)


def barh(labels, values, xlabel, title, color=PALETTE[0]):
    n = len(labels)
    fig, ax = plt.subplots(figsize=(9, max(2.2, 0.30 * n + 1)))
    y = np.arange(n)
    ax.barh(y, values, color=color, height=0.68)
    ax.set_yticks(y)
    ax.set_yticklabels([GUARD.safe(str(l))[:55] for l in labels])
