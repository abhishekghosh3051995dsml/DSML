def cramers_v(a, b):
    ct = pd.crosstab(a, b)
    if ct.shape[0] < 2 or ct.shape[1] < 2:
        return np.nan
    chi2 = chi2_contingency(ct, correction=False)[0]
    n = ct.values.sum()
    phi2 = chi2 / n
    r, k = ct.shape
    phi2c = max(0.0, phi2 - (k - 1) * (r - 1) / (n - 1))
    rc = r - (r - 1) ** 2 / (n - 1)
    kc = k - (k - 1) ** 2 / (n - 1)
    d = min(kc - 1, rc - 1)
    return float(np.sqrt(phi2c / d)) if d > 0 else np.nan


def theils_u(x, y):
    px = pd.Series(x).value_counts(normalize=True)
    hx = float(-(px * np.log(px + 1e-12)).sum())
    if hx == 0:
        return 0.0
    d = pd.DataFrame({"x": x, "y": y})
    hxy = 0.0
    for _, g in d.groupby("y"):
        p = g["x"].value_counts(normalize=True)
        hxy += (len(g) / len(d)) * float(-(p * np.log(p + 1e-12)).sum())
    return float((hx - hxy) / hx)


def cohens_kappa(a, b):
    a, b = pd.Series(a).astype(str), pd.Series(b).astype(str)
    m = a.notna() & b.notna()
    a, b = a[m], b[m]
    if len(a) == 0:
        return None
    po = float((a == b).mean())
    pa, pb = a.value_counts(normalize=True), b.value_counts(normalize=True)
    pe = float(sum(pa.get(k, 0) * pb.get(k, 0)
                   for k in set(pa.index) | set(pb.index)))
    return round((po - pe) / (1 - pe), 4) if pe < 1 else None


def build_stopwords(texts, template_fields, name_lexicon, df_ceiling=None):
    """
    Four layers, all justified:
      1. generic English function words
      2. TEMPLATE FIELD LABEL WORDS, discovered from this corpus. If "email"
         and "call back number" are form labels here, then those words are
         structural furniture, not telecom concepts. This is what stops the
         model learning the paperwork.
      3. corpus-specific over-frequent tokens above a derived ceiling
      4. NEW IN v2.1: every token in the harvested name lexicon, so a customer
         name can never surface as a cluster term or a learned keyword
    """
    sw = set(ENGLISH_STOP_WORDS)
    n0 = len(sw)

    field_words = set()
    for f in template_fields:
        for w in re.split(r"[^a-z]+", f):
            if len(w) >= 2:
                field_words.add(w)
    sw |= field_words

    s = pd.Series(texts).fillna("").astype(str).str.lower()
    n = len(s)
    dfc = Counter()
    for t in s:
        for w in set(re.findall(r"[a-z][a-z_\-]{1,}", t)):
            dfc[w] += 1
    freqs = np.array([v / max(n, 1) for v in dfc.values()])
    ceiling = df_ceiling if df_ceiling else float(np.quantile(freqs, 0.999))
    ceiling = max(ceiling, 0.40)
    over = {w for w, v in dfc.items() if v / max(n, 1) >= ceiling}
    sw |= over

    sw |= set(name_lexicon)

    prov("stopwords_english", n0, "DOMAIN_FACT",
         "scikit-learn English function-word list")
    prov("stopwords_from_template_fields", len(field_words), "DERIVED",
         "words appearing as form field labels in THIS corpus")
    prov("stopword_df_ceiling", round(ceiling, 4), "DERIVED",
         "document-frequency ceiling from the corpus token distribution")
    prov("stopwords_from_name_lexicon", len(name_lexicon), "SAFETY",
         "harvested customer-name tokens, excluded from every vocabulary")
    return sw, sorted(field_words), sorted(over)


def weighted_log_odds(texts, labels, stopwords, min_count=8, top_n=40):
    """
    Weighted log-odds with an informative Dirichlet prior (Monroe, Colaresi and
    Quinn). Preferred over raw counts or plain PMI because both are dominated by
    rare words: a term seen three times in one class looks perfectly predictive.
    This shrinks rare terms toward zero and returns a z-score, so every keyword
    carries a confidence rather than an impression.
    """
    docs = pd.Series(texts).fillna("").astype(str).str.lower()
    y = pd.Series(labels).astype(str)
    tok = docs.str.findall(r"[a-z][a-z_\-]{2,}")
    total, per_class = Counter(), defaultdict(Counter)
    for t, lab in zip(tok, y):
        for w in set(t):
            if w in stopwords or len(w) < 3:
                continue
            total[w] += 1
            per_class[lab][w] += 1
    vocab = [w for w, c in total.items() if c >= min_count]
    if not vocab:
        return pd.DataFrame()
    a0 = sum(total[w] for w in vocab)
    rows = []
    for lab in per_class:
        ni = sum(per_class[lab][w] for w in vocab)
        nj = sum(total[w] - per_class[lab][w] for w in vocab)
        for w in vocab:
            yiw = per_class[lab][w]
            yjw = total[w] - yiw
            aw = total[w]
            num_i, num_j = yiw + aw, yjw + aw
            den_i, den_j = ni + a0 - num_i, nj + a0 - num_j
            if min(num_i, num_j, den_i, den_j) <= 0:
                continue
            delta = np.log(num_i / den_i) - np.log(num_j / den_j)
            z = delta / np.sqrt(1.0 / num_i + 1.0 / num_j)
            rows.append({"class": lab, "keyword": w, "doc_freq": total[w],
                         "in_class": yiw,
                         "pct_of_class": round(100.0 * yiw / max(ni, 1), 2),
                         "log_odds": round(float(delta), 4),
                         "z_score": round(float(z), 3)})
    out = pd.DataFrame(rows)
    if out.empty:
        return out
    out["strength"] = pd.cut(out["z_score"].abs(),
                             bins=[-np.inf, 1.96, 3.29, 5.0, np.inf],
                             labels=["not significant", "significant",
                                     "strong", "very strong"])
    return (out.sort_values(["class", "z_score"], ascending=[True, False])
            .groupby("class").head(top_n).reset_index(drop=True))


