def find(cols, patterns, exclude=()):
    for pat in patterns:
        for c in cols:
            n = re.sub(r"[^a-z0-9]+", "_", str(c).lower())
            if any(re.search(e, n) for e in exclude):
                continue
            if re.search(pat, n):
                return c
    return None


def discover_columns(df):
    c = list(df.columns)
    roles = {
        "case":       find(c, [r"^source_row$", r"source.*row", r"^row_?id$"]),
        "turn":       find(c, [r"message_index", r"turn.*index", r"^index$", r"^seq"]),
        "conv_label": find(c, [r"classification.*intent", r"case.*intent",
                               r"conversation.*intent"]),
        "cid":        find(c, [r"data_cid$", r"(^|_)cid$", r"conversation.*id"]),
        "text":       find(c, [r"data_content$", r"content$", r"message.*text",
                               r"^text$", r"utterance"]),
        "predicted":  find(c, [r"intent_predicted", r"predicted"]),
        "turn_label": find(c, [r"data_label$", r"(^|_)label$", r"turn.*intent"],
                           exclude=[r"predicted"]),
        "role":       find(c, [r"^message_type$", r"message_type$", r"data_type$",
                               r"^role$", r"speaker"]),
        "timestamp":  find(c, [r"time_?stamp", r"_ts$", r"created", r"^date"]),
    }
    rc = roles.get("role")
    if rc and df[rc].nunique() > 12:
        roles["role"] = None
    return roles


# =============================================================================
# 2  TEMPLATE FIELD DISCOVERY
# =============================================================================
# A share of NORA's user turns are an intake form pasted into the message body.
# Treating that blob as "the customer's words" is what made v1 learn the form
# instead of the fault. So we discover the form, split it into fields, and
# identify which field carries the free-text payload.
#
# v2.1 change: the discovery REPORT no longer prints an example value for each
# field. An example of a field called `customer_name` is, by definition, a
# customer name. The report now describes the field's SHAPE instead.

FIELD_LINE_RE = re.compile(
    r"(?m)^[ \t\-\*#>]*"
    r"(?P<key>[A-Za-z][A-Za-z0-9 _\-/#\.]{1,44}?)"
    r"\s*:\s*"
    r"(?P<val>.*)$")

MD_HEADER_RE = re.compile(r"(?m)^\s{0,3}#{1,6}\s*(?P<key>[^\n#]{2,60})\s*$")


def norm_key(k):
    return re.sub(r"[^a-z0-9]+", "_", str(k).strip().lower()).strip("_")


def knee_cutoff(values, floor=0.0):
    """Largest drop in the log-frequency curve. Derived, never assumed."""
    v = np.sort(np.asarray(values, dtype=float))[::-1]
    v = v[v > 0]
    if len(v) < 4:
        return float(v.min()) if len(v) else floor
    drops = np.diff(np.log(v + 1e-9))
    knee = int(np.argmin(drops)) + 1
    return max(float(v[min(knee, len(v) - 1)]), floor)


def split_fields(text):
    """Parse one message into {field_key: value} plus the unmatched remainder."""
    if not isinstance(text, str) or not text:
        return {}, ""
    fields, spans = {}, []
    for m in FIELD_LINE_RE.finditer(text):
        k = norm_key(m.group("key"))
        if not k or len(k) < 2:
            continue
        fields.setdefault(k, m.group("val").strip())
        spans.append((m.start(), m.end()))
    if not spans:
        return {}, text
    rest, prev = [], 0
    for a, b in spans:
        rest.append(text[prev:a])
        prev = b
    rest.append(text[prev:])
    return fields, re.sub(r"\s+", " ", " ".join(rest)).strip()


def discover_template(texts, sample=8000, seed=42):
    """Returns (promoted_field_keys, payload_key, report_dataframe)."""
    s = pd.Series(texts).dropna().astype(str)
    s = s[s.str.strip() != ""]
    if s.empty:
        return [], None, pd.DataFrame()
    take = s.sample(min(sample, len(s)), random_state=seed)
    n = len(take)

    docs = Counter()
    vals = defaultdict(list)
    for t in take:
        seen = set()
        for m in FIELD_LINE_RE.finditer(t):
            k = norm_key(m.group("key"))
            if not k or len(k) < 2 or k.isdigit():
                continue
            if k not in seen:
                docs[k] += 1
                seen.add(k)
            v = m.group("val").strip()
            if len(vals[k]) < 4000:
                vals[k].append(v)
        for m in MD_HEADER_RE.finditer(t):
            k = "hdr_" + norm_key(m.group("key"))
            if k not in seen:
                docs[k] += 1
                seen.add(k)

    if not docs:
        return [], None, pd.DataFrame()

    rows = []
    for k, d in docs.items():
        vv = [x for x in vals.get(k, []) if x]
        lens = [len(x) for x in vv] or [0]
        words = [len(x.split()) for x in vv] or [0]
        digits = [sum(ch.isdigit() for ch in x) / max(len(x), 1) for x in vv] or [0]
        uniq = len(set(vv)) / max(len(vv), 1)
        rows.append({
            "field": k,
            "holds": field_kind(k) or "free_text",
            "doc_count": d,
            "coverage_pct": round(100.0 * d / n, 2),
            "median_chars": float(np.median(lens)),
            "median_words": float(np.median(words)),
            "digit_density": round(float(np.median(digits)), 3),
            "distinct_ratio": round(uniq, 3),
        })
    R = pd.DataFrame(rows).sort_values("coverage_pct", ascending=False)

    cut = knee_cutoff(R["coverage_pct"].values, floor=1.0)
    prov("template_field_coverage_cutoff", round(cut, 3), "DERIVED",
         "knee of the field document-frequency curve")
    R["promoted"] = R["coverage_pct"] >= cut

    promoted = R[R["promoted"]]
    payload = None
    if len(promoted):
        # The payload is the promoted field that is not an identifier field by
        # its key and behaves like prose. Selecting on median word count rather
        # than distinct ratio matters: a support corpus repeats the same
        # complaint constantly, so a low distinct ratio is normal here.
        cand = promoted[promoted["holds"] == "free_text"]
        cand = cand[cand["median_words"] >= 3]
        if len(cand):
            payload = cand.sort_values("median_words", ascending=False)["field"].iloc[0]
        else:
            nonid = promoted[promoted["holds"] == "free_text"]
            if len(nonid):
                payload = nonid.sort_values("median_chars",
                                            ascending=False)["field"].iloc[0]
    R["is_payload"] = R["field"] == payload
    return list(promoted["field"]), payload, R


