def build_tool_transitions(interactions: Dict[str, Interaction]) -> List[Dict[str, Any]]:
    transitions, sources = Counter(), Counter()
    for item in interactions.values():
        tools = item.tool_sequence()
        for t in tools:
            sources[t] += 1
        for a, b in zip(tools, tools[1:]):
            transitions[(a, b)] += 1
    rows = [{"current_tool": a, "next_tool": b, "transition_count": n,
             "transition_rate": safe_div(n, sources[a])} for (a, b), n in transitions.items()]
    rows.sort(key=lambda r: r["transition_count"], reverse=True)
    return rows


