    rows = []
    for tool, b in data.items():
        total, n_int = b["calls"], len(b["interactions"])
        coverage = pct(n_int, total_interactions)
        rows.append({
            "tool_name": tool, "namespace": b["namespace"] or "(none)",
            "raw_name_variants": " | ".join(sorted(b["raw_names"])),
