def build_global_summary(interactions: Dict[str, Interaction], ic: ClusterResult,
                         pc: ClusterResult, wc: ClusterResult, filter_report: Dict[str, Any],
                         ingest_report: Dict[str, Any], sensitivity: List[Dict[str, Any]],
                         tsr: TimestampReader, alias: Dict[str, str]) -> Dict[str, Any]:
    total = len(interactions)
    all_calls, problems, intents, subintents = [], [], [], []
    with_problem = with_intent = with_tools = with_parallel = 0
    workflows, sentiments, timestamps = Counter(), Counter(), []

    for item in interactions.values():
        with_problem += bool(item.problems)
        with_intent += bool(item.intents)
        with_tools += bool(item.tool_calls)
        with_parallel += item.max_parallel_degree() > 1
        problems.extend(item.problems)
        intents.extend(item.intents)
        subintents.extend(item.subintents)
        all_calls.extend(item.tool_calls)
        sentiments[item.sentiment] += 1
        if item.started_at:
            timestamps.append(item.started_at)
        wf = workflow_signature(item.tool_sequence())
        if wf:
            workflows[wf] += 1

    status = Counter(c.status for c in all_calls)
    n_calls = len(all_calls)
    per_interaction = [len(i.tool_calls) for i in interactions.values()]
    n_workflows = len(workflows)
    single_use = sum(1 for n in workflows.values() if n == 1)

    tool_interactions: Counter = Counter()
    for item in interactions.values():
        for tool in {c.canonical_tool for c in item.tool_calls}:
            tool_interactions[tool] += 1
    always_on = [t for t, n in tool_interactions.items() if pct(n, total) >= 95]

    return {
        "M1_problems": {
            "total_interactions": total, "interactions_with_problem": with_problem,
            "problem_coverage_pct": pct(with_problem, total),
            "total_problem_records": len(problems),
            "unique_problem_texts": len(set(problems)),
            "problem_clusters": pc.n_clusters, "problem_clustering_method": pc.method},
        "M2_intents": {
            "interactions_with_intent": with_intent, "total_intent_occurrences": len(intents),
            "unique_intents": len(set(intents)), "intent_clusters": ic.n_clusters,
            "total_subintent_occurrences": len(subintents),
            "unique_subintents": len(set(subintents)), "intent_clustering_method": ic.method},
        "M3_workflows": {
            "interactions_with_tool_calls": with_tools, "distinct_workflows": n_workflows,
            "task_decomposition_clusters": wc.n_clusters,
            "largest_cluster_share_pct": wc.largest_share_pct(),
            "clustering_sensitivity": sensitivity,
            "toolset_grouping_threshold_free": group_by_toolset(interactions),
            "reused_workflows": sum(1 for n in workflows.values() if n > 1),
            "single_use_workflows": single_use,
            "single_use_workflow_pct": pct(single_use, n_workflows),
            "avg_tool_calls_per_interaction": round(statistics.mean(per_interaction), 4)
            if per_interaction else 0,
            "median_tool_calls_per_interaction": round(statistics.median(per_interaction), 4)
            if per_interaction else 0,
            "max_tool_calls_in_interaction": max(per_interaction, default=0),
            "workflow_clustering_method": wc.method},
        "M4_workflow_reuse": {
            "intent_clusters": ic.n_clusters, "distinct_workflows": n_workflows,
            "workflows_per_intent_cluster": safe_div(n_workflows, max(ic.n_clusters, 1), 2),
            "workflows_per_interaction": safe_div(n_workflows, max(total, 1), 4),
            "verdict": divergence_verdict(total, n_workflows, wc.n_clusters)},
        "M5_tools_and_A_api": {
            "total_tool_calls": n_calls,
            "unique_tools_canonical": len({c.canonical_tool for c in all_calls}),
            "unique_tools_raw_names": len({c.tool_name for c in all_calls}),
            "tool_name_aliases_merged": sum(1 for k, v in alias.items() if k != v),
            "always_on_tools": len(always_on),
            "always_on_tool_names": sorted(always_on)[:50],
            "always_on_pct_of_catalogue": pct(len(always_on), max(len(tool_interactions), 1)),
            "unique_namespaces": len({c.namespace for c in all_calls if c.namespace}),
            "A_api_calls": sum(c.is_A_api for c in all_calls),
            "A_calls_agent_side": sum(1 for c in all_calls
                                         if c.is_A_api and c.side == "agent"),
            "A_calls_tool_side": sum(1 for c in all_calls
                                        if c.is_A_api and c.side == "tool"),
            "calls_agent_side": sum(1 for c in all_calls if c.side == "agent"),
            "calls_tool_side": sum(1 for c in all_calls if c.side == "tool"),
            "successful_tool_calls": status["success"], "partial_tool_calls": status["partial"],
            "no_data_tool_calls": status["no_data"], "skipped_tool_calls": status["skipped"],
            "error_tool_calls": status["error"], "empty_tool_calls": status["empty"],
            "tool_success_rate": safe_div(status["success"], n_calls),
            "tool_error_rate": safe_div(status["error"], n_calls),
            "tool_no_data_rate": safe_div(status["no_data"], n_calls),
            "interactions_with_parallel_calls": with_parallel,
