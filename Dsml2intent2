def build_tool_cooccurrence(interactions: Dict[str, Interaction]) -> List[Dict[str, Any]]:
    pairs, tool_counts, parallel_pairs = Counter(), Counter(), Counter()
    for item in interactions.values():
        tools = sorted({c.canonical_tool for c in item.tool_calls})
        for t in tools:
            tool_counts[t] += 1
        for a, b in combinations(tools, 2):
            pairs[(a, b)] += 1
        for group in item.parallel_groups():
            for a, b in combinations(sorted(group), 2):
                parallel_pairs[(a, b)] += 1
    rows = [{"tool_a": a, "tool_b": b, "cooccurring_interactions": n,
             "parallel_cooccurrences": parallel_pairs[(a, b)],
             "tool_a_interactions": tool_counts[a], "tool_b_interactions": tool_counts[b],
             "association_rate": safe_div(n, min(tool_counts[a], tool_counts[b]))}
            for (a, b), n in pairs.items()]
    rows.sort(key=lambda r: r["cooccurring_interactions"], reverse=True)
    return rows


