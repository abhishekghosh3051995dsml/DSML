@dataclass
class Interaction:
    interaction_id: str
    source_row_count: int = 0
    problems: List[str] = field(default_factory=list)
    problem_categories: List[str] = field(default_factory=list)
    intents: List[str] = field(default_factory=list)
    subintents: List[str] = field(default_factory=list)
    workflow_names: List[str] = field(default_factory=list)
    tool_calls: List[ToolCall] = field(default_factory=list)
    feedback_values: List[str] = field(default_factory=list)
    sentiment: str = "unknown"
    started_at: Optional[datetime] = None
    ended_at: Optional[datetime] = None
    source_files: List[str] = field(default_factory=list)

    def tool_names(self) -> List[str]:
        return [c.canonical_tool for c in self.tool_calls]

    def tool_sequence(self, dedupe_consecutive: bool = True) -> List[str]:
        names = self.tool_names()
        if not dedupe_consecutive:
            return names
        out: List[str] = []
        for n in names:
            if not out or out[-1] != n:
                out.append(n)
        return out

    def primary_intent(self) -> str:
        return self.intents[0] if self.intents else ""

    def primary_problem(self) -> str:
        return self.problems[0] if self.problems else ""

    def parallel_groups(self) -> List[Tuple[str, ...]]:
        groups: Dict[str, Set[str]] = defaultdict(set)
        for c in self.tool_calls:
            if c.parallel_group:
                groups[c.parallel_group].add(c.canonical_tool)
        return [tuple(sorted(t)) for t in groups.values() if len(t) > 1]

    def max_parallel_degree(self) -> int:
        return max((c.parallel_degree for c in self.tool_calls), default=0)


def workflow_signature(tools: Sequence[str]) -> str:
    return " -> ".join(normalize_text(t) for t in tools if normalize_text(t))


def workflow_set_signature(tools: Sequence[str]) -> str:
    return " | ".join(sorted(set(tools)))


def build_alias_map(all_names: Iterable[str], enabled: bool = True) -> Dict[str, str]:
    """P2: derive tool-name aliases from the data, not from assumptions.

    If a bare function name appears as its own tool AND also as the suffix of a
    namespaced tool ("get_pgw_hlr" and "nsm-get_pgw_hlr"), both map to the bare
    function name so they count as one tool.
    """
    names = set(all_names)
    if not enabled:
        return {n: n for n in names}
    alias: Dict[str, str] = {}
    for name in names:
        _, fn = split_tool_name(name)
        alias[name] = fn if (fn != name and fn in names) else name
    return alias


def finalize_interaction(item: Interaction, parallel_window: float,
                         alias: Dict[str, str]) -> None:
    item.problems = unique_preserve_order(item.problems)
    item.problem_categories = unique_preserve_order(item.problem_categories)
    item.intents = unique_preserve_order(item.intents)
    item.subintents = unique_preserve_order(item.subintents)
    item.workflow_names = unique_preserve_order(item.workflow_names)
    item.feedback_values = unique_preserve_order(item.feedback_values)
    item.source_files = unique_preserve_order(item.source_files)

    for c in item.tool_calls:
        c.canonical_tool = alias.get(c.tool_name, c.tool_name)

    def sort_key(entry: Tuple[int, ToolCall]):
        i, c = entry
        p = parse_timestamp(c.timestamp)
        return (1, 0.0, c.row_number, i) if p is None else (0, p.timestamp(), c.row_number, i)

    item.tool_calls = [c for _, c in sorted(enumerate(item.tool_calls), key=sort_key)]
    for i, c in enumerate(item.tool_calls, start=1):
        c.call_index = i

    groups: Dict[str, List[ToolCall]] = defaultdict(list)
    anchor_ts, anchor_key = None, ""
    for c in item.tool_calls:
        if c.step_key:
            key = f"step::{c.step_key}"
        else:
            p = parse_timestamp(c.timestamp)
            if p is not None:
                if anchor_ts is None or (p - anchor_ts).total_seconds() > parallel_window:
                    anchor_ts, anchor_key = p, f"win::{p.isoformat()}"
                key = anchor_key
            else:
                key = f"row::{c.row_number}"
        groups[key].append(c)

    for key, group in groups.items():
        gid = stable_hash(f"{item.interaction_id}::{key}", 12)
        degree = len({c.canonical_tool for c in group})
        for c in group:
            c.parallel_group, c.parallel_degree = gid, degree


# ------------------------------------------------------------- clustering
class UnionFind:
    def __init__(self, n: int) -> None:
        self.parent = list(range(n))

    def find(self, x: int) -> int:
        while self.parent[x] != x:
            self.parent[x] = self.parent[self.parent[x]]
            x = self.parent[x]
        return x

    def union(self, a: int, b: int) -> None:
        ra, rb = self.find(a), self.find(b)
        if ra != rb:
            self.parent[max(ra, rb)] = min(ra, rb)


@dataclass
class ClusterResult:
    assignments: Dict[str, int] = field(default_factory=dict)
    representatives: Dict[int, str] = field(default_factory=dict)
    members: Dict[int, List[str]] = field(default_factory=dict)
    method: str = "none"

    @property
    def n_clusters(self) -> int:
        return len(self.members)

    def cluster_of(self, item: str) -> Optional[int]:
        return self.assignments.get(item)

    def label_of(self, item: str, default: str = "") -> str:
        cid = self.assignments.get(item)
        return self.representatives.get(cid, default) if cid is not None else default

    def largest_share_pct(self) -> float:
        if not self.members:
            return 0.0
        total = sum(len(m) for m in self.members.values())
        return pct(max(len(m) for m in self.members.values()), total)


def _package(items: Sequence[str], labels: Sequence[Any], weights: Dict[str, int],
             method: str) -> ClusterResult:
    grouped: Dict[Any, List[str]] = defaultdict(list)
    for item, label in zip(items, labels):
        grouped[label].append(item)
    res = ClusterResult(method=method)
    for new_id, (_, members) in enumerate(
            sorted(grouped.items(), key=lambda kv: (-len(kv[1]), str(kv[0])))):
        res.members[new_id] = sorted(members)
        res.representatives[new_id] = max(members, key=lambda m: (weights.get(m, 0), -len(m)))
        for m in members:
            res.assignments[m] = new_id
    return res


def text_similarity(a: str, b: str, ta: Set[str], tb: Set[str]) -> float:
    if not a or not b:
        return 0.0
    jac = len(ta & tb) / len(ta | tb) if (ta or tb) else 0.0
    return max(jac, 0.5 * jac + 0.5 * SequenceMatcher(None, a, b).ratio())


def cluster_texts(values: Sequence[str], weights: Optional[Dict[str, int]] = None,
                  threshold: float = D_INTENT_THRESHOLD, max_items: int = D_MAX_CLUSTER_ITEMS,
                  enabled: bool = True) -> ClusterResult:
    weights = weights or {}
    items = [v for v in unique_preserve_order(values) if str(v).strip()]
    if not items:
        return ClusterResult(method="empty")
    if not enabled:
        return _package(items, list(range(len(items))), weights, "disabled")
    norm = [normalize_label(i) for i in items]
    if len(items) > max_items:
        buckets: Dict[str, int] = {}
        return _package(items, [buckets.setdefault(t, len(buckets)) for t in norm],
                        weights, "normalized-exact (size guard)")
    tokens = [set(t.split()) for t in norm]
    blocks: Dict[str, List[int]] = defaultdict(list)
    for i, ts in enumerate(tokens):
        for tok in ts:
            blocks[tok].append(i)
    uf, compared = UnionFind(len(items)), set()
    for cands in blocks.values():
        if len(cands) > 400:
            continue
        for i, j in combinations(cands, 2):
            pair = (i, j) if i < j else (j, i)
            if pair in compared:
                continue
            compared.add(pair)
            if text_similarity(norm[i], norm[j], tokens[i], tokens[j]) >= threshold:
                uf.union(i, j)
    return _package(items, [uf.find(i) for i in range(len(items))], weights,
                    "token-blocking + difflib union-find")


def bigrams(seq: Sequence[str]) -> Set[Tuple[str, str]]:
    """Adjacent tool transitions - the order signal, as a set for fast comparison."""
    return set(zip(seq, list(seq)[1:]))


def workflow_similarity(sa: Set[str], sb: Set[str], ba: Set[Tuple[str, str]],
                        bb: Set[Tuple[str, str]], order_weight: float) -> float:
    """Blend of WHICH tools (unigram Jaccard) and IN WHAT ORDER (bigram Jaccard).

    Both halves are set operations, so this is far faster than SequenceMatcher
    and does not degrade to ~0 just because two runs interleave the same tools
    differently.
    """
    union = len(sa | sb)
    if not union:
        return 0.0
    uni = len(sa & sb) / union
    b_union = len(ba | bb)
    order = (len(ba & bb) / b_union) if b_union else (1.0 if uni == 1.0 else 0.0)
    return (1 - order_weight) * uni + order_weight * order


def cluster_tool_sequences(sequences: Dict[str, Sequence[str]],
                           weights: Optional[Dict[str, int]] = None,
                           threshold: float = D_WORKFLOW_THRESHOLD,
                           order_weight: float = D_ORDER_WEIGHT,
                           enabled: bool = True,
                           max_leaders: int = 5000) -> ClusterResult:
    """P4: non-transitive LEADER clustering.

    v2 used union-find, which is transitive: A~B and B~C merged A with C even
    when A and C were nothing alike, collapsing everything into mega-clusters
    and making the cluster count swing wildly with the threshold. Here every
    workflow is compared against cluster LEADERS only, so membership always
    means 'similar to this leader' - the count is stable and explainable.
    """
    weights = weights or {}
    keys = [k for k, s in sequences.items() if s]
    if not keys:
        return ClusterResult(method="empty")
    if not enabled:
        return _package(keys, list(range(len(keys))), weights, "disabled")

    sets = {k: set(sequences[k]) for k in keys}
    bigs = {k: bigrams(sequences[k]) for k in keys}
    ordered = sorted(keys, key=lambda k: (-weights.get(k, 0), -len(sets[k]), k))
    leaders: List[str] = []
    assign: Dict[str, str] = {}

    for key in ordered:
        sa, ba, best_leader, best_score = sets[key], bigs[key], None, 0.0
        len_a = len(sa)
        for leader in leaders:
            sb = sets[leader]
            # cheap size prune: Jaccard can never exceed min/max cardinality ratio
            hi = min(len_a, len(sb)) / max(len_a, len(sb), 1)
            if (1 - order_weight) * hi + order_weight < threshold:
                continue
            score = workflow_similarity(sa, sb, ba, bigs[leader], order_weight)
            if score >= threshold and score > best_score:
                best_leader, best_score = leader, score
                if score > 0.98:
                    break
        if best_leader is None:
            assign[key] = key
            if len(leaders) < max_leaders:
                leaders.append(key)
        else:
            assign[key] = best_leader

    return _package(keys, [assign[k] for k in keys], weights,
                    f"leader clustering @ {threshold:.2f} (non-transitive, bigram order)")


def group_by_toolset(interactions: Dict[str, "Interaction"]) -> Dict[str, Any]:
    """Threshold-free, fully deterministic grouping: which tools were used at all.

    Reported alongside the similarity clustering so there is always one number
    that involves no tuning and cannot be argued with.
    """
    counter: Counter = Counter()
    for item in interactions.values():
        tools = {c.canonical_tool for c in item.tool_calls}
        if tools:
            counter[stable_hash("|".join(sorted(tools)))] += 1
    return {
        "distinct_toolsets": len(counter),
        "largest_toolset_share_pct": pct(max(counter.values()), sum(counter.values()))
        if counter else 0.0,
        "single_use_toolsets": sum(1 for n in counter.values() if n == 1),
    }


def clustering_sensitivity(sequences: Dict[str, Sequence[str]], weights: Dict[str, int],
                           thresholds: Sequence[float], order_weight: float,
                           quiet: bool) -> List[Dict[str, Any]]:
    """Report cluster counts across thresholds so no single number is quoted blind."""
    out = []
    for th in thresholds:
        res = cluster_tool_sequences(sequences, weights, th, order_weight, True)
        out.append({
            "threshold": th,
            "clusters": res.n_clusters,
            "largest_cluster_share_pct": res.largest_share_pct(),
            "singleton_clusters": sum(1 for m in res.members.values() if len(m) == 1),
        })
        log(f"[INFO]   threshold {th:.2f} -> {res.n_clusters} clusters "
            f"(largest holds {res.largest_share_pct()}%)", quiet)
    return out


# ---------------------------------------------------------------- filters
def parse_boundary_date(value: Optional[str], end_of_day: bool = False) -> Optional[datetime]:
    if not value:
        return None
    p = parse_timestamp(value)
    if p is None:
        raise SystemExit(f"[ERROR] Invalid date '{value}'. Use ISO format, e.g. 2026-06-01")
    if end_of_day and (p.hour, p.minute, p.second) == (0, 0, 0):
        p = p.replace(hour=23, minute=59, second=59)
    return p


def filter_interactions(interactions: Dict[str, Interaction], start_date: Optional[str],
                        end_date: Optional[str], only_positive: bool
                        ) -> Tuple[Dict[str, Interaction], Dict[str, Any]]:
    start, end = parse_boundary_date(start_date), parse_boundary_date(end_date, True)
    kept, dropped = {}, Counter()
    for key, item in interactions.items():
        ref = item.started_at or item.ended_at
        if (start or end) and ref is None:
            dropped["missing_timestamp"] += 1
        elif start and ref and ref < start:
            dropped["before_start_date"] += 1
        elif end and ref and ref > end:
            dropped["after_end_date"] += 1
        elif only_positive and item.sentiment != "positive":
            dropped["not_positive"] += 1
        else:
            kept[key] = item
    return kept, {"start_date": start_date or "", "end_date": end_date or "",
                  "only_positive": bool(only_positive), "input_interactions": len(interactions),
                  "kept_interactions": len(kept), "dropped": dict(dropped)}


# ----------------------------------------------------------------- ingest
def expand_inputs(paths: Sequence[str]) -> List[Path]:
    resolved: List[Path] = []
    for raw in paths:
        expanded = globlib.glob(os.path.expanduser(raw))
        cands = [Path(p) for p in expanded] if expanded else [Path(os.path.expanduser(raw))]
        for c in cands:
            resolved.extend(sorted(c.glob("*.csv")) if c.is_dir() else [c])
    out, seen = [], set()
    for p in resolved:
        k = str(p.resolve())
        if k not in seen:
            seen.add(k)
            out.append(p.resolve())
    return out


def analyze_csv_files(input_files: Sequence[Path], A_namespaces: Sequence[str],
                      preview_chars: int, parallel_window: float, max_rows: Optional[int],
                      canonicalise: bool, tsr: TimestampReader, min_problem_chars: int,
                      quiet: bool) -> Tuple[Dict[str, Interaction], Counter, Dict[str, Any], Dict[str, str]]:
    interactions: Dict[str, Interaction] = {}
    schema_counter: Counter = Counter()
    limit = raise_csv_field_limit()
    log(f"[INFO] CSV field size limit set to {limit:,} characters", quiet)
    report: Dict[str, Any] = {"files": [], "total_rows": 0, "failed_rows": 0,
                              "rows_without_native_id": 0}

    for path in input_files:
        size_mb = path.stat().st_size / 1e6
        log(f"[INFO] Reading: {path}  ({size_mb:,.1f} MB)", quiet)
        file_rows = file_failures = 0
        with path.open("r", encoding="utf-8-sig", errors="replace", newline="") as fh:
            reader = csv.DictReader(fh)
            if not reader.fieldnames:
                raise RuntimeError(f"CSV has no header row: {path}")
            log("[INFO] CSV columns: " + ", ".join(str(c) for c in reader.fieldnames), quiet)

            for row_number, raw_row in enumerate(reader, start=1):
                if max_rows is not None and row_number > max_rows:
                    log(f"[INFO] Stopping early at --max-rows={max_rows}", quiet)
                    break
                if row_number % 20000 == 0:
                    log(f"[INFO] Processed {row_number:,} CSV rows...", quiet)
                try:
                    row = decode_csv_row(raw_row)
                    for k in row:
                        schema_counter[normalize_key(k)] += 1

                    iid = find_interaction_id(row, row_number)
                    if iid.startswith("row_"):
                        report["rows_without_native_id"] += 1
                    item = interactions.get(iid)
                    if item is None:
                        item = Interaction(interaction_id=iid)
                        interactions[iid] = item

                    item.source_row_count += 1
                    item.source_files.append(path.name)

                    ts = tsr.from_record(row)
                    if ts:
                        item.started_at = min(item.started_at or ts, ts)
                        item.ended_at = max(item.ended_at or ts, ts)

                    intents, subintents = extract_intents(row)
                    sentiment, feedback = extract_feedback(row)
                    item.problems.extend(extract_user_messages(row, min_problem_chars))
                    item.problem_categories.extend(extract_problem_categories(row))
                    item.intents.extend(intents)
                    item.subintents.extend(subintents)
                    item.workflow_names.extend(extract_workflow_names(row))
                    item.feedback_values.extend(feedback)
                    if sentiment == "negative":
                        item.sentiment = "negative"
                    elif sentiment == "positive" and item.sentiment != "negative":
                        item.sentiment = "positive"

                    item.tool_calls.extend(extract_tool_calls(
                        row, iid, row_number, A_namespaces, preview_chars, ts, tsr))
                except Exception as exc:
                    file_failures += 1
                    report["failed_rows"] += 1
                    if file_failures <= 5:
                        log(f"[WARN] Row {row_number} in {path.name} failed: {exc}", quiet)
                    continue
                file_rows += 1

        report["files"].append({"file": str(path), "rows": file_rows,
                                "failed_rows": file_failures, "size_mb": round(size_mb, 2)})
        report["total_rows"] += file_rows

    raw_names = {c.tool_name for it in interactions.values() for c in it.tool_calls}
    alias = build_alias_map(raw_names, canonicalise)
    merged = sum(1 for k, v in alias.items() if k != v)
    log(f"[INFO] Tool names: {len(raw_names)} raw -> {len(set(alias.values()))} canonical "
        f"({merged} alias(es) merged)", quiet)

    log("[INFO] Ordering tool calls and detecting parallel fan-out...", quiet)
    for item in interactions.values():
        finalize_interaction(item, parallel_window, alias)
    log(f"[INFO] Discovered {len(interactions):,} interactions.", quiet)
    return interactions, schema_counter, report, alias


# ---------------------------------------------------------------- writers
def write_csv(path: Path, rows: Iterable[Dict[str, Any]], fields: Sequence[str]) -> None:
    with path.open("w", encoding="utf-8-sig", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=list(fields), extrasaction="ignore")
        w.writeheader()
        for row in rows:
            w.writerow(row)


def write_json(path: Path, payload: Any) -> None:
    with path.open("w", encoding="utf-8") as fh:
        json.dump(payload, fh, ensure_ascii=False, indent=2, default=str)


