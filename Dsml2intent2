def build_workflow_summary(interactions: Dict[str, Interaction], ic: ClusterResult,
                           wc: ClusterResult) -> List[Dict[str, Any]]:
    data: Dict[str, Dict[str, Any]] = defaultdict(
        lambda: {"count": 0, "interactions": [], "intents": Counter(), "clusters": Counter(),
                 "tools": Counter(), "steps": 0, "wf": "", "pos": 0, "neg": 0,
                 "success": 0, "total": 0})
    for iid, item in interactions.items():
        seq = item.tool_sequence()
        wf = workflow_signature(seq)
        if not wf:
            continue
        b = data[stable_hash(wf)]
        b["count"] += 1
        b["interactions"].append(iid)
        b["steps"], b["wf"] = len(seq), wf
        for intent in item.intents:
            b["intents"][intent] += 1
            if ic.label_of(intent):
                b["clusters"][ic.label_of(intent)] += 1
        for c in item.tool_calls:
            b["tools"][c.canonical_tool] += 1
            b["total"] += 1
            b["success"] += c.is_success
        if item.sentiment == "positive":
            b["pos"] += 1
        elif item.sentiment == "negative":
            b["neg"] += 1
    rows = []
    for wf_id, b in data.items():
        rows.append({"workflow_id": wf_id, "task_decomposition_cluster_id": wc.cluster_of(wf_id),
                     "interaction_count": b["count"], "step_count": b["steps"],
                     "total_tool_calls": b["total"], "distinct_tools": len(b["tools"]),
                     "tool_call_counts": json_dumps_safe(b["tools"].most_common(50)),
                     "unique_intent_count": len(b["intents"]),
                     "intents": json_dumps_safe(dict(b["intents"].most_common(20))),
                     "intent_clusters": json_dumps_safe(dict(b["clusters"].most_common(20))),
                     "success_rate": safe_div(b["success"], b["total"]),
                     "positive_interactions": b["pos"], "negative_interactions": b["neg"],
                     "is_single_use": int(b["count"] == 1),
                     "workflow": short_text(b["wf"], 4000),
                     "example_interactions": " | ".join(b["interactions"][:5])})
    rows.sort(key=lambda r: r["interaction_count"], reverse=True)
    return rows


