            "error_rate": safe_div(b["statuses"]["error"], total),
            "no_data_rate": safe_div(b["statuses"]["no_data"], total),
            "avg_result_length": round(statistics.mean(b["lengths"]), 2) if b["lengths"] else 0,
            "common_argument_keys": json_dumps_safe(b["argkeys"].most_common(3))})
