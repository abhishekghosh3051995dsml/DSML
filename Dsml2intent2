def build_interaction_rows(interactions: Dict[str, Interaction], ic: ClusterResult,
                           pc: ClusterResult, wc: ClusterResult) -> List[Dict[str, Any]]:
    rows = []
    for iid, item in interactions.items():
        names = item.tool_names()
        tool_counter, status = Counter(names), Counter(c.status for c in item.tool_calls)
        repeated = {t: n for t, n in tool_counter.items() if n > 1}
        total = len(item.tool_calls)
        seq = item.tool_sequence()
        wf = workflow_signature(seq)
        wf_id = stable_hash(wf) if wf else ""
        pi, pp = item.primary_intent(), item.primary_problem()
        rows.append({
            "interaction_id": iid, "source_files": " | ".join(item.source_files),
            "source_row_count": item.source_row_count,
            "started_at": iso_or_blank(item.started_at), "ended_at": iso_or_blank(item.ended_at),
            "sentiment": item.sentiment,
            "feedback_values": " || ".join(item.feedback_values)[:500],
            "problem_count": len(item.problems),
            "problems": short_text(" || ".join(item.problems), 2000),
            "problem_categories": " || ".join(item.problem_categories),
            "problem_cluster_id": pc.cluster_of(pp),
            "problem_cluster_label": short_text(pc.label_of(pp), 200),
            "intent_count": len(item.intents), "intents": " || ".join(item.intents),
            "primary_intent": pi, "intent_cluster_id": ic.cluster_of(pi),
            "intent_cluster_label": ic.label_of(pi),
            "subintent_count": len(item.subintents), "subintents": " || ".join(item.subintents),
            "declared_workflow_names": " || ".join(item.workflow_names)[:500],
            "tool_call_count": total, "unique_tool_count": len(set(names)),
            "tool_names": " || ".join(unique_preserve_order(names)),
            "workflow": short_text(wf, 4000), "workflow_id": wf_id,
            "workflow_step_count": len(seq),
            "workflow_tool_set": workflow_set_signature(names),
            "task_decomposition_cluster_id": wc.cluster_of(wf_id),
            "A_api_calls": sum(c.is_A_api for c in item.tool_calls),
            "A_calls_agent_side": sum(1 for c in item.tool_calls
                                         if c.is_A_api and c.side == "agent"),
            "A_calls_tool_side": sum(1 for c in item.tool_calls
                                        if c.is_A_api and c.side == "tool"),
            "calls_agent_side": sum(1 for c in item.tool_calls if c.side == "agent"),
            "calls_tool_side": sum(1 for c in item.tool_calls if c.side == "tool"),
            "max_parallel_degree": item.max_parallel_degree(),
            "parallel_tool_groups": "; ".join(", ".join(g) for g in item.parallel_groups())[:1000],
            "success_calls": status["success"], "partial_calls": status["partial"],
            "no_data_calls": status["no_data"], "skipped_calls": status["skipped"],
            "error_calls": status["error"], "empty_calls": status["empty"],
            "tool_success_rate": safe_div(status["success"], total),
            "repeated_tool_types": len(repeated),
            "repeated_tool_calls": sum(n - 1 for n in repeated.values()),
            "repeated_tools": json_dumps_safe(repeated),
            "has_problem": int(bool(item.problems)), "has_intent": int(bool(item.intents)),
            "has_tool_calls": int(bool(item.tool_calls))})
    rows.sort(key=lambda r: r["tool_call_count"], reverse=True)
    return rows


