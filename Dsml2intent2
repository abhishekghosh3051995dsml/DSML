# ---------------------------------------------------------------- helpers
def normalize_key(v: Any) -> str:
    return "" if v is None else re.sub(r"[^a-z0-9]+", "_", str(v).strip().lower()).strip("_")


def normalize_text(v: Any) -> str:
    if v is None:
        return ""
    t = str(v).replace("\\n", " ").replace("\\r", " ").replace("\\t", " ")
    return re.sub(r"\s+", " ", t).strip()


def normalize_label(v: Any) -> str:
    return re.sub(r"[^a-z0-9]+", " ", str(v).lower()).strip()


def short_text(v: Any, limit: int = D_PREVIEW_CHARS) -> str:
    t = normalize_text(v)
    return t if len(t) <= limit else t[:limit] + "..."


def stable_hash(v: str, length: int = 20) -> str:
    return hashlib.sha256(v.encode("utf-8", errors="ignore")).hexdigest()[:length]


def json_dumps_safe(v: Any) -> str:
    try:
        return json.dumps(v, ensure_ascii=False, default=str)
    except Exception:
        return str(v)


def unique_preserve_order(values: Iterable[Any]) -> List[Any]:
    seen, out = set(), []
    for v in values:
        m = json_dumps_safe(v)
        if m not in seen:
            seen.add(m)
            out.append(v)
    return out


def safe_div(a: float, b: float, digits: int = 6) -> float:
    return round(a / b, digits) if b else 0.0


def pct(a: float, b: float) -> float:
    return round(100.0 * a / b, 2) if b else 0.0


def log(msg: str, quiet: bool = False) -> None:
    if not quiet:
        print(msg, flush=True)


# ------------------------------------------------- JSON / literal decoding
def _decode_candidates(text: str) -> Iterator[str]:
    yield text
    if '""' in text:
        yield text.replace('""', '"')
    if '\\"' in text:
        yield text.replace('\\"', '"')
    if '""' in text and '\\"' in text:
        yield text.replace('""', '"').replace('\\"', '"')


def try_decode(value: Any, depth: int = 0) -> Any:
    if depth >= JSON_MAX_DEPTH or not isinstance(value, (str, dict, list)):
        return value
    if isinstance(value, dict):
        return {k: try_decode(v, depth + 1) for k, v in value.items()}
    if isinstance(value, list):
        return [try_decode(v, depth + 1) for v in value]
    t = value.strip()
    if len(t) < 2 or not ((t[0] == "{" and t[-1] == "}") or (t[0] == "[" and t[-1] == "]")):
        return value
    for cand in _decode_candidates(t):
        try:
            return try_decode(json.loads(cand), depth + 1)
        except Exception:
            continue
    try:
        dec = ast.literal_eval(t)
        if isinstance(dec, (dict, list, tuple)):
            return try_decode(list(dec) if isinstance(dec, tuple) else dec, depth + 1)
    except Exception:
        pass
    return value


def walk(obj: Any, path: Tuple[str, ...] = (), skip_opaque: bool = False
         ) -> Iterator[Tuple[Tuple[str, ...], str, Any]]:
    """Walk nested structures. skip_opaque avoids descending into tool payloads."""
    if isinstance(obj, dict):
        for k, v in obj.items():
            nk = normalize_key(k)
            yield path, nk, v
            if skip_opaque and nk in OPAQUE_KEYS:
                continue
            yield from walk(v, path + (nk,), skip_opaque)
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            yield from walk(v, path + (str(i),), skip_opaque)


def find_by_patterns(obj: Any, include: Sequence[str], exclude: Sequence[str] = (),
                     skip_opaque: bool = True) -> List[Any]:
    out = []
    for _, key, val in walk(obj, skip_opaque=skip_opaque):
        if not key or not any(p in key for p in include) or any(p in key for p in exclude):
            continue
        if isinstance(val, (str, int, float, bool)):
            out.append(val)
        elif isinstance(val, list):
            out.extend(x for x in val if isinstance(x, (str, int, float, bool)))
    return out


def find_by_exact_keys(obj: Any, keys: Sequence[str], skip_opaque: bool = True) -> List[Any]:
    wanted = {normalize_key(k) for k in keys}
    return [v for _, k, v in walk(obj, skip_opaque=skip_opaque)
            if k in wanted and isinstance(v, (str, int, float, bool))]


# ------------------------------------------------------------- timestamps
def _from_epoch(v: float) -> Optional[datetime]:
    if v <= 0:
        return None
    if v > 1e17:
        v /= 1e9
    elif v > 1e14:
        v /= 1e6
    elif v > 1e11:
        v /= 1e3
    try:
        return datetime.fromtimestamp(v, tz=timezone.utc)
    except Exception:
        return None


def parse_timestamp(value: Any) -> Optional[datetime]:
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, datetime):
        return value if value.tzinfo else value.replace(tzinfo=timezone.utc)
    if isinstance(value, (int, float)):
        return _from_epoch(float(value))
    t = normalize_text(value)
    if not t or t.lower() in NULLISH:
        return None
    try:
        p = datetime.fromisoformat(t.replace("Z", "+00:00"))
        return p if p.tzinfo else p.replace(tzinfo=timezone.utc)
    except Exception:
        pass
    for fmt in TIMESTAMP_FORMATS:
        try:
            p = datetime.strptime(t, fmt)
            return p if p.tzinfo else p.replace(tzinfo=timezone.utc)
        except Exception:
            continue
    return _from_epoch(float(t)) if t.replace(".", "", 1).isdigit() else None


class TimestampReader:
    """P5: parse timestamps, reject implausible ones, and record which key won."""

    def __init__(self, min_year: int, max_year_ahead: int) -> None:
        self.min_dt = datetime(min_year, 1, 1, tzinfo=timezone.utc)
        self.max_dt = datetime(datetime.now(timezone.utc).year + max_year_ahead, 12, 31,
                               tzinfo=timezone.utc)
        self.key_usage: Counter = Counter()
        self.rejected: Counter = Counter()

    def plausible(self, dt: Optional[datetime]) -> bool:
        return dt is not None and self.min_dt <= dt <= self.max_dt

    def from_node(self, node: Dict[str, Any]) -> Optional[datetime]:
        norm = {normalize_key(k): v for k, v in node.items()}
        for key in TIMESTAMP_KEYS:
            if key not in norm:
                continue
            p = parse_timestamp(norm[key])
            if p is None:
                continue
            if self.plausible(p):
                self.key_usage[key] += 1
                return p
            self.rejected[f"{key}={p.date().isoformat()}"] += 1
        return None

    def from_record(self, obj: Any) -> Optional[datetime]:
        best: Optional[datetime] = None
        for _, key, value in walk(obj, skip_opaque=True):
            if key not in TIMESTAMP_KEYS or not isinstance(value, (str, int, float)):
                continue
            p = parse_timestamp(value)
            if p is None:
                continue
            if not self.plausible(p):
                self.rejected[f"{key}={p.date().isoformat()}"] += 1
                continue
            self.key_usage[key] += 1
            if best is None or p < best:
                best = p
        return best


def iso_or_blank(v: Optional[datetime]) -> str:
    return v.isoformat() if v else ""


# --------------------------------------------------------------- entities
def find_interaction_id(obj: Any, row_number: int) -> str:
    priority = [normalize_key(x) for x in ID_PRIORITY]
    found: Dict[str, List[str]] = defaultdict(list)
    for _, key, val in walk(obj, skip_opaque=True):
        if key in priority and isinstance(val, (str, int)):
            t = str(val).strip()
            if t and t.lower() not in NULLISH:
                found[key].append(t)
    for cand in priority:
        if found[cand]:
            return found[cand][0]
    for v in find_by_patterns(obj, ("id",)):
        if len(str(v).strip()) >= 8:
            return str(v).strip()
    return f"row_{row_number:09d}"


def extract_user_messages(obj: Any, min_chars: int) -> List[str]:
    """P1: real customer text only. Role-tagged messages first; the fallback is
    restricted to explicitly named problem fields and never enters tool payloads."""
    messages: List[str] = []

    def recurse(node: Any) -> None:
        if isinstance(node, dict):
            norm = {normalize_key(k): v for k, v in node.items()}
            role = normalize_text(norm.get("role", norm.get("type", norm.get("speaker", "")))).lower()
            if role in USER_ROLES:
                for f in USER_TEXT_KEYS:
                    val = norm.get(f)
                    if isinstance(val, str) and normalize_text(val):
                        messages.append(normalize_text(val))
                    elif isinstance(val, dict):
                        for inner in USER_TEXT_KEYS:
                            iv = val.get(inner)
                            if isinstance(iv, str) and normalize_text(iv):
                                messages.append(normalize_text(iv))
                    elif isinstance(val, list):
                        messages.extend(normalize_text(x) for x in val
                                        if isinstance(x, str) and normalize_text(x))
            for k, v in node.items():
                if normalize_key(k) in OPAQUE_KEYS:
                    continue
                recurse(v)
        elif isinstance(node, list):
            for v in node:
                recurse(v)

    recurse(obj)

    if not messages:
        for v in find_by_exact_keys(obj, PROBLEM_FALLBACK, skip_opaque=True):
            t = normalize_text(v)
            if len(t) >= min_chars:
                messages.append(t)
    return unique_preserve_order([m for m in messages if len(m) >= min_chars])


def extract_problem_categories(obj: Any) -> List[str]:
    vals = find_by_patterns(obj, ("problem_type", "issue_type", "problem_category"),
                            ("id", "count"), skip_opaque=True)
    return unique_preserve_order([normalize_text(v) for v in vals if normalize_text(v)])


def extract_intents(obj: Any) -> Tuple[List[str], List[str]]:
    intents, subintents = [], []
    for _, key, val in walk(obj, skip_opaque=True):
        if not isinstance(val, (str, int, float)) or isinstance(val, bool):
            continue
        t = normalize_text(val)
        if not t or t.lower() in NULLISH:
            continue
        if "subintent" in key or "sub_intent" in key:
            subintents.append(t)
        elif "intent" in key and not any(x in key for x in INTENT_EXCLUDE):
            intents.append(t)
    return unique_preserve_order(intents), unique_preserve_order(subintents)


def extract_workflow_names(obj: Any) -> List[str]:
    vals = find_by_patterns(obj, ("workflow", "playbook", "flow_name", "plan_name"),
                            ("id", "count", "index"), skip_opaque=True)
    return unique_preserve_order([normalize_text(v) for v in vals
                                  if normalize_text(v) and normalize_text(v).lower() not in NULLISH])


def classify_feedback_value(value: Any) -> str:
    t = normalize_text(value)
    if not t or t.lower() in NULLISH:
        return "unknown"
    if any(p.search(t) for p in NEGATIVE_RE):
        return "negative"
    if any(p.search(t) for p in POSITIVE_RE):
        return "positive"
    return "unknown"


def extract_feedback(obj: Any) -> Tuple[str, List[str]]:
    raw = [normalize_text(v) for v in find_by_exact_keys(obj, FEEDBACK_KEYS, skip_opaque=True)
           if normalize_text(v) and normalize_text(v).lower() not in NULLISH]
    sentiment = "unknown"
    for v in raw:
        c = classify_feedback_value(v)
        if c == "negative":
            return "negative", unique_preserve_order(raw)
        if c == "positive":
            sentiment = "positive"
    return sentiment, unique_preserve_order(raw)


# ------------------------------------------------------------- tool calls
@dataclass
class ToolCall:
    interaction_id: str
    row_number: int
    call_index: int
    tool_name: str
    canonical_tool: str
    namespace: str
    function_name: str
    is_A_api: int
    side: str
    arguments: str
    argument_keys: str
    result: str
    error: str
    status: str
    is_success: int
    timestamp: str
    step_key: str
    parallel_group: str
    parallel_degree: int
    source_path: str
    result_length: int
    argument_length: int


def split_tool_name(name: str) -> Tuple[str, str]:
    m = TOOL_NAME_PATTERN.match(name.strip())
    return (m.group("namespace"), m.group("function")) if m else ("", name.strip())


def classify_tool_status(result: Any, error: Any) -> str:
    err = normalize_text(error)
    if err and err.lower() not in NULLISH:
        return "skipped" if any(p in err.lower() for p in SKIPPED_PATTERNS) else "error"
    res = normalize_text(result).lower()
    if not res or res in NULLISH:
        return "empty"
    if any(p in res for p in PARTIAL_PATTERNS):
        return "partial"
    if any(p in res for p in ERROR_PATTERNS):
        return "error"
    if any(p in res for p in NO_DATA_PATTERNS):
        return "no_data"
    if any(p in res for p in SKIPPED_PATTERNS):
        return "skipped"
    return "success"


def classify_side(node: Dict[str, Any], row: Dict[str, Any]) -> str:
    cands = []
    norm = {normalize_key(k): v for k, v in node.items()}
    for key in SIDE_KEYS:
        if key in norm and isinstance(norm[key], (str, int, float)):
            cands.append(normalize_text(norm[key]).lower())
    if not cands:
        cands = [normalize_text(v).lower() for v in find_by_exact_keys(row, SIDE_KEYS)]
    for t in cands:
        if not t:
            continue
        if any(h in t for h in AGENT_SIDE_HINTS):
            return "agent"
        if any(h in t for h in TOOL_SIDE_HINTS):
            return "tool"
    return DEFAULT_SIDE


def extract_step_key(node: Dict[str, Any], row: Dict[str, Any]) -> str:
    norm = {normalize_key(k): v for k, v in node.items()}
    for key in STEP_KEYS:
        if key in norm and isinstance(norm[key], (str, int, float)):
            t = normalize_text(norm[key])
            if t and t.lower() not in NULLISH:
                return t
    for v in find_by_exact_keys(row, STEP_KEYS):
        t = normalize_text(v)
        if t and t.lower() not in NULLISH:
            return t
    return ""


def extract_tool_calls(obj: Any, interaction_id: str, row_number: int,
                       A_namespaces: Sequence[str], preview_chars: int,
                       row_timestamp: Optional[datetime], tsr: TimestampReader) -> List[ToolCall]:
    calls: List[ToolCall] = []
    A_set = {n.lower() for n in A_namespaces}

    def recurse(node: Any, path: Tuple[str, ...]) -> None:
        if isinstance(node, dict):
            norm = {normalize_key(k): v for k, v in node.items()}
            tool_name = ""
            for key in TOOL_NAME_KEYS:
                v = norm.get(key)
                if isinstance(v, str) and v.strip():
                    tool_name = v.strip()
                    break
            if not tool_name:
                nm = norm.get("name")
                if isinstance(nm, str) and nm.strip() and set(norm).intersection(
                        ARG_KEYS | RESULT_KEYS | ERROR_KEYS):
                    tool_name = nm.strip()

            if tool_name:
                args = next((norm[k] for k in ARG_KEYS if k in norm), None)
                result = next((norm[k] for k in RESULT_KEYS if k in norm), None)
                error = next((norm[k] for k in ERROR_KEYS if k in norm), None)
                ns, fn = split_tool_name(tool_name)
                status = classify_tool_status(result, error)
                args_text, res_text = json_dumps_safe(args), json_dumps_safe(result)
                calls.append(ToolCall(
                    interaction_id=interaction_id, row_number=row_number, call_index=0,
                    tool_name=tool_name, canonical_tool=tool_name, namespace=ns, function_name=fn,
                    is_A_api=int((ns or tool_name).lower() in A_set),
                    side=classify_side(node, obj),
                    arguments=short_text(args_text, preview_chars),
                    argument_keys="|".join(sorted(normalize_key(k) for k in args))
                    if isinstance(args, dict) else "",
                    result=short_text(res_text, preview_chars),
                    error=short_text(normalize_text(error), preview_chars),
                    status=status, is_success=int(status == "success"),
                    timestamp=iso_or_blank(tsr.from_node(node) or row_timestamp),
                    step_key=extract_step_key(node, obj),
                    parallel_group="", parallel_degree=1, source_path=".".join(path),
                    result_length=len(res_text), argument_length=len(args_text)))
                return  # never descend into a matched call's own payload

            for k, v in node.items():
                recurse(v, path + (normalize_key(k),))
        elif isinstance(node, list):
            for i, v in enumerate(node):
                recurse(v, path + (str(i),))

    recurse(obj, ())

    # Dedup only within this row: the same call is often serialised twice per row.
    # Genuine retries live in different rows and must survive.
    out, seen = [], set()
    for c in calls:
        fp = (c.tool_name, c.arguments, c.result, c.error, c.timestamp)
        if fp not in seen:
            seen.add(fp)
            out.append(c)
    return out


def raise_csv_field_limit() -> int:
    limit = min(sys.maxsize, 2 ** 31 - 1)
    while limit > 1024:
        try:
            csv.field_size_limit(limit)
            return limit
        except OverflowError:
            limit //= 2
    return csv.field_size_limit()


def decode_csv_row(row: Dict[str, Any]) -> Dict[str, Any]:
    out = {}
    for k, v in row.items():
        if k is None:
            continue
        if isinstance(v, list):
            v = " ".join(str(x) for x in v)
        out[str(k).strip()] = try_decode(v)
    return out


