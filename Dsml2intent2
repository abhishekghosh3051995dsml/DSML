def divergence_verdict(n_items: int, n_workflows: int, n_clusters: int) -> str:
    if not n_items:
        return "no data"
    ratio = n_workflows / n_items
    if ratio >= 0.8:
        base = "HIGH DIVERGENCE - a near-unique workflow almost every run"
    elif ratio >= 0.4:
        base = "MIXED - partial reuse with substantial per-run variation"
    else:
        base = "STABLE - workflows are largely reused"
    if n_clusters and n_workflows:
        base += f"; {n_clusters} structural cluster(s) at the chosen threshold"
    return base


def build_intent_workflow_summary(interactions: Dict[str, Interaction], ic: ClusterResult,
                                  wc: ClusterResult, use_clusters: bool = True
                                  ) -> List[Dict[str, Any]]:
    rel: Dict[str, Dict[str, Any]] = defaultdict(
        lambda: {"interactions": set(), "workflows": Counter(), "clusters": set(),
                 "tools": Counter(), "labels": set(), "pos": 0, "neg": 0, "calls": 0})
    for iid, item in interactions.items():
        wf = workflow_signature(item.tool_sequence())
        wf_id = stable_hash(wf) if wf else ""
        raw = item.intents or ["__INTENT_NOT_AVAILABLE__"]
        keys = unique_preserve_order([ic.label_of(i, i) for i in raw]) if use_clusters else raw
        for key, original in zip(keys, raw):
            b = rel[key]
            b["interactions"].add(iid)
            b["labels"].add(original)
            b["calls"] += len(item.tool_calls)
            if wf_id:
                b["workflows"][wf_id] += 1
                cid = wc.cluster_of(wf_id)
                if cid is not None:
                    b["clusters"].add(cid)
            for c in item.tool_calls:
                b["tools"][c.canonical_tool] += 1
            if item.sentiment == "positive":
                b["pos"] += 1
            elif item.sentiment == "negative":
                b["neg"] += 1
    rows = []
    for intent, b in rel.items():
        n_int, n_wf, n_cl = len(b["interactions"]), len(b["workflows"]), len(b["clusters"])
        dom, dom_n = b["workflows"].most_common(1)[0] if b["workflows"] else ("", 0)
        rows.append({"intent_cluster": intent,
                     "member_intent_labels": " || ".join(sorted(b["labels"]))[:800],
                     "interaction_count": n_int, "distinct_workflow_count": n_wf,
                     "task_decomposition_cluster_count": n_cl,
                     "workflow_consistency_rate": safe_div(dom_n, n_int),
                     "workflow_reuse_ratio": round(1 - n_wf / n_int, 6) if n_int else 0.0,
                     "dominant_workflow_id": dom, "dominant_workflow_count": dom_n,
                     "verdict": divergence_verdict(n_int, n_wf, n_cl),
                     "avg_tool_calls": safe_div(b["calls"], n_int, 4),
                     "positive_interactions": b["pos"], "negative_interactions": b["neg"],
                     "distinct_tool_count": len(b["tools"]),
                     "top_tools": json_dumps_safe(b["tools"].most_common(20)),
                     "workflow_distribution": json_dumps_safe(b["workflows"].most_common(50))})
    rows.sort(key=lambda r: r["interaction_count"], reverse=True)
    return rows


