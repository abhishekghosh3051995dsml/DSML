def build_tool_summary(interactions: Dict[str, Interaction]) -> List[Dict[str, Any]]:
    """P3: adds coverage - what share of interactions call this tool at all."""
    total_interactions = len(interactions)
    data: Dict[str, Dict[str, Any]] = defaultdict(
        lambda: {"calls": 0, "interactions": set(), "statuses": Counter(), "sides": Counter(),
                 "lengths": [], "namespace": "", "is_A_api": 0, "argkeys": Counter(),
                 "raw_names": set()})
    for iid, item in interactions.items():
