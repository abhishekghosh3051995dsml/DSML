          f"{m5['unique_tools_canonical']:,} tools "
          f"({m5['unique_tools_raw_names']:,} raw names, "
          f"{m5['tool_name_aliases_merged']:,} merged)")
    print(f"  ALWAYS-ON tools (>=95% int.): {m5['always_on_tools']:,} "
          f"({m5['always_on_pct_of_catalogue']}% of the catalogue)")
    print(f"  A API calls              : {m5['A_api_calls']:,}   "
          f"(agent side {m5['A_calls_agent_side']:,} / "
          f"tool side {m5['A_calls_tool_side']:,})")
    print(f"  Success / error / no-data   : {m5['successful_tool_calls']:,} / "
          f"{m5['error_tool_calls']:,} / {m5['no_data_tool_calls']:,}")
    print(f"  Tool success rate           : {round(m5['tool_success_rate'] * 100, 2)}%")
    print(f"  Parallel fan-out            : max degree {m5['max_parallel_degree']}, "
          f"{m5['interactions_with_parallel_calls']:,} interactions with parallel calls")
    print(line)


# ------------------------------------------------------------------- main
def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Generate production-grade A metrics from interactions.csv",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    p.add_argument("input_csv", nargs="*",
                   default=[os.getenv("A_INTERACTIONS_CSV", "interactions.csv")],
                   help="One or more CSV files, directories or globs.")
    p.add_argument("--output-dir", default=os.getenv("A_METRICS_OUTPUT", "A_metrics_output"))
    p.add_argument("--start-date", default=None, help="Inclusive ISO start, e.g. 2026-06-01")
    p.add_argument("--end-date", default=None, help="Inclusive ISO end, e.g. 2026-08-31")
    p.add_argument("--only-positive", action="store_true")
    p.add_argument("--max-rows", type=int, default=None)
    p.add_argument("--no-clustering", action="store_true")
    p.add_argument("--no-canonical-tools", action="store_true",
                   help="Disable data-driven merging of duplicate tool-name variants.")
    p.add_argument("--intent-threshold", type=float, default=D_INTENT_THRESHOLD)
    p.add_argument("--workflow-threshold", type=float, default=D_WORKFLOW_THRESHOLD)
    p.add_argument("--order-weight", type=float, default=D_ORDER_WEIGHT)
    p.add_argument("--parallel-window", type=float, default=D_PARALLEL_WINDOW)
    p.add_argument("--max-cluster-items", type=int, default=D_MAX_CLUSTER_ITEMS)
    p.add_argument("--A-namespaces", default=",".join(DEFAULT_A_NAMESPACES))
    p.add_argument("--preview-chars", type=int, default=D_PREVIEW_CHARS)
    p.add_argument("--min-problem-chars", type=int, default=D_MIN_PROBLEM_CHARS,
                   help="Shorter strings are not treated as customer problem text.")
    p.add_argument("--min-year", type=int, default=D_MIN_YEAR,
                   help="Timestamps before this year are treated as corrupt and ignored.")
    p.add_argument("--max-year-ahead", type=int, default=D_MAX_YEAR_AHEAD)
    p.add_argument("--no-sensitivity", action="store_true",
                   help="Skip the clustering threshold sweep (faster).")
    p.add_argument("--no-tool-call-export", action="store_true",
                   help="Skip 02_tool_calls.csv (large on big dumps).")
    p.add_argument("--quiet", action="store_true")
    return p.parse_args()


def main() -> int:
    args = parse_args()
    input_files = expand_inputs(args.input_csv)
    missing = [str(p) for p in input_files if not p.exists()]
    if missing or not input_files:
        for m in missing:
            print(f"[ERROR] Input CSV not found: {m}", file=sys.stderr)
        if not input_files:
            print("[ERROR] No input files resolved.", file=sys.stderr)
        return 2

    out_dir = Path(args.output_dir).expanduser().resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    A_ns = [n.strip() for n in args.A_namespaces.split(",") if n.strip()]
    clustering = not args.no_clustering
    tsr = TimestampReader(args.min_year, args.max_year_ahead)

    interactions, schema_counter, ingest_report, alias = analyze_csv_files(
        input_files, A_ns, args.preview_chars, args.parallel_window, args.max_rows,
        not args.no_canonical_tools, tsr, args.min_problem_chars, args.quiet)

    interactions, filter_report = filter_interactions(
        interactions, args.start_date, args.end_date, args.only_positive)
    log(f"[INFO] {filter_report['kept_interactions']:,} interactions kept after filters"
        f" (dropped: {filter_report['dropped'] or 'none'})", args.quiet)

    if not interactions:
        print("[WARN] No interactions left after filtering. "
              "Check --start-date/--end-date/--only-positive.")
        write_json(out_dir / "10_global_metrics.json",
                   {"warning": "no interactions", "filters": filter_report})
        return 0

    log("[INFO] Clustering intents and task decompositions...", args.quiet)
    intent_w, problem_w, workflow_w = Counter(), Counter(), Counter()
    intent_int, problem_int = Counter(), Counter()
    sequences: Dict[str, Sequence[str]] = {}
    for item in interactions.values():
        for label in unique_preserve_order(item.intents + item.subintents):
            intent_w[label] += 1
            intent_int[label] += 1
        for label in unique_preserve_order(item.problems):
            problem_w[label] += 1
            problem_int[label] += 1
        seq = item.tool_sequence()
        if seq:
            wf_id = stable_hash(workflow_signature(seq))
            sequences.setdefault(wf_id, seq)
            workflow_w[wf_id] += 1

    ic = cluster_texts(list(intent_w), dict(intent_w), args.intent_threshold,
                       args.max_cluster_items, clustering)
    pc = cluster_texts(list(problem_w), dict(problem_w), args.intent_threshold,
                       args.max_cluster_items, clustering)
    wc = cluster_tool_sequences(sequences, dict(workflow_w), args.workflow_threshold,
                                args.order_weight, clustering)

    sensitivity: List[Dict[str, Any]] = []
    if clustering and not args.no_sensitivity and sequences:
        log("[INFO] Running clustering sensitivity sweep...", args.quiet)
        sensitivity = clustering_sensitivity(sequences, dict(workflow_w), D_SENSITIVITY,
                                             args.order_weight, args.quiet)

    log("[INFO] Building metrics...", args.quiet)
    write_csv(out_dir / "01_interaction_metrics.csv",
              build_interaction_rows(interactions, ic, pc, wc), INTERACTION_FIELDS)
    if not args.no_tool_call_export:
        write_csv(out_dir / "02_tool_calls.csv",
                  [asdict(c) for i in interactions.values() for c in i.tool_calls],
                  TOOL_CALL_FIELDS)
    write_csv(out_dir / "03_tool_summary.csv",
              build_tool_summary(interactions), TOOL_SUMMARY_FIELDS)
    write_csv(out_dir / "04_workflow_summary.csv",
              build_workflow_summary(interactions, ic, wc), WORKFLOW_FIELDS)
    write_csv(out_dir / "05_intent_workflow_summary.csv",
              build_intent_workflow_summary(interactions, ic, wc, clustering),
              INTENT_WORKFLOW_FIELDS)
    write_csv(out_dir / "06_tool_cooccurrence.csv",
              build_tool_cooccurrence(interactions), COOCCURRENCE_FIELDS)
    write_csv(out_dir / "07_tool_transitions.csv",
              build_tool_transitions(interactions), TRANSITION_FIELDS)
    write_csv(out_dir / "08_intent_summary.csv",
              build_intent_summary(interactions, ic), INTENT_FIELDS)
    write_csv(out_dir / "09_schema_profile.csv",
              ({"field": n, "row_occurrence_count": c} for n, c in schema_counter.most_common()),
              ["field", "row_occurrence_count"])
    summary = build_global_summary(interactions, ic, pc, wc, filter_report, ingest_report,
                                   sensitivity, tsr, alias)
    write_json(out_dir / "10_global_metrics.json", summary)
    write_csv(out_dir / "11_intent_clusters.csv",
              build_cluster_rows(ic, dict(intent_w), "intent", dict(intent_int)), CLUSTER_FIELDS)
    write_csv(out_dir / "12_task_decomposition_clusters.csv",
              build_cluster_rows(wc, dict(workflow_w), "task_decomposition", dict(workflow_w)),
              CLUSTER_FIELDS)
    write_csv(out_dir / "13_problem_clusters.csv",
              build_cluster_rows(pc, dict(problem_w), "problem", dict(problem_int)), CLUSTER_FIELDS)
    write_csv(out_dir / "14_parallel_tool_groups.csv",
              build_parallel_group_rows(interactions), PARALLEL_FIELDS)
    write_csv(out_dir / "15_intent_workflow_matrix.csv",
              build_intent_workflow_matrix(interactions, ic, wc), MATRIX_FIELDS)
    write_csv(out_dir / "16_tool_name_aliases.csv",
              build_alias_rows(alias, interactions), ALIAS_FIELDS)

    print_console_summary(summary)
    print(f"\n[DONE] Metrics written to:\n{out_dir}\n\nGenerated files:")
    for p in sorted(out_dir.glob("*")):
        print(f"  - {p.name}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
