TELECOM_TERMS = {
    r"\bhsi\b": "home internet service", r"\bmsisdn\b": "mobile number",
    r"\bimei\b": "device identifier", r"\biccid\b": "sim identifier",
    r"\bban\b": "billing account", r"\bsoc\b": "service code",
    r"\bapn\b": "access point name", r"\bvolte\b": "voice over lte",
    r"\bcpe\b": "customer premises equipment", r"\besim\b": "embedded sim",
    r"\bcx\b": "customer", r"\brca\b": "root cause analysis",
}


def phase2(df, C, R, masker):
    log("\n=== PHASE 2  TEMPLATE, MASKING, CLEANING ===")
    R.h("Phase 2 · Extracting the real problem statement")

    if C.get("role"):
        user = df[df["_role"] == "user"].copy()
    else:
        user = df.copy()
    log(f"  user messages: {len(user):,} of {len(df):,}")

    # ---- discover the intake template
    log("  2.1 discovering the intake template")
    fields, payload, TR = discover_template(user["_raw"].tolist())
    if len(TR):
        R.h("2.1 The intake form, discovered from the data", 3)
        R.csv(TR, "p2_01_template_fields.csv")
        R.table(TR[TR["promoted"]], max_rows=30)
        R.note("These field labels were found by pattern and ranked by how often "
               "they appear; the cutoff is the knee of that frequency curve. "
               "Nothing about this form is written into the code, so a different "
               "intake layout in a future export is discovered the same way.")
    if payload:
        cov = float(TR.loc[TR['field'] == payload, 'coverage_pct'].iloc[0])
        R.ok(f"Free-text payload field identified: '{payload}' "
             f"(present in {cov:.1f}% of user messages). This is the customer's "
             f"actual problem statement. Everything else on the form is "
             f"identifiers and will not be used as model input.")
        prov("payload_field", payload, "DERIVED",
             "promoted field with the greatest median length and lexical variety")
        finding("INFO", "Intake form detected and split",
                f"{len(fields)} recurring fields; payload = '{payload}'.",
                "Model on the payload, not the whole form.")
    else:
        R.warn("No free-text payload field could be identified. Falling back to "
               "the whole message as X.")

    # ---- parse and mask, field by field
    log("  2.2 field-aware PII masking")
    issue_txt, kept_other, n_templated = [], [], 0
    for t in user["_raw"]:
        f, rest = split_fields(t)
        if f:
            n_templated += 1
        masked_fields = {k: masker.mask_field(k, v) for k, v in f.items()}
        # The body is ALWAYS assembled from already-masked pieces. Never fall
        # back to span-masking the raw blob: span masking has no name rule (by
        # design, because an unbounded name pattern is what leaked the BAN in
        # v1), so a raw fallback would emit customer names in clear text.
        if payload and payload in f:
            body = masked_fields[payload]
        elif f:
            # no payload field: keep every non-identifier field value, in order
            body = " ".join(v for k, v in masked_fields.items()
                            if field_kind(k) is None and v)
            if rest.strip():
                body = (body + " " + masker.mask_span(rest)).strip()
        else:
            body = masker.mask_span(t)
        issue_txt.append(body)
        kept_other.append(json.dumps(
            {k: v for k, v in masked_fields.items() if k != payload})[:600])

    user["_issue"] = pd.Series(issue_txt, index=user.index).fillna("")
    user["_fields_masked"] = kept_other
    R.p(f"{n_templated:,} of {len(user):,} user messages "
        f"({100.0 * n_templated / max(len(user), 1):.1f}%) are form-structured; "
        f"the remainder are free text. Both paths converge on a single problem "
        f"statement field.")

    # ---- residue check on what will actually be modelled
    res = []
    for name, rx in RESIDUE:
        n = int(user["_issue"].str.contains(rx).sum())
        res.append({"check": name, "rows_with_residue": n,
                    "pct": round(100.0 * n / max(len(user), 1), 3),
                    "status": "PASS" if n == 0 else "REVIEW"})
    RES = pd.DataFrame(res)
    R.csv(RES, "p2_02_pii_residue_check.csv")
    R.h("PII residue check on the modelled text", 3)
    R.table(RES)
    if (RES["status"] == "REVIEW").any():
        R.warn("Residue detected — inspect p2_02 before sharing this run. Note "
               "that a long digit run inside a ticket reference is not "
               "necessarily personal data; confirm case by case.")
        finding("HIGH", "Possible PII residue",
                RES[RES.status == "REVIEW"].to_dict("records"),
                "Review before circulating outputs.")
    else:
        R.ok("No email addresses, long digit runs or IP addresses remain in the "
             "text that will be modelled.")

    R.csv(masker.report() if hasattr(masker, "report") else
          pd.DataFrame(sorted(masker.counts.items()),
                       columns=["entity_type", "spans_masked"]),
          "p2_03_masking_summary.csv")

    # ---- normalise
    log("  2.3 normalising")
    clean = user["_issue"].str.lower()
    for pat, rep in TELECOM_TERMS.items():
        clean = clean.str.replace(pat, rep, regex=True)
    clean = (clean.str.replace(r"<([a-z]+)_[0-9a-f]+>", r" ", regex=True)
             .str.replace(r"\s+", " ", regex=True).str.strip())
    user["_clean"] = clean
    prov("telecom_abbreviations", len(TELECOM_TERMS), "DOMAIN_FACT",
         "SME lexicon; exported for review")

    before = len(user)
    user = user[user["_clean"].str.len() >= 3]
    dup = int(user["_clean"].duplicated().sum())

    steps = pd.DataFrame([
        {"step": "1 split the intake form into fields",
         "detail": f"{len(fields)} recurring fields discovered; "
                   f"payload = {payload or 'n/a'}"},
        {"step": "2 mask PII per field",
         "detail": f"{sum(masker.counts.values()):,} values replaced with salted "
                   f"surrogates: {dict(masker.counts)}"},
        {"step": "3 keep user messages only",
         "detail": f"{len(user):,} kept; assistant messages excluded from X "
                   f"because they contain the answer"},
        {"step": "4 reduce to the problem statement",
         "detail": f"median length {int(user['_raw'].str.len().median())} chars "
                   f"-> {int(user['_clean'].str.len().median())} chars after "
                   f"removing form furniture"},
        {"step": "5 expand telecom abbreviations",
         "detail": f"{len(TELECOM_TERMS)} domain terms normalised"},
        {"step": "6 drop empty after cleaning", "detail": f"{before - len(user):,} dropped"},
        {"step": "7 duplicate check",
         "detail": f"{dup:,} messages repeat text already seen "
                   f"({100.0 * dup / max(len(user), 1):.1f}%). Kept for analysis; "
                   f"collapsed before clustering and before any train/test split."},
    ])
    R.h("2.2 Cleaning steps", 3)
    R.csv(steps, "p2_04_cleaning_steps.csv")
    R.table(steps)
    R.note("X is the customer's problem statement with identifiers removed. In "
           "v1 the whole intake form was used, which is why the keyword model "
           "learned form labels such as 'name', 'email' and 'call back'.")

    keep = [c for c in [C.get("case"), C.get("turn"), C.get("turn_label"),
                        C.get("conv_label")] if c]
    R.csv(user[keep + ["_raw", "_issue", "_clean"]].head(1500),
          "p2_05_before_after_sample.csv")
    return user, fields, payload


