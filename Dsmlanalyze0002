        {"metric": "distinct messages", "value": int(df["_text"].nunique())},
        {"metric": "duplicated rows %",
         "value": round(100.0 * df["_text"].duplicated(keep=False).mean(), 2)}])
    R.csv(T, "p1_07_text_facts.csv")
    R.table(T)
    if C.get("role"):
        order = (df.groupby("_role")["_text"].apply(lambda x: x.str.len().median())
                 .sort_values().index)
        fig, ax = plt.subplots(figsize=(9, 3.4))
        ax.boxplot([df.loc[df["_role"] == r, "_text"].str.len().values for r in order],
                   tick_labels=[str(r)[:14] for r in order], showfliers=False,
                   patch_artist=True,
                   boxprops=dict(facecolor="#bee3f8", edgecolor="#2b6cb0"),
                   medianprops=dict(color="#c05621", linewidth=2))
        ax.set_ylabel("characters")
        ax.set_title("Message length by role", loc="left", fontweight="600")
        R.fig(fig, "User messages are short problem statements; assistant "
                   "messages are long analyses. Two different populations.")

    log("  1.6 association")
    if C.get("turn_label"):
        R.h("1.6 Which columns relate to the label", 3)
        y = df[C["turn_label"]].fillna("__blank__").astype(str)
        rows = []
        for c in df.columns:
            if c == C["turn_label"]:
                continue
            nun = df[c].fillna("_").nunique()
            if nun < 2 or nun > 400:
                continue
            a = df[c].fillna("__blank__").astype(str)
            if a.nunique() > 200:
                a = a.where(a.isin(a.value_counts().head(200).index), "__other__")
            rows.append({"column": c, "cramers_v": round(cramers_v(a, y), 4),
