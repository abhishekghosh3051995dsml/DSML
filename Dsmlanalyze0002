# PHASE 3  EDA + PCA
# =============================================================================

def phase3(user, C, R, stopwords, seed):
    log("\n=== PHASE 3  EDA + PCA ===")
    R.h("Phase 3 · EDA and PCA — is the label learnable from the text?")

    vec = TfidfVectorizer(max_features=60000, ngram_range=(1, 2), min_df=3,
                          max_df=0.6, stop_words=list(stopwords),
                          sublinear_tf=True)
    Xs = vec.fit_transform(user["_clean"])
    log(f"  TF-IDF {Xs.shape}")
    k = int(min(200, Xs.shape[1] - 1, max(2, Xs.shape[0] - 1)))
    svd = TruncatedSVD(n_components=k, random_state=seed)
    Xd = svd.fit_transform(Xs)
    R.p(f"Vectorised to {Xs.shape[1]:,} TF-IDF features, compressed to {k} "
        f"components holding {svd.explained_variance_ratio_.sum():.1%} of the "
        f"variance.")
    prov("tfidf_vocabulary", Xs.shape[1], "DERIVED", "learned from this corpus")
    prov("svd_components", k, "REVIEW_GATE",
         "extraction width; retention decided by the criteria below")

    Z = StandardScaler().fit_transform(Xd)
    npc = int(min(30, Z.shape[1]))
    pca = PCA(n_components=npc, random_state=seed)
    P = pca.fit_transform(Z)
    ev = pca.explained_variance_ratio_
    scree = pd.DataFrame({"component": range(1, npc + 1),
                          "eigenvalue": np.round(pca.explained_variance_, 4),
                          "explained_variance_ratio": np.round(ev, 5),
                          "cumulative": np.round(np.cumsum(ev), 5)})
    scree["kaiser_retain"] = scree["eigenvalue"] > 1.0
    R.csv(scree, "p3_01_pca_scree.csv")
    n90 = int((scree["cumulative"] < 0.90).sum()) + 1
    prov("pca_components_kaiser", int(scree["kaiser_retain"].sum()), "DERIVED",
         "eigenvalue > 1")
    prov("pca_components_for_90pct", n90, "DERIVED", "cumulative variance")

    lab = C.get("turn_label")
    fig, axes = plt.subplots(1, 2, figsize=(12, 3.9))
    axes[0].bar(range(1, npc + 1), ev, color=PALETTE[0])
    axes[0].plot(range(1, npc + 1), np.cumsum(ev), color=PALETTE[1], marker="o",
                 markersize=3)
    axes[0].axhline(0.9, color="#a0aec0", linestyle="--", linewidth=1)
    axes[0].set_xlabel("component")
    axes[0].set_ylabel("explained variance")
    axes[0].set_title("scree (dashed = 90%)", loc="left", fontsize=10)
    if lab:
        y = user[lab].fillna("__blank__").astype(str)
        for i, u in enumerate(y.value_counts().head(8).index):
            m = (y == u).values
            axes[1].scatter(P[m, 0], P[m, 1], s=7, alpha=0.4,
                            color=PALETTE[i % len(PALETTE)], label=str(u)[:18])
        axes[1].legend(fontsize=7, markerscale=1.8, frameon=False)
        axes[1].set_title("PC1 vs PC2, coloured by label", loc="left", fontsize=10)
    axes[1].set_xlabel("PC1")
    axes[1].set_ylabel("PC2")
    R.fig(fig, "If the colours separate, the labels are learnable from the text. "
               "If they overlap completely, the taxonomy is the problem, not the "
               "model.")
    R.p(f"{int(scree['kaiser_retain'].sum())} components have eigenvalue > 1 "
        f"(Kaiser criterion); {n90} are needed for 90% of the variance.")

    if lab:
        y = user[lab].fillna("__blank__").astype(str).values
        rows = []
        for i in range(min(10, P.shape[1])):
            s = pd.Series(P[:, i])
            g = s.groupby(y)
            between, within = float(g.mean().var()), float(g.var().mean())
            rows.append({"component": f"PC{i+1}",
                         "between_group_var": round(between, 5),
                         "within_group_var": round(within, 5),
                         "fisher_ratio": round(between / within, 5) if within else None})
        FR = pd.DataFrame(rows).sort_values("fisher_ratio", ascending=False)
        FR["reads_as"] = np.where(FR["fisher_ratio"].fillna(0) > 0.1,
                                  "carries real class structure",
                                  "mostly within-class noise")
        R.csv(FR, "p3_02_pca_fisher_ratio.csv")
        R.h("Does any component separate the classes?", 3)
        R.table(FR)
        best = float(FR["fisher_ratio"].max() or 0)
        if best < 0.1:
            R.warn("No principal component separates the classes. The label is "
                   "not expressible as a direction in this representation — "
                   "expect weak linear performance and treat the taxonomy itself "
                   "as suspect.")
            finding("MEDIUM", "No component separates the classes",
                    f"best Fisher ratio {best:.3f}",
                    "Prioritise SME review of the taxonomy over model tuning.")
    return Xs, Xd, vec


# =============================================================================
# PHASE 4  CLUSTERING  (deduplicated, multi-criterion)
# =============================================================================

def phase4(user, C, R, stopwords, max_k, seed):
    log("\n=== PHASE 4  CLUSTERING ===")
    R.h("Phase 4 · Clustering — what customers actually talk about")

    # Deduplicate first. In v1 one sentence repeated 112 times became its own
    # cluster; that is a duplicate, not a topic. Weights keep the frequency
    # information without letting it dominate the geometry.
    grp = (user.groupby("_clean").size().rename("weight").reset_index())
    grp = grp[grp["_clean"].str.len() >= 8]
    R.p(f"{len(user):,} user messages collapse to {len(grp):,} distinct problem "
        f"statements. Clustering runs on the distinct texts with frequency "
        f"weights, so a single repeated sentence cannot form its own cluster.")
    prov("dedup_distinct_texts", len(grp), "DERIVED", "unique cleaned statements")
    if len(grp) < 40:
        R.warn("Too few distinct statements to cluster meaningfully.")
        return user

    vec = TfidfVectorizer(max_features=40000, ngram_range=(1, 2), min_df=2,
                          max_df=0.6, stop_words=list(stopwords), sublinear_tf=True)
    S = vec.fit_transform(grp["_clean"])
    kk = int(min(120, S.shape[1] - 1, max(2, S.shape[0] - 1)))
    D = TruncatedSVD(n_components=kk, random_state=seed).fit_transform(S)

    hi = max(3, min(max_k, len(grp) // 30))
    rows, models = [], {}
    for k in range(2, hi + 1):
        km = KMeans(n_clusters=k, random_state=seed, n_init=6).fit(D)
        try:
            sil = silhouette_score(D, km.labels_, sample_size=min(4000, len(D)),
                                   random_state=seed)
            ch = calinski_harabasz_score(D, km.labels_)
            db = davies_bouldin_score(D, km.labels_)
        except Exception:
            continue
        rows.append({"k": k, "silhouette": round(float(sil), 4),
                     "calinski_harabasz": round(float(ch), 1),
                     "davies_bouldin": round(float(db), 4)})
        models[k] = km
    SC = pd.DataFrame(rows)
    if SC.empty:
        R.warn("Cluster quality could not be computed.")
        return user
    R.csv(SC, "p4_01_cluster_quality_by_k.csv")

    # three independent criteria; agreement between them is the real evidence
    k_sil = int(SC.loc[SC["silhouette"].idxmax(), "k"])
    k_ch = int(SC.loc[SC["calinski_harabasz"].idxmax(), "k"])
    k_db = int(SC.loc[SC["davies_bouldin"].idxmin(), "k"])
    votes = Counter([k_sil, k_ch, k_db])
    k_best = votes.most_common(1)[0][0]
    prov("k_selected", k_best, "DERIVED",
         f"majority of three criteria: silhouette={k_sil}, "
         f"Calinski-Harabasz={k_ch}, Davies-Bouldin={k_db}")

    fig, axes = plt.subplots(1, 3, figsize=(13, 3.2))
    for ax, col, ttl, best in [
            (axes[0], "silhouette", "silhouette (higher better)", k_sil),
            (axes[1], "calinski_harabasz", "Calinski-Harabasz (higher better)", k_ch),
            (axes[2], "davies_bouldin", "Davies-Bouldin (lower better)", k_db)]:
        ax.plot(SC["k"], SC[col], marker="o", markersize=3, color=PALETTE[0])
        ax.axvline(best, color=PALETTE[1], linestyle="--", linewidth=1)
        ax.set_xlabel("k")
        ax.set_title(ttl, loc="left", fontsize=9)
    R.fig(fig, "Three independent measures of cluster quality. Where they agree, "
               "the structure is real; where they disagree, it is weak.")
    R.table(SC)
    R.p(f"Selected k = {k_best}. Silhouette prefers {k_sil}, "
        f"Calinski-Harabasz prefers {k_ch}, Davies-Bouldin prefers {k_db}.")

    sil_best = float(SC["silhouette"].max())
    if sil_best < 0.25:
        R.warn(f"Peak silhouette is only {sil_best:.3f}. The problem statements "
               f"do not form well-separated groups in this representation — the "
               f"clusters below are weak and should be read as suggestive, not "
               f"as a taxonomy. Sentence embeddings would likely separate this "
               f"text better than TF-IDF.")
        finding("MEDIUM", "Weak cluster separation",
                f"peak silhouette {sil_best:.3f} at k={k_sil}",
                "Re-run with sentence embeddings before treating clusters as "
                "an intent taxonomy.")

    km = models[k_best]
    grp["_cluster"] = km.labels_

    # name the clusters with c-TF-IDF
    terms = np.array(vec.get_feature_names_out())
    rows = []
    for c in sorted(set(km.labels_)):
        m = (km.labels_ == c)
        inside = np.asarray(S[m].mean(axis=0)).ravel()
        outside = np.asarray(S[~m].mean(axis=0)).ravel()
        idx = (inside - outside).argsort()[::-1][:12]
        ex = grp.loc[m].sort_values("weight", ascending=False)["_clean"].head(3).tolist()
        rows.append({"cluster": int(c),
                     "distinct_statements": int(m.sum()),
                     "messages": int(grp.loc[m, "weight"].sum()),
                     "pct_of_messages": round(100.0 * grp.loc[m, "weight"].sum()
                                              / grp["weight"].sum(), 2),
                     "top_terms": ", ".join(terms[idx]),
                     "example_1": (ex[0][:150] if ex else ""),
                     "example_2": (ex[1][:150] if len(ex) > 1 else ""),
                     "example_3": (ex[2][:150] if len(ex) > 2 else "")})
    CT = pd.DataFrame(rows).sort_values("messages", ascending=False)
    R.csv(CT, "p4_02_cluster_terms.csv")
    R.h("What each cluster is about", 3)
    R.table(CT, max_rows=40)
    R.note("Cluster names come from c-TF-IDF: the words that make a cluster "
           "different from every other cluster, not simply its most common "
           "words. An SME reads this table and names each cluster — that is the "
           "detailed-intent layer, discovered rather than invented.")

    # map back to messages
    user = user.merge(grp[["_clean", "_cluster"]], on="_clean", how="left")

    lab = C.get("turn_label")
    if lab:
        y = user[lab].fillna("__unlabelled__").astype(str)
        ct = pd.crosstab(user["_cluster"], y)
        keep = ct.sum(axis=1).sort_values(ascending=False).head(40).index
        ct = ct.loc[keep]
        rn = ct.div(ct.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
        R.h("Cluster × intent heat map", 3)
        R.fig(heat(rn.values, list(ct.columns),
                   [f"cluster {int(i)}" for i in ct.index],
                   "Cluster (rows) × intent (columns), row-normalised",
                   "share of cluster", cmap="YlGnBu"))
        R.csv(ct.reset_index(), "p4_03_cluster_x_intent.csv")

        pur = pd.DataFrame({"cluster": ct.index, "messages": ct.sum(axis=1).values,
                            "dominant_intent": rn.idxmax(axis=1).values,
                            "purity": rn.max(axis=1).round(3).values})
        base = float(y.value_counts(normalize=True).max())
        pur["lift_over_base_rate"] = (pur["purity"] - base).round(3)
        pur["reads_as"] = np.where(
            pur["lift_over_base_rate"] > 0.15,
            "informative — this cluster really is mostly one intent",
            np.where(pur["lift_over_base_rate"] > 0.05, "mildly informative",
                     "no better than guessing the majority class"))
        R.csv(pur.sort_values("messages", ascending=False), "p4_04_cluster_purity.csv")
        R.h("Cluster purity, compared against the base rate", 3)
        R.table(pur.sort_values("messages", ascending=False), max_rows=40)
        R.note(f"The majority class is {100 * base:.1f}% of messages, so a "
               f"cluster with purity below that is telling us nothing. The lift "
               f"column is the honest measure — purity minus the base rate.")
        prov("majority_class_base_rate", round(base, 4), "DERIVED",
             "share of the most common label")
    R.csv(user[[c for c in [C.get("case"), C.get("turn"), lab, "_clean", "_cluster"]
                if c]], "p4_05_messages_with_clusters.csv")
    return user


# =============================================================================
# PHASE 5  TURN INTENT -> CONVERSATION INTENT
# =============================================================================

def phase5(user, C, R):
    log("\n=== PHASE 5  TURN -> CONVERSATION INTENT ===")
    R.h("Phase 5 · From per-message intent to conversation intent")
    lab, case, conv = C.get("turn_label"), C.get("case"), C.get("conv_label")
    if not (lab and case):
        R.warn("Needs both a per-message label and a case key. Skipped.")
        return

    u = user[user[lab].fillna("").astype(str).str.strip() != ""].copy()
    u = u.sort_values([case, "_turn"])
    seqs, verdicts = [], []
    for _, g in u.groupby(case):
        seqs.append(list(g[lab].astype(str)))
        if conv:
            v = g[conv].dropna().astype(str)
            verdicts.append(v.iloc[0] if len(v) else None)
        else:
            verdicts.append(None)

    multi = [s for s in seqs if len(s) > 1]
    changed = [s for s in multi if len(set(s)) > 1]
    change_rate = len(changed) / max(len(multi), 1)

    labs = sorted({x for s in seqs for x in s})
    M = np.zeros((len(labs), len(labs)))
    li = {l: i for i, l in enumerate(labs)}
    for s in seqs:
        for a, b in zip(s, s[1:]):
            M[li[a], li[b]] += 1
    rs = M.sum(axis=1, keepdims=True)
    P = np.divide(M, rs, out=np.zeros_like(M), where=rs > 0)
    R.h("How intent moves through a conversation", 3)
    R.fig(heat(P, labs, labs, "Intent at message t (rows) → message t+1 (columns)",
               "probability", cmap="Blues"))
    R.csv(pd.DataFrame(M, index=labs, columns=labs).reset_index()
          .rename(columns={"index": "from\\to"}), "p5_01_transition_counts.csv")

    R.p(f"{len(seqs):,} conversations have at least one labelled user message. "
        f"{len(multi):,} have more than one. Of those, {len(changed):,} "
        f"({100 * change_rate:.1f}%) change intent during the conversation.")

    if change_rate == 0 and len(multi) > 0:
        R.warn("THE INTENT NEVER CHANGES WITHIN A CONVERSATION. Every labelled "
               "message in a conversation carries the same value. That means "
               "the per-message label is the CONVERSATION label copied down onto "
               "the messages — it is not an independent per-message judgement. "
               "Two consequences: (1) we do not actually have two label sources, "
               "we have one; (2) the rule test below is arithmetic, not a "
               "finding, because when every message shares a label, first / "
               "last / majority all return the same answer by construction.")
        finding("HIGH", "Per-message label does not vary within a conversation",
                f"{len(multi)} multi-message conversations, 0 with any change.",
                "Ask the data owner whether the per-message label is generated "
                "per message or inherited from the case. If inherited, a "
                "genuine per-message target must be created before "
                "message-level modelling means anything.")
    elif changed:
        J = pd.DataFrame(Counter(" → ".join(s) for s in changed).most_common(20),
                         columns=["journey", "conversations"])
        R.csv(J, "p5_02_intent_journeys.csv")
        R.h("Most common intent journeys", 3)
        R.table(J)
        R.ok("Intent does change within conversations — the evidence for "
             "modelling the conversation as a sequence rather than a single "
             "label.")

    if conv and any(v is not None for v in verdicts):
        pairs = [(s, v) for s, v in zip(seqs, verdicts) if v is not None]
        cnt = Counter()
        for s, _ in pairs:
            cnt.update(s)
        rarity = {k: i for i, (k, _) in enumerate(sorted(cnt.items(),
                                                         key=lambda kv: kv[1]))}
        rules = {"first_message": lambda s: s[0],
                 "last_message": lambda s: s[-1],
                 "majority_vote": lambda s: Counter(s).most_common(1)[0][0],
                 "rarest_class_wins": lambda s: min(s, key=lambda x: rarity.get(x, 1e9))}
        rows = []
        for name, fn in rules.items():
            ok = [fn(s) == v for s, v in pairs]
            rows.append({"rule": name, "conversations": len(ok),
                         "agreement_pct": round(100.0 * np.mean(ok), 2)})
        RU = pd.DataFrame(rows).sort_values("agreement_pct", ascending=False)
        R.csv(RU, "p5_03_global_intent_rules.csv")
        R.h("Is the conversation label just a rule over the messages?", 3)
        R.fig(barh(RU["rule"].tolist(), RU["agreement_pct"].values,
                   "% agreement with the conversation label",
                   "Do simple rules reproduce the conversation verdict?",
                   color=PALETTE[2]))
        R.table(RU)
        spread = float(RU["agreement_pct"].max() - RU["agreement_pct"].min())
        if change_rate == 0:
            R.warn("All rules score identically because the label never varies "
                   "within a conversation. This table is VACUOUS on this export "
                   "and must not be reported as evidence that a rule was "
                   "discovered.")
        elif spread < 1.0:
            R.warn("All rules score within one point of each other, so this test "
                   "does not distinguish between them.")
        else:
            best = RU.iloc[0]
            R.ok(f"'{best['rule']}' reproduces the conversation label "
                 f"{best['agreement_pct']}% of the time, clearly ahead of the "
                 f"alternatives. Implement that rule rather than training a "
                 f"second model.")


# =============================================================================
# PHASE 6  TWO LABEL SETS
# =============================================================================

def build_rules(texts, labels, stopwords, min_z=2.5, top_n=40):
    KW = weighted_log_odds(texts, labels, stopwords, top_n=top_n)
    if KW.empty:
        return {}
    KW = KW[KW["z_score"] >= min_z]
    r = defaultdict(dict)
    for _, x in KW.iterrows():
        r[x["class"]][x["keyword"]] = float(x["z_score"])
    return dict(r)


def apply_rules(texts, rules):
    classes = sorted(rules.keys())
    preds, confs = [], []
    for t in texts:
        toks = set(re.findall(r"[a-z][a-z_\-]{2,}", str(t).lower()))
        sc = {c: sum(w for k, w in rules[c].items() if k in toks) for c in classes}
        tot = sum(sc.values())
        if tot <= 0:
            preds.append(None)
            confs.append(0.0)
            continue
        rk = sorted(sc.items(), key=lambda kv: kv[1], reverse=True)
        top = rk[0][1]
        second = rk[1][1] if len(rk) > 1 else 0.0
        preds.append(rk[0][0])
        confs.append(round((top - second) / tot, 4))
    return preds, confs


def phase6(user, C, R, stopwords, field_words, seed):
    log("\n=== PHASE 6  TWO LABEL SETS ===")
    R.h("Phase 6 · Two label sets, and whether they agree")
    lab = C.get("turn_label")
    if not lab:
        R.warn("No per-message label column. Skipped.")
        return

    u = user[user[lab].fillna("").astype(str).str.strip() != ""].copy()
    texts = u["_clean"].tolist()
    y1 = u[lab].astype(str).values

    R.note("The keyword vocabulary now excludes generic English words, words "
           "that appear as intake-form field labels in this corpus "
           f"({', '.join(field_words[:12])}{'…' if len(field_words) > 12 else ''}), "
           "and tokens above a derived frequency ceiling. In v1 these were not "
           "removed, so the top 'indicators' were 'can', 'what', 'the', 'name' "
           "and 'email' — the model was detecting which form a message used, "
           "not what the customer wanted.")

    pred = [None] * len(u)
    conf = [0.0] * len(u)
    vc = pd.Series(y1).value_counts()
    usable = vc[vc >= 5].index
    mask = np.array([v in usable for v in y1])
    idx = np.where(mask)[0]
    last_rules = {}
    if len(idx) >= 25 and len(usable) >= 2:
        skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=seed)
        Xa = np.array(texts, dtype=object)[idx]
        ya = y1[idx]
        for tr, te in skf.split(Xa, ya):
            rules = build_rules(Xa[tr], ya[tr], stopwords)
            if not rules:
                continue
            last_rules = rules
            p, c = apply_rules(Xa[te], rules)
            for j, kk in enumerate(te):
                pred[idx[kk]] = p[j]
                conf[idx[kk]] = c[j]
        prov("keyword_rule_cv_folds", 5, "REVIEW_GATE",
             "out-of-fold so agreement is a measurement, not a tautology")

    u["_label_excel"] = y1
    u["_label_keyword"] = pred
    u["_confidence"] = conf

    if last_rules:
        RB = pd.DataFrame([{"class": c, "keyword": k, "weight": round(w, 3)}
                           for c, d in last_rules.items()
                           for k, w in sorted(d.items(), key=lambda kv: -kv[1])])
        R.csv(RB, "p6_01_keyword_rule_block.csv")
        R.h("The keyword rule block, learned from the data", 3)
        R.table(RB.groupby("class").head(14), max_rows=70)
        for i, cls in enumerate(sorted(last_rules)):
            d = sorted(last_rules[cls].items(), key=lambda kv: -kv[1])[:12]
            if d:
                R.fig(barh([k for k, _ in d], [w for _, w in d],
                           "z-score (higher = stronger indicator)",
                           f"Keywords indicating '{cls}'",
                           color=PALETTE[i % len(PALETTE)]))

    covered = u["_label_keyword"].notna()
    R.p(f"The rule block reaches a decision on {int(covered.sum()):,} of "
        f"{len(u):,} labelled user messages ({100.0 * covered.mean():.1f}%). "
        f"The rest contain none of the learned keywords — an honest abstention "
        f"rather than a forced guess.")

    both = u[covered]
    if len(both):
        agree = float((both["_label_excel"] == both["_label_keyword"]).mean())
        kap = cohens_kappa(both["_label_excel"], both["_label_keyword"])
        base = float(both["_label_excel"].value_counts(normalize=True).max())
        K = pd.DataFrame([{"compared_messages": len(both),
                           "raw_agreement_pct": round(100 * agree, 2),
                           "majority_class_base_rate_pct": round(100 * base, 2),
                           "cohens_kappa": kap,
                           "reads_as": ("almost perfect" if (kap or 0) > .8 else
                                        "substantial" if (kap or 0) > .6 else
                                        "moderate" if (kap or 0) > .4 else
                                        "fair" if (kap or 0) > .2 else "poor")}])
        R.csv(K, "p6_02_agreement.csv")
        R.h("Agreement between the two label sets", 3)
        R.table(K)
        R.note("Cohen's kappa corrects for the agreement two labellers would "
               "reach by chance. Raw agreement always flatters an imbalanced "
               "problem; kappa does not. Compare the raw figure against the "
               "majority base rate in the same row.")

        labs = sorted(set(both["_label_excel"]) | set(both["_label_keyword"]))
        CM = (pd.crosstab(both["_label_excel"], both["_label_keyword"])
              .reindex(index=labs, columns=labs, fill_value=0))
        rn = CM.div(CM.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
        R.fig(heat(rn.values, labs, labs,
                   "Existing label (rows) vs keyword-derived label (columns)",
                   "share of row", cmap="Greens"),
              "The diagonal is agreement. Off-diagonal mass shows which intents "
              "the two methods confuse.")
        R.csv(CM.reset_index(), "p6_03_label_confusion.csv")

        dis = both[both["_label_excel"] != both["_label_keyword"]].copy()
        if len(dis):
            dis = dis.sort_values("_confidence", ascending=False)
            cols = [c for c in [C.get("case"), C.get("turn"), "_clean",
                                "_label_excel", "_label_keyword", "_confidence"] if c]
            R.csv(dis[cols].head(800), "p6_04_disagreements_for_sme_review.csv")
            R.h("Where the two label sets disagree, highest confidence first", 3)
            R.table(dis[["_clean", "_label_excel", "_label_keyword",
                         "_confidence"]].head(25))
            R.note("Sorted by confidence so the most clear-cut disagreements come "
                   "first. This file is the highest-value SME task in the "
                   "project: each row is a case where two independent methods "
                   "reached different conclusions.")

        b = both.copy()
        b["_ok"] = (b["_label_excel"] == b["_label_keyword"])
        try:
            b["_bin"] = pd.qcut(b["_confidence"], 5, duplicates="drop")
            cal = (b.groupby("_bin", observed=True)
                   .agg(messages=("_ok", "size"),
                        mean_confidence=("_confidence", "mean"),
                        agreement=("_ok", "mean")).reset_index())
            cal["_bin"] = cal["_bin"].astype(str)
            R.csv(cal.round(4), "p6_05_confidence_calibration.csv")
            fig, ax = plt.subplots(figsize=(7.5, 3.4))
            ax.plot(cal["mean_confidence"], cal["agreement"], marker="o",
                    color=PALETTE[1], label="observed")
            ax.axhline(base, color="#a0aec0", linestyle=":", linewidth=1,
                       label="majority base rate")
            ax.plot([0, 1], [0, 1], "--", color="#cbd5e0", linewidth=1,
                    label="perfect calibration")
            ax.set_xlabel("confidence (margin between winner and runner-up)")
            ax.set_ylabel("agreement with the existing label")
            ax.legend(fontsize=7, frameon=False)
            ax.set_title("Is the confidence score meaningful?", loc="left",
                         fontweight="600")
            R.fig(fig, "A rising line means confidence carries real information. "
                       "The fixed per-class confidence in the source export does "
                       "not — it is the same number for every row of a class.")
            if cal["agreement"].is_monotonic_increasing:
                R.ok("Confidence is monotonically informative: higher confidence "
                     "really does mean higher agreement. This is a usable "
                     "abstention threshold for production.")
        except Exception:
            pass

    R.csv(u[[c for c in [C.get("case"), C.get("turn"), "_clean", "_label_excel",
                         "_label_keyword", "_confidence"] if c]],
          "p6_06_both_label_sets.csv")


# =============================================================================
# PHASE 7  FINDINGS AND NEXT ACTIONS
# =============================================================================

def phase7(R):
    log("\n=== PHASE 7  FINDINGS ===")
    R.h("Phase 7 · Findings and recommended actions")
    if not FINDINGS:
        R.ok("No blocking issues detected in this run.")
        return
    F = pd.DataFrame(FINDINGS)
    order = {"HIGH": 0, "MEDIUM": 1, "INFO": 2}
    F["_o"] = F["severity"].map(order).fillna(3)
    F = F.sort_values("_o").drop(columns="_o")
    R.csv(F, "p7_01_findings.csv")
    R.table(F, max_rows=40)
    R.note("Severity HIGH means a number from this run should not be reported "
           "until the issue is resolved. MEDIUM means the analysis stands but "
           "the interpretation is constrained. INFO is context.")


# =============================================================================
# MAIN
# =============================================================================

def main():
    ap = argparse.ArgumentParser(
        description="NORA intent analysis v2 — data analysis then data science")
    ap.add_argument("--input", required=True)
    ap.add_argument("--outdir", default="nora_out_v2")
    ap.add_argument("--salt-file", default="nora_salt.txt")
    ap.add_argument("--max-k", type=int, default=30)
    ap.add_argument("--sample", type=int, default=0)
    ap.add_argument("--chunksize", type=int, default=200000)
    ap.add_argument("--seed", type=int, default=42)
    args = ap.parse_args()

    log("=" * 74)
    log("NORA INTENT ANALYSIS  v2")
    log("=" * 74)
    log(f"reading {args.input}")

    reader = pd.read_csv(args.input, low_memory=False, dtype=str,
                         keep_default_na=False,
                         na_values=["", "NA", "NaN", "null", "None", "nan"],
                         chunksize=args.chunksize)
    df = pd.concat([c for c in reader], ignore_index=True)
    log(f"  {len(df):,} rows x {len(df.columns)} columns")
    if args.sample and args.sample < len(df):
        df = df.sample(args.sample, random_state=args.seed).reset_index(drop=True)
        log(f"  sampled to {len(df):,}")

    C = discover_columns(df)
    log("  discovered columns:")
    for k, v in C.items():
        log(f"    {k:<12} -> {v}")
    if not C.get("text"):
        raise SystemExit("BLOCKED: no message-content column found. Check the "
                         "header row of the CSV.")

    R = Report(args.outdir, "NORA Intent Analysis · v2")
    R.p(f"Source: {os.path.basename(args.input)} — {len(df):,} rows, "
        f"{len(df.columns)} columns.")
    R.note("X is the customer's problem statement extracted from user messages. "
           "y_turn is the per-message label; y_global is the conversation "
           "label. Assistant messages are excluded from X because they contain "
           "NORA's answer.")

    salt = load_salt(args.salt_file)
    masker = Masker(salt)

    df["_raw"] = (df[C["text"]].fillna("").astype(str)
                  .str.replace(r"\\r", " ", regex=True)
                  .str.replace(r"\\n", "\n", regex=True))
    df["_text"] = df["_raw"].str.replace(r"\s+", " ", regex=True).str.strip() \
                            .map(masker.mask_span)
    df["_role"] = (df[C["role"]].fillna("unknown").astype(str).str.strip().str.lower()
                   if C.get("role") else "unknown")
    df["_turn"] = (pd.to_numeric(df[C["turn"]], errors="coerce")
                   if C.get("turn") else np.arange(len(df)))

    df = phase1(df, C, R)
    user, fields, payload = phase2(df, C, R, masker)

    stopwords, field_words, over = build_stopwords(user["_clean"], fields)
    R.h("Vocabulary control", 3)
    R.csv(pd.DataFrame({"excluded_token": sorted(stopwords)}),
          "p2_06_stopwords_used.csv")
    R.p(f"{len(stopwords):,} tokens excluded from keyword learning: generic "
        f"English function words, {len(field_words)} words that appear as "
        f"intake-form field labels in this corpus, and {len(over)} tokens above "
        f"the derived frequency ceiling.")

    Xs, Xd, vec = phase3(user, C, R, stopwords, args.seed)
    user = phase4(user, C, R, stopwords, args.max_k, args.seed)
    phase5(user, C, R)
    phase6(user, C, R, stopwords, field_words, args.seed)
    phase7(R)

    PR = pd.DataFrame(PROVENANCE)
    R.csv(PR, "provenance_register.csv")
    R.h("Provenance of every constant used", 2)
    R.table(PR, max_rows=60)
    R.note("DERIVED means computed from this dataset at runtime. DOMAIN_FACT "
           "means a fact about telecoms or an external contract, not an "
           "assumption about the data. REVIEW_GATE means a convention that only "
           "decides what gets flagged for a human; it never alters a computed "
           "value.")

    html = os.path.join(args.outdir, "nora_report_v2.html")
    R.save(html)
    json.dump({"input": os.path.abspath(args.input), "rows": int(len(df)),
               "columns": list(df.columns), "roles": C,
               "template_fields": fields, "payload_field": payload,
               "findings": FINDINGS, "provenance": PROVENANCE},
              open(os.path.join(args.outdir, "run_manifest.json"), "w"), indent=2)

    log("\n" + "=" * 74)
    log("DONE")
    log("=" * 74)
    for f in sorted(FINDINGS, key=lambda x: {"HIGH": 0, "MEDIUM": 1}.get(x["severity"], 2)):
        log(f"  [{f['severity']}] {f['finding']}")
    log(f"\n  report : {os.path.abspath(html)}")
    log(f"  tables : {os.path.abspath(args.outdir)}")
    log(f"  salt   : {os.path.abspath(args.salt_file)}   (keep out of OneDrive)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
