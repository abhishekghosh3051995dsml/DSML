            R.csv(A, "p1_08_association_with_label.csv")
            R.table(A)
            R.fig(barh(A.head(12)["column"].tolist(),
                       A.head(12)["cramers_v"].fillna(0).values,
                       "Cramér's V", "Association with the per-message label",
                       color=PALETTE[3]))
            R.note("Cramér's V comes from the chi-square test of independence and "
                   "runs 0 to 1. Near 1 means that column already contains the "
                   "answer. Theil's U is asymmetric, so it also shows the "
                   "direction of the dependence.")
    return df


