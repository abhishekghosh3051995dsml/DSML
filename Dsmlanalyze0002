                ax.set_yscale("log")
            ax.set_xticks(range(len(d)))
            ax.set_xticklabels(d["class"].str.slice(0, 16), rotation=25, ha="right")
            ax.set_title(ttl, loc="left", fontsize=10)
        R.fig(fig)
