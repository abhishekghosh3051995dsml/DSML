def find(cols, patterns, exclude=()):
    for pat in patterns:
        for c in cols:
            n = re.sub(r"[^a-z0-9]+", "_", str(c).lower())
            if any(re.search(e, n) for e in exclude):
                continue
            if re.search(pat, n):
                return c
    return None


def discover_columns(df):
    c = list(df.columns)
    roles = {
        "case":       find(c, [r"^source_row$", r"source.*row", r"^row_?id$"]),
        "turn":       find(c, [r"message_index", r"turn.*index", r"^index$", r"^seq"]),
        "conv_label": find(c, [r"classification.*intent", r"case.*intent",
                               r"conversation.*intent"]),
        "cid":        find(c, [r"data_cid$", r"(^|_)cid$", r"conversation.*id"]),
        "text":       find(c, [r"data_content$", r"content$", r"message.*text",
                               r"^text$", r"utterance"]),
        "predicted":  find(c, [r"intent_predicted", r"predicted"]),
        "turn_label": find(c, [r"data_label$", r"(^|_)label$", r"turn.*intent"],
                           exclude=[r"predicted"]),
        "role":       find(c, [r"^message_type$", r"message_type$", r"data_type$",
                               r"^role$", r"speaker"]),
        "timestamp":  find(c, [r"time_?stamp", r"_ts$", r"created", r"^date"]),
    }
    # role column must actually look like a role: few values, textual
    rc = roles.get("role")
    if rc and df[rc].nunique() > 12:
        roles["role"] = None
    return roles


# =============================================================================
# 2  TEMPLATE FIELD DISCOVERY   *** the core new capability ***
# =============================================================================
# A large share of NORA's user turns are not free text at all - they are an
# intake form pasted into the message:
#
#     Customer Name: ...
#     BAN: ...
#     IMEI: ...
#     CALL BACK NUMBER: ...
#     # WITH ISSUE: ...
#     EMAIL: ...
#     ISSUES: <the actual customer problem>
#
# Treating that whole blob as "the customer's words" is what made v1 learn the
# form instead of the fault. So we discover the form, split it into fields, and
# identify which field carries the free-text payload.
#
# Nothing about the form is hardcoded. Field labels are found by pattern, ranked
# by document frequency, and promoted above a cutoff derived from the frequency
# curve. The payload field is chosen as the promoted field with the greatest
# median length and lexical variety - i.e. the one that behaves like prose while
# the others behave like identifiers.

FIELD_LINE_RE = re.compile(
    r"(?m)^[ \t\-\*#>]*"
    r"(?P<key>[A-Za-z][A-Za-z0-9 _\-/#\.]{1,44}?)"
    r"\s*:\s*"
    r"(?P<val>.*)$")

MD_HEADER_RE = re.compile(r"(?m)^\s{0,3}#{1,6}\s*(?P<key>[^\n#]{2,60})\s*$")


def norm_key(k):
    return re.sub(r"[^a-z0-9]+", "_", str(k).strip().lower()).strip("_")


def knee_cutoff(values, floor=0.0):
    """Largest drop in the log-frequency curve. Derived, never assumed."""
    v = np.sort(np.asarray(values, dtype=float))[::-1]
    v = v[v > 0]
    if len(v) < 4:
        return float(v.min()) if len(v) else floor
    drops = np.diff(np.log(v + 1e-9))
    knee = int(np.argmin(drops)) + 1
    return max(float(v[min(knee, len(v) - 1)]), floor)


def discover_template(texts, sample=8000, seed=42):
    """Returns (promoted_field_keys, payload_key, report_dataframe)."""
    s = pd.Series(texts).dropna().astype(str)
    s = s[s.str.strip() != ""]
    if s.empty:
        return [], None, pd.DataFrame()
    take = s.sample(min(sample, len(s)), random_state=seed)
    n = len(take)

    docs = Counter()
    vals = defaultdict(list)
    for t in take:
        seen = set()
        for m in FIELD_LINE_RE.finditer(t):
            k = norm_key(m.group("key"))
            if not k or len(k) < 2 or k.isdigit():
                continue
            if k not in seen:
                docs[k] += 1
                seen.add(k)
            v = m.group("val").strip()
            if len(vals[k]) < 4000:
                vals[k].append(v)
        for m in MD_HEADER_RE.finditer(t):
            k = "hdr_" + norm_key(m.group("key"))
            if k not in seen:
                docs[k] += 1
                seen.add(k)

    if not docs:
        return [], None, pd.DataFrame()

    rows = []
    for k, d in docs.items():
        vv = [x for x in vals.get(k, []) if x]
        lens = [len(x) for x in vv] or [0]
        words = [len(x.split()) for x in vv] or [0]
        uniq = len(set(vv)) / max(len(vv), 1)
        rows.append({
            "field": k, "doc_count": d,
            "coverage_pct": round(100.0 * d / n, 2),
            "median_chars": float(np.median(lens)),
            "median_words": float(np.median(words)),
            "distinct_ratio": round(uniq, 3),
            "example": (vv[0][:120] if vv else ""),
        })
    R = pd.DataFrame(rows).sort_values("coverage_pct", ascending=False)

    cut = knee_cutoff(R["coverage_pct"].values, floor=1.0)
    prov("template_field_coverage_cutoff", round(cut, 3), "DERIVED",
         "knee of the field document-frequency curve")
    R["promoted"] = R["coverage_pct"] >= cut

    promoted = R[R["promoted"]]
    payload = None
    if len(promoted):
        # The payload is the promoted field that (a) is not an identifier field
        # by its key, and (b) behaves like prose rather than like a value.
        # Selecting on median word count rather than on distinct ratio matters:
        # a support corpus repeats the same complaint constantly, so a low
        # distinct ratio is normal for the payload and must not disqualify it.
        cand = promoted[promoted["field"].map(lambda k: field_kind(k) is None)]
        cand = cand[cand["median_words"] >= 3]
        if len(cand):
            payload = cand.sort_values("median_words", ascending=False)["field"].iloc[0]
        elif len(promoted):
            nonid = promoted[promoted["field"].map(lambda k: field_kind(k) is None)]
            if len(nonid):
                payload = nonid.sort_values("median_chars",
                                            ascending=False)["field"].iloc[0]
    R["is_payload"] = R["field"] == payload
    return list(promoted["field"]), payload, R


def split_fields(text):
    """Parse one message into {field_key: value} plus the unmatched remainder."""
    if not isinstance(text, str) or not text:
        return {}, ""
    fields, spans = {}, []
    for m in FIELD_LINE_RE.finditer(text):
        k = norm_key(m.group("key"))
        if not k or len(k) < 2:
            continue
        fields.setdefault(k, m.group("val").strip())
        spans.append((m.start(), m.end()))
    if not spans:
        return {}, text
    rest, prev = [], 0
    for a, b in spans:
        rest.append(text[prev:a])
        prev = b
    rest.append(text[prev:])
    return fields, re.sub(r"\s+", " ", " ".join(rest)).strip()


# =============================================================================
# 3  PII MASKING   *** field-aware, fixes the v1 leak ***
# =============================================================================
# v1 masked the raw blob and its NAME rule consumed the following field label.
# v2 masks per field, so a value can never run into the next field. Free text
# still gets span masking, but the greedy name rule is gone: names are taken
# from the parsed field values, which are bounded by construction.

PII_PATTERNS = [
    ("EMAIL",  re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b")),
    ("IPV4",   re.compile(r"\b(?:(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\.){3}"
                          r"(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\b")),
    ("EID",    re.compile(r"\b[0-9a-fA-F]{32}\b")),
    ("ICCID",  re.compile(r"\b89\d{17,20}\b")),
    ("IMEI",   re.compile(r"\b\d{15,16}\b")),
    ("MSISDN", re.compile(r"(?<!\d)(?:\+?\d{1,3}[\s\-.]?)?\(?\d{3}\)?[\s\-.]?"
                          r"\d{3}[\s\-.]?\d{4}(?!\d)")),
    ("ACCTNUM", re.compile(r"(?<!\d)\d{9,12}(?!\d)")),
    ("LATLON", re.compile(r"(?<![\w.])-?\d{1,3}\.\d{4,}(?![\w.])")),
    ("ZIP",    re.compile(r"(?<!\d)\d{5}(?:-\d{4})?(?!\d)")),
    ("URL",    re.compile(r"https?://\S+")),
]

ADDRESS_RE = re.compile(
    r"\b\d{1,6}\s+(?:[A-Za-z0-9.'\-]+\s+){0,4}"
    r"(?:st|street|rd|road|ave|avenue|blvd|boulevard|ln|lane|dr|drive|ct|court|"
    r"way|pl|place|ter|terrace|pkwy|parkway|hwy|highway|cir|circle)\b\.?",
    re.IGNORECASE)

# Which parsed field keys hold which kind of identifier. Matched on the KEY, so
# it adapts to new form layouts without code changes.
FIELD_KIND_HINTS = [
    ("NAME",    r"(customer|contact|account|subscriber)?_?name"),
    ("EMAIL",   r"e_?mail"),
    ("MSISDN",  r"(phone|mobile|msisdn|call_?back|number_?with_issue|with_issue|"
                r"line|contact_?number)"),
    ("IMEI",    r"imei"),
    ("ICCID",   r"iccid|sim"),
    ("EID",     r"^eid$|euicc"),
    ("BAN",     r"^ban$|billing_?account|account_?number"),
    ("ADDRESS", r"address|street|location"),
]


def field_kind(key):
    for kind, pat in FIELD_KIND_HINTS:
        if re.search(pat, key):
            return kind
    return None


class Masker:
    def __init__(self, salt):
        self.salt = salt
        self.counts = Counter()

    def surrogate(self, kind, value):
        h = hmac.new(self.salt, f"{kind}|{value}".encode("utf-8", "ignore"),
                     hashlib.sha256).hexdigest()[:10]
        self.counts[kind] += 1
        return f"<{kind}_{h}>"

    def mask_span(self, text):
        """Span masking for free text. No name rule here - names come from
        parsed fields, which cannot overrun into the next field."""
        if not isinstance(text, str) or not text:
            return text
        s = ADDRESS_RE.sub(lambda m: self.surrogate("ADDRESS", m.group(0).lower()),
                           text)
        for kind, rx in PII_PATTERNS:
            s = rx.sub(lambda m, k=kind: self.surrogate(k, m.group(0)), s)
        return s

    def mask_field(self, key, value):
        """Whole-value masking for a parsed field, chosen by what the key says
        the field holds. Bounded by construction, so no bleed."""
        v = str(value or "").strip()
        if not v or v.upper() in {"N/A", "NA", "NONE", "NULL", "-"}:
            return v
        kind = field_kind(key)
        if kind:
            return self.surrogate(kind, v.lower())
        return self.mask_span(v)


def load_salt(path):
    if os.path.exists(path):
        with open(path) as f:
            v = f.read().strip()
        if v:
            return v.encode()
    v = secrets.token_hex(32)
    with open(path, "w") as f:
        f.write(v)
    try:
        os.chmod(path, 0o600)
    except Exception:
        pass
    log(f"    created salt file {path}  — KEEP OUT OF ONEDRIVE AND GIT")
    return v.encode()


RESIDUE = [
    ("residual_email", re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")),
    ("residual_9plus_digit_run", re.compile(r"(?<![\w>])\d{9,}(?![\w<])")),
    ("residual_ipv4", re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")),
