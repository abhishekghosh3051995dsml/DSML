# %%
# --- 9. does any axis relate to the existing label ----------------------------
if COL["label"]:
    lab = user[COL["label"]].fillna("").astype(str).str.strip()
    m = lab != ""
    rows = []
    for axis in axis_cols:
        ct = pd.crosstab(hits.loc[m, axis], lab[m])
        if ct.shape[0] < 2 or ct.shape[1] < 2:
            continue
        chi = ((ct - np.outer(ct.sum(1), ct.sum(0)) / ct.values.sum()) ** 2 /
               (np.outer(ct.sum(1), ct.sum(0)) / ct.values.sum())).values.sum()
        n = ct.values.sum()
        v = np.sqrt(chi / (n * (min(ct.shape) - 1)))
        share = ct.div(ct.sum(1), axis=0)
        rows.append({"axis": axis, "cramers_v": round(float(v), 4),
                     "present_top_class": share.loc[True].idxmax(),
                     "present_top_share": round(float(share.loc[True].max()), 3)})
    assoc = pd.DataFrame(rows).sort_values("cramers_v", ascending=False)
    assoc.to_csv(f"{OUTDIR}/09_axis_label_association.csv", index=False)
    print(assoc.to_string(index=False))

    fig, ax = plt.subplots(figsize=(8, .32 * len(assoc) + 1))
    y = np.arange(len(assoc))
    ax.barh(y, assoc["cramers_v"], color="#2b6cb0", height=.7)
    ax.set_yticks(y)
    ax.set_yticklabels(assoc["axis"])
    ax.invert_yaxis()
    ax.set_xlabel("Cramer's V against the existing label")
    ax.set_title("Which axes carry label signal", loc="left", fontweight="600")
    fig.savefig(f"{OUTDIR}/fig_axis_label_association.png", bbox_inches="tight")
    plt.close(fig)

