# --- 5. axis coverage ---------------------------------------------------------
# For each candidate axis, how many user messages contain at least one of its
# terms. This is the test of the manager's ten-slot list against real data.

def compile_axis(terms):
    pats = sorted(terms, key=len, reverse=True)
    return re.compile(r"(?<!\w)(?:" + "|".join(re.escape(p) for p in pats) + r")(?!\w)")


AXIS_RE = {a: compile_axis(v) for a, v in SEEDS.items()}
ACTOR_RE = {a: compile_axis(v) for a, v in ACTORS.items()}

hits = pd.DataFrame(index=user.index)
for axis, rx in AXIS_RE.items():
    hits[axis] = user["clean"].str.contains(rx, regex=True)
for actor, rx in ACTOR_RE.items():
    hits["actor_" + actor] = user["clean"].str.contains(rx, regex=True)

cov = (hits.mean() * 100).round(2).sort_values(ascending=False)
cov = cov.rename_axis("axis").reset_index(name="pct_of_user_messages")
cov["messages"] = [int(hits[a].sum()) for a in cov["axis"]]
cov["verdict"] = np.where(cov["pct_of_user_messages"] >= 20, "well supported",
                   np.where(cov["pct_of_user_messages"] >= 5, "thin", "not supported"))
cov.to_csv(f"{OUTDIR}/05_axis_coverage.csv", index=False)
print(cov.to_string(index=False))

fig, ax = plt.subplots(figsize=(8, .32 * len(cov) + 1))
y = np.arange(len(cov))
colors = ["#2f855a" if v == "well supported" else "#c05621" if v == "thin"
          else "#9b2c2c" for v in cov["verdict"]]
ax.barh(y, cov["pct_of_user_messages"], color=colors, height=.7)
ax.set_yticks(y)
ax.set_yticklabels(cov["axis"])
ax.invert_yaxis()
ax.set_xlabel("% of user messages containing at least one term")
ax.set_title("Which entity axes the data actually supports", loc="left",
             fontweight="600")
for i, v in enumerate(cov["pct_of_user_messages"]):
    ax.text(v + .3, i, f"{v}%", va="center", fontsize=8, color="#4a5568")
fig.savefig(f"{OUTDIR}/fig_axis_coverage.png", bbox_inches="tight")
plt.close(fig)

# how many axes fire per message - a message with zero is one we cannot describe
