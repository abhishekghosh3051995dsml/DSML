ax.set_yticks(range(len(axis_cols)))
ax.set_yticklabels(axis_cols, fontsize=8)
ax.grid(False)
ax.set_title("Axis co-occurrence (Jaccard)", loc="left", fontweight="600")
for i in range(len(axis_cols)):
    for j in range(len(axis_cols)):
        v = jac.values[i, j]
        ax.text(j, i, f"{v:.2f}", ha="center", va="center", fontsize=7,
