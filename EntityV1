def find_col(cols, patterns, exclude=()):
    for pat in patterns:
        for c in cols:
            n = re.sub(r"[^a-z0-9]+", "_", str(c).lower())
            if any(re.search(e, n) for e in exclude):
                continue
            if re.search(pat, n):
                return c
    return None


