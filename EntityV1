# --- 4. lexical EDA -----------------------------------------------------------
STOP = set("""a an the and or but if then than of to in on at for with without from by
is are was were be been being do does did doing have has had having i we you he she it
they them his her its their our my me us this that these those as so not no nor can
could will would shall should may might must about into over under again further once
here there when where why how all any both each few more most other some such only own
same too very s t just now up down out off""".split())


def tokens(s, n=1):
    w = [x for x in s.split() if x not in STOP and len(x) > 1]
    if n == 1:
        return w
    return [" ".join(w[i:i + n]) for i in range(len(w) - n + 1)]


def term_table(texts, n, top):
    doc = Counter()
    for t in texts:
        for g in set(tokens(t, n)):
            doc[g] += 1
    rows = [{"term": k, "n_gram": n, "messages": v,
             "pct_of_messages": round(100 * v / max(len(texts), 1), 2)}
            for k, v in doc.most_common(top)]
    return pd.DataFrame(rows)


