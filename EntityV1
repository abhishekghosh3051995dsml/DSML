# %%
# --- 3. PII removal -----------------------------------------------------------
# Identifier form fields are dropped, not surrogated - a stable token for a BAN
# is still a join key back to one person. Names typed into free text are caught
# by harvesting every value that appears in a name field anywhere in the corpus
# and blocking those tokens everywhere.

if os.path.exists(SALT_FILE):
    SALT = open(SALT_FILE).read().strip().encode()
else:
    SALT = secrets.token_hex(32).encode()
    open(SALT_FILE, "w").write(SALT.decode())
    print(f"created {SALT_FILE} - keep it out of git and OneDrive")

PII = [
    ("URL",    re.compile(r"https?://\S+")),
    ("EMAIL",  re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b")),
    ("IP",     re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")),
    ("EID",    re.compile(r"\b[0-9a-fA-F]{32}\b")),
    ("UUID",   re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                          r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b")),
    ("ICCID",  re.compile(r"\b89\d{17,20}\b")),
    ("IMEI",   re.compile(r"\b\d{14,17}\b")),
    ("MSISDN", re.compile(r"(?<!\d)(?:\+?\d{1,3}[\s\-.]?)?\(?\d{3}\)?[\s\-.]?"
                          r"\d{3}[\s\-.]?\d{4}(?!\d)")),
    ("ACCT",   re.compile(r"(?<!\d)\d{8,}(?!\d)")),
    ("GEO",    re.compile(r"(?<![\w.])-?\d{1,3}\.\d{4,}(?![\w.])")),
    ("NUMID",  re.compile(r"(?<!\d)\d{5,7}(?!\d)")),
]
ADDRESS = re.compile(
    r"\b\d{1,6}\s+(?:[A-Za-z0-9.'\-]+\s+){0,4}"
    r"(?:st|street|rd|road|ave|avenue|blvd|ln|lane|dr|drive|ct|court|way|pl|"
    r"place|pkwy|hwy|cir|circle|apt|suite|ste|unit)\b\.?", re.I)
NAME_CUE = re.compile(
    r"(?i)\b(?:customer\s*name|customername|contact\s*name|account\s*name|"
    r"caller|cust\s*name|first\s*name|last\s*name|name)\s*[:\-]\s*"
    r"(?P<val>[A-Za-z][A-Za-z'\-]{1,20}(?:\s+[A-Za-z][A-Za-z'\-]{1,20}){0,4})")
FIELD_LINE = re.compile(r"(?m)^[ \t\-\*#>]*(?P<k>[A-Za-z][A-Za-z0-9 _\-/#\.]{1,44}?)"
                        r"\s*:\s*(?P<v>.*)$")

ID_FIELDS = [
    ("NAME",  r"(customer|contact|account|subscriber|caller|first|last|full)?_?name"),
    ("EMAIL", r"e_?mail"),
    ("PHONE", r"phone|mobile|msisdn|call_?back|callback|number_?with_issue|with_issue"),
    ("IMEI",  r"imei"),
    ("ICCID", r"iccid|sim_?serial"),
    ("EID",   r"^eid$|euicc"),
    ("BAN",   r"^ban$|billing_?account|account_?number|acct"),
    ("ADDR",  r"address|street|zip|postal|city|state"),
    ("ID",    r"^cid$|uuid|guid|ticket|case_?number|order_?number"),
]

SAFE_WORDS = {
    "customer", "cust", "caller", "rep", "care", "business", "consumer", "account",
    "line", "phone", "mobile", "device", "internet", "service", "data", "call",
    "calls", "text", "sim", "esim", "router", "gateway", "hotspot", "signal",
    "network", "wifi", "roaming", "plan", "ticket", "order", "status", "issue",
    "issues", "problem", "unknown", "none", "test", "null", "blank", "email",
    "name", "number", "info", "verified", "resolved", "pending", "yes", "no",
    "home", "work", "office", "site", "tower", "outage", "inseego", "cradlepoint",
    "craddlepoint", "franklin", "samsung", "apple", "iphone", "android", "galaxy",
    "tmobile", "sprint", "magenta", "the", "and", "for", "with", "this", "that",
}

masked_counts = Counter()


def norm_key(k):
    return re.sub(r"[^a-z0-9]+", "_", str(k).strip().lower()).strip("_")


def key_kind(k):
    for kind, pat in ID_FIELDS:
        if re.search(pat, k):
            return kind
    return None


def surrogate(kind, val):
    h = hmac.new(SALT, f"{kind}|{val}".encode("utf-8", "ignore"),
                 hashlib.sha256).hexdigest()[:10]
    masked_counts[kind] += 1
    return f"<{kind}_{h}>"


def harvest_names(texts):
    """Every token that has ever sat in a name field or after a name cue."""
    seen = Counter()
    for t in texts:
        if not isinstance(t, str) or not t:
            continue
        for m in FIELD_LINE.finditer(t):
            if key_kind(norm_key(m.group("k"))) == "NAME":
                for w in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", m.group("v")):
                    seen[w.lower()] += 1
        for m in NAME_CUE.finditer(t):
            for w in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", m.group("val")):
                seen[w.lower()] += 1
    return {w for w in seen if len(w) >= 3 and w not in SAFE_WORDS}


NAMES = harvest_names(df["raw"].tolist())
NAME_RE = (re.compile(r"(?i)\b(?:" +
                      "|".join(re.escape(w) for w in sorted(NAMES, key=len, reverse=True)) +
                      r")\b") if NAMES else None)
print(f"name tokens blocked: {len(NAMES)}")


def scrub(text):
    if not isinstance(text, str) or not text:
        return ""
    s = NAME_CUE.sub(lambda m: m.group(0)[:m.start("val") - m.start(0)] +
                     surrogate("NAME", m.group("val").lower()), text)
    s = ADDRESS.sub(lambda m: surrogate("ADDR", m.group(0).lower()), s)
    for kind, rx in PII:
        s = rx.sub(lambda m, k=kind: surrogate(k, m.group(0)), s)
    if NAME_RE:
        s = NAME_RE.sub(lambda m: surrogate("NAME", m.group(0).lower()), s)
    return s


def strip_fields(text):
    """Split an intake form; drop identifier fields, keep free text."""
    fields = {}
    spans = []
    for m in FIELD_LINE.finditer(text):
        k = norm_key(m.group("k"))
        if len(k) < 2:
            continue
        fields.setdefault(k, m.group("v").strip())
        spans.append((m.start(), m.end()))
    if not spans:
        return scrub(text)
    rest, prev = [], 0
    for a, b in spans:
        rest.append(text[prev:a])
        prev = b
    rest.append(text[prev:])
    keep = [scrub(v) for k, v in fields.items() if key_kind(k) is None and v]
    for k in fields:
        if key_kind(k):
            masked_counts[key_kind(k)] += 1
    tail = scrub(" ".join(rest))
    return " ".join([p for p in keep if p] + [tail]).strip()


user["clean"] = user["raw"].map(strip_fields)
asst["clean"] = asst["raw"].map(scrub)

# residue gate - anything still identifier-shaped is blanked, not shipped
SURR = re.compile(r"<[A-Z_]+_[0-9a-f]{6,}>")
RESIDUE = [
    ("email", re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")),
    ("digits5", re.compile(r"(?<!\d)\d{5,}(?!\d)")),
    ("ipv4", re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")),
    ("hex32", re.compile(r"\b[0-9a-fA-F]{32}\b")),
]


def residue_hits(s):
    probe = SURR.sub(" ", s)
    return [n for n, rx in RESIDUE if rx.search(probe)]


for part, frame in (("user", user), ("assistant", asst)):
    bad = frame["clean"].map(lambda x: bool(residue_hits(x)))
    frame.loc[bad, "clean"] = ""
    print(f"{part}: {int(bad.sum())} messages blanked by residue gate")

# normalise
for frame in (user, asst):
    frame["clean"] = (frame["clean"].str.lower()
                      .str.replace(SURR, " ", regex=True)
                      .str.replace(r"[^a-z0-9%.\-/' ]+", " ", regex=True)
                      .str.replace(r"\s+", " ", regex=True).str.strip())

user = user[user["clean"].str.len() >= 3].copy()
asst = asst[asst["clean"].str.len() >= 3].copy()
print(f"after cleaning: user {len(user)}  assistant {len(asst)}")

pd.DataFrame(sorted(masked_counts.items()),
             columns=["entity", "count"]).to_csv(f"{OUTDIR}/03_masking_summary.csv",
                                                 index=False)
print(pd.DataFrame(sorted(masked_counts.items()),
                   columns=["entity", "count"]).to_string(index=False))

