#!/usr/bin/env python3
"""
NORA V5.7.2 Reference-Style Interactive Knowledge Graph Generator.

Reads the graph_bundle.json created by the existing NORA V5.7.2 graph builder
and writes one self-contained HTML graph visualization. The graph data is
embedded in the generated HTML, so no Python HTTP server is required.
"""

from __future__ import annotations

import argparse
import json
import math
from collections import Counter, defaultdict, deque
from pathlib import Path
from typing import Any, Dict, List, Mapping, Sequence, Tuple


def first_value(d: Mapping[str, Any], *keys: str, default: Any = None) -> Any:
    for key in keys:
        value = d.get(key)
        if value is not None and value != "":
            return value
    return default


def as_float(value: Any, default: float = 0.0) -> float:
    try:
        x = float(value)
        return x if math.isfinite(x) else default
    except (TypeError, ValueError):
        return default


def node_type(value: Any) -> str:
    text = str(value or "UNKNOWN").strip()
    return "_".join(text.replace("-", " ").split()).upper() or "UNKNOWN"


def metadata(value: Any) -> Dict[str, Any]:
    if isinstance(value, dict):
        return value
    if value in (None, ""):
        return {}
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
            return parsed if isinstance(parsed, dict) else {"value": parsed}
        except json.JSONDecodeError:
            return {"value": value}
    return {"value": value}


def load_bundle(path: Path) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    if not path.exists():
        raise FileNotFoundError(f"graph_bundle.json not found: {path}")

    with path.open("r", encoding="utf-8") as f:
        raw = json.load(f)

    raw_nodes = raw.get("nodes")
    if not isinstance(raw_nodes, list):
        raw_nodes = raw.get("graph", {}).get("nodes", [])

    raw_edges = raw.get("edges")
    if not isinstance(raw_edges, list):
        raw_edges = raw.get("links")
    if not isinstance(raw_edges, list):
        raw_edges = raw.get("graph", {}).get("edges", [])

    if not raw_nodes:
        raise ValueError("No nodes found in graph_bundle.json")

    nodes: List[Dict[str, Any]] = []
    for i, r in enumerate(raw_nodes):
        if not isinstance(r, dict):
            continue
        nid = str(first_value(r, "id", "node_id", "key", default=f"node_{i}"))
        parent = first_value(r, "parent_id", "parent", default=None)
        nodes.append({
            "id": nid,
            "label": str(first_value(r, "label", "name", "canonical_label", default=nid)),
            "type": node_type(first_value(r, "type", "node_type", "kind", default="UNKNOWN")),
            "count": as_float(first_value(r, "count", "support", "frequency", default=1), 1.0),
            "level": int(as_float(first_value(r, "level", "depth", default=0), 0)),
            "parent_id": None if parent in (None, "") else str(parent),
            "metadata": metadata(first_value(r, "metadata", "metadata_json", default={})),
            "source_artifacts": first_value(
                r, "source_artifacts", "source_artifact", "source", default=""
            ),
        })

    node_ids = {n["id"] for n in nodes}

    edges: List[Dict[str, Any]] = []
    for i, r in enumerate(raw_edges or []):
        if not isinstance(r, dict):
            continue
        source = str(first_value(r, "source", "from", "source_id", default=""))
        target = str(first_value(r, "target", "to", "target_id", default=""))
        if source not in node_ids or target not in node_ids:
            continue
        edges.append({
            "id": str(first_value(r, "id", "edge_id", default=f"edge_{i}")),
            "source": source,
            "target": target,
            "predicate": str(first_value(
                r, "predicate", "relationship", "relation", "label", default="RELATED_TO"
            )),
            "kind": str(first_value(r, "kind", "edge_kind", default="semantic")),
            "count": as_float(first_value(r, "count", "support", default=1), 1.0),
            "confidence": as_float(first_value(
                r, "mean_confidence", "confidence", default=0
            ), 0.0),
        })

    return nodes, edges


def project_graph(
    nodes: Sequence[Dict[str, Any]],
    edges: Sequence[Dict[str, Any]],
    max_nodes: int,
    max_edges: int,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], Dict[str, int]]:
    node_by_id = {n["id"]: n for n in nodes}
    adjacency: Dict[str, List[str]] = defaultdict(list)
    degree: Counter[str] = Counter()
    child_count: Counter[str] = Counter()

    for e in edges:
        s, t = e["source"], e["target"]
        adjacency[s].append(t)
        adjacency[t].append(s)
        degree[s] += 1
        degree[t] += 1

    for n in nodes:
        if n["parent_id"] in node_by_id:
            child_count[n["parent_id"]] += 1

    def score(n: Dict[str, Any]) -> float:
        d = degree[n["id"]]
        c = max(1.0, as_float(n["count"], 1.0))
        ch = child_count[n["id"]]
        hierarchy = 5.0 if n["parent_id"] is None else max(0.0, 3.0 - n["level"])
        return (
            4.2 * math.log1p(d)
            + 1.35 * math.log1p(c)
            + 1.8 * math.log1p(ch)
            + hierarchy
        )

    score_by_id = {n["id"]: score(n) for n in nodes}

    by_type: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for n in nodes:
        by_type[n["type"]].append(n)
    for arr in by_type.values():
        arr.sort(key=lambda n: score_by_id[n["id"]], reverse=True)

    selected: set[str] = set()
    q: deque[str] = deque()

    type_names = sorted(by_type)
    per_type = max(3, min(40, max_nodes // max(1, len(type_names) * 8)))

    for t in type_names:
        for n in by_type[t][:per_type]:
            if len(selected) >= max_nodes:
                break
            if n["id"] not in selected:
                selected.add(n["id"])
                q.append(n["id"])

    roots = sorted(
        (n for n in nodes if n["parent_id"] is None or n["level"] == 0),
        key=lambda n: score_by_id[n["id"]],
        reverse=True,
    )
    for n in roots[:min(180, max_nodes)]:
        if len(selected) >= max_nodes:
            break
        if n["id"] not in selected:
            selected.add(n["id"])
            q.append(n["id"])

    def ranked_neighbors(nid: str) -> List[str]:
        return sorted(
            set(adjacency.get(nid, [])),
            key=lambda x: score_by_id.get(x, 0.0),
            reverse=True,
        )

    while q and len(selected) < max_nodes:
        current = q.popleft()
        for nb in ranked_neighbors(current):
            if len(selected) >= max_nodes:
                break
            if nb not in selected:
                selected.add(nb)
                q.append(nb)

    if len(selected) < max_nodes:
        remaining = sorted(
            (n for n in nodes if n["id"] not in selected),
            key=lambda n: score_by_id[n["id"]],
            reverse=True,
        )
        for n in remaining:
            if len(selected) >= max_nodes:
                break
            selected.add(n["id"])
            for nb in ranked_neighbors(n["id"]):
                if len(selected) >= max_nodes:
                    break
                selected.add(nb)

    candidate_edges = [
        e for e in edges if e["source"] in selected and e["target"] in selected
    ]

    def edge_score(e: Dict[str, Any]) -> float:
        return (
            (2.0 if str(e["kind"]).lower() == "semantic" else 0.5)
            + math.log1p(max(1.0, as_float(e["count"], 1.0)))
            + max(0.0, min(1.0, as_float(e["confidence"], 0.0)))
            + 0.05 * (degree[e["source"]] + degree[e["target"]])
        )

    candidate_edges.sort(key=edge_score, reverse=True)
    projected_edges = candidate_edges[:max_edges]

    connected = set()
    for e in projected_edges:
        connected.add(e["source"])
        connected.add(e["target"])

    if connected:
        projected_nodes = [n for n in nodes if n["id"] in selected and n["id"] in connected]
    else:
        projected_nodes = [n for n in nodes if n["id"] in selected]

    stats = {
        "source_nodes": len(nodes),
        "source_edges": len(edges),
        "projected_nodes": len(projected_nodes),
        "projected_edges": len(projected_edges),
    }
    return projected_nodes, projected_edges, stats


