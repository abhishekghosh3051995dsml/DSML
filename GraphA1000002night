def write_html(
    output: Path,
    nodes: Sequence[Dict[str, Any]],
    edges: Sequence[Dict[str, Any]],
    stats: Mapping[str, Any],
) -> None:
    nj = json.dumps(nodes, ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
    ej = json.dumps(edges, ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
    sj = json.dumps(dict(stats), ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
    html = HTML.replace("__NODES_JSON__", nj).replace("__EDGES_JSON__", ej).replace("__STATS_JSON__", sj)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(html, encoding="utf-8")


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Build a reference-style NORA V5.7.2 interactive graph.")
    p.add_argument("--bundle", required=True, help="Path to graph_bundle.json")
    p.add_argument("--output", default="nora_v572_reference_graph.html", help="Output HTML")
    p.add_argument("--max-nodes", type=int, default=2280)
    p.add_argument("--max-edges", type=int, default=9000)
    return p.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv)
    if args.max_nodes < 10:
        raise ValueError("--max-nodes must be >= 10")
    if args.max_edges < 1:
        raise ValueError("--max-edges must be >= 1")

    bundle_path = Path(args.bundle).expanduser().resolve()
    output_path = Path(args.output).expanduser().resolve()

    print(f"[1/4] Reading {bundle_path}")
    nodes, edges = load_bundle(bundle_path)
    print(f"[2/4] Full graph: {len(nodes):,} nodes / {len(edges):,} edges")

    pn, pe, stats = project_graph(
        nodes, edges,
        max_nodes=min(args.max_nodes, len(nodes)),
        max_edges=min(args.max_edges, len(edges)),
    )
    print(f"[3/4] Viewer projection: {len(pn):,} nodes / {len(pe):,} edges")

    write_html(output_path, pn, pe, stats)
    print(f"[4/4] Created {output_path}")
    print("Open this generated HTML in Edge/Chrome. No HTTP server is required.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
