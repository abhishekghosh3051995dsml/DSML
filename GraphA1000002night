<script>
"use strict";

const RAW_NODES=__NODES_JSON__;
const RAW_EDGES=__EDGES_JSON__;
const SOURCE_STATS=__STATS_JSON__;

const COLORS={
"CONTEXT_FAMILY":"#ff4040","CONTEXT_PATTERN":"#ff9e2f","CONTEXT_LEAF":"#ffd447",
"INTERACTION":"#7c3aed","PARTICIPANT":"#2f80ed","ENTITY":"#14b8a6","TOOL":"#70c050",
"CONTEXT_FACT":"#d1d5db","ROOT_CAUSE":"#e84393","REMEDIATION":"#b7df52",
"DIAGNOSTIC_EVIDENCE":"#3fa7ff","MOTIF":"#f59e0b","FINGERPRINT":"#9ca3af",
"ATTRIBUTE":"#c084fc","MEASUREMENT":"#38bdf8"
};

function hue(s){let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return Math.abs(h)%360}
function color(t){return COLORS[t]||`hsl(${hue(t)} 72% 56%)`}
function esc(s){return String(s??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;")}
function fmt(n){return new Intl.NumberFormat().format(Number(n||0))}

const degree=new Map(),adj=new Map(),nodeById=new Map(RAW_NODES.map(n=>[n.id,n])),typeCounts=new Map();
RAW_NODES.forEach(n=>{degree.set(n.id,0);adj.set(n.id,[]);typeCounts.set(n.type,(typeCounts.get(n.type)||0)+1)});
RAW_EDGES.forEach((e,i)=>{degree.set(e.source,(degree.get(e.source)||0)+1);degree.set(e.target,(degree.get(e.target)||0)+1);adj.get(e.source)?.push(i);adj.get(e.target)?.push(i)});

const vals=[...degree.values()].sort((a,b)=>b-a);
const labelCut=vals[Math.min(119,Math.max(0,vals.length-1))]??Infinity;
function size(n){const d=degree.get(n.id)||0,c=Math.max(1,Number(n.count||1));return Math.max(5,Math.min(34,5+2.5*Math.log1p(d)+1.3*Math.log1p(c)))}

const nodes=new vis.DataSet(RAW_NODES.map(n=>({
id:n.id,label:(degree.get(n.id)||0)>=labelCut?n.label:"",
title:`<b>${esc(n.type)}</b><br>${esc(n.label)}<br>Degree: ${degree.get(n.id)||0}`,
shape:"dot",size:size(n),
color:{background:color(n.type),border:"#f8fafc",highlight:{background:color(n.type),border:"#fff"},hover:{background:color(n.type),border:"#fff"}},
borderWidth:(degree.get(n.id)||0)>=labelCut?2:1,
font:{color:"#f5f7fb",size:11,strokeWidth:3,strokeColor:"#020811"}
})));

const edges=new vis.DataSet(RAW_EDGES.map(e=>({
id:e.id,from:e.source,to:e.target,title:`${esc(e.predicate)}<br>${esc(e.kind)}`,
width:Math.max(.35,Math.min(2.4,.45+Math.log1p(Number(e.count||1))*.35)),
color:{color:"rgba(185,205,230,.22)",highlight:"#fff",hover:"#e8f1ff",inherit:false},smooth:false
})));

const network=new vis.Network(document.getElementById("graph"),{nodes,edges},{
autoResize:true,layout:{improvedLayout:false,randomSeed:37},
interaction:{hover:true,tooltipDelay:120,hideEdgesOnDrag:true,hideEdgesOnZoom:true,keyboard:{enabled:true,bindToWindow:false}},
physics:{enabled:true,barnesHut:{gravitationalConstant:-16000,centralGravity:.12,springLength:105,springConstant:.02,damping:.18,avoidOverlap:.12},
stabilization:{enabled:true,iterations:600,updateInterval:40,fit:true}}
});

document.getElementById("nodeCount").textContent=fmt(RAW_NODES.length);
document.getElementById("edgeCount").textContent=fmt(RAW_EDGES.length);
document.getElementById("tripleCount").textContent=fmt(RAW_EDGES.length);

const hiddenTypes=new Set();
function legend(){
 const host=document.getElementById("legendRows");
 [...typeCounts.entries()].sort((a,b)=>a[0].localeCompare(b[0])).forEach(([t,c])=>{
  const row=document.createElement("div");row.className="legend-row";row.dataset.type=t;
  row.innerHTML=`<span class="dot" style="background:${color(t)}"></span><span style="flex:1">${esc(t)}</span><span class="small">${fmt(c)}</span>`;
  row.onclick=()=>{hiddenTypes.has(t)?hiddenTypes.delete(t):hiddenTypes.add(t);row.classList.toggle("off",hiddenTypes.has(t));
   nodes.update(RAW_NODES.filter(n=>n.type===t).map(n=>({id:n.id,hidden:hiddenTypes.has(t)})))};
  host.appendChild(row);
 });
}
legend();

function inspect(id){
 const n=nodeById.get(id);if(!n)return;
 nodes.update({id:id,label:n.label});
 const children=RAW_NODES.filter(x=>x.parent_id===id).slice(0,18).map(x=>x.label);
 let html=`<div class="kv">
 <div class="k">Label:</div><div class="value"><b>${esc(n.label)}</b></div>
 <div class="k">Type:</div><div>${esc(n.type)}</div>
 <div class="k">Degree:</div><div>${fmt(degree.get(id)||0)}</div>
 <div class="k">Count:</div><div>${fmt(n.count)}</div>
 <div class="k">Level:</div><div>${fmt(n.level)}</div>`;
 if(n.parent_id){const p=nodeById.get(n.parent_id);html+=`<div class="k">Parent:</div><div>${esc(p?.label||n.parent_id)}</div>`}
 if(children.length)html+=`<div class="k">Children:</div><div>${children.map(esc).join("<br>")}</div>`;
 html+="</div>";document.getElementById("selection").innerHTML=html;
 const rels=(adj.get(id)||[]).map(i=>RAW_EDGES[i]).slice(0,35);
 document.getElementById("relationships").innerHTML=rels.length?`<hr><b style="font-size:12px">Connected relationships</b>`+rels.map(e=>{
  const out=e.source===id,otherId=out?e.target:e.source,other=nodeById.get(otherId);
  return `<div class="rel"><span class="pred">${esc(e.predicate)}</span> ${out?"→":"←"} ${esc(other?.label||otherId)}<div class="small">${esc(other?.type||"")}</div></div>`;
 }).join(""):"";
}

function neighborSet(id){const s=new Set([id]);(adj.get(id)||[]).forEach(i=>{const e=RAW_EDGES[i];s.add(e.source);s.add(e.target)});return s}
function highlight(id){
 const s=neighborSet(id);nodes.update(RAW_NODES.map(n=>({id:n.id,opacity:s.has(n.id)?1:.12})));
 network.selectNodes([id]);network.focus(id,{scale:1.15,animation:{duration:600}});
}
function isolate(id){
 const s=neighborSet(id);nodes.update(RAW_NODES.map(n=>({id:n.id,hidden:!s.has(n.id)||hiddenTypes.has(n.type),opacity:1})));
 network.focus(id,{scale:1.0,animation:{duration:500}});network.fit({nodes:[...s],animation:{duration:600}});
}
function reset(){
 nodes.update(RAW_NODES.map(n=>({id:n.id,hidden:hiddenTypes.has(n.type),opacity:1})));
 network.unselectAll();network.fit({animation:{duration:700}});
}

network.on("click",p=>{if(!p.nodes.length)return;const id=String(p.nodes[0]);inspect(id);highlight(id)});
network.on("doubleClick",p=>{if(p.nodes.length)isolate(String(p.nodes[0]))});
network.on("stabilizationProgress",p=>{const pct=p.total?Math.round((p.iterations/p.total)*100):0;document.getElementById("status").textContent=`Layout ${pct}%`});
network.once("stabilizationIterationsDone",()=>{network.setOptions({physics:false});network.fit({animation:{duration:650}});
 document.getElementById("status").textContent=`${fmt(SOURCE_STATS.projected_nodes)} nodes · ${fmt(SOURCE_STATS.projected_edges)} links`});

document.getElementById("fitBtn").onclick=()=>network.fit({animation:{duration:600}});
document.getElementById("resetBtn").onclick=reset;
document.getElementById("neighborsBtn").onclick=()=>{const s=network.getSelectedNodes();if(s.length)isolate(String(s[0]))};

function find(){
 const q=document.getElementById("searchBox").value.trim().toLowerCase();if(!q)return;
 const m=RAW_NODES.find(n=>n.id.toLowerCase()===q||n.label.toLowerCase()===q)||
         RAW_NODES.find(n=>n.label.toLowerCase().includes(q)||n.id.toLowerCase().includes(q)||n.type.toLowerCase().includes(q));
 if(!m){document.getElementById("status").textContent="No matching node";return}
 nodes.update({id:m.id,hidden:false,opacity:1,label:m.label});inspect(m.id);network.selectNodes([m.id]);network.focus(m.id,{scale:1.5,animation:{duration:700}});
}
document.getElementById("searchBtn").onclick=find;
document.getElementById("searchBox").addEventListener("keydown",e=>{if(e.key==="Enter")find()});
</script>
