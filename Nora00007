# Topic-label alignment
# ---------------------------------------------------------------------------

def topic_label_alignment(
    user: pd.DataFrame,
    schema: Dict[str, Optional[str]],
) -> Dict[str, Any]:
    label_col, _ = resolve_label_and_group(schema)

    if not label_col or "topic_id" not in user.columns:
        return {"status": "skipped"}

    mask = (
        user["data_split"].eq("development")
        & user[label_col].fillna("").astype(str).str.strip().ne("")
        & user["topic_id"].ne(-1)
    )

    if mask.sum() < 20:
        return {
            "status": "skipped",
            "reason": "insufficient_development_overlap",
        }

    labels = user.loc[mask, label_col].astype(str)
    topics = user.loc[mask, "topic_id"].astype(int)

    return {
        "status": "completed",
        "partition": "development_only",
        "compared_rows": int(mask.sum()),
        "normalized_mutual_information": float(
            normalized_mutual_info_score(labels, topics)
        ),
        "adjusted_rand_index": float(
            adjusted_rand_score(labels, topics)
        ),
        "note": (
            "These measure structural alignment between discovered topics and "
            "existing labels; they are not classification accuracy."
        ),
    }


