# Assistant finding discovery
# ---------------------------------------------------------------------------

def section_role(header: str) -> str:
    value = re.sub(r"\s+", " ", header.strip().lower())

    if value.startswith("root cause") or value in {"probable cause", "likely cause"}:
        return "root_cause"
    if (
        value.startswith("recommendation")
        or value in {"remediation", "resolution"}
        or value.startswith("next step")
    ):
        return "remediation"
    if value.startswith("diagnostic"):
        return "diagnostic_check"
    if value.startswith("limitation"):
        return "limitation"
    return "unclassified"


def split_sentences(text: str) -> List[str]:
    return [
        piece.strip()
        for piece in SENTENCE_RE.split(str(text))
        if len(piece.strip()) >= 12
    ]


def extract_assistant_units(
    text: str,
    max_sentences: int,
) -> List[Tuple[str, str]]:
    """
    Split an assistant response into sentence units.

    Explicit section headings are preserved as structural roles. Text without a
    recognized heading stays unclassified instead of being forced into an RCA
    or remediation class.
    """
    matches = list(SECTION_MARKER_RE.finditer(text))
    units: List[Tuple[str, str]] = []

    if not matches:
        for sentence in split_sentences(text)[:max_sentences]:
            units.append((sentence, "unclassified"))
        return units

    prefix = text[:matches[0].start()].strip()
    for sentence in split_sentences(prefix):
        units.append((sentence, "unclassified"))

    for position, match in enumerate(matches):
        start = match.end()
        end = (
            matches[position + 1].start()
            if position + 1 < len(matches)
            else len(text)
        )

        role = section_role(match.group("header"))
        segment = text[start:end].strip()

        for sentence in split_sentences(segment):
            units.append((sentence, role))

    return units[:max_sentences]


def build_link_key(
    row: pd.Series,
    schema: Dict[str, Optional[str]],
) -> str:
    conversation_col = schema.get("conversation")
    case_col = schema.get("case")

    if conversation_col:
        value = str(row.get(conversation_col, "")).strip()
        if value:
            return f"conversation::{value}"

    if case_col:
        value = str(row.get(case_col, "")).strip()
        if value:
            return f"case::{value}"

    return ""


def assistant_units_table(
    assistant: pd.DataFrame,
    schema: Dict[str, Optional[str]],
    config: RunConfig,
) -> pd.DataFrame:
    rows: List[Dict[str, Any]] = []

    case_col = schema.get("case")
    conversation_col = schema.get("conversation")

    for assistant_row in range(len(assistant)):
        source = assistant.iloc[assistant_row]
        units = extract_assistant_units(
            str(source["text"]),
            config.max_sentences_per_message,
        )

        for sentence_index, (sentence, structural_role) in enumerate(units):
            rows.append({
                "assistant_row": int(assistant_row),
                "sentence_index": int(sentence_index),
                "case": (
                    str(source.get(case_col, ""))
                    if case_col
                    else ""
                ),
                "conversation_id": (
                    str(source.get(conversation_col, ""))
                    if conversation_col
                    else ""
                ),
                "link_key": build_link_key(source, schema),
                "group_key": str(source.get("group_key", "")),
                "data_split": str(source.get("data_split", "unlabelled")),
                "structural_role": structural_role,
                "sentence": sentence,
            })

    return pd.DataFrame(rows)


def discover_assistant_findings(
    assistant: pd.DataFrame,
    schema: Dict[str, Optional[str]],
    config: RunConfig,
) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    log("\n[7/10] Assistant finding discovery")

    if config.skip_assistant:
        return pd.DataFrame(), {
            "status": "skipped",
            "reason": "disabled_by_flag",
        }

    if assistant.empty:
        return pd.DataFrame(), {
            "status": "skipped",
            "reason": "no_assistant_turns",
        }

    units = assistant_units_table(
        assistant,
        schema,
        config,
    )

    if units.empty:
        return units, {
            "status": "skipped",
            "reason": "no_assistant_sentence_units",
        }

    units["finding_cluster_id"] = -1
    units["finding_cluster_score"] = np.nan
    units["finding_descriptor"] = "unassigned"

    development = units[units["data_split"].eq("development")]
    unique_development = (
        development[["sentence"]]
        .drop_duplicates("sentence")
        .reset_index(drop=True)
    )

    if len(unique_development) < 30:
        summary = {
            "status": "partial",
            "reason": "too_few_distinct_development_assistant_sentences_for_clustering",
            "assistant_messages": int(len(assistant)),
            "sentence_units": int(len(units)),
            "structural_role_counts": {
                str(key): int(value)
                for key, value in units["structural_role"].value_counts().items()
            },
        }
        return units, summary

    representation, development_vectors = fit_latent_representation(
        unique_development["sentence"].tolist(),
        config,
        max_components=config.assistant_svd_components,
    )

    cluster_model, assignments, strengths = fit_cluster_model(
        development_vectors,
        seed=config.seed,
        requested_min_cluster_size=config.assistant_min_cluster_size,
        requested_neighbors=config.topic_umap_neighbors,
        max_k=config.assistant_max_k,
    )

    descriptions = describe_clusters_ctfidf(
        unique_development["sentence"].tolist(),
        assignments,
    )

    development_lookup = {
        str(sentence): (
            int(cluster_id),
            float(score),
        )
        for sentence, cluster_id, score in zip(
            unique_development["sentence"],
            assignments,
            strengths,
        )
    }

    for index in units.index:
        item = development_lookup.get(str(units.at[index, "sentence"]))
        if item is not None:
            units.at[index, "finding_cluster_id"] = item[0]
            units.at[index, "finding_cluster_score"] = item[1]

    unseen = units.index[
        ~units["sentence"].isin(development_lookup.keys())
    ]

    if len(unseen):
        unseen_vectors = representation.transform(
            units.loc[unseen, "sentence"].astype(str).tolist()
        )
        predicted, predicted_strength = predict_clusters(
            cluster_model,
            unseen_vectors,
        )
        units.loc[unseen, "finding_cluster_id"] = predicted
        units.loc[unseen, "finding_cluster_score"] = predicted_strength

    def descriptor(cluster_id: Any) -> str:
        try:
            cluster = int(cluster_id)
        except (TypeError, ValueError):
            return "unassigned"
        if cluster == -1:
            return "unassigned"
        return descriptions.get(
            cluster,
            {},
        ).get(
            "descriptor",
            f"assistant_cluster_{cluster}",
        )

    units["finding_descriptor"] = units["finding_cluster_id"].map(descriptor)

    development_assignments = np.asarray(assignments, dtype=int)
    sizes = pd.Series(development_assignments).value_counts().sort_index()
    clusters = sorted(
        int(item)
        for item in set(development_assignments.tolist())
        if int(item) != -1
    )

    summary = {
        "status": "completed",
        "fit_partition": "development_only",
        "method": (
            "assistant sentence units -> word + character TF-IDF -> "
            f"TruncatedSVD/LSA -> {cluster_model.method}"
        ),
        "assistant_messages": int(len(assistant)),
        "sentence_units": int(len(units)),
        "development_unique_sentences": int(len(unique_development)),
        "finding_clusters_found": int(len(clusters)),
        "development_unassigned_sentences": int(
            (development_assignments == -1).sum()
        ),
        "silhouette_cosine_non_outliers": cluster_model.silhouette,
        "structural_role_counts": {
            str(key): int(value)
            for key, value in units["structural_role"].value_counts().items()
        },
        "structural_role_note": (
            "root_cause/remediation/diagnostic/limitation labels are assigned "
            "only when explicit section headings are present."
        ),
        "clusters": [
            {
                "cluster_id": int(cluster_id),
                "count": int(sizes.get(cluster_id, 0)),
                "descriptor": (
                    "unassigned"
                    if int(cluster_id) == -1
                    else descriptions.get(
                        int(cluster_id),
                        {},
                    ).get(
                        "descriptor",
                        f"assistant_cluster_{cluster_id}",
                    )
                ),
                "keywords": (
                    []
                    if int(cluster_id) == -1
                    else descriptions.get(
                        int(cluster_id),
                        {},
                    ).get("keywords", [])
                ),
            }
            for cluster_id in sorted(set(development_assignments.tolist()))
        ],
    }

    log(
        f"  method={cluster_model.method} "
        f"clusters={len(clusters)} "
        f"sentences={len(units):,}"
    )

    return units, summary


