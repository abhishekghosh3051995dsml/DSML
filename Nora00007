def parse_fields(text: str) -> Tuple[List[Tuple[str, str]], str]:
    if not isinstance(text, str) or not text:
        return [], ""

    fields: List[Tuple[str, str]] = []
    spans: List[Tuple[int, int]] = []

    for match in FIELD_LINE_RE.finditer(text):
        key = normalise_key(match.group("key"))
        value = match.group("value").strip()
        if len(key) >= 2:
            fields.append((key, value))
            spans.append((match.start(), match.end()))

    if not spans:
        return [], text

    remainder: List[str] = []
    cursor = 0
    for start, end in spans:
        remainder.append(text[cursor:start])
        cursor = end
    remainder.append(text[cursor:])

    return fields, re.sub(r"\s+", " ", " ".join(remainder)).strip()


def harvest_name_tokens(
    texts: Iterable[str],
) -> Tuple[set[str], int]:
    """
    Build a privacy-only name block list from development text.

    A token is blocked only when most of its occurrences are in explicit name
    fields, which avoids masking ordinary words that also happen to be surnames.
    """
    in_name: Dict[str, int] = {}
    everywhere: Dict[str, int] = {}

    def increment(counter: Dict[str, int], token: str) -> None:
        counter[token] = counter.get(token, 0) + 1

    name_field_pattern = IDENTIFIER_FIELD_PATTERNS[0][1]

    for text in texts:
        if not isinstance(text, str) or not text:
            continue

        fields, _ = parse_fields(text)
        for key, value in fields:
            if re.search(name_field_pattern, key):
                for token in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", value):
                    increment(in_name, token.lower())

        for match in NAME_CUE_RE.finditer(text):
            for token in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", match.group("value")):
                increment(in_name, token.lower())

        for token in re.findall(r"[A-Za-z][A-Za-z'\-]{2,}", text.lower()):
            increment(everywhere, token)

    blocked = {
        token
        for token, count in in_name.items()
        if len(token) >= 3
        and count / max(everywhere.get(token, count), 1) >= 0.5
    }

    return blocked, len(in_name) - len(blocked)


def build_name_regex(tokens: set[str]) -> Optional[re.Pattern]:
    if not tokens:
        return None
    ordered = sorted(tokens, key=len, reverse=True)
    return re.compile(
        r"(?i)\b(?:" + "|".join(re.escape(token) for token in ordered) + r")\b"
    )


def scrub(
    text: str,
    name_regex: Optional[re.Pattern],
) -> str:
    if not isinstance(text, str) or not text:
        return ""

    value = NAME_CUE_RE.sub(" ", text)
    value = ADDRESS_RE.sub(f" {REDACT} ", value)

    for _, pattern in PII_PATTERNS:
        value = pattern.sub(f" {REDACT} ", value)

    if name_regex is not None:
        value = name_regex.sub(f" {REDACT} ", value)

    return value


def extract_customer_problem(
    text: str,
    name_regex: Optional[re.Pattern],
) -> str:
    fields, remainder = parse_fields(text)

    if not fields:
        body = scrub(text, name_regex)
    else:
        parts = [
            scrub(value, name_regex)
            for key, value in fields
            if value and not is_identifier_key(key)
        ]
        if remainder:
            parts.append(scrub(remainder, name_regex))
        body = " ".join(part for part in parts if part)

    body = body.replace(REDACT, " ")
    return re.sub(r"\s+", " ", body).strip()


def residue_flags(text: str) -> List[str]:
    hits = [
        name
        for name, pattern in PII_PATTERNS
        if pattern.search(text)
    ]
    if ADDRESS_RE.search(text):
        hits.append("address")
    return hits


def repair_residual_pii(
    series: pd.Series,
) -> Tuple[pd.Series, int, int]:
    repaired: List[str] = []
    touched = 0
    blanked = 0

    for text in series:
        if not residue_flags(text):
            repaired.append(text)
            continue

        touched += 1
        fixed = ADDRESS_RE.sub(" ", text)
        for _, pattern in PII_PATTERNS:
            fixed = pattern.sub(" ", fixed)
        fixed = re.sub(r"\s+", " ", fixed).strip()

        if residue_flags(fixed):
            repaired.append("")
            blanked += 1
        else:
            repaired.append(fixed)

    return pd.Series(repaired, index=series.index), touched, blanked


def build_corpora(
    work: pd.DataFrame,
    schema: Dict[str, Optional[str]],
) -> Tuple[pd.DataFrame, pd.DataFrame, Dict[str, Any]]:
    log("\n[3/10] Building privacy-safe customer and assistant corpora")

    # The learned name list is built only from development rows. Deterministic
    # PII regexes are still applied to every partition.
    development_name_source = work.loc[
        work["data_split"].eq("development"),
        "_raw",
    ].tolist()

    blocked_names, released_count = harvest_name_tokens(
        development_name_source
    )
    name_regex = build_name_regex(blocked_names)

    if schema.get("role"):
        user = work[work["_role"].eq("user")].copy()
        assistant = work[work["_role"].eq("assistant")].copy()
    else:
        user = work.copy()
        assistant = work.iloc[0:0].copy()

    if user.empty:
        raise RuntimeError("No user/customer turns were found.")

    user["text"] = user["_raw"].map(
        lambda value: extract_customer_problem(value, name_regex)
    )
    user["text"], user_repaired, user_blanked = repair_residual_pii(
        user["text"]
    )
    user = user[user["text"].str.len().ge(3)].reset_index(drop=True)

    if user.empty:
        raise RuntimeError(
            "No usable customer problem statements remain after cleaning."
        )

    if not assistant.empty:
        assistant["text"] = assistant["_raw"].map(
            lambda value: scrub(value, name_regex).replace(REDACT, " ")
        )
        assistant["text"], assistant_repaired, assistant_blanked = repair_residual_pii(
            assistant["text"]
        )
        assistant = assistant[assistant["text"].str.len().ge(3)].reset_index(drop=True)
    else:
        assistant_repaired = 0
        assistant_blanked = 0

    quality = {
        "input_rows": int(len(work)),
        "role_counts": {
            str(key): int(value)
            for key, value in work["_role"].value_counts().items()
        },
        "name_tokens_blocked_from_development": int(len(blocked_names)),
        "name_tokens_released": int(released_count),
        "customer_rows_repaired": int(user_repaired),
        "customer_rows_blanked": int(user_blanked),
        "assistant_rows_repaired": int(assistant_repaired),
        "assistant_rows_blanked": int(assistant_blanked),
        "customer_rows_after_cleaning": int(len(user)),
        "assistant_rows_after_cleaning": int(len(assistant)),
        "distinct_customer_problems": int(user["text"].nunique()),
    }

    log(json.dumps(quality, indent=2))
    return user, assistant, quality


