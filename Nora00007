# Schema and raw frame
# ---------------------------------------------------------------------------

def normalise_key(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "_", str(value).strip().lower()).strip("_")


def is_identifier_key(key: str) -> bool:
    normalised = normalise_key(key)
    return any(
        re.search(pattern, normalised)
        for _, pattern in IDENTIFIER_FIELD_PATTERNS
    )


def find_column(
    columns: Sequence[str],
    patterns: Sequence[str],
    exclude: Sequence[str] = (),
) -> Optional[str]:
    for pattern in patterns:
        for column in columns:
            name = normalise_key(column)
            if any(re.search(item, name) for item in exclude):
                continue
            if re.search(pattern, name):
                return column
    return None


def discover_schema(df: pd.DataFrame) -> Dict[str, Optional[str]]:
    columns = list(df.columns)
    return {
        "case": find_column(
            columns,
            [r"^source_row$", r"source.*row", r"^row_?id$"],
        ),
        "turn": find_column(
            columns,
            [r"message_index", r"turn.*index", r"^index$", r"^seq"],
        ),
        "conversation": find_column(
            columns,
            [r"data_cid$", r"(^|_)cid$", r"conversation.*id"],
        ),
        "text": find_column(
            columns,
            [r"data_content$", r"content$", r"message.*text", r"^text$", r"utterance"],
        ),
        "role": find_column(
            columns,
            [r"^message_type$", r"message_type$", r"data_type$", r"^role$", r"speaker"],
        ),
        "turn_label": find_column(
            columns,
            [r"data_label$", r"(^|_)label$", r"turn.*intent"],
            exclude=[r"predict"],
        ),
        "case_label": find_column(
            columns,
            [r"classification.*intent", r"case.*intent", r"conversation.*intent"],
        ),
    }


def profile_columns(
    df: pd.DataFrame,
    schema: Dict[str, Optional[str]],
) -> List[Dict[str, Any]]:
    resolved = {column: role for role, column in schema.items() if column}
    rows: List[Dict[str, Any]] = []

    for column in df.columns:
        series = df[column].dropna().astype(str)
        series = series[series.str.strip().ne("")]
        rows.append({
            "column": column,
            "resolved_role": resolved.get(column, ""),
            "fill_pct": pct(len(series), len(df)),
            "distinct": int(series.nunique()),
            "median_chars": int(series.str.len().median()) if len(series) else 0,
            "max_chars": int(series.str.len().max()) if len(series) else 0,
        })

    return rows


def load_input(
    config: RunConfig,
) -> Tuple[pd.DataFrame, Dict[str, Optional[str]]]:
    log("\n[1/10] Loading input and resolving schema")

    path = Path(config.input_path)
    if not path.is_file():
        raise FileNotFoundError(f"Input CSV not found: {path}")

    df = pd.read_csv(
        path,
        dtype=str,
        keep_default_na=False,
        na_values=["", "NA", "NaN", "null", "None", "nan"],
        low_memory=False,
    )

    if config.sample_rows and config.sample_rows < len(df):
        df = df.sample(
            config.sample_rows,
            random_state=config.seed,
        ).reset_index(drop=True)

    schema = discover_schema(df)
    if not schema["text"]:
        raise RuntimeError(
            "No message-content column could be resolved from the CSV header."
        )

    log(f"  rows={len(df):,} columns={len(df.columns)}")
    for role, column in schema.items():
        log(f"  {role:<13} -> {column}")

    return df, schema


def prepare_raw_frame(
    df: pd.DataFrame,
    schema: Dict[str, Optional[str]],
) -> pd.DataFrame:
    work = df.copy()
    text_col = schema["text"]
    role_col = schema["role"]

    work["_raw"] = (
        work[text_col]
        .fillna("")
        .astype(str)
        .str.replace(r"\\r", " ", regex=True)
        .str.replace(r"\\n", "\n", regex=True)
    )

    if role_col:
        work["_role"] = (
            work[role_col]
            .fillna("unknown")
            .astype(str)
            .str.strip()
            .str.lower()
        )
    else:
        work["_role"] = "unknown"

    return work


# ---------------------------------------------------------------------------
# Locked split
# ---------------------------------------------------------------------------

def resolve_label_and_group(
    schema: Dict[str, Optional[str]],
) -> Tuple[Optional[str], Optional[str]]:
    label_col = schema.get("case_label") or schema.get("turn_label")
    group_col = schema.get("case") or schema.get("conversation")
    return label_col, group_col


def create_group_key(
    frame: pd.DataFrame,
    group_col: Optional[str],
) -> pd.Series:
    if group_col:
        groups = frame[group_col].fillna("").astype(str).str.strip().copy()
        missing = groups.eq("")
        if missing.any():
            groups.loc[missing] = [
                f"missing_group_{index}"
                for index in frame.index[missing]
            ]
        return groups

    return pd.Series(
        [f"row_{index}" for index in frame.index],
        index=frame.index,
        dtype=str,
    )


def create_locked_split(
    work: pd.DataFrame,
    schema: Dict[str, Optional[str]],
    config: RunConfig,
) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    """
    Create one stratified group-level 80/20 split.

    The split is learned from labelled customer groups and then propagated to
    every row in those groups, including unlabelled customer turns and assistant
    turns. This prevents a held-out case leaking back through another turn.
    """
    log("\n[2/10] Creating locked 80/20 development-test split")

    frame = work.copy()
    frame["data_split"] = "unlabelled"

    label_col, group_col = resolve_label_and_group(schema)
    frame["group_key"] = create_group_key(frame, group_col)

    if not label_col:
        return frame, {
            "status": "skipped",
            "reason": "no_existing_label_column",
        }

    labels = frame[label_col].fillna("").astype(str).str.strip()
    customer_mask = frame["_role"].eq("user") if schema.get("role") else pd.Series(
        True, index=frame.index
    )
    labelled_customer = customer_mask & labels.ne("")

    if labelled_customer.sum() < 30 or labels.loc[labelled_customer].nunique() < 2:
        return frame, {
            "status": "skipped",
            "reason": "insufficient_labelled_customer_variation",
        }

    labelled_table = pd.DataFrame({
        "group": frame.loc[labelled_customer, "group_key"].to_numpy(),
        "label": labels.loc[labelled_customer].to_numpy(),
    })

    labels_per_group = labelled_table.groupby("group")["label"].nunique()
    conflicting_groups = set(
        labels_per_group[labels_per_group.gt(1)].index.tolist()
    )

    consistent = labelled_table[
        ~labelled_table["group"].isin(conflicting_groups)
    ]

    group_table = (
        consistent[["group", "label"]]
        .drop_duplicates("group")
        .reset_index(drop=True)
    )

    if group_table["label"].nunique() < 2:
        return frame, {
            "status": "skipped",
            "reason": "fewer_than_two_consistent_classes",
            "conflicting_groups": int(len(conflicting_groups)),
        }

    groups_per_class = group_table["label"].value_counts()
    if int(groups_per_class.min()) < 2:
        return frame, {
            "status": "skipped",
            "reason": "fewer_than_two_independent_groups_in_a_class",
            "groups_per_class": {
                str(key): int(value)
                for key, value in groups_per_class.items()
            },
        }

    splitter = StratifiedShuffleSplit(
        n_splits=1,
        test_size=config.test_size,
        random_state=config.seed,
    )

    try:
        development_pos, test_pos = next(
            splitter.split(
                np.zeros(len(group_table)),
                group_table["label"].to_numpy(),
            )
        )
    except ValueError as exc:
        raise RuntimeError(
            "Unable to create a stratified group split. "
            "Check class counts at case/conversation level."
        ) from exc

    development_groups = set(
        group_table.iloc[development_pos]["group"].tolist()
    )
    locked_test_groups = set(
        group_table.iloc[test_pos]["group"].tolist()
    )

    # Important: propagate split to every row in a group, not only labelled rows.
    frame.loc[
        frame["group_key"].isin(development_groups),
        "data_split",
    ] = "development"

    frame.loc[
        frame["group_key"].isin(locked_test_groups),
        "data_split",
    ] = "locked_test"

    frame.loc[
        frame["group_key"].isin(conflicting_groups),
        "data_split",
    ] = "excluded_conflict"

    customer_supervised = (
        customer_mask
        & frame["data_split"].isin(["development", "locked_test"])
        & labels.ne("")
    )
    total_supervised = int(customer_supervised.sum())

    development_rows = int(
        (customer_supervised & frame["data_split"].eq("development")).sum()
    )
    test_rows = int(
        (customer_supervised & frame["data_split"].eq("locked_test")).sum()
    )

    metrics = {
        "status": "completed",
        "label_column": label_col,
        "grouping_column": group_col or "row_index",
        "protocol": {
            "development_target_pct": 80.0,
            "locked_test_target_pct": 20.0,
            "cv_folds_inside_development": int(config.cv_splits),
            "approximate_per_cv_fold_pct_of_total": {
                "train": 64.0,
                "validation": 16.0,
                "locked_test": 20.0,
            },
            "note": (
                "The hold-out split is group-aware. Labels are used only to "
                "stratify the split; test text/features are not used for fitting."
            ),
        },
        "development_groups": int(len(development_groups)),
        "locked_test_groups": int(len(locked_test_groups)),
        "conflicting_groups_excluded": int(len(conflicting_groups)),
        "customer_supervised_rows": {
            "development": development_rows,
            "locked_test": test_rows,
        },
        "customer_supervised_row_pct": {
            "development": pct(development_rows, total_supervised),
            "locked_test": pct(test_rows, total_supervised),
        },
    }

    log(json.dumps(metrics["customer_supervised_row_pct"], indent=2))
    return frame, metrics


