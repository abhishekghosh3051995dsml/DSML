# Privacy controls. These patterns are not used as predictive/model features.
IDENTIFIER_FIELD_PATTERNS: Sequence[Tuple[str, str]] = (
    ("name", r"^(?:(?:customer|contact|account|subscriber|caller|first|last|full)_?)?name$"),
    ("email", r"^(?:e_?mail|email_?address)$"),
    ("phone", r"^(?:phone|phone_?number|mobile_?number|contact_?number|msisdn|"
              r"call_?back(?:_?number)?|callback(?:_?number)?|number_?with_?issue)$"),
    ("imei", r"^imei(?:_?number)?$"),
    ("iccid", r"^(?:iccid|sim_?serial(?:_?number)?)$"),
    ("eid", r"^(?:eid|euicc(?:_?id)?)$"),
    ("ban", r"^(?:ban|billing_?account(?:_?number)?|account_?number|acct_?number)$"),
    ("address", r"^(?:address|street(?:_?address)?|zip|zip_?code|postal(?:_?code)?)$"),
    ("reference", r"^(?:cid|uuid|guid|ticket(?:_?number)?|case_?number|order_?number)$"),
)

FIELD_LINE_RE = re.compile(
    r"(?m)^[ \t\-\*#>]*(?P<key>[A-Za-z][A-Za-z0-9 _\-/#\.]{1,60}?)"
    r"\s*:\s*(?P<value>.*)$"
)

NAME_CUE_RE = re.compile(
    r"(?i)\b(?:customer\s*name|customername|contact\s*name|account\s*name|"
    r"caller|cust\s*name|first\s*name|last\s*name|full\s*name)\s*[:\-]\s*"
    r"(?P<value>[A-Za-z][A-Za-z'\-]{1,24}"
    r"(?:\s+[A-Za-z][A-Za-z'\-]{1,24}){0,4})"
)

PII_PATTERNS: Sequence[Tuple[str, re.Pattern]] = (
    ("url", re.compile(r"https?://\S+", re.I)),
    ("email", re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b")),
    ("ipv4", re.compile(
        r"\b(?:(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\.){3}"
        r"(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\b"
    )),
    ("uuid", re.compile(
        r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
        r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b"
    )),
    ("eid", re.compile(r"\b[0-9a-fA-F]{32}\b")),
    ("iccid", re.compile(r"\b89\d{17,20}\b")),
    ("imei", re.compile(r"\b\d{14,17}\b")),
    ("phone", re.compile(
        r"(?<!\d)(?:\+?\d{1,3}[\s\-.]?)?\(?\d{3}\)?[\s\-.]?"
        r"\d{3}[\s\-.]?\d{4}(?!\d)"
    )),
    ("long_number", re.compile(r"(?<!\d)\d{7,}(?!\d)")),
    ("latlon", re.compile(r"(?<![\w.])-?\d{1,3}\.\d{4,}(?![\w.])")),
)

ADDRESS_RE = re.compile(
    r"\b\d{1,6}\s+(?:[A-Za-z0-9.'\-]+\s+){0,5}"
    r"(?:st|street|rd|road|ave|avenue|blvd|boulevard|ln|lane|dr|drive|"
    r"ct|court|way|pl|place|ter|terrace|pkwy|parkway|hwy|highway|"
    r"cir|circle|apt|suite|ste|unit)\b\.?",
    re.I,
)

SENTENCE_RE = re.compile(r"(?<=[.!?;])\s+|\n+")

# These markers are used only to exploit explicit assistant response structure.
# They do not classify free text semantically.
SECTION_MARKER_RE = re.compile(
    r"(?i)\b(?P<header>"
    r"root\s*cause(?:\s*analysis)?|"
    r"probable\s*cause|"
    r"likely\s*cause|"
    r"recommendations?|"
    r"remediation|"
    r"resolution|"
    r"next\s*steps?|"
    r"diagnostic(?:\s*checks?)?|"
    r"limitations?"
    r")\s*[:\-]\s*"
)

REDACT = "[redacted]"


