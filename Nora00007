def horizontal_bar(
    labels: Sequence[Any],
    values: Sequence[float],
    xlabel: str,
    title: str,
    path: Path,
) -> None:
    if not len(labels):
        return

    figure, axis = plt.subplots(
        figsize=(8, max(2.0, 0.32 * len(labels) + 1))
    )
    positions = np.arange(len(labels))

    axis.barh(positions, values, height=0.7)
    axis.set_yticks(positions)
    axis.set_yticklabels([str(item)[:64] for item in labels])
    axis.invert_yaxis()
    axis.set_xlabel(xlabel)
    axis.set_title(title, loc="left", fontweight="bold")

    for position, value in enumerate(values):
        axis.text(
            value,
            position,
            f" {value:,.4g}",
            va="center",
            fontsize=8,
        )

    figure.tight_layout()
    figure.savefig(path, bbox_inches="tight", dpi=130)
    plt.close(figure)


def save_charts(
    outdir: Path,
    split_metrics: Dict[str, Any],
    classifier_metrics: Dict[str, Any],
    topic_metrics: Dict[str, Any],
    entity_cluster_table: pd.DataFrame,
    assistant_frame: pd.DataFrame,
) -> None:
    outdir.mkdir(parents=True, exist_ok=True)

    split_rows = split_metrics.get("customer_supervised_rows", {})
    if split_rows:
        horizontal_bar(
            ["development", "locked_test"],
            [
                float(split_rows.get("development", 0)),
                float(split_rows.get("locked_test", 0)),
            ],
            "labelled customer rows",
            "Development / locked-test split",
            outdir / "split_distribution.png",
        )

    topics = topic_metrics.get("topics") or []
    topics = [
        item
        for item in topics
        if int(item.get("topic_id", -1)) != -1
    ]
    topics = sorted(
        topics,
        key=lambda item: -int(item.get("count", 0)),
    )[:25]

    if topics:
        horizontal_bar(
            [item.get("descriptor", "") for item in topics],
            [float(item.get("count", 0)) for item in topics],
            "distinct development statements",
            "Largest detailed-intent clusters",
            outdir / "topic_sizes.png",
        )

    matrix_block = (
        classifier_metrics.get("locked_test", {}).get("confusion_matrix")
        if classifier_metrics.get("status") == "completed"
        else None
    )

    if matrix_block and matrix_block.get("matrix"):
        matrix = np.asarray(matrix_block["matrix"], dtype=float)
        names = list(matrix_block["labels"])
        normalised = matrix / np.clip(
            matrix.sum(axis=1, keepdims=True),
            1,
            None,
        )

        figure, axis = plt.subplots(
            figsize=(
                1.4 * len(names) + 2.5,
                1.2 * len(names) + 2,
            )
        )

        image = axis.imshow(
            normalised,
            vmin=0,
            vmax=1,
            aspect="auto",
        )
        axis.set_xticks(range(len(names)))
        axis.set_xticklabels(names, rotation=30, ha="right")
        axis.set_yticks(range(len(names)))
        axis.set_yticklabels(names)
        axis.set_xlabel("predicted")
        axis.set_ylabel("actual")
        axis.grid(False)
        axis.set_title("Locked test confusion", loc="left", fontweight="bold")

        for row in range(len(names)):
            for column in range(len(names)):
                axis.text(
                    column,
                    row,
                    f"{normalised[row, column]:.2f}",
                    ha="center",
                    va="center",
                    fontsize=9,
                )

        figure.colorbar(image, ax=axis, fraction=0.04, pad=0.03)
        figure.tight_layout()
        figure.savefig(
            outdir / "confusion_matrix.png",
            bbox_inches="tight",
            dpi=130,
        )
        plt.close(figure)

    if isinstance(entity_cluster_table, pd.DataFrame) and not entity_cluster_table.empty:
        top = (
            entity_cluster_table
            .sort_values("messages_with_cluster", ascending=False)
            .head(25)
        )
        horizontal_bar(
            top["descriptor"].tolist(),
            top["messages_with_cluster"].astype(float).tolist(),
            "customer messages",
            "Largest entity/context candidate clusters",
            outdir / "entity_cluster_sizes.png",
        )

    if isinstance(assistant_frame, pd.DataFrame) and not assistant_frame.empty:
        counts = (
            assistant_frame[
                assistant_frame["finding_cluster_id"].ne(-1)
            ]["finding_descriptor"]
            .value_counts()
            .head(25)
        )
        if len(counts):
            horizontal_bar(
                counts.index.tolist(),
                counts.astype(float).tolist(),
                "assistant sentence units",
                "Largest assistant finding clusters",
                outdir / "assistant_cluster_sizes.png",
            )


def write_csv(
    path: Path,
    frame: pd.DataFrame,
    columns: Optional[Sequence[str]] = None,
) -> None:
    if frame.empty and columns:
        pd.DataFrame(columns=list(columns)).to_csv(path, index=False)
    else:
        frame.to_csv(path, index=False)


def write_tables(
    outdir: Path,
    user: pd.DataFrame,
    entity_candidates: Sequence[Dict[str, List[Dict[str, Any]]]],
    entity_cluster_table: pd.DataFrame,
    assistant_frame: pd.DataFrame,
    topic_metrics: Dict[str, Any],
    split_metrics: Dict[str, Any],
) -> None:
    outdir.mkdir(parents=True, exist_ok=True)

    customer_columns = [
        column
        for column in [
            "text",
            "data_split",
            "group_key",
            "topic_id",
            "detailed_intent",
            "topic_membership_score",
            "predicted_intent",
            "prediction_score",
            "prediction_source",
        ]
        if column in user.columns
    ]
    user[customer_columns].to_csv(
        outdir / "customer_turns.csv",
        index=False,
    )

    entity_rows: List[Dict[str, Any]] = []
    for row_index, found in enumerate(entity_candidates):
        for cluster_key, values in (found or {}).items():
            for item in values:
                entity_rows.append({
                    "row": int(row_index),
                    "concept_cluster": cluster_key,
                    **item,
                })

    write_csv(
        outdir / "entity_candidates.csv",
        pd.DataFrame(entity_rows),
        columns=[
            "row",
            "concept_cluster",
            "value",
            "tfidf_weight",
            "cluster_membership_score",
            "cluster_descriptor",
        ],
    )

    write_csv(
        outdir / "entity_clusters.csv",
        entity_cluster_table,
        columns=[
            "cluster_id",
            "descriptor",
            "candidate_phrase_count",
            "messages_with_cluster",
            "message_coverage_pct",
        ],
    )

    topic_rows = [
        {
            "topic_id": item.get("topic_id"),
            "count": item.get("count"),
            "descriptor": item.get("descriptor"),
        }
        for item in (topic_metrics.get("topics") or [])
    ]
    write_csv(
        outdir / "topics.csv",
        pd.DataFrame(topic_rows),
        columns=["topic_id", "count", "descriptor"],
    )

    split_rows = split_metrics.get("customer_supervised_rows", {})
    split_table = pd.DataFrame([
        {
            "split": key,
            "rows": int(value),
        }
        for key, value in split_rows.items()
    ])
    write_csv(
        outdir / "split_summary.csv",
        split_table,
        columns=["split", "rows"],
    )

    assistant_columns = [
        "assistant_row",
        "sentence_index",
        "case",
        "conversation_id",
        "link_key",
        "group_key",
        "data_split",
        "structural_role",
        "sentence",
        "finding_cluster_id",
        "finding_cluster_score",
        "finding_descriptor",
    ]
    write_csv(
        outdir / "assistant_findings.csv",
        assistant_frame,
        columns=assistant_columns,
    )

    role_files = {
        "root_cause": "rca.csv",
        "remediation": "remediation.csv",
        "diagnostic_check": "diagnostics.csv",
        "limitation": "limitations.csv",
    }

    for role, filename in role_files.items():
        if assistant_frame.empty:
            subset = pd.DataFrame(columns=assistant_columns)
        else:
            subset = assistant_frame[
                assistant_frame["structural_role"].eq(role)
            ]
        write_csv(
            outdir / filename,
            subset,
            columns=assistant_columns,
        )


