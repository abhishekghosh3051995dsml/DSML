def parse_args(
    argv: Optional[Sequence[str]] = None,
) -> Tuple[RunConfig, Path]:
    parser = argparse.ArgumentParser(
        description="NORA offline ML/NLP intent analysis"
    )

    parser.add_argument("--input", required=True, dest="input_path")
    parser.add_argument("--output-json", default="nora_dictionary.json")
    parser.add_argument("--outdir", default="nora_out")
    parser.add_argument("--seed", type=int, default=DEFAULT_SEED)
    parser.add_argument("--sample", type=int, default=0, dest="sample_rows")
    parser.add_argument("--test-size", type=float, default=0.20)
    parser.add_argument("--cv-splits", type=int, default=5)

    parser.add_argument("--word-max-features", type=int, default=30000)
    parser.add_argument("--char-max-features", type=int, default=30000)

    parser.add_argument("--topic-svd-components", type=int, default=128)
    parser.add_argument(
        "--topic-min-cluster-size",
        type=int,
        default=0,
        help="0 = derive from development corpus size",
    )
    parser.add_argument(
        "--topic-umap-neighbors",
        type=int,
        default=0,
        help="0 = derive from development corpus size",
    )
    parser.add_argument("--topic-max-k", type=int, default=30)

    parser.add_argument("--entity-max-features", type=int, default=12000)
    parser.add_argument("--entity-top-phrases", type=int, default=12)
    parser.add_argument(
        "--entity-max-values-per-cluster",
        type=int,
        default=3,
    )
    parser.add_argument(
        "--entity-min-cluster-size",
        type=int,
        default=0,
    )
    parser.add_argument("--entity-max-k", type=int, default=30)

    parser.add_argument("--assistant-svd-components", type=int, default=96)
    parser.add_argument(
        "--assistant-min-cluster-size",
        type=int,
        default=0,
    )
    parser.add_argument("--assistant-max-k", type=int, default=30)
    parser.add_argument(
        "--max-sentences-per-message",
        type=int,
        default=40,
    )
    parser.add_argument("--skip-assistant", action="store_true")

    args = parser.parse_args(argv)

    if not 0.05 <= args.test_size <= 0.50:
        parser.error("--test-size must be between 0.05 and 0.50")
    if args.cv_splits < 2:
        parser.error("--cv-splits must be at least 2")
    if args.word_max_features < 100:
        parser.error("--word-max-features must be at least 100")
    if args.char_max_features < 100:
        parser.error("--char-max-features must be at least 100")
    if args.topic_svd_components < 2:
        parser.error("--topic-svd-components must be at least 2")
    if args.entity_max_features < 100:
        parser.error("--entity-max-features must be at least 100")
    if args.entity_top_phrases < 1:
        parser.error("--entity-top-phrases must be at least 1")
    if args.entity_max_values_per_cluster < 1:
        parser.error("--entity-max-values-per-cluster must be at least 1")
    if args.max_sentences_per_message < 1:
        parser.error("--max-sentences-per-message must be at least 1")

    fields = dict(vars(args))
    outdir = Path(fields.pop("outdir"))

    return RunConfig(**fields), outdir


def main(
    argv: Optional[Sequence[str]] = None,
) -> int:
    warnings.filterwarnings("once")

    config, outdir = parse_args(argv)
    outdir.mkdir(parents=True, exist_ok=True)

    output_path = Path(config.output_json)
    if not output_path.is_absolute() and output_path.parent == Path("."):
        output_path = outdir / output_path.name
    output_path.parent.mkdir(parents=True, exist_ok=True)

    log("=" * 80)
    log("NORA OFFLINE ML/NLP INTENT ANALYSIS v2")
    log("=" * 80)
    log(f"input  : {Path(config.input_path).resolve()}")
    log(f"output : {output_path.resolve()}")
    log(f"review : {outdir.resolve()}")

    df, schema = load_input(config)
    profile = profile_columns(df, schema)

    work = prepare_raw_frame(df, schema)
    work, split_metrics = create_locked_split(
        work,
        schema,
        config,
    )

    user, assistant, quality = build_corpora(
        work,
        schema,
    )

    user, classifier_metrics = evaluate_broad_intent(
        user,
        schema,
        config,
    )

    user, topic_metrics, representation = discover_detailed_intents(
        user,
        config,
    )

    entity_candidates, entity_summary, entity_cluster_table = (
        discover_entity_candidates(
            user,
            representation,
            config,
        )
    )

    assistant_frame, assistant_summary = discover_assistant_findings(
        assistant,
        schema,
        config,
    )

    alignment = topic_label_alignment(
        user,
        schema,
    )

    save_charts(
        outdir,
        split_metrics,
        classifier_metrics,
        topic_metrics,
        entity_cluster_table,
        assistant_frame,
    )

    write_tables(
        outdir,
        user,
        entity_candidates,
        entity_cluster_table,
        assistant_frame,
        topic_metrics,
        split_metrics,
    )

    payload = build_dictionary(
        config=config,
        df=df,
        schema=schema,
        profile=profile,
        quality=quality,
        split_metrics=split_metrics,
        classifier_metrics=classifier_metrics,
        topic_metrics=topic_metrics,
        entity_summary=entity_summary,
        assistant_summary=assistant_summary,
        assistant_frame=assistant_frame,
        alignment=alignment,
        user=user,
        entity_candidates=entity_candidates,
    )

    with output_path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            indent=2,
            ensure_ascii=False,
        )

    log("\n[10/10] COMPLETE")
    log(f"  dictionary : {output_path.resolve()}")
    log(f"  review dir : {outdir.resolve()}")
    log(f"  records    : {len(payload['records']):,}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
