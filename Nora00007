def build_text_vectorizer(
    config: RunConfig,
    min_word_df: int,
    min_char_df: int,
) -> FeatureUnion:
    return FeatureUnion([
        (
            "word",
            TfidfVectorizer(
                analyzer="word",
                lowercase=True,
                strip_accents="unicode",
                stop_words="english",
                ngram_range=(1, 2),
                min_df=min_word_df,
                max_df=0.95,
                max_features=config.word_max_features,
                sublinear_tf=True,
                norm="l2",
            ),
        ),
        (
            "char",
            TfidfVectorizer(
                analyzer="char_wb",
                lowercase=True,
                strip_accents="unicode",
                ngram_range=(3, 5),
                min_df=min_char_df,
                max_features=config.char_max_features,
                sublinear_tf=True,
                norm="l2",
            ),
        ),
    ])


def fit_classifier_vectorizer(
    texts: Sequence[str],
    config: RunConfig,
) -> Tuple[FeatureUnion, Any]:
    min_word_df = 2 if len(texts) >= 50 else 1
    min_char_df = 3 if len(texts) >= 100 else 1

    vectorizer = build_text_vectorizer(
        config,
        min_word_df=min_word_df,
        min_char_df=min_char_df,
    )
    matrix = vectorizer.fit_transform(list(texts))
    return vectorizer, matrix


def new_classifier(
    seed: int,
) -> LogisticRegression:
    return LogisticRegression(
        max_iter=4000,
        class_weight="balanced",
        solver="liblinear",
        random_state=seed,
    )


def choose_cv_splits(
    labels: np.ndarray,
    groups: np.ndarray,
    requested: int,
) -> int:
    table = pd.DataFrame({
        "label": labels,
        "group": groups,
    }).drop_duplicates()

    if table["label"].nunique() < 2:
        return 0

    minimum_groups = int(
        table.groupby("label")["group"].nunique().min()
    )
    return max(
        0,
        min(
            requested,
            minimum_groups,
            int(table["group"].nunique()),
        ),
    )


def evaluate_broad_intent(
    user: pd.DataFrame,
    schema: Dict[str, Optional[str]],
    config: RunConfig,
) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    log("\n[4/10] Broad-intent supervised ML")

    frame = user.copy()
    frame["predicted_intent"] = ""
    frame["prediction_score"] = np.nan
    frame["prediction_source"] = "not_scored"

    label_col, _ = resolve_label_and_group(schema)
    if not label_col:
        return frame, {
            "status": "skipped",
            "reason": "no_existing_label_column",
        }

    labels = frame[label_col].fillna("").astype(str).str.strip()

    development_mask = frame["data_split"].eq("development") & labels.ne("")
    test_mask = frame["data_split"].eq("locked_test") & labels.ne("")

    if development_mask.sum() < 30 or test_mask.sum() < 5:
        return frame, {
            "status": "skipped",
            "reason": "insufficient_development_or_test_rows",
        }

    development_label_table = pd.DataFrame({
        "text": frame.loc[development_mask, "text"].astype(str),
        "label": labels.loc[development_mask],
    })
    labels_per_text = development_label_table.groupby("text")["label"].nunique()
    conflicting_texts = set(
        labels_per_text[labels_per_text.gt(1)].index.tolist()
    )

    eligible_development = (
        development_mask
        & ~frame["text"].isin(conflicting_texts)
    )

    dev_pool = (
        frame.loc[eligible_development]
        .drop_duplicates("text")
        .index
        .to_numpy()
    )

    if len(dev_pool) < 30:
        return frame, {
            "status": "skipped",
            "reason": "insufficient_consistent_unique_development_examples",
        }

    dev_texts = frame.loc[dev_pool, "text"].astype(str).to_numpy()
    dev_labels_raw = labels.loc[dev_pool].to_numpy()

    encoder = LabelEncoder()
    dev_y = encoder.fit_transform(dev_labels_raw)
    dev_groups = (
        frame.loc[dev_pool, "group_key"]
        .astype(str)
        .to_numpy(dtype=object)
    )

    n_splits = choose_cv_splits(
        dev_y,
        dev_groups,
        config.cv_splits,
    )
    if n_splits < 2:
        return frame, {
            "status": "skipped",
            "reason": "insufficient_independent_groups_for_cv",
        }

    if StratifiedGroupKFold is not None:
        splitter = StratifiedGroupKFold(
            n_splits=n_splits,
            shuffle=True,
            random_state=config.seed,
        )
    else:
        splitter = GroupKFold(n_splits=n_splits)

    oof_pred = np.full(len(dev_pool), -1, dtype=int)
    oof_score = np.full(len(dev_pool), np.nan, dtype=float)
    fold_metrics: List[Dict[str, Any]] = []

    for fold, (train_pos, validation_pos) in enumerate(
        splitter.split(dev_texts, dev_y, dev_groups),
        start=1,
    ):
        if len(np.unique(dev_y[train_pos])) != len(encoder.classes_):
            continue

        vectorizer, x_train = fit_classifier_vectorizer(
            dev_texts[train_pos],
            config,
        )
        x_validation = vectorizer.transform(
            dev_texts[validation_pos]
        )

        classifier = new_classifier(config.seed)
        classifier.fit(x_train, dev_y[train_pos])

        prediction = classifier.predict(x_validation)
        probability = classifier.predict_proba(x_validation)

        oof_pred[validation_pos] = prediction
        oof_score[validation_pos] = probability.max(axis=1)

        fold_metrics.append({
            "fold": int(fold),
            "train_rows": int(len(train_pos)),
            "validation_rows": int(len(validation_pos)),
            "balanced_accuracy": float(
                balanced_accuracy_score(dev_y[validation_pos], prediction)
            ),
            "macro_f1": float(
                f1_score(
                    dev_y[validation_pos],
                    prediction,
                    average="macro",
                    zero_division=0,
                )
            ),
        })

    scored = oof_pred >= 0
    cv_summary = None

    if scored.any():
        cv_summary = {
            "splits": int(n_splits),
            "evaluated_unique_development_problems": int(scored.sum()),
            "balanced_accuracy": float(
                balanced_accuracy_score(
                    dev_y[scored],
                    oof_pred[scored],
                )
            ),
            "macro_f1": float(
                f1_score(
                    dev_y[scored],
                    oof_pred[scored],
                    average="macro",
                    zero_division=0,
                )
            ),
            "fold_metrics": fold_metrics,
        }

        oof_lookup = {
            str(dev_texts[position]): (
                str(encoder.inverse_transform([oof_pred[position]])[0]),
                float(oof_score[position]),
            )
            for position in np.flatnonzero(scored)
        }

        for index in frame.index[frame["data_split"].eq("development")]:
            item = oof_lookup.get(str(frame.at[index, "text"]))
            if item is not None:
                frame.at[index, "predicted_intent"] = item[0]
                frame.at[index, "prediction_score"] = item[1]
                frame.at[index, "prediction_source"] = "development_oof"

    # Everything below is frozen on development before test text is transformed.
    final_vectorizer, x_development = fit_classifier_vectorizer(
        dev_texts,
        config,
    )
    final_classifier = new_classifier(config.seed)
    final_classifier.fit(x_development, dev_y)

    development_text_set = set(dev_texts.tolist())
    test_pool = (
        frame.loc[test_mask]
        .drop_duplicates("text")
        .index
        .to_numpy()
    )

    duplicate_test_mask = np.asarray([
        str(frame.at[index, "text"]) in development_text_set
        for index in test_pool
    ])
    clean_test_pool = test_pool[~duplicate_test_mask]

    if len(clean_test_pool) == 0:
        return frame, {
            "status": "skipped",
            "reason": "all_locked_test_texts_duplicate_development_texts",
            "cross_validation": cv_summary,
        }

    test_labels_raw = labels.loc[clean_test_pool].to_numpy()
    unseen_test_classes = sorted(
        set(test_labels_raw) - set(encoder.classes_)
    )
    if unseen_test_classes:
        return frame, {
            "status": "skipped",
            "reason": "locked_test_contains_class_absent_from_development",
            "unseen_test_classes": unseen_test_classes,
            "cross_validation": cv_summary,
        }

    test_y = encoder.transform(test_labels_raw)
    test_texts = frame.loc[clean_test_pool, "text"].astype(str).to_numpy()

    x_test = final_vectorizer.transform(test_texts)
    test_prediction = final_classifier.predict(x_test)
    test_probability = final_classifier.predict_proba(x_test)

    test_metrics = {
        "accuracy": float(accuracy_score(test_y, test_prediction)),
        "balanced_accuracy": float(
            balanced_accuracy_score(test_y, test_prediction)
        ),
        "macro_f1": float(
            f1_score(
                test_y,
                test_prediction,
                average="macro",
                zero_division=0,
            )
        ),
        "weighted_f1": float(
            f1_score(
                test_y,
                test_prediction,
                average="weighted",
                zero_division=0,
            )
        ),
    }

    label_ids = np.arange(len(encoder.classes_))
    report = classification_report(
        test_y,
        test_prediction,
        labels=label_ids,
        target_names=encoder.classes_,
        output_dict=True,
        zero_division=0,
    )
    matrix = confusion_matrix(
        test_y,
        test_prediction,
        labels=label_ids,
    )

    test_lookup = {
        str(text): (
            str(encoder.inverse_transform([prediction])[0]),
            float(score),
        )
        for text, prediction, score in zip(
            test_texts,
            test_prediction,
            test_probability.max(axis=1),
        )
    }

    for index in frame.index[frame["data_split"].eq("locked_test")]:
        text = str(frame.at[index, "text"])
        item = test_lookup.get(text)

        if item is not None:
            frame.at[index, "predicted_intent"] = item[0]
            frame.at[index, "prediction_score"] = item[1]
            frame.at[index, "prediction_source"] = "locked_test"
        elif text in development_text_set:
            x_row = final_vectorizer.transform([text])
            row_probability = final_classifier.predict_proba(x_row)
            row_prediction = row_probability.argmax(axis=1)
            frame.at[index, "predicted_intent"] = str(
                encoder.inverse_transform(row_prediction)[0]
            )
            frame.at[index, "prediction_score"] = float(row_probability.max())
            frame.at[index, "prediction_source"] = (
                "locked_test_duplicate_seen_in_development"
            )

    remaining = frame.index[
        frame["prediction_source"].eq("not_scored")
    ]

    if len(remaining):
        remaining_texts = frame.loc[remaining, "text"].astype(str).tolist()
        x_remaining = final_vectorizer.transform(remaining_texts)
        remaining_probability = final_classifier.predict_proba(x_remaining)
        remaining_prediction = remaining_probability.argmax(axis=1)

        frame.loc[remaining, "predicted_intent"] = encoder.inverse_transform(
            remaining_prediction
        )
        frame.loc[remaining, "prediction_score"] = remaining_probability.max(axis=1)
        frame.loc[remaining, "prediction_source"] = "development_model_inference"

    metrics = {
        "status": "completed",
        "label_column": label_col,
        "classes": encoder.classes_.tolist(),
        "feature_representation": (
            "word and character TF-IDF; every CV fold fits its own vocabulary"
        ),
        "classifier": "class-balanced Logistic Regression",
        "development_protocol": {
            "development_target_pct": 80.0,
            "cv_splits": int(n_splits),
            "approximate_train_pct_per_fold_of_total": 64.0,
            "approximate_validation_pct_per_fold_of_total": 16.0,
        },
        "locked_test_protocol": {
            "target_pct": 20.0,
            "fit_on_test": False,
            "test_used_during_cv": False,
            "test_used_for_feature_fitting": False,
            "exact_duplicate_test_texts_excluded_from_metrics": int(
                duplicate_test_mask.sum()
            ),
        },
        "conflicting_development_texts_excluded": int(
            len(conflicting_texts)
        ),
        "cross_validation": cv_summary,
        "locked_test": {
            "evaluated_unique_problems": int(len(clean_test_pool)),
            "metrics": test_metrics,
            "classification_report": report,
            "confusion_matrix": {
                "labels": encoder.classes_.tolist(),
                "matrix": matrix.tolist(),
            },
        },
        "prediction_score_note": (
            "The score is the maximum Logistic Regression class probability; "
            "it is not treated as a calibrated confidence."
        ),
    }

    log("  locked test: " + json.dumps(test_metrics))
    return frame, metrics


