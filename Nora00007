def assistant_findings_index(
    assistant_frame: pd.DataFrame,
) -> Dict[str, List[Dict[str, Any]]]:
    index: Dict[str, List[Dict[str, Any]]] = defaultdict(list)

    if assistant_frame.empty:
        return index

    for item in assistant_frame.itertuples(index=False):
        key = str(getattr(item, "link_key", "") or "")
        if not key:
            continue

        index[key].append({
            "structural_role": str(
                getattr(item, "structural_role", "unclassified")
            ),
            "sentence": str(getattr(item, "sentence", "")),
            "finding_cluster_id": int(
                getattr(item, "finding_cluster_id", -1)
            ),
            "finding_cluster_score": to_plain(
                getattr(item, "finding_cluster_score", None)
            ),
            "finding_descriptor": str(
                getattr(item, "finding_descriptor", "unassigned")
            ),
        })

    return index


def build_dictionary(
    config: RunConfig,
    df: pd.DataFrame,
    schema: Dict[str, Optional[str]],
    profile: List[Dict[str, Any]],
    quality: Dict[str, Any],
    split_metrics: Dict[str, Any],
    classifier_metrics: Dict[str, Any],
    topic_metrics: Dict[str, Any],
    entity_summary: Dict[str, Any],
    assistant_summary: Dict[str, Any],
    assistant_frame: pd.DataFrame,
    alignment: Dict[str, Any],
    user: pd.DataFrame,
    entity_candidates: Sequence[
        Dict[str, List[Dict[str, Any]]]
    ],
) -> Dict[str, Any]:
    log("\n[9/10] Assembling final dictionary")

    label_col, _ = resolve_label_and_group(schema)
    case_col = schema.get("case")
    conversation_col = schema.get("conversation")
    turn_col = schema.get("turn")

    findings = assistant_findings_index(assistant_frame)
    records: Dict[str, Dict[str, Any]] = {}

    for number, (_, row) in enumerate(
        user.iterrows(),
        start=1,
    ):
        record_id = f"record_{number:06d}"
        link_key = build_link_key(row, schema)
        linked_findings = findings.get(link_key, [])

        records[record_id] = {
            "record_id": record_id,
            "case": (
                str(row.get(case_col, ""))
                if case_col
                else ""
            ),
            "conversation_id": (
                str(row.get(conversation_col, ""))
                if conversation_col
                else ""
            ),
            "turn_index": (
                str(row.get(turn_col, ""))
                if turn_col
                else ""
            ),
            "data_split": str(
                row.get("data_split", "unlabelled")
            ),
            "customer_problem": str(row["text"]),
            "broad_intent": {
                "existing_label": (
                    str(row.get(label_col, ""))
                    if label_col
                    else ""
                ),
                "predicted_label": str(
                    row.get("predicted_intent", "")
                ),
                "prediction_score": to_plain(
                    row.get("prediction_score")
                ),
                "prediction_source": str(
                    row.get("prediction_source", "")
                ),
            },
            "detailed_intent": {
                "topic_id": to_plain(
                    row.get("topic_id", -1)
                ),
                "topic_descriptor": str(
                    row.get("detailed_intent", "unassigned")
                ),
                "topic_membership_score": to_plain(
                    row.get("topic_membership_score")
                ),
            },
            "entity_context_candidates": to_plain(
                entity_candidates[number - 1]
            ),
            "assistant_findings": to_plain(linked_findings),
            "root_cause": to_plain([
                item
                for item in linked_findings
                if item["structural_role"] == "root_cause"
            ]),
            "remediation": to_plain([
                item
                for item in linked_findings
                if item["structural_role"] == "remediation"
            ]),
            "diagnostic_checks": to_plain([
                item
                for item in linked_findings
                if item["structural_role"] == "diagnostic_check"
            ]),
            "limitations": to_plain([
                item
                for item in linked_findings
                if item["structural_role"] == "limitation"
            ]),
        }

    return to_plain({
        "run": {
            "analysis_name": "NORA offline ML/NLP intent analysis v2",
            "input_file": Path(config.input_path).name,
            "config": asdict(config),
        },
        "schema": schema,
        "dataset": {
            "input_rows": int(len(df)),
            "column_profile": profile,
            "data_quality": quality,
        },
        "split": split_metrics,
        "analysis": {
            "broad_intent_supervised_ml": classifier_metrics,
            "detailed_intent_discovery": topic_metrics,
            "entity_context_candidate_discovery": entity_summary,
            "assistant_finding_discovery": assistant_summary,
            "topic_vs_existing_label": alignment,
        },
        "records": records,
    })


