def fit_latent_representation(
    development_texts: Sequence[str],
    config: RunConfig,
    max_components: Optional[int] = None,
) -> Tuple[LatentRepresentation, np.ndarray]:
    min_word_df = 2 if len(development_texts) >= 50 else 1
    min_char_df = 3 if len(development_texts) >= 100 else 1

    vectorizer = build_text_vectorizer(
        config,
        min_word_df=min_word_df,
        min_char_df=min_char_df,
    )
    sparse = vectorizer.fit_transform(list(development_texts))

    requested = (
        config.topic_svd_components
        if max_components is None
        else max_components
    )
    components = min(
        sparse.shape[0] - 1,
        sparse.shape[1] - 1,
        requested,
    )

    if components < 2:
        raise RuntimeError(
            "Not enough development samples/features for TruncatedSVD."
        )

    svd = TruncatedSVD(
        n_components=int(components),
        random_state=config.seed,
    )
    dense = svd.fit_transform(sparse)

    normalizer = Normalizer(copy=False)
    dense = normalizer.fit_transform(dense)

    representation = LatentRepresentation(
        vectorizer=vectorizer,
        svd=svd,
        normalizer=normalizer,
    )
    return representation, np.asarray(dense, dtype=np.float32)


def derive_cluster_parameters(
    n_samples: int,
    requested_min_cluster_size: int,
    requested_neighbors: int,
) -> Tuple[int, int, int]:
    if requested_min_cluster_size <= 0:
        min_cluster_size = max(
            12,
            int(round(math.sqrt(max(n_samples, 1)))),
        )
    else:
        min_cluster_size = requested_min_cluster_size

    min_cluster_size = min(
        min_cluster_size,
        max(2, n_samples // 3),
    )

    if requested_neighbors <= 0:
        neighbors = min(
            30,
            max(
                10,
                int(round(math.sqrt(max(n_samples, 1)) / 2)),
            ),
        )
    else:
        neighbors = requested_neighbors

    neighbors = min(
        neighbors,
        max(2, n_samples - 1),
    )
    min_samples = max(5, min_cluster_size // 4)

    return int(min_cluster_size), int(neighbors), int(min_samples)


def cluster_centroids(
    vectors: np.ndarray,
    labels: np.ndarray,
) -> Dict[int, np.ndarray]:
    centroids: Dict[int, np.ndarray] = {}

    for label in sorted(set(labels.tolist())):
        label = int(label)
        if label == -1:
            continue
        member = vectors[labels == label]
        if len(member) == 0:
            continue
        centroid = member.mean(axis=0)
        norm = float(np.linalg.norm(centroid))
        if norm > 0.0:
            centroid = centroid / norm
        centroids[label] = np.asarray(centroid, dtype=np.float32)

    return centroids


def fit_kmeans_by_silhouette(
    vectors: np.ndarray,
    seed: int,
    max_k: int,
    min_cluster_size: int,
) -> Tuple[KMeans, np.ndarray, np.ndarray, float]:
    n_samples = len(vectors)
    upper = min(
        max_k,
        max(2, n_samples // max(min_cluster_size, 1)),
        max(2, int(round(math.sqrt(n_samples)))),
    )

    best_score = -1.0
    best_model: Optional[KMeans] = None
    best_labels: Optional[np.ndarray] = None

    for k in range(2, upper + 1):
        model = KMeans(
            n_clusters=k,
            random_state=seed,
            n_init=10,
        )
        labels = model.fit_predict(vectors)

        if len(set(labels.tolist())) < 2:
            continue

        score = float(
            silhouette_score(
                vectors,
                labels,
                metric="cosine",
                sample_size=min(3000, n_samples),
                random_state=seed,
            )
        )

        if score > best_score:
            best_score = score
            best_model = model
            best_labels = labels.astype(int)

    if best_model is None or best_labels is None:
        raise RuntimeError("Unable to derive a stable KMeans clustering.")

    distances = best_model.transform(vectors).min(axis=1)
    strengths = 1.0 / (1.0 + distances)

    return (
        best_model,
        best_labels,
        strengths.astype(float),
        best_score,
    )


def fit_cluster_model(
    vectors: np.ndarray,
    seed: int,
    requested_min_cluster_size: int,
    requested_neighbors: int,
    max_k: int,
) -> Tuple[ClusterModel, np.ndarray, np.ndarray]:
    n_samples = len(vectors)
    if n_samples < 4:
        raise RuntimeError("Too few samples for clustering.")

    min_size, neighbors, min_samples = derive_cluster_parameters(
        n_samples,
        requested_min_cluster_size,
        requested_neighbors,
    )

    try:
        from umap import UMAP
        from hdbscan import HDBSCAN

        reducer = UMAP(
            n_neighbors=neighbors,
            n_components=5,
            min_dist=0.0,
            metric="cosine",
            random_state=seed,
            low_memory=True,
        )
        reduced = reducer.fit_transform(vectors)

        clusterer = HDBSCAN(
            min_cluster_size=min_size,
            min_samples=min_samples,
            metric="euclidean",
            cluster_selection_method="eom",
            prediction_data=True,
        )
        labels = clusterer.fit_predict(reduced).astype(int)
        strengths = np.asarray(clusterer.probabilities_, dtype=float)

        non_outlier = labels != -1
        discovered = sorted(set(labels[non_outlier].tolist()))

        # If HDBSCAN finds fewer than two useful clusters, use the deterministic
        # local fallback rather than returning a meaningless partition.
        if len(discovered) >= 2:
            sil = None
            if non_outlier.sum() >= 3:
                try:
                    sil = float(
                        silhouette_score(
                            vectors[non_outlier],
                            labels[non_outlier],
                            metric="cosine",
                            sample_size=min(3000, int(non_outlier.sum())),
                            random_state=seed,
                        )
                    )
                except ValueError:
                    sil = None

            model = ClusterModel(
                method="umap_hdbscan",
                reducer=reducer,
                clusterer=clusterer,
                centroids=cluster_centroids(vectors, labels),
                silhouette=sil,
                parameters={
                    "min_cluster_size": min_size,
                    "min_samples": min_samples,
                    "umap_neighbors": neighbors,
                },
            )
            return model, labels, strengths

        log("  HDBSCAN returned <2 usable clusters; using KMeans fallback")

    except ImportError:
        log("  UMAP/HDBSCAN unavailable; using local KMeans fallback")

    kmeans, labels, strengths, sil = fit_kmeans_by_silhouette(
        vectors,
        seed=seed,
        max_k=max_k,
        min_cluster_size=min_size,
    )

    model = ClusterModel(
        method="kmeans_fallback",
        reducer=None,
        clusterer=kmeans,
        centroids=cluster_centroids(vectors, labels),
        silhouette=float(sil),
        parameters={
            "selected_k": int(kmeans.n_clusters),
            "min_cluster_size_reference": min_size,
        },
    )
    return model, labels, strengths


def predict_clusters(
    model: ClusterModel,
    vectors: np.ndarray,
) -> Tuple[np.ndarray, np.ndarray]:
    if len(vectors) == 0:
        return (
            np.asarray([], dtype=int),
            np.asarray([], dtype=float),
        )

    if model.method == "umap_hdbscan":
        try:
            from hdbscan.prediction import approximate_predict

            reduced = model.reducer.transform(vectors)
            labels, strengths = approximate_predict(
                model.clusterer,
                reduced,
            )
            return labels.astype(int), strengths.astype(float)
        except Exception:
            pass

    if model.method == "kmeans_fallback":
        labels = model.clusterer.predict(vectors).astype(int)
        distances = model.clusterer.transform(vectors).min(axis=1)
        strengths = 1.0 / (1.0 + distances)
        return labels, strengths.astype(float)

    # Last-resort nearest-development-centroid assignment. This never refits.
    if not model.centroids:
        return (
            np.full(len(vectors), -1, dtype=int),
            np.zeros(len(vectors), dtype=float),
        )

    cluster_ids = sorted(model.centroids)
    centroid_matrix = np.vstack([model.centroids[item] for item in cluster_ids])
    similarity = vectors @ centroid_matrix.T
    best = similarity.argmax(axis=1)
    labels = np.asarray([cluster_ids[position] for position in best], dtype=int)
    strengths = np.clip(
        (similarity[np.arange(len(vectors)), best] + 1.0) / 2.0,
        0.0,
        1.0,
    )
    return labels, strengths.astype(float)


def describe_clusters_ctfidf(
    documents: Sequence[str],
    assignments: np.ndarray,
    top_terms: int = 12,
) -> Dict[int, Dict[str, Any]]:
    """
    Class-based TF-IDF representation of already discovered clusters.
    """
    cluster_ids = sorted(
        int(cluster_id)
        for cluster_id in set(assignments.tolist())
        if int(cluster_id) != -1
    )
    if not cluster_ids:
        return {}

    grouped_documents = [
        " ".join(
            document
            for document, assignment in zip(documents, assignments)
            if int(assignment) == cluster_id
        )
        for cluster_id in cluster_ids
    ]

    vectorizer = CountVectorizer(
        lowercase=True,
        strip_accents="unicode",
        stop_words="english",
        ngram_range=(1, 2),
        min_df=1,
        max_features=30000,
    )
    counts = vectorizer.fit_transform(grouped_documents).astype(np.float64)
    terms = np.asarray(vectorizer.get_feature_names_out())

    words_per_cluster = np.asarray(counts.sum(axis=1)).ravel()
    words_per_cluster[words_per_cluster == 0] = 1.0

    term_frequency = counts.multiply(
        1.0 / words_per_cluster[:, None]
    )
    global_term_frequency = np.asarray(
        counts.sum(axis=0)
    ).ravel()

    average_words = float(np.mean(words_per_cluster))
    inverse_frequency = np.log(
        1.0
        + average_words
        / np.maximum(global_term_frequency, 1.0)
    )

    ctfidf = term_frequency.multiply(
        inverse_frequency
    ).toarray()

    output: Dict[int, Dict[str, Any]] = {}

    for row, cluster_id in enumerate(cluster_ids):
        ranked = np.argsort(ctfidf[row])[::-1]
        selected = [
            index
            for index in ranked
            if ctfidf[row, index] > 0
        ][:top_terms]

        keywords = [
            {
                "term": str(terms[index]),
                "weight": round(float(ctfidf[row, index]), 6),
            }
            for index in selected
        ]
        descriptor = " | ".join(
            item["term"] for item in keywords[:5]
        )

        output[cluster_id] = {
            "descriptor": descriptor or f"cluster_{cluster_id}",
            "keywords": keywords,
        }

    return output


# ---------------------------------------------------------------------------
# Detailed intent discovery
# ---------------------------------------------------------------------------

def discover_detailed_intents(
    user: pd.DataFrame,
    config: RunConfig,
) -> Tuple[
    pd.DataFrame,
    Dict[str, Any],
    Optional[LatentRepresentation],
]:
    log("\n[5/10] Detailed-intent discovery")

    frame = user.copy()
    frame["topic_id"] = -1
    frame["topic_membership_score"] = np.nan
    frame["detailed_intent"] = "unassigned"

    development = frame[frame["data_split"].eq("development")]
    unique_development = (
        development[["text"]]
        .drop_duplicates("text")
        .reset_index(drop=True)
    )

    if len(unique_development) < 30:
        return frame, {
            "status": "skipped",
            "reason": "too_few_distinct_development_statements",
            "distinct_development_statements": int(len(unique_development)),
        }, None

    representation, development_vectors = fit_latent_representation(
        unique_development["text"].tolist(),
        config,
    )

    cluster_model, assignments, strengths = fit_cluster_model(
        development_vectors,
        seed=config.seed,
        requested_min_cluster_size=config.topic_min_cluster_size,
        requested_neighbors=config.topic_umap_neighbors,
        max_k=config.topic_max_k,
    )

    descriptions = describe_clusters_ctfidf(
        unique_development["text"].tolist(),
        assignments,
    )

    development_lookup = {
        str(text): (
            int(cluster_id),
            float(score),
        )
        for text, cluster_id, score in zip(
            unique_development["text"],
            assignments,
            strengths,
        )
    }

    for index in frame.index:
        item = development_lookup.get(str(frame.at[index, "text"]))
        if item is not None:
            frame.at[index, "topic_id"] = item[0]
            frame.at[index, "topic_membership_score"] = item[1]

    unseen = frame.index[
        ~frame["text"].isin(development_lookup.keys())
    ]

    if len(unseen):
        unseen_texts = frame.loc[unseen, "text"].astype(str).tolist()
        unseen_vectors = representation.transform(unseen_texts)
        predicted, predicted_strength = predict_clusters(
            cluster_model,
            unseen_vectors,
        )
        frame.loc[unseen, "topic_id"] = predicted
        frame.loc[unseen, "topic_membership_score"] = predicted_strength

    def topic_name(topic_id: Any) -> str:
        try:
            topic = int(topic_id)
        except (TypeError, ValueError):
            return "unassigned"

        if topic == -1:
            return "unassigned"

        return descriptions.get(
            topic,
            {},
        ).get(
            "descriptor",
            f"topic_{topic}",
        )

    frame["detailed_intent"] = frame["topic_id"].map(topic_name)

    sizes = pd.Series(assignments).value_counts().sort_index()
    discovered = sorted(
        int(item)
        for item in set(assignments.tolist())
        if int(item) != -1
    )

    metrics = {
        "status": "completed",
        "fit_partition": "development_only",
        "method": cluster_model.method,
        "representation": "word + character TF-IDF -> TruncatedSVD/LSA",
        "cluster_description": "class-based TF-IDF",
        "distinct_development_statements": int(len(unique_development)),
        "topics_found": int(len(discovered)),
        "development_unassigned": int((assignments == -1).sum()),
        "development_unassigned_pct": pct(
            int((assignments == -1).sum()),
            len(assignments),
        ),
        "silhouette_cosine_non_outliers": cluster_model.silhouette,
        "parameters": {
            "svd_components": int(representation.svd.n_components),
            **cluster_model.parameters,
        },
        "topics": [
            {
                "topic_id": int(topic_id),
                "count": int(sizes.get(topic_id, 0)),
                "descriptor": (
                    "unassigned"
                    if int(topic_id) == -1
                    else descriptions.get(
                        int(topic_id),
                        {},
                    ).get(
                        "descriptor",
                        f"topic_{topic_id}",
                    )
                ),
                "keywords": (
                    []
                    if int(topic_id) == -1
                    else descriptions.get(
                        int(topic_id),
                        {},
                    ).get("keywords", [])
                ),
            }
            for topic_id in sorted(set(assignments.tolist()))
        ],
    }

    log(
        f"  method={cluster_model.method} "
        f"topics={metrics['topics_found']} "
        f"unassigned={metrics['development_unassigned']} "
        f"silhouette={cluster_model.silhouette}"
    )

    return frame, metrics, representation


# ---------------------------------------------------------------------------
# Unsupervised entity/context candidate discovery
# ---------------------------------------------------------------------------

def discover_entity_candidates(
    user: pd.DataFrame,
    representation: Optional[LatentRepresentation],
    config: RunConfig,
) -> Tuple[
    List[Dict[str, List[Dict[str, Any]]]],
    Dict[str, Any],
    pd.DataFrame,
]:
    """
    Discover entity/context candidates without predefined semantic axes.

    Development-only n-grams are embedded in the development latent space and
    clustered into corpus-derived concept groups. The test partition is only
    transformed through the frozen development vocabulary/model.
    """
    log("\n[6/10] Unsupervised entity/context candidate discovery")

    outputs: List[Dict[str, List[Dict[str, Any]]]] = [
        {} for _ in range(len(user))
    ]

    development_texts = (
        user.loc[user["data_split"].eq("development"), "text"]
        .drop_duplicates()
        .astype(str)
        .tolist()
    )

    if len(development_texts) < 30:
        return outputs, {
            "status": "skipped",
            "reason": "too_few_development_texts",
        }, pd.DataFrame()

    if representation is None:
        representation, _ = fit_latent_representation(
            development_texts,
            config,
        )

    min_df = 2 if len(development_texts) >= 50 else 1
    candidate_vectorizer = TfidfVectorizer(
        lowercase=True,
        strip_accents="unicode",
        stop_words="english",
        ngram_range=(1, 3),
        min_df=min_df,
        max_df=0.90,
        max_features=config.entity_max_features,
        sublinear_tf=True,
        norm="l2",
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]+\b",
    )

    development_matrix = candidate_vectorizer.fit_transform(
        development_texts
    )
    vocabulary = np.asarray(
        candidate_vectorizer.get_feature_names_out()
    )

    if len(vocabulary) < 20:
        return outputs, {
            "status": "skipped",
            "reason": "candidate_vocabulary_too_small",
        }, pd.DataFrame()

    phrase_vectors = representation.transform(
        vocabulary.tolist()
    )
    vector_norm = np.linalg.norm(phrase_vectors, axis=1)
    covered = vector_norm > 1e-8

    if int(covered.sum()) < 20:
        return outputs, {
            "status": "skipped",
            "reason": "too_few_phrases_in_latent_space",
        }, pd.DataFrame()

    covered_feature_ids = np.flatnonzero(covered)
    covered_vectors = phrase_vectors[covered]

    cluster_model, covered_labels, covered_strengths = fit_cluster_model(
        covered_vectors,
        seed=config.seed,
        requested_min_cluster_size=config.entity_min_cluster_size,
        requested_neighbors=config.topic_umap_neighbors,
        max_k=config.entity_max_k,
    )

    feature_cluster = np.full(len(vocabulary), -1, dtype=int)
    feature_strength = np.zeros(len(vocabulary), dtype=float)
    feature_cluster[covered_feature_ids] = covered_labels
    feature_strength[covered_feature_ids] = covered_strengths

    document_frequency = np.asarray(
        (development_matrix > 0).sum(axis=0)
    ).ravel()

    cluster_catalog: List[Dict[str, Any]] = []
    cluster_descriptor: Dict[int, str] = {}
    cluster_ids = sorted(
        int(item)
        for item in set(covered_labels.tolist())
        if int(item) != -1
    )

    for cluster_id in cluster_ids:
        feature_ids = np.flatnonzero(feature_cluster == cluster_id)
        if len(feature_ids) == 0:
            continue

        centroid = cluster_model.centroids.get(cluster_id)
        if centroid is None:
            centrality = np.ones(len(feature_ids), dtype=float)
        else:
            centrality = np.clip(
                phrase_vectors[feature_ids] @ centroid,
                -1.0,
                1.0,
            )

        importance = (
            np.log1p(document_frequency[feature_ids])
            * (centrality + 1.0)
            * (feature_strength[feature_ids] + 1e-6)
        )

        ranked_local = np.argsort(importance)[::-1]
        top_ids = feature_ids[ranked_local[:12]]
        top_phrases = [
            {
                "phrase": str(vocabulary[feature_id]),
                "development_document_frequency": int(
                    document_frequency[feature_id]
                ),
                "cluster_membership_score": round(
                    float(feature_strength[feature_id]),
                    4,
                ),
            }
            for feature_id in top_ids
        ]

        descriptor = " | ".join(
            item["phrase"] for item in top_phrases[:5]
        )
        cluster_descriptor[cluster_id] = (
            descriptor or f"concept_cluster_{cluster_id}"
        )

        cluster_catalog.append({
            "cluster_id": int(cluster_id),
            "descriptor": cluster_descriptor[cluster_id],
            "candidate_phrase_count": int(len(feature_ids)),
            "top_phrases": top_phrases,
        })

    all_matrix = candidate_vectorizer.transform(
        user["text"].astype(str).tolist()
    )

    message_cluster_counts: Dict[int, int] = defaultdict(int)

    for row_index in range(all_matrix.shape[0]):
        start = all_matrix.indptr[row_index]
        end = all_matrix.indptr[row_index + 1]
        feature_ids = all_matrix.indices[start:end]
        weights = all_matrix.data[start:end]

        if len(feature_ids) == 0:
            continue

        order = np.argsort(weights)[::-1]
        grouped: Dict[str, List[Dict[str, Any]]] = {}

        for local_position in order:
            feature_id = int(feature_ids[local_position])
            cluster_id = int(feature_cluster[feature_id])

            if cluster_id == -1:
                continue

            key = f"concept_cluster_{cluster_id:03d}"
            grouped.setdefault(key, []).append({
                "value": str(vocabulary[feature_id]),
                "tfidf_weight": round(float(weights[local_position]), 4),
                "cluster_membership_score": round(
                    float(feature_strength[feature_id]),
                    4,
                ),
                "cluster_descriptor": cluster_descriptor.get(
                    cluster_id,
                    key,
                ),
            })

        trimmed: Dict[str, List[Dict[str, Any]]] = {}

        ranked_clusters = sorted(
            grouped.items(),
            key=lambda item: max(
                value["tfidf_weight"] for value in item[1]
            ),
            reverse=True,
        )

        for key, values in ranked_clusters[:config.entity_top_phrases]:
            values.sort(
                key=lambda item: (
                    -item["tfidf_weight"],
                    -item["cluster_membership_score"],
                    item["value"],
                )
            )
            trimmed[key] = values[
                : config.entity_max_values_per_cluster
            ]

            try:
                cluster_id = int(key.rsplit("_", 1)[-1])
                message_cluster_counts[cluster_id] += 1
            except ValueError:
                pass

        outputs[row_index] = trimmed

    cluster_table = pd.DataFrame([
        {
            "cluster_id": item["cluster_id"],
            "descriptor": item["descriptor"],
            "candidate_phrase_count": item["candidate_phrase_count"],
            "messages_with_cluster": int(
                message_cluster_counts.get(item["cluster_id"], 0)
            ),
            "message_coverage_pct": pct(
                int(message_cluster_counts.get(item["cluster_id"], 0)),
                len(user),
            ),
        }
        for item in cluster_catalog
    ])

    summary = {
        "status": "completed",
        "fit_partition": "development_only",
        "method": (
            "development n-gram mining -> development LSA vectors -> "
            f"{cluster_model.method}"
        ),
        "named_business_axes_used": False,
        "candidate_vocabulary_size": int(len(vocabulary)),
        "phrases_with_latent_vector": int(covered.sum()),
        "candidate_clusters_found": int(len(cluster_ids)),
        "candidate_phrase_outliers": int((covered_labels == -1).sum()),
        "silhouette_cosine_non_outliers": cluster_model.silhouette,
        "parameters": cluster_model.parameters,
        "clusters": cluster_catalog,
        "interpretation": (
            "Clusters are corpus-derived entity/context candidates. They are "
            "not assigned service/device/symptom labels without supervision."
        ),
    }

    log(
        f"  method={cluster_model.method} "
        f"clusters={len(cluster_ids)} "
        f"phrase_outliers={int((covered_labels == -1).sum())}"
    )

    return outputs, summary, cluster_table


