def payload_to_bundle(payload: Dict[str, Any]) -> CorpusBundle:
    version = payload.get("format_version")
    if version != ARTIFACT_FORMAT_VERSION:
        raise RuntimeError(
            f"Artifact format {version!r} does not match {ARTIFACT_FORMAT_VERSION!r}; retrain before inference."
        )
    noise = payload["noise_model"]
    latent = payload["latent_model"]
    model_text_mode = str(payload.get("model_text_mode", "raw_redacted"))
    noise_policy = str(payload.get("noise_policy") or (
        "shared_clean" if model_text_mode == "noise_reduced" else "raw"
    ))
    return CorpusBundle(
        pipeline_name=str(payload["pipeline_name"]),
        pipeline_version=str(payload["pipeline_version"]),
        corpus_name=str(payload["corpus_name"]),
        noise_model=NoiseModel(
            unigrams=set(noise["unigrams"]),
            template_phrases=set(noise["template_phrases"]),
            descriptor_blocklist=set(noise["descriptor_blocklist"]),
            score_threshold=float(noise["score_threshold"]),
            protected_phrases=set(noise.get("protected_phrases", [])),
            selection_method=str(noise.get("selection_method", "distribution_derived")),
        ),
        noise_policy=noise_policy,
        latent_model=LatentModel(
            vectorizer=latent["vectorizer"],
            svd=latent["svd"],
            normalizer=latent["normalizer"],
            batch_size=int(latent.get("batch_size", 4096)),
        ),
        cluster_model=cluster_model_from_payload(payload["cluster_model"]),
        refinement_rules=[
            RefinementRule(
                parent_cluster=int(rule["parent_cluster"]),
                model=cluster_model_from_payload(rule["model"]),
                child_id_map={int(k): int(v) for k, v in rule["child_id_map"].items()},
                depth=int(rule["depth"]),
            )
            for rule in payload.get("refinement_rules", [])
        ],
        merge_map={int(k): int(v) for k, v in payload.get("merge_map", {}).items()},
        outlier_recovery_model=outlier_recovery_from_payload(payload.get("outlier_recovery_model")),
        descriptions={int(k): v for k, v in payload.get("descriptions", {}).items()},
        model_text_mode=model_text_mode,
        reference_cluster_distribution={
            int(k): float(v) for k, v in payload.get("reference_cluster_distribution", {}).items()
        },
        reference_outlier_rate=float(payload.get("reference_outlier_rate", 0.0)),
        reference_strength_quantiles={
            str(k): float(v) for k, v in payload.get("reference_strength_quantiles", {}).items()
        },
        reference_recovery_rate=float(payload.get("reference_recovery_rate", 0.0)),
        config=dict(payload.get("config", {})),
    )


def sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while True:
            chunk = handle.read(chunk_size)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def validate_runtime_compatibility(payload: Dict[str, Any]) -> None:
    """Fail on scikit-learn major/minor drift; warn on other library drift."""
    trained = payload.get("runtime_versions", {})
    current = package_versions()
    trained_sklearn = str(trained.get("scikit_learn", ""))
    current_sklearn = str(current.get("scikit_learn", ""))
    if trained_sklearn and current_sklearn:
        if trained_sklearn.split(".")[:2] != current_sklearn.split(".")[:2]:
            raise RuntimeError(
                f"scikit-learn runtime mismatch: trained={trained_sklearn}, current={current_sklearn}. "
                "Use the training environment or retrain the artifact."
            )


def load_bundle(path: Path, expected_sha256: Optional[str] = None) -> CorpusBundle:
    if expected_sha256:
        actual = sha256_file(path)
        if actual != expected_sha256:
            raise RuntimeError(f"Artifact checksum mismatch for {path.name}")
    payload = joblib.load(path)
    if isinstance(payload, CorpusBundle):
        # Backward-compatible local artifact only; new artifacts use payload dicts.
        return payload
    if not isinstance(payload, dict):
        raise RuntimeError(f"Unsupported model artifact type: {type(payload)!r}")
    validate_runtime_compatibility(payload)
    return payload_to_bundle(payload)


@dataclass
class StageRecorder:
    """Collect wall-clock/runtime evidence for expensive stages."""
    records: List[Dict[str, Any]] = field(default_factory=list)

    def add(
        self,
        stage: str,
        elapsed_seconds: float,
        status: str,
        cache_hit: bool,
        rows_in: Optional[int] = None,
        rows_out: Optional[int] = None,
        cache_key: Optional[str] = None,
        detail: str = "",
    ) -> None:
        self.records.append({
            "stage": stage,
            "elapsed_seconds": round(float(elapsed_seconds), 6),
            "status": status,
            "cache_hit": bool(cache_hit),
            "rows_in": rows_in,
            "rows_out": rows_out,
            "cache_key": cache_key or "",
            "detail": detail,
        })

    def frame(self) -> pd.DataFrame:
        return pd.DataFrame(self.records)


def stable_payload_hash(payload: Any) -> str:
    raw = json.dumps(to_plain(payload), sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def hash_text_sequence(texts: Sequence[str]) -> str:
    digest = hashlib.sha256()
    for text in texts:
        value = str(text).encode("utf-8", errors="ignore")
        digest.update(len(value).to_bytes(8, "little", signed=False))
        digest.update(value)
    return digest.hexdigest()


