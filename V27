def fit_baseline_on_unique(
    unique_texts: Sequence[str], config: Config
) -> Tuple[LatentModel, ClusterModel, np.ndarray, np.ndarray, np.ndarray, pd.DataFrame]:
    values = list(unique_texts)
    if len(values) > config.max_cluster_fit_rows:
        rng = np.random.default_rng(config.seed)
        fit_idx = np.sort(rng.choice(len(values), size=config.max_cluster_fit_rows, replace=False))
        fit_texts = [values[i] for i in fit_idx.tolist()]
    else:
        fit_idx = np.arange(len(values), dtype=int)
        fit_texts = values
    latent, fit_vectors = fit_latent(fit_texts, config)
    cluster_model, fit_labels, fit_strengths, search = fit_cluster_search(fit_vectors, config)
    if len(fit_idx) == len(values):
        return latent, cluster_model, fit_vectors, fit_labels, fit_strengths, search
    all_vectors = latent.transform(values)
    labels, strengths = predict_cluster(cluster_model, all_vectors)
    return latent, cluster_model, all_vectors, labels, strengths, search


def build_sme_review_template(catalog: pd.DataFrame) -> pd.DataFrame:
    if catalog.empty:
        return pd.DataFrame(columns=[
            "cluster_id", "cluster_provenance", "count", "descriptor", "top_terms",
            "npmi_coherence", "sme_review_status", "sme_business_label",
            "sme_is_coherent", "sme_noise_contamination", "sme_notes",
        ])
    keep = [
        c for c in (
            "cluster_id", "cluster_provenance", "count", "share_of_nonoutliers_pct",
            "cohesion_mean_cosine_to_centroid", "npmi_coherence", "descriptor", "top_terms",
            "representative_examples",
        ) if c in catalog.columns
    ]
    review = catalog[keep].copy()
    review["sme_review_status"] = "PENDING"
    review["sme_business_label"] = ""
    review["sme_is_coherent"] = ""
    review["sme_noise_contamination"] = ""
    review["sme_notes"] = ""
    return review


def process_corpus(
    frame: pd.DataFrame,
    text_col: str,
    corpus_name: str,
    config: Config,
    cache: Optional[StageCache] = None,
) -> Dict[str, Any]:
    LOGGER.info("[%s] Phase-2 corpus processing: %s", "3/9" if corpus_name == "customer" else "7/9", corpus_name)
    data = frame.copy().reset_index(drop=True)
    data[text_col] = data[text_col].fillna("").astype(str).map(redact_pii)
    data = data[data[text_col].map(lambda x: len(tokenize(x)) >= 2)].reset_index(drop=True)

    dev = data[data["data_split"].eq("development")].copy().reset_index()
    if len(dev) < 30:
        raise RuntimeError(f"Too few development rows for {corpus_name}: {len(dev)}")
    unique_dev = dev[["index", text_col]].drop_duplicates(text_col).reset_index(drop=True)
    unique_raw = unique_dev[text_col].astype(str).tolist()
    if len(unique_raw) < 30:
        raise RuntimeError(f"{corpus_name}: only {len(unique_raw)} distinct development texts, 30 required")
    corpus_hash = hash_text_sequence(unique_raw)

    # ------------------------------------------------------------------
    # Immutable development reference baseline.  The same privacy-redacted
    # corpus is used for every interpretability comparison.
    # ------------------------------------------------------------------
    LOGGER.info("%s: fitting raw-text development baseline", corpus_name)
    def _compute_baseline() -> Any:
        return fit_baseline_on_unique(unique_raw, config)
    if cache is not None:
        baseline_latent, baseline_cluster, baseline_vectors, baseline_labels, baseline_strengths, baseline_search = cache.cached(
            f"{corpus_name}.baseline",
            {"corpus_hash": corpus_hash, "config": stage_config(config, "baseline")},
            _compute_baseline, rows_in=len(unique_raw),
        )
    else:
        baseline_latent, baseline_cluster, baseline_vectors, baseline_labels, baseline_strengths, baseline_search = _compute_baseline()
    baseline_sources = np.asarray([
        "native" if int(x) != -1 else "outlier" for x in baseline_labels
    ], dtype=object)
    baseline_final_metrics = final_partition_metrics(
        baseline_vectors, baseline_labels, baseline_strengths, config.seed, baseline_sources
    )
    baseline_model_diagnostics = metric_with_model(
        evaluate_cluster_candidate(baseline_vectors, baseline_labels, config.seed), baseline_cluster
    )
    baseline_descriptions = ctfidf_descriptions(unique_raw, baseline_labels)
    baseline_interp, baseline_per_npmi = interpretability_metrics(
        unique_raw, baseline_descriptions, config.coherence_top_terms
    )
    baseline_final_metrics.update(baseline_interp)

    # ------------------------------------------------------------------
    # Development-only noise discovery + policy ablation.
    # ------------------------------------------------------------------
    LOGGER.info("%s: building multi-clustering development-only noise consensus", corpus_name)
    def _compute_noise_stage() -> Any:
        labelings, consensus_audit = build_noise_label_ensemble(
            baseline_vectors, baseline_cluster, baseline_labels, config
        )
        learned_model, learned_table = learn_noise_model(unique_raw, labelings, config)
        selected_policy, policy_ablation = select_noise_policy(
            unique_raw, learned_model, config
        )
        return labelings, consensus_audit, learned_model, learned_table, selected_policy, policy_ablation
    if cache is not None:
        noise_labelings, noise_consensus_audit, noise_model, noise_table, selected_noise_policy, noise_policy_ablation = cache.cached(
            f"{corpus_name}.noise",
            {"corpus_hash": corpus_hash, "baseline_method": baseline_cluster.method, "config": stage_config(config, "noise")},
            _compute_noise_stage, rows_in=len(unique_raw),
        )
    else:
        noise_labelings, noise_consensus_audit, noise_model, noise_table, selected_noise_policy, noise_policy_ablation = _compute_noise_stage()
    model_unique = prepare_model_texts(unique_raw, noise_model, selected_noise_policy)
    LOGGER.info(
        "%s: noise terms=%d templates=%d consensus_clusterings=%d selected_policy=%s protected_phrases=%d",
        corpus_name,
        len(noise_model.unigrams),
        len(noise_model.template_phrases),
        len(noise_labelings),
        selected_noise_policy,
        len(noise_model.protected_phrases),
    )

    # ------------------------------------------------------------------
    # Duplicate-family control is performed in the selected model-text space.
    # ------------------------------------------------------------------
    LOGGER.info("%s: detecting scalable near-duplicate families", corpus_name)
    model_text_hash = hash_text_sequence(model_unique)
    def _compute_duplicate_stage() -> Any:
        fam_ids, dup_pairs, dup_cutoff, dup_method, dup_proj = detect_duplicate_families(model_unique, config)
        representatives, dup_families = choose_family_representatives(fam_ids, dup_proj)
        return fam_ids, dup_pairs, dup_cutoff, dup_method, dup_proj, representatives, dup_families
    if cache is not None:
        family_ids, duplicate_pairs, duplicate_cutoff, duplicate_method, duplicate_proj, reps, duplicate_families = cache.cached(
            f"{corpus_name}.duplicates",
            {"model_text_hash": model_text_hash, "noise_policy": selected_noise_policy, "config": stage_config(config, "duplicates")},
            _compute_duplicate_stage, rows_in=len(model_unique),
        )
    else:
        family_ids, duplicate_pairs, duplicate_cutoff, duplicate_method, duplicate_proj, reps, duplicate_families = _compute_duplicate_stage()
    fit_texts = [model_unique[i] for i in reps.tolist()]
    if len(fit_texts) > config.max_cluster_fit_rows:
        rng = np.random.default_rng(config.seed)
        chosen = np.sort(rng.choice(len(fit_texts), size=config.max_cluster_fit_rows, replace=False))
        fit_texts_model = [fit_texts[i] for i in chosen.tolist()]
        fit_rep_positions = reps[chosen]
    else:
        fit_texts_model = fit_texts
        fit_rep_positions = reps

    LOGGER.info("%s: fitting selected latent space and UMAP/HDBSCAN search", corpus_name)
    fit_hash = hash_text_sequence(fit_texts_model)
    def _compute_candidate_stage() -> Any:
        local_latent, local_vectors = fit_latent(
            fit_texts_model,
            config,
            noise_model=noise_model if selected_noise_policy == "word_only" else None,
            noise_policy=selected_noise_policy,
        )
        local_cluster_model, local_labels, local_strengths, local_search = fit_cluster_search(local_vectors, config)
        local_refined_labels, local_refined_strengths, local_refinement_audit, local_rules = refine_clusters(
            local_vectors, local_labels, local_strengths, config
        )
        local_final_labels, local_merge_map, local_merge_audit = statistically_justified_merge(
            local_vectors, local_refined_labels, config
        )
        return (
            local_latent, local_vectors, local_cluster_model, local_labels, local_strengths, local_search,
            local_refined_labels, local_refined_strengths, local_refinement_audit, local_rules,
            local_final_labels, local_merge_map, local_merge_audit,
        )
    if cache is not None:
        (
            latent, fit_vectors, cluster_model, fit_labels, fit_strengths, search_table,
            refined_labels, refined_strengths, refinement_audit, refinement_rules,
            final_fit_labels, merge_map, merge_audit,
        ) = cache.cached(
            f"{corpus_name}.candidate_cluster",
            {"fit_hash": fit_hash, "noise_policy": selected_noise_policy, "config": stage_config(config, "candidate")},
            _compute_candidate_stage, rows_in=len(fit_texts_model),
        )
    else:
        (
            latent, fit_vectors, cluster_model, fit_labels, fit_strengths, search_table,
            refined_labels, refined_strengths, refinement_audit, refinement_rules,
            final_fit_labels, merge_map, merge_audit,
        ) = _compute_candidate_stage()

    rep_pos_to_assignment: Dict[int, Tuple[int, float]] = {}
    for local_pos, unique_pos in enumerate(fit_rep_positions.tolist()):
        rep_pos_to_assignment[int(unique_pos)] = (
            int(final_fit_labels[local_pos]), float(refined_strengths[local_pos])
        )
    missing_reps = [int(i) for i in reps.tolist() if int(i) not in rep_pos_to_assignment]
    if missing_reps:
        missing_vec = latent.transform([model_unique[i] for i in missing_reps])
        p_labels, p_strengths = predict_with_refinements(
            cluster_model, refinement_rules, missing_vec, merge_map
        )
        for i, lab, st in zip(missing_reps, p_labels.tolist(), p_strengths.tolist()):
            rep_pos_to_assignment[i] = (int(lab), float(st))

    rep_by_family = {
        int(row.duplicate_family_id): int(row.representative_index)
        for row in duplicate_families.itertuples()
    }
    family_to_assignment = {
        fam: rep_pos_to_assignment.get(rep_idx, (-1, 0.0))
        for fam, rep_idx in rep_by_family.items()
    }
    unique_labels_pre_recovery = np.asarray(
        [family_to_assignment[int(fam)][0] for fam in family_ids], dtype=int
    )
    unique_strengths = np.asarray(
        [family_to_assignment[int(fam)][1] for fam in family_ids], dtype=float
    )
    unique_vectors = latent.transform(model_unique)

    # ------------------------------------------------------------------
    # Persistable outlier recovery.  Thresholds are cluster-specific and use
    # both nearest-centroid similarity and best-vs-second-best margin.
    # ------------------------------------------------------------------
    outlier_recovery_model, outlier_recovery_thresholds = fit_outlier_recovery_model(
        unique_vectors, unique_labels_pre_recovery, config
    )
    (
        unique_labels,
        unique_strengths,
        unique_sources,
        unique_recovery_similarity,
        unique_recovery_margin,
    ) = apply_outlier_recovery_model(
        unique_vectors,
        unique_labels_pre_recovery,
        unique_strengths,
        outlier_recovery_model,
    )
    outlier_recovery_summary = {
        "enabled": bool(config.reassign_outliers),
        "outliers_before": int(np.sum(unique_labels_pre_recovery == -1)),
        "outliers_reassigned": int(np.sum(unique_sources == "recovered_outlier")),
        "outliers_after": int(np.sum(unique_labels == -1)),
        "recovery_model_clusters": int(len(outlier_recovery_model.cluster_ids)) if outlier_recovery_model else 0,
    }

    # Descriptors always use readable privacy-redacted source language. Noise
    # terms are blocked at the descriptor layer regardless of selected policy.
    descriptions = ctfidf_descriptions(
        unique_raw, unique_labels, blocked_terms=noise_model.descriptor_blocklist
    )
    candidate_interp, candidate_per_npmi = interpretability_metrics(
        unique_raw, descriptions, config.coherence_top_terms
    )
    attempted_final_metrics = final_partition_metrics(
        unique_vectors, unique_labels, unique_strengths, config.seed, unique_sources
    )
    attempted_final_metrics.update(candidate_interp)
    attempted_model_diagnostics = metric_with_model(
        evaluate_cluster_candidate(unique_vectors, unique_labels_pre_recovery, config.seed), cluster_model
    )

    catalog = cluster_catalog(
        unique_raw,
        unique_vectors,
        unique_labels,
        unique_strengths,
        descriptions,
        cluster_model,
        config.representative_examples,
        refinement_rules=refinement_rules,
        merge_map=merge_map,
        per_cluster_npmi=candidate_per_npmi,
        assignment_source=unique_sources,
    )

    structural_passed, structural_gate_audit, structural_gate_summary = structural_safety_gate(
        baseline_final_metrics, attempted_final_metrics, search_table, cluster_model
    )
    semantic_allowed, semantic_guard_audit, semantic_guard_summary, _, _ = semantic_regression_guard(
        unique_raw, baseline_descriptions, descriptions, config
    )
    deploy_candidate = bool(structural_passed and semantic_allowed)
    if not structural_passed:
        LOGGER.warning(
            "%s: structural safety gate failed on %s",
            corpus_name,
            ", ".join(structural_gate_summary["failed_conditions"]) or "unknown",
        )
    if not semantic_allowed:
        LOGGER.warning(
            "%s: semantic regression guard blocked candidate; status=%s",
            corpus_name, semantic_guard_summary["status"],
        )

    # ------------------------------------------------------------------
    # Deployment selection. A failed candidate is auditable and can revert to
    # the untouched development baseline without contaminating the locked test.
    # ------------------------------------------------------------------
    deployed_noise_policy = selected_noise_policy
    deployed_mode = (
        "noise_reduced" if selected_noise_policy == "shared_clean"
        else "word_only_feature_suppression" if selected_noise_policy == "word_only"
        else "raw_redacted"
    )
    deployed_final_metrics = dict(attempted_final_metrics)
    deployed_model_diagnostics = dict(attempted_model_diagnostics)
    deployed_sources = unique_sources.copy()
    deployed_recovery_similarity = unique_recovery_similarity.copy()
    deployed_recovery_margin = unique_recovery_margin.copy()
    reverted = False

    if not deploy_candidate and config.on_regression == "revert":
        LOGGER.warning("%s: deployment checks failed; reverting deployed geometry to raw baseline", corpus_name)
        latent = baseline_latent
        cluster_model = baseline_cluster
        refinement_rules = []
        merge_map = {}
        outlier_recovery_model = None
        unique_labels = np.asarray(baseline_labels, dtype=int)
        unique_strengths = np.asarray(baseline_strengths, dtype=float)
        unique_vectors = baseline_vectors
        deployed_sources = baseline_sources
        deployed_recovery_similarity = np.full(len(unique_labels), np.nan)
        deployed_recovery_margin = np.full(len(unique_labels), np.nan)
        descriptions = baseline_descriptions
        catalog = cluster_catalog(
            unique_raw,
            unique_vectors,
            unique_labels,
            unique_strengths,
            descriptions,
            baseline_cluster,
            config.representative_examples,
            refinement_rules=[],
            merge_map={},
            per_cluster_npmi=baseline_per_npmi,
            assignment_source=baseline_sources,
        )
        deployed_final_metrics = dict(baseline_final_metrics)
        deployed_model_diagnostics = dict(baseline_model_diagnostics)
        deployed_noise_policy = "raw"
        deployed_mode = "raw_redacted"
        reverted = True

    exact_map: Dict[str, Tuple[int, float, str, float, float]] = {
        str(raw): (
            int(lab), float(st), str(src), float(rs), float(rm)
        )
        for raw, lab, st, src, rs, rm in zip(
            unique_raw,
            unique_labels.tolist(),
            unique_strengths.tolist(),
            deployed_sources.tolist(),
            deployed_recovery_similarity.tolist(),
            deployed_recovery_margin.tolist(),
        )
    }

    labels_all = np.full(len(data), -1, dtype=int)
    strengths_all = np.zeros(len(data), dtype=float)
    assignment_source_all = np.asarray(["outlier"] * len(data), dtype=object)
    recovery_similarity_all = np.full(len(data), np.nan, dtype=float)
    recovery_margin_all = np.full(len(data), np.nan, dtype=float)
    unseen_positions: List[int] = []
    unseen_model_texts: List[str] = []
    model_text_all: List[str] = []

    for i, raw in enumerate(data[text_col].astype(str).tolist()):
        model_text = prepare_model_texts([raw], noise_model, deployed_noise_policy)[0]
        model_text_all.append(model_text)
        hit = exact_map.get(raw)
        if hit is not None and data.at[i, "data_split"] == "development":
            labels_all[i], strengths_all[i], assignment_source_all[i], recovery_similarity_all[i], recovery_margin_all[i] = hit
        else:
            unseen_positions.append(i)
            unseen_model_texts.append(model_text)

    if unseen_positions:
        vec = latent.transform(unseen_model_texts)
        labs, sts, srcs, rec_sims, rec_margins = predict_final_partition(
            cluster_model,
            refinement_rules,
            vec,
            merge_map,
            outlier_recovery_model,
        )
        for pos, lab, st, src, rec_sim, rec_margin in zip(
            unseen_positions,
            labs.tolist(),
            sts.tolist(),
            srcs.tolist(),
            rec_sims.tolist(),
            rec_margins.tolist(),
        ):
            labels_all[pos] = int(lab)
            strengths_all[pos] = float(st)
            assignment_source_all[pos] = str(src)
            recovery_similarity_all[pos] = float(rec_sim)
            recovery_margin_all[pos] = float(rec_margin)

    data["phase2_model_text"] = model_text_all
    data["phase2_cluster_id"] = labels_all
    # This remains native HDBSCAN/KMeans strength. Recovered rows keep their
    # original native strength and expose recovery evidence separately.
    data["phase2_cluster_strength"] = strengths_all
    data["phase2_assignment_source"] = assignment_source_all
    data["phase2_recovery_similarity"] = recovery_similarity_all
    data["phase2_recovery_margin"] = recovery_margin_all
    data["phase2_cluster_descriptor"] = [
        "unassigned" if int(lab) == -1
        else descriptions.get(int(lab), {}).get("descriptor", f"cluster_{int(lab)}")
        for lab in labels_all.tolist()
    ]

    before_after = pd.DataFrame([
        {"stage": "raw_text_baseline", **baseline_final_metrics},
        {"stage": "attempted_phase2_final_partition", **attempted_final_metrics},
        {"stage": "deployed_final_partition", **deployed_final_metrics},
    ])

    dev_mask_all = data["data_split"].eq("development").to_numpy()
    reference_distribution = cluster_distribution(labels_all[dev_mask_all])
    reference_outlier_rate = float(np.mean(labels_all[dev_mask_all] == -1)) if dev_mask_all.any() else 0.0
    dev_native_mask = dev_mask_all & (assignment_source_all != "recovered_outlier")
    reference_strength = strength_quantiles(strengths_all[dev_native_mask]) if dev_native_mask.any() else {}
    reference_recovery_rate = float(np.mean(assignment_source_all[dev_mask_all] == "recovered_outlier")) if dev_mask_all.any() else 0.0

    bundle = CorpusBundle(
        pipeline_name=PIPELINE_NAME,
        pipeline_version=PIPELINE_VERSION,
        corpus_name=corpus_name,
        noise_model=noise_model,
        noise_policy=deployed_noise_policy,
        latent_model=latent,
        cluster_model=cluster_model,
        refinement_rules=refinement_rules,
        merge_map=merge_map,
        outlier_recovery_model=outlier_recovery_model,
        descriptions=descriptions,
        model_text_mode=deployed_mode,
        reference_cluster_distribution=reference_distribution,
        reference_outlier_rate=reference_outlier_rate,
        reference_strength_quantiles=reference_strength,
        reference_recovery_rate=reference_recovery_rate,
        config=asdict(config),
    )
    sme_review = build_sme_review_template(catalog)
    if "protected_phrase" in noise_table.columns:
        preserved_phrases = noise_table[noise_table["protected_phrase"].astype(bool)].copy()
    else:
        preserved_phrases = pd.DataFrame()
    if not preserved_phrases.empty:
        preserved_phrases = preserved_phrases.sort_values(
            ["discriminative_phrase_score", "development_document_frequency"],
            ascending=False,
        ).reset_index(drop=True)
    similarity = cluster_similarity_matrix(unique_vectors, unique_labels, max_clusters=50)

    summary = {
        "corpus": corpus_name,
        "development_rows": int((data["data_split"] == "development").sum()),
        "locked_test_rows": int((data["data_split"] == "locked_test").sum()),
        "unique_development_texts": len(unique_raw),
        "noise_consensus_clusterings": len(noise_labelings),
        "learned_noise_unigrams": len(noise_model.unigrams),
        "learned_noise_template_phrases": len(noise_model.template_phrases),
        "protected_discriminative_phrases": len(noise_model.protected_phrases),
        "noise_selection_method": noise_model.selection_method,
        "noise_policy_requested": config.noise_policy,
        "noise_policy_selected": selected_noise_policy,
        "noise_policy_deployed": deployed_noise_policy,
        "model_text_policy": (
            "auto-selected on development data: shared_clean feeds identical cleaned text to word+char; "
            "word_only suppresses learned terms only from fitted word vocabulary; raw is the safety baseline"
        ),
        "near_duplicate_similarity_cutoff": duplicate_cutoff,
        "near_duplicate_method": duplicate_method,
        "near_duplicate_families": int(len(set(family_ids.tolist()))),
        "duplicate_pairs_detected": int(len(duplicate_pairs)),
        "cluster_fit_representatives": len(fit_texts_model),
        "cluster_method": cluster_model.method,
        "selected_parameters": cluster_model.parameters,
        "merge_clusters_enabled": bool(config.merge_clusters),
        "persisted_merge_mapping_size": len(merge_map),
        "outlier_recovery": outlier_recovery_summary,
        "baseline_final_partition_metrics": baseline_final_metrics,
        "attempted_phase2_final_partition_metrics": attempted_final_metrics,
        "deployed_final_partition_metrics": deployed_final_metrics,
        "baseline_base_model_diagnostics": baseline_model_diagnostics,
        "attempted_base_model_diagnostics": attempted_model_diagnostics,
        "deployed_base_model_diagnostics": deployed_model_diagnostics,
        "structural_safety_gate": structural_gate_summary,
        "semantic_regression_guard": semantic_guard_summary,
        "business_semantic_acceptance": {
            "status": "PENDING_SME_REVIEW",
            "artifact": f"{corpus_name}_sme_review.csv",
            "note": "Structural safety and semantic regression protection do not certify business intent correctness.",
        },
        "recursive_refinements_triggered": int(sum(1 for r in refinement_audit if r.get("status") == "triggered")),
        "recursive_refinements_accepted": int(sum(1 for r in refinement_audit if r.get("status") == "accepted")),
        "reverted_to_baseline": reverted,
        "deployed_model_text_mode": deployed_mode,
        "reference_development_cluster_distribution": reference_distribution,
        "reference_development_outlier_rate": reference_outlier_rate,
        "reference_development_native_strength_quantiles": reference_strength,
        "reference_development_recovery_rate": reference_recovery_rate,
        "outlier_definition": "cluster_id=-1 means unresolved after native clustering and conservative persisted recovery.",
    }

    return {
        "rows": data,
        "text_col": text_col,
        "noise_table": noise_table,
        "preserved_phrases": preserved_phrases,
        "cluster_similarity": similarity,
        "noise_consensus_audit": noise_consensus_audit,
        "noise_policy_ablation": noise_policy_ablation,
        "duplicate_pairs": duplicate_pairs,
        "duplicate_families": duplicate_families,
        "model_search": search_table,
        "baseline_model_search": baseline_search,
        "refinement_audit": pd.DataFrame(refinement_audit),
        "merge_audit": merge_audit,
        "outlier_recovery_audit": outlier_recovery_thresholds,
        "quality_gate_audit": structural_gate_audit,
        "semantic_guard_audit": semantic_guard_audit,
        "cluster_catalog": catalog,
        "sme_review": sme_review,
        "before_after": before_after,
        "summary": summary,
        "bundle": bundle,
    }

