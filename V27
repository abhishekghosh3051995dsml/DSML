def save_bar_chart(labels: Sequence[str], values: Sequence[float], title: str, ylabel: str, path: Path) -> None:
    plt.figure(figsize=(10, 6))
    plt.bar(list(labels), list(values))
    plt.title(title)
    plt.ylabel(ylabel)
    plt.xticks(rotation=20, ha="right")
    plt.tight_layout()
    plt.savefig(path, dpi=160)
    plt.close()


def save_horizontal_cluster_chart(catalog: pd.DataFrame, title: str, path: Path, top_n: int = 25) -> None:
    if catalog.empty:
        return
    view = catalog.head(top_n).iloc[::-1]
    labels = [f"{int(r.cluster_id)}: {str(r.descriptor)[:55]}" for r in view.itertuples()]
