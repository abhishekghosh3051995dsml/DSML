def persist_result(
    result: Dict[str, Any],
    prefix: str,
    outdir: Path,
    pseudonym_key: bytes,
    persist_models: bool,
    export_review_text: bool,
) -> Dict[str, Any]:
    safe_rows = privacy_safe_rows(result, pseudonym_key, export_review_text)
    pii_columns = ["phase2_cluster_descriptor"] + (["redacted_text"] if export_review_text else [])
    pii_scan = residual_pii_counts(safe_rows, pii_columns)
    if any(v > 0 for v in pii_scan.values()):
        raise RuntimeError(f"Privacy guard blocked {prefix} row export; residual pattern counts={pii_scan}")
    safe_rows.to_csv(outdir / f"{prefix}_phase2_rows.csv", index=False)

    artifact_files: Dict[str, str] = {}
    for key, suffix in [
        ("noise_table", "noise_terms"),
        ("preserved_phrases", "preserved_phrases"),
        ("noise_consensus_audit", "noise_consensus_audit"),
        ("noise_policy_ablation", "noise_policy_ablation"),
        ("duplicate_pairs", "duplicate_pairs"),
        ("duplicate_families", "duplicate_families"),
        ("model_search", "cluster_model_search"),
        ("baseline_model_search", "baseline_model_search"),
        ("refinement_audit", "refinement_audit"),
        ("merge_audit", "merge_audit"),
        ("outlier_recovery_audit", "outlier_recovery_audit"),
        ("quality_gate_audit", "structural_safety_gate_audit"),
        ("semantic_guard_audit", "semantic_regression_guard_audit"),
        ("cluster_catalog", "cluster_catalog"),
        ("sme_review", "sme_review"),
        ("before_after", "before_after_metrics"),
    ]:
        export_frame = result[key].copy()
        if not export_review_text and "representative_examples" in export_frame.columns:
            export_frame = export_frame.drop(columns=["representative_examples"])
        export_frame = sanitize_frame_for_export(export_frame)
        human_cols = [c for c in ("representative_examples", "descriptor", "top_terms", "sme_business_label", "sme_notes") if c in export_frame.columns]
        audit_scan = residual_pii_counts(export_frame, human_cols)
        if any(v > 0 for v in audit_scan.values()):
            raise RuntimeError(
                f"Privacy guard blocked {prefix}_{suffix}.csv; residual pattern counts={audit_scan}"
            )
        path = outdir / f"{prefix}_{suffix}.csv"
        export_frame.to_csv(path, index=False)
        artifact_files[path.name] = sha256_file(path)

    save_horizontal_cluster_chart(
        result["cluster_catalog"], f"NORA Phase 2 refined {prefix} clusters",
        outdir / f"{prefix}_phase2_cluster_sizes.png",
    )
    save_noise_chart(result["noise_table"], outdir / f"{prefix}_learned_noise.png")
    save_policy_ablation_chart(
        result.get("noise_policy_ablation", pd.DataFrame()),
        outdir / f"{prefix}_noise_policy_ablation.png",
    )
    similarity = result.get("cluster_similarity", pd.DataFrame())
    if similarity is not None and not similarity.empty:
        similarity_export = similarity.copy()
        similarity_export.insert(0, "cluster_id", similarity_export.index)
        similarity_path = outdir / f"{prefix}_cluster_similarity.csv"
        similarity_export.to_csv(similarity_path, index=False)
        artifact_files[similarity_path.name] = sha256_file(similarity_path)
        save_cluster_similarity_heatmap(
            similarity,
            f"{prefix.title()} cluster centroid similarity",
            outdir / f"{prefix}_cluster_similarity_heatmap.png",
        )
    save_grouped_metric_chart(
        result["before_after"],
        ["npmi_coherence", "descriptor_diversity_composite", "mean_cluster_cohesion"],
        f"{prefix.title()} cluster interpretability: baseline vs deployed",
        outdir / f"{prefix}_before_after_interpretability.png",
    )
    save_grouped_metric_chart(
        result["before_after"],
        ["noise_rate", "assigned_fraction"],
        f"{prefix.title()} unassigned records: baseline vs deployed",
        outdir / f"{prefix}_before_after_coverage.png",
    )
    ba = result["before_after"]
    if not ba.empty:
        save_bar_chart(
            ba["stage"].tolist(), ba["silhouette"].fillna(0).tolist(),
            f"{prefix.title()} final-partition silhouette: baseline vs Phase 2", "Cosine silhouette",
            outdir / f"{prefix}_before_after_silhouette.png",
        )
        save_bar_chart(
            ba["stage"].tolist(), (100.0 * ba["largest_cluster_share"].fillna(0)).tolist(),
            f"{prefix.title()} final-partition largest-cluster dominance", "Largest cluster share (%)",
            outdir / f"{prefix}_before_after_largest_cluster.png",
        )

    model_info: Dict[str, Any] = {}
    if persist_models:
        model_path = outdir / f"{prefix}_model.joblib"
        joblib.dump(bundle_to_payload(result["bundle"]), model_path, compress=3)
        model_info = {
            "model_file": model_path.name,
            "model_sha256": sha256_file(model_path),
            "artifact_format": ARTIFACT_FORMAT_VERSION,
        }

    return {
        "residual_pii_patterns": pii_scan,
        "safe_export_rows": len(safe_rows),
        "review_text_exported": bool(export_review_text),
        "audit_file_sha256": artifact_files,
        **model_info,
    }

