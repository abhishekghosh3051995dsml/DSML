def run_train(config: Config) -> Dict[str, Any]:
    np.random.seed(config.seed)
    run_id = secrets.token_hex(8)
    started_at = utc_now_iso()
    outdir = Path(config.outdir)
    outdir.mkdir(parents=True, exist_ok=True)

    input_path = Path(config.input_path)
    if not input_path.exists():
        raise FileNotFoundError(f"Input CSV not found: {input_path}")

    dataset_sha256 = sha256_file(input_path)
    recorder = StageRecorder()
    cache = StageCache(
        Path(config.cache_dir),
        dataset_sha256,
        recorder,
        enabled=config.cache_enabled,
        resume=config.resume,
        refresh=config.refresh_cache,
    )

    frame, schema = cache.cached(
        "data.prepare",
        {"config": stage_config(config, "prepare")},
        lambda: load_and_prepare(config),
    )
    frame, split_audit = cache.cached(
        "data.split",
        {
            "prepared_groups": int(frame["_group"].nunique()),
            "config": stage_config(config, "split"),
        },
        lambda: assign_group_split(frame, config),
        rows_in=len(frame),
    )
    pseudonym_key, pseudonym_key_source = resolve_pseudonym_key(config)

    customer = frame[frame["_role"].eq("user")].copy().reset_index(drop=True)
    if len(customer) < 30:
        raise RuntimeError("Too few user/customer rows detected.")
    customer_result = process_corpus(
        customer, "_text", "customer", config, cache=cache
    )
    customer_export_audit = persist_result(
        customer_result,
        "customer",
        outdir,
        pseudonym_key,
        config.persist_models,
        config.export_review_text,
    )

    assistant_result: Optional[Dict[str, Any]] = None
    assistant_export_audit: Optional[Dict[str, Any]] = None
    assistant_skip_reason: Optional[str] = None

    if config.include_assistant:
        LOGGER.info("[6/9] Building assistant sentence units")
        units = cache.cached(
            "assistant.sentence_units",
            {
                "frame_rows": len(frame),
                "config": stage_config(config, "assistant_units"),
            },
            lambda: build_assistant_units(frame, config),
            rows_in=len(frame),
        )
        if len(units) >= 30:
            try:
                assistant_result = process_corpus(
                    units,
                    "assistant_sentence",
                    "assistant",
                    config,
                    cache=cache,
                )
                assistant_export_audit = persist_result(
                    assistant_result,
                    "assistant",
                    outdir,
                    pseudonym_key,
                    config.persist_models,
                    config.export_review_text,
                )
            except Exception as exc:
                assistant_skip_reason = str(exc)
                if config.failure_policy == "fail":
                    raise RuntimeError(
                        f"Assistant processing failed under failure_policy=fail: {exc}"
                    ) from exc
                LOGGER.warning(
                    "Assistant processing skipped under failure_policy=warn: %s", exc
                )
        else:
            assistant_skip_reason = f"only {len(units)} sentence units available, 30 required"
            if config.failure_policy == "fail":
                raise RuntimeError(
                    f"Assistant processing required but unavailable: {assistant_skip_reason}"
                )
            LOGGER.warning("Assistant processing skipped: %s", assistant_skip_reason)
    else:
        assistant_skip_reason = "disabled with --skip-assistant"

    stage_metrics = recorder.frame()
    stage_metrics.to_csv(outdir / "stage_metrics.csv", index=False)
    (outdir / "cache_manifest.json").write_text(
        json.dumps(to_plain(cache.manifest()), indent=2),
        encoding="utf-8",
    )

    customer_reverted = bool(customer_result["summary"].get("reverted_to_baseline"))
    assistant_reverted = bool(
        assistant_result and assistant_result["summary"].get("reverted_to_baseline")
    )
    pipeline_status = (
        "SUCCESS_WITH_SAFETY_REVERT"
        if customer_reverted or assistant_reverted
        else "SUCCESS"
    )

    LOGGER.info("[8/9] Writing consolidated audit report, executive summary and manifest")
    report = {
        "pipeline": PIPELINE_NAME,
        "pipeline_version": PIPELINE_VERSION,
        "run_id": run_id,
        "status": pipeline_status,
        "profile": config.profile,
        "started_at_utc": started_at,
        "completed_at_utc": utc_now_iso(),
        "architecture": (
            "group-isolated development/test -> privacy redaction -> cached raw-text baseline -> "
            "development-only multi-clustering noise consensus -> phrase-aware discriminative concept protection -> "
            "development-only noise-policy ablation -> word+character TF-IDF -> scalable ANN+exact duplicate validation -> "
            "representative-family fitting -> TruncatedSVD/LSA -> UMAP/HDBSCAN bounded multi-parameter search -> "
            "perturbation stability -> recursive refinement -> statistically justified persisted cluster merge -> "
            "persisted cluster-specific outlier recovery -> phrase-aware NPMI -> structural safety gate -> "
            "separate semantic regression guard -> SME review artifacts -> locked-test transform only -> "
            "privacy-safe persisted inference + runtime/cache/drift monitoring"
        ),
        "config": scrub_persisted_config(asdict(config)),
        "schema": schema,
        "runtime_versions": package_versions(),
        "split_audit": split_audit,
        "runtime": {
            "stage_count": int(len(stage_metrics)),
            "measured_stage_seconds": float(stage_metrics["elapsed_seconds"].sum())
            if not stage_metrics.empty
            else 0.0,
            "cache_hits": int(stage_metrics["cache_hit"].sum())
            if (not stage_metrics.empty and "cache_hit" in stage_metrics.columns)
            else 0,
            "cache_enabled": bool(config.cache_enabled),
            "resume": bool(config.resume),
            "cache_schema": CACHE_SCHEMA_VERSION,
        },
        "dataset": {
            "rows": len(frame),
            "user_rows": int((frame["_role"] == "user").sum()),
            "assistant_rows": int((frame["_role"] == "assistant").sum()),
            "development_rows": int((frame["data_split"] == "development").sum()),
            "locked_test_rows": int((frame["data_split"] == "locked_test").sum()),
        },
        "customer": customer_result["summary"],
        "customer_export_privacy_audit": customer_export_audit,
        "assistant": assistant_result["summary"] if assistant_result else {
            "status": "skipped",
            "reason": assistant_skip_reason,
        },
        "assistant_export_privacy_audit": assistant_export_audit,
        "governance": {
            "cluster_labels": "unsupervised candidate groups, not SME-validated business intents",
            "noise_terms": (
                "learned from development-corpus frequency/dispersion statistics; "
                "discriminative multi-word phrases are protected statistically; "
                "no manually curated NORA noise/intent list"
            ),
            "locked_test": (
                "never used to fit noise model, phrase protection, noise-policy choice, duplicate threshold, "
                "vocabulary, SVD, UMAP, clustering, merge, recovery thresholds, or semantic guard"
            ),
            "decision_separation": (
                "structural safety, semantic-regression protection, and SME business acceptance are independent decisions"
            ),
            "privacy": (
                "raw input text and raw case/conversation/group identifiers are never exported. "
                "Row-level review text is omitted by default and can be enabled only as redacted text."
            ),
            "pseudonym_key_source": pseudonym_key_source,
        },
    }

    report_path = outdir / config.report_json
    report_path.write_text(
        json.dumps(to_plain(report), indent=2),
        encoding="utf-8",
    )
    report_sha256 = sha256_file(report_path)

    executive_path = write_executive_summary(
        outdir,
        customer_result,
        assistant_result,
        split_audit,
        stage_metrics,
        pipeline_status,
    )

    manifest = {
        "pipeline": PIPELINE_NAME,
        "version": PIPELINE_VERSION,
        "run_id": run_id,
        "status": pipeline_status,
        "created_at_utc": utc_now_iso(),
        "created_for_mode": "train",
        "artifact_format": ARTIFACT_FORMAT_VERSION,
        "cache_schema": CACHE_SCHEMA_VERSION,
        "runtime_versions": package_versions(),
        "artifacts": {
            "customer_model": customer_export_audit.get("model_file"),
            "customer_model_sha256": customer_export_audit.get("model_sha256"),
            "assistant_model": assistant_export_audit.get("model_file")
            if assistant_export_audit
            else None,
            "assistant_model_sha256": assistant_export_audit.get("model_sha256")
            if assistant_export_audit
            else None,
            "report": config.report_json,
            "report_sha256": report_sha256,
            "executive_summary": str(executive_path.relative_to(outdir)),
            "stage_metrics": "stage_metrics.csv",
            "cache_manifest": "cache_manifest.json",
        },
        "privacy": {
            "review_text_exported": bool(config.export_review_text),
            "pseudonym_key_source": pseudonym_key_source,
            "pseudonym_secret_persisted": False,
        },
        "security_note": (
            "joblib artifacts must only be loaded from this trusted model directory; "
            "SHA-256 is verified before load."
        ),
    }
    (outdir / "model_manifest.json").write_text(
        json.dumps(to_plain(manifest), indent=2),
        encoding="utf-8",
    )

    LOGGER.info("[9/9] COMPLETE status=%s", pipeline_status)
    LOGGER.info("output directory: %s", outdir.resolve())
    LOGGER.info("executive summary: %s", executive_path.resolve())
    LOGGER.info("report: %s", report_path.resolve())
    return report



def run_inference(config: Config) -> Dict[str, Any]:
    run_id = secrets.token_hex(8)
    started_at = utc_now_iso()
    outdir = Path(config.outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    model_dir = Path(config.model_dir or "")
    manifest_path = model_dir / "model_manifest.json"
    if not manifest_path.exists():
        raise FileNotFoundError(f"Model manifest not found: {manifest_path}")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("artifact_format") != ARTIFACT_FORMAT_VERSION:
        raise RuntimeError(
            f"Manifest artifact format {manifest.get('artifact_format')!r} does not match "
            f"{ARTIFACT_FORMAT_VERSION!r}; retrain before inference."
        )
    artifacts = manifest.get("artifacts", {})

    customer_file = artifacts.get("customer_model") or "customer_model.joblib"
    customer_path = model_dir / customer_file
    if not customer_path.exists():
        raise FileNotFoundError(f"Customer model artifact not found: {customer_path}")
    customer_bundle = load_bundle(customer_path, artifacts.get("customer_model_sha256"))

    assistant_bundle: Optional[CorpusBundle] = None
    assistant_file = artifacts.get("assistant_model")
    if assistant_file and config.include_assistant:
        assistant_path = model_dir / assistant_file
        if assistant_path.exists():
            assistant_bundle = load_bundle(assistant_path, artifacts.get("assistant_model_sha256"))

    frame, schema = load_and_prepare(config)
    pseudonym_key, pseudonym_key_source = resolve_pseudonym_key(config)
    outputs: List[pd.DataFrame] = []
    drift: Dict[str, Any] = {}

    def build_safe_output(source: pd.DataFrame, detail: Dict[str, Any], corpus: str, sentence_index: Optional[pd.Series] = None) -> pd.DataFrame:
        safe = pd.DataFrame({
            "row_id": source["_row_id"].astype(int),
            "case_ref": source["_case"].map(lambda x: pseudonymize(x, pseudonym_key)),
            "conversation_ref": source["_conversation"].map(lambda x: pseudonymize(x, pseudonym_key)),
            "cluster_id": detail["labels"],
            "native_cluster_strength": detail["native_strengths"],
            "assignment_source": detail["assignment_source"],
            "recovery_similarity": detail["recovery_similarity"],
            "recovery_margin": detail["recovery_margin"],
            "cluster_descriptor": detail["descriptors"],
            "corpus": corpus,
        })
        if sentence_index is not None:
            safe["sentence_index"] = sentence_index.astype(int).values
        if config.export_review_text:
            safe["redacted_text"] = detail["redacted"]
        return safe

    def drift_payload(bundle: CorpusBundle, detail: Dict[str, Any]) -> Dict[str, Any]:
        labels = np.asarray(detail["labels"], dtype=int)
        strengths = np.asarray(detail["native_strengths"], dtype=float)
        sources = np.asarray(detail["assignment_source"], dtype=object)
        observed = cluster_distribution(labels)
        native_mask = sources != "recovered_outlier"
        return {
            "cluster_js_distance": cluster_js_distance(bundle.reference_cluster_distribution, observed),
            "reference_outlier_rate": bundle.reference_outlier_rate,
            "observed_outlier_rate": float(np.mean(labels == -1)) if len(labels) else 0.0,
            "reference_recovery_rate": bundle.reference_recovery_rate,
            "observed_recovery_rate": float(np.mean(sources == "recovered_outlier")) if len(sources) else 0.0,
            "reference_native_strength_quantiles": bundle.reference_strength_quantiles,
            "observed_native_strength_quantiles": strength_quantiles(strengths[native_mask]) if native_mask.any() else {},
            "noise_policy": bundle.noise_policy,
        }

    customer = frame[frame["_role"].eq("user")].copy().reset_index(drop=True)
    if len(customer):
        detail = customer_bundle.transform_texts_detailed(customer["_text"].tolist())
        outputs.append(build_safe_output(customer, detail, "customer"))
        drift["customer"] = drift_payload(customer_bundle, detail)

    if assistant_bundle is not None:
        units = build_assistant_units(frame.assign(data_split="inference"), config)
        if len(units):
            detail = assistant_bundle.transform_texts_detailed(units["assistant_sentence"].tolist())
            outputs.append(build_safe_output(units, detail, "assistant", units["sentence_index"]))
            drift["assistant"] = drift_payload(assistant_bundle, detail)

    combined = pd.concat(outputs, ignore_index=True) if outputs else pd.DataFrame()
    inference_path = outdir / "nora_phase2_inference.csv"
    pii_scan: Dict[str, int] = {name: 0 for name, _ in PII_PATTERNS}
    if not combined.empty:
        scan_columns = ["cluster_descriptor"] + (["redacted_text"] if config.export_review_text else [])
        pii_scan = residual_pii_counts(combined, scan_columns)
        if any(v > 0 for v in pii_scan.values()):
            raise RuntimeError(f"Privacy guard blocked inference export; residual patterns={pii_scan}")
        combined.to_csv(inference_path, index=False)

    report = {
        "pipeline": PIPELINE_NAME,
        "pipeline_version": PIPELINE_VERSION,
        "run_id": run_id,
        "started_at_utc": started_at,
        "completed_at_utc": utc_now_iso(),
        "mode": "infer",
        "input_rows": len(frame),
        "output_rows": len(combined),
        "model_dir": str(model_dir),
        "schema": schema,
        "runtime_versions": package_versions(),
        "artifact_manifest_verified": True,
        "privacy": {
            "review_text_exported": bool(config.export_review_text),
            "residual_pattern_scan": pii_scan,
            "pseudonym_key_source": pseudonym_key_source,
        },
        "drift": drift,
    }
    (outdir / "nora_phase2_inference_report.json").write_text(
        json.dumps(to_plain(report), indent=2), encoding="utf-8"
    )
    LOGGER.info("Inference complete: %d output rows", len(combined))
    return report


