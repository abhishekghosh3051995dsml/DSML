def parse_args(argv: Optional[Sequence[str]] = None) -> Config:
    parser = argparse.ArgumentParser(
        description=(
            f"{PIPELINE_NAME} - phrase-aware noise reduction, cluster refinement, "
            "resumable caching and manager reporting"
        )
    )
    parser.add_argument("--mode", choices=["train", "infer"], default="train")
    parser.add_argument("--profile", choices=["production", "fast_dev"], default="production")
    parser.add_argument("--input", required=True, dest="input_path", help="Input flattened NORA CSV")
    parser.add_argument("--outdir", default="nora_phase2_v26_out")
    parser.add_argument("--model-dir", default=None, help="Required for --mode infer")
    parser.add_argument("--report-json", default="nora_phase2_v26_report.json")
    parser.add_argument("--seed", type=int, default=DEFAULT_SEED)
    parser.add_argument(
        "--sample",
        type=int,
        default=0,
        dest="sample_rows",
        help="Group-preserving functional smoke sample; 0 uses all rows",
    )
    parser.add_argument("--test-size", type=float, default=0.20)
    parser.add_argument("--split-trials", type=int, default=64)

    parser.add_argument("--cache-dir", default=".nora_cache")
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--no-resume", action="store_true")
    parser.add_argument(
        "--refresh-cache",
        action="store_true",
        help="Ignore matching cache entries and recompute them",
    )
    parser.add_argument(
        "--failure-policy",
        choices=["fail", "warn"],
        default=None,
        help="production defaults to fail; fast_dev defaults to warn",
    )

    parser.add_argument("--max-word-features", type=int, default=60000)
    parser.add_argument("--max-char-features", type=int, default=90000)
    parser.add_argument("--svd-components", type=int, default=160)
    parser.add_argument("--candidate-noise-features", type=int, default=50000)
    parser.add_argument("--noise-max-ngram", type=int, default=3)
    parser.add_argument("--noise-stability-repeats", type=int, default=None)
    parser.add_argument("--noise-consensus-models", type=int, default=3)
    parser.add_argument("--noise-subsample-fraction", type=float, default=0.80)
    parser.add_argument(
        "--noise-policy",
        choices=["auto", "shared_clean", "word_only", "raw"],
        default="auto",
    )
    parser.add_argument("--noise-policy-search-trials", type=int, default=None)
    parser.add_argument("--noise-policy-sample-rows", type=int, default=None)
    parser.add_argument(
        "--no-phrase-protection",
        action="store_true",
        help="Disable data-derived discriminative phrase protection",
    )
    parser.add_argument("--phrase-protection-top-terms", type=int, default=5000)

    parser.add_argument("--model-search-trials", type=int, default=None)
    parser.add_argument("--stability-repeats", type=int, default=None)
    parser.add_argument("--stability-subsample-fraction", type=float, default=0.85)
    parser.add_argument("--search-sample-rows", type=int, default=None)
    parser.add_argument("--recursive-max-depth", type=int, default=2)
    parser.add_argument("--representative-examples", type=int, default=5)
    parser.add_argument("--max-cluster-fit-rows", type=int, default=30000)
    parser.add_argument("--assistant-max-units", type=int, default=120000)
    parser.add_argument("--duplicate-projection-components", type=int, default=64)
    parser.add_argument("--duplicate-neighbors", type=int, default=8)
    parser.add_argument("--ann-min-rows", type=int, default=5000)
    parser.add_argument("--transform-batch-size", type=int, default=4096)

    parser.add_argument(
        "--export-review-text",
        action="store_true",
        help="Export redacted review text; off by default",
    )
    parser.add_argument("--pseudonym-key-env", default="NORA_PSEUDONYM_KEY")
    parser.add_argument("--skip-assistant", action="store_true")
    parser.add_argument("--no-persist-models", action="store_true")
    parser.add_argument("--no-merge-clusters", action="store_true")
    parser.add_argument("--no-reassign-outliers", action="store_true")
    parser.add_argument("--coherence-top-terms", type=int, default=10)
    parser.add_argument("--semantic-guard-mode", choices=["block", "warn"], default="block")
    parser.add_argument("--semantic-bootstrap-repeats", type=int, default=None)
    parser.add_argument("--semantic-bootstrap-fraction", type=float, default=0.80)
    parser.add_argument("--semantic-guard-alpha", type=float, default=0.05)
    parser.add_argument(
        "--on-regression",
        choices=["report", "revert"],
        default="revert",
        help="Deployment behavior when structural or semantic deployment checks fail",
    )
    args = parser.parse_args(argv)

    # Profiles provide safe defaults only. Explicit CLI values always win.
    if args.profile == "fast_dev":
        model_search_trials = args.model_search_trials if args.model_search_trials is not None else 6
        stability_repeats = args.stability_repeats if args.stability_repeats is not None else 2
        noise_stability_repeats = (
            args.noise_stability_repeats if args.noise_stability_repeats is not None else 2
        )
        noise_policy_search_trials = (
            args.noise_policy_search_trials if args.noise_policy_search_trials is not None else 4
        )
        noise_policy_sample_rows = (
            args.noise_policy_sample_rows if args.noise_policy_sample_rows is not None else 2000
        )
        search_sample_rows = args.search_sample_rows if args.search_sample_rows is not None else 4000
        semantic_bootstrap_repeats = (
            args.semantic_bootstrap_repeats if args.semantic_bootstrap_repeats is not None else 24
        )
        failure_policy = args.failure_policy or "warn"
    else:
        model_search_trials = args.model_search_trials if args.model_search_trials is not None else 16
        stability_repeats = args.stability_repeats if args.stability_repeats is not None else 4
        noise_stability_repeats = (
            args.noise_stability_repeats if args.noise_stability_repeats is not None else 4
        )
        noise_policy_search_trials = (
            args.noise_policy_search_trials if args.noise_policy_search_trials is not None else 8
        )
        noise_policy_sample_rows = (
            args.noise_policy_sample_rows if args.noise_policy_sample_rows is not None else 4000
        )
        search_sample_rows = args.search_sample_rows if args.search_sample_rows is not None else 8000
        semantic_bootstrap_repeats = (
            args.semantic_bootstrap_repeats if args.semantic_bootstrap_repeats is not None else 64
        )
        failure_policy = args.failure_policy or "fail"

    if args.mode == "train" and not (0.05 <= args.test_size <= 0.40):
        parser.error("--test-size must be between 0.05 and 0.40")
    if args.noise_max_ngram < 1 or args.noise_max_ngram > 5:
        parser.error("--noise-max-ngram must be between 1 and 5")
    if not (0.60 <= args.noise_subsample_fraction <= 1.0):
        parser.error("--noise-subsample-fraction must be between 0.60 and 1.0")
    if noise_stability_repeats < 0:
        parser.error("--noise-stability-repeats must be >= 0")
    if args.noise_consensus_models < 1:
        parser.error("--noise-consensus-models must be >= 1")
    if noise_policy_search_trials < 1:
        parser.error("--noise-policy-search-trials must be >= 1")
    if noise_policy_sample_rows < 0:
        parser.error("--noise-policy-sample-rows must be >= 0")
    if args.phrase_protection_top_terms < 1:
        parser.error("--phrase-protection-top-terms must be >= 1")
    if args.coherence_top_terms < 2:
        parser.error("--coherence-top-terms must be >= 2")
    if semantic_bootstrap_repeats < 0:
        parser.error("--semantic-bootstrap-repeats must be >= 0")
    if not (0.50 <= args.semantic_bootstrap_fraction <= 1.0):
        parser.error("--semantic-bootstrap-fraction must be between 0.50 and 1.0")
    if not (0.001 <= args.semantic_guard_alpha <= 0.25):
        parser.error("--semantic-guard-alpha must be between 0.001 and 0.25")
    if not (0.60 <= args.stability_subsample_fraction <= 1.0):
        parser.error("--stability-subsample-fraction must be between 0.60 and 1.0")
    if args.mode == "infer" and not args.model_dir:
        parser.error("--model-dir is required when --mode infer")

    return Config(
        input_path=args.input_path,
        outdir=args.outdir,
        report_json=args.report_json,
        mode=args.mode,
        model_dir=args.model_dir,
        profile=args.profile,
        cache_dir=args.cache_dir,
        cache_enabled=not args.no_cache,
        resume=not args.no_resume,
        refresh_cache=args.refresh_cache,
        failure_policy=failure_policy,
        seed=args.seed,
        sample_rows=args.sample_rows,
        test_size=args.test_size,
        split_trials=args.split_trials,
        max_word_features=args.max_word_features,
        max_char_features=args.max_char_features,
        svd_components=args.svd_components,
        candidate_noise_features=args.candidate_noise_features,
        noise_max_ngram=args.noise_max_ngram,
        noise_stability_repeats=noise_stability_repeats,
        noise_consensus_models=args.noise_consensus_models,
        noise_subsample_fraction=args.noise_subsample_fraction,
        noise_policy=args.noise_policy,
        noise_policy_search_trials=noise_policy_search_trials,
        noise_policy_sample_rows=noise_policy_sample_rows,
        phrase_protection=not args.no_phrase_protection,
        phrase_protection_top_terms=args.phrase_protection_top_terms,
        model_search_trials=model_search_trials,
        stability_repeats=stability_repeats,
        stability_subsample_fraction=args.stability_subsample_fraction,
        search_sample_rows=search_sample_rows,
        recursive_max_depth=args.recursive_max_depth,
        representative_examples=args.representative_examples,
        max_cluster_fit_rows=args.max_cluster_fit_rows,
        assistant_max_units=args.assistant_max_units,
        duplicate_projection_components=args.duplicate_projection_components,
        duplicate_neighbors=args.duplicate_neighbors,
        ann_min_rows=args.ann_min_rows,
        transform_batch_size=args.transform_batch_size,
        export_review_text=args.export_review_text,
        pseudonym_key_env=args.pseudonym_key_env,
        include_assistant=not args.skip_assistant,
        on_regression=args.on_regression,
        persist_models=not args.no_persist_models,
        merge_clusters=not args.no_merge_clusters,
        reassign_outliers=not args.no_reassign_outliers,
        coherence_top_terms=args.coherence_top_terms,
        semantic_guard_mode=args.semantic_guard_mode,
        semantic_bootstrap_repeats=semantic_bootstrap_repeats,
        semantic_bootstrap_fraction=args.semantic_bootstrap_fraction,
        semantic_guard_alpha=args.semantic_guard_alpha,
    )



def main(argv: Optional[Sequence[str]] = None) -> int:
    configure_logging()
    try:
        config = parse_args(argv)
        if config.mode == "train":
            run_train(config)
        else:
            run_inference(config)
        return 0
    except KeyboardInterrupt:
        LOGGER.error("Interrupted by user.")
        return 130
    except Exception as exc:
        LOGGER.exception("Phase 2 failed: %s", exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
