# Scalable near-duplicate control
# ---------------------------------------------------------------------------

class UnionFind:
    def __init__(self, n: int) -> None:
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, x: int) -> int:
        while self.parent[x] != x:
            self.parent[x] = self.parent[self.parent[x]]
            x = self.parent[x]
        return x

    def union(self, a: int, b: int) -> None:
        ra, rb = self.find(a), self.find(b)
        if ra == rb:
            return
        if self.rank[ra] < self.rank[rb]:
            ra, rb = rb, ra
        self.parent[rb] = ra
        if self.rank[ra] == self.rank[rb]:
            self.rank[ra] += 1


def duplicate_feature_space(
    texts: Sequence[str], config: Config
) -> Tuple[sparse.csr_matrix, np.ndarray]:
    """Character TF-IDF for exact verification plus SVD projection for ANN retrieval."""
    values = list(texts)
    vec = TfidfVectorizer(
        analyzer="char_wb",
        ngram_range=(3, 5),
        min_df=1,
        sublinear_tf=True,
        norm="l2",
        max_features=min(config.max_char_features, 70000),
    )
    x = vec.fit_transform(values).tocsr()
    n_components = min(config.duplicate_projection_components, x.shape[0] - 1, x.shape[1] - 1)
    if n_components < 2:
        return x, x.toarray().astype(np.float32)
    svd = TruncatedSVD(n_components=n_components, random_state=config.seed)
    z = svd.fit_transform(x)
    z = Normalizer(copy=False).fit_transform(z)
    return x, np.asarray(z, dtype=np.float32)


def ann_neighbors(vectors: np.ndarray, k: int, config: Config) -> Tuple[np.ndarray, np.ndarray, str]:
    n = len(vectors)
    k = min(max(2, k), n)
    if n >= config.ann_min_rows:
        try:
            from pynndescent import NNDescent
            index = NNDescent(
                vectors,
                metric="cosine",
                n_neighbors=k,
                random_state=config.seed,
                low_memory=True,
                n_jobs=-1,
            )
            try:
                indices, distances = index.neighbor_graph
            except Exception:
                indices, distances = index.query(vectors, k=k)
            return np.asarray(indices), np.asarray(distances), "pynndescent_candidate_generation"
        except ImportError as exc:
            raise RuntimeError(
                f"pynndescent is required for scalable near-duplicate detection at n={n}; "
                "it is normally installed with umap-learn."
            ) from exc
    nn = NearestNeighbors(n_neighbors=k, metric="cosine", algorithm="brute", n_jobs=-1)
    nn.fit(vectors)
    distances, indices = nn.kneighbors(vectors)
    return indices, distances, "exact_candidate_generation_small_corpus"


def exact_sparse_cosine(x: sparse.csr_matrix, i: int, j: int) -> float:
    # TfidfVectorizer(norm='l2') makes the sparse dot product equal cosine similarity.
    return float(x.getrow(i).multiply(x.getrow(j)).sum())


def _refine_duplicate_components(
    preliminary_roots: Sequence[int],
    x: sparse.csr_matrix,
    projection: np.ndarray,
    cutoff: float,
) -> np.ndarray:
    """Break transitive duplicate chains using medoid-anchored exact similarity.

    Plain connected components can chain A~B and B~C even when A !~ C. Each
    preliminary component is therefore partitioned into medoid-centred families
    whose members individually satisfy the exact sparse-cosine cutoff to their
    representative.
    """
    components: Dict[int, List[int]] = defaultdict(list)
    for idx, root in enumerate(preliminary_roots):
        components[int(root)].append(idx)

    family_ids = np.full(len(preliminary_roots), -1, dtype=int)
    next_family = 0
    for members in components.values():
        remaining = list(members)
        while remaining:
            if len(remaining) == 1 or not np.isfinite(cutoff):
                anchor = remaining[0]
            else:
                block = projection[remaining]
                centroid = block.mean(axis=0)
                norm = np.linalg.norm(centroid)
                if norm > 0:
                    centroid = centroid / norm
                anchor = remaining[int(np.argmax(block @ centroid))]

            family = [anchor]
            for member in remaining:
                if member == anchor:
                    continue
                sim = exact_sparse_cosine(x, anchor, member)
                if sim >= cutoff or np.isclose(sim, cutoff, rtol=1e-9, atol=1e-12):
                    family.append(member)
            for member in family:
                family_ids[member] = next_family
            selected = set(family)
            remaining = [m for m in remaining if m not in selected]
            next_family += 1
    return family_ids


def detect_duplicate_families(
    texts: Sequence[str], config: Config
) -> Tuple[np.ndarray, pd.DataFrame, float, str, np.ndarray]:
    if len(texts) < 3:
        fam = np.arange(len(texts), dtype=int)
        return fam, pd.DataFrame(), float("inf"), "not_required", np.asarray(texts)

    x_sparse, projection = duplicate_feature_space(texts, config)
    indices, approx_distances, candidate_method = ann_neighbors(
        projection, config.duplicate_neighbors, config
    )

    # ANN is candidate generation only. Every candidate edge is re-ranked with
    # exact cosine similarity in the original normalized character TF-IDF space.
    exact_by_pair: Dict[Tuple[int, int], float] = {}
    nearest_exact = np.zeros(len(texts), dtype=float)
    approx_by_pair: Dict[Tuple[int, int], float] = {}
    for i in range(len(texts)):
        for j, approx_dist in zip(indices[i], approx_distances[i]):
            j = int(j)
            if j == i:
                continue
            a, b = (i, j) if i < j else (j, i)
            pair = (a, b)
            if pair not in exact_by_pair:
                exact_by_pair[pair] = exact_sparse_cosine(x_sparse, a, b)
                approx_by_pair[pair] = float(1.0 - approx_dist)
            sim = exact_by_pair[pair]
            nearest_exact[i] = max(nearest_exact[i], sim)
            nearest_exact[j] = max(nearest_exact[j], sim)

    cutoff, cutoff_method = distribution_upper_tail_cutoff(nearest_exact, config.seed)
    if np.isfinite(cutoff):
        cutoff = float(min(max(cutoff, 0.0), 1.0))

    uf = UnionFind(len(texts))
    pair_rows: List[Dict[str, Any]] = []
    for (i, j), exact_sim in exact_by_pair.items():
        accepted = bool(
            np.isfinite(cutoff)
            and (exact_sim >= cutoff or np.isclose(exact_sim, cutoff, rtol=1e-9, atol=1e-12))
        )
        if accepted:
            uf.union(i, j)
            pair_rows.append({
                "left_index": i,
                "right_index": j,
                "ann_projection_similarity": approx_by_pair[(i, j)],
                "exact_char_tfidf_similarity": exact_sim,
                "cutoff": cutoff,
                "accepted": True,
            })

    preliminary = [uf.find(i) for i in range(len(texts))]
    family_ids = _refine_duplicate_components(preliminary, x_sparse, projection, cutoff)
    for row in pair_rows:
        row["same_final_family"] = bool(
            family_ids[int(row["left_index"])] == family_ids[int(row["right_index"])]
        )
    method = f"{candidate_method}+exact_sparse_rerank+{cutoff_method}+medoid_chain_guard"
    return family_ids, pd.DataFrame(pair_rows), cutoff, method, projection

def choose_family_representatives(
    family_ids: np.ndarray, projection: np.ndarray
) -> Tuple[np.ndarray, pd.DataFrame]:
    families: Dict[int, List[int]] = defaultdict(list)
    for i, fam in enumerate(family_ids.tolist()):
        families[int(fam)].append(i)
    reps: List[int] = []
    rows: List[Dict[str, Any]] = []
    for fam, members in sorted(families.items()):
        if len(members) == 1:
            rep = members[0]
        else:
            block = projection[members]
            centroid = block.mean(axis=0)
            norm = np.linalg.norm(centroid)
            if norm > 0:
                centroid = centroid / norm
            similarities = block @ centroid
            rep = members[int(np.argmax(similarities))]
        reps.append(rep)
        rows.append({
            "duplicate_family_id": fam,
            "family_size": len(members),
            "representative_index": rep,
            "member_indices": ";".join(str(i) for i in members),
        })
    return np.asarray(reps, dtype=int), pd.DataFrame(rows)


