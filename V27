def adaptive_min_df(n_docs: int) -> int:
    return max(2, int(round(math.log2(max(n_docs, 4)) / 2.0)))


def build_vectorizer(
    config: Config,
    n_docs: int,
    min_df_override: Optional[int] = None,
    word_vocabulary: Optional[Sequence[str]] = None,
) -> FeatureUnion:
    min_df = int(min_df_override) if min_df_override is not None else adaptive_min_df(n_docs)
    word = TfidfVectorizer(
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(1, 3),
        min_df=min_df,
        max_df=1.0,
        max_features=config.max_word_features,
        sublinear_tf=True,
        norm="l2",
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b",
        stop_words=None,
        vocabulary=list(word_vocabulary) if word_vocabulary is not None else None,
    )
    char = TfidfVectorizer(
        analyzer="char_wb",
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(3, 5),
        min_df=min_df,
        max_features=config.max_char_features,
        sublinear_tf=True,
        norm="l2",
    )
    return FeatureUnion([("word", word), ("char", char)])


def suppressed_word_vocabulary(
    texts: Sequence[str], config: Config, noise_model: NoiseModel
) -> Optional[List[str]]:
    """Build the word vocabulary with development-learned noise terms withheld.

    This is used only by the `word_only` ablation policy.  The character branch
    still sees the untouched redacted text under that policy.  `shared_clean`
    instead feeds the same cleaned model text to both branches.
    """
    values = list(texts)
    probe = build_vectorizer(config, len(values))
    try:
        probe.fit(values)
    except ValueError:
        probe = build_vectorizer(config, len(values), min_df_override=1)
        probe.fit(values)
    blocked = set(noise_model.descriptor_blocklist) | noise_model.model_terms()
    vocab = [
        term for term in dict(probe.transformer_list)["word"].get_feature_names_out().tolist()
        if term not in blocked
    ]
    if len(vocab) < 10:
        LOGGER.warning(
            "word_only noise suppression would leave only %d word features; using the full word vocabulary",
            len(vocab),
        )
        return None
    return vocab


def prepare_model_texts(
    texts: Sequence[str], noise_model: NoiseModel, policy: str
) -> List[str]:
    policy = str(policy).lower()
    values = [str(x) for x in texts]
    if policy == "shared_clean":
        return [apply_noise_model(x, noise_model) for x in values]
    if policy in {"word_only", "raw"}:
        return values
    raise ValueError(f"Unsupported noise policy: {policy}")


def fit_latent(
    texts: Sequence[str],
    config: Config,
    noise_model: Optional[NoiseModel] = None,
    noise_policy: str = "raw",
) -> Tuple[LatentModel, np.ndarray]:
    """Fit TF-IDF -> SVD/LSA for a specific development-selected noise policy."""
    values = list(texts)
    policy = str(noise_policy).lower()
    word_vocabulary = None
    if noise_model is not None and policy == "word_only":
        word_vocabulary = suppressed_word_vocabulary(values, config, noise_model)
    vectorizer = build_vectorizer(
        config, len(values), word_vocabulary=word_vocabulary
    )
    try:
        x = vectorizer.fit_transform(values)
    except ValueError as exc:
        if "no terms remain" not in str(exc).lower() and "empty vocabulary" not in str(exc).lower():
            raise
        LOGGER.warning(
            "Adaptive min_df removed all features for n_docs=%d; retrying with min_df=1.",
            len(values),
        )
        vectorizer = build_vectorizer(
            config, len(values), min_df_override=1, word_vocabulary=word_vocabulary
        )
        x = vectorizer.fit_transform(values)
    n_components = min(config.svd_components, x.shape[0] - 1, x.shape[1] - 1)
    if n_components < 2:
        raise RuntimeError("Insufficient samples/features for SVD.")
    svd = TruncatedSVD(n_components=n_components, random_state=config.seed)
    z = svd.fit_transform(x)
    normalizer = Normalizer(copy=False)
    z = normalizer.fit_transform(z)
    model = LatentModel(vectorizer, svd, normalizer, batch_size=config.transform_batch_size)
    return model, np.asarray(z, dtype=np.float32)


def derive_search_grid(n: int, trials: int) -> List[Dict[str, Any]]:
    """Build a corpus-size-derived UMAP/HDBSCAN search surface.

    The grid explores neighborhood scale, embedding dimensionality, minimum
    distance, HDBSCAN minimum cluster support, density conservativeness, and
    EOM/leaf extraction. Values are derived from sample size rather than from
    a telecom-specific intent count.
    """
    if n < 8:
        return []
    logn = max(3.0, math.log2(n))
    sqrtn = math.sqrt(n)
    neighbor_candidates = sorted(set(
        min(n - 1, max(5, int(round(x))))
        for x in (logn, 2.0 * logn, math.sqrt(logn * sqrtn), sqrtn)
    ))
    component_candidates = sorted(set(
        max(2, min(int(round(x)), max(2, int(round(logn * 1.5)))))
        for x in (5.0, logn, 1.5 * logn)
    ))
    cluster_candidates = sorted(set(
        max(5, min(int(round(x)), max(5, n // 3)))
        for x in (1.5 * logn, 0.35 * sqrtn, 0.60 * sqrtn, sqrtn, 1.40 * sqrtn)
    ))

    combos: List[Dict[str, Any]] = []
    for nn in neighbor_candidates:
        min_dist_candidates = sorted(set((0.0, min(0.10, 1.0 / math.sqrt(max(nn, 1))))))
        for n_components in component_candidates:
            for min_dist in min_dist_candidates:
                for mcs in cluster_candidates:
                    min_samples_candidates = sorted(set(
                        max(2, min(mcs, int(round(x))))
                        for x in (math.log2(max(n, 4)), math.sqrt(max(mcs, 2)), mcs / 3.0)
                    ))
                    for min_samples in min_samples_candidates:
                        for method in ("eom", "leaf"):
                            combos.append({
                                "n_neighbors": int(nn),
                                "n_components": int(n_components),
                                "min_dist": float(min_dist),
                                "min_cluster_size": int(mcs),
                                "min_samples": int(min_samples),
                                "cluster_selection_method": method,
                            })
    if len(combos) <= trials:
        return combos
    # Deterministic stratified thinning across the ordered parameter surface.
    positions = np.linspace(0, len(combos) - 1, trials).round().astype(int)
    return [combos[i] for i in sorted(set(positions.tolist()))]

def cluster_size_entropy(labels: np.ndarray) -> float:
    valid = labels[labels != -1]
    if len(valid) == 0:
        return 0.0
    counts = np.asarray(list(Counter(valid.tolist()).values()), dtype=float)
    p = counts / counts.sum()
    entropy = -np.sum(p * np.log(p + 1e-12))
    max_entropy = math.log(max(len(counts), 2))
    return float(entropy / max_entropy) if max_entropy > 0 else 0.0


def safe_silhouette(vectors: np.ndarray, labels: np.ndarray, seed: int) -> Optional[float]:
    mask = labels != -1
    unique = set(labels[mask].tolist())
    if mask.sum() < 3 or len(unique) < 2:
        return None
    try:
        return float(silhouette_score(
            vectors[mask], labels[mask], metric="cosine",
            sample_size=min(5000, int(mask.sum())), random_state=seed,
        ))
    except Exception:
        return None


def safe_density_validity(reduced: np.ndarray, labels: np.ndarray, seed: int) -> Optional[float]:
    mask = labels != -1
    if mask.sum() < 10 or len(set(labels[mask].tolist())) < 2:
        return None
    idx = np.flatnonzero(mask)
    if len(idx) > 4000:
        rng = np.random.default_rng(seed)
        idx = np.sort(rng.choice(idx, size=4000, replace=False))
    try:
        from hdbscan.validity import validity_index
        return float(validity_index(reduced[idx], labels[idx], metric="euclidean"))
    except Exception:
        return None


def weighted_cluster_persistence(clusterer: Any, labels: np.ndarray) -> Optional[float]:
    try:
        persistence = np.asarray(clusterer.cluster_persistence_, dtype=float)
    except Exception:
        return None
    if persistence.size == 0:
        return None
    counts = Counter(int(x) for x in labels.tolist() if int(x) != -1)
    weights = np.asarray([counts.get(i, 0) for i in range(len(persistence))], dtype=float)
    if weights.sum() <= 0:
        return float(np.mean(persistence))
    return float(np.average(persistence, weights=weights))


def evaluate_cluster_candidate(
    vectors: np.ndarray,
    labels: np.ndarray,
    seed: int,
    reduced: Optional[np.ndarray] = None,
    clusterer: Any = None,
) -> Dict[str, float]:
    sil = safe_silhouette(vectors, labels, seed)
    noise_rate = float(np.mean(labels == -1))
    balance = cluster_size_entropy(labels)
    valid = labels[labels != -1]
    n_clusters = len(set(valid.tolist()))
    largest_share = 1.0
    if len(valid):
        largest_share = max(Counter(valid.tolist()).values()) / len(valid)
    density_validity = safe_density_validity(reduced, labels, seed) if reduced is not None else None
    persistence = weighted_cluster_persistence(clusterer, labels) if clusterer is not None else None
    return {
        "silhouette": float(sil) if sil is not None else float("nan"),
        "density_validity": float(density_validity) if density_validity is not None else float("nan"),
        "weighted_persistence": float(persistence) if persistence is not None else float("nan"),
        "noise_rate": noise_rate,
        "balance_entropy": balance,
        "n_clusters": float(n_clusters),
        "largest_cluster_share": float(largest_share),
    }


def fit_umap_hdbscan_once(
    vectors: np.ndarray, params: Dict[str, Any], seed: int
) -> Tuple[Any, Any, np.ndarray, np.ndarray, np.ndarray]:
    from umap import UMAP
    from hdbscan import HDBSCAN

    reducer = UMAP(
        n_neighbors=int(params["n_neighbors"]),
        n_components=int(params.get("n_components", 5)),
        min_dist=float(params.get("min_dist", 0.0)),
        metric="cosine",
        random_state=seed,
        transform_seed=seed,
        low_memory=True,
    )
    reduced = reducer.fit_transform(vectors)
    clusterer = HDBSCAN(
        min_cluster_size=int(params["min_cluster_size"]),
        min_samples=int(params["min_samples"]),
        metric="euclidean",
        cluster_selection_method=str(params["cluster_selection_method"]),
        prediction_data=True,
        core_dist_n_jobs=-1,
    )
    labels = clusterer.fit_predict(reduced).astype(int)
    strengths = np.asarray(clusterer.probabilities_, dtype=float)
    return reducer, clusterer, labels, strengths, np.asarray(reduced, dtype=np.float32)

def stability_for_params(
    vectors: np.ndarray,
    params: Dict[str, Any],
    seed: int,
    repeats: int,
    subsample_fraction: float = 0.85,
) -> Dict[str, float]:
    """Perturbation stability across independently subsampled development data.

    This is stronger than re-running only random UMAP seeds on the exact same
    rows: each repeat also perturbs the observed sample, and pairwise agreement
    is evaluated only on rows shared by the two subsamples.
    """
    n = len(vectors)
    if n < 8:
        return {"global_ari": 0.0, "assigned_ari": 0.0, "outlier_jaccard": 0.0, "mean_overlap": 0.0}
    frac = float(min(max(subsample_fraction, 0.60), 1.0))
    sample_n = max(8, min(n, int(round(frac * n))))
    runs: List[Tuple[np.ndarray, np.ndarray]] = []
    for i in range(max(2, repeats)):
        rng = np.random.default_rng(seed + i * 9973)
        idx = np.arange(n, dtype=int) if sample_n == n else np.sort(rng.choice(n, size=sample_n, replace=False))
        local_params = dict(params)
        if sample_n < n:
            ratio = sample_n / n
            local_params["min_cluster_size"] = max(
                5, min(sample_n // 3, int(round(int(params["min_cluster_size"]) * ratio)))
            )
            local_params["min_samples"] = max(
                2, min(local_params["min_cluster_size"], int(round(int(params["min_samples"]) * ratio)))
            )
            local_params["n_neighbors"] = min(int(params["n_neighbors"]), sample_n - 1)
        try:
            _, _, labels, _, _ = fit_umap_hdbscan_once(vectors[idx], local_params, seed + i * 997)
            runs.append((idx, labels))
        except Exception:
            return {"global_ari": 0.0, "assigned_ari": 0.0, "outlier_jaccard": 0.0, "mean_overlap": 0.0}

    global_aris: List[float] = []
    assigned_aris: List[float] = []
    outlier_jaccards: List[float] = []
    overlaps: List[float] = []
    for i in range(len(runs)):
        for j in range(i + 1, len(runs)):
            idx_a, lab_a = runs[i]
            idx_b, lab_b = runs[j]
            common, ia, ib = np.intersect1d(idx_a, idx_b, assume_unique=True, return_indices=True)
            if len(common) < 3:
                continue
            a, b = lab_a[ia], lab_b[ib]
            overlaps.append(len(common) / max(min(len(idx_a), len(idx_b)), 1))
            global_aris.append(float(adjusted_rand_score(a, b)))
            mask = (a != -1) & (b != -1)
            if mask.sum() >= 3 and len(set(a[mask].tolist())) >= 2 and len(set(b[mask].tolist())) >= 2:
                assigned_aris.append(float(adjusted_rand_score(a[mask], b[mask])))
            ao = set(np.flatnonzero(a == -1).tolist())
            bo = set(np.flatnonzero(b == -1).tolist())
            union = ao | bo
            outlier_jaccards.append(1.0 if not union else len(ao & bo) / len(union))
    return {
        "global_ari": float(np.mean(global_aris)) if global_aris else 0.0,
        "assigned_ari": float(np.mean(assigned_aris)) if assigned_aris else 0.0,
        "outlier_jaccard": float(np.mean(outlier_jaccards)) if outlier_jaccards else 0.0,
        "mean_overlap": float(np.mean(overlaps)) if overlaps else 0.0,
    }

def kmeans_distance_thresholds(model: MiniBatchKMeans, vectors: np.ndarray, labels: np.ndarray) -> Dict[int, float]:
    distances = model.transform(vectors)
    own = distances[np.arange(len(vectors)), labels]
    thresholds: Dict[int, float] = {}
    for cid in sorted(set(labels.tolist())):
        values = own[labels == cid]
        threshold = robust_upper_fence(values)
        if not np.isfinite(threshold):
            threshold = float(np.max(values)) if len(values) else float("inf")
        thresholds[int(cid)] = float(threshold)
    return thresholds


def apply_kmeans_outlier_gate(
    model: MiniBatchKMeans,
    vectors: np.ndarray,
    labels: np.ndarray,
    thresholds: Dict[int, float],
) -> Tuple[np.ndarray, np.ndarray]:
    distances = model.transform(vectors)
    own = distances[np.arange(len(vectors)), labels]
    out = labels.copy().astype(int)
    strengths = 1.0 / (1.0 + own)
    for i, (cid, dist) in enumerate(zip(labels.tolist(), own.tolist())):
        if dist > thresholds.get(int(cid), float("inf")):
            out[i] = -1
            strengths[i] = 0.0
    return out, strengths.astype(float)


def fit_kmeans_fallback(
    vectors: np.ndarray, seed: int
) -> Tuple[ClusterModel, np.ndarray, np.ndarray, pd.DataFrame]:
    n = len(vectors)
    max_k = max(2, min(int(round(math.sqrt(max(n, 4)))), 40))
    rows: List[Dict[str, Any]] = []
    best: Optional[Tuple[float, MiniBatchKMeans, np.ndarray, np.ndarray, Dict[int, float]]] = None
    for k in range(2, max_k + 1):
        model = MiniBatchKMeans(
            n_clusters=k, random_state=seed,
            batch_size=min(4096, max(256, n)), n_init="auto",
        )
        raw_labels = model.fit_predict(vectors).astype(int)
        thresholds = kmeans_distance_thresholds(model, vectors, raw_labels)
        labels, strengths = apply_kmeans_outlier_gate(model, vectors, raw_labels, thresholds)
        metrics = evaluate_cluster_candidate(vectors, labels, seed)
        if metrics["n_clusters"] < 2 or not np.isfinite(metrics["silhouette"]):
            continue
        rows.append({"method": "minibatch_kmeans", "k": k, **metrics})
    if not rows:
        raise RuntimeError("Unable to fit fallback clusterer.")
    table = pd.DataFrame(rows)
    rank_cols = [
        percentile_rank(table["silhouette"], True),
        percentile_rank(table["balance_entropy"], True),
        percentile_rank(table["largest_cluster_share"], False),
    ]
    table["selection_score"] = pd.concat(rank_cols, axis=1).median(axis=1)
    best_row = table.loc[table["selection_score"].idxmax()]
    k = int(best_row["k"])
    model = MiniBatchKMeans(
        n_clusters=k, random_state=seed,
        batch_size=min(4096, max(256, n)), n_init="auto",
    )
    raw_labels = model.fit_predict(vectors).astype(int)
    thresholds = kmeans_distance_thresholds(model, vectors, raw_labels)
    labels, strengths = apply_kmeans_outlier_gate(model, vectors, raw_labels, thresholds)
    cluster_model = ClusterModel(
        method="minibatch_kmeans",
        reducer=None,
        clusterer=model,
        parameters={"k": k, "distance_thresholds": thresholds},
        global_stability_ari=None,
        assigned_stability_ari=None,
        outlier_jaccard=None,
        silhouette=safe_silhouette(vectors, labels, seed),
        density_validity=None,
        weighted_persistence=None,
        selection_score=float(best_row["selection_score"]),
    )
    return cluster_model, labels, strengths, table.sort_values("selection_score", ascending=False).reset_index(drop=True)


def fit_cluster_search(
    vectors: np.ndarray, config: Config, seed: Optional[int] = None
) -> Tuple[ClusterModel, np.ndarray, np.ndarray, pd.DataFrame]:
    seed = config.seed if seed is None else seed
    if len(vectors) < 8:
        return fit_kmeans_fallback(vectors, seed)
    try:
        import umap  # noqa: F401
        import hdbscan  # noqa: F401
    except ImportError:
        LOGGER.warning("UMAP/HDBSCAN unavailable; using outlier-aware MiniBatchKMeans fallback.")
        return fit_kmeans_fallback(vectors, seed)

    if len(vectors) > config.search_sample_rows > 0:
        rng = np.random.default_rng(seed)
        search_idx = np.sort(rng.choice(len(vectors), size=config.search_sample_rows, replace=False))
        search_vectors = vectors[search_idx]
    else:
        search_vectors = vectors

    grid = derive_search_grid(len(search_vectors), config.model_search_trials)
    rows: List[Dict[str, Any]] = []
    for params in grid:
        try:
            _, clusterer, labels, _, reduced = fit_umap_hdbscan_once(search_vectors, params, seed)
            metrics = evaluate_cluster_candidate(search_vectors, labels, seed, reduced, clusterer)
            if metrics["n_clusters"] < 2:
                continue
            rows.append({**params, **metrics})
        except Exception as exc:
            LOGGER.debug("cluster candidate failed %s: %s", params, exc)
    if not rows:
        return fit_kmeans_fallback(vectors, seed)

    table = pd.DataFrame(rows)
    noise_rank = table["noise_rate"].rank(pct=True)
    table["noise_plausibility"] = 1.0 - 2.0 * np.abs(noise_rank - 0.5)
    coarse_components = [
        percentile_rank(table["silhouette"], True),
        percentile_rank(table["density_validity"], True),
        percentile_rank(table["weighted_persistence"], True),
        percentile_rank(table["balance_entropy"], True),
        percentile_rank(table["largest_cluster_share"], False),
        table["noise_plausibility"].fillna(0.5),
    ]
    table["coarse_score"] = pd.concat(coarse_components, axis=1).median(axis=1)

    top_n = max(2, min(len(table), int(round(math.sqrt(len(table)))) + 1))
    top_idx = table.nlargest(top_n, "coarse_score").index.tolist()
    stability_rows: Dict[int, Dict[str, float]] = {}
    for idx in top_idx:
        params = {
            "n_neighbors": int(table.at[idx, "n_neighbors"]),
            "n_components": int(table.at[idx, "n_components"]),
            "min_dist": float(table.at[idx, "min_dist"]),
            "min_cluster_size": int(table.at[idx, "min_cluster_size"]),
            "min_samples": int(table.at[idx, "min_samples"]),
            "cluster_selection_method": str(table.at[idx, "cluster_selection_method"]),
        }
        stability_rows[int(idx)] = stability_for_params(
            search_vectors, params, seed, config.stability_repeats,
            config.stability_subsample_fraction,
        )
    for key in ("global_ari", "assigned_ari", "outlier_jaccard", "mean_overlap"):
        table[key] = [stability_rows.get(int(i), {}).get(key, np.nan) for i in table.index]

    final_components = [
        percentile_rank(table["silhouette"], True),
        percentile_rank(table["density_validity"], True),
        percentile_rank(table["weighted_persistence"], True),
        percentile_rank(table["balance_entropy"], True),
        percentile_rank(table["largest_cluster_share"], False),
        table["noise_plausibility"].fillna(0.5),
        percentile_rank(table["assigned_ari"], True),
        percentile_rank(table["outlier_jaccard"], True),
    ]
    table["selection_score"] = pd.concat(final_components, axis=1).median(axis=1)
    best_idx = int(table["selection_score"].idxmax())
    best = table.loc[best_idx]
    best_params = {
        "n_neighbors": int(best["n_neighbors"]),
        "n_components": int(best["n_components"]),
        "min_dist": float(best["min_dist"]),
        "min_cluster_size": int(best["min_cluster_size"]),
        "min_samples": int(best["min_samples"]),
        "cluster_selection_method": str(best["cluster_selection_method"]),
    }

    if len(search_vectors) < len(vectors):
        # Preserve the selected support *proportion* when refitting on more
        # development rows. UMAP neighborhood size stays fixed because it
        # represents local scale rather than a population proportion.
        support_ratio = best_params["min_cluster_size"] / max(len(search_vectors), 1)
        best_params["min_cluster_size"] = max(
            5, min(len(vectors) // 3, int(round(support_ratio * len(vectors))))
        )
        conservativeness = float(best["min_samples"]) / max(float(best["min_cluster_size"]), 1.0)
        best_params["min_samples"] = max(
            2, min(best_params["min_cluster_size"], int(round(best_params["min_cluster_size"] * conservativeness)))
        )
        best_params["n_neighbors"] = min(best_params["n_neighbors"], len(vectors) - 1)

    reducer, clusterer, labels, strengths, reduced = fit_umap_hdbscan_once(vectors, best_params, seed)
    final_metrics = evaluate_cluster_candidate(vectors, labels, seed, reduced, clusterer)

    # Re-estimate perturbation stability for the *deployed* parameterization.
    # If the full fit is larger than the bounded stability sample, scale only
    # support parameters to the evaluation sample while preserving proportions.
    if len(vectors) > config.search_sample_rows > 0:
        rng = np.random.default_rng(seed + 7919)
        stab_idx = np.sort(rng.choice(len(vectors), size=config.search_sample_rows, replace=False))
        stab_vectors = vectors[stab_idx]
        stab_params = dict(best_params)
        ratio = len(stab_vectors) / len(vectors)
        stab_params["min_cluster_size"] = max(5, int(round(best_params["min_cluster_size"] * ratio)))
        stab_params["min_samples"] = max(
            2, min(stab_params["min_cluster_size"], int(round(best_params["min_samples"] * ratio)))
        )
        stab_params["n_neighbors"] = min(best_params["n_neighbors"], len(stab_vectors) - 1)
    else:
        stab_vectors = vectors
        stab_params = dict(best_params)
    stability = stability_for_params(
        stab_vectors, stab_params, seed + 3571, config.stability_repeats,
        config.stability_subsample_fraction,
    )
    model = ClusterModel(
        method="umap_hdbscan_search",
        reducer=reducer,
        clusterer=clusterer,
        parameters={**best_params, "search_rows": int(len(search_vectors)), "fit_rows": int(len(vectors))},
        global_stability_ari=float(stability.get("global_ari", np.nan)),
        assigned_stability_ari=float(stability.get("assigned_ari", np.nan)),
        outlier_jaccard=float(stability.get("outlier_jaccard", np.nan)),
        silhouette=float(final_metrics["silhouette"]) if np.isfinite(final_metrics["silhouette"]) else None,
        density_validity=float(final_metrics["density_validity"]) if np.isfinite(final_metrics["density_validity"]) else None,
        weighted_persistence=float(final_metrics["weighted_persistence"]) if np.isfinite(final_metrics["weighted_persistence"]) else None,
        selection_score=float(best["selection_score"]),
    )
    return model, labels, strengths, table.sort_values("selection_score", ascending=False).reset_index(drop=True)


def predict_cluster(model: ClusterModel, vectors: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
    if len(vectors) == 0:
        return np.asarray([], dtype=int), np.asarray([], dtype=float)
    if model.method == "umap_hdbscan_search":
        try:
            from hdbscan.prediction import approximate_predict
            reduced = model.reducer.transform(vectors)
            labels, strengths = approximate_predict(model.clusterer, reduced)
            return labels.astype(int), strengths.astype(float)
        except Exception as exc:
            LOGGER.warning("HDBSCAN approximate prediction failed: %s", exc)
            return np.full(len(vectors), -1, dtype=int), np.zeros(len(vectors), dtype=float)
    if model.method == "minibatch_kmeans":
        raw = model.clusterer.predict(vectors).astype(int)
        thresholds = {int(k): float(v) for k, v in model.parameters.get("distance_thresholds", {}).items()}
        return apply_kmeans_outlier_gate(model.clusterer, vectors, raw, thresholds)
    return np.full(len(vectors), -1, dtype=int), np.zeros(len(vectors), dtype=float)

