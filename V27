def build_assistant_units(frame: pd.DataFrame, config: Config) -> pd.DataFrame:
    rows: List[Dict[str, Any]] = []
    assistant = frame[frame["_role"].eq("assistant")].copy()
    for _, row in assistant.iterrows():
        parts = [
            p.strip() for p in SENTENCE_SPLIT_RE.split(str(row["_text"]))
            if len(tokenize(p)) >= 3
        ]
        for sentence_idx, sentence in enumerate(parts):
            rows.append({
                "_row_id": int(row["_row_id"]),
                "_case": str(row["_case"]),
                "_conversation": str(row["_conversation"]),
                "_group": str(row["_group"]),
                "data_split": str(row["data_split"]),
                "sentence_index": sentence_idx,
                "assistant_sentence": redact_pii(sentence),
            })
    units = pd.DataFrame(rows)
    if units.empty:
        return units
    if config.assistant_max_units > 0 and len(units) > config.assistant_max_units:
        LOGGER.warning(
            "assistant sentence units=%d exceed advisory threshold=%d; retaining all rows. "
            "Training cost remains bounded by max_cluster_fit_rows/search_sample_rows and ANN duplicate search.",
            len(units), config.assistant_max_units,
        )
    return units


