class StageCache:
    """Content-addressed resumable local cache with an audit manifest."""

    def __init__(
        self,
        root: Path,
        dataset_sha256: str,
        recorder: StageRecorder,
        enabled: bool = True,
        resume: bool = True,
        refresh: bool = False,
    ) -> None:
        self.root = Path(root)
        self.dataset_sha256 = str(dataset_sha256)
        self.recorder = recorder
        self.enabled = bool(enabled)
        self.resume = bool(resume)
        self.refresh = bool(refresh)
        self.entries: List[Dict[str, Any]] = []
        if self.enabled:
            self.root.mkdir(parents=True, exist_ok=True)

    def _path(self, stage: str, payload: Dict[str, Any]) -> Tuple[Path, str]:
        key_payload = {
            "cache_schema": CACHE_SCHEMA_VERSION,
            "pipeline_version": PIPELINE_VERSION,
            "artifact_format": ARTIFACT_FORMAT_VERSION,
            "dataset_sha256": self.dataset_sha256,
            "stage": stage,
            "payload": payload,
        }
        key = stable_payload_hash(key_payload)
        safe_stage = re.sub(r"[^a-zA-Z0-9_.-]+", "_", stage)
        return self.root / self.dataset_sha256[:16] / safe_stage / f"{key}.joblib", key

    def cached(
        self,
        stage: str,
        payload: Dict[str, Any],
        compute: Any,
        rows_in: Optional[int] = None,
    ) -> Any:
        path, key = self._path(stage, payload)
        start = time.perf_counter()
        hit = False
        try:
            if self.enabled and self.resume and not self.refresh and path.exists():
                value = joblib.load(path)
                hit = True
                status = "CACHE_HIT"
            else:
                value = compute()
                status = "SUCCESS"
                if self.enabled:
                    path.parent.mkdir(parents=True, exist_ok=True)
                    tmp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
                    joblib.dump(value, tmp, compress=3)
                    os.replace(tmp, path)
            elapsed = time.perf_counter() - start
            rows_out: Optional[int] = None
            if isinstance(value, pd.DataFrame):
                rows_out = len(value)
            elif isinstance(value, tuple) and value and isinstance(value[0], pd.DataFrame):
                rows_out = len(value[0])
            self.recorder.add(stage, elapsed, status, hit, rows_in, rows_out, key)
            self.entries.append({
                "stage": stage,
                "cache_key": key,
                "cache_hit": hit,
                "path": str(path) if self.enabled else "",
                "elapsed_seconds": elapsed,
            })
            LOGGER.info("stage=%s status=%s elapsed=%.2fs", stage, status, elapsed)
            return value
        except Exception as exc:
            elapsed = time.perf_counter() - start
            self.recorder.add(stage, elapsed, "FAILED", hit, rows_in, None, key, str(exc))
            raise

    def manifest(self) -> Dict[str, Any]:
        return {
            "cache_schema": CACHE_SCHEMA_VERSION,
            "dataset_sha256": self.dataset_sha256,
            "enabled": self.enabled,
            "resume": self.resume,
            "refresh": self.refresh,
            "entries": self.entries,
        }


