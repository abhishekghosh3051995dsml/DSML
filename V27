def find_column(columns: Sequence[str], patterns: Sequence[str]) -> Optional[str]:
    normalized = {c: normalise_key(c) for c in columns}
    for pattern in patterns:
        for c, key in normalized.items():
            if re.search(pattern, key):
                return c
    return None


def discover_schema(df: pd.DataFrame) -> Dict[str, Optional[str]]:
    cols = list(df.columns)
    return {
        "case": find_column(cols, [r"^source_row$", r"source.*row", r"case.*id", r"ticket.*id"]),
        "turn": find_column(cols, [r"message_index", r"turn.*index", r"sequence", r"^index$"]),
        "conversation": find_column(cols, [r"message.*cid", r"^cid$", r"conversation.*id", r"interaction.*id"]),
        "text": find_column(cols, [r"message.*content", r"^content$", r"^text$", r"message.*text"]),
        "broad_label": find_column(cols, [r"classification.*intent", r"^intent$", r"broad.*intent"]),
        "role": find_column(cols, [r"^message_type$", r"message.*type", r"^role$"]),
    }


def infer_role(row: pd.Series, role_col: Optional[str]) -> str:
    candidates: List[str] = []
    if role_col and role_col in row.index:
        candidates.append(str(row.get(role_col, "")))
    for col in row.index:
        if "type" in normalise_key(col) or "role" in normalise_key(col):
            candidates.append(str(row.get(col, "")))
    joined = " ".join(candidates).lower()
    if re.search(r"\b(user|customer|human|subscriber)\b", joined):
        return "user"
    if re.search(r"\b(assistant|agent|bot|system)\b", joined):
        return "assistant"
    return "unknown"



def group_preserving_sample(frame: pd.DataFrame, target_rows: int, seed: int) -> pd.DataFrame:
    """Functional-test sampling that never fragments a conversation/group."""
    if target_rows <= 0 or len(frame) <= target_rows:
        return frame.copy()
    stats = frame.groupby("_group", sort=False).size().reset_index(name="rows")
    rng = np.random.default_rng(seed)
    order = rng.permutation(len(stats))
    selected: List[str] = []
    running = 0
    for pos in order.tolist():
        group = str(stats.at[pos, "_group"])
        size = int(stats.at[pos, "rows"])
        if not selected or abs(target_rows - (running + size)) <= abs(target_rows - running):
            selected.append(group)
            running += size
        elif running >= target_rows:
            break
    if not selected:
        selected = [str(stats.at[int(order[0]), "_group"])]
    return frame[frame["_group"].isin(set(selected))].copy().reset_index(drop=True)


def load_and_prepare(config: Config) -> Tuple[pd.DataFrame, Dict[str, Optional[str]]]:
    LOGGER.info("[1/9] Loading data and resolving schema")
    path = Path(config.input_path)
    if not path.exists():
        raise FileNotFoundError(f"Input CSV not found: {path}")
    df = pd.read_csv(path, low_memory=False)
    schema = discover_schema(df)
    if schema["text"] is None:
        raise ValueError("Unable to discover the message text column.")

    frame = df.copy().reset_index(drop=True)
    frame["_row_id"] = np.arange(len(frame), dtype=int)
    frame["_raw_text"] = frame[schema["text"]].fillna("").astype(str)
    frame["_text"] = frame["_raw_text"].map(redact_pii)
    frame["_role"] = frame.apply(lambda r: infer_role(r, schema["role"]), axis=1)
    frame["_case"] = (
        frame[schema["case"]].fillna("").astype(str)
        if schema["case"] else "row_" + frame["_row_id"].astype(str)
    )
    frame["_conversation"] = (
        frame[schema["conversation"]].fillna("").astype(str)
        if schema["conversation"] else frame["_case"]
    )
    frame["_group"] = frame["_conversation"].where(frame["_conversation"].str.len() > 0, frame["_case"])
    frame["_group"] = frame["_group"].where(frame["_group"].str.len() > 0, "row_" + frame["_row_id"].astype(str))
    if config.sample_rows > 0:
        frame = group_preserving_sample(frame, config.sample_rows, config.seed)
        frame["_row_id"] = np.arange(len(frame), dtype=int)
        LOGGER.info("group-preserving smoke sample rows=%d", len(frame))
    LOGGER.info(
        "rows=%d user=%d assistant=%d unknown=%d",
        len(frame), int((frame["_role"] == "user").sum()),
        int((frame["_role"] == "assistant").sum()), int((frame["_role"] == "unknown").sum()),
    )
    return frame, schema


def assign_group_split(frame: pd.DataFrame, config: Config) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    """Deterministic group-preserving split targeting rows and role composition.

    No labels or text content influence the partition. Multiple deterministic
    group permutations are evaluated; the selected split minimizes row-ratio
    error plus total-variation drift in role composition, while guaranteeing
    zero group overlap.
    """
    LOGGER.info("[2/9] Creating locked group-aware development/test split")
    out = frame.copy()
    stats = out.groupby("_group", sort=False).agg(rows=("_row_id", "size")).reset_index()
    total_rows = len(out)
    target_rows = int(round(config.test_size * total_rows))
    roles = sorted(out["_role"].astype(str).unique().tolist())
    global_role = out["_role"].astype(str).value_counts(normalize=True).reindex(roles, fill_value=0.0)

    best: Optional[Tuple[float, set[str], Dict[str, Any]]] = None
    for trial in range(max(8, config.split_trials)):
        rng = np.random.default_rng(config.seed + trial * 104729)
        order = rng.permutation(len(stats))
        selected: List[int] = []
        running = 0
        for pos in order.tolist():
            size = int(stats.at[pos, "rows"])
            candidate_error = abs(target_rows - (running + size))
            current_error = abs(target_rows - running)
            if not selected or candidate_error <= current_error:
                selected.append(pos)
                running += size
            elif running >= target_rows:
                break
        if not selected:
            selected = [int(order[0])]

        groups = set(stats.loc[selected, "_group"].astype(str))
        test_mask = out["_group"].isin(groups)
        test_rows = int(test_mask.sum())
        if test_rows == 0 or test_rows == total_rows:
            continue
        test_role = (
            out.loc[test_mask, "_role"].astype(str).value_counts(normalize=True)
            .reindex(roles, fill_value=0.0)
        )
        row_error = abs(test_rows / total_rows - config.test_size)
        role_tv = 0.5 * float(np.abs(test_role.values - global_role.values).sum())
        score = row_error + role_tv
        audit = {
            "trial": trial,
            "test_rows": test_rows,
            "development_rows": total_rows - test_rows,
            "test_ratio": test_rows / total_rows,
            "target_test_ratio": config.test_size,
            "row_ratio_error": row_error,
            "role_total_variation": role_tv,
            "global_role_distribution": global_role.to_dict(),
            "test_role_distribution": test_role.to_dict(),
        }
        if best is None or score < best[0]:
            best = (score, groups, audit)

    if best is None:
        raise RuntimeError("Unable to construct a valid group-aware split.")
    _, test_groups, audit = best
    out["data_split"] = np.where(out["_group"].isin(test_groups), "locked_test", "development")
    dev_groups = set(out.loc[out["data_split"] == "development", "_group"].astype(str))
    overlap = dev_groups & test_groups
    if overlap:
        raise AssertionError(f"Group leakage detected: {len(overlap)} overlapping groups")
    if set(out["data_split"].unique()) != {"development", "locked_test"}:
        raise AssertionError("Split assignment did not produce both development and locked_test partitions")

    # Exact cross-split text overlap is audited, not used to fit or choose models.
    dev_text = set(out.loc[out["data_split"] == "development", "_text"].astype(str))
    test_text = set(out.loc[out["data_split"] == "locked_test", "_text"].astype(str))
    audit["group_overlap_count"] = 0
    audit["development_groups"] = len(dev_groups)
    audit["locked_test_groups"] = len(test_groups)
    audit["cross_split_exact_text_overlap"] = len(dev_text & test_text)
    LOGGER.info("split audit=%s", audit)
    return out, audit

