@dataclass
class LatentModel:
    vectorizer: FeatureUnion
    svd: TruncatedSVD
    normalizer: Normalizer
    batch_size: int = 4096

    def transform(self, texts: Sequence[str]) -> np.ndarray:
        values = list(texts)
        if not values:
            return np.empty((0, int(self.svd.n_components)), dtype=np.float32)
        parts: List[np.ndarray] = []
        for start in range(0, len(values), max(1, self.batch_size)):
            batch = values[start:start + max(1, self.batch_size)]
            x = self.vectorizer.transform(batch)
            z = self.svd.transform(x)
            z = self.normalizer.transform(z)
            parts.append(np.asarray(z, dtype=np.float32))
        return np.vstack(parts)


