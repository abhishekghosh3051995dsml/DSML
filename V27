@dataclass
class CorpusBundle:
    pipeline_name: str
    pipeline_version: str
    corpus_name: str
    noise_model: NoiseModel
    noise_policy: str
    latent_model: LatentModel
    cluster_model: ClusterModel
    refinement_rules: List[RefinementRule]
    merge_map: Dict[int, int]
    outlier_recovery_model: Optional[OutlierRecoveryModel]
    descriptions: Dict[int, Dict[str, Any]]
    model_text_mode: str
    reference_cluster_distribution: Dict[int, float] = field(default_factory=dict)
    reference_outlier_rate: float = 0.0
    reference_strength_quantiles: Dict[str, float] = field(default_factory=dict)
    reference_recovery_rate: float = 0.0
    config: Dict[str, Any] = field(default_factory=dict)

    def _prepare_model_text(self, redacted: Sequence[str]) -> List[str]:
        policy = str(self.noise_policy or self.model_text_mode or "raw").lower()
        if policy in {"shared_clean", "noise_reduced"}:
            return [apply_noise_model(x, self.noise_model) for x in redacted]
        # word_only uses a fitted word vocabulary with learned terms withheld;
        # raw and word_only therefore both transform the untouched redacted text.
        return list(redacted)

    def transform_texts_detailed(self, texts: Sequence[str]) -> Dict[str, Any]:
        redacted = [redact_pii(str(x or "")) for x in texts]
        model_text = self._prepare_model_text(redacted)
        vectors = self.latent_model.transform(model_text)
        labels, strengths, assignment_source, recovery_similarity, recovery_margin = predict_final_partition(
            self.cluster_model,
            self.refinement_rules,
            vectors,
            self.merge_map,
            self.outlier_recovery_model,
        )
        descriptors = [
            "unassigned" if int(lab) == -1
            else self.descriptions.get(int(lab), {}).get("descriptor", f"cluster_{int(lab)}")
            for lab in labels.tolist()
        ]
        return {
            "redacted": redacted,
            "model_text": model_text,
            "labels": labels,
            "native_strengths": strengths,
            "descriptors": descriptors,
            "assignment_source": assignment_source,
            "recovery_similarity": recovery_similarity,
            "recovery_margin": recovery_margin,
        }

    def transform_texts(self, texts: Sequence[str]) -> Tuple[List[str], np.ndarray, np.ndarray, List[str]]:
        """Backward-compatible four-value inference boundary."""
        detail = self.transform_texts_detailed(texts)
        return (
            detail["redacted"], detail["labels"], detail["native_strengths"], detail["descriptors"]
        )


