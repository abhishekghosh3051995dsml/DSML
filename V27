def _image_data_uri(path: Path) -> str:
    if not path.exists():
        return ""
    encoded = base64.b64encode(path.read_bytes()).decode("ascii")
    return f"data:image/png;base64,{encoded}"


def manager_metrics_frame(
    customer_result: Dict[str, Any], assistant_result: Optional[Dict[str, Any]]
) -> pd.DataFrame:
    rows: List[Dict[str, Any]] = []
    for corpus, result in (("customer", customer_result), ("assistant", assistant_result)):
        if not result:
            continue
        summary = result["summary"]
        metrics = summary.get("deployed_final_partition_metrics", {})
        rows.append({
            "corpus": corpus,
            "development_rows": summary.get("development_rows"),
            "locked_test_rows": summary.get("locked_test_rows"),
            "unique_development_texts": summary.get("unique_development_texts"),
            "noise_policy": summary.get("noise_policy_deployed"),
            "learned_noise_unigrams": summary.get("learned_noise_unigrams"),
            "protected_phrases": summary.get("protected_discriminative_phrases"),
            "n_clusters": metrics.get("n_clusters"),
            "silhouette": metrics.get("silhouette"),
            "npmi_coherence": metrics.get("npmi_coherence"),
            "descriptor_diversity": metrics.get("descriptor_diversity_composite"),
            "mean_cluster_cohesion": metrics.get("mean_cluster_cohesion"),
            "largest_cluster_share": metrics.get("largest_cluster_share"),
            "noise_rate": metrics.get("noise_rate"),
            "assigned_fraction": metrics.get("assigned_fraction"),
            "structural_gate": "PASS" if summary.get("structural_safety_gate", {}).get("passed") else "BLOCK",
            "semantic_guard": summary.get("semantic_regression_guard", {}).get("status"),
            "reverted_to_baseline": summary.get("reverted_to_baseline"),
            "sme_status": "PENDING_SME_REVIEW",
        })
    return pd.DataFrame(rows)


