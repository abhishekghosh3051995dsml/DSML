def local_cluster_cohesion(vectors: np.ndarray, labels: np.ndarray) -> Dict[int, float]:
    output: Dict[int, float] = {}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cid)
        if len(idx) < 3:
            output[cid] = 1.0
            continue
        centroid = vectors[idx].mean(axis=0)
        norm = np.linalg.norm(centroid)
        if norm > 0:
            centroid = centroid / norm
        output[cid] = float(np.mean(vectors[idx] @ centroid))
    return output


def cohesion_gain_bootstrap(
    vectors: np.ndarray,
    parent_idx: np.ndarray,
    child_labels: np.ndarray,
    seed: int,
    repeats: int = 200,
) -> Tuple[float, float]:
    block = vectors[parent_idx]
    parent_centroid = block.mean(axis=0)
    pnorm = np.linalg.norm(parent_centroid)
    if pnorm > 0:
        parent_centroid /= pnorm
    parent_sim = block @ parent_centroid
    child_sim = np.zeros(len(block), dtype=float)
    for cid in sorted(set(int(x) for x in child_labels.tolist() if int(x) != -1)):
        local = np.flatnonzero(child_labels == cid)
        centroid = block[local].mean(axis=0)
        norm = np.linalg.norm(centroid)
        if norm > 0:
            centroid /= norm
        child_sim[local] = block[local] @ centroid
    assigned = child_labels != -1
    if assigned.sum() < 3:
        return 0.0, 0.0
    delta = child_sim[assigned] - parent_sim[assigned]
    mean_delta = float(np.mean(delta))
    rng = np.random.default_rng(seed)
    samples = []
    for _ in range(repeats):
        sample = rng.choice(delta, size=len(delta), replace=True)
        samples.append(float(np.mean(sample)))
    lower = float(np.quantile(samples, 0.025))
    return mean_delta, lower


def refine_clusters(
    vectors: np.ndarray,
    base_labels: np.ndarray,
    base_strengths: np.ndarray,
    config: Config,
) -> Tuple[np.ndarray, np.ndarray, List[Dict[str, Any]], List[RefinementRule]]:
    labels = base_labels.copy().astype(int)
    strengths = base_strengths.copy().astype(float)
    audit: List[Dict[str, Any]] = []
    rules: List[RefinementRule] = []
    next_id = max([x for x in labels.tolist() if x >= 0], default=-1) + 1

    for depth in range(config.recursive_max_depth):
        valid_ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
        if len(valid_ids) < 2:
            break
        sizes = {cid: int((labels == cid).sum()) for cid in valid_ids}
        cohesions = local_cluster_cohesion(vectors, labels)
        size_fence = robust_upper_fence(list(sizes.values()))
        cohesion_floor = robust_lower_fence(list(cohesions.values()))
        candidates = [
            cid for cid in valid_ids
            if sizes[cid] > size_fence or cohesions[cid] < cohesion_floor
        ]
        for cid in valid_ids:
            audit.append({
                "depth": depth + 1,
                "parent_cluster": cid,
                "parent_size": sizes[cid],
                "parent_cohesion": cohesions[cid],
                "size_upper_fence": float(size_fence),
                "cohesion_lower_fence": float(cohesion_floor),
                "oversized": bool(sizes[cid] > size_fence),
                "incoherent": bool(cohesions[cid] < cohesion_floor),
                "status": "triggered" if cid in candidates else "not_triggered",
            })

        if not candidates:
            largest = max(valid_ids, key=lambda c: sizes[c])
            shares = np.asarray(list(sizes.values()), dtype=float) / max(sum(sizes.values()), 1)
            share_fence = robust_upper_fence(shares)
            largest_share = sizes[largest] / max(sum(sizes.values()), 1)
            if largest_share > share_fence:
                candidates = [largest]
                audit.append({
                    "depth": depth + 1,
                    "parent_cluster": largest,
                    "parent_size": sizes[largest],
                    "parent_share": largest_share,
                    "share_upper_fence": share_fence,
                    "status": "triggered",
                    "reason": "distribution_derived_dominance_trigger",
                })

        any_split = False
        for cid in candidates:
            idx = np.flatnonzero(labels == cid)
            data_driven_min = max(8, int(round(math.log2(max(len(vectors), 16)))))
            if len(idx) < data_driven_min:
                audit.append({
                    "depth": depth + 1, "parent_cluster": cid,
                    "parent_size": len(idx), "status": "skipped",
                    "reason": "insufficient_support_for_local_model",
                })
                continue
            local_vectors = vectors[idx]
            local_cfg = Config(**{
                **asdict(config),
                "model_search_trials": max(8, config.model_search_trials // 2),
                "stability_repeats": max(2, config.stability_repeats - 1),
            })
            try:
                child_model, child_labels, child_strengths, child_search = fit_cluster_search(
                    local_vectors, local_cfg, seed=config.seed + depth + cid + 1
                )
            except Exception as exc:
                audit.append({"depth": depth + 1, "parent_cluster": cid, "status": "failed", "reason": str(exc)})
                continue
            child_ids = sorted(set(int(x) for x in child_labels.tolist() if int(x) != -1))
            if len(child_ids) < 2:
                audit.append({"depth": depth + 1, "parent_cluster": cid, "status": "rejected", "reason": "fewer_than_two_children"})
                continue

            mean_gain, lower_gain = cohesion_gain_bootstrap(
                vectors, idx, child_labels, seed=config.seed + depth + cid + 991
            )
            child_sil = safe_silhouette(local_vectors, child_labels, config.seed)
            stability = child_model.assigned_stability_ari
            stability_values = pd.to_numeric(child_search.get("assigned_ari", pd.Series(dtype=float)), errors="coerce").dropna()
            stability_floor = float(stability_values.median()) if len(stability_values) else 0.0
            child_sizes = [int((child_labels == c).sum()) for c in child_ids]
            child_balance = cluster_size_entropy(child_labels)
            selection_values = pd.to_numeric(
                child_search.get("selection_score", pd.Series(dtype=float)), errors="coerce"
            ).dropna()
            selection_floor = float(selection_values.median()) if len(selection_values) else float("-inf")
            density_values = pd.to_numeric(
                child_search.get("density_validity", pd.Series(dtype=float)), errors="coerce"
            ).dropna()
            density_floor = float(density_values.median()) if len(density_values) else float("-inf")
            density_ok = (
                child_model.density_validity is None
                or not np.isfinite(child_model.density_validity)
                or child_model.density_validity >= density_floor
            )
            selection_ok = (
                child_model.selection_score is None
                or not np.isfinite(child_model.selection_score)
                or child_model.selection_score >= selection_floor
            )
            accept = (
                lower_gain > 0.0
                and child_sil is not None and child_sil > 0.0
                and (stability is None or not np.isfinite(stability) or stability >= stability_floor)
                and density_ok
                and selection_ok
                and child_balance > 0.0
            )
            audit.append({
                "depth": depth + 1,
                "parent_cluster": cid,
                "parent_size": len(idx),
                "child_clusters": len(child_ids),
                "cohesion_gain_mean": mean_gain,
                "cohesion_gain_bootstrap_lower_95": lower_gain,
                "child_silhouette": child_sil,
                "child_assigned_stability_ari": stability,
                "child_stability_reference_median": stability_floor,
                "child_balance_entropy": child_balance,
                "child_density_validity": child_model.density_validity,
                "child_density_reference_median": density_floor,
                "child_selection_score": child_model.selection_score,
                "child_selection_reference_median": selection_floor,
                "largest_child_share": max(child_sizes) / max(sum(child_sizes), 1),
                "child_method": child_model.method,
                "status": "accepted" if accept else "rejected",
            })
            if not accept:
                continue
            mapping = {child: next_id + pos for pos, child in enumerate(child_ids)}
            next_id += len(child_ids)
            rules.append(RefinementRule(
                parent_cluster=int(cid), model=child_model,
                child_id_map={int(k): int(v) for k, v in mapping.items()}, depth=depth + 1,
            ))
            for local_pos, global_pos in enumerate(idx.tolist()):
                child = int(child_labels[local_pos])
                if child == -1:
                    continue
                labels[global_pos] = mapping[child]
                strengths[global_pos] = float(child_strengths[local_pos])
            any_split = True
        LOGGER.info(
            "refinement depth %d: %d evaluated, %d triggered, %d accepted",
            depth + 1, len(valid_ids), len(candidates),
            sum(1 for row in audit if row.get("depth") == depth + 1 and row.get("status") == "accepted"),
        )
        if not any_split:
            break
    return labels, strengths, audit, rules


def apply_merge_map(labels: np.ndarray, merge_map: Optional[Dict[int, int]] = None) -> np.ndarray:
    if not merge_map:
        return np.asarray(labels, dtype=int).copy()
    return np.asarray([
        -1 if int(label) == -1 else int(merge_map.get(int(label), int(label)))
        for label in np.asarray(labels, dtype=int).tolist()
    ], dtype=int)


def statistically_justified_merge(
    vectors: np.ndarray,
    labels: np.ndarray,
    config: Config,
) -> Tuple[np.ndarray, Dict[int, int], pd.DataFrame]:
    """Optionally merge only a statistically distinct high-similarity centroid tail.

    No percentile fallback forces a merge.  If a two-component Gaussian mixture
    is not BIC-supported for between-centroid similarities, the function leaves
    the partition unchanged.  Candidate groups also use complete-link centroid
    similarity plus a cohesion non-degradation check, preventing transitive
    A~B~C chains from collapsing semantically different clusters.
    """
    base = np.asarray(labels, dtype=int)
    audit: List[Dict[str, Any]] = []
    if not config.merge_clusters:
        return base.copy(), {}, pd.DataFrame([{"status": "disabled"}])
    ids = sorted(set(int(x) for x in base.tolist() if int(x) != -1))
    if len(ids) < 3:
        return base.copy(), {}, pd.DataFrame([{"status": "not_required", "reason": "fewer_than_three_clusters"}])

    centroids: Dict[int, np.ndarray] = {}
    cohesion = local_cluster_cohesion(vectors, base)
    for cid in ids:
        block = vectors[base == cid]
        centroid = block.mean(axis=0)
        norm = float(np.linalg.norm(centroid))
        centroids[cid] = centroid / norm if norm > 0 else centroid

    pair_values: List[float] = []
    pair_lookup: Dict[Tuple[int, int], float] = {}
    for i, left in enumerate(ids):
        for right in ids[i + 1:]:
            sim = float(centroids[left] @ centroids[right])
            pair_values.append(sim)
            pair_lookup[(left, right)] = sim
    threshold, method = distribution_upper_tail_cutoff(pair_values, config.seed + 4241)
    if method != "gmm_bic_two_component" or not np.isfinite(threshold):
        audit.append({
            "status": "no_merge",
            "threshold_method": method,
            "merge_threshold": threshold,
            "reason": "no_BIC_supported_high_similarity_component",
        })
        return base.copy(), {}, pd.DataFrame(audit)

    groups: List[set[int]] = [{cid} for cid in ids]
    candidates = sorted(
        [(sim, left, right) for (left, right), sim in pair_lookup.items() if sim >= threshold],
        reverse=True,
    )
    for sim, left, right in candidates:
        gi = next((i for i, g in enumerate(groups) if left in g), None)
        gj = next((i for i, g in enumerate(groups) if right in g), None)
        if gi is None or gj is None or gi == gj:
            continue
        g1, g2 = groups[gi], groups[gj]
        cross = []
        for a in g1:
            for b in g2:
                key = (a, b) if a < b else (b, a)
                cross.append(pair_lookup[key])
        complete_link_ok = bool(cross) and min(cross) >= threshold
        merged_members = g1 | g2
        idx = np.flatnonzero(np.isin(base, list(merged_members)))
        merged_centroid = vectors[idx].mean(axis=0)
        norm = float(np.linalg.norm(merged_centroid))
        if norm > 0:
            merged_centroid = merged_centroid / norm
        merged_cohesion = float(np.mean(vectors[idx] @ merged_centroid)) if len(idx) else float("nan")
        constituent_floor = min(cohesion.get(cid, -1.0) for cid in merged_members)
        cohesion_ok = np.isfinite(merged_cohesion) and merged_cohesion >= constituent_floor
        accepted = complete_link_ok and cohesion_ok
        audit.append({
            "status": "accepted" if accepted else "rejected",
            "left_group": ";".join(str(x) for x in sorted(g1)),
            "right_group": ";".join(str(x) for x in sorted(g2)),
            "candidate_centroid_cosine": sim,
            "minimum_cross_centroid_cosine": min(cross) if cross else np.nan,
            "merge_threshold": threshold,
            "threshold_method": method,
            "merged_cohesion": merged_cohesion,
            "constituent_cohesion_floor": constituent_floor,
            "complete_link_ok": complete_link_ok,
            "cohesion_non_degradation_ok": cohesion_ok,
        })
        if accepted:
            new_group = merged_members
            for index in sorted((gi, gj), reverse=True):
                groups.pop(index)
            groups.append(new_group)

    merge_map: Dict[int, int] = {}
    for group in groups:
        canonical = min(group)
        for cid in group:
            if cid != canonical:
                merge_map[int(cid)] = int(canonical)
    merged = apply_merge_map(base, merge_map)
    return merged, merge_map, pd.DataFrame(audit)


def predict_with_refinements(
    base_model: ClusterModel,
    rules: Sequence[RefinementRule],
    vectors: np.ndarray,
    merge_map: Optional[Dict[int, int]] = None,
) -> Tuple[np.ndarray, np.ndarray]:
    labels, strengths = predict_cluster(base_model, vectors)
    labels = labels.astype(int)
    strengths = strengths.astype(float)
    for rule in rules:
        idx = np.flatnonzero(labels == int(rule.parent_cluster))
        if len(idx) == 0:
            continue
        child_labels, child_strengths = predict_cluster(rule.model, vectors[idx])
        for local_pos, global_pos in enumerate(idx.tolist()):
            mapped = rule.child_id_map.get(int(child_labels[local_pos]))
            if mapped is not None:
                labels[global_pos] = int(mapped)
                strengths[global_pos] = float(child_strengths[local_pos])
    labels = apply_merge_map(labels, merge_map)
    return labels, strengths

def fit_outlier_recovery_model(
    vectors: np.ndarray,
    labels: np.ndarray,
    config: Config,
) -> Tuple[Optional[OutlierRecoveryModel], pd.DataFrame]:
    """Learn conservative cluster-specific recovery boundaries from assigned development rows."""
    labels = np.asarray(labels, dtype=int)
    ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if not config.reassign_outliers:
        return None, pd.DataFrame([{"status": "disabled"}])
    if len(ids) < 2:
        return None, pd.DataFrame([{"status": "not_available", "reason": "fewer_than_two_clusters"}])

    centroids: List[np.ndarray] = []
    for cid in ids:
        block = vectors[labels == cid]
        centroid = block.mean(axis=0)
        norm = float(np.linalg.norm(centroid))
        centroids.append(centroid / norm if norm > 0 else centroid)
    matrix = np.vstack(centroids).astype(np.float32)
    similarities = np.asarray(vectors @ matrix.T, dtype=float)

    similarity_floors: Dict[int, float] = {}
    margin_floors: Dict[int, float] = {}
    audit: List[Dict[str, Any]] = []
    for col, cid in enumerate(ids):
        idx = np.flatnonzero(labels == cid)
        own = similarities[idx, col]
        other = np.delete(similarities[idx], col, axis=1)
        second = np.max(other, axis=1) if other.shape[1] else np.full(len(idx), -1.0)
        margin = own - second
        sim_floor, sim_method = distribution_lower_tail_cutoff(
            own.tolist(), config.seed + 4001 + int(cid)
        )
        margin_floor, margin_method = distribution_lower_tail_cutoff(
            margin.tolist(), config.seed + 7001 + int(cid)
        )
        sim_floor = float(np.clip(sim_floor, -1.0, 1.0)) if np.isfinite(sim_floor) else float("inf")
        margin_floor = float(np.clip(margin_floor, -2.0, 2.0)) if np.isfinite(margin_floor) else float("inf")
        similarity_floors[int(cid)] = sim_floor
        margin_floors[int(cid)] = margin_floor
        audit.append({
            "cluster_id": int(cid),
            "assigned_members": int(len(idx)),
            "similarity_floor": sim_floor,
            "similarity_floor_method": sim_method,
            "margin_floor": margin_floor,
            "margin_floor_method": margin_method,
            "member_similarity_median": float(np.median(own)) if len(own) else np.nan,
            "member_margin_median": float(np.median(margin)) if len(margin) else np.nan,
            "status": "fitted",
        })

    return OutlierRecoveryModel(
        cluster_ids=np.asarray(ids, dtype=int),
        centroids=matrix,
        similarity_floors=similarity_floors,
        margin_floors=margin_floors,
        fit_rows=int(np.sum(labels != -1)),
        enabled=True,
    ), pd.DataFrame(audit)


def apply_outlier_recovery_model(
    vectors: np.ndarray,
    labels: np.ndarray,
    native_strengths: np.ndarray,
    model: Optional[OutlierRecoveryModel],
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    """Recover only borderline outliers using persisted cluster-specific evidence.

    `native_strengths` remains the original HDBSCAN/KMeans strength. Recovery
    similarity and margin are separate fields, so two incomparable confidence
    concepts are never mixed into one number.
    """
    labels = np.asarray(labels, dtype=int).copy()
    strengths = np.asarray(native_strengths, dtype=float).copy()
    sources = np.asarray(["native" if int(x) != -1 else "outlier" for x in labels], dtype=object)
    recovery_similarity = np.full(len(labels), np.nan, dtype=float)
    recovery_margin = np.full(len(labels), np.nan, dtype=float)

    if model is None or not model.enabled or len(model.cluster_ids) < 2:
        return labels, strengths, sources, recovery_similarity, recovery_margin
    outliers = np.flatnonzero(labels == -1)
    if len(outliers) == 0:
        return labels, strengths, sources, recovery_similarity, recovery_margin

    similarity = np.asarray(vectors[outliers] @ model.centroids.T, dtype=float)
    order = np.argsort(similarity, axis=1)
    best_pos = order[:, -1]
    second_pos = order[:, -2]
    best_score = similarity[np.arange(len(outliers)), best_pos]
    second_score = similarity[np.arange(len(outliers)), second_pos]
    margin = best_score - second_score

    for local, row in enumerate(outliers.tolist()):
        cid = int(model.cluster_ids[int(best_pos[local])])
        sim_floor = float(model.similarity_floors.get(cid, float("inf")))
        margin_floor = float(model.margin_floors.get(cid, float("inf")))
        recovery_similarity[row] = float(best_score[local])
        recovery_margin[row] = float(margin[local])
        if best_score[local] >= sim_floor and margin[local] >= margin_floor:
            labels[row] = cid
            sources[row] = "recovered_outlier"
            # Native strength intentionally remains unchanged (typically zero).

    return labels, strengths, sources, recovery_similarity, recovery_margin


def predict_final_partition(
    base_model: ClusterModel,
    rules: Sequence[RefinementRule],
    vectors: np.ndarray,
    merge_map: Optional[Dict[int, int]] = None,
    outlier_recovery_model: Optional[OutlierRecoveryModel] = None,
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    labels, strengths = predict_with_refinements(base_model, rules, vectors, merge_map)
    return apply_outlier_recovery_model(
        vectors, labels, strengths, outlier_recovery_model
    )


def diverse_top_terms(terms: np.ndarray, scores: np.ndarray, top_n: int) -> List[int]:
    ranked = [int(i) for i in np.argsort(scores)[::-1] if scores[int(i)] > 0]
    chosen: List[int] = []
    while ranked and len(chosen) < top_n:
        best_idx = None
        best_value = float("-inf")
        for idx in ranked[: min(200, len(ranked))]:
            tokens = set(str(terms[idx]).split())
            overlap = 0.0
            if chosen:
                overlap = max(
                    len(tokens & set(str(terms[c]).split())) / max(len(tokens | set(str(terms[c]).split())), 1)
                    for c in chosen
                )
            value = float(scores[idx]) * (1.0 - overlap)
            if value > best_value:
                best_value = value
                best_idx = idx
        if best_idx is None:
            break
        chosen.append(best_idx)
        ranked.remove(best_idx)
    return chosen


def ctfidf_descriptions(
    texts: Sequence[str],
    labels: np.ndarray,
    top_n: int = 12,
    blocked_terms: Optional[set[str]] = None,
) -> Dict[int, Dict[str, Any]]:
    ids = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if not ids:
        return {}
    grouped = [" ".join(str(text) for text, label in zip(texts, labels) if int(label) == cid) for cid in ids]
    vectorizer = CountVectorizer(
        lowercase=True, strip_accents="unicode", ngram_range=(1, 3),
        min_df=1, max_features=50000,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b", stop_words=None,
    )
    counts = vectorizer.fit_transform(grouped).astype(np.float64)
    terms = np.asarray(vectorizer.get_feature_names_out())
    blocked = blocked_terms or set()

    # Class-based TF-IDF with frequent-term dampening inspired by modern
    # topic-representation practice: L1 normalize, then sqrt TF to reduce
    # repeated boilerplate dominance, and weight by inverse class frequency.
    row_sum = np.asarray(counts.sum(axis=1)).ravel()
    row_sum[row_sum == 0] = 1.0
    tf = counts.multiply(1.0 / row_sum[:, None])
    tf.data = np.sqrt(tf.data)
    class_df = np.asarray((counts > 0).sum(axis=0)).ravel()
    idf = np.log((1.0 + len(ids)) / (1.0 + class_df)) + 1.0
    scores = tf.multiply(idf).toarray()

    out: Dict[int, Dict[str, Any]] = {}
    for row, cid in enumerate(ids):
        eligible = np.asarray([
            (str(term) not in blocked) and scores[row, j] > 0
            for j, term in enumerate(terms)
        ], dtype=bool)
        local_scores = scores[row].copy()
        local_scores[~eligible] = 0.0
        chosen = diverse_top_terms(terms, local_scores, top_n)
        keywords = [{"term": str(terms[j]), "weight": float(local_scores[j])} for j in chosen]
        out[cid] = {
            "descriptor": " | ".join(x["term"] for x in keywords[:5]) or f"cluster_{cid}",
            "keywords": keywords,
        }
    return out


def descriptor_term_map(
    descriptions: Dict[int, Dict[str, Any]], top_terms: int
) -> Dict[int, List[str]]:
    out: Dict[int, List[str]] = {}
    for cid, payload in descriptions.items():
        terms: List[str] = []
        for item in payload.get("keywords", [])[:max(2, int(top_terms))]:
            normalized = " ".join(tokenize(str(item.get("term", ""))))
            if normalized and normalized not in terms:
                terms.append(normalized)
        out[int(cid)] = terms
    return out


def _reference_term_matrix(
    reference_texts: Sequence[str], term_maps: Sequence[Dict[int, List[str]]]
) -> Tuple[sparse.csr_matrix, Dict[str, int]]:
    vocabulary_terms = sorted({
        term for mapping in term_maps for terms in mapping.values() for term in terms
    })
    if not vocabulary_terms:
        return sparse.csr_matrix((len(reference_texts), 0), dtype=np.int8), {}
    vocabulary = {term: idx for idx, term in enumerate(vocabulary_terms)}
    vectorizer = CountVectorizer(
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(1, 3),
        binary=True,
        vocabulary=vocabulary,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b",
    )
    matrix = vectorizer.transform(list(reference_texts)).tocsr()
    matrix.data[:] = 1
    return matrix, vocabulary


def _npmi_from_matrix(
    matrix: sparse.csr_matrix,
    vocabulary: Dict[str, int],
    term_map: Dict[int, List[str]],
    row_indices: Optional[np.ndarray] = None,
) -> Tuple[float, Dict[int, float]]:
    view = matrix if row_indices is None else matrix[np.asarray(row_indices, dtype=int)]
    n_docs = int(view.shape[0])
    if n_docs <= 0:
        return float("nan"), {}
    df = np.asarray(view.sum(axis=0)).ravel().astype(float)
    per_cluster: Dict[int, float] = {}
    for cid, terms in term_map.items():
        cols = [vocabulary[t] for t in terms if t in vocabulary]
        cols = list(dict.fromkeys(cols))
        if len(cols) < 2:
            per_cluster[int(cid)] = float("nan")
            continue
        pair_scores: List[float] = []
        for i in range(len(cols)):
            for j in range(i + 1, len(cols)):
                a, b = cols[i], cols[j]
                p_a = df[a] / n_docs
                p_b = df[b] / n_docs
                joint = float(view[:, a].multiply(view[:, b]).sum())
                p_ab = joint / n_docs
                if p_a <= 0 or p_b <= 0:
                    continue
                if p_ab <= 0:
                    pair_scores.append(-1.0)
                    continue
                if p_ab >= 1.0 - 1e-12:
                    # Ubiquitous co-occurrence contains no discriminative information.
                    pair_scores.append(0.0)
                    continue
                denom = -math.log(p_ab)
                if denom <= 1e-12:
                    continue
                pair_scores.append(float(math.log(p_ab / (p_a * p_b)) / denom))
        per_cluster[int(cid)] = float(np.mean(pair_scores)) if pair_scores else float("nan")
    finite = [v for v in per_cluster.values() if np.isfinite(v)]
    return (float(np.mean(finite)) if finite else float("nan")), per_cluster


def descriptor_diversity_metrics(term_map: Dict[int, List[str]]) -> Dict[str, float]:
    phrases = [term for terms in term_map.values() for term in terms]
    phrase_diversity = len(set(phrases)) / len(phrases) if phrases else float("nan")
    tokens = [token for phrase in phrases for token in tokenize(phrase)]
    token_diversity = len(set(tokens)) / len(tokens) if tokens else float("nan")
    cluster_sets = [set(token for phrase in terms for token in tokenize(phrase)) for terms in term_map.values()]
    jaccards: List[float] = []
    for i in range(len(cluster_sets)):
        for j in range(i + 1, len(cluster_sets)):
            union = cluster_sets[i] | cluster_sets[j]
            if union:
                jaccards.append(len(cluster_sets[i] & cluster_sets[j]) / len(union))
    redundancy = float(np.mean(jaccards)) if jaccards else 0.0
    components = [x for x in (phrase_diversity, token_diversity, 1.0 - redundancy) if np.isfinite(x)]
    composite = float(np.median(components)) if components else float("nan")
    return {
        "descriptor_phrase_diversity": float(phrase_diversity),
        "descriptor_token_diversity": float(token_diversity),
        "descriptor_pairwise_jaccard_redundancy": redundancy,
        "descriptor_diversity_composite": composite,
    }


def interpretability_metrics(
    reference_texts: Sequence[str],
    descriptions: Dict[int, Dict[str, Any]],
    top_terms: int = 10,
) -> Tuple[Dict[str, float], Dict[int, float]]:
    """Phrase-aware NPMI and descriptor diversity on a fixed reference corpus."""
    term_map = descriptor_term_map(descriptions, top_terms)
    matrix, vocabulary = _reference_term_matrix(reference_texts, [term_map])
    coherence, per_cluster = _npmi_from_matrix(matrix, vocabulary, term_map)
    metrics = {
        "npmi_coherence": coherence,
        **descriptor_diversity_metrics(term_map),
    }
    return metrics, per_cluster


def semantic_regression_guard(
    reference_texts: Sequence[str],
    baseline_descriptions: Dict[int, Dict[str, Any]],
    candidate_descriptions: Dict[int, Dict[str, Any]],
    config: Config,
) -> Tuple[bool, pd.DataFrame, Dict[str, Any], Dict[int, float], Dict[int, float]]:
    """Separate semantic regression protection from structural safety.

    Baseline and candidate descriptors are scored against the exact same
    privacy-redacted development reference documents.  A paired bootstrap blocks
    only when the confidence interval supports an NPMI regression; SME business
    acceptance remains a separate human decision.
    """
    baseline_terms = descriptor_term_map(baseline_descriptions, config.coherence_top_terms)
    candidate_terms = descriptor_term_map(candidate_descriptions, config.coherence_top_terms)
    matrix, vocabulary = _reference_term_matrix(
        reference_texts, [baseline_terms, candidate_terms]
    )
    baseline_npmi, baseline_per = _npmi_from_matrix(matrix, vocabulary, baseline_terms)
    candidate_npmi, candidate_per = _npmi_from_matrix(matrix, vocabulary, candidate_terms)
    baseline_div = descriptor_diversity_metrics(baseline_terms)
    candidate_div = descriptor_diversity_metrics(candidate_terms)

    repeats = max(0, int(config.semantic_bootstrap_repeats))
    frac = float(min(max(config.semantic_bootstrap_fraction, 0.50), 1.0))
    sample_n = max(10, min(matrix.shape[0], int(round(frac * matrix.shape[0])))) if matrix.shape[0] else 0
    deltas: List[float] = []
    if repeats > 0 and sample_n > 0 and np.isfinite(baseline_npmi) and np.isfinite(candidate_npmi):
        rng = np.random.default_rng(config.seed + 9901)
        for _ in range(repeats):
            idx = rng.choice(matrix.shape[0], size=sample_n, replace=True)
            b, _ = _npmi_from_matrix(matrix, vocabulary, baseline_terms, idx)
            c, _ = _npmi_from_matrix(matrix, vocabulary, candidate_terms, idx)
            if np.isfinite(b) and np.isfinite(c):
                deltas.append(float(c - b))

    alpha = float(min(max(config.semantic_guard_alpha, 0.001), 0.25))
    if deltas:
        lower = float(np.quantile(deltas, alpha / 2.0))
        upper = float(np.quantile(deltas, 1.0 - alpha / 2.0))
        median_delta = float(np.median(deltas))
    else:
        lower = upper = median_delta = float("nan")

    mode = str(config.semantic_guard_mode).lower()
    statistically_supported_regression = bool(np.isfinite(upper) and upper < 0.0)
    if statistically_supported_regression and mode == "block":
        status = "BLOCK"
        deployment_allowed = False
    elif statistically_supported_regression:
        status = "WARN"
        deployment_allowed = True
    elif np.isfinite(lower) and lower > 0.0:
        status = "PASS_IMPROVED"
        deployment_allowed = True
    elif np.isfinite(candidate_npmi) and np.isfinite(baseline_npmi):
        status = "PASS_NO_SIGNIFICANT_REGRESSION"
        deployment_allowed = True
    else:
        status = "WARN_METRIC_UNAVAILABLE"
        deployment_allowed = True

    diversity_regressed = bool(
        np.isfinite(candidate_div["descriptor_diversity_composite"])
        and np.isfinite(baseline_div["descriptor_diversity_composite"])
        and candidate_div["descriptor_diversity_composite"] < baseline_div["descriptor_diversity_composite"]
    )
    audit = pd.DataFrame([
        {
            "check": "npmi_fixed_reference",
            "baseline": baseline_npmi,
            "candidate": candidate_npmi,
            "delta": candidate_npmi - baseline_npmi if np.isfinite(candidate_npmi) and np.isfinite(baseline_npmi) else np.nan,
            "bootstrap_delta_median": median_delta,
            "bootstrap_delta_ci_lower": lower,
            "bootstrap_delta_ci_upper": upper,
            "passed": not statistically_supported_regression or mode != "block",
            "basis": "paired_bootstrap_same_development_reference_corpus",
        },
        {
            "check": "descriptor_diversity_composite",
            "baseline": baseline_div["descriptor_diversity_composite"],
            "candidate": candidate_div["descriptor_diversity_composite"],
            "delta": candidate_div["descriptor_diversity_composite"] - baseline_div["descriptor_diversity_composite"],
            "bootstrap_delta_median": np.nan,
            "bootstrap_delta_ci_lower": np.nan,
            "bootstrap_delta_ci_upper": np.nan,
            "passed": True,
            "basis": "audit_and_sme_signal_not_automatic_veto",
        },
    ])
    summary = {
        "status": status,
        "deployment_allowed": bool(deployment_allowed),
        "guard_mode": mode,
        "baseline_npmi_coherence": baseline_npmi,
        "candidate_npmi_coherence": candidate_npmi,
        "bootstrap_delta_median": median_delta,
        "bootstrap_delta_ci_lower": lower,
        "bootstrap_delta_ci_upper": upper,
        "bootstrap_repeats_valid": len(deltas),
        "alpha": alpha,
        "statistically_supported_regression": statistically_supported_regression,
        "baseline_descriptor_diversity": baseline_div,
        "candidate_descriptor_diversity": candidate_div,
        "descriptor_diversity_regressed": diversity_regressed,
        "scope": "semantic_regression_protection_only",
        "business_semantic_acceptance": "PENDING_SME_REVIEW",
    }
    return deployment_allowed, audit, summary, baseline_per, candidate_per


def representative_examples(
    texts: Sequence[str], vectors: np.ndarray, labels: np.ndarray, per_cluster: int
) -> Dict[int, List[str]]:
    out: Dict[int, List[str]] = {}
    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cid)
        if len(idx) == 0:
            continue
        centroid = vectors[idx].mean(axis=0)
        norm = np.linalg.norm(centroid)
        if norm > 0:
            centroid /= norm
        sims = vectors[idx] @ centroid
        order = idx[np.argsort(sims)[::-1][:per_cluster]]
        out[cid] = [redact_pii(str(texts[i])) for i in order.tolist()]
    return out


def cluster_catalog(
    texts: Sequence[str],
    vectors: np.ndarray,
    labels: np.ndarray,
    strengths: np.ndarray,
    descriptions: Dict[int, Dict[str, Any]],
    model: ClusterModel,
    per_cluster: int,
    refinement_rules: Optional[Sequence[RefinementRule]] = None,
    merge_map: Optional[Dict[int, int]] = None,
    per_cluster_npmi: Optional[Dict[int, float]] = None,
    assignment_source: Optional[np.ndarray] = None,
) -> pd.DataFrame:
    reps = representative_examples(texts, vectors, labels, per_cluster)
    cohesion = local_cluster_cohesion(vectors, labels)
    sources = (
        np.asarray(assignment_source, dtype=object)
        if assignment_source is not None
        else np.asarray(["native" if int(x) != -1 else "outlier" for x in labels], dtype=object)
    )
    rows: List[Dict[str, Any]] = []
    n_nonoutlier = max(int((labels != -1).sum()), 1)

    child_ids = {
        int(child)
        for rule in (refinement_rules or [])
        for child in rule.child_id_map.values()
    }
    merge_targets = set(int(v) for v in (merge_map or {}).values())
    persistence_map: Dict[int, float] = {}
    if model.method == "umap_hdbscan_search":
        try:
            p = np.asarray(model.clusterer.cluster_persistence_, dtype=float)
            persistence_map = {i: float(v) for i, v in enumerate(p.tolist())}
        except Exception:
            pass

    for cid in sorted(set(int(x) for x in labels.tolist() if int(x) != -1)):
        idx = np.flatnonzero(labels == cid)
        if cid in merge_targets:
            provenance = "merged_final_cluster"
        elif cid in child_ids:
            provenance = "recursive_child"
        else:
            provenance = "base_cluster"
        persistence = persistence_map.get(cid, np.nan) if provenance == "base_cluster" else np.nan
        native_idx = idx[sources[idx] != "recovered_outlier"]
        recovered_count = int(np.sum(sources[idx] == "recovered_outlier"))
        rows.append({
            "cluster_id": cid,
            "cluster_provenance": provenance,
            "count": len(idx),
            "recovered_outlier_count": recovered_count,
            "share_of_nonoutliers_pct": 100.0 * len(idx) / n_nonoutlier,
            "mean_native_membership_strength": float(np.mean(strengths[native_idx])) if len(native_idx) else np.nan,
            "cohesion_mean_cosine_to_centroid": cohesion.get(cid, np.nan),
            "hdbscan_cluster_persistence": persistence,
            "npmi_coherence": (per_cluster_npmi or {}).get(cid, np.nan),
            "global_stability_ari": model.global_stability_ari,
            "assigned_stability_ari": model.assigned_stability_ari,
            "outlier_jaccard": model.outlier_jaccard,
            "descriptor": descriptions.get(cid, {}).get("descriptor", f"cluster_{cid}"),
            "top_terms": "; ".join(x["term"] for x in descriptions.get(cid, {}).get("keywords", [])[:12]),
            "representative_examples": " || ".join(reps.get(cid, [])),
        })
    if not rows:
        return pd.DataFrame()
    return pd.DataFrame(rows).sort_values("count", ascending=False).reset_index(drop=True)


def metric_with_model(metrics: Dict[str, float], model: ClusterModel) -> Dict[str, float]:
    out = dict(metrics)
    if not np.isfinite(float(out.get("density_validity", np.nan))) and model.density_validity is not None:
        out["density_validity"] = float(model.density_validity)
    if not np.isfinite(float(out.get("weighted_persistence", np.nan))) and model.weighted_persistence is not None:
        out["weighted_persistence"] = float(model.weighted_persistence)
    out["global_stability_ari"] = float(model.global_stability_ari) if model.global_stability_ari is not None else float("nan")
    out["assigned_stability_ari"] = float(model.assigned_stability_ari) if model.assigned_stability_ari is not None else float("nan")
    out["outlier_jaccard"] = float(model.outlier_jaccard) if model.outlier_jaccard is not None else float("nan")
    return out


def final_partition_metrics(
    vectors: np.ndarray,
    labels: np.ndarray,
    strengths: np.ndarray,
    seed: int,
    assignment_source: Optional[np.ndarray] = None,
) -> Dict[str, float]:
    labels = np.asarray(labels, dtype=int)
    strengths = np.asarray(strengths, dtype=float)
    sources = (
        np.asarray(assignment_source, dtype=object)
        if assignment_source is not None
        else np.asarray(["native" if int(x) != -1 else "outlier" for x in labels], dtype=object)
    )
    metrics = evaluate_cluster_candidate(vectors, labels, seed)
    cohesion = local_cluster_cohesion(vectors, labels)
    sizes = {cid: int((labels == cid).sum()) for cid in cohesion}
    assigned = labels != -1
    native_assigned = assigned & (sources != "recovered_outlier")
    recovered = sources == "recovered_outlier"
    if sizes:
        weighted_cohesion = sum(cohesion[cid] * sizes[cid] for cid in sizes) / max(sum(sizes.values()), 1)
        median_cohesion = float(np.median(list(cohesion.values())))
    else:
        weighted_cohesion = float("nan")
        median_cohesion = float("nan")

    ids = sorted(sizes)
    separation = float("nan")
    if len(ids) >= 2:
        centroids = []
        for cid in ids:
            centroid = vectors[labels == cid].mean(axis=0)
            norm = float(np.linalg.norm(centroid))
            centroids.append(centroid / norm if norm > 0 else centroid)
        matrix = np.vstack(centroids)
        sims = matrix @ matrix.T
        np.fill_diagonal(sims, -np.inf)
        nearest = np.max(sims, axis=1)
        separation = float(np.mean(1.0 - nearest))

    metrics.update({
        "assigned_fraction": float(np.mean(assigned)) if len(labels) else 0.0,
        "recovered_outlier_fraction": float(np.mean(recovered)) if len(labels) else 0.0,
        "mean_cluster_cohesion": float(weighted_cohesion),
        "median_cluster_cohesion": float(median_cohesion),
        "centroid_separation": separation,
        "mean_native_assigned_strength": (
            float(np.mean(strengths[native_assigned])) if native_assigned.any() else float("nan")
        ),
        # Backward-compatible key; now explicitly means native model strength.
        "mean_assigned_strength": (
            float(np.mean(strengths[native_assigned])) if native_assigned.any() else float("nan")
        ),
    })
    return metrics


def structural_safety_gate(
    baseline: Dict[str, float],
    candidate: Dict[str, float],
    candidate_search: pd.DataFrame,
    model: ClusterModel,
) -> Tuple[bool, pd.DataFrame, Dict[str, Any]]:
    """Safety gate for structural pathologies only; semantic acceptance stays human.

    Boundaries are inferred from the development model-search distribution via
    robust fences.  The gate does not nominate a single primary metric and does
    not impose a fixed outlier-rate multiple.  Passing means "not structurally
    pathological", not "business-correct".
    """
    rows: List[Dict[str, Any]] = []
    conditions: List[Tuple[str, bool, Any, Any, str]] = []

    n_clusters = float(candidate.get("n_clusters", 0.0))
    largest = float(candidate.get("largest_cluster_share", 1.0))
    assigned_fraction = float(candidate.get("assigned_fraction", 0.0))
    conditions.extend([
        ("at_least_two_non_noise_clusters", n_clusters >= 2.0, n_clusters, 2.0, "hard_invariant"),
        ("not_single_cluster_collapse", largest < 1.0, largest, 1.0, "hard_invariant"),
        ("some_records_assigned", assigned_fraction > 0.0, assigned_fraction, 0.0, "hard_invariant"),
    ])

    # Data-derived fences from candidate model search.  These are used only when
    # enough finite observations exist; otherwise the condition is informational.
    fence_specs = {
        "silhouette": ("lower", candidate.get("silhouette", np.nan)),
        "balance_entropy": ("lower", candidate.get("balance_entropy", np.nan)),
        "largest_cluster_share": ("upper", candidate.get("largest_cluster_share", np.nan)),
        "noise_rate": ("upper", candidate.get("noise_rate", np.nan)),
    }
    for metric, (side, observed) in fence_specs.items():
        values = pd.to_numeric(candidate_search.get(metric, pd.Series(dtype=float)), errors="coerce").dropna().to_numpy(float)
        if len(values) < 4 or not np.isfinite(float(observed)):
            rows.append({
                "condition": f"search_fence_{metric}", "passed": True,
                "observed": observed, "boundary": np.nan,
                "basis": "informational_insufficient_search_distribution",
            })
            continue
        boundary = robust_lower_fence(values) if side == "lower" else robust_upper_fence(values)
        ok = float(observed) >= boundary if side == "lower" else float(observed) <= boundary
        conditions.append((f"search_fence_{metric}", bool(ok), float(observed), float(boundary), f"development_search_{side}_fence"))

    stability_values = pd.to_numeric(
        candidate_search.get("assigned_ari", pd.Series(dtype=float)), errors="coerce"
    ).dropna().to_numpy(float)
    observed_stability = model.assigned_stability_ari
    if observed_stability is not None and np.isfinite(observed_stability) and len(stability_values) >= 4:
        boundary = robust_lower_fence(stability_values)
        conditions.append((
            "deployed_assigned_stability_within_search_distribution",
            float(observed_stability) >= boundary,
            float(observed_stability), float(boundary), "development_search_lower_fence",
        ))

    for name, ok, observed, boundary, basis in conditions:
        rows.append({
            "condition": name,
            "passed": bool(ok),
            "observed": observed,
            "boundary": boundary,
            "basis": basis,
        })

    failed = [row["condition"] for row in rows if not bool(row["passed"])]
    passed = len(failed) == 0
    # Baseline deltas are audit-only and never become a hidden semantic gate.
    for metric in (
        "silhouette", "balance_entropy", "largest_cluster_share", "noise_rate",
        "mean_cluster_cohesion", "centroid_separation",
    ):
        b = float(baseline.get(metric, np.nan))
        c = float(candidate.get(metric, np.nan))
        if np.isfinite(b) and np.isfinite(c):
            rows.append({
                "condition": f"baseline_delta_{metric}",
                "passed": True,
                "observed": c - b,
                "boundary": np.nan,
                "basis": "audit_only_not_a_deployment_veto",
            })

    summary = {
        "passed": passed,
        "failed_conditions": failed,
        "gate_scope": "structural_safety_only",
        "semantic_acceptance": "pending_sme_review",
        "rule": (
            "hard anti-collapse invariants plus data-derived development-search fences; "
            "no single intrinsic metric, fixed silhouette veto, or fixed noise-rate multiple"
        ),
    }
    return passed, pd.DataFrame(rows), summary


def multi_metric_quality_gate(
    baseline: Dict[str, float],
    candidate: Dict[str, float],
    baseline_search: pd.DataFrame,
    candidate_search: pd.DataFrame,
) -> Tuple[bool, pd.DataFrame, Dict[str, Any]]:
    """Backward-compatible wrapper; v2.4 uses structural_safety_gate directly."""
    dummy = ClusterModel(
        method="compatibility_wrapper", reducer=None, clusterer=None, parameters={},
        global_stability_ari=None, assigned_stability_ari=None, outlier_jaccard=None,
        silhouette=None, density_validity=None, weighted_persistence=None, selection_score=None,
    )
    return structural_safety_gate(baseline, candidate, candidate_search, dummy)

def cluster_similarity_matrix(
    vectors: np.ndarray, labels: np.ndarray, max_clusters: int = 50
) -> pd.DataFrame:
    valid = np.asarray(labels, dtype=int)
    ids = [cid for cid, _ in Counter(valid[valid != -1].tolist()).most_common(max_clusters)]
    if len(ids) < 2:
        return pd.DataFrame()
    centroids: List[np.ndarray] = []
    for cid in ids:
        centroid = np.asarray(vectors[valid == cid].mean(axis=0), dtype=float)
        norm = float(np.linalg.norm(centroid))
        centroids.append(centroid / norm if norm > 0 else centroid)
    matrix = np.clip(np.vstack(centroids) @ np.vstack(centroids).T, -1.0, 1.0)
    return pd.DataFrame(matrix, index=ids, columns=ids)


def save_cluster_similarity_heatmap(
    similarity: pd.DataFrame, title: str, path: Path, max_display: int = 25
) -> None:
    if similarity is None or similarity.empty:
        return
    view = similarity.iloc[:max_display, :max_display]
    fig_size = max(8.0, min(16.0, 0.48 * len(view) + 4.0))
    plt.figure(figsize=(fig_size, fig_size))
    image = plt.imshow(view.values, aspect="auto", vmin=-1.0, vmax=1.0)
    plt.colorbar(image, label="Centroid cosine similarity")
    positions = np.arange(len(view))
    plt.xticks(positions, [str(x) for x in view.columns], rotation=90)
    plt.yticks(positions, [str(x) for x in view.index])
    plt.title(title)
    plt.xlabel("Cluster ID")
    plt.ylabel("Cluster ID")
    plt.tight_layout()
    plt.savefig(path, dpi=160)
    plt.close()


