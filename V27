def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def configure_logging() -> None:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s | %(levelname)s | %(message)s",
        datefmt="%H:%M:%S",
    )


def normalise_key(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "_", str(value).strip().lower()).strip("_")


def to_plain(value: Any) -> Any:
    if value is None:
        return None
    if isinstance(value, dict):
        return {str(k): to_plain(v) for k, v in value.items()}
    if isinstance(value, (list, tuple, set)):
        return [to_plain(v) for v in value]
    if isinstance(value, np.ndarray):
        return [to_plain(v) for v in value.tolist()]
    if isinstance(value, np.integer):
        return int(value)
    if isinstance(value, np.floating):
        return None if np.isnan(value) else float(value)
    try:
        if pd.isna(value):
            return None
    except Exception:
        pass
    return value


def robust_upper_fence(values: Sequence[float], multiplier: float = 1.5) -> float:
    arr = np.asarray([x for x in values if np.isfinite(x)], dtype=float)
    if arr.size == 0:
        return float("inf")
    q1, q3 = np.quantile(arr, [0.25, 0.75])
    return float(q3 + multiplier * (q3 - q1))


def robust_lower_fence(values: Sequence[float], multiplier: float = 1.5) -> float:
    arr = np.asarray([x for x in values if np.isfinite(x)], dtype=float)
    if arr.size == 0:
        return float("-inf")
    q1, q3 = np.quantile(arr, [0.25, 0.75])
    return float(q1 - multiplier * (q3 - q1))


def robust_mad(values: Sequence[float]) -> float:
    arr = np.asarray([x for x in values if np.isfinite(x)], dtype=float)
    if arr.size == 0:
        return 1.0
    med = float(np.median(arr))
    mad = float(np.median(np.abs(arr - med)))
    return max(1.4826 * mad, 1e-9)



def distribution_upper_tail_cutoff(values: Sequence[float], seed: int) -> Tuple[float, str]:
    """Infer a high-tail boundary without forcing a fixed top-percentile rule.

    A two-component Gaussian mixture is used only when BIC supports it over a
    one-component model. Otherwise a robust Tukey/MAD tail boundary is used;
    if no observed value exceeds that boundary, nothing is force-selected.
    """
    arr = np.asarray([x for x in values if np.isfinite(x)], dtype=float)
    if arr.size == 0:
        return float("inf"), "empty"
    if arr.size < 20 or float(np.std(arr)) < 1e-8:
        fence = robust_upper_fence(arr)
        return float(fence), "robust_upper_fence"

    x = arr.reshape(-1, 1)
    g1 = GaussianMixture(n_components=1, random_state=seed, covariance_type="full").fit(x)
    g2 = GaussianMixture(n_components=2, random_state=seed, covariance_type="full").fit(x)
    if g2.bic(x) < g1.bic(x):
        means = g2.means_.ravel()
        high = int(np.argmax(means))
        low = 1 - high
        grid = np.linspace(float(arr.min()), float(arr.max()), 4096).reshape(-1, 1)
        probs = g2.predict_proba(grid)
        diff = probs[:, high] - probs[:, low]
        crossings = np.flatnonzero(np.signbit(diff[:-1]) != np.signbit(diff[1:]))
        if len(crossings):
            cutoff = float(grid[int(crossings[-1]) + 1, 0])
        else:
            cutoff = float((means[high] + means[low]) / 2.0)
        return cutoff, "gmm_bic_two_component"

    fence = robust_upper_fence(arr)
    if np.isfinite(fence):
        return float(fence), "robust_upper_fence"
    med = float(np.median(arr))
    return med + 3.0 * robust_mad(arr), "median_plus_3mad"


def distribution_lower_tail_cutoff(values: Sequence[float], seed: int) -> Tuple[float, str]:
    """Mirror of distribution_upper_tail_cutoff for unusually low observations."""
    arr = np.asarray([x for x in values if np.isfinite(x)], dtype=float)
    if arr.size == 0:
        return float("-inf"), "empty"
    upper, method = distribution_upper_tail_cutoff((-arr).tolist(), seed)
    if not np.isfinite(upper):
        return float("-inf"), method
    return float(-upper), method.replace("upper", "lower")


def cluster_distribution(labels: np.ndarray) -> Dict[int, float]:
    if len(labels) == 0:
        return {}
    counts = Counter(int(x) for x in labels.tolist())
    total = float(len(labels))
    return {int(k): float(v / total) for k, v in sorted(counts.items())}


def strength_quantiles(strengths: np.ndarray) -> Dict[str, float]:
    arr = np.asarray(strengths, dtype=float)
    arr = arr[np.isfinite(arr)]
    if arr.size == 0:
        return {}
    return {
        "p10": float(np.quantile(arr, 0.10)),
        "p50": float(np.quantile(arr, 0.50)),
        "p90": float(np.quantile(arr, 0.90)),
    }


def cluster_js_distance(reference: Dict[int, float], observed: Dict[int, float]) -> float:
    keys = sorted(set(reference) | set(observed))
    if not keys:
        return 0.0
    p = np.asarray([reference.get(k, 0.0) for k in keys], dtype=float)
    q = np.asarray([observed.get(k, 0.0) for k in keys], dtype=float)
    if p.sum() <= 0 or q.sum() <= 0:
        return 1.0
    p /= p.sum()
    q /= q.sum()
    return float(jensenshannon(p, q, base=2.0))


def percentile_rank(series: pd.Series, higher_is_better: bool = True) -> pd.Series:
    values = pd.to_numeric(series, errors="coerce")
    if values.notna().sum() <= 1:
        return pd.Series(np.full(len(series), 0.5), index=series.index)
    return values.rank(pct=True, ascending=higher_is_better).fillna(0.0)


def tokenize(text: str) -> List[str]:
    return [m.group(0).lower() for m in TOKEN_RE.finditer(str(text))]


def redact_pii(text: str) -> str:
    value = str(text or "")
    for _, pattern in PII_PATTERNS:
        value = pattern.sub(" [redacted] ", value)
    return re.sub(r"\s+", " ", value).strip()


def deterministic_sample(frame: pd.DataFrame, n: int, seed: int) -> pd.DataFrame:
    if n <= 0 or len(frame) <= n:
        return frame.copy()
    return frame.sample(n=n, random_state=seed).sort_index().copy()


def pseudonymize(value: Any, key: bytes) -> str:
    raw = str(value or "").encode("utf-8", errors="ignore")
    return hashlib.blake2b(raw, key=key, digest_size=12).hexdigest()



def resolve_pseudonym_key(config: Config) -> Tuple[bytes, str]:
    """Use a deployment-provided secret when available; otherwise use an ephemeral run key."""
    raw = os.environ.get(config.pseudonym_key_env, "") if config.pseudonym_key_env else ""
    if raw:
        return hashlib.sha256(raw.encode("utf-8")).digest(), f"environment:{config.pseudonym_key_env}"
    return secrets.token_bytes(32), "ephemeral_per_run"


def sanitize_frame_for_export(frame: pd.DataFrame) -> pd.DataFrame:
    out = frame.copy()
    for col in out.select_dtypes(include=["object"]).columns:
        out[col] = out[col].map(lambda x: redact_pii(str(x)) if x is not None else x)
    return out


def package_versions() -> Dict[str, str]:
    result = {
        "python": platform.python_version(),
        "numpy": np.__version__,
        "pandas": pd.__version__,
    }
    try:
        import sklearn
        result["scikit_learn"] = sklearn.__version__
    except Exception:
