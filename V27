def term_cluster_entropy(matrix: sparse.csr_matrix, labels: np.ndarray) -> np.ndarray:
    valid_clusters = sorted(set(int(x) for x in labels.tolist() if int(x) != -1))
    if len(valid_clusters) < 2:
        return np.ones(matrix.shape[1], dtype=float)
    counts = np.zeros((len(valid_clusters), matrix.shape[1]), dtype=np.float64)
    for row_idx, cluster_id in enumerate(valid_clusters):
        row_mask = labels == cluster_id
        if row_mask.any():
            counts[row_idx] = np.asarray((matrix[row_mask] > 0).sum(axis=0)).ravel()
    total = counts.sum(axis=0)
    total[total == 0] = 1.0
    p = counts / total[None, :]
    entropy = -np.sum(np.where(p > 0, p * np.log(p + 1e-12), 0.0), axis=0)
    return entropy / max(math.log(len(valid_clusters)), 1e-12)


def build_noise_label_ensemble(
    vectors: np.ndarray,
    baseline_model: ClusterModel,
    baseline_labels: np.ndarray,
    config: Config,
) -> Tuple[List[np.ndarray], pd.DataFrame]:
    """Create several plausible development-only clusterings for noise consensus.

    Noise should not be declared generic because of one provisional partition.
    Alternative partitions are refit from deterministic development subsamples
    and projected back to the full development representation.  Locked-test
    rows never enter this procedure.
    """
    labelings: List[np.ndarray] = [np.asarray(baseline_labels, dtype=int)]
    audit: List[Dict[str, Any]] = [{
        "consensus_run": 0,
        "method": "baseline_partition",
        "rows_fit": int(len(vectors)),
        "n_clusters": int(len(set(int(x) for x in baseline_labels.tolist() if int(x) != -1))),
        "noise_rate": float(np.mean(np.asarray(baseline_labels) == -1)),
        "accepted": True,
    }]
    target = max(1, int(config.noise_consensus_models))
    if target <= 1 or len(vectors) < 8:
        return labelings, pd.DataFrame(audit)

    sample_cap = config.search_sample_rows if config.search_sample_rows > 0 else len(vectors)
    sample_n = min(len(vectors), max(8, int(sample_cap)))
    for run in range(1, target):
        rng = np.random.default_rng(config.seed + 16127 * run)
        idx = np.arange(len(vectors), dtype=int) if sample_n == len(vectors) else np.sort(
            rng.choice(len(vectors), size=sample_n, replace=False)
        )
        try:
            if baseline_model.method == "umap_hdbscan_search":
                params = {
                    k: baseline_model.parameters[k]
                    for k in (
                        "n_neighbors", "n_components", "min_dist",
                        "min_cluster_size", "min_samples", "cluster_selection_method",
                    )
                    if k in baseline_model.parameters
                }
                if sample_n < len(vectors):
                    ratio = sample_n / len(vectors)
                    params["min_cluster_size"] = max(
                        5, min(sample_n // 3, int(round(int(params["min_cluster_size"]) * ratio)))
                    )
                    params["min_samples"] = max(
                        2, min(int(params["min_cluster_size"]), int(round(int(params["min_samples"]) * ratio)))
                    )
                    params["n_neighbors"] = min(int(params["n_neighbors"]), sample_n - 1)
                reducer, clusterer, _, _, _ = fit_umap_hdbscan_once(
                    vectors[idx], params, config.seed + 3571 * run
                )
                from hdbscan.prediction import approximate_predict
                reduced_all = reducer.transform(vectors)
                labels, _ = approximate_predict(clusterer, reduced_all)
                labels = labels.astype(int)
                method = "subsample_refit_umap_hdbscan"
            elif baseline_model.method == "minibatch_kmeans":
                k = int(baseline_model.parameters.get("k", 2))
                model = MiniBatchKMeans(
                    n_clusters=k,
                    random_state=config.seed + 3571 * run,
                    batch_size=min(4096, max(256, sample_n)),
                    n_init="auto",
                )
                raw_sample = model.fit_predict(vectors[idx]).astype(int)
                thresholds = kmeans_distance_thresholds(model, vectors[idx], raw_sample)
                raw_all = model.predict(vectors).astype(int)
                labels, _ = apply_kmeans_outlier_gate(model, vectors, raw_all, thresholds)
                method = "subsample_refit_kmeans"
            else:
                continue
            n_clusters = len(set(int(x) for x in labels.tolist() if int(x) != -1))
            accepted = n_clusters >= 2
            audit.append({
                "consensus_run": run,
                "method": method,
                "rows_fit": int(sample_n),
                "n_clusters": int(n_clusters),
                "noise_rate": float(np.mean(labels == -1)),
                "accepted": bool(accepted),
            })
            if accepted:
                labelings.append(np.asarray(labels, dtype=int))
        except Exception as exc:
            audit.append({
                "consensus_run": run,
                "method": baseline_model.method,
                "rows_fit": int(sample_n),
                "n_clusters": 0,
                "noise_rate": np.nan,
                "accepted": False,
                "reason": str(exc),
            })
    return labelings, pd.DataFrame(audit)


def learn_noise_model(
    texts: Sequence[str], provisional_labelings: Sequence[np.ndarray] | np.ndarray, config: Config
) -> Tuple[NoiseModel, pd.DataFrame]:
    """Learn generic corpus noise while protecting discriminative phrases.

    Generic terms are frequent and evenly dispersed across plausible semantic
    partitions. Protected phrases have enough support but are concentrated in
    particular partitions. Both decisions are development-data driven.
    """
    min_df = adaptive_min_df(len(texts))
    vectorizer = CountVectorizer(
        lowercase=True,
        strip_accents="unicode",
        ngram_range=(1, config.noise_max_ngram),
        min_df=min_df,
        max_df=1.0,
        max_features=config.candidate_noise_features,
        binary=True,
        token_pattern=r"(?u)\b[a-zA-Z][a-zA-Z0-9'\-]{1,}\b",
        stop_words=None,
    )
    matrix = vectorizer.fit_transform(list(texts)).tocsr()
    terms = np.asarray(vectorizer.get_feature_names_out())
    df = np.asarray(matrix.sum(axis=0)).ravel().astype(float)
    df_ratio = df / max(len(texts), 1)

    if isinstance(provisional_labelings, np.ndarray):
        labelings = [provisional_labelings]
    else:
        labelings = [np.asarray(x, dtype=int) for x in provisional_labelings]
    valid_labelings = [
        labels for labels in labelings
        if len(labels) == len(texts)
        and len(set(int(x) for x in labels.tolist() if int(x) != -1)) >= 2
    ]
    if not valid_labelings:
        valid_labelings = [np.asarray(labelings[0], dtype=int)]

    entropy_stack = np.vstack([term_cluster_entropy(matrix, labels) for labels in valid_labelings])
    entropy = np.median(entropy_stack, axis=0)
    specificity = 1.0 - np.clip(entropy, 0.0, 1.0)

    freq_rank = pd.Series(df_ratio).rank(pct=True).to_numpy(dtype=float)
    noise_score = np.sqrt(np.clip(freq_rank, 0.0, 1.0) * np.clip(entropy, 0.0, 1.0))
    threshold, threshold_method = distribution_upper_tail_cutoff(noise_score, config.seed)
    selected_full = noise_score >= threshold if np.isfinite(threshold) else np.zeros_like(noise_score, dtype=bool)

    selection_count = np.zeros(len(terms), dtype=float)
    valid_evaluations = 0
    repeats = max(0, int(config.noise_stability_repeats))
    frac = float(min(max(config.noise_subsample_fraction, 0.60), 1.0))
    sample_n = max(20, min(len(texts), int(round(frac * len(texts)))))
    if repeats >= 1 and len(texts) >= 30:
        for li, labels in enumerate(valid_labelings):
            for r in range(repeats):
                rng = np.random.default_rng(config.seed + 1009 * (r + 1) + 65537 * li)
                idx = np.arange(len(texts), dtype=int) if sample_n == len(texts) else np.sort(
                    rng.choice(len(texts), size=sample_n, replace=False)
                )
                sub_labels = labels[idx]
                if len(set(int(x) for x in sub_labels.tolist() if int(x) != -1)) < 2:
                    continue
                sub = matrix[idx]
                sub_df = np.asarray(sub.sum(axis=0)).ravel().astype(float)
                sub_ratio = sub_df / max(len(idx), 1)
                sub_entropy = term_cluster_entropy(sub, sub_labels)
                sub_rank = pd.Series(sub_ratio).rank(pct=True).to_numpy(dtype=float)
                sub_score = np.sqrt(np.clip(sub_rank, 0.0, 1.0) * np.clip(sub_entropy, 0.0, 1.0))
                sub_threshold, _ = distribution_upper_tail_cutoff(
                    sub_score, config.seed + 1009 * (r + 1) + 65537 * li
                )
                if np.isfinite(sub_threshold):
                    selection_count += (sub_score >= sub_threshold).astype(float)
                    valid_evaluations += 1

    if valid_evaluations:
        stability_rate = selection_count / valid_evaluations
        majority_rate = math.ceil(valid_evaluations / 2) / valid_evaluations
        selected = selected_full & (stability_rate >= majority_rate)
        selection_method = f"{threshold_method}+multi_clustering_bootstrap_majority_consensus"
    else:
        stability_rate = selected_full.astype(float)
        majority_rate = 1.0
        selected = selected_full
        selection_method = threshold_method

    orders = np.asarray([str(t).count(" ") + 1 for t in terms], dtype=int)

    # Phase 2.6: phrase protection is learned from support + cluster specificity.
    support_rank = pd.Series(df_ratio).rank(pct=True).to_numpy(dtype=float)
    discriminative_score = np.sqrt(
        np.clip(support_rank, 0.0, 1.0) * np.clip(specificity, 0.0, 1.0)
    )
    phrase_mask = orders > 1
    protected = np.zeros(len(terms), dtype=bool)
    protection_threshold = float("inf")
    protection_method = "disabled"
    if config.phrase_protection and phrase_mask.any():
        phrase_scores = discriminative_score[phrase_mask]
        protection_threshold, protection_method = distribution_upper_tail_cutoff(
            phrase_scores.tolist(), config.seed + 31337
        )
        if np.isfinite(protection_threshold):
            protected = phrase_mask & (discriminative_score >= protection_threshold)
            if int(protected.sum()) > int(config.phrase_protection_top_terms):
                protected_idx = np.flatnonzero(protected)
                ranked = protected_idx[np.argsort(discriminative_score[protected_idx])[::-1]]
                keep_idx = set(ranked[: int(config.phrase_protection_top_terms)].tolist())
                protected = np.asarray([i in keep_idx for i in range(len(terms))], dtype=bool)

    protected_phrases = set(terms[protected].astype(str).tolist())
    selected_unigrams = set(terms[selected & (orders == 1)].astype(str).tolist())
    selected_phrases = set(terms[selected & (orders > 1)].astype(str).tolist()) - protected_phrases
    safe_templates = {
        phrase for phrase in selected_phrases
        if all(token in selected_unigrams for token in phrase.split())
    }
    descriptor_blocklist = set(terms[selected].astype(str).tolist()) - protected_phrases

    suppression_scope: List[str] = []
    for term, order, is_selected, is_protected in zip(
        terms.tolist(), orders.tolist(), selected.tolist(), protected.tolist()
    ):
        if is_protected:
            suppression_scope.append("protected_phrase")
        elif not is_selected:
            suppression_scope.append("none")
        elif order == 1:
            suppression_scope.append("model_and_descriptor")
        elif str(term) in safe_templates:
            suppression_scope.append("model_and_descriptor")
        else:
            suppression_scope.append("descriptor_only")

    table = pd.DataFrame({
        "term": terms,
        "ngram_order": orders,
        "development_document_frequency": df.astype(int),
        "document_frequency_ratio": df_ratio,
        "median_cluster_entropy": entropy,
        "cluster_specificity": specificity,
        "consensus_clusterings": len(valid_labelings),
        "frequency_percentile": freq_rank,
        "noise_score": noise_score,
        "noise_threshold": threshold,
        "noise_threshold_method": threshold_method,
        "discriminative_phrase_score": discriminative_score,
        "phrase_protection_threshold": protection_threshold,
        "phrase_protection_method": protection_method,
        "protected_phrase": protected,
        "consensus_evaluations": valid_evaluations,
        "consensus_selection_rate": stability_rate,
        "consensus_majority_rate": majority_rate,
        "selected_as_noise": selected,
        "suppression_scope": suppression_scope,
    }).sort_values(
        ["protected_phrase", "selected_as_noise", "discriminative_phrase_score", "noise_score"],
        ascending=[False, False, False, False],
    ).reset_index(drop=True)

    model = NoiseModel(
        unigrams=selected_unigrams,
        template_phrases=safe_templates,
        descriptor_blocklist=descriptor_blocklist,
        score_threshold=float(threshold),
        protected_phrases=protected_phrases,
        selection_method=selection_method,
    )
    return model, table


def apply_noise_model(text: str, model: NoiseModel) -> str:
    tokens = tokenize(text)
    if not tokens:
        return ""

    # Mark protected multi-word spans first. Globally frequent words remain
    # available when the corpus shows they participate in a discriminative phrase.
    keep = np.zeros(len(tokens), dtype=bool)
    protected = set(model.protected_phrases)
    max_protected = max([len(x.split()) for x in protected], default=1)
    for n in range(max_protected, 1, -1):
        if len(tokens) < n:
            continue
        for i in range(0, len(tokens) - n + 1):
            phrase = " ".join(tokens[i:i+n])
            if phrase in protected:
                keep[i:i+n] = True

    drop = np.zeros(len(tokens), dtype=bool)
    templates = model.template_phrases
    max_ngram = max([len(x.split()) for x in templates], default=1)
    for n in range(max_ngram, 1, -1):
        if len(tokens) < n:
            continue
        for i in range(0, len(tokens) - n + 1):
            if drop[i:i+n].any() or keep[i:i+n].any():
                continue
            phrase = " ".join(tokens[i:i+n])
            if phrase in templates:
                drop[i:i+n] = True
    for i, token in enumerate(tokens):
        if keep[i]:
            continue
        if not drop[i] and (token == "redacted" or token in model.unigrams):
            drop[i] = True
    kept = [token for token, flag in zip(tokens, drop.tolist()) if not flag]
    if len(kept) < 2:
        return " ".join(tokens)
    return " ".join(kept)



def select_noise_policy(
    texts: Sequence[str], noise_model: NoiseModel, config: Config
) -> Tuple[str, pd.DataFrame]:
    """Choose the noise-application policy using development data only.

    The policy question (clean both channels vs suppress only word features vs
    leave features raw) is treated as a model-selection problem rather than a
    hard-coded belief.  Search is bounded to a deterministic development sample
    and uses rank aggregation across structural and interpretability metrics.
    """
    requested = str(config.noise_policy).lower()
    allowed = ("shared_clean", "word_only", "raw")
    if requested != "auto":
        if requested not in allowed:
            raise ValueError(f"Unsupported noise policy: {requested}")
        return requested, pd.DataFrame([{
            "policy": requested,
            "selected": True,
            "selection_reason": "explicit_configuration",
        }])

    values = list(texts)
    if len(values) < 30:
        return "shared_clean", pd.DataFrame([{
            "policy": "shared_clean",
            "selected": True,
            "selection_reason": "insufficient_rows_for_ablation",
        }])

    if config.noise_policy_sample_rows > 0 and len(values) > config.noise_policy_sample_rows:
        rng = np.random.default_rng(config.seed + 2713)
        idx = np.sort(rng.choice(len(values), size=config.noise_policy_sample_rows, replace=False))
        sample_raw = [values[i] for i in idx.tolist()]
    else:
        sample_raw = values

    local_cfg = Config(**{
        **asdict(config),
        "model_search_trials": max(4, min(config.model_search_trials, config.noise_policy_search_trials)),
        "search_sample_rows": min(len(sample_raw), config.search_sample_rows),
        "max_cluster_fit_rows": min(len(sample_raw), config.max_cluster_fit_rows),
        "recursive_max_depth": 0,
    })

    rows: List[Dict[str, Any]] = []
    for policy in allowed:
        try:
            model_text = prepare_model_texts(sample_raw, noise_model, policy)
            latent, vectors = fit_latent(
                model_text,
                local_cfg,
                noise_model=noise_model if policy == "word_only" else None,
                noise_policy=policy,
            )
            model, labels, strengths, _ = fit_cluster_search(
                vectors, local_cfg, seed=config.seed + 101 * (allowed.index(policy) + 1)
            )
            descriptions = ctfidf_descriptions(
                sample_raw,
                labels,
                blocked_terms=noise_model.descriptor_blocklist,
            )
            metrics = final_partition_metrics(vectors, labels, strengths, config.seed)
            interp, _ = interpretability_metrics(
                sample_raw, descriptions, config.coherence_top_terms
            )
            rows.append({
                "policy": policy,
                "status": "ok",
                **metrics,
                **interp,
                "cluster_method": model.method,
            })
        except Exception as exc:
            rows.append({
                "policy": policy,
                "status": "failed",
                "reason": str(exc),
            })

    table = pd.DataFrame(rows)
    ok = table[table["status"].eq("ok")].copy()
    if ok.empty:
        LOGGER.warning("All noise-policy ablations failed; using shared_clean fail-safe")
        table["selected"] = table["policy"].eq("shared_clean")
        table["selection_reason"] = np.where(table["selected"], "all_ablation_candidates_failed", "")
        return "shared_clean", table

    valid = (
        (pd.to_numeric(ok.get("n_clusters"), errors="coerce") >= 2)
        & (pd.to_numeric(ok.get("assigned_fraction"), errors="coerce") > 0)
        & (pd.to_numeric(ok.get("largest_cluster_share"), errors="coerce") < 1)
    )
    ok["structurally_valid"] = valid
    candidates = ok[ok["structurally_valid"]].copy()
    if candidates.empty:
        candidates = ok.copy()

    rank_parts: List[pd.Series] = []
    for metric in (
        "npmi_coherence",
        "descriptor_diversity_composite",
        "silhouette",
        "balance_entropy",
        "assigned_fraction",
        "centroid_separation",
    ):
        if metric in candidates.columns:
            rank_parts.append(percentile_rank(candidates[metric], True))
    if "largest_cluster_share" in candidates.columns:
        rank_parts.append(percentile_rank(candidates["largest_cluster_share"], False))
    if rank_parts:
        candidates["policy_selection_score"] = pd.concat(rank_parts, axis=1).median(axis=1)
    else:
        candidates["policy_selection_score"] = 0.5

    best_idx = candidates["policy_selection_score"].idxmax()
    selected = str(candidates.at[best_idx, "policy"])
    table = table.merge(
        candidates[["policy", "structurally_valid", "policy_selection_score"]],
        on="policy", how="left",
    )
    table["selected"] = table["policy"].eq(selected)
    table["selection_reason"] = np.where(
        table["selected"], "development_only_rank_aggregation", ""
    )
    LOGGER.info("selected noise policy=%s from development-only ablation", selected)
    return selected, table


