def privacy_safe_rows(
    result: Dict[str, Any], pseudonym_key: bytes, include_review_text: bool
) -> pd.DataFrame:
    data = result["rows"]
    safe = pd.DataFrame({
        "row_id": data.get("_row_id", pd.Series(np.arange(len(data)))).astype(int),
        "case_ref": data.get("_case", pd.Series([""] * len(data))).map(lambda x: pseudonymize(x, pseudonym_key)),
        "conversation_ref": data.get("_conversation", pd.Series([""] * len(data))).map(lambda x: pseudonymize(x, pseudonym_key)),
        "group_ref": data.get("_group", pd.Series([""] * len(data))).map(lambda x: pseudonymize(x, pseudonym_key)),
        "data_split": data["data_split"].astype(str),
        "phase2_cluster_id": data["phase2_cluster_id"].astype(int),
        "phase2_cluster_strength": data["phase2_cluster_strength"].astype(float),
        "phase2_assignment_source": data.get("phase2_assignment_source", pd.Series(["native"] * len(data))).astype(str),
        "phase2_recovery_similarity": pd.to_numeric(data.get("phase2_recovery_similarity", pd.Series([np.nan] * len(data))), errors="coerce"),
        "phase2_recovery_margin": pd.to_numeric(data.get("phase2_recovery_margin", pd.Series([np.nan] * len(data))), errors="coerce"),
        "phase2_cluster_descriptor": data["phase2_cluster_descriptor"].astype(str).map(redact_pii),
    })
    if include_review_text:
        text_col = result["text_col"]
        safe["redacted_text"] = data[text_col].astype(str).map(redact_pii)
    if "sentence_index" in data.columns:
        safe["sentence_index"] = data["sentence_index"].values
    return safe


def residual_pii_counts(
    frame: pd.DataFrame, text_columns: Optional[Sequence[str]] = None
) -> Dict[str, int]:
    """Scan only human-language text fields for residual regex-detectable PII."""
    counts = {name: 0 for name, _ in PII_PATTERNS}
    columns = list(text_columns or [])
    if not columns:
        columns = [c for c in frame.columns if c in {"redacted_text", "representative_examples", "descriptor", "top_terms"}]
    for col in columns:
        if col not in frame.columns:
            continue
        for value in frame[col].fillna("").astype(str):
            for name, pattern in PII_PATTERNS:
                if pattern.search(value):
                    counts[name] += 1
    return counts


def save_grouped_metric_chart(
    before_after: pd.DataFrame, metrics: Sequence[str], title: str, path: Path
) -> None:
    if before_after is None or before_after.empty:
        return
    available = [metric for metric in metrics if metric in before_after.columns]
    if not available:
        return
    stages = before_after["stage"].astype(str).tolist()
    positions = np.arange(len(available))
    width = 0.8 / max(len(stages), 1)
    plt.figure(figsize=(max(8, 1.8 * len(available)), 5.5))
    for offset, stage in enumerate(stages):
        values = []
        for metric in available:
            value = float(before_after.iloc[offset].get(metric, np.nan))
            values.append(0.0 if not np.isfinite(value) else value)
        bars = plt.bar(positions + offset * width, values, width=width, label=stage)
        for bar, value in zip(bars, values):
            plt.text(
                bar.get_x() + bar.get_width() / 2,
                bar.get_height(),
                f"{value:.3f}",
                ha="center",
                va="bottom",
                fontsize=7,
            )
    plt.xticks(
        positions + width * (len(stages) - 1) / 2,
        [metric.replace("_", " ") for metric in available],
        rotation=20,
        ha="right",
    )
    plt.title(title)
    plt.legend(fontsize=8, frameon=False)
    plt.tight_layout()
    plt.savefig(path, dpi=160)
    plt.close()


