def pct(num, den):
    return round(100.0 * num / den, 2) if den else 0.0


def to_plain(obj):
    """Make numpy and pandas values safe for json.dump."""
    if obj is None:
        return None
    if isinstance(obj, dict):
        return {str(k): to_plain(v) for k, v in obj.items()}
    if isinstance(obj, (list, tuple, set)):
        return [to_plain(v) for v in obj]
    if isinstance(obj, np.integer):
        return int(obj)
    if isinstance(obj, np.floating):
        return None if np.isnan(obj) else float(obj)
    if isinstance(obj, np.ndarray):
        return [to_plain(v) for v in obj.tolist()]
    try:
        if pd.isna(obj):
            return None
    except (TypeError, ValueError):
        pass
    return obj


def otsu_threshold(values, bins=64):
    """Split a score distribution into keep and discard without picking a number
    by hand. Standard between-class variance maximisation."""
    v = np.asarray([x for x in values if np.isfinite(x)], dtype=float)
    if v.size < 4:
        return float(v.min()) if v.size else 0.0
    hist, edges = np.histogram(v, bins=bins)
    total = hist.sum()
    if total == 0:
        return float(v.min())
    p = hist / total
    centres = (edges[:-1] + edges[1:]) / 2.0
    omega = np.cumsum(p)
    mu = np.cumsum(p * centres)
    mu_total = mu[-1]
    denom = omega * (1.0 - omega)
    with np.errstate(divide="ignore", invalid="ignore"):
        between = (mu_total * omega - mu) ** 2 / denom
    between = np.nan_to_num(between)
    return float(centres[int(np.argmax(between))])


# ---------------------------------------------------------------- schema

def normalise_key(value):
    return re.sub(r"[^a-z0-9]+", "_", str(value).strip().lower()).strip("_")


def is_identifier_key(key):
    key = normalise_key(key)
    return any(re.search(pat, key) for _, pat in IDENTIFIER_KEYS)


def find_column(columns, patterns, exclude=()):
    for pat in patterns:
        for col in columns:
            name = normalise_key(col)
            if any(re.search(ex, name) for ex in exclude):
                continue
            if re.search(pat, name):
                return col
    return None


def discover_schema(df):
    cols = list(df.columns)
    return {
        "case": find_column(cols, [r"^source_row$", r"source.*row", r"^row_?id$"]),
        "turn": find_column(cols, [r"message_index", r"turn.*index", r"^index$", r"^seq"]),
        "conversation": find_column(cols, [r"data_cid$", r"(^|_)cid$", r"conversation.*id"]),
        "text": find_column(cols, [r"data_content$", r"content$", r"message.*text",
                                   r"^text$", r"utterance"]),
        "role": find_column(cols, [r"^message_type$", r"message_type$", r"data_type$",
                                   r"^role$", r"speaker"]),
        "turn_label": find_column(cols, [r"data_label$", r"(^|_)label$", r"turn.*intent"],
                                  exclude=[r"predict"]),
        "case_label": find_column(cols, [r"classification.*intent", r"case.*intent",
                                         r"conversation.*intent"]),
    }


def profile_columns(df, schema):
    roles = {col: role for role, col in schema.items() if col}
    rows = []
    for col in df.columns:
        s = df[col].dropna().astype(str)
        s = s[s.str.strip() != ""]
        rows.append({
            "column": col,
            "resolved_role": roles.get(col, ""),
            "fill_pct": pct(len(s), len(df)),
            "distinct": int(s.nunique()),
            "median_chars": int(s.str.len().median()) if len(s) else 0,
            "max_chars": int(s.str.len().max()) if len(s) else 0,
        })
    return rows


# ---------------------------------------------------------------- privacy

def parse_fields(text):
    if not isinstance(text, str) or not text:
        return [], ""
    fields, spans = [], []
    for m in FIELD_LINE_RE.finditer(text):
        key = normalise_key(m.group("key"))
        if len(key) >= 2:
            fields.append((key, m.group("value").strip()))
            spans.append((m.start(), m.end()))
    if not spans:
        return [], text
    parts, cursor = [], 0
    for start, end in spans:
        parts.append(text[cursor:start])
        cursor = end
    parts.append(text[cursor:])
    return fields, re.sub(r"\s+", " ", " ".join(parts)).strip()


def harvest_name_tokens(texts):
    """Tokens seen inside a name field. A token is only treated as a name when
    most of its occurrences in the whole corpus sit in one, which keeps surnames
    that double as ordinary words out of the block list."""
    in_name, everywhere = {}, {}
    for text in texts:
        if not isinstance(text, str) or not text:
            continue
        fields, _ = parse_fields(text)
        for key, value in fields:
            if re.search(IDENTIFIER_KEYS[0][1], key):
                for tok in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", value):
                    in_name[tok.lower()] = in_name.get(tok.lower(), 0) + 1
        for m in NAME_CUE_RE.finditer(text):
            for tok in re.findall(r"[A-Za-z][A-Za-z'\-]{1,}", m.group("value")):
                in_name[tok.lower()] = in_name.get(tok.lower(), 0) + 1
        for tok in re.findall(r"[A-Za-z][A-Za-z'\-]{2,}", text.lower()):
            everywhere[tok] = everywhere.get(tok, 0) + 1
    kept = {t for t, c in in_name.items()
            if len(t) >= 3 and c / max(everywhere.get(t, c), 1) >= 0.5}
    return kept, len(in_name) - len(kept)


def build_name_regex(tokens):
    if not tokens:
        return None
    ordered = sorted(tokens, key=len, reverse=True)
    return re.compile(r"(?i)\b(?:" + "|".join(re.escape(t) for t in ordered) + r")\b")


def scrub(text, name_regex):
    if not isinstance(text, str) or not text:
        return ""
    out = NAME_CUE_RE.sub(" ", text)
    out = ADDRESS_RE.sub(f" {REDACT} ", out)
    for _, pattern in PII_PATTERNS:
        out = pattern.sub(f" {REDACT} ", out)
    if name_regex is not None:
        out = name_regex.sub(f" {REDACT} ", out)
    return out


def extract_problem(text, name_regex):
    """Drop identifier form fields, keep the free-text payload. Casing is kept
    because both the encoder and the extractor are sensitive to it."""
    fields, remainder = parse_fields(text)
    if not fields:
        body = scrub(text, name_regex)
    else:
        parts = [scrub(v, name_regex) for k, v in fields
                 if v and not is_identifier_key(k)]
        if remainder:
            parts.append(scrub(remainder, name_regex))
        body = " ".join(p for p in parts if p)
    body = body.replace(REDACT, " ")
    body = re.sub(r"[ \t]+", " ", body)
    return re.sub(r"\s+", " ", body).strip()


def residue_flags(text):
    return [name for name, pattern in RESIDUE_PATTERNS if pattern.search(text)]


def enforce_residue_gate(series):
    """A second pass on anything that still looks like an identifier. The text is
    repaired rather than the row deleted - dropping rows removes the longest and
    most detailed statements and biases everything downstream."""
    repaired, blanked, touched = [], 0, 0
    for text in series:
        if not residue_flags(text):
            repaired.append(text)
            continue
        touched += 1
        fixed = text
        for _, pattern in RESIDUE_PATTERNS:
            fixed = pattern.sub(" ", fixed)
        fixed = re.sub(r"\s+", " ", fixed).strip()
        if residue_flags(fixed):
            repaired.append("")
            blanked += 1
        else:
            repaired.append(fixed)
    return pd.Series(repaired, index=series.index), touched, blanked


# ---------------------------------------------------------------- corpus

def load_input(path, sample, seed):
    log("\n[1/8] load and schema")
    df = pd.read_csv(path, dtype=str, keep_default_na=False,
                     na_values=["", "NA", "NaN", "null", "None", "nan"],
                     low_memory=False)
    if sample and sample < len(df):
        df = df.sample(sample, random_state=seed).reset_index(drop=True)
    schema = discover_schema(df)
    if not schema["text"]:
        raise RuntimeError("no message content column resolved from the header")
    log(f"  rows={len(df):,} columns={len(df.columns)}")
    for role, col in schema.items():
        log(f"  {role:<13} -> {col}")
    return df, schema


def build_corpus(df, schema):
    log("\n[2/8] partition and privacy")
    work = df.copy()
    work["raw"] = (work[schema["text"]].fillna("").astype(str)
                   .str.replace(r"\\r", " ", regex=True)
                   .str.replace(r"\\n", "\n", regex=True))
    if schema["role"]:
        work["role"] = work[schema["role"]].fillna("unknown").astype(str).str.strip().str.lower()
    else:
        work["role"] = "unknown"

    names, released = harvest_name_tokens(work["raw"].tolist())
    name_regex = build_name_regex(names)
    log(f"  name tokens blocked={len(names)} released={released}")

    user = work[work["role"].eq("user")].copy() if schema["role"] else work.copy()
    assistant = work[work["role"].eq("assistant")].copy()

    user["text"] = user["raw"].map(lambda t: extract_problem(t, name_regex))
    assistant["text"] = assistant["raw"].map(lambda t: scrub(t, name_regex).replace(REDACT, " "))
    assistant["text"] = assistant["text"].str.replace(r"\s+", " ", regex=True).str.strip()

    user["text"], u_touched, u_blank = enforce_residue_gate(user["text"])
    assistant["text"], a_touched, a_blank = enforce_residue_gate(assistant["text"])
    log(f"  residue repaired user={u_touched} blanked={u_blank} | "
        f"assistant={a_touched} blanked={a_blank}")

    user = user[user["text"].str.len() >= 3].reset_index(drop=True)
    assistant = assistant[assistant["text"].str.len() >= 3].reset_index(drop=True)
    if user.empty:
        raise RuntimeError("no usable customer turns after cleaning")

    quality = {
        "input_rows": int(len(df)),
        "role_counts": {str(k): int(v) for k, v in work["role"].value_counts().items()},
        "name_tokens_blocked": int(len(names)),
        "name_tokens_released": int(released),
        "customer_rows_repaired": int(u_touched),
        "customer_rows_blanked": int(u_blank),
        "assistant_rows_repaired": int(a_touched),
        "assistant_rows_blanked": int(a_blank),
        "customer_rows": int(len(user)),
        "assistant_rows": int(len(assistant)),
        "distinct_customer_problems": int(user["text"].nunique()),
    }
    log(f"  customer={len(user):,} assistant={len(assistant):,}")
    return user, assistant, quality


