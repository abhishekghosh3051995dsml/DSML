# ---------------------------------------------------------------- topics

def derive_topic_params(n_docs, min_cluster_size, n_neighbors):
    if min_cluster_size <= 0:
        min_cluster_size = max(12, int(round(np.sqrt(max(n_docs, 1)))))
    min_cluster_size = min(min_cluster_size, max(2, n_docs // 3))
    if n_neighbors <= 0:
        n_neighbors = int(round(np.sqrt(max(n_docs, 1)) / 2))
        n_neighbors = min(30, max(10, n_neighbors))
    n_neighbors = min(n_neighbors, max(2, n_docs - 1))
    return min_cluster_size, n_neighbors, max(5, min_cluster_size // 4)


def discover_topics(docs, embeddings, encoder, args):
    log("\n[3/8] detailed intent discovery")
    try:
        from umap import UMAP
        from hdbscan import HDBSCAN
        from bertopic import BERTopic
        from bertopic.representation import KeyBERTInspired
        from sklearn.feature_extraction.text import CountVectorizer
    except ImportError as exc:
        raise RuntimeError("pip install umap-learn hdbscan bertopic") from exc

    n_docs = len(docs)
    if n_docs < 30:
        out = docs.copy()
        out["topic_id"] = -1
        out["topic_score"] = np.nan
        out["detailed_intent"] = "insufficient_data"
        return out, {"status": "skipped", "reason": "too few distinct statements"}

    min_size, neighbors, min_samples = derive_topic_params(
        n_docs, args.min_cluster_size, args.umap_neighbors)
    log(f"  min_cluster_size={min_size} min_samples={min_samples} neighbors={neighbors}")

    topic_model = BERTopic(
        embedding_model=encoder,
        umap_model=UMAP(n_neighbors=neighbors, n_components=5, min_dist=0.0,
                        metric="cosine", random_state=args.seed, low_memory=True),
        hdbscan_model=HDBSCAN(min_cluster_size=min_size, min_samples=min_samples,
                              metric="euclidean", cluster_selection_method="eom",
                              prediction_data=True),
        vectorizer_model=CountVectorizer(stop_words="english", ngram_range=(1, 2),
                                         min_df=2, max_df=0.85),
        representation_model=KeyBERTInspired(),
        calculate_probabilities=False,
        verbose=False,
    )
    topics, probs = topic_model.fit_transform(docs["text"].tolist(), embeddings=embeddings)
    topics = np.asarray(topics, dtype=int)

    # HDBSCAN leaves a large tail unassigned on short support text. Pull those
    # back to their nearest topic so the corpus is not half unusable, and report
    # how many were reassigned.
    outliers_before = int((topics == -1).sum())
    if outliers_before and args.reduce_outliers:
        try:
            topics = np.asarray(topic_model.reduce_outliers(
                docs["text"].tolist(), topics, strategy="embeddings",
                embeddings=embeddings), dtype=int)
            topic_model.update_topics(docs["text"].tolist(), topics=topics.tolist())
        except Exception as exc:
            log(f"  outlier reduction unavailable: {exc}")

    names, keywords = {}, {}
    for topic_id in sorted(set(topics.tolist())):
        if topic_id == -1:
            names[topic_id] = "unassigned"
            keywords[str(topic_id)] = []
            continue
        terms = topic_model.get_topic(topic_id) or []
        names[topic_id] = " | ".join(w for w, _ in terms[:5]) or f"topic_{topic_id}"
        keywords[str(topic_id)] = [{"term": w, "weight": round(float(s), 4)}
                                   for w, s in terms[:12]]

    out = docs.copy()
    out["topic_id"] = topics
    if probs is None:
        out["topic_score"] = np.nan
    else:
        arr = np.asarray(probs)
        out["topic_score"] = arr if arr.ndim == 1 else arr.max(axis=1)
    out["detailed_intent"] = out["topic_id"].map(names)

    assigned = topics != -1
    clusters = sorted(set(topics[assigned].tolist()))
    sil = None
    if assigned.sum() >= 3 and len(clusters) >= 2:
        try:
            sil = float(silhouette_score(embeddings[assigned], topics[assigned],
                                         metric="cosine"))
        except Exception:
            sil = None

    sizes = pd.Series(topics).value_counts().sort_index()
    metrics = {
        "status": "completed",
        "distinct_statements": int(n_docs),
        "topics_found": int(len(clusters)),
        "unassigned_before_reduction": outliers_before,
        "unassigned_after_reduction": int((topics == -1).sum()),
        "silhouette_cosine": sil,
        "parameters": {"min_cluster_size": int(min_size), "min_samples": int(min_samples),
                       "umap_neighbors": int(neighbors)},
        "topics": [{"topic_id": int(t), "count": int(sizes.get(t, 0)),
                    "name": names.get(t, ""), "keywords": keywords.get(str(t), [])}
                   for t in sorted(set(topics.tolist()))],
    }
    log(f"  topics={len(clusters)} unassigned={int((topics == -1).sum())} silhouette={sil}")
    return out, metrics


# ---------------------------------------------------------------- classifier

def split_by_case(labels, groups, test_size, seed):
    """Hold out whole cases. Splitting by row would put the same case on both
    sides, and since the turn label is the case label copied down that leaks the
    answer straight into the test set."""
    splitter = GroupShuffleSplit(n_splits=1, test_size=test_size, random_state=seed)
    train_idx, test_idx = next(splitter.split(np.zeros(len(labels)), labels, groups))
    return train_idx, test_idx


def choose_splits(y, groups, requested):
    frame = pd.DataFrame({"y": y, "g": groups}).drop_duplicates()
    if frame["y"].nunique() < 2:
        return 0
    per_class = frame.groupby("y")["g"].nunique()
    return max(0, min(requested, int(per_class.min()), int(frame["g"].nunique())))


def new_classifier(seed):
    return LogisticRegression(max_iter=3000, class_weight="balanced",
                              solver="lbfgs", random_state=seed)


def run_classifier(user, embeddings, schema, args):
    log("\n[4/8] broad intent classifier")
    label_col = schema.get("case_label") or schema.get("turn_label")
    user = user.copy()
    user["predicted_intent"] = ""
    user["prediction_confidence"] = np.nan
    user["prediction_source"] = "none"
    user["split"] = "unlabelled"

    if not label_col:
        return user, {"status": "skipped", "reason": "no label column"}

    labels = user[label_col].fillna("").astype(str).str.strip()
    labelled = labels.ne("")
    if labelled.sum() < 30 or labels[labelled].nunique() < 2:
        return user, {"status": "skipped", "reason": "insufficient labelled variation"}

    case_col = schema.get("case") or schema.get("conversation")
    if case_col:
        groups_all = user[case_col].fillna("").astype(str)
        groups_all = groups_all.where(groups_all.ne(""), user["text"])
    else:
        groups_all = user["text"]

    # One row per distinct statement so an identical sentence cannot sit on both
    # sides of a split.
    pool = user.loc[labelled].drop_duplicates("text").index.to_numpy()
    y_text = labels.loc[pool].to_numpy()
    groups = groups_all.loc[pool].to_numpy(dtype=object)
    encoder = LabelEncoder()
    y = encoder.fit_transform(y_text)
    X = embeddings[pool]

    train_pos, test_pos = split_by_case(y, groups, args.test_size, args.seed)
    X_train, y_train, g_train = X[train_pos], y[train_pos], groups[train_pos]
    X_test, y_test = X[test_pos], y[test_pos]
    log(f"  train statements={len(train_pos):,} test statements={len(test_pos):,} "
        f"({len(set(groups[test_pos]))} held-out cases)")

    n_splits = choose_splits(y_train, g_train, args.cv_splits)
    oof = np.full(len(y_train), -1, dtype=int)
    folds = []
    if n_splits >= 2:
        if StratifiedGroupKFold is not None:
            splitter = StratifiedGroupKFold(n_splits=n_splits, shuffle=True,
                                            random_state=args.seed)
        else:
            splitter = GroupKFold(n_splits=n_splits)
        for fold, (tr, va) in enumerate(splitter.split(X_train, y_train, g_train), 1):
            clf = new_classifier(args.seed).fit(X_train[tr], y_train[tr])
            pred = clf.predict(X_train[va])
            oof[va] = pred
            folds.append({
                "fold": fold,
                "train_rows": int(len(tr)),
                "validation_rows": int(len(va)),
                "balanced_accuracy": float(balanced_accuracy_score(y_train[va], pred)),
                "macro_f1": float(f1_score(y_train[va], pred, average="macro")),
            })

    fitted = new_classifier(args.seed).fit(X_train, y_train)
    test_pred = fitted.predict(X_test)
    test_prob = fitted.predict_proba(X_test).max(axis=1)

    label_ids = np.arange(len(encoder.classes_))
    holdout = {
        "accuracy": float(accuracy_score(y_test, test_pred)),
        "balanced_accuracy": float(balanced_accuracy_score(y_test, test_pred)),
        "macro_f1": float(f1_score(y_test, test_pred, average="macro")),
        "weighted_f1": float(f1_score(y_test, test_pred, average="weighted")),
    }
    cm = confusion_matrix(y_test, test_pred, labels=label_ids)
    report = classification_report(y_test, test_pred, labels=label_ids,
                                   target_names=encoder.classes_, output_dict=True,
                                   zero_division=0)

    cv_summary = None
    if folds:
        scored = oof >= 0
        cv_summary = {
            "splits": int(n_splits),
            "balanced_accuracy": float(balanced_accuracy_score(y_train[scored], oof[scored])),
            "macro_f1": float(f1_score(y_train[scored], oof[scored], average="macro")),
            "folds": folds,
        }

    # Every prediction written to a record is out-of-sample for that record.
    # Training rows get their out-of-fold prediction, held-out rows get the
    # prediction from the model that never saw them, and unlabelled rows are
    # scored by a model fitted on everything labelled.
    idx_train = pool[train_pos]
    idx_test = pool[test_pos]
    train_prob = np.full(len(train_pos), np.nan)
    if folds:
        for fold, (tr, va) in enumerate(
                (StratifiedGroupKFold(n_splits=n_splits, shuffle=True,
                                      random_state=args.seed)
                 if StratifiedGroupKFold is not None
                 else GroupKFold(n_splits=n_splits)).split(X_train, y_train, g_train), 1):
            clf = new_classifier(args.seed).fit(X_train[tr], y_train[tr])
            train_prob[va] = clf.predict_proba(X_train[va]).max(axis=1)

    assign = pd.DataFrame({
        "row": np.concatenate([idx_train, idx_test]),
        "pred": np.concatenate([oof, test_pred]),
        "prob": np.concatenate([train_prob, test_prob]),
        "split": ["train"] * len(idx_train) + ["test"] * len(idx_test),
    })
    assign = assign[assign["pred"] >= 0]
    user.loc[assign["row"], "predicted_intent"] = encoder.inverse_transform(
        assign["pred"].to_numpy())
    user.loc[assign["row"], "prediction_confidence"] = assign["prob"].to_numpy()
    user.loc[assign["row"], "prediction_source"] = np.where(
        assign["split"].to_numpy() == "train", "out_of_fold", "held_out")
    user.loc[assign["row"], "split"] = assign["split"].to_numpy()

    rest = user.index[user["prediction_source"].eq("none")]
    if len(rest):
        full = new_classifier(args.seed).fit(X, y)
        probs = full.predict_proba(embeddings[rest.to_numpy()])
        user.loc[rest, "predicted_intent"] = encoder.inverse_transform(probs.argmax(axis=1))
        user.loc[rest, "prediction_confidence"] = probs.max(axis=1)
        user.loc[rest, "prediction_source"] = "in_sample_model"

    metrics = {
        "status": "completed",
        "label_column": label_col,
        "classes": encoder.classes_.tolist(),
        "grouping": "case" if case_col else "problem text",
        "test_fraction": args.test_size,
        "train_statements": int(len(train_pos)),
        "test_statements": int(len(test_pos)),
        "test_cases": int(len(set(groups[test_pos]))),
        "cross_validation": cv_summary,
        "held_out_test": holdout,
        "classification_report": report,
        "confusion_matrix": {"labels": encoder.classes_.tolist(), "matrix": cm.tolist()},
    }
    log("  held-out test: " + json.dumps(holdout))
    return user, metrics


# ---------------------------------------------------------------- entities

def load_extractor(model_name):
    try:
        from gliner import GLiNER
    except ImportError:
        return None
    try:
        return GLiNER.from_pretrained(model_name)
    except Exception as exc:
        log(f"  extractor unavailable: {exc}")
        return None


def split_sentences(text, max_chars):
    """The extractor has a token window, so long assistant narratives are cut on
    sentence boundaries and offsets are tracked back to the original string."""
    pieces, cursor = [], 0
    for raw in SENTENCE_SPLIT.split(text):
        if not raw:
            continue
        start = text.find(raw, cursor)
        if start < 0:
            start = cursor
        cursor = start + len(raw)
        for offset in range(0, len(raw), max_chars):
            chunk = raw[offset:offset + max_chars].strip()
            if len(chunk) >= 3:
                pieces.append((start + offset, chunk))
    if not pieces and text.strip():
        pieces.append((0, text[:max_chars]))
    return pieces


def extract_entities(extractor, texts, types, args, tag):
    """Returns one list of spans per input text plus the score distribution the
    operating threshold was derived from."""
    log(f"\n  extracting {tag} entities over {len(texts):,} texts")
    labels = [f"{t} ({TYPE_HINTS[t]})" if args.type_hints and t in TYPE_HINTS else t
              for t in types]
    label_to_type = {lab: t for lab, t in zip(labels, types)}

    jobs, owners = [], []
    for i, text in enumerate(texts):
        for start, chunk in split_sentences(text, args.max_chunk_chars):
            jobs.append(chunk)
            owners.append((i, start))

    raw = [[] for _ in texts]
    scores = []
    batch = args.ner_batch_size
    for begin in range(0, len(jobs), batch):
        window = jobs[begin:begin + batch]
        try:
            found = extractor.batch_predict_entities(
                window, labels, threshold=args.ner_floor)
        except (AttributeError, TypeError):
            found = [extractor.predict_entities(t, labels, threshold=args.ner_floor)
                     for t in window]
        for offset, spans in enumerate(found):
            doc, base = owners[begin + offset]
            for span in spans:
                score = float(span.get("score", 0.0))
                scores.append(score)
                raw[doc].append({
                    "type": label_to_type.get(span["label"], span["label"]),
                    "text": span["text"],
                    "start": int(span["start"]) + base,
                    "end": int(span["end"]) + base,
                    "score": round(score, 4),
                })
        if begin and begin % (batch * 20) == 0:
            log(f"    {begin:,}/{len(jobs):,} chunks")

    threshold = otsu_threshold(scores) if scores else args.ner_floor
    threshold = max(threshold, args.ner_floor)
    log(f"    candidate spans={len(scores):,} derived threshold={threshold:.3f}")

    kept = []
    for spans in raw:
        keep = [s for s in spans if s["score"] >= threshold]
        keep.sort(key=lambda s: (-s["score"], s["start"]))
        deduped, seen = [], set()
        for span in keep:
            key = (span["type"], span["text"].lower())
            if key in seen:
                continue
            seen.add(key)
            deduped.append(span)
        kept.append(deduped[:args.max_spans_per_text])
    return kept, scores, threshold


def summarise_entities(spans_per_text, types, n_texts):
    present = {t: 0 for t in types}
    values = {t: {} for t in types}
    for spans in spans_per_text:
        seen = set()
        for span in spans:
            t = span["type"]
            if t not in present:
                present[t] = 0
                values[t] = {}
            if t not in seen:
                present[t] += 1
                seen.add(t)
            key = span["text"].lower()
            values[t][key] = values[t].get(key, 0) + 1
    return {
        "types": list(types),
        "messages_with_type": {t: int(c) for t, c in present.items()},
        "coverage_pct": {t: pct(c, n_texts) for t, c in present.items()},
        "top_values": {
            t: [{"value": v, "count": int(c)}
                for v, c in sorted(vals.items(), key=lambda kv: -kv[1])[:25]]
            for t, vals in values.items()
        },
    }


def flag_ambiguity(spans):
    """Two spans of different types over the same text is the signal the
    downstream ambiguity check needs."""
    by_offset = {}
    for span in spans:
        by_offset.setdefault((span["start"], span["end"]), []).append(span["type"])
    return [{"start": k[0], "end": k[1], "competing_types": sorted(set(v))}
            for k, v in by_offset.items() if len(set(v)) > 1]


# ---------------------------------------------------------------- alignment

def topic_label_alignment(user, schema):
    label_col = schema.get("case_label") or schema.get("turn_label")
    if not label_col or "topic_id" not in user.columns:
        return {"status": "skipped"}
    mask = (user[label_col].fillna("").astype(str).str.strip().ne("")
            & user["topic_id"].notna())
    if mask.sum() < 20:
        return {"status": "skipped", "reason": "insufficient overlap"}
    labels = user.loc[mask, label_col].astype(str)
    topics = user.loc[mask, "topic_id"].astype(int)
    return {
        "status": "completed",
        "normalised_mutual_information": float(normalized_mutual_info_score(labels, topics)),
        "adjusted_rand_index": float(adjusted_rand_score(labels, topics)),
    }


# ---------------------------------------------------------------- charts

def save_bar(labels, values, xlabel, title, path, color="#2b6cb0"):
    fig, ax = plt.subplots(figsize=(8, max(2.0, 0.32 * len(labels) + 1)))
    y = np.arange(len(labels))
    ax.barh(y, values, color=color, height=0.7)
    ax.set_yticks(y)
    ax.set_yticklabels([str(l)[:48] for l in labels])
    ax.invert_yaxis()
    ax.set_xlabel(xlabel)
    ax.set_title(title, loc="left", fontweight="bold")
    for i, v in enumerate(values):
        ax.text(v, i, f" {v:,.4g}", va="center", fontsize=8, color="#4a5568")
    fig.savefig(path, bbox_inches="tight", dpi=130)
    plt.close(fig)


def save_charts(outdir, entity_summary, assistant_summary, topic_metrics,
                classifier_metrics, scores, threshold):
    outdir.mkdir(parents=True, exist_ok=True)

    if entity_summary:
        cov = entity_summary["coverage_pct"]
        order = sorted(cov, key=cov.get, reverse=True)
        save_bar(order, [cov[t] for t in order], "% of customer messages",
                 "Entity type coverage", outdir / "entity_coverage.png", "#2f855a")

    if assistant_summary:
        cov = assistant_summary["coverage_pct"]
        order = sorted(cov, key=cov.get, reverse=True)
        save_bar(order, [cov[t] for t in order], "% of assistant messages",
                 "RCA and remediation coverage", outdir / "assistant_coverage.png",
                 "#6b46c1")

    if scores:
        fig, ax = plt.subplots(figsize=(7, 3.4))
        ax.hist(scores, bins=60, color="#2b6cb0")
        ax.axvline(threshold, color="#c05621", linestyle="--", linewidth=1.5,
                   label=f"threshold {threshold:.3f}")
        ax.set_xlabel("extractor confidence")
        ax.set_ylabel("spans")
        ax.set_title("Span confidence and derived cut-off", loc="left", fontweight="bold")
        ax.legend(frameon=False, fontsize=8)
        fig.savefig(outdir / "span_confidence.png", bbox_inches="tight", dpi=130)
        plt.close(fig)

    if topic_metrics.get("status") == "completed":
        topics = [t for t in topic_metrics["topics"] if t["topic_id"] != -1]
        topics = sorted(topics, key=lambda t: -t["count"])[:25]
        if topics:
            save_bar([t["name"] for t in topics], [t["count"] for t in topics],
                     "distinct statements", "Largest detailed intents",
                     outdir / "topic_sizes.png", "#c05621")

    if classifier_metrics.get("status") == "completed":
        cm = np.asarray(classifier_metrics["confusion_matrix"]["matrix"], dtype=float)
        names = classifier_metrics["confusion_matrix"]["labels"]
        norm = cm / np.clip(cm.sum(axis=1, keepdims=True), 1, None)
        fig, ax = plt.subplots(figsize=(1.4 * len(names) + 2.5, 1.2 * len(names) + 2))
        im = ax.imshow(norm, cmap="Blues", vmin=0, vmax=1)
        ax.set_xticks(range(len(names)))
        ax.set_xticklabels(names, rotation=30, ha="right")
        ax.set_yticks(range(len(names)))
        ax.set_yticklabels(names)
        ax.set_xlabel("predicted")
        ax.set_ylabel("actual")
        ax.grid(False)
        ax.set_title("Held-out test confusion", loc="left", fontweight="bold")
        for i in range(len(names)):
            for j in range(len(names)):
                ax.text(j, i, f"{norm[i, j]:.2f}", ha="center", va="center", fontsize=9,
                        color="white" if norm[i, j] > 0.6 else "#2d3748")
        fig.colorbar(im, ax=ax, fraction=0.04, pad=0.03)
        fig.savefig(outdir / "confusion_matrix.png", bbox_inches="tight", dpi=130)
        plt.close(fig)


# ---------------------------------------------------------------- assembly

def build_dictionary(args, df, schema, profile, quality, topic_metrics,
                     classifier_metrics, entity_summary, assistant_summary,
                     alignment, user, customer_spans, assistant_table):
    log("\n[8/8] assembling dictionary")
    label_col = schema.get("case_label") or schema.get("turn_label")

    rca_by_case, remediation_by_case = {}, {}
    for row in assistant_table:
        case = row["case"]
        for span in row["spans"]:
            bucket = None
            if span["type"] == "root cause":
                bucket = rca_by_case
            elif span["type"] == "remediation action":
                bucket = remediation_by_case
            if bucket is not None:
                bucket.setdefault(case, []).append(
                    {"text": span["text"], "score": span["score"]})

    case_col = schema.get("case")
    records = {}
    for n, (position, row) in enumerate(user.iterrows(), start=1):
        case = str(row.get(case_col, "")) if case_col else ""
        spans = customer_spans[position] if position < len(customer_spans) else []
        grouped = {}
        for span in spans:
            grouped.setdefault(span["type"], []).append({
                "value": span["text"],
                "start": span["start"],
                "end": span["end"],
                "confidence": span["score"],
            })
        record_id = f"record_{n:06d}"
        records[record_id] = {
            "record_id": record_id,
            "case": case,
            "turn_index": str(row.get(schema["turn"], "")) if schema.get("turn") else "",
            "customer_problem": row["text"],
            "broad_intent": {
                "existing_label": str(row.get(label_col, "")) if label_col else "",
                "predicted": str(row.get("predicted_intent", "")),
                "confidence": to_plain(row.get("prediction_confidence")),
                "prediction_source": str(row.get("prediction_source", "none")),
                "data_split": str(row.get("split", "unlabelled")),
            },
            "detailed_intent": {
                "topic_id": to_plain(row.get("topic_id")),
                "topic_name": str(row.get("detailed_intent", "")),
                "topic_score": to_plain(row.get("topic_score")),
            },
            "entities": grouped,
            "evidence": [{"type": s["type"], "text": s["text"],
                          "start": s["start"], "end": s["end"]} for s in spans],
            "ambiguity": flag_ambiguity(spans),
            "root_cause": rca_by_case.get(case, []),
            "remediation": remediation_by_case.get(case, []),
        }

    payload = {
        "run": {
            "input_file": Path(args.input).name,
            "embedding_model": args.embedding_model,
            "extraction_model": args.ner_model,
            "seed": args.seed,
            "test_fraction": args.test_size,
            "cv_splits": args.cv_splits,
        },
        "schema": schema,
        "dataset": {
            "input_rows": int(len(df)),
            "column_profile": profile,
            "data_quality": quality,
        },
        "analysis": {
            "detailed_intent": topic_metrics,
            "broad_intent": classifier_metrics,
            "customer_entities": entity_summary,
            "assistant_entities": assistant_summary,
            "topic_label_alignment": alignment,
        },
        "records": records,
    }
    return to_plain(payload)


def write_tables(outdir, user, customer_spans, assistant_table, entity_summary,
                 assistant_summary):
    outdir.mkdir(parents=True, exist_ok=True)

    rows = []
    for position, spans in enumerate(customer_spans):
        for span in spans:
            rows.append({"row": position, "type": span["type"], "value": span["text"],
                         "start": span["start"], "end": span["end"],
                         "confidence": span["score"]})
    pd.DataFrame(rows).to_csv(outdir / "customer_entities.csv", index=False)

    rows = []
    for item in assistant_table:
        for span in item["spans"]:
            rows.append({"case": item["case"], "type": span["type"],
                         "value": span["text"], "confidence": span["score"]})
    frame = pd.DataFrame(rows)
    frame.to_csv(outdir / "assistant_entities.csv", index=False)
    if not frame.empty:
        frame[frame["type"].eq("root cause")].to_csv(outdir / "rca.csv", index=False)
        frame[frame["type"].eq("remediation action")].to_csv(
            outdir / "remediation.csv", index=False)

    if entity_summary:
        pd.DataFrame([{"type": t, "messages": entity_summary["messages_with_type"][t],
                       "coverage_pct": entity_summary["coverage_pct"][t]}
                      for t in entity_summary["types"]]
                     ).sort_values("coverage_pct", ascending=False
                                   ).to_csv(outdir / "entity_coverage.csv", index=False)

    if assistant_summary:
        pd.DataFrame([{"type": t, "messages": assistant_summary["messages_with_type"][t],
                       "coverage_pct": assistant_summary["coverage_pct"][t]}
                      for t in assistant_summary["types"]]
                     ).sort_values("coverage_pct", ascending=False
                                   ).to_csv(outdir / "assistant_coverage.csv", index=False)

    keep = [c for c in ["text", "topic_id", "detailed_intent", "predicted_intent",
                        "prediction_confidence", "prediction_source", "split"]
            if c in user.columns]
    user[keep].to_csv(outdir / "customer_turns.csv", index=False)


# ---------------------------------------------------------------- entry

def parse_args(argv=None):
    p = argparse.ArgumentParser()
    p.add_argument("--input", required=True)
    p.add_argument("--outdir", default="nora_out")
    p.add_argument("--output-json", default="nora_dictionary.json")
    p.add_argument("--embedding-model", default=EMBED_MODEL)
    p.add_argument("--ner-model", default=NER_MODEL)
    p.add_argument("--seed", type=int, default=42)
    p.add_argument("--batch-size", type=int, default=64)
    p.add_argument("--ner-batch-size", type=int, default=16)
    p.add_argument("--ner-floor", type=float, default=0.25,
                   help="lowest span score kept before the threshold is derived")
    p.add_argument("--max-chunk-chars", type=int, default=800)
    p.add_argument("--max-spans-per-text", type=int, default=20)
    p.add_argument("--test-size", type=float, default=0.2)
    p.add_argument("--cv-splits", type=int, default=5)
    p.add_argument("--min-cluster-size", type=int, default=0)
    p.add_argument("--umap-neighbors", type=int, default=0)
    p.add_argument("--sample", type=int, default=0)
    p.add_argument("--type-hints", action="store_true", default=True)
    p.add_argument("--no-type-hints", dest="type_hints", action="store_false")
    p.add_argument("--reduce-outliers", action="store_true", default=True)
    p.add_argument("--keep-outliers", dest="reduce_outliers", action="store_false")
    p.add_argument("--skip-assistant", action="store_true")
    return p.parse_args(argv)


def main(argv=None):
    warnings.filterwarnings("once")
    args = parse_args(argv)
    outdir = Path(args.outdir)
    outdir.mkdir(parents=True, exist_ok=True)

    df, schema = load_input(args.input, args.sample, args.seed)
    profile = profile_columns(df, schema)
    user, assistant, quality = build_corpus(df, schema)

    log("\n[3/8] encoding")
    encoder = load_encoder(args.embedding_model)
    embeddings = encode(encoder, user["text"], args.batch_size)
    log(f"  embeddings={embeddings.shape}")

    unique = user[["text"]].drop_duplicates("text").reset_index(drop=True)
    first_seen = user.drop_duplicates("text").index.to_numpy()
    topics, topic_metrics = discover_topics(unique, embeddings[first_seen], encoder, args)
    user = user.join(topics.set_index("text")[["topic_id", "topic_score",
                                               "detailed_intent"]], on="text")

    user, classifier_metrics = run_classifier(user, embeddings, schema, args)

    log("\n[5/8] customer entity extraction")
    extractor = load_extractor(args.ner_model)
    if extractor is None:
        raise RuntimeError(
            "the span extractor could not be loaded. install it with "
            "pip install gliner, or point --ner-model at a local copy")

    customer_spans, scores, threshold = extract_entities(
        extractor, user["text"].tolist(), CUSTOMER_TYPES, args, "customer")
    entity_summary = summarise_entities(customer_spans, CUSTOMER_TYPES, len(user))
    entity_summary["span_threshold"] = round(threshold, 4)
    entity_summary["candidate_spans"] = len(scores)

    log("\n[6/8] assistant root cause and remediation")
    assistant_table, assistant_summary = [], None
    if not args.skip_assistant and len(assistant):
        a_spans, a_scores, a_threshold = extract_entities(
            extractor, assistant["text"].tolist(), ASSISTANT_TYPES, args, "assistant")
        assistant_summary = summarise_entities(a_spans, ASSISTANT_TYPES, len(assistant))
        assistant_summary["span_threshold"] = round(a_threshold, 4)
        assistant_summary["candidate_spans"] = len(a_scores)
        case_col = schema.get("case")
        for position, spans in enumerate(a_spans):
            case = str(assistant.iloc[position][case_col]) if case_col else ""
            assistant_table.append({"case": case, "spans": spans})

    log("\n[7/8] alignment, charts and tables")
    alignment = topic_label_alignment(user, schema)
    save_charts(outdir, entity_summary, assistant_summary, topic_metrics,
                classifier_metrics, scores, threshold)
    write_tables(outdir, user, customer_spans, assistant_table, entity_summary,
                 assistant_summary)

    payload = build_dictionary(args, df, schema, profile, quality, topic_metrics,
                               classifier_metrics, entity_summary, assistant_summary,
                               alignment, user, customer_spans, assistant_table)

    json_path = outdir / args.output_json
    with open(json_path, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, ensure_ascii=False)

    log("\ndone")
    log(f"  dictionary : {json_path.resolve()}")
    log(f"  tables     : {outdir.resolve()}")
    log(f"  records    : {len(payload['records']):,}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
